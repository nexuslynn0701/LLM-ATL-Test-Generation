<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art001"
           title="A Comprehensive Study of Model Transformation Testing"
           year="2021"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr001"
           title="Testing Strategies for ATL Transformations"
           year="2020">
    <authors author="Clara Brown"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unp001"
           title="Preliminary Results on Incremental Model Transformations"
           note="Draft version, not for distribution">
    <authors author="David Wilson"/>
    <authors author="Eva Martinez"/>
  </entries>

  <!-- Manual (no author, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="man001"
           title="ATL Transformation Language Reference Guide"/>
  
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc001"
           title="Proceedings of the 15th International Conference on Model Transformation"
           year="2019"/>

  <!-- InProceedings (inherits Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc001"
           title="Experiments with Automated Test Data Generation for MDE"
           year="2019"
           booktitle="Proceedings of the 15th International Conference on Model Transformation">
    <authors author="Frank Green"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet001"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book001"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Grace Lee"/>
    <authors author="Henry Kim"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol001"
           title="Coverage Criteria for Model Transformations"
           year="2017"
           publisher="Springer"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Isabel Turner"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook001"
           title="Practical Aspects of Model Transformation Testing"
           year="2016"
           publisher="Morgan Kaufmann"
           chapter="5">
    <authors author="Jack Miller"/>
    <authors author="Karen Davis"/>
  </entries>

  <!-- Misc entry (minimal BibTeXEntry) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc001"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd001"
           title="Automation Techniques for Model Transformation Testing"
           year="2015"
           school="Technical University of Metamodeling">
    <authors author="Laura Scott"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc001"
           title="Evaluating Test Adequacy for ATL Transformations"
           year="2014"
           school="Institute of Software Engineering">
    <authors author="Michael Brown"/>
  </entries>

</BibTeX:BibTeXFile>