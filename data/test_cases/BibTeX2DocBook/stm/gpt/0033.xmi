<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplex2020"
           title="Comprehensive Survey on Model-Driven Testing"
           year="2020"
           journal="Journal of Software Engineering Methods">
    <authors author="Alice Modeler"/>
    <authors author="Bob Transformer"/>
    <authors author="Carol Verifier"/>
  </entries>

  <!-- TechReport -->
  <entries xsi:type="BibTeX:TechReport"
           id="trMDE2021"
           title="Advances in Model Transformation Testing"
           year="2021">
    <authors author="Derek Analyzer"/>
  </entries>

  <!-- Unpublished -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraftMDE"
           title="Draft: Unified Approach to Bidirectional Transformations"
           note="Submitted for review, not yet accepted.">
    <authors author="Eve Bidirectional"/>
    <authors author="Frank Consistency"/>
  </entries>

  <!-- Manual -->
  <entries xsi:type="BibTeX:Manual"
           id="manualToolUserGuide"
           title="User Guide for the ATL Testing Framework"/>
  
  <!-- Proceedings (no authors, dated and titled only) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procICMDE2022"
           title="Proceedings of the 10th International Conference on Model-Driven Engineering"
           year="2022"/>

  <!-- InProceedings: authored paper within proceedings, also with booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocTrace2022"
           title="Tracing Model Transformations in Large-Scale Systems"
           year="2022"
           booktitle="Proceedings of the 10th International Conference on Model-Driven Engineering">
    <authors author="Grace Tracer"/>
    <authors author="Henry Logger"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletIntroMDE"
           year="2019"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDEPatterns"
           title="Patterns in Model-Driven Engineering"
           year="2018"
           publisher="Academic Press">
    <authors author="Ivy Pattern"/>
    <authors author="Jack Architect"/>
  </entries>

  <!-- InCollection: chapter in edited book -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollectionRefactoring"
           title="Refactoring Model Transformations"
           year="2018"
           publisher="Academic Press"
           booktitle="Patterns in Model-Driven Engineering">
    <authors author="Karen Refactor"/>
  </entries>

  <!-- InBook: chapter with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookTestingChapter"
           title="Testing and Validation of Transformations"
           year="2018"
           publisher="Academic Press"
           chapter="7">
    <authors author="Leo Tester"/>
    <authors author="Mona Validator"/>
  </entries>

  <!-- Misc: minimal, only id required -->
  <entries xsi:type="BibTeX:Misc"
           id="miscWebsiteMDEPortal"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdTraceability"
           title="Traceability Techniques for Model Transformations"
           year="2017"
           school="Technical University of Metropolis">
    <authors author="Nina Researcher"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterAutomation"
           title="Automation of Regression Testing for ATL Transformations"
           year="2019"
           school="Institute of Software Technology">
    <authors author="Oscar Graduate"/>
  </entries>

</BibTeX:BibTeXFile>