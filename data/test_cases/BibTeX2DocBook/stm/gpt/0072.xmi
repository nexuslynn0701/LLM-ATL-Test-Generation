<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art:multi-authors"
           title="A Comprehensive Study of Model Transformations"
           year="2019"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carol White"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech:transform-testing"
           title="Testing Strategies for ATL Transformations"
           year="2020">
    <authors author="David Brown"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub:early-draft"
           title="Preliminary Results on Incremental Model Transformations"
           note="Draft version, not for distribution">
    <authors author="Eva Green"/>
    <authors author="Frank Miller"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Manual (no authors, but title required) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual:atl-user-guide"
           title="ATL User Guide 4.0"/>

  <!-- Proceedings (dated and titled, but no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc:mde-2021"
           title="Proceedings of the 2021 International Conference on Model-Driven Engineering"
           year="2021"/>

  <!-- InProceedings (inherits Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc:traceability"
           title="Traceability in Large-Scale Model Transformations"
           year="2021"
           booktitle="Proceedings of the 2021 International Conference on Model-Driven Engineering">
    <authors author="Henry Clark"/>
    <authors author="Isabel Turner"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet:mde-tutorial"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book:mde-foundations"
           title="Foundations of Model-Driven Engineering"
           year="2016"
           publisher="Springer">
    <authors author="Jack Wilson"/>
    <authors author="Karen Adams"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol:chapter-qvt"
           title="Practical QVT Applications"
           year="2016"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Laura Martin"/>
  </entries>

  <!-- InBook (Book with chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook:chapter-testing"
           title="Testing of Model Transformations"
           year="2016"
           publisher="Springer"
           chapter="7">
    <authors author="Michael Scott"/>
    <authors author="Nina Perez"/>
  </entries>

  <!-- Misc (only id required) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc:online-resource"/>

  <!-- PhDThesis (ThesisEntry specialization) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd:mde-traceability"
           title="Traceability Techniques in Model-Driven Engineering"
           year="2017"
           school="Technical University of Metropolis">
    <authors author="Oliver King"/>
  </entries>

  <!-- MasterThesis (ThesisEntry specialization) with two authors (unusual but allowed) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master:atl-optimization"
           title="Optimization Techniques for ATL Transformations"
           year="2018"
           school="Institute of Software Systems">
    <authors author="Patricia Young"/>
    <authors author="Quentin Ross"/>
  </entries>

</BibTeX:BibTeXFile>