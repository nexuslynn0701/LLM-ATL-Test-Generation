<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth"
           title="A Comprehensive Study on Model-Driven Testing"
           year="2021"
           journal="Journal of Software Engineering Research">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carol Williams"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech_single_auth"
           title="Automated Verification of Model Transformations"
           year="2019">
    <authors author="David Lee"/>
  </entries>

  <!-- Unpublished with multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft"
           title="Draft Specification of a New Transformation Language"
           note="Work in progress, do not distribute">
    <authors author="Emily Clark"/>
    <authors author="Frank Miller"/>
  </entries>

  <!-- Manual without authors (allowed, since Manual only extends TitledEntry) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool"
           title="User Guide for the MetaTrans Toolset"/>
           
  <!-- Proceedings entry -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_conf"
           title="Proceedings of the International Conference on Model Engineering"
           year="2020"/>
           
  <!-- InProceedings with booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_paper"
           title="Traceability Techniques for ATL Transformations"
           year="2020"
           booktitle="Proceedings of the International Conference on Model Engineering">
    <authors author="Grace Nguyen"/>
    <authors author="Henry Adams"/>
  </entries>

  <!-- Booklet (dated but not authored, per metamodel) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_tutorial"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="TechPress Publishing">
    <authors author="Isabel Martinez"/>
    <authors author="John O&apos;Connor"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter"
           title="Testing Strategies for Model Transformations"
           year="2017"
           publisher="TechPress Publishing"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Karen Hughes"/>
  </entries>

  <!-- InBook with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_case_study"
           title="Case Studies in Model Transformation Quality"
           year="2017"
           publisher="TechPress Publishing"
           chapter="5">
    <authors author="Luis Fernandez"/>
    <authors author="Maria Rossi"/>
  </entries>

  <!-- Misc entry (no additional mandatory attributes) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_thesis_example"
           title="Formal Analysis of Model Transformations"
           year="2016"
           school="University of Metropolis">
    <authors author="Nathan Brown"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_thesis_example"
           title="Empirical Evaluation of Transformation Testing Tools"
           year="2015"
           school="City Technical University">
    <authors author="Olivia Green"/>
  </entries>

</BibTeX:BibTeXFile>