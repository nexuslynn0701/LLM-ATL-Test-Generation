<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth_2022"
           title="Multi-Author Collaboration in Model Transformations"
           year="2022"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carla Ruiz"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech_rep_2020"
           title="Testing Strategies for ATL Transformations"
           year="2020">
    <authors author="David Miller"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft_2023"
           title="Draft Specification of a BibTeX to DocBook Transformation"
           note="Manuscript in preparation">
    <authors author="Eva Thompson"/>
    <authors author="Frank Zhang"/>
  </entries>

  <!-- Manual without authors (allowed since Manual only extends TitledEntry) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_1"
           title="User Guide for the Model Transformation Toolkit"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_conf_2019"
           title="Proceedings of the 2019 Conference on Model-Driven Engineering"
           year="2019"/>

  <!-- InProceedings: authored, dated, titled, and with booktitle (via BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study"
           title="A Case Study in Bidirectional Model Transformations"
           year="2019"
           booktitle="Proceedings of the 2019 Conference on Model-Driven Engineering">
    <authors author="George King"/>
    <authors author="Hannah Lee"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_intro_mde"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_intro_atl"
           title="Introduction to ATL and Model Transformations"
           year="2017"
           publisher="Springer">
    <authors author="Ian Clark"/>
    <authors author="Julia Perez"/>
  </entries>

  <!-- InCollection: a chapter in an edited book (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_mde"
           title="Advanced Topics in Model-Driven Engineering"
           year="2017"
           publisher="Springer"
           booktitle="Collected Works on Software Engineering">
    <authors author="Laura Nguyen"/>
  </entries>

  <!-- InBook: a specific chapter in a book -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_testing"
           title="Testing Model Transformations"
           year="2016"
           publisher="Elsevier"
           chapter="5">
    <authors author="Michael Brown"/>
    <authors author="Nina Rossi"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_reference_001"/>

  <!-- PhD Thesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_thesis_robustness"
           title="Ensuring Robustness in Model Transformation Pipelines"
           year="2015"
           school="Technical University of Metropolis">
    <authors author="Oscar Diaz"/>
  </entries>

  <!-- Master Thesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_thesis_validation"
           title="Validation Techniques for Model-Driven Engineering Tools"
           year="2014"
           school="Institute of Software Systems">
    <authors author="Paula Green"/>
  </entries>

</BibTeX:BibTeXFile>