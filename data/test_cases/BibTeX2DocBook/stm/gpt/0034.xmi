<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_survey_2020"
           title="A Comprehensive Survey on Model Transformations"
           year="2020"
           journal="Journal of Software Engineering Methods">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_mde_tools_2019"
           title="Tool Support for Model-Driven Engineering"
           year="2019">
    <authors author="Carla Gomez"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_verification_2021"
           title="Verification Techniques for Model Transformations"
           note="Draft version, to be submitted to TSE">
    <authors author="David Lee"/>
    <authors author="Eva Müller"/>
  </entries>

  <!-- Manual without authors -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_atl_guide"
           title="ATL Transformation Language User Guide"/>
  
  <!-- Proceedings entry (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_conf_2018"
           title="Proceedings of the International Conference on Model-Driven Engineering"
           year="2018"/>
  
  <!-- InProceedings with authors and booktitle, based on a proceedings-like context -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_testing_atl_2018"
           title="Systematic Testing of ATL Transformations"
           year="2018"
           booktitle="Proceedings of the International Conference on Model-Driven Engineering">
    <authors author="Frank Nguyen"/>
  </entries>

  <!-- Booklet (dated entry without title) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_intro"
           year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_principles"
           title="Principles of Model-Driven Engineering"
           year="2016"
           publisher="TechPress Publishing">
    <authors author="Grace Hopper"/>
    <authors author="Henry Ford"/>
  </entries>

  <!-- InCollection: chapter in an edited book -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_model_validation"
           title="Model Validation Techniques"
           year="2016"
           publisher="TechPress Publishing"
           booktitle="Principles of Model-Driven Engineering">
    <authors author="Isabel Clark"/>
  </entries>

  <!-- InBook: specific chapter in the same book -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_case_studies"
           title="Case Studies in Model Transformations"
           year="2016"
           publisher="TechPress Publishing"
           chapter="5">
    <authors author="Grace Hopper"/>
  </entries>

  <!-- Misc entry, minimal -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource_1"/>

  <!-- PhDThesis with all required fields -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_mde_security"
           title="Security-Aware Model-Driven Engineering"
           year="2015"
           school="University of Technology">
    <authors author="Jack Brown"/>
  </entries>

  <!-- MasterThesis with all required fields -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_model_testing"
           title="Model-Based Testing of Transformations"
           year="2014"
           school="Institute of Computer Science">
    <authors author="Karen Davis"/>
  </entries>

</BibTeX:BibTeXFile>