<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_smt2023"
           title="Scalable Model Transformations for Heterogeneous Systems"
           year="2023"
           journal="Journal of Model Engineering">
    <authors author="Alice Schmidt"/>
    <authors author="Bruno Keller"/>
    <authors author="Chen Li"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_test_2021"
           title="Testing Strategies for Model Transformations"
           year="2021">
    <authors author="Dana Rossi"/>
  </entries>

  <!-- Unpublished with two authors and a note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_mde_survey"
           title="A Comprehensive Survey on Model-Driven Engineering Tools"
           note="Draft available on personal website">
    <authors author="Elias Novak"/>
    <authors author="Fatima Oliveira"/>
  </entries>

  <!-- Manual without authors (allowed, since Manual only extends TitledEntry) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_v2"
           title="USER GUIDE: TransformationBench v2.0"/>
  
  <!-- Proceedings (titled and dated, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mdeconf_2022"
           title="Proceedings of the 10th International Conference on Model Engineering"
           year="2022"/>

  <!-- InProceedings: inherits year/title from Proceedings,
       plus booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_perf_2022"
           title="Performance Analysis of Incremental Model Transformations"
           year="2022"
           booktitle="Proceedings of the 10th International Conference on Model Engineering">
    <authors author="Giorgio Conti"/>
    <authors author="Hannah Weiss"/>
  </entries>

  <!-- Booklet: only dated -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_intro"
           year="2019"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns"
           title="Patterns in Model-Driven Engineering"
           year="2020"
           publisher="TechPress Publishing">
    <authors author="Ivan Petrov"/>
    <authors author="Julia Martin"/>
  </entries>

  <!-- InCollection: chapter in an edited book (booktitle attribute present) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_validation"
           title="Validation Techniques for Transformation Chains"
           year="2020"
           publisher="TechPress Publishing"
           booktitle="Patterns in Model-Driven Engineering">
    <authors author="Julia Martin"/>
    <authors author="Kevin Young"/>
  </entries>

  <!-- InBook: chapter in a book, with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_case_study"
           title="Case Study: Industrial Adoption of MDE"
           year="2020"
           publisher="TechPress Publishing"
           chapter="7">
    <authors author="Ivan Petrov"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_dataset_mde"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_traceability"
           title="Traceability Management in Large-Scale Model Transformations"
           year="2018"
           school="University of Techville">
    <authors author="Laura Nguyen"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_tooling"
           title="Tool Support for Testing ATL Transformations"
           year="2019"
           school="Institute of Software Systems">
    <authors author="Marco Silva"/>
  </entries>

</BibTeX:BibTeXFile>