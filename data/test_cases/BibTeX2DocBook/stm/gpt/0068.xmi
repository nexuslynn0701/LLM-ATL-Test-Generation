<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020semantic"
           title="Semantic Integration of Heterogeneous Models"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="John Smith"/>
    <authors author="Maria Rossi"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="lee2019mde"
           title="Model-Driven Engineering in Practice"
           year="2019">
    <authors author="Kevin Lee"/>
  </entries>

  <!-- Unpublished work, multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="garcia2023draft"
           title="Draft Techniques for Incremental Transformations"
           note="Internal working draft, not for distribution.">
    <authors author="Ana Garcia"/>
    <authors author="Michael Brown"/>
  </entries>

  <!-- Manual (titled only, no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="toolManualV3"
           title="Atlas Transformation Tool User Manual v3.0"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmt2021proc"
           title="Proceedings of the 14th International Conference on Model Transformations"
           year="2021"/>

  <!-- InProceedings (inherits date/title from Proceedings plus authors and booktitle) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="miller2021trace"
           title="Traceability in Large-Scale Transformation Chains"
           year="2021"
           booktitle="Proceedings of the 14th International Conference on Model Transformations">
    <authors author="Sarah Miller"/>
    <authors author="David Nguyen"/>
  </entries>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="anderson2018foundations"
           title="Foundations of Model Transformation"
           year="2018"
           publisher="TechPress Publishing">
    <authors author="Laura Anderson"/>
    <authors author="Peter Johnson"/>
  </entries>

  <!-- InCollection (book + booktitle) -->
  <entries xsi:type="BibTeX:InCollection"
           id="anderson2018chapter5"
           title="Chapter 5: Advanced ATL Patterns"
           year="2018"
           publisher="TechPress Publishing"
           booktitle="Foundations of Model Transformation">
    <authors author="Laura Anderson"/>
  </entries>

  <!-- InBook (book with chapter number) -->
  <entries xsi:type="BibTeX:InBook"
           id="johnson2018chap2"
           title="Introduction to Operational Transformations"
           year="2018"
           publisher="TechPress Publishing"
           chapter="2">
    <authors author="Peter Johnson"/>
  </entries>

  <!-- Booklet (dated only, minimal) -->
  <entries xsi:type="BibTeX:Booklet"
           id="promo2022"
           year="2022"/>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscRef01"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="schmidt2017phd"
           title="Consistency Management in Model-Driven Development"
           year="2017"
           school="Technical University of Metropolis">
    <authors author="Thomas Schmidt"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="kumar2020msc"
           title="Testing of Model Transformations Using Mutation Analysis"
           year="2020"
           school="Metropolis Institute of Technology">
    <authors author="Priya Kumar"/>
  </entries>

</BibTeX:BibTeXFile>