<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_2020"
           year="2020"
           title="Model Transformation Testing in Practice"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_single_2019"
           year="2019"
           title="An Industrial Survey on ATL Transformations">
    <authors author="Carol Miller"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft_2021"
           title="Draft Guidelines for Bidirectional Transformations"
           note="To appear, internal review version">
    <authors author="David Brown"/>
    <authors author="Eve Davis"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_2018"
           title="User Manual for the MetaTrans Toolset"/>
           
  <!-- Proceedings with date and title -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_2017"
           year="2017"
           title="Proceedings of the 10th International Conference on Model-Driven Engineering"/>

  <!-- InProceedings: inherits year, title from Proceedings; has authors and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_2017"
           year="2017"
           title="A Case Study on Testing ATL Refinement Rules"
           booktitle="Proceedings of the 10th International Conference on Model-Driven Engineering">
    <authors author="Frank Green"/>
    <authors author="Grace Hall"/>
  </entries>

  <!-- Booklet: only dated, no title/authors -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_overview_2016"
           year="2016"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_intro_2015"
           year="2015"
           title="Introduction to Model-Driven Engineering"
           publisher="TechPress">
    <authors author="Helen King"/>
    <authors author="Ian Lee"/>
  </entries>

  <!-- InCollection: book-like with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_2015"
           year="2015"
           title="Coverage Criteria for Model Transformations"
           publisher="TechPress"
           booktitle="Handbook of Software Engineering Research">
    <authors author="Jack Moore"/>
  </entries>

  <!-- InBook: specific chapter in a book -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter3_2014"
           year="2014"
           title="Formal Semantics of Transformation Languages"
           publisher="Academic Publishing"
           chapter="3">
    <authors author="Karen Nelson"/>
    <authors author="Leo Ortiz"/>
  </entries>

  <!-- Misc: minimal, no extra attributes -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_web_resource_2022"/>

  <!-- PhDThesis with required school -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_mde_2013"
           year="2013"
           title="Testing and Verification of Model Transformations"
           school="University of Metropolis">
    <authors author="Maria Perez"/>
  </entries>

  <!-- MasterThesis with different school -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_mde_2012"
           year="2012"
           title="Empirical Evaluation of Transformation Testing Tools"
           school="Institute of Software Technology">
    <authors author="Nick Quinn"/>
  </entries>

</BibTeX:BibTeXFile>