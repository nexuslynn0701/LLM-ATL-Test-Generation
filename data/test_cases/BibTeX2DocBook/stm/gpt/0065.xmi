<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artMultiAuthors2023"
           title="Concurrent Transformations in Model-Driven Engineering"
           year="2023"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Duarte"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techRepMDE2022"
           title="Scalability of Model Transformation Testing"
           year="2022">
    <authors author="Diana Rose"/>
  </entries>

  <!-- Unpublished item -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraft2021"
           title="Draft Semantics for Incremental ATL"
           note="Submitted to MDE Symposium, under revision">
    <authors author="Ethan Brown"/>
    <authors author="Fiona Green"/>
  </entries>

  <!-- Manual (no authors, only title required) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualToolUserGuide"
           title="User Guide for the MetaTrans Tester 3.0"/>

  <!-- Proceedings (dated + titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procMDEConf2020"
           title="Proceedings of the 5th Conference on Model Transformations"
           year="2020"/>

  <!-- InProceedings: authored, dated, titled + booktitle, in proceedings style -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inProcSession2020"
           title="Coverage Criteria for ATL Transformations"
           year="2020"
           booktitle="Proceedings of the 5th Conference on Model Transformations">
    <authors author="George Hill"/>
    <authors author="Hannah Lee"/>
  </entries>

  <!-- Booklet (only year required) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletShortIntro"
           year="2019"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="bookAdvancedMDE2018"
           title="Advanced Topics in Model-Driven Engineering"
           year="2018"
           publisher="Springer">
    <authors author="Ian Clark"/>
    <authors author="Julia Adams"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry (chapter in an edited book) -->
  <entries xsi:type="BibTeX:InCollection"
           id="inCollectionChap5"
           title="Testing Strategies for Declarative Model Transformations"
           year="2018"
           publisher="Springer"
           booktitle="Advanced Topics in Model-Driven Engineering">
    <authors author="Kevin Martin"/>
  </entries>

  <!-- InBook: chapter of a book -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookCaseStudy"
           title="Industrial Case Studies in Model Transformation"
           year="2017"
           publisher="Elsevier"
           chapter="7">
    <authors author="Laura Perez"/>
    <authors author="Michael Young"/>
  </entries>

  <!-- Misc: minimal entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscWebResource"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisRefinement"
           title="Refinement Techniques for Model Transformations"
           year="2016"
           school="University of Metamodeling">
    <authors author="Natalie Owen"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisTesting"
           title="Automated Testing Frameworks for ATL"
           year="2015"
           school="Institute of Software Modeling">
    <authors author="Oliver King"/>
  </entries>

</BibTeX:BibTeXFile>