<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article" id="art_multi_auth" title="A Comprehensive Study of Model Transformations" year="2018" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carol Lee"/>
  </entries>

  <!-- TechReport single author -->
  <entries xsi:type="BibTeX:TechReport" id="tr_single_auth" title="Automated Testing of Model Transformations" year="2019">
    <authors author="David Miller"/>
  </entries>

  <!-- Unpublished, multiple authors -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub_draft" title="Draft Specification of a New Modeling Language" note="Work in progress, do not cite">
    <authors author="Emily Davis"/>
    <authors author="Frank Nguyen"/>
  </entries>

  <!-- Manual (no authors, no date, only title) -->
  <entries xsi:type="BibTeX:Manual" id="manual_tool_guide" title="User Guide for the MetaTool Suite"/>
  
  <!-- Proceedings (dated and titled, but no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc_mde_symp" title="Proceedings of the 5th Symposium on Model-Driven Engineering" year="2020"/>

  <!-- InProceedings: authored, dated, titled, and booktitle, inherits from Proceedings -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc_keynote" title="Keynote on the Future of Model-Driven Engineering" year="2020" booktitle="Proceedings of the 5th Symposium on Model-Driven Engineering">
    <authors author="Grace Hopper"/>
    <authors author="Henry Ford"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet_intro_mde" year="2015"/>

  <!-- Book with multiple authors and required publisher -->
  <entries xsi:type="BibTeX:Book" id="book_mde_patterns" title="Patterns in Model-Driven Engineering" year="2016" publisher="Academic Press">
    <authors author="Irene Clark"/>
    <authors author="James Wilson"/>
  </entries>

  <!-- InCollection: book chapter in an edited volume -->
  <entries xsi:type="BibTeX:InCollection" id="incollection_chapter" title="Chapter on Testing Model Transformations" year="2016" publisher="Academic Press" booktitle="Patterns in Model-Driven Engineering">
    <authors author="Kelly Brown"/>
  </entries>

  <!-- InBook: specific chapter in a book, with chapter number -->
  <entries xsi:type="BibTeX:InBook" id="inbook_case_study" title="Case Studies in Model Transformation Testing" year="2017" publisher="Tech Books Ltd." chapter="7">
    <authors author="Laura Green"/>
    <authors author="Michael Scott"/>
  </entries>

  <!-- Misc: minimal entry, only id required -->
  <entries xsi:type="BibTeX:Misc" id="misc_web_resource"/>

  <!-- PhDThesis: ThesisEntry subtype -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd_mde" title="Scalable Techniques for Model Transformation Testing" year="2014" school="University of Metropolis">
    <authors author="Nina Peterson"/>
  </entries>

  <!-- MasterThesis: ThesisEntry subtype -->
  <entries xsi:type="BibTeX:MasterThesis" id="master_incremental" title="Incremental Testing Strategies for ATL Transformations" year="2013" school="Tech University">
    <authors author="Oscar Ramirez"/>
  </entries>

</BibTeX:BibTeXFile>