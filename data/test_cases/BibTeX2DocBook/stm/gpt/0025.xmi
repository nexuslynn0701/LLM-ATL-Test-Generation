<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_smt_solver_2018"
           year="2018"
           title="Incremental SMT Solving for Large-Scale Verification"
           journal="Journal of Automated Reasoning">
    <authors author="Elena Kovacs"/>
    <authors author="Martin Schulz"/>
    <authors author="Priya Raman"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_mde_tools_2020"
           year="2020"
           title="Tool Support for Industrial Model-Driven Engineering"/>
    <!-- inherits authors/year/title from supertypes -->
    <authors author="Lars Petersen"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_stream_types"
           title="A Unified Theory of Stream-Based Type Systems"
           note="Draft under submission, do not distribute">
    <authors author="Hannah Lee"/>
    <authors author="Carlos Gómez"/>
  </entries>

  <!-- Manual (title only, no authors or year required) -->
  <entries xsi:type="BibTeX:Manual"
           id="man_ci_pipeline"
           title="Continuous Integration Pipeline Configuration Reference"/>
           
  <!-- Proceedings (dated + titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_models_2019"
           year="2019"
           title="Proceedings of the 22nd International Conference on Model Driven Engineering Languages and Systems"/>

  <!-- InProceedings combines proceedings, authors, and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_variant_mgmt"
           year="2019"
           title="Managing Variability in Large Model Repositories"
           booktitle="Proceedings of the 22nd International Conference on Model Driven Engineering Languages and Systems">
    <authors author="Nora Bauer"/>
    <authors author="Ahmed Hassan"/>
  </entries>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns"
           year="2015"
           title="Patterns and Best Practices in Model-Driven Engineering"
           publisher="Springer">
    <authors author="Julia Novak"/>
    <authors author="Thomas Brown"/>
  </entries>

  <!-- InCollection reusing Book features plus booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol_transform_testing"
           year="2015"
           title="Testing Transformations in Model-Driven Workflows"
           publisher="Springer"
           booktitle="Patterns and Best Practices in Model-Driven Engineering">
    <authors author="Julia Novak"/>
    <authors author="Sven Richter"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_model_validation"
           year="2015"
           title="Practical Approaches to Model Validation"
           publisher="Springer"
           chapter="7">
    <authors author="Thomas Brown"/>
  </entries>

  <!-- Booklet (only year required) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_tutorial"
           year="2017"/>

  <!-- Misc (only id required) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_tool_website"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_model_evolution"
           year="2014"
           title="Model Evolution and Co-Consistency in Large Systems"
           school="Technical University of Munich">
    <authors author="Robert Klein"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_delta_transformations"
           year="2021"
           title="Delta-Based Approaches to Model Transformation"
           school="University of Waterloo">
    <authors author="Sara Ibrahim"/>
  </entries>

</BibTeX:BibTeXFile>