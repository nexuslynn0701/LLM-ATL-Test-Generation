<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with three authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplex"
           title="A Comprehensive Survey on Model Transformation Testing"
           year="2023"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carol White"/>
  </entries>

  <!-- TechReport with multiple authors -->
  <entries xsi:type="BibTeX:TechReport"
           id="techRep01"
           title="Industrial Experiences with ATL Transformations"
           year="2021">
    <authors author="David Brown"/>
    <authors author="Eve Green"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraft"
           title="Draft Guidelines for Metamodel Evolution"
           note="To appear; internal review version">
    <authors author="Frank Miller"/>
  </entries>

  <!-- Manual without authors (allowed, since Manual is only TitledEntry) -->
  <entries xsi:type="BibTeX:Manual"
           id="manUserGuide"
           title="ATL Transformation Engine User Guide"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procConf2020"
           title="Proceedings of the International Conference on Model Engineering"
           year="2020"/>
           
  <!-- InProceedings that refers to a proceedings volume conceptually (inherits Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inProcKeynote"
           title="Keynote on Scalable Model Transformations"
           year="2020"
           booktitle="Proceedings of the International Conference on Model Engineering">
    <authors author="Grace Hopper"/>
    <authors author="Henry Ford"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletFlyer"
           year="2019"/>

  <!-- Book with two authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDEIntro"
           title="Introduction to Model-Driven Engineering"
           year="2018"
           publisher="TechPress">
    <authors author="Irene Novak"/>
    <authors author="John Clark"/>
  </entries>

  <!-- InCollection: chapter in an edited book (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="inCollChap5"
           title="Testing Strategies for Model Transformations"
           year="2018"
           publisher="TechPress"
           booktitle="Introduction to Model-Driven Engineering">
    <authors author="Karen Davis"/>
  </entries>

  <!-- InBook: specific chapter number in a book -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookChap2"
           title="Fundamentals of ATL Transformations"
           year="2017"
           publisher="Springer"
           chapter="2">
    <authors author="Liam O&apos;Connor"/>
  </entries>

  <!-- Misc entry with only required id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscNote01"/>

  <!-- PhDThesis with single author -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisModelTesting"
           title="Automated Testing of Model Transformations"
           year="2016"
           school="University of Model Engineering">
    <authors author="Maria Lopez"/>
  </entries>

  <!-- MasterThesis with two authors (unusual but structurally allowed) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisTrace"
           title="Traceability in Bidirectional Transformations"
           year="2015"
           school="Technical University of Systems">
    <authors author="Nina Patel"/>
    <authors author="Oscar Ramirez"/>
  </entries>

</BibTeX:BibTeXFile>