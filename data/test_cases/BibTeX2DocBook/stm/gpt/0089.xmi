<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_authors_2021"
           year="2021"
           title="Multi-Author Perspectives on Model-Driven Variability"
           journal="Journal of Advanced MDE">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_single_author_2019"
           year="2019"
           title="Industrial Experiences with ATL Transformations">
    <authors author="Dana Müller"/>
  </entries>

  <!-- Unpublished with two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft_2020"
           title="Draft Semantics for Incremental Model Transformations"
           note="Work in progress, to be submitted to MODELS 2026">
    <authors author="Evan Lee"/>
    <authors author="Fatima al-Hassan"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_guide_2018"
           title="User Guide for the TransForge Toolset"/>
  
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_symposium_2022"
           year="2022"
           title="Proceedings of the 10th Symposium on Model Engineering"/>
  
  <!-- InProceedings with authors and booktitle, inheriting year/title from Proceedings and booktitle from BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study_2022"
           year="2022"
           title="A Case Study on Testing Bidirectional Transformations"
           booktitle="Proceedings of the 10th Symposium on Model Engineering">
    <authors author="George Brown"/>
    <authors author="Hiroko Tanaka"/>
  </entries>

  <!-- Booklet (only year, no title or authors) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_intro_models_2017"
           year="2017"/>
  
  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns_2015"
           year="2015"
           title="Patterns and Best Practices in Model-Driven Engineering"
           publisher="Springer">
    <authors author="Isabelle Dupont"/>
    <authors author="Jürgen Vogel"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_constraints_2016"
           year="2016"
           title="Constraint Specification in Model Transformations"
           publisher="Morgan &amp; Claypool"
           booktitle="Collected Readings on Model Transformations">
    <authors author="Karen O&apos;Neil"/>
  </entries>

  <!-- InBook extending Book, with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_testing_2014"
           year="2014"
           title="Testing Model Transformations"
           publisher="Elsevier"
           chapter="7">
    <authors author="Liam Chen"/>
    <authors author="Maria Rossi"/>
  </entries>

  <!-- Misc with only id (no additional attributes required) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource_mde_2023"/>
  
  <!-- PhDThesis (ThesisEntry subtype) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_transform_verification_2020"
           year="2020"
           title="Formal Verification Techniques for Model Transformations"
           school="Technical University of Munich">
    <authors author="Nikolai Petrov"/>
  </entries>

  <!-- MasterThesis (ThesisEntry subtype) with multiple authors is unusual but allowed -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_model_evolution_2018"
           year="2018"
           title="Managing Model Evolution in Large-Scale Systems"
           school="University of Edinburgh">
    <authors author="Olivia Martinez"/>
    <authors author="Peter Wang"/>
  </entries>

</BibTeX:BibTeXFile>