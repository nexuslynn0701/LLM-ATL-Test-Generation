<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_advanced_mde_2021"
           title="Advanced Topics in Model-Driven Engineering"
           year="2021"
           journal="Journal of Software Modeling">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_mde_survey_2019"
           title="A Comprehensive Survey on Model Transformations"
           year="2019">
    <authors author="Carlos Martinez"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_dsl_case_study"
           title="Domain-Specific Languages for Cyber-Physical Systems: A Case Study"
           note="Manuscript in preparation">
    <authors author="Diana Lee"/>
    <authors author="Edward Kim"/>
    <authors author="Fiona Brown"/>
  </entries>

  <!-- Manual (no authors, title only) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_reference"
           title="Reference Manual for the MDE Tool Suite"/>
           
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_conf_2020"
           title="Proceedings of the 10th International Conference on Model-Driven Engineering"
           year="2020"/>
           
  <!-- InProceedings referencing a proceedings-like entry via booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_model_validation"
           title="Model Transformation Validation in Practice"
           year="2020"
           booktitle="Proceedings of the 10th International Conference on Model-Driven Engineering">
    <authors author="George Clark"/>
    <authors author="Helen Davis"/>
  </entries>

  <!-- Booklet (dated only, minimal) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_intro"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns"
           title="Patterns and Best Practices in Model-Driven Engineering"
           year="2017"
           publisher="TechPress Publishers">
    <authors author="Ian Thompson"/>
    <authors author="Julia Wang"/>
  </entries>

  <!-- InCollection: in a book, with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_metamodeling"
           title="Metamodeling Techniques for Large-Scale Systems"
           year="2017"
           publisher="TechPress Publishers"
           booktitle="Patterns and Best Practices in Model-Driven Engineering">
    <authors author="Kevin White"/>
  </entries>

  <!-- InBook: a chapter of the same book -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_tooling"
           title="Tool Support for Model-Driven Engineering"
           year="2017"
           publisher="TechPress Publishers"
           chapter="5">
    <authors author="Laura Green"/>
    <authors author="Michael Black"/>
  </entries>

  <!-- Misc: minimal non-typed entry -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_mde_website"/>
           
  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_model_transformation"
           title="Scalable Model Transformation Techniques"
           year="2016"
           school="Institute of Software Engineering">
    <authors author="Nancy Young"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_mde_testing"
           title="Testing Approaches for Model Transformations"
           year="2015"
           school="Department of Computer Science">
    <authors author="Oscar Perez"/>
  </entries>

</BibTeX:BibTeXFile>