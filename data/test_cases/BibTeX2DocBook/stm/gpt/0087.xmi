<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_complex_2020"
           title="Model-Driven Engineering in Practice"
           year="2020"
           journal="Journal of Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_industrial_2019"
           title="Industrial Applications of Model Transformations"
           year="2019">
    <authors author="Carol Williams"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft_2021"
           title="Draft Specification for a Transformation Language"
           note="Draft in internal review">
    <authors author="Daniel Brown"/>
    <authors author="Eva Green"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_guide"
           title="User Guide for the Transformation Workbench"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_conf_2018"
           title="Proceedings of the International Conference on Model-Driven Engineering"
           year="2018"/>

  <!-- InProceedings: inherits title/year via Proceedings, plus booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study_2018"
           title="A Case Study in Bidirectional Model Transformations"
           year="2018"
           booktitle="Proceedings of the International Conference on Model-Driven Engineering">
    <authors author="Frank Harris"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Booklet: only dated entry -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_overview_2017"
           year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_textbook"
           title="Foundations of Model-Driven Engineering"
           year="2016"
           publisher="TechPress Publishing">
    <authors author="Henry Adams"/>
    <authors author="Irene Clark"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry (chapter in edited book) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_5"
           title="Testing of Model Transformations"
           year="2016"
           publisher="TechPress Publishing"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Jack Miller"/>
    <authors author="Karen Davis"/>
  </entries>

  <!-- InBook: Book with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_10"
           title="Advanced Topics in Metamodeling"
           year="2016"
           publisher="TechPress Publishing"
           chapter="10">
    <authors author="Laura Scott"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_smith_2015"
           title="Scalable Techniques for Model Transformation Testing"
           year="2015"
           school="University of Metropolis">
    <authors author="Michael Smith"/>
  </entries>

  <!-- MasterThesis with two authors is uncommon but allowed by metamodel -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_dual_2014"
           title="Empirical Evaluation of MDE Toolchains"
           year="2014"
           school="Tech University">
    <authors author="Nina Rogers"/>
    <authors author="Oliver Turner"/>
  </entries>

</BibTeX:BibTeXFile>