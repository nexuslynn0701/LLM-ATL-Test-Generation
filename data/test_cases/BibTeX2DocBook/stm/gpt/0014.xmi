<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth_2023"
           title="Model-Driven Testing of Complex Transformations"
           year="2023"
           journal="Journal of Model Engineering">
    <authors author="Alice Example"/>
    <authors author="Bob Sample"/>
    <authors author="Carol Tester"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_mde_2022"
           title="Industrial Experiences with ATL Transformations"
           year="2022">
    <authors author="David Researcher"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft_2021"
           title="Draft Specification of a BibTeX to DocBook Transformation"
           note="Internal draft, not for distribution">
    <authors author="Eve Architect"/>
    <authors author="Frank Contributor"/>
  </entries>

  <!-- Manual (no authors, just title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_guide"
           title="User Guide for the Model Transformation Workbench"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_conf_2020"
           title="Proceedings of the 2020 Conference on Model Engineering"
           year="2020"/>

  <!-- InProceedings: shares characteristics of proceedings, authored and booktitled -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study_2020"
           title="A Case Study on Testing Bidirectional Transformations"
           year="2020"
           booktitle="Proceedings of the 2020 Conference on Model Engineering">
    <authors author="Grace Analyst"/>
    <authors author="Henry Engineer"/>
  </entries>

  <!-- Booklet (only dated, minimal) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_intro"
           year="2019"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns"
           title="Patterns for Model Transformations"
           year="2018"
           publisher="Modeling Press">
    <authors author="Ivy Patternsmith"/>
    <authors author="Jack Designer"/>
  </entries>

  <!-- InCollection: chapter in an edited book (booktitled and authored) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_2018"
           title="Testing Strategies for DSL Transformations"
           year="2018"
           publisher="Modeling Press"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Karen Tester"/>
  </entries>

  <!-- InBook with chapter attribute -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter5_mde"
           title="Automated Test Generation from Metamodels"
           year="2017"
           publisher="Software Engineering Publications"
           chapter="5">
    <authors author="Liam Developer"/>
    <authors author="Mia Quality"/>
  </entries>

  <!-- Misc entry (only id mandatory) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_mde_testing_2016"
           title="Testing Model Transformations in Practice"
           year="2016"
           school="University of Model Engineering">
    <authors author="Noah Scholar"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_mde_evaluation_2015"
           title="Evaluating Quality of Model Transformations"
           year="2015"
           school="Institute of Software Technology">
    <authors author="Olivia Graduate"/>
  </entries>

</BibTeX:BibTeXFile>