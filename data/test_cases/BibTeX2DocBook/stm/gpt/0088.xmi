<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020deep"
           title="Deep Learning for Model Transformations"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="John Smith"/>
    <authors author="Emily Clark"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="miller2018survey"
           title="A Survey on Model-Driven Testing"
           year="2018">
    <authors author="Alice Miller"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="doe2021draft"
           title="Draft Guidelines for ATL Testing"
           note="Draft version, not yet submitted.">
    <authors author="Jane Doe"/>
    <authors author="Robert King"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="atlmanual2022"
           title="ATL Transformation Language Reference Manual"/>
  
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmt2023"
           title="Proceedings of the 16th International Conference on Model Transformation"
           year="2023"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="garcia2023testing"
           title="Testing Strategies for Bidirectional Transformations"
           year="2023"
           booktitle="Proceedings of the 16th International Conference on Model Transformation">
    <authors author="Luis Garcia"/>
  </entries>

  <!-- Booklet: dated only -->
  <entries xsi:type="BibTeX:Booklet"
           id="introMDE2015"
           year="2015"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="brown2017mde"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Michael Brown"/>
    <authors author="Sarah Johnson"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="johnson2017chapter"
           title="Model Transformation Testing in Practice"
           year="2017"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Sarah Johnson"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="brown2017chapter5"
           title="Advanced Topics in ATL"
           year="2017"
           publisher="Springer"
           chapter="5">
    <authors author="Michael Brown"/>
  </entries>

  <!-- Misc: minimal concrete BibTeXEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="toolwebsite2024"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="lee2019phd"
           title="Quality Assurance in Model Transformations"
           year="2019"
           school="Technical University of Metamodeling">
    <authors author="David Lee"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="nguyen2020msc"
           title="Automated Testing of ATL Transformations"
           year="2020"
           school="Institute of Software Engineering">
    <authors author="Linh Nguyen"/>
  </entries>

</BibTeX:BibTeXFile>