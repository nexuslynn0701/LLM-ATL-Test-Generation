<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- An Article with multiple authors -->
  <entries xsi:type="BibTeX:Article" id="art_multi_auth" title="Scalable Model Transformations" year="2018" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carol White"/>
  </entries>

  <!-- A TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport" id="techrep_single" title="Testing Model Transformations" year="2019">
    <authors author="David Brown"/>
  </entries>

  <!-- An Unpublished entry with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub_draft" title="Draft on Incremental Transformations" note="To appear in conference proceedings">
    <authors author="Eve Davis"/>
    <authors author="Frank Miller"/>
  </entries>

  <!-- A Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual" id="manual_tool" title="ATL Transformation Toolkit User Guide"/>

  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="proceed_conf2020" title="Proceedings of the 10th MDE Conference" year="2020"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc_case_study" title="Case Studies in Model-Driven Testing" year="2020" booktitle="Proceedings of the 10th MDE Conference">
    <authors author="Grace Lee"/>
    <authors author="Henry Adams"/>
  </entries>

  <!-- A Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet_intro" year="2017"/>

  <!-- A Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book" id="book_mde_intro" title="Introduction to Model-Driven Engineering" year="2015" publisher="Springer">
    <authors author="Ian Green"/>
    <authors author="Julia Black"/>
  </entries>

  <!-- An InCollection: Book + BookTitledEntry (chapter in an edited book) -->
  <entries xsi:type="BibTeX:InCollection" id="incollection_chapter" title="Verification of Transformations" year="2016" publisher="ACM Press" booktitle="Advances in Model Transformations">
    <authors author="Karen Turner"/>
    <authors author="Laura Scott"/>
  </entries>

  <!-- An InBook: Book + specific chapter (EInt) -->
  <entries xsi:type="BibTeX:InBook" id="inbook_chapter5" title="Industrial Experiences" year="2015" publisher="Springer" chapter="5">
    <authors author="Michael Reed"/>
  </entries>

  <!-- A Misc entry (only id required) -->
  <entries xsi:type="BibTeX:Misc" id="misc_website"/>

  <!-- A PhDThesis (ThesisEntry) with school -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd_thesis_mde" title="Model-Driven Engineering for Large Systems" year="2014" school="Technical University of Metropolis">
    <authors author="Nina Clark"/>
  </entries>

  <!-- A MasterThesis (ThesisEntry) with school and another year -->
  <entries xsi:type="BibTeX:MasterThesis" id="msc_thesis_testing" title="Automated Testing of Model Transformations" year="2021" school="Institute of Software Technology">
    <authors author="Oscar Perez"/>
  </entries>

</BibTeX:BibTeXFile>