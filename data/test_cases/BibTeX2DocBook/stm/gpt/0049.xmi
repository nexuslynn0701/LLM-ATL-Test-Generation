<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artSmith2020DeepLearning"
           title="Deep Learning Approaches for Model Transformations"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="John Smith"/>
    <authors author="Emily Clark"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="trMiller2018Testing"
           title="Systematic Testing of Model Transformations"
           year="2018">
    <authors author="Alice Miller"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubGarcia2023Survey"
           title="A Survey of Bidirectional Transformations"
           note="Submitted for publication; preprint available online.">
    <authors author="Carlos Garcia"/>
    <authors author="Dana Zhou"/>
  </entries>

  <!-- Manual without authors -->
  <entries xsi:type="BibTeX:Manual"
           id="manualATL2021"
           title="ATL Transformation Language Reference Manual"/>
  
  <!-- Proceedings (no authors, conference-like) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procMDEConf2019"
           title="Proceedings of the 2019 Conference on Model-Driven Engineering"
           year="2019"/>
  
  <!-- InProceedings, inheriting date/title/booktitle plus authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocLee2019Traceability"
           title="Traceability Techniques in ATL Transformations"
           year="2019"
           booktitle="Proceedings of the 2019 Conference on Model-Driven Engineering">
    <authors author="Sung Lee"/>
  </entries>

  <!-- Book, will also serve as container basis for InCollection/InBook semantics -->
  <entries xsi:type="BibTeX:Book"
           id="bookBrown2022MDE"
           title="Foundations of Model-Driven Engineering"
           year="2022"
           publisher="TechPress Publications">
    <authors author="Robert Brown"/>
    <authors author="Helen Young"/>
  </entries>

  <!-- InCollection referencing a book title via booktitle attribute -->
  <entries xsi:type="BibTeX:InCollection"
           id="incolNguyen2022Chapter"
           title="Testing Strategies for Model Transformations"
           year="2022"
           publisher="TechPress Publications"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Linh Nguyen"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookBrown2022Chap3"
           title="Advanced Topics in Model Transformation Testing"
           year="2022"
           publisher="TechPress Publications"
           chapter="3">
    <authors author="Robert Brown"/>
  </entries>

  <!-- Booklet, only dated entry -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletIntroMDE2017"
           year="2017"/>
  
  <!-- Misc with minimal data (only id) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscToolWebsite2024"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdKhan2021Validation"
           title="Validation Techniques for Model Transformations"
           year="2021"
           school="University of Software Engineering">
    <authors author="Asim Khan"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mscLopez2020ATL"
           title="Improving ATL Transformations Through Automated Refactoring"
           year="2020"
           school="Institute of Computer Science">
    <authors author="Maria Lopez"/>
  </entries>

</BibTeX:BibTeXFile>