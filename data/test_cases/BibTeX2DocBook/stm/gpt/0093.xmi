<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth"
           year="2018"
           title="Collaborative Modeling in Heterogeneous Environments"
           journal="International Journal of Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Charlie Nguyen"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech_single_auth"
           year="2015"
           title="Model Transformation Testing: A Survey">
    <authors author="Dana Miller"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_working_draft"
           title="Towards a Unified Framework for Traceability in MDE"
           note="Manuscript under revision">
    <authors author="Ethan Clark"/>
    <authors author="Fiona Garcia"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_guide"
           title="ToolX User Guide Version 3.2"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_conf_2020"
           year="2020"
           title="Proceedings of the 10th International Conference on Model Transformations"/>
           
  <!-- InProceedings that inherits from Proceedings, AuthoredEntry, and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_keynote_paper"
           year="2020"
           title="Scaling Model Transformations for Industrial Systems"
           booktitle="Proceedings of the 10th International Conference on Model Transformations">
    <authors author="Grace Lee"/>
    <authors author="Henry Adams"/>
  </entries>

  <!-- Booklet (only year required) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_intro_mde"
           year="2013"/>

  <!-- Book with authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_principles"
           year="2011"
           title="Principles of Model-Driven Engineering"
           publisher="TechPress Publishing">
    <authors author="Isabella Perez"/>
    <authors author="Jack Thompson"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter"
           year="2011"
           title="Testing of Model Transformations"
           publisher="TechPress Publishing"
           booktitle="Principles of Model-Driven Engineering">
    <authors author="Isabella Perez"/>
    <authors author="Laura Kim"/>
  </entries>

  <!-- InBook extending Book, with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_case_study"
           year="2011"
           title="Industrial Case Studies"
           publisher="TechPress Publishing"
           chapter="7">
    <authors author="Jack Thompson"/>
  </entries>

  <!-- Misc entry with minimal information -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_website_ref"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_traceability"
           year="2019"
           title="Traceability Techniques for Large-Scale Model Transformations"
           school="University of Metropolis">
    <authors author="Michael Brown"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_automation"
           year="2017"
           title="Automated Testing of ATL Transformations"
           school="City Technical University">
    <authors author="Nina Rodriguez"/>
  </entries>

</BibTeX:BibTeXFile>