<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-key-2025-ml"
           year="2025"
           title="Advanced Machine Learning Methods"
           journal="Journal of Intelligent Systems">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr-key-2023-analysis"
           year="2023"
           title="Static Analysis Techniques for Model Transformations">
    <authors author="Carla Mendes"/>
  </entries>

  <!-- Unpublished with multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-key-2024-drafts"
           title="Draft Specification for Next-Gen Modeling"
           note="Work in progress, not yet submitted.">
    <authors author="David Lee"/>
    <authors author="Eva Novak"/>
  </entries>

  <!-- Manual (titled only, no authors or year) -->
  <entries xsi:type="BibTeX:Manual"
           id="man-key-tool-v3"
           title="User Manual for MetaTool v3.0"/>

  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-key-conf2022"
           year="2022"
           title="Proceedings of the 10th Conference on Model Engineering"/>

  <!-- InProceedings with authors and booktitle, inherits year/title from Proceedings and authors/booktitle from supertypes -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-key-2022-case"
           year="2022"
           title="A Case Study on Bidirectional Transformations"
           booktitle="Proceedings of the 10th Conference on Model Engineering">
    <authors author="Frank O&apos;Connor"/>
    <authors author="Grace Müller"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-key-2021-guide"
           year="2021"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book-key-2020-mde"
           year="2020"
           title="Foundations of Model-Driven Engineering"
           publisher="TechPress">
    <authors author="Hanna Schmidt"/>
    <authors author="Ian Brown"/>
  </entries>

  <!-- InCollection extends Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol-key-2020-chapter7"
           year="2020"
           title="Testing of Model Transformations"
           publisher="TechPress"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Julia Clark"/>
  </entries>

  <!-- InBook extends Book and adds chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-key-2019-ch2"
           year="2019"
           title="Modularization in Model Transformations"
           publisher="Academic Publications"
           chapter="2">
    <authors author="Kevin Zhang"/>
    <authors author="Laura Pérez"/>
  </entries>

  <!-- Misc with only mandatory id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-key-unknown-ref"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd-key-2018-metamodels"
           year="2018"
           title="Quality Assurance for Metamodel Evolution"
           school="University of Software Engineering">
    <authors author="Michael Green"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc-key-2017-models"
           year="2017"
           title="Model-Based Testing of Transformations"
           school="Institute of Computer Science">
    <authors author="Nina Rossi"/>
  </entries>

</BibTeX:BibTeXFile>