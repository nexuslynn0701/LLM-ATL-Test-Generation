    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Simple misc entry without additional attributes -->
  <entries xsi:type="BibTeX:Misc" id="miscRef01"/>

  <!-- An article with multiple authors -->
