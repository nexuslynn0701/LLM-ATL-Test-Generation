<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_authors_2020"
           title="A Comprehensive Survey on Model Transformation Testing"
           year="2020"
           journal="Journal of Software Engineering Research and Development">
    <authors author="Alice Tester"/>
    <authors author="Bob Verifier"/>
    <authors author="Charlie Analyzer"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techreport_formal_2018"
           title="Formal Foundations of ATL Transformations"
           year="2018">
    <authors author="Diana Semantics"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_experimental_2023"
           title="Experimental Results on Incremental Model Transformations"
           note="Submitted for publication, under review.">
    <authors author="Edward Incremental"/>
    <authors author="Fiona Performance"/>
  </entries>

  <!-- Manual (no authors, untimed) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tooling_guide"
           title="User Guide for the MDE Testing Framework v3.2"/>

  <!-- Proceedings (dated + titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mdeconf_2019"
           title="Proceedings of the 12th International Conference on Model-Driven Engineering"
           year="2019"/>

  <!-- InProceedings: authored, booktitled, inherits year/title from Proceedings -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_studies_2019"
           title="Case Studies in Testing Large-Scale ATL Transformations"
           year="2019"
           booktitle="Proceedings of the 12th International Conference on Model-Driven Engineering">
    <authors author="Grace CaseStudy"/>
    <authors author="Henry Integration"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_short_intro_2017"
           year="2017"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_testing_2016"
           title="Model-Driven Engineering: Testing and Quality Assurance"
           year="2016"
           publisher="Springer">
    <authors author="Isabel Quality"/>
    <authors author="John Reliability"/>
  </entries>

  <!-- InCollection: uses Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_metrics"
           title="Metrics for Assessing Model Transformation Quality"
           year="2016"
           publisher="Springer"
           booktitle="Model-Driven Engineering: Testing and Quality Assurance">
    <authors author="Karen Metrics"/>
    <authors author="Liam Evaluation"/>
  </entries>

  <!-- InBook: chapter in a book, single author -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_advanced"
           title="Advanced Techniques for Model Transformation Test Generation"
           year="2016"
           publisher="Springer"
           chapter="7">
    <authors author="Michael Generation"/>
  </entries>

  <!-- Misc: minimal, only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource_mde_portal"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_mde_testing_2015"
           title="Systematic Testing of Model Transformations in Model-Driven Engineering"
           year="2015"
           school="Technical University of Modelia">
    <authors author="Nora Researcher"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_automation_2021"
           title="Automation of Regression Testing for ATL Transformations"
           year="2021"
           school="Institute of Software Automation">
    <authors author="Oscar Automation"/>
  </entries>

</BibTeX:BibTeXFile>