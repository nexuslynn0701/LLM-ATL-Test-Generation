<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020deep"
           title="Deep Learning for Model Transformations"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="John Smith"/>
    <authors author="Emily Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="doe2018report"
           title="An Empirical Study on ATL Transformations"
           year="2018">
    <authors author="Alice Doe"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="millerDraft"
           title="Towards Automated Testing of Model Transformations"
           note="Draft version, not yet submitted">
    <authors author="Robert Miller"/>
    <authors author="Helen Clark"/>
  </entries>

  <!-- Manual without author or date (allowed: only title required) -->
  <entries xsi:type="BibTeX:Manual"
           id="atlUserGuide"
           title="ATL Transformation Language User Guide"/>

  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmt2019proc"
           title="Proceedings of the 12th International Conference on Model Transformation"
           year="2019"/>

  <!-- InProceedings: authored, dated (via Proceedings), and with booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="garcia2019testing"
           title="Systematic Testing of Model Transformations"
           year="2019"
           booktitle="Proceedings of the 12th International Conference on Model Transformation">
    <authors author="Laura Garcia"/>
    <authors author="Thomas Nguyen"/>
  </entries>

  <!-- Booklet: only date required -->
  <entries xsi:type="BibTeX:Booklet"
           id="shortGuide2021"
           year="2021"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="meyerMDEBook"
           title="Foundations of Model-Driven Engineering"
           year="2015"
           publisher="TechPress">
    <authors author="Karl Meyer"/>
    <authors author="Sophie Laurent"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="brownChapter"
           title="Model Transformation Testing Strategies"
           year="2016"
           publisher="Springer"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Ian Brown"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="leeChapter10"
           title="Performance Analysis of ATL Transformations"
           year="2017"
           publisher="Academic Press"
           chapter="10">
    <authors author="Michael Lee"/>
    <authors author="Sara Kim"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscResource1"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="andersonPhD"
           title="Improving Reliability of Model Transformations"
           year="2014"
           school="University of Metamodeling">
    <authors author="Peter Anderson"/>
  </entries>

  <!-- MasterThesis with multiple authors (co-authored) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="cooperMaster"
           title="Automated Generation of Test Models for ATL"
           year="2022"
           school="Institute of Software Systems">
    <authors author="Rachel Cooper"/>
    <authors author="David Green"/>
  </entries>

</BibTeX:BibTeXFile>