    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_complex_2022"
           title="A Comprehensive Study of Model Transformation Testing"
           year="2022"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Lopez"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_formal_2019"
           title="Formal Approaches to Testing ATL Transformations"
           year="2019">
    <authors author="Diana Evans"/>
  </entries>

  <!-- Unpublished with multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_tool_idea"
           title="Ideas for a Next-Generation MDE Toolchain"
           note="Draft circulated within the research group only.">
    <authors author="Ethan Brown"/>
    <authors author="Fiona Green"/>
  </entries>

  <!-- Manual (no author, no date, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_atl_tooling"
           title="ATL Tooling User Guide 3.1"/>
           
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_2020"
           title="Proceedings of the 13th International Conference on Model-Driven Engineering"
           year="2020"/>
           
  <!-- InProceedings combining proceedings, authors, and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study_2020"
           title="Case Studies in Industrial Model Transformation Testing"
           year="2020"
           booktitle="Proceedings of the 13th International Conference on Model-Driven Engineering">
    <authors author="George Hill"/>
    <authors author="Hannah Ito"/>
  </entries>

  <!-- Booklet (only year, no title/author) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_summer_school"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns"
           title="Patterns and Best Practices in Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Ian King"/>
    <authors author="Julia Novak"/>
  </entries>

  <!-- InCollection: chapter in an edited book -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_validation"
           title="Validation Strategies for Model Transformations"
           year="2017"
           publisher="Springer"
           booktitle="Patterns and Best Practices in Model-Driven Engineering">
    <authors author="Kevin Olson"/>
  </entries>

  <!-- InBook: specific chapter in a book -->
  <entries xsi:type="BibTeX:InBook"
