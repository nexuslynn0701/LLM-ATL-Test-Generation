<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article" id="artKey2020" title="A Comprehensive Study on Model Transformations" year="2020" journal="Journal of Model Engineering">
    <authors author="Alice Anderson"/>
    <authors author="Bob Brown"/>
    <authors author="Charlie Clark"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport" id="techRepLocal" title="Industrial Experiences with ATL Transformations" year="2018">
    <authors author="Dana Doe"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished" id="unpubDraft" title="Draft Guidelines for Testing Model Transformations" note="Work in progress; do not distribute.">
    <authors author="Eve Evans"/>
    <authors author="Frank Foster"/>
  </entries>

  <!-- Manual (title only, no date or authors) -->
  <entries xsi:type="BibTeX:Manual" id="atlManual" title="ATL Transformation Language Reference Manual"/>

  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="mdeProc2019" title="Proceedings of the 2019 International Conference on Model-Driven Engineering" year="2019"/>

  <!-- InProceedings, inherits from Proceedings, AuthoredEntry, and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings" id="inProcPaper01" title="Testing Strategies for Bidirectional Transformations" year="2019" booktitle="Proceedings of the 2019 International Conference on Model-Driven Engineering">
    <authors author="Grace Green"/>
    <authors author="Henry Hall"/>
  </entries>

  <!-- Booklet (dated only, minimal) -->
  <entries xsi:type="BibTeX:Booklet" id="toolBrochure" year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book" id="bookMDEIntro" title="Introduction to Model-Driven Engineering" year="2015" publisher="Academic Press">
    <authors author="Irene Ivory"/>
    <authors author="Jack Johnson"/>
  </entries>

  <!-- InCollection, extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection" id="chapterOnValidation" title="Validation of Model Transformations" year="2015" publisher="Academic Press" booktitle="Introduction to Model-Driven Engineering">
    <authors author="Jack Johnson"/>
    <authors author="Karen King"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook" id="inBookChap3" title="Case Studies in Transformation Testing" year="2015" publisher="Academic Press" chapter="3">
    <authors author="Irene Ivory"/>
  </entries>

  <!-- Misc (only id required) -->
  <entries xsi:type="BibTeX:Misc" id="miscEntry01"/>

  <!-- PhDThesis with school, multiple authors (e.g., co-supervised) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phdThesisJane" title="Automated Testing of Model Transformations" year="2021" school="University of Software Engineering">
    <authors author="Jane Jones"/>
    <authors author="Liam Lewis"/>
  </entries>

  <!-- MasterThesis with single author -->
  <entries xsi:type="BibTeX:MasterThesis" id="mscThesisMark" title="Traceability in Model Transformation Chains" year="2019" school="Institute of Computer Science">
    <authors author="Mark Miller"/>
  </entries>

</BibTeX:BibTeXFile>