<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth"
           title="Multi-paradigm Modeling in Practice"
           year="2018"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech_mde"
           title="A Survey on Model-Driven Engineering Tooling"
           year="2016">
    <authors author="Carol Williams"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_dsl"
           title="Internal DSLs for Data Analytics"
           note="Under revision for conference submission.">
    <authors author="David Brown"/>
    <authors author="Emma Wilson"/>
    <authors author="Frank Miller"/>
  </entries>

  <!-- Manual (no authors, no date) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool"
           title="MDETool 3.0 User Guide"/>
           
  <!-- Proceedings (dated and titled, no authors, no booktitle) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mbt"
           title="Proceedings of the International Conference on Model-Based Testing"
           year="2019"/>

  <!-- InProceedings with authors, year, title, and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_testing"
           title="Automated Testing of Model Transformations"
           year="2019"
           booktitle="Proceedings of the International Conference on Model-Based Testing">
    <authors author="George King"/>
    <authors author="Hannah Clark"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_intro"
           year="2015"/>

  <!-- Book with authors, date, title, and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde"
           title="Foundations of Model-Driven Engineering"
           year="2014"
           publisher="TechPress Publishing">
    <authors author="Ian Thompson"/>
    <authors author="Julia Roberts"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter"
           title="Model Transformation Testing Techniques"
           year="2014"
           publisher="TechPress Publishing"
           booktitle="Foundations of Model-Driven Engineering: Selected Chapters">
    <authors author="Kevin Turner"/>
  </entries>

  <!-- InBook extending Book with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_overview"
           title="Overview of Model Versioning"
           year="2014"
           publisher="TechPress Publishing"
           chapter="7">
    <authors author="Laura Martinez"/>
    <authors author="Michael Davis"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_note_only"/>

  <!-- PhDThesis (ThesisEntry subtype) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_thesis_mde"
           title="Scalable Techniques for Model-Driven Engineering"
           year="2020"
           school="University of Software Engineering">
    <authors author="Natalie Evans"/>
  </entries>

  <!-- MasterThesis (ThesisEntry subtype) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_thesis_testing"
           title="Quality Assurance in Model Transformation Chains"
           year="2017"
           school="Institute of Computer Science">
    <authors author="Oliver Perez"/>
  </entries>

</BibTeX:BibTeXFile>