    <authors author="Frank O&apos;Connor"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual" id="toolManual" title="User Guide for MetaTrans 2.0"/>

  <!-- Proceedings -->
  <entries xsi:type="BibTeX:Proceedings" id="procSymposium" title="Proceedings of the 15th Symposium on Model Transformations" year="2018"/>

  <!-- InProceedings sharing booktitle with proceedings, multiple authors -->
  <entries xsi:type="BibTeX:InProceedings" id="inProcKeynote" title="Keynote: The Future of Model Transformations" year="2018" booktitle="Proceedings of the 15th Symposium on Model Transformations">
    <authors author="Grace Hopper"/>
