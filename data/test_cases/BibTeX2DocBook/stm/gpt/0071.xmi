  <!-- Book with authors and publisher -->
  <entries xsi:type="BibTeX:Book" id="bookMDEIntro" title="Introduction to Model-Driven Engineering" year="2016" publisher="Springer">
    <authors author="John Doe"/>
    <authors author="Jane Roe"/>
  </entries>

  <!-- InCollection within the same book, with booktitle -->
  <entries xsi:type="BibTeX:InCollection" id="inCollectionChap" title="Chapter on Model Transformation Testing" year="2016" publisher="Springer" booktitle="Introduction to Model-Driven Engineering">
    <authors author="John Doe"/>
  </entries>

  <!-- InBook with chapter number -->
