<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
      id="art-2023-deeplearning"
      title="Deep Learning for Model Transformations"
      year="2023"
      journal="Journal of Model-Driven Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
      id="tr-2022-testing"
      title="Systematic Testing of Model Transformations"
      year="2022">
    <authors author="Carol Martinez"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
      id="unpub-2020-draft"
      title="Draft Specification of a New Transformation Language"
      note="Manuscript submitted for publication.">
    <authors author="David Lee"/>
    <authors author="Emma Watson"/>
  </entries>

  <!-- Manual without authors (allowed, since Manual does not extend AuthoredEntry) -->
  <entries xsi:type="BibTeX:Manual"
      id="man-2021-tool"
      title="User Guide for the MegaTransform Tool"/>

  <!-- Proceedings (acts as a container-like dated & titled work) -->
  <entries xsi:type="BibTeX:Proceedings"
      id="proc-2024-mdeconf"
      title="Proceedings of the 2024 Conference on Model Engineering"
      year="2024"/>

  <!-- InProceedings with multiple authors, linked conceptually to the above proceedings -->
  <entries xsi:type="BibTeX:InProceedings"
      id="inproc-2024-quality"
      title="Quality Assurance in Model Transformations"
      year="2024"
      booktitle="Proceedings of the 2024 Conference on Model Engineering">
    <authors author="Frank Nelson"/>
    <authors author="Grace Hopper"/>
  </entries>

  <!-- Booklet (dated entry without title) -->
  <entries xsi:type="BibTeX:Booklet"
      id="booklet-2019-overview"
      year="2019"/>

  <!-- Book with authors and publisher -->
  <entries xsi:type="BibTeX:Book"
      id="book-2018-mdeintro"
      title="Introduction to Model-Driven Engineering"
      year="2018"
      publisher="Springer">
    <authors author="Helen King"/>
  </entries>

  <!-- InCollection referencing a booktitle, with its own authors -->
  <entries xsi:type="BibTeX:InCollection"
      id="incollection-2018-chapter"
      title="Reusable Transformation Patterns"
      year="2018"
      publisher="Springer"
      booktitle="Introduction to Model-Driven Engineering">
    <authors author="Ian Brown"/>
    <authors author="Julia White"/>
  </entries>

  <!-- InBook: chapter of a book -->
  <entries xsi:type="BibTeX:InBook"
      id="inbook-2018-ch5"
      title="Case Studies in Model Transformation"
      year="2018"
      publisher="Springer"
      chapter="5">
    <authors author="Helen King"/>
    <authors author="Kevin Clark"/>
  </entries>

  <!-- Misc entry with minimal information -->
  <entries xsi:type="BibTeX:Misc"
      id="misc-2025-projectpage"/>

  <!-- PhD thesis -->
  <entries xsi:type="BibTeX:PhDThesis"
      id="phd-2017-evolution"
      title="Evolution of Model Transformations in Practice"
      year="2017"
      school="Technical University of Metropolis">
    <authors author="Laura Green"/>
  </entries>

  <!-- Master thesis with multiple authors (unusual but structurally allowed) -->
  <entries xsi:type="BibTeX:MasterThesis"
      id="msc-2020-analysis"
      title="Static Analysis Techniques for ATL Transformations"
      year="2020"
      school="Institute of Software Technology">
    <authors author="Michael Scott"/>
    <authors author="Nina Adams"/>
  </entries>

</BibTeX:BibTeXFile>