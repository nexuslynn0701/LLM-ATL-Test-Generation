<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020deep"
           title="Deep Learning for Model Transformations"
           year="2020"
           journal="Journal of Model-Driven Engineering">
    <authors author="John Smith"/>
    <authors author="Emily Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="lee2018report"
           title="Scalability of Model Transformations"
           year="2018">
    <authors author="Michael Lee"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="brown2023draft"
           title="A Draft on Bidirectional Transformations"
           note="Manuscript under revision">
    <authors author="Sarah Brown"/>
    <authors author="Thomas Clark"/>
  </entries>

  <!-- Manual (only title required) -->
  <entries xsi:type="BibTeX:Manual"
           id="atluserguide"
           title="ATL User Guide and Reference Manual"/>
  
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="mdl2021proc"
           title="Proceedings of the 2021 Workshop on Model-Driven Languages"
           year="2021"/>

  <!-- InProceedings (inherits Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="garcia2021mde"
           title="Testing ATL Transformations in Practice"
           year="2021"
           booktitle="Proceedings of the 2021 Workshop on Model-Driven Languages">
    <authors author="Laura Garcia"/>
    <authors author="Peter Novak"/>
  </entries>

  <!-- Booklet (only year required) -->
  <entries xsi:type="BibTeX:Booklet"
           id="umlcheatsheet"
           year="2019"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="mdehandbook"
           title="Handbook of Model-Driven Engineering"
           year="2015"
           publisher="Springer">
    <authors author="Alice Martin"/>
    <authors author="David Wilson"/>
  </entries>

  <!-- InCollection based on a Book -->
  <entries xsi:type="BibTeX:InCollection"
           id="martin2015chapter"
           title="Verification of Model Transformations"
           year="2015"
           publisher="Springer"
           booktitle="Handbook of Model-Driven Engineering">
    <authors author="Alice Martin"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="wilson2015chapter5"
           title="Case Studies in Transformation Testing"
           year="2015"
           publisher="Springer"
           chapter="5">
    <authors author="David Wilson"/>
  </entries>

  <!-- Misc with only id (no other required attributes) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscNoteOnTools"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="nguyen2017phd"
           title="Automated Testing of Model Transformations"
           year="2017"
           school="Technical University of Metropolis">
    <authors author="Hanh Nguyen"/>
  </entries>

  <!-- MasterThesis with two authors (unusual but allowed structurally) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="cooper2020msc"
           title="Incremental Testing for ATL Transformations"
           year="2020"
           school="Institute of Software Engineering">
    <authors author="James Cooper"/>
    <authors author="Maria Rossi"/>
  </entries>

</BibTeX:BibTeXFile>