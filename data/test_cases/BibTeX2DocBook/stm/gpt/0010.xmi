<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth"
           title="Model-Driven Testing of Transformations"
           year="2019"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Martinez"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech_rep_single"
           title="Scalable Validation of ATL Transformations"
           year="2020">
    <authors author="Diana Clarke"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft"
           title="Towards Automated Oracle Generation"
           note="Draft manuscript under review">
    <authors author="Eve Robinson"/>
    <authors author="Frank Lee"/>
  </entries>

  <!-- Manual (no authors, only title required) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool"
           title="ATL Transformation Debugger User Guide"/>
  
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_conf2021"
           title="Proceedings of the MDE Testing Symposium"
           year="2021"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study"
           title="Case Studies in Model Transformation Testing"
           year="2021"
           booktitle="MDE Testing Symposium 2021">
    <authors author="Grace Kim"/>
    <authors author="Henry Zhang"/>
  </entries>

  <!-- Booklet: only year required -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_overview"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_ref_mde"
           title="Foundations of Model-Driven Engineering"
           year="2015"
           publisher="TechPress">
    <authors author="Isabella Rossi"/>
    <authors author="Jack Miller"/>
  </entries>

  <!-- InCollection: extends Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter"
           title="Testing Strategies for Model Transformations"
           year="2016"
           publisher="Springer"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Karen White"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter7"
           title="Automated Generation of Test Models"
           year="2017"
           publisher="Software Science Press"
           chapter="7">
    <authors author="Liam Brown"/>
    <authors author="Maria Garcia"/>
  </entries>

  <!-- Misc: only id required -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_website_ref"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_thesis_modeltesting"
           title="Testing and Verification of Model Transformations"
           year="2014"
           school="University of Metropolis">
    <authors author="Nathan Clark"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_thesis_tooling"
           title="Tool Support for Model Transformation Testing"
           year="2013"
           school="Institute of Software Technology">
    <authors author="Olivia Perez"/>
  </entries>

</BibTeX:BibTeXFile>