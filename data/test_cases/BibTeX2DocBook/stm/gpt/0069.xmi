<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_authors_2022"
           title="Multi-Paradigm Modeling in Practice"
           year="2022"
           journal="Journal of Software Engineering Methods">
    <authors author="Alice Example"/>
    <authors author="Bob Reference"/>
    <authors author="Carlos Meta"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech_report_2020"
           title="Industrial Adoption of Model Transformations"
           year="2020">
    <authors author="Diana Transformation"/>
  </entries>

  <!-- Unpublished with two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_mde_notes"
           title="Notes on Incremental Model Synchronization"
           note="Draft available upon request.">
    <authors author="Eve Incremental"/>
    <authors author="Frank Synchronizer"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_guide"
           title="User Guide for the Metamodel Inspector"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proceedings_mde_2021"
           title="Proceedings of the International Conference on Model Engineering"
           year="2021"/>
           
  <!-- InProceedings inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study"
           title="Case Studies in Domain-Specific Languages"
           year="2021"
           booktitle="Proceedings of the International Conference on Model Engineering">
    <authors author="Grace Domain"/>
    <authors author="Henry Specific"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_summer_school"
           year="2019"/>

  <!-- Book with authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_textbook"
           title="Foundations of Model-Driven Engineering"
           year="2018"
           publisher="Academic Press">
    <authors author="Irene Foundation"/>
    <authors author="John Driver"/>
  </entries>

  <!-- InCollection extending Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter"
           title="Testing of Model Transformations"
           year="2018"
           publisher="Academic Press"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Karen Tester"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_7"
           title="Bidirectional Transformations"
           year="2018"
           publisher="Academic Press"
           chapter="7">
    <authors author="Liam Bidirectional"/>
    <authors author="Mia Consistency"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_web_resource"/>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_mde"
           title="Scalable Techniques for Model Transformation Testing"
           year="2017"
           school="University of Model Engineering">
    <authors author="Noah Doctoral"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_tooling"
           title="Tool Support for Automated Model Co-Evolution"
           year="2016"
           school="Institute of Software Technology">
    <authors author="Olivia Masters"/>
  </entries>

</BibTeX:BibTeXFile>