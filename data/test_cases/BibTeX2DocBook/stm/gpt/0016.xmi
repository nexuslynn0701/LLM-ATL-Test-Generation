<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_authors_2020"
           title="A Survey on Model Transformation Testing"
           year="2020"
           journal="Journal of Software Engineering Research">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Martinez"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech_report_tooling_2018"
           title="Tool Support for ATL Transformation Testing"
           year="2018">
    <authors author="Diana Prince"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_experimental_results"
           title="Experimental Results on Model Mutation Strategies"
           note="Work in progress, not yet submitted.">
    <authors author="Eve Adams"/>
    <authors author="Frank Müller"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_atl_reference"
           title="ATL Language Reference Manual 4.0"/>
           
  <!-- Proceedings (dated, titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mdeconf_2021"
           title="Proceedings of the 15th International Conference on Model-Driven Engineering"
           year="2021"/>

  <!-- InProceedings: inherits Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_coverage_approach"
           title="Coverage Criteria for Model Transformations"
           year="2021"
           booktitle="Proceedings of the 15th International Conference on Model-Driven Engineering">
    <authors author="Hannah Kim"/>
    <authors author="Ian Thompson"/>
  </entries>

  <!-- Booklet: only DatedEntry -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_tutorial"
           year="2017"/>

  <!-- Book: Authored + Dated + Titled + publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns"
           title="Patterns and Best Practices in Model-Driven Engineering"
           year="2016"
           publisher="TechPress Publishing">
    <authors author="John Doe"/>
    <authors author="Karen Nguyen"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_metamodeling"
           title="Metamodeling Techniques in Practice"
           year="2016"
           publisher="TechPress Publishing"
           booktitle="Patterns and Best Practices in Model-Driven Engineering">
    <authors author="Laura Rossi"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_testing"
           title="Testing of Model Transformations"
           year="2016"
           publisher="TechPress Publishing"
           chapter="7">
    <authors author="John Doe"/>
    <authors author="Michael Brown"/>
  </entries>

  <!-- Misc: minimal, only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource_mde_tools"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_mde_validation"
           title="Validation and Verification Techniques for Model Transformations"
           year="2015"
           school="University of Software Systems">
    <authors author="Natalie Perez"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_traceability"
           title="Traceability Support in Model-Driven Engineering Workflows"
           year="2019"
           school="Institute of Computer Science">
    <authors author="Oliver King"/>
  </entries>

</BibTeX:BibTeXFile>