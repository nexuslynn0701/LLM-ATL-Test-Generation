<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth_2021"
           title="A Comprehensive Survey on Model Transformation Testing"
           year="2021"
           journal="Journal of Software Engineering Research">
    <authors author="Alice Johnson"/>
    <authors author="Bob Martinez"/>
    <authors author="Charlie Nguyen"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech_report_mde_2019"
           title="Industrial Experiences with Model-Driven Engineering"
           year="2019">
    <authors author="Dana Smith"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_formal_approach"
           title="A Formal Approach to Validating Transformation Chains"
           note="Manuscript in preparation">
    <authors author="Edward Brown"/>
    <authors author="Fiona Clark"/>
  </entries>

  <!-- Manual without authors (allowed, since Manual only extends TitledEntry) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_guide"
           title="User Guide for the MetaModel Transformation Toolkit"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_conf_2020"
           title="Proceedings of the International Conference on Model-Driven Engineering"
           year="2020"/>
           
  <!-- InProceedings (inherits Proceedings + AuthoredEntry + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study_2020"
           title="Case Studies in Large-Scale Model Transformations"
           year="2020"
           booktitle="Proceedings of the International Conference on Model-Driven Engineering">
    <authors author="George Hall"/>
    <authors author="Helen Irving"/>
  </entries>

  <!-- Booklet (only DatedEntry) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_short_intro"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_principles"
           title="Principles and Practices of Model-Driven Engineering"
           year="2016"
           publisher="TechPress Publishing">
    <authors author="Ian Jacobs"/>
    <authors author="Julia Keller"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_validation"
           title="Validation Patterns for Model Transformations"
           year="2016"
           publisher="TechPress Publishing"
           booktitle="Principles and Practices of Model-Driven Engineering">
    <authors author="Ian Jacobs"/>
    <authors author="Laura Martin"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_testing"
           title="Testing Strategies for ATL Transformations"
           year="2016"
           publisher="TechPress Publishing"
           chapter="5">
    <authors author="Julia Keller"/>
  </entries>

  <!-- Misc with minimal info (only id required by BibTeXEntry) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource"/>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_model_validation"
           title="Model Transformation Validation in Practice"
           year="2017"
           school="University of Metropolis">
    <authors author="Kevin Nolan"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) with different school -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_coverage"
           title="Coverage Criteria for Model Transformation Testing"
           year="2018"
           school="Institute of Software Systems">
    <authors author="Linda Owens"/>
  </entries>

</BibTeX:BibTeXFile>