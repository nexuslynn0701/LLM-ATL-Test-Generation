<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_complex_2021"
           year="2021"
           title="A Comprehensive Survey on Model Transformation Testing"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Modeler"/>
    <authors author="Bob Tester"/>
    <authors author="Carlos Verifier"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_early_2018"
           year="2018"
           title="Early Experiences with ATL Transformation Validation">
    <authors author="Diana Engineer"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft_2023"
           title="Draft Guidelines for Model Transformation Benchmarks"
           note="To appear as internal white paper">
    <authors author="Eve Architect"/>
    <authors author="Frank Analyst"/>
  </entries>

  <!-- Manual without authors -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_guide"
           title="User Guide for the MetaTransform Toolkit"/>
  
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_symposium"
           year="2020"
           title="Proceedings of the 10th Symposium on Model Engineering"/>

  <!-- InProceedings: inherits year/title from Proceedings,
       plus authors and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study"
           year="2020"
           title="Case Studies in Testing Large-Scale ATL Transformations"
           booktitle="Proceedings of the 10th Symposium on Model Engineering">
    <authors author="Grace Researcher"/>
    <authors author="Henry Developer"/>
  </entries>

  <!-- Booklet: only dated entry -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_short_intro"
           year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_testing"
           year="2019"
           title="Foundations of Model Transformation Testing"
           publisher="Springer">
    <authors author="Iris Scientist"/>
    <authors author="John Evaluator"/>
  </entries>

  <!-- InCollection: chapter in edited book -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_coverage"
           year="2019"
           title="Coverage Criteria for Model Transformations"
           publisher="Springer"
           booktitle="Foundations of Model Transformation Testing">
    <authors author="Karen Coverage"/>
  </entries>

  <!-- InBook: chapter number present -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_5"
           year="2019"
           title="Automation Patterns for Transformation Test Generation"
           publisher="Springer"
           chapter="5">
    <authors author="Leo Generator"/>
    <authors author="Mia Strategist"/>
  </entries>

  <!-- Misc: minimal required fields -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_website_reference"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_formal_approaches"
           year="2016"
           title="Formal Approaches to Model Transformation Testing"
           school="Technical University of Metropolis">
    <authors author="Nina Doctoral"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_empirical_study"
           year="2022"
           title="An Empirical Study on ATL Transformation Faults"
           school="Institute of Software Systems">
    <authors author="Oscar Graduate"/>
  </entries>

</BibTeX:BibTeXFile>