<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth"
           title="Model-Driven Engineering in Practice"
           year="2018"
           journal="Journal of Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech_rep_01"
           title="A Survey on Model Transformation Testing"
           year="2019">
    <authors author="Carlos Martinez"/>
  </entries>

  <!-- Unpublished with note and three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft"
           title="Draft Specification of a Transformation Language"
           note="Work in progress technical note, not for distribution">
    <authors author="Diana Nguyen"/>
    <authors author="Ethan Brown"/>
    <authors author="Fatima Ali"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool"
           title="User Guide for the MetaTrans Tool Suite"/>
           
  <!-- Proceedings with title and year -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_conf_2020"
           title="Proceedings of the 10th International Conference on Model Transformations"
           year="2020"/>

  <!-- InProceedings combining proceedings, authors, and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_paper_01"
           title="Test Adequacy Criteria for Model Transformations"
           year="2020"
           booktitle="Proceedings of the 10th International Conference on Model Transformations">
    <authors author="George King"/>
    <authors author="Hanna Lee"/>
  </entries>

  <!-- Booklet with just year -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_intro"
           year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_intro"
           title="Introduction to Model-Driven Engineering"
           year="2015"
           publisher="TechPress Publishing">
    <authors author="Ian Clark"/>
    <authors author="Julia Patel"/>
  </entries>

  <!-- InCollection in a Book, with booktitle, same authors reused logically -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter"
           title="Quality Assurance for Model Transformations"
           year="2015"
           publisher="TechPress Publishing"
           booktitle="Introduction to Model-Driven Engineering">
    <authors author="Julia Patel"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_case_study"
           title="Case Studies in Industrial MDE"
           year="2016"
           publisher="Enterprise Books"
           chapter="7">
    <authors author="Kevin O&apos;Brien"/>
    <authors author="Laura Chen"/>
  </entries>

  <!-- Misc with only id (no other mandatory attributes) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_ref"/>

  <!-- PhDThesis with school and multiple authors (co-authored thesis-like work) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_model_testing"
           title="Systematic Testing of Model Transformations"
           year="2021"
           school="University of Metropolis">
    <authors author="Michael Green"/>
  </entries>

  <!-- MasterThesis with different school -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_docbook_gen"
           title="Automatic Generation of Documentation from Models"
           year="2022"
           school="Institute of Software Technology">
    <authors author="Nina Rossi"/>
  </entries>

</BibTeX:BibTeXFile>