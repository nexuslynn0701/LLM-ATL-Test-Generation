<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_smt2021"
           year="2021"
           title="Scalable Model Transformations for Industrial Systems"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_mdperf_2019"
           year="2019"
           title="Performance Evaluation of Model-Driven Tools">
    <authors author="Carlos Martinez"/>
  </entries>

  <!-- Unpublished with two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_dsltemp_2020"
           title="A Template Language for Domain-Specific Models"
           note="Draft under submission to MoDELS 2020">
    <authors author="Diana Evans"/>
    <authors author="Emily Clark"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="man_tool_guide"
           title="User Guide for the MetaTransform Tool"/>
  
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_modesl_2022"
           year="2022"
           title="Proceedings of the 25th International Conference on Model Driven Engineering Languages and Systems"/>

  <!-- InProceedings: inherits authors, date, titles and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_test_coverage"
           year="2022"
           title="Testing Coverage Criteria for Model Transformations"
           booktitle="Proceedings of the 25th International Conference on Model Driven Engineering Languages and Systems">
    <authors author="Frank Green"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Booklet: dated only -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_intro"
           year="2018"/>

  <!-- Book: authored, dated, titled, publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_fundamentals"
           year="2017"
           title="Fundamentals of Model-Driven Engineering"
           publisher="TechPress Publishing">
    <authors author="Helen Brown"/>
    <authors author="Ian Thompson"/>
  </entries>

  <!-- InCollection: book plus booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol_chapter_mwe"
           year="2017"
           title="Model Weaving and Evolution"
           publisher="TechPress Publishing"
           booktitle="Fundamentals of Model-Driven Engineering">
    <authors author="Helen Brown"/>
    <authors author="Jack Wilson"/>
  </entries>

  <!-- InBook: concrete sub of Book, adds chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chap_tooling"
           year="2017"
           title="Tool Support for Large-Scale Transformations"
           publisher="TechPress Publishing"
           chapter="5">
    <authors author="Ian Thompson"/>
  </entries>

  <!-- Misc: minimal concrete BibTeXEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource"/>

  <!-- PhDThesis: concrete ThesisEntry -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_model_testing"
           year="2016"
           title="Systematic Testing of Model Transformations"
           school="University of Metropolis">
    <authors author="Karen Young"/>
  </entries>

  <!-- MasterThesis: concrete ThesisEntry -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_tracing_2015"
           year="2015"
           title="Traceability Techniques in Model Transformations"
           school="Institute of Software Systems">
    <authors author="Liam Scott"/>
  </entries>

</BibTeX:BibTeXFile>