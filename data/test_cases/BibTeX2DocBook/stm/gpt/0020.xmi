<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_survey_2021"
           title="A Comprehensive Survey on Model Transformations"
           year="2021"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_mde_tools_2020"
           title="Tool Support for Model-Driven Engineering"
           year="2020">
    <authors author="Caroline Brown"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_metamodel_ideas"
           title="Ideas on Next-Generation Metamodeling"
           note="Draft version, not for distribution">
    <authors author="Daniel Wilson"/>
    <authors author="Eva Thompson"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_atl_reference"
           title="ATL Transformation Language Reference Manual"/>
  
  <!-- Proceedings (dated and titled, but no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_symposium_2019"
           title="Proceedings of the 2019 Symposium on Model-Driven Engineering"
           year="2019"/>
  
  <!-- InProceedings: combines Proceedings, AuthoredEntry, and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study_2019"
           title="Case Studies in Industrial Model Transformation"
           year="2019"
           booktitle="Proceedings of the 2019 Symposium on Model-Driven Engineering">
    <authors author="Frank Martinez"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Booklet (only year required) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_tutorial"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_intro_mde"
           title="Introduction to Model-Driven Engineering"
           year="2017"
           publisher="TechPress Publishing">
    <authors author="Henry Clark"/>
    <authors author="Isabella Green"/>
  </entries>

  <!-- InCollection: based on Book plus booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_mtl"
           title="Model Transformation Languages"
           year="2017"
           publisher="TechPress Publishing"
           booktitle="Introduction to Model-Driven Engineering">
    <authors author="Henry Clark"/>
    <authors author="Julia Adams"/>
  </entries>

  <!-- InBook: Book with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_validation"
           title="Validation and Verification of Model Transformations"
           year="2017"
           publisher="TechPress Publishing"
           chapter="5">
    <authors author="Isabella Green"/>
  </entries>

  <!-- Misc entry (no additional mandatory attributes) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_mde_webpage"/>
  
  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_smith_2022"
           title="Scalable Techniques for Model Transformation Testing"
           year="2022"
           school="University of Software Technology">
    <authors author="Kevin Smith"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_jones_2020"
           title="Automated Generation of Test Models for MDE"
           year="2020"
           school="Institute of Computer Science">
    <authors author="Laura Jones"/>
  </entries>

</BibTeX:BibTeXFile>