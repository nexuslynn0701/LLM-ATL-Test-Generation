<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artMultiAuthor2020"
           title="A Comprehensive Survey on Model Transformation Testing"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carla Nguyen"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techRepFormal2019"
           title="Formal Foundations of ATL Transformations"
           year="2019">
    <authors author="David Brown"/>
  </entries>

  <!-- Unpublished with note and several authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraftMDE"
           title="Draft Notes on Scalable Model Transformations"
           note="Internal working draft, not for distribution">
    <authors author="Elena Garcia"/>
    <authors author="Frank Müller"/>
  </entries>

  <!-- Manual (title only, no authors or year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualToolchain"
           title="User Guide for the Advanced MDE Toolchain"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procMDEConf2022"
           title="Proceedings of the International Conference on Model-Driven Engineering"
           year="2022"/>
           
  <!-- InProceedings: proceedings + authored + booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inProcTrace2022"
           title="Traceability Techniques in Heterogeneous Model Transformations"
           year="2022"
           booktitle="Proceedings of the International Conference on Model-Driven Engineering">
    <authors author="Grace Lee"/>
    <authors author="Henry Thompson"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletIntroMDE"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDEPatterns"
           title="Patterns and Practices in Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Irene Rossi"/>
    <authors author="James Clark"/>
  </entries>

  <!-- InCollection: a chapter from a book with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="inCollectionTesting"
           title="Testing Techniques for Model Transformations"
           year="2017"
           publisher="Springer"
           booktitle="Patterns and Practices in Model-Driven Engineering">
    <authors author="Karen White"/>
  </entries>

  <!-- InBook: another chapter, using chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookChapter3"
           title="Case Studies in Industrial MDE Adoption"
           year="2017"
           publisher="Springer"
           chapter="3">
    <authors author="James Clark"/>
    <authors author="Laura Pérez"/>
  </entries>

  <!-- Misc: minimal entry with only mandatory id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscOnlineResource01"/>

  <!-- PhDThesis: thesis entry with school -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisTransformation"
           title="Optimization Techniques for Large-Scale Model Transformations"
           year="2016"
           school="Technical University of Metropolis">
    <authors author="Michael O'Connor"/>
  </entries>

  <!-- MasterThesis: another thesis entry -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisTesting"
           title="Automated Testing Strategies for ATL Transformations"
           year="2021"
           school="Institute of Software Engineering">
    <authors author="Nina Schmidt"/>
  </entries>

</BibTeX:BibTeXFile>