<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article" id="art_survey21" title="A Survey on Model Transformations" year="2021" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport" id="tr_mde_tools20" title="Tool Support for Model-Driven Engineering" year="2020">
    <authors author="Clara Zhang"/>
  </entries>

  <!-- Unpublished with note and three authors -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub_dsl_idea" title="Early Ideas on Domain-Specific Languages" note="Draft manuscript under internal review">
    <authors author="David Brown"/>
    <authors author="Emma Wilson"/>
    <authors author="Frank Martin"/>
  </entries>

  <!-- Manual without authors (allowed: Manual extends only TitledEntry) -->
  <entries xsi:type="BibTeX:Manual" id="man_tool_userguide" title="User Guide for the MetaTransform Toolset"/>
  
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc_mdeconf22" title="Proceedings of the 10th Conference on Model-Driven Engineering" year="2022"/>

  <!-- InProceedings: authors + inherited title/year from Proceedings + booktitle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc_validation22" title="Validating Model Transformations via Metamorphic Testing" year="2022" booktitle="Proceedings of the 10th Conference on Model-Driven Engineering">
    <authors author="Grace Lee"/>
    <authors author="Henry Clark"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet_short_intro" year="2019"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book" id="book_mde_textbook" title="Foundations of Model-Driven Engineering" year="2018" publisher="TechPress Publishing">
    <authors author="Isabel Turner"/>
    <authors author="Jack Roberts"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry, inherits authors, title, year, publisher, plus booktitle -->
  <entries xsi:type="BibTeX:InCollection" id="incol_chapter_metamodels" title="Metamodeling Techniques in Practice" year="2018" publisher="TechPress Publishing" booktitle="Foundations of Model-Driven Engineering">
    <authors author="Isabel Turner"/>
    <authors author="Laura Green"/>
  </entries>

  <!-- InBook: Book + specific chapter -->
  <entries xsi:type="BibTeX:InBook" id="inbook_chapter_validation" title="Validation of Model Transformations" year="2018" publisher="TechPress Publishing" chapter="7">
    <authors author="Jack Roberts"/>
  </entries>

  <!-- Misc entry with only mandatory id -->
  <entries xsi:type="BibTeX:Misc" id="misc_personal_comm"/>

  <!-- PhDThesis with authors, year, title, school -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd_mde_optimizations" title="Optimization Techniques for Model Transformations" year="2017" school="University of Software Engineering">
    <authors author="Michael Scott"/>
  </entries>

  <!-- MasterThesis with different author and school -->
  <entries xsi:type="BibTeX:MasterThesis" id="msc_model_testing" title="Testing Strategies for Model Transformations" year="2019" school="Institute of Computer Science">
    <authors author="Nina Adams"/>
  </entries>

</BibTeX:BibTeXFile>