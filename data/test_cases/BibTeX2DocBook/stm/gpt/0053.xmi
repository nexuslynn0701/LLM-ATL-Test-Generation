<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_complex_01"
           title="A Comprehensive Study on Model-Driven Testing"
           year="2021"
           journal="Journal of Software Engineering Research">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Martinez"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_mde_02"
           title="Industrial Adoption of Model-Driven Engineering"
           year="2019">
    <authors author="Diana Roberts"/>
  </entries>

  <!-- Unpublished with two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_note_03"
           title="Preliminary Results on Bidirectional Transformations"
           note="Draft manuscript, not for distribution">
    <authors author="Ethan Brown"/>
    <authors author="Fiona Green"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_04"
           title="User Guide for the Atlas Transformation Language"/>

  <!-- Proceedings -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_conf_05"
           title="Proceedings of the International Conference on Model Transformations"
           year="2020"/>

  <!-- InProceedings: authored, dated, with booktitle and inherited title/year from Proceedings -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_06"
           title="Test Case Generation for Model Transformations"
           year="2020"
           booktitle="Proc. Int. Conf. on Model Transformations">
    <authors author="George King"/>
    <authors author="Helen Young"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_intro_07"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_08"
           title="Foundations of Model-Driven Engineering"
           year="2016"
           publisher="TechPress Publishing">
    <authors author="Ian Clark"/>
    <authors author="Julia Adams"/>
  </entries>

  <!-- InCollection: book chapter in an edited volume -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_09"
           title="Testing Transformations in Practice"
           year="2017"
           publisher="TechPress Publishing"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Kevin Lee"/>
  </entries>

  <!-- InBook: book chapter with explicit chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_10"
           title="Case Studies in Model Transformation Testing"
           year="2015"
           publisher="Software Science Press"
           chapter="4">
    <authors author="Laura Perez"/>
    <authors author="Michael Turner"/>
  </entries>

  <!-- Misc: minimal entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_resource_11"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_mbt_12"
           title="Model-Based Testing of Domain-Specific Languages"
           year="2014"
           school="University of Metropolis">
    <authors author="Natalie Owens"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_validation_13"
           title="Validation Techniques for Model Transformations"
           year="2013"
           school="Technical University of Gotham">
    <authors author="Oliver Scott"/>
