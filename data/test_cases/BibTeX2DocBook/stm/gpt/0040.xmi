<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article" id="art_key_001" title="Model Transformations in Practice" year="2018" journal="Journal of Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with three authors -->
  <entries xsi:type="BibTeX:TechReport" id="tr_key_002" title="A Survey on ATL Testing" year="2020">
    <authors author="Carla Rossi"/>
    <authors author="Daniel Lee"/>
    <authors author="Eve Clark"/>
  </entries>

  <!-- Unpublished with one author -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub_key_003" title="Preliminary Results on Model Mutation" note="To appear in workshop proceedings.">
    <authors author="Frank Martin"/>
  </entries>

  <!-- Manual without authors (allowed, since Manual extends only TitledEntry) -->
  <entries xsi:type="BibTeX:Manual" id="manual_key_004" title="ATL Tooling Reference Guide"/>
  
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc_key_005" title="Proceedings of the MDE Conference" year="2019"/>

  <!-- InProceedings with its own authors and booktitle (extends Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc_key_006" title="Testing Transformations via Mutation" year="2019" booktitle="Proceedings of the MDE Conference">
    <authors author="Grace Hopper"/>
    <authors author="Henry Ford"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet_key_007" year="2017"/>

  <!-- Book with authors, date, title, and publisher -->
  <entries xsi:type="BibTeX:Book" id="book_key_008" title="Foundations of Model-Driven Engineering" year="2015" publisher="Springer">
    <authors author="Isabella King"/>
    <authors author="James Wright"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) with authors, date, title, publisher, and booktitle -->
  <entries xsi:type="BibTeX:InCollection" id="incollection_key_009" title="Coverage Criteria for ATL Transformations" year="2021" publisher="Elsevier" booktitle="Advances in Software Testing">
    <authors author="Laura Perez"/>
    <authors author="Michael Brown"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook" id="inbook_key_010" title="Case Studies in Model Transformation" year="2016" publisher="ACM Press" chapter="7">
    <authors author="Nina Adams"/>
  </entries>

  <!-- Misc entry, minimal (only id required) -->
  <entries xsi:type="BibTeX:Misc" id="misc_key_011"/>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd_key_012" title="Testing and Verification of Model Transformations" year="2014" school="Technical University of Metropolis">
    <authors author="Oscar Rivera"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) with two authors (unusual but structurally valid) -->
  <entries xsi:type="BibTeX:MasterThesis" id="master_key_013" title="Tool Support for ATL Model Testing" year="2013" school="Metropolis State University">
    <authors author="Pat Quinn"/>
    <authors author="Rita Stone"/>
  </entries>

</BibTeX:BibTeXFile>