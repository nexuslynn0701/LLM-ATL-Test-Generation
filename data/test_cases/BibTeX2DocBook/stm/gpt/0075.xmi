<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Simple misc entry without extra properties -->
  <entries xsi:type="BibTeX:Misc" id="miscUniqueId01"/>

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="articleMultiAuth2020"
           title="Advances in Model-Driven Testing"
           year="2020"
           journal="Journal of Software Engineering Research">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techReportMDE2019"
           title="Industrial Applications of Model Transformations"
           year="2019">
    <authors author="Clara Verdi"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpublishedDraft2022"
           title="A Draft on Bidirectional Transformations"
           note="To appear in conference proceedings">
    <authors author="Daniel García"/>
    <authors author="Eva Müller"/>
  </entries>

  <!-- Manual without authors -->
  <entries xsi:type="BibTeX:Manual"
           id="manualToolGuideV3"
           title="User Guide for the Traceability Analyzer v3.0"/>

  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proceedingsMTConf2018"
           title="Proceedings of the 8th International Conference on Model Transformations"
           year="2018"/>

  <!-- InProceedings extending Proceedings, using booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocCaseStudy2018"
           title="A Case Study on Testing ATL Transformations"
           year="2018"
           booktitle="Proceedings of the 8th International Conference on Model Transformations">
    <authors author="Frank Lee"/>
  </entries>

  <!-- Booklet, only dated -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletShortIntro2021"
           year="2021"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDEHandbook2017"
           title="Handbook of Model-Driven Engineering"
           year="2017"
           publisher="TechBooks Publishing">
    <authors author="Grace Hopper"/>
    <authors author="Henry Ford"/>
  </entries>

  <!-- InCollection: chapter in an edited book, with booktitle and authors -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollectionChap5"
           title="Testing Techniques for Model Transformations"
           year="2017"
           publisher="TechBooks Publishing"
           booktitle="Handbook of Model-Driven Engineering">
    <authors author="Isabel Newton"/>
  </entries>

  <!-- InBook: specific chapter in a book with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookChap2"
           title="Foundations of Model Transformation Testing"
           year="2016"
           publisher="Academic Press"
           chapter="2">
    <authors author="Jack O&apos;Connor"/>
    <authors author="Karen Li"/>
  </entries>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisRefinement2015"
           title="Refinement Techniques for Model Transformations"
           year="2015"
           school="Technical University of Metropolis">
    <authors author="Liam Brown"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisTesting2014"
           title="Automated Testing of Model Transformations"
           year="2014"
           school="Institute of Software Engineering">
    <authors author="Maria Rossi"/>
  </entries>

</BibTeX:BibTeXFile>