<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplex2020"
           title="A Comprehensive Survey on Model Transformations"
           year="2020"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carol White"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="trFormal2019"
           title="Formal Verification Techniques for ATL Transformations"
           year="2019">
    <authors author="David Brown"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraft2023"
           title="Draft: Incremental Testing of Model Transformations"
           note="To appear, under review.">
    <authors author="Eve Miller"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualTool2021"
           title="User Guide for the MetaTrans Testing Framework"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procICMT2022"
           title="Proceedings of the 15th International Conference on Model Transformation"
           year="2022"/>

  <!-- InProceedings: inherits authors, date, titles, booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocKeynote2022"
           title="Keynote: Future Directions in Model-Driven Engineering"
           year="2022"
           booktitle="Proceedings of the 15th International Conference on Model Transformation">
    <authors author="Grace Hopper"/>
  </entries>

  <!-- Booklet: only dated -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletPromo2018"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="bookIntroMDE2016"
           title="Introduction to Model-Driven Engineering"
           year="2016"
           publisher="Springer">
    <authors author="Henry Taylor"/>
    <authors author="Isabel Walker"/>
  </entries>

  <!-- InCollection: chapter in edited book with its own booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollectionChap5"
           title="Testing Techniques for Model Transformations"
           year="2016"
           publisher="Springer"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Jack Martin"/>
    <authors author="Laura King"/>
  </entries>

  <!-- InBook: specific chapter of a book -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookChap2"
           title="Foundations of Metamodeling"
           year="2016"
           publisher="Springer"
           chapter="2">
    <authors author="Henry Taylor"/>
    <authors author="Isabel Walker"/>
  </entries>

  <!-- Misc: minimal entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscOnlineResource1"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesis2021"
           title="Automated Testing of Model Transformations"
           year="2021"
           school="University of Model Engineering">
    <authors author="Michael Scott"/>
  </entries>

  <!-- MasterThesis with different school -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesis2020"
           title="Coverage Criteria for Model Transformation Testing"
           year="2020"
           school="Institute of Software Technology">
    <authors author="Nina Adams"/>
  </entries>

</BibTeX:BibTeXFile>