<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
      id="artSmithJones2018"
      title="A Survey of Model Transformation Testing"
      year="2018"
      journal="Journal of Software Engineering Methods">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- TechReport -->
  <entries xsi:type="BibTeX:TechReport"
      id="trMDEGuidelines2020"
      title="Guidelines for Scalable Model-Driven Engineering"
      year="2020">
    <authors author="Carla Rodriguez"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
      id="unpubKuhn2021"
      title="Incremental Testing of ATL Transformations"
      note="Draft manuscript, not yet submitted">
    <authors author="David Kuehn"/>
    <authors author="Eva Müller"/>
  </entries>

  <!-- Manual (no author, no year) -->
  <entries xsi:type="BibTeX:Manual"
      id="manATLTooling"
      title="ATL Transformation Developer Guide 3.1"/>
      
  <!-- Proceedings -->
  <entries xsi:type="BibTeX:Proceedings"
      id="procModelsConf2019"
      title="Proceedings of the 2019 Conference on Model-Driven Engineering"
      year="2019"/>

  <!-- InProceedings extending Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
      id="inprocLee2019"
      title="Traceability-Driven Test Case Generation for Model Transformations"
      year="2019"
      booktitle="Proceedings of the 2019 Conference on Model-Driven Engineering">
    <authors author="Frank Lee"/>
    <authors author="Grace Tan"/>
  </entries>

  <!-- Book with two authors -->
  <entries xsi:type="BibTeX:Book"
      id="bookTestingMDE2016"
      title="Testing and Debugging Model Transformations"
      year="2016"
      publisher="Springer">
    <authors author="Helen Clark"/>
    <authors author="Ian Brown"/>
  </entries>

  <!-- InCollection referencing book-style info and booktitle -->
  <entries xsi:type="BibTeX:InCollection"
      id="inCollChapter7"
      title="Automated Oracles for Model Transformations"
      year="2016"
      publisher="Springer"
      booktitle="Testing and Debugging Model Transformations">
    <authors author="Helen Clark"/>
    <authors author="James White"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook"
      id="inBookChap3"
      title="Mutation-Based Testing of ATL Transformations"
      year="2016"
      publisher="Springer"
      chapter="3">
    <authors author="Ian Brown"/>
  </entries>

  <!-- Booklet, only year required -->
  <entries xsi:type="BibTeX:Booklet"
      id="bookletIntroMDE2015"
      year="2015"/>

  <!-- Misc entry without extra attributes -->
  <entries xsi:type="BibTeX:Misc"
      id="miscWebResourceTransformations"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
      id="phdGarcia2022"
      title="Quality Assurance Techniques for Model Transformations"
      year="2022"
      school="Technical University of Madrid">
    <authors author="Laura Garcia"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
      id="mscNguyen2020"
      title="Model-Based Test Data Generation for ATL Transformations"
      year="2020"
      school="University of Stuttgart">
    <authors author="Minh Nguyen"/>
  </entries>

</BibTeX:BibTeXFile>