<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020-scalable"
           title="Scalable Model Transformations"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="John Smith"/>
    <authors author="Emily Clark"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="doe2019-report"
           title="A Report on ATL Testing"
           year="2019">
    <authors author="Jane Doe"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="miller2024-unreleased"
           title="Unreleased Study on Bidirectional Transformations"
           note="Draft under internal review">
    <authors author="Michael Miller"/>
    <authors author="Sara Lee"/>
    <authors author="Carlos Alvarez"/>
  </entries>

  <!-- Manual (no authors, no year, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="atltool-manual"
           title="ATL Transformation Toolkit User Guide"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmt2021-proc"
           title="Proceedings of the International Conference on Model Transformations"
           year="2021"/>
  
  <!-- InProceedings: inherits Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="garcia2021-inproc"
           title="Testing Strategies for Model Transformations"
           year="2021"
           booktitle="ICMT 2021: Proceedings of the International Conference on Model Transformations">
    <authors author="Laura Garcia"/>
    <authors author="Tom Becker"/>
  </entries>

  <!-- Booklet (only year) -->
  <entries xsi:type="BibTeX:Booklet"
           id="pamphlet2022"
           year="2022"/>

  <!-- Book with two authors -->
  <entries xsi:type="BibTeX:Book"
           id="brown2018-book"
           title="Foundations of Model-Driven Engineering"
           year="2018"
           publisher="Springer">
    <authors author="Alan Brown"/>
    <authors author="Nina Rossi"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="rossi2018-chapter"
           title="Validation and Verification in MDE"
           year="2018"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Nina Rossi"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="brown2018-chapter5"
           title="Chapter 5: Testing Transformations"
           year="2018"
           publisher="Springer"
           chapter="5">
    <authors author="Alan Brown"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-ref-001"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="wang2017-phd"
           title="Model Transformation Testing Techniques"
           year="2017"
           school="Technical University of Munich">
    <authors author="Li Wang"/>
  </entries>

  <!-- MasterThesis with two authors (co-authored thesis, allowed by metamodel) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="cooper2020-master"
           title="Incremental Testing of ATL Transformations"
           year="2020"
           school="University of York">
    <authors author="David Cooper"/>
    <authors author="Helen Young"/>
  </entries>

</BibTeX:BibTeXFile>