<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
      id="smith2020deep"
      title="Deep Learning for Model Transformations"
      year="2020"
      journal="Journal of Model Engineering">
    <authors author="John Smith"/>
    <authors author="Emily Clark"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
      id="lee2018mde"
      title="Industrial Adoption of Model-Driven Engineering"
      year="2018">
    <authors author="Michael Lee"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
      id="garcia2023draft"
      title="Draft Specification of a Transformation Testing Framework"
      note="Manuscript in preparation">
    <authors author="Laura Garcia"/>
    <authors author="Thomas Nguyen"/>
  </entries>

  <!-- Manual (titled only) -->
  <entries xsi:type="BibTeX:Manual"
      id="toolUserGuide"
      title="User Guide for the MetaTransform Toolset"/>

  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
      id="mdeconf2019"
      title="Proceedings of the 2019 Conference on Model Transformations"
      year="2019"/>

  <!-- InProceedings that reuses the Proceedings semantics and has its own booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
      id="anderson2019testing"
      title="Systematic Testing of ATL Transformations"
      year="2019"
      booktitle="Proceedings of the 2019 Conference on Model Transformations">
    <authors author="Sarah Anderson"/>
    <authors author="John Smith"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet"
      id="shortIntroMDE"
      year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
      id="brown2015book"
      title="Foundations of Model-Driven Engineering"
      year="2015"
      publisher="TechPress Publishing">
    <authors author="David Brown"/>
    <authors author="Helen Scott"/>
  </entries>

  <!-- InCollection: a chapter in an edited book (inherits Book and BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
      id="miller2016chapter"
      title="Quality Assurance for Model Transformations"
      year="2016"
      publisher="TechPress Publishing"
      booktitle="Advances in Model-Driven Engineering">
    <authors author="Karen Miller"/>
  </entries>

  <!-- InBook: specific chapter in a book with chapter number -->
  <entries xsi:type="BibTeX:InBook"
      id="wagner2015chapter3"
      title="Testing Techniques for Transformations"
      year="2015"
      publisher="TechPress Publishing"
      chapter="3">
    <authors author="Paul Wagner"/>
  </entries>

  <!-- Misc entry with only an id -->
  <entries xsi:type="BibTeX:Misc"
      id="miscNoteOnTools"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
      id="roberts2021phd"
      title="Scalable Testing Approaches for Model Transformations"
      year="2021"
      school="University of Metamodeling">
    <authors author="Olivia Roberts"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
      id="young2019masters"
      title="Automated Regression Testing of ATL Models"
      year="2019"
      school="Institute of Software Technology">
    <authors author="Kevin Young"/>
  </entries>

</BibTeX:BibTeXFile>