<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art:deep-learning-2015"
           title="Deep Learning Foundations"
           year="2015"
           journal="Journal of Artificial Intelligence Research">
    <authors author="Ian Goodfellow"/>
    <authors author="Yoshua Bengio"/>
    <authors author="Aaron Courville"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr:model-transformations-2019"
           title="Formal Analysis of Model Transformations"
           year="2019">
    <authors author="Alice Martin"/>
  </entries>

  <!-- Unpublished with multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub:ocl-constraints-2020"
           title="OCL Constraints in Practice"
           note="Manuscript in preparation">
    <authors author="Bob Keller"/>
    <authors author="Carla Diaz"/>
  </entries>

  <!-- Manual (no author/year required by metamodel) -->
  <entries xsi:type="BibTeX:Manual"
           id="man:atl-user-guide"
           title="ATL User Guide and Reference Manual"/>
  
  <!-- Proceedings -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc:models-2021"
           title="Proceedings of the ACM/IEEE 24th International Conference on Model Driven Engineering Languages and Systems"
           year="2021"/>

  <!-- InProceedings, reusing the same booktitle as the Proceedings title -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc:test-generation-2021"
           title="Automated Test Generation for Model Transformations"
           year="2021"
           booktitle="Proceedings of the ACM/IEEE 24th International Conference on Model Driven Engineering Languages and Systems">
    <authors author="David Schmidt"/>
    <authors author="Eva Johansson"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet:mde-intro-2018"
           year="2018"/>

  <!-- Book -->
  <entries xsi:type="BibTeX:Book"
           id="book:mde-patterns-2016"
           title="Model-Driven Engineering Patterns"
           year="2016"
           publisher="Springer">
    <authors author="Frank Brown"/>
    <authors author="Gina Rossi"/>
  </entries>

  <!-- InCollection: a chapter in the above book, with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection:atl-case-studies-2016"
           title="Case Studies in ATL-based Transformations"
           year="2016"
           publisher="Springer"
           booktitle="Model-Driven Engineering Patterns">
    <authors author="Helen Clark"/>
  </entries>

  <!-- InBook: another chapter in the same book with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook:testing-strategies-2016"
           title="Testing Strategies for Model Transformations"
           year="2016"
           publisher="Springer"
           chapter="7">
    <authors author="Isabel Nguyen"/>
    <authors author="John Parker"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc:tool-website"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd:scalability-mde-2014"
           title="Scalability in Model-Driven Engineering"
           year="2014"
           school="Technical University of Munich">
    <authors author="Karl Meier"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master:traceability-2017"
           title="Traceability Techniques for ATL Transformations"
           year="2017"
           school="University of Oslo">
    <authors author="Laura Silva"/>
  </entries>

</BibTeX:BibTeXFile>