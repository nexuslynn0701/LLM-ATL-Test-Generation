<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth"
           title="Scalable Model Transformations"
           year="2019"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_single_auth"
           title="Verification of ATL Transformations"
           year="2020">
    <authors author="Dana White"/>
  </entries>

  <!-- Unpublished entry with two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft"
           title="A Draft on Incremental Model Synchronization"
           note="Work in progress, not for citation">
    <authors author="Eva Green"/>
    <authors author="Frank Hall"/>
  </entries>

  <!-- Manual without authors (allowed because Manual extends only TitledEntry) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_x"
           title="User Guide for ToolX 3.2"/>
           
  <!-- Proceedings (titled and dated, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_symp"
           title="Proceedings of the 5th Symposium on Model Engineering"
           year="2021"/>

  <!-- InProceedings (inherits Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_keynote"
           title="Keynote on Future of MDE"
           year="2021"
           booktitle="Proceedings of the 5th Symposium on Model Engineering">
    <authors author="Grace Lee"/>
  </entries>

  <!-- Booklet (dated only, no title/authors) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_overview"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_m2m_patterns"
           title="Patterns for Model-to-Model Transformations"
           year="2017"
           publisher="Modeling Press">
    <authors author="Henry King"/>
    <authors author="Irene Novak"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter"
           title="Testing Strategies for Transformations"
           year="2017"
           publisher="Modeling Press"
           booktitle="Patterns for Model-to-Model Transformations">
    <authors author="John O&apos;Neil"/>
  </entries>

  <!-- InBook (Book with chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_case_study"
           title="Case Study on Industrial MDE"
           year="2016"
           publisher="Tech Publishing"
           chapter="4">
    <authors author="Karen Park"/>
    <authors author="Liam Quinn"/>
  </entries>

  <!-- Misc without extra attributes -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_web_resource"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_metamodel_evolution"
           title="Managing Metamodel Evolution in Large-Scale Systems"
           year="2015"
           school="University of Metropolis">
    <authors author="Maria Rossi"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_test_automation"
           title="Automation of Model Transformation Testing"
           year="2018"
           school="Tech State University">
    <authors author="Nicolas Brown"/>
  </entries>

</BibTeX:BibTeXFile>