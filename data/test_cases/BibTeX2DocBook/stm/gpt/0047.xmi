<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art0047"
           title="A Comparative Study of Model Transformations"
           year="2022"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carol White"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr0047"
           title="Testing Strategies for ATL Transformations"
           year="2020">
    <authors author="David Brown"/>
  </entries>

  <!-- Unpublished with multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub0047"
           title="Draft Guidelines for Model-Driven Testing"
           note="Work in progress, not for distribution.">
    <authors author="Emily Green"/>
    <authors author="Frank Black"/>
  </entries>

  <!-- Manual without authors (allowed: Manual extends TitledEntry only) -->
  <entries xsi:type="BibTeX:Manual"
           id="man0047"
           title="ATL Tooling User Manual v3.0"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc0047"
           title="Proceedings of the International Conference on Model Engineering"
           year="2021"/>

  <!-- InProceedings: extends Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc0047"
           title="Scalable Evaluation of Model Transformations"
           year="2021"
           booktitle="Proceedings of the International Conference on Model Engineering">
    <authors author="Grace Miller"/>
    <authors author="Henry Wilson"/>
  </entries>

  <!-- Booklet (dated entry only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet0047"
           year="2019"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book0047"
           title="Foundations of Model-Driven Engineering"
           year="2018"
           publisher="Springer">
    <authors author="Ian Taylor"/>
    <authors author="Julia Adams"/>
  </entries>

  <!-- InCollection: Book plus BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection0047"
           title="Advanced Topics in Model Transformation Testing"
           year="2018"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering: Volume II">
    <authors author="Karen Scott"/>
  </entries>

  <!-- InBook: Book with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook0047"
           title="Chapter-based Evaluation Techniques"
           year="2018"
           publisher="Springer"
           chapter="7">
    <authors author="Liam Turner"/>
    <authors author="Maria Hughes"/>
  </entries>

  <!-- Misc: bare BibTeXEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="misc0047"/>

  <!-- PhDThesis: ThesisEntry specialization -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd0047"
           title="Automated Testing Frameworks for Model Transformations"
           year="2017"
           school="Technical University of Metamodeling">
    <authors author="Nathan Rivera"/>
  </entries>

  <!-- MasterThesis: ThesisEntry specialization with different year/school -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master0047"
           title="Tool Support for BibTeX to DocBook Transformations"
           year="2016"
           school="Institute of Software Systems">
    <authors author="Olivia Perez"/>
  </entries>

</BibTeX:BibTeXFile>