<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_survey_mde_2018"
           title="A Comprehensive Survey on Model-Driven Engineering"
           year="2018"
           journal="Journal of Software Engineering Research and Development">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_mde_tools_2016"
           title="Tool Support for Large-Scale Model Transformations"
           year="2016">
    <authors author="Charlie Lee"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_dsl_case_2020"
           title="Domain-Specific Languages in Safety-Critical Systems"
           note="Submitted to the International Conference on Software Engineering, under review.">
    <authors author="Diana Perez"/>
    <authors author="Evan Thompson"/>
  </entries>

  <!-- Manual without authors (TitledEntry only) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_emf_user_guide"
           title="Eclipse Modeling Framework: User Guide and Reference"/>
           
  <!-- Proceedings (DatedEntry + TitledEntry, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_symposium_2019"
           title="Proceedings of the 7th International Symposium on Model-Driven Engineering"
           year="2019"/>

  <!-- InProceedings extending Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_bidirectional_2019"
           title="Bidirectional Transformations in Practice"
           year="2019"
           booktitle="Proceedings of the 7th International Symposium on Model-Driven Engineering">
    <authors author="Frank Underwood"/>
    <authors author="Grace Hopper"/>
  </entries>

  <!-- Booklet (DatedEntry only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_tutorial"
           year="2015"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_model_transformation_2014"
           title="Model Transformation Engineering"
           year="2014"
           publisher="TechScience Press">
    <authors author="Hannah Green"/>
    <authors author="Ian Black"/>
  </entries>

  <!-- InCollection extending Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_qvtr_chapter"
           title="A Practical Introduction to QVT Relations"
           year="2015"
           publisher="TechScience Press"
           booktitle="Advances in Model Transformation Engineering">
    <authors author="Hannah Green"/>
    <authors author="Jack White"/>
  </entries>

  <!-- InBook extending Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_metamodeling_chapter"
           title="Metamodeling Foundations"
           year="2013"
           publisher="Springer"
           chapter="4">
    <authors author="Karen Brown"/>
  </entries>

  <!-- Misc, minimal BibTeXEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_mde_project_site"/>

  <!-- PhDThesis extending ThesisEntry -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_model_validation_2017"
           title="Model Validation Techniques for Industrial Systems"
           year="2017"
           school="Technical University of Metropolis">
    <authors author="Laura Martin"/>
  </entries>

  <!-- MasterThesis extending ThesisEntry -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_mde_education_2021"
           title="Teaching Model-Driven Engineering in Undergraduate Courses"
           year="2021"
           school="City University of Engineering">
    <authors author="Michael Scott"/>
  </entries>

</BibTeX:BibTeXFile>