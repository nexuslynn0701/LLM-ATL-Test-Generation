<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artSmithJones2020"
           title="Incremental Model Transformation Testing"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="trClark2021"
           title="A Survey on ATL Transformation Verification"
           year="2021">
    <authors author="Charlie Clark"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubMiller2022"
           title="Draft: Scalable Traceability in MDE"
           note="To appear, submitted to SoSyM">
    <authors author="Dana Miller"/>
    <authors author="Evan Brown"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualToolX"
           title="ToolX User Guide Version 3.4"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procICMT2019"
           title="Proceedings of the 12th International Conference on Model Transformation"
           year="2019"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocGarcia2019"
           title="Testing Bidirectional Transformations"
           year="2019"
           booktitle="Proceedings of the 12th International Conference on Model Transformation">
    <authors author="Fernando Garcia"/>
    <authors author="Helen Lee"/>
  </entries>

  <!-- Booklet (only dated entry) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletIntroMDE"
           year="2018"/>

  <!-- Book -->
  <entries xsi:type="BibTeX:Book"
           id="bookJohnson2017"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Ian Johnson"/>
    <authors author="Julia Novak"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollNovak2017"
           title="Testing and Verification of Model Transformations"
           year="2017"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Julia Novak"/>
  </entries>

  <!-- InBook: Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookSmith2017"
           title="Advanced Topics in Transformation Testing"
           year="2017"
           publisher="Springer"
           chapter="7">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="miscOnlineResource01"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisLopez2020"
           title="Formal Methods for Model Transformation Testing"
           year="2020"
           school="Technical University of Madrid">
    <authors author="Carlos Lopez"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisKim2019"
           title="Coverage Criteria for ATL Transformations"
           year="2019"
           school="University of Ottawa">
    <authors author="Grace Kim"/>
  </entries>

</BibTeX:BibTeXFile>