<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artHybrid2021"
           title="A Hybrid Approach to Model Transformation Testing"
           year="2021"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="trMDE2020"
           title="Advances in Model-Driven Engineering"
           year="2020">
    <authors author="Carla Martinez"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraftMDE"
           title="Draft Specification of an MDE Toolchain"
           note="To appear in internal technical documentation.">
    <authors author="Daniel Nguyen"/>
    <authors author="Eva Rossi"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualToolRef"
           title="Reference Manual for the TransFoX Tool"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procMDEConf2019"
           title="Proceedings of the International Conference on MDE"
           year="2019"/>

  <!-- InProceedings that references a proceedings-like entry (as a BibTeX entry type) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocTrace2019"
           title="Traceability in Large-Scale Transformations"
           year="2019"
           booktitle="Proceedings of the International Conference on MDE">
    <authors author="Frank Liu"/>
    <authors author="Grace Kim"/>
  </entries>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDEFundamentals"
           title="Fundamentals of Model-Driven Engineering"
           year="2018"
           publisher="ModelTech Press">
    <authors author="Helen Clark"/>
    <authors author="Ian Thompson"/>
  </entries>

  <!-- InCollection within an edited book -->
  <entries xsi:type="BibTeX:InCollection"
           id="chapterTestingMDE"
           title="Testing Model Transformations"
           year="2018"
           publisher="ModelTech Press"
           booktitle="Fundamentals of Model-Driven Engineering">
    <authors author="Julia Becker"/>
  </entries>

  <!-- InBook chapter with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="chapterAutomation"
           title="Automation Patterns in MDE"
           year="2017"
           publisher="Software Architecture House"
           chapter="7">
    <authors author="Karl O&apos;Brien"/>
    <authors author="Laura Schmidt"/>
  </entries>

  <!-- Booklet (dated but minimal) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletShortIntro"
           year="2016"/>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscOnlineResource"/>

  <!-- PhD Thesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdModelTesting"
           title="Systematic Testing of Model Transformations"
           year="2015"
           school="University of Metamodeling">
    <authors author="Michael Brown"/>
  </entries>

  <!-- Master Thesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mscCaseStudies"
           title="Case Studies in Model Transformation Validation"
           year="2014"
           school="Institute of Software Models">
    <authors author="Nina Petrova"/>
  </entries>

</BibTeX:BibTeXFile>