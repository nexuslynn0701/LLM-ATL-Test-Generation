<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_author"
           title="Scalable Model Transformations in Practice"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="Alice Example"/>
    <authors author="Bob Sample"/>
    <authors author="Charlie Test"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech_mde_eval"
           title="An Evaluation of Model Transformation Testing Techniques"
           year="2019">
    <authors author="Diana Researcher"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_dsl"
           title="A DSL for Automated Test Data Generation"
           note="Submitted for publication; currently under major revision.">
    <authors author="Evan Developer"/>
    <authors author="Fiona Analyst"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="man_tool_guide"
           title="User Guide for the MetaTrans Toolchain"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_conf_2021"
           title="Proceedings of the International Conference on Model Engineering"
           year="2021"/>
           
  <!-- InProceedings with authors, year, title, and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study"
           title="Case Studies in Bidirectional Model Transformations"
           year="2021"
           booktitle="Proceedings of the International Conference on Model Engineering">
    <authors author="Grace Architect"/>
    <authors author="Henry Integrator"/>
  </entries>

  <!-- Booklet (only year) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_short_tutorial"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_fundamentals"
           title="Fundamentals of Model-Driven Engineering"
           year="2017"
           publisher="ACME Academic Press">
    <authors author="Irene Scholar"/>
    <authors author="John Lecturer"/>
  </entries>

  <!-- InCollection: extends Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_metamodels"
           title="Metamodel Design Patterns"
           year="2017"
           publisher="ACME Academic Press"
           booktitle="Fundamentals of Model-Driven Engineering">
    <authors author="Karen Designer"/>
  </entries>

  <!-- InBook: Book specialization with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_testing"
           title="Testing Model Transformations"
           year="2017"
           publisher="ACME Academic Press"
           chapter="7">
    <authors author="Laura Tester"/>
    <authors author="Mike Engineer"/>
  </entries>

  <!-- Misc entry with only mandatory id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_tool_website"/>

  <!-- PhDThesis with one author -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_mde_quality"
           title="Quality Assurance for Model Transformations"
           year="2016"
           school="University of Model City">
    <authors author="Nina Doctoral"/>
  </entries>

  <!-- MasterThesis with two authors (co-supervised style) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_migration"
           title="Migrating Legacy Systems via Model Transformations"
           year="2015"
           school="Institute of Software Systems">
    <authors author="Oscar Student"/>
    <authors author="Pat Mentor"/>
  </entries>

</BibTeX:BibTeXFile>