<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article" id="art_multi_auth" title="Multi-Author Empirical Study" year="2019" journal="Journal of Empirical Software Engineering">
    <authors author="Alice Example"/>
    <authors author="Bob Researcher"/>
    <authors author="Carlos Analyst"/>
  </entries>

  <!-- TechReport -->
  <entries xsi:type="BibTeX:TechReport" id="tech_rep_01" title="Verification of Model Transformations" year="2018">
    <authors author="Diana Tester"/>
  </entries>

  <!-- Unpublished -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub_draft" title="Unreleased Draft on MDE" note="Work in progress, do not cite">
    <authors author="Eve Architect"/>
    <authors author="Frank Reviewer"/>
  </entries>

  <!-- Manual (no author, no year) -->
  <entries xsi:type="BibTeX:Manual" id="tool_manual_v2" title="ToolX User Manual Version 2.0"/>

  <!-- Proceedings (dated + titled, but no authors/booktitle) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc_conf_2021" title="Proceedings of the International Conference on Model Engineering" year="2021"/>

  <!-- InProceedings (inherits Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc_case_study" title="Case Study on Model Transformation Testing" year="2021" booktitle="Proceedings of the International Conference on Model Engineering">
    <authors author="Grace Scientist"/>
    <authors author="Henry Developer"/>
  </entries>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book" id="book_mde_intro" title="Introduction to Model-Driven Engineering" year="2016" publisher="TechBooks Publishing">
    <authors author="Ivy Mentor"/>
    <authors author="John Instructor"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection" id="incollection_chapter" title="Testing Transformations in Practice" year="2017" publisher="Academic Press" booktitle="Advances in Software Modeling">
    <authors author="Karen Practitioner"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook" id="inbook_chapter_5" title="Chapter on Traceability" year="2015" publisher="MDE Press" chapter="5">
    <authors author="Leo Author"/>
    <authors author="Maria Coauthor"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet_short_guide" year="2014"/>

  <!-- Misc (minimal, only id) -->
  <entries xsi:type="BibTeX:Misc" id="misc_resource_01"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd_mde" title="Scalable Techniques for Model-Driven Engineering" year="2013" school="University of Model Engineering">
    <authors author="Nina Doctoral"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis" id="msc_testing" title="Automated Testing of ATL Transformations" year="2020" school="Institute of Software Technology">
    <authors author="Oscar Student"/>
  </entries>

</BibTeX:BibTeXFile>