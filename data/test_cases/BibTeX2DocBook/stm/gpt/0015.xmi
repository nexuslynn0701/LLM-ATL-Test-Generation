<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_smith2020"
           title="Model-Driven Engineering for Heterogeneous Systems"
           year="2020"
           journal="Journal of Software Engineering">
    <authors author="John Smith"/>
    <authors author="Anne Brown"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_lee2019"
           title="Assessing Model Transformation Quality"
           year="2019">
    <authors author="Kevin Lee"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unp_millerDraft"
           title="Draft Guidelines for ATL Testing"
           note="Under review, not yet submitted">
    <authors author="Sara Miller"/>
    <authors author="Tom Clark"/>
  </entries>

  <!-- Manual (no authors, only title required via TitledEntry) -->
  <entries xsi:type="BibTeX:Manual"
           id="man_toolX"
           title="ToolX User Reference Manual"/>
           
  <!-- Proceedings (dated and titled, but no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde2021"
           title="Proceedings of the 2021 Conference on Model-Driven Engineering"
           year="2021"/>

  <!-- InProceedings: authored, dated, titled (from Proceedings and BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_garcia2021"
           title="Testing Strategies for Model Transformations"
           year="2021"
           booktitle="Proceedings of the 2021 Conference on Model-Driven Engineering">
    <authors author="Luis Garcia"/>
    <authors author="Emily Davis"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_introMDE"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_roberts2017"
           title="Foundations of Model Transformation"
           year="2017"
           publisher="TechPress Publishing">
    <authors author="Michael Roberts"/>
    <authors author="Olivia Turner"/>
  </entries>

  <!-- InCollection: extends Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol_segment2017"
           title="Case Studies in Model Transformation Testing"
           year="2017"
           publisher="TechPress Publishing"
           booktitle="Foundations of Model Transformation">
    <authors author="Michael Roberts"/>
    <authors author="Nina Patel"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter3"
           title="Empirical Evaluation Methods"
           year="2017"
           publisher="TechPress Publishing"
           chapter="3">
    <authors author="Olivia Turner"/>
  </entries>

  <!-- Misc: only id required -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_webResource01"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_wang2022"
           title="Scalable Testing Techniques for ATL Transformations"
           year="2022"
           school="University of Technology">
    <authors author="Li Wang"/>
  </entries>

  <!-- MasterThesis with multiple authors (unusual but structurally valid) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_khan2020"
           title="Automation Frameworks for Model-Driven Testing"
           year="2020"
           school="Institute of Computer Science">
    <authors author="Amir Khan"/>
    <authors author="Co-Supervisor: Julia Evans"/>
  </entries>

</BibTeX:BibTeXFile>