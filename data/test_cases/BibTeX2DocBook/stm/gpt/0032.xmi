<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth"
           title="Scalable Model Transformation Testing"
           year="2018"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Martinez"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech_single_auth"
           title="Industrial Experiences with ATL Transformations"
           year="2019">
    <authors author="Diana Brown"/>
  </entries>

  <!-- Unpublished entry (no year, but note required) -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft_paper"
           title="A Draft on Incremental Model Synchronization"
           note="Draft version, not yet submitted">
    <authors author="Ethan Davis"/>
    <authors author="Fiona Clark"/>
  </entries>

  <!-- Manual (only title, no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_guide"
           title="User Guide for the MetaTransf Tool Suite"/>

  <!-- Proceedings (dated, titled, but no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_symposium"
           title="Proceedings of the International Symposium on Model Engineering"
           year="2020"/>

  <!-- InProceedings (inherits Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study"
           title="Case Study: Testing Bidirectional Transformations"
           year="2020"
           booktitle="Proceedings of the International Symposium on Model Engineering">
    <authors author="George Harris"/>
    <authors author="Helen Ito"/>
  </entries>

  <!-- Booklet (only year) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_tutorial"
           year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_textbook"
           title="Foundations of Model-Driven Engineering"
           year="2015"
           publisher="ModelPress Publications">
    <authors author="Ian Jackson"/>
    <authors author="Julia King"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter"
           title="Testing Strategies for Graph Transformations"
           year="2016"
           publisher="TechBooks International"
           booktitle="Advances in Model Transformation Techniques">
    <authors author="Kevin Lewis"/>
  </entries>

  <!-- InBook (Book + extra chapter attribute) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_5"
           title="Model Transformation Debugging"
           year="2015"
           publisher="ModelPress Publications"
           chapter="5">
    <authors author="Ian Jackson"/>
    <authors author="Laura Nelson"/>
  </entries>

  <!-- Misc (minimal concrete BibTeXEntry) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_website_reference"/>

  <!-- PhDThesis (ThesisEntry specialization) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_mde_testing"
           title="Systematic Testing of Model Transformations"
           year="2014"
           school="University of Model Engineering">
    <authors author="Michael Owens"/>
  </entries>

  <!-- MasterThesis (ThesisEntry specialization, different school) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_incremental_sync"
           title="Incremental Synchronization of Heterogeneous Models"
           year="2013"
           school="Institute of Software Systems">
    <authors author="Nora Patel"/>
  </entries>

</BibTeX:BibTeXFile>