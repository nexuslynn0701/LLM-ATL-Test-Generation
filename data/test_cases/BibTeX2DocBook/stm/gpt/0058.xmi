<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_survey_2020"
           title="A Comprehensive Survey on Model Transformation Testing"
           year="2020"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carol Williams"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_mde_tools_2018"
           title="Evaluation of MDE Toolchains for Industrial Use"
           year="2018">
    <authors author="David Brown"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_xtend_2023"
           title="Experiments with Incremental Model Transformations"
           note="Submitted to the International Conference on Model Transformations">
    <authors author="Eva Green"/>
    <authors author="Frank Miller"/>
  </entries>

  <!-- Manual without authors -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_atl_guide"
           title="ATL Transformation Developer Guide"/>
  
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_icmt_2019"
           title="Proceedings of the 12th International Conference on Model Transformations"
           year="2019"/>

  <!-- InProceedings with its own title, year, booktitle, and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_traceability_2019"
           title="Ensuring Traceability in Large-Scale Model Transformations"
           year="2019"
           booktitle="Proceedings of the 12th International Conference on Model Transformations">
    <authors author="Grace Lee"/>
    <authors author="Henry Clark"/>
  </entries>

  <!-- Booklet (dated entry only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_intro"
           year="2016"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns"
           title="Patterns for Model-Driven Engineering"
           year="2015"
           publisher="TechPress Publishing">
    <authors author="Isabella Turner"/>
    <authors author="Jack Robinson"/>
  </entries>

  <!-- InCollection: chapter in an edited book with booktitle and publisher -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_testing_chapter"
           title="Testing Strategies for Model Transformations"
           year="2017"
           publisher="Engineering Books Ltd."
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Karen Davis"/>
    <authors author="Liam Thompson"/>
  </entries>

  <!-- InBook: a specific chapter of a book -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter5_mde"
           title="Case Studies in Industrial MDE Adoption"
           year="2015"
           publisher="TechPress Publishing"
           chapter="5">
    <authors author="Isabella Turner"/>
    <authors author="Michael Scott"/>
  </entries>

  <!-- Misc entry without additional attributes -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_mde_blog_post"/>

  <!-- PhD thesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_formal_testing_2021"
           title="Formal Approaches to Testing Model Transformations"
           year="2021"
           school="University of Software Engineering">
    <authors author="Natalie Perez"/>
  </entries>

  <!-- Master thesis with two authors (co-authored thesis) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_trace_tools_2019"
           title="Tool Support for Traceability in Model Transformations"
           year="2019"
           school="Institute of Computer Science">
    <authors author="Oliver King"/>
    <authors author="Paula Adams"/>
  </entries>

</BibTeX:BibTeXFile>