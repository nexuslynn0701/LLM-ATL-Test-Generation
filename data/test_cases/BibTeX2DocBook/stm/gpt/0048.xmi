<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth_2021"
           title="A Survey on Model Transformation Testing"
           year="2021"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_mde_2019"
           title="Industrial Experiences with ATL Transformations"
           year="2019">
    <authors author="Carlos Martinez"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_dsl_idea"
           title="An Unpublished Idea on Domain-Specific Debugging"
           note="Draft circulated within the research group only.">
    <authors author="Dana Lee"/>
    <authors author="Ethan Brown"/>
  </entries>

  <!-- Manual (no authors, only title required) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_guide"
           title="ATL Transformation Tool User Guide"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_conf_2020"
           title="Proceedings of the 2020 Conference on Model-Driven Engineering"
           year="2020"/>

  <!-- InProceedings (inherits Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_test_strategy"
           title="Test Strategies for Bidirectional Model Transformations"
           year="2020"
           booktitle="Proceedings of the 2020 Conference on Model-Driven Engineering">
    <authors author="Fiona Green"/>
    <authors author="George White"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_intro_mde"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns"
           title="Patterns for Model-Driven Engineering"
           year="2017"
           publisher="TechPress International">
    <authors author="Helen Clark"/>
    <authors author="Ian Thompson"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_metamodels"
           title="Metamodeling Fundamentals"
           year="2017"
           publisher="TechPress International"
           booktitle="Patterns for Model-Driven Engineering">
    <authors author="Helen Clark"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_testing"
           title="Testing Model Transformations"
           year="2017"
           publisher="TechPress International"
           chapter="5">
    <authors author="Ian Thompson"/>
  </entries>

  <!-- Misc entry (minimal) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_website_resource"/>

  <!-- PhDThesis (ThesisEntry specialization) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_thesis_transformation"
           title="Quality Assurance for Model Transformations"
           year="2016"
           school="University of Model Engineering">
    <authors author="Julia Novak"/>
  </entries>

  <!-- MasterThesis (ThesisEntry specialization) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_thesis_coverage"
           title="Coverage Criteria for ATL Transformations"
           year="2015"
           school="Institute of Software Systems">
    <authors author="Kevin O'Neil"/>
  </entries>

</BibTeX:BibTeXFile>