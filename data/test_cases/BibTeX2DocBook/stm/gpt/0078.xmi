<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artMultiAuth2020"
           title="A Comprehensive Survey on Model Transformation Testing"
           year="2020"
           journal="Journal of Software Engineering Research and Development">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Simple TechReport -->
  <entries xsi:type="BibTeX:TechReport"
           id="techReportMT2021"
           title="Industrial Experiences with ATL Transformations"
           year="2021">
    <authors author="Caroline Brown"/>
  </entries>

  <!-- Unpublished entry (no year, has note) -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraft3"
           title="Towards Automated Oracle Derivation for Model Transformations"
           note="Under review for journal submission">
    <authors author="David Green"/>
    <authors author="Emily White"/>
  </entries>

  <!-- Manual (title only) -->
  <entries xsi:type="BibTeX:Manual"
           id="atlUserGuide2022"
           title="ATL Transformation Language User Guide 3.0"/>
           
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procMDEConf2019"
           title="Proceedings of the 15th Conference on Model-Driven Engineering"
           year="2019"/>

  <!-- InProceedings, referencing a proceedings-type entry (inherits Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inProcSessionA"
           title="Testing Transformation Chains in Practice"
           year="2019"
           booktitle="Proceedings of the 15th Conference on Model-Driven Engineering">
    <authors author="Frank Harris"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Booklet (only year required) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletFlyer2023"
           year="2023"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDEPatterns2018"
           title="Patterns and Best Practices in Model-Driven Engineering"
           year="2018"
           publisher="TechPress Publishing">
    <authors author="Helen Martin"/>
    <authors author="Ian Thompson"/>
  </entries>

  <!-- InCollection (book + booktitle, uses same authors as book, but could differ) -->
  <entries xsi:type="BibTeX:InCollection"
           id="inCollectionChap5"
           title="Validation Strategies for Model Transformations"
           year="2018"
           publisher="TechPress Publishing"
           booktitle="Patterns and Best Practices in Model-Driven Engineering">
    <authors author="Jack Wilson"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookChap2"
           title="Foundations of Model-Driven Testing"
           year="2017"
           publisher="Academic World Press"
           chapter="2">
    <authors author="Laura King"/>
    <authors author="Michael Scott"/>
  </entries>

  <!-- Misc entry (minimal) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscOnlineToolRef"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesis2016"
           title="Quality Assurance for Model Transformations"
           year="2016"
           school="University of Metropolis">
    <authors author="Natalie Young"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mscThesis2015"
           title="Automated Test Generation for ATL Transformations"
           year="2015"
           school="Institute of Software Technology">
    <authors author="Oliver Perez"/>
  </entries>

</BibTeX:BibTeXFile>