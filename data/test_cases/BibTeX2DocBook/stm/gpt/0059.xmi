<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-smith-2020-ml"
           title="Advances in Machine Learning"
           year="2020"
           journal="Journal of AI Research">
    <authors author="John Smith"/>
    <authors author="Emily Clark"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr-jones-2018-formal"
           title="Formal Methods in Software Engineering"
           year="2018">
    <authors author="Michael Jones"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-brown-ideas"
           title="Unreleased Ideas on Model Transformations"
           note="Draft version, not for citation">
    <authors author="Laura Brown"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- Manual without authors -->
  <entries xsi:type="BibTeX:Manual"
           id="man-tool-usage"
           title="User Manual for the TransformX Tool"/>
  
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-mde-2022"
           title="Proceedings of the MDE Conference 2022"
           year="2022"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-lee-2022-testing"
           title="Testing Model Transformations Thoroughly"
           year="2022"
           booktitle="Proceedings of the MDE Conference 2022">
    <authors author="Kevin Lee"/>
    <authors author="Nina Patel"/>
  </entries>

  <!-- Booklet: only dated -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-overview-2019"
           year="2019"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book-mde-practices"
           title="Model-Driven Engineering in Practice"
           year="2017"
           publisher="TechPress">
    <authors author="Anna Müller"/>
    <authors author="Robert White"/>
  </entries>

  <!-- InCollection: based on Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection-zhang-2017-patterns"
           title="Design Patterns for Model Transformations"
           year="2017"
           publisher="TechPress"
           booktitle="Model-Driven Engineering in Practice">
    <authors author="Wei Zhang"/>
  </entries>

  <!-- InBook: Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-garcia-2015-chapter3"
           title="Verification of Transformations"
           year="2015"
           publisher="Springer"
           chapter="3">
    <authors author="Maria Garcia"/>
    <authors author="Thomas Keller"/>
  </entries>

  <!-- Misc entry -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-online-resource"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd-novak-2021"
           title="Automated Testing of Model Transformations"
           year="2021"
           school="University of Metropolis">
    <authors author="Peter Novak"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc-lin-2020"
           title="Traceability in Model-Driven Engineering"
           year="2020"
           school="Tech University">
    <authors author="Sarah Lin"/>
  </entries>

</BibTeX:BibTeXFile>