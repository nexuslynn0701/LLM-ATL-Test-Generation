<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020deep"
           title="Deep Learning for Model Transformations"
           year="2020"
           journal="Journal of Model-Driven Engineering">
    <authors author="John Smith"/>
    <authors author="Alice Johnson"/>
    <authors author="Wei Zhang"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="doe2018report"
           title="A Survey on ATL Transformation Testing"
           year="2018">
    <authors author="Jane Doe"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="miller2022draft"
           title="Runtime Verification of Model Transformations"
           note="Working draft, not yet submitted">
    <authors author="Paul Miller"/>
    <authors author="Sara Lee"/>
  </entries>

  <!-- Manual (title only, no authors/year) -->
  <entries xsi:type="BibTeX:Manual"
           id="atlUserGuide"
           title="ATL User Guide 3.0"/>

  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmt2019proc"
           title="Proceedings of the 12th International Conference on Model Transformation"
           year="2019"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="garcia2019coverage"
           title="Coverage Criteria for Model Transformations"
           year="2019"
           booktitle="Proceedings of the 12th International Conference on Model Transformation">
    <authors author="Luis Garcia"/>
    <authors author="Emily Brown"/>
  </entries>

  <!-- Booklet: only dated -->
  <entries xsi:type="BibTeX:Booklet"
           id="lee2021tutorial"
           year="2021"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="gamma1994patterns"
           title="Design Patterns: Elements of Reusable Object-Oriented Software"
           year="1994"
           publisher="Addison-Wesley">
    <authors author="Erich Gamma"/>
    <authors author="Richard Helm"/>
    <authors author="Ralph Johnson"/>
    <authors author="John Vlissides"/>
  </entries>

  <!-- InCollection: book + booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="brown2017chapter"
           title="Testing Model Transformations"
           year="2017"
           publisher="Springer"
           booktitle="Advanced Topics in Model-Driven Engineering">
    <authors author="Emily Brown"/>
    <authors author="Thomas Nguyen"/>
  </entries>

  <!-- InBook: chapter-based book entry -->
  <entries xsi:type="BibTeX:InBook"
           id="smith2015chapter5"
           title="Case Studies in Transformation Testing"
           year="2015"
           publisher="Morgan Kaufmann"
           chapter="5">
    <authors author="John Smith"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry (only id) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscResource01"/>

  <!-- PhDThesis: ThesisEntry specialization -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="kim2020phd"
           title="Scalable Testing Techniques for Model Transformations"
           year="2020"
           school="Technical University of Metamodeling">
    <authors author="Min-Jae Kim"/>
  </entries>

  <!-- MasterThesis: ThesisEntry specialization, multiple authors (unusual but allowed) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="rodriguez2019msc"
           title="Mutation Analysis for ATL Transformations"
           year="2019"
           school="University of Software Engineering">
    <authors author="Carlos Rodriguez"/>
    <authors author="Co-supervised by Anna Schmidt"/>
  </entries>

</BibTeX:BibTeXFile>