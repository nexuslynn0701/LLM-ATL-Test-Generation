<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_syntax_001"
           title="A Comprehensive Study of Model Transformation Testing"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="Alice Example"/>
    <authors author="Bob Sample"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_validation_002"
           title="Validation Techniques for ATL Transformations"
           year="2019">
    <authors author="Charlie Tester"/>
  </entries>

  <!-- Unpublished with note and several authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft_003"
           title="Draft Guidelines for BibTeX to DocBook Transformations"
           note="Under review and not yet publicly available.">
    <authors author="Dana Reviewer"/>
    <authors author="Evan Contributor"/>
  </entries>

  <!-- Manual (only titled) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_004"
           title="User Manual for the Transformation Testing Toolkit"/>
           
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_conf_005"
           title="Proceedings of the International Conference on Model Transformation"
           year="2021"/>

  <!-- InProceedings: authored + proceedings + booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_006"
           title="Case Studies in Bidirectional Model Transformations"
           year="2021"
           booktitle="ICMT 2021">
    <authors author="Fiona Case"/>
    <authors author="George Researcher"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_intro_007"
           year="2018"/>

  <!-- Book: authored, dated, titled, with publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_008"
           title="Foundations of Model-Driven Engineering"
           year="2016"
           publisher="TechPress Publishing">
    <authors author="Helen Architect"/>
    <authors author="Ian Designer"/>
  </entries>

  <!-- InCollection: specialization of Book + booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_009"
           title="Testing Strategies for Large-Scale Transformations"
           year="2017"
           publisher="Global Science Publishers"
           booktitle="Advances in Model Engineering">
    <authors author="Julia Tester"/>
  </entries>

  <!-- InBook: specialization of Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_section_010"
           title="Automated Test Generation for Model Transformations"
           year="2015"
           publisher="Academic House"
           chapter="4">
    <authors author="Kevin Automation"/>
    <authors author="Laura Quality"/>
  </entries>

  <!-- Misc: bare BibTeXEntry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_resource_011"/>

  <!-- PhDThesis: concrete ThesisEntry -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_thesis_012"
           title="Formal Methods for Testing ATL Transformations"
           year="2014"
           school="University of Model Engineering">
    <authors author="Martin Doctoral"/>
  </entries>

  <!-- MasterThesis: concrete ThesisEntry -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_thesis_013"
           title="Coverage Criteria for Model Transformation Testing"
           year="2013"
           school="Institute of Software Technology">
    <authors author="Nina Graduate"/>
  </entries>

</BibTeX:BibTeXFile>