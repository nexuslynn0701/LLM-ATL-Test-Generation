<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_smt_solving"
           title="Scalable SMT Solving for Software Verification"
           year="2017"
           journal="Journal of Automated Reasoning">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_model_transformation_testing"
           title="Systematic Testing of Model Transformations"
           year="2018">
    <authors author="Carol White"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_mde_survey"
           title="A Comprehensive Survey on Model-Driven Engineering Tools"
           note="Manuscript submitted for publication">
    <authors author="David Brown"/>
    <authors author="Eva Green"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="man_atl_guide"
           title="ATL Transformation Language Reference Guide"/>
  
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_icmt_2020"
           title="Proceedings of the 13th International Conference on Model Transformation"
           year="2020"/>

  <!-- InProceedings: authored, dated, titled via Proceedings, with booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_traceability"
           title="Traceability Support in Industrial Model Transformations"
           year="2020"
           booktitle="ICMT 2020">
    <authors author="Frank Miller"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Booklet (only year, no title or authors) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_domain_specific"
           year="2015"/>

  <!-- Book with authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_principles"
           title="Principles of Model-Driven Engineering"
           year="2014"
           publisher="TechPress">
    <authors author="Helen Carter"/>
    <authors author="Ian Thompson"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_case_studies"
           title="Case Studies in Industrial MDE Adoption"
           year="2014"
           publisher="TechPress"
           booktitle="Principles of Model-Driven Engineering">
    <authors author="Helen Carter"/>
    <authors author="Jack Wilson"/>
  </entries>

  <!-- InBook extending Book, with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_validation"
           title="Validation of Model Transformations"
           year="2014"
           publisher="TechPress"
           chapter="7">
    <authors author="Ian Thompson"/>
    <authors author="Karen Young"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_tool_website"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_mbt"
           title="Model-Based Testing of Complex Systems"
           year="2013"
           school="University of Metropolis">
    <authors author="Laura Perez"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_bidirectional"
           title="Bidirectional Transformations for Model Synchronization"
           year="2016"
           school="Tech University">
    <authors author="Mark Robinson"/>
  </entries>

</BibTeX:BibTeXFile>