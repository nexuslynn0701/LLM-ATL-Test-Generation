<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-mde-survey"
           title="A Comprehensive Survey on Model-Driven Engineering"
           year="2018"
           journal="Software Systems Journal">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Gomez"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr-mt-testing"
           title="Approaches to Testing Model Transformations"
           year="2019">
    <authors author="Diana Clarke"/>
  </entries>

  <!-- Unpublished with multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-dsl-evolution"
           title="On the Evolution of Domain-Specific Languages"
           note="Draft under internal review">
    <authors author="Erik Lund"/>
    <authors author="Fiona Lee"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="man-atl-reference"
           title="ATL Transformation Language Reference Manual"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-mde-2020"
           title="Proceedings of the International Conference on Model-Driven Engineering"
           year="2020"/>

  <!-- InProceedings: authored, dated, titled, with booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-traceability"
           title="Traceability in Large-Scale Model Transformations"
           year="2020"
           booktitle="Proceedings of the International Conference on Model-Driven Engineering">
    <authors author="George Kahn"/>
    <authors author="Hiroko Tanaka"/>
  </entries>

  <!-- Booklet (only dated entry) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-mde-intro"
           year="2017"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book-mde-principles"
           title="Principles of Model-Driven Engineering"
           year="2015"
           publisher="TechPress Publishing">
    <authors author="Ian Brown"/>
    <authors author="Julia Novak"/>
  </entries>

  <!-- InCollection inside a book (authored, dated, titled, booktitle via inheritance) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection-ocl-constraints"
           title="OCL Constraints in Practice"
           year="2015"
           publisher="TechPress Publishing"
           booktitle="Principles of Model-Driven Engineering">
    <authors author="Karen Müller"/>
    <authors author="Luis Ortega"/>
  </entries>

  <!-- InBook with chapter information -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-testing-chapter"
           title="Testing Transformations"
           year="2015"
           publisher="TechPress Publishing"
           chapter="7">
    <authors author="Ian Brown"/>
  </entries>

  <!-- Misc entry with minimal information -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-mde-website"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd-model-transformation"
           title="Advanced Techniques for Model Transformation Testing"
           year="2016"
           school="University of Software Engineering">
    <authors author="Maria Rossi"/>
  </entries>

  <!-- MasterThesis with different school -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master-traceability"
           title="Traceability Support in ATL Transformations"
           year="2014"
           school="Institute of Computer Science">
    <authors author="Nikolai Petrov"/>
  </entries>

</BibTeX:BibTeXFile>