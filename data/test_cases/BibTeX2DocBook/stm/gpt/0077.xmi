<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth"
           title="A Survey on Model Transformation Testing"
           year="2019"
           journal="Journal of Software Engineering Methods">
    <authors author="Alice Example"/>
    <authors author="Bob Sample"/>
  </entries>

  <!-- TechReport with three authors -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_complex_case"
           title="Industrial Experiences with ATL Transformations"
           year="2020">
    <authors author="Carol Engineer"/>
    <authors author="David Researcher"/>
    <authors author="Eve Practitioner"/>
  </entries>

  <!-- Unpublished with one author -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_mde"
           title="Unreleased Notes on Incremental MDE"
           note="Draft version, do not distribute">
    <authors author="Frank Modeler"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="man_tool"
           title="ATL Tooling Reference Manual"/>
  
  <!-- Proceedings (has title and year, but no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_conf2021"
           title="Proceedings of the 2021 Conference on Model Engineering"
           year="2021"/>

  <!-- InProceedings: authored, dated, titled, and with booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study"
           title="Case Studies in Bidirectional Transformations"
           year="2021"
           booktitle="Proceedings of the 2021 Conference on Model Engineering">
    <authors author="Grace Tester"/>
    <authors author="Henry Analyst"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_short_intro"
           year="2018"/>

  <!-- Book (authored, dated, titled, publisher) -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns"
           title="Patterns of Model-Driven Engineering"
           year="2017"
           publisher="TechPress">
    <authors author="Irene Architect"/>
    <authors author="John Designer"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter"
           title="Testing Strategies for Model Transformations"
           year="2017"
           publisher="TechPress"
           booktitle="Patterns of Model-Driven Engineering">
    <authors author="Kate Verifier"/>
    <authors author="Leo Developer"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_detail"
           title="Advanced Topics in MDE"
           year="2016"
           publisher="Science House"
           chapter="5">
    <authors author="Maria Scientist"/>
  </entries>

  <!-- Misc (no additional mandatory attributes) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_resource"/>

  <!-- PhDThesis (ThesisEntry subtype) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_formal_mde"
           title="Formal Foundations of Model-Driven Engineering"
           year="2015"
           school="University of Metamodeling">
    <authors author="Nathan Scholar"/>
  </entries>

  <!-- MasterThesis (ThesisEntry subtype) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_testing"
           title="Testing Techniques for Model Transformations"
           year="2014"
           school="Institute of Software Modeling">
    <authors author="Olivia Student"/>
  </entries>

</BibTeX:BibTeXFile>