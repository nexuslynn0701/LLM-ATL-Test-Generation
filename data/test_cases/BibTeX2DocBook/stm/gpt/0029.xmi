<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Simple miscellaneous entry without extra fields -->
  <entries xsi:type="BibTeX:Misc" id="misc_unique"/>

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth"
           title="A Survey of Model Transformation Testing Techniques"
           year="2023"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Example"/>
    <authors author="Bob Tester"/>
    <authors author="Charlie Engineer"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech_report_01"
           title="Testing Strategies for ATL Transformations"
           year="2022">
    <authors author="Diana Researcher"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft_01"
           title="Draft Guidelines for MDE Benchmarks"
           note="Work in progress, not for distribution">
    <authors author="Edward Draft"/>
    <authors author="Fiona Reviewer"/>
  </entries>

  <!-- Manual, title only -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_guide"
           title="User Guide for Transformation Testing Framework"/>

  <!-- Proceedings with date and title -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_conf_2021"
           title="Proceedings of the International Conference on Model Transformations"
           year="2021"/>

  <!-- InProceedings inheriting from Proceedings, with booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study"
           title="Case Studies in Automated Model Transformation Validation"
           year="2021"
           booktitle="Proceedings of the International Conference on Model Transformations">
    <authors author="George Analyst"/>
    <authors author="Helen Quality"/>
  </entries>

  <!-- Booklet with year only -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_intro"
           year="2020"/>

  <!-- Book with publisher and authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns"
           title="Patterns for Model-Driven Software Engineering"
           year="2019"
           publisher="Software Engineering Press">
    <authors author="Ian Architect"/>
    <authors author="Julia Designer"/>
  </entries>

  <!-- InCollection, extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter"
           title="Evaluation of Model Transformation Testing Approaches"
           year="2019"
           publisher="Software Engineering Press"
           booktitle="Patterns for Model-Driven Software Engineering">
    <authors author="Karl Evaluator"/>
  </entries>

  <!-- InBook, chapter-based entry -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_example_chapter"
           title="Practical Aspects of ATL Transformation Testing"
           year="2019"
           publisher="Software Engineering Press"
           chapter="7">
    <authors author="Laura Practitioner"/>
    <authors author="Mike Consultant"/>
  </entries>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_mde_testing"
           title="Systematic Testing of Model Transformations"
           year="2018"
           school="University of Model Engineering">
    <authors author="Nina Doctoral"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_traceability"
           title="Traceability Techniques for ATL Transformations"
           year="2020"
           school="Institute of Software Technology">
    <authors author="Oscar Student"/>
  </entries>

</BibTeX:BibTeXFile>