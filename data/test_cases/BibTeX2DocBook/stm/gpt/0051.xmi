<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020deep"
           title="Deep Learning for Model Transformations"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="John Smith"/>
    <authors author="Alice Johnson"/>
  </entries>

  <!-- TechReport with three authors -->
  <entries xsi:type="BibTeX:TechReport"
           id="martin2018report"
           title="A Comprehensive Study of ATL Transformations"
           year="2018">
    <authors author="Martin Fowler"/>
    <authors author="Emily Clark"/>
    <authors author="Robert King"/>
  </entries>

  <!-- Unpublished with single author -->
  <entries xsi:type="BibTeX:Unpublished"
           id="doe2025unpub"
           title="Towards Verified Model Transformations"
           note="Manuscript in preparation">
    <authors author="Jane Doe"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="atlToolManual"
           title="ATL Transformation Tool User Manual"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="mdeconf2022"
           title="Proceedings of the 2022 Conference on Model-Driven Engineering"
           year="2022"/>

  <!-- InProceedings: combines proceedings, authors, and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="lee2022traceability"
           title="Traceability in Model Transformations"
           year="2022"
           booktitle="Proceedings of the 2022 Conference on Model-Driven Engineering">
    <authors author="David Lee"/>
    <authors author="Sara Müller"/>
  </entries>

  <!-- Booklet (only year, minimal) -->
  <entries xsi:type="BibTeX:Booklet"
           id="shortGuideMDE"
           year="2019"/>

  <!-- Book with authors, date, title, and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="green2021mdebook"
           title="Foundations of Model-Driven Engineering"
           year="2021"
           publisher="TechPress Publishing">
    <authors author="Laura Green"/>
    <authors author="Michael Brown"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="garcia2021chapter"
           title="Testing Model Transformations"
           year="2021"
           publisher="TechPress Publishing"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Pedro Garcia"/>
  </entries>

  <!-- InBook with chapter information -->
  <entries xsi:type="BibTeX:InBook"
           id="kim2021inbook"
           title="Formal Semantics of ATL"
           year="2021"
           publisher="TechPress Publishing"
           chapter="7">
    <authors author="Yuna Kim"/>
    <authors author="Thomas White"/>
  </entries>

  <!-- Misc with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscEntry001"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="nguyen2019phd"
           title="Verification Techniques for Model Transformations"
           year="2019"
           school="University of Software Engineering">
    <authors author="An Nguyen"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="patel2020master"
           title="Empirical Evaluation of Transformation Testing Tools"
           year="2020"
           school="Institute of Computer Science">
    <authors author="Ravi Patel"/>
  </entries>

</BibTeX:BibTeXFile>