<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Simple Misc entry without authors, title, or date -->
  <entries xsi:type="BibTeX:Misc" id="miscUniqueId001"/>

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplex2021"
           title="Advanced Topics in Model-Driven Engineering"
           year="2021"
           journal="International Journal of Software and Systems Modeling">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Martinez"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techReportMDE2020"
           title="Industrial Adoption of Model Transformation Testing"
           year="2020">
    <authors author="Diana Roberts"/>
  </entries>

  <!-- Unpublished with two authors and a note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraftMDE"
           title="A Draft Survey on ATL Transformation Testing"
           note="Submitted for review, not yet accepted.">
    <authors author="Emily Turner"/>
    <authors author="Frank Li"/>
  </entries>

  <!-- Manual with only title -->
  <entries xsi:type="BibTeX:Manual"
           id="manualATLUserGuide"
           title="ATL Transformation Language: User Guide and Reference"/>
           
  <!-- Proceedings with date and title, no authors -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procSTAF2019"
           title="Proceedings of the Software Technologies: Applications and Foundations 2019"
           year="2019"/>

  <!-- InProceedings that is both a Proceedings and an AuthoredEntry with booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocTraceability2019"
           title="Ensuring Traceability in Model Transformations"
           year="2019"
           booktitle="Proceedings of the Software Technologies: Applications and Foundations 2019">
    <authors author="George King"/>
    <authors author="Helen Zhao"/>
  </entries>

  <!-- Booklet with only a year -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletMDEIntro"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDEHandbook"
           title="Handbook of Model-Driven Engineering"
           year="2017"
           publisher="TechPress Publishing">
    <authors author="Ian Cooper"/>
    <authors author="Julia Novak"/>
  </entries>

  <!-- InCollection: a chapter within the above bookMDEHandbook (logical relation by text only) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollectionTestingChapter"
           title="Testing and Validation of Model Transformations"
           year="2017"
           publisher="TechPress Publishing"
           booktitle="Handbook of Model-Driven Engineering">
    <authors author="Kevin Brown"/>
  </entries>

  <!-- InBook: a specific chapter with numeric chapter attribute -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookChapter5"
           title="Case Studies in Transformation Testing"
           year="2017"
           publisher="TechPress Publishing"
           chapter="5">
    <authors author="Laura Green"/>
    <authors author="Michael Young"/>
  </entries>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisMDE2022"
           title="Scalable Techniques for Testing Model Transformations"
           year="2022"
           school="University of Model Engineering">
    <authors author="Natalie Hughes"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisATL2023"
           title="Improving ATL Transformation Quality through Automated Testing"
           year="2023"
           school="Institute of Software Systems">
    <authors author="Oliver Perez"/>
  </entries>

</BibTeX:BibTeXFile>