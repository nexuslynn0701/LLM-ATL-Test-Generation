<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_smt2020"
           title="Scalable Model Transformations for Large-Scale Systems"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Brian Johnson"/>
    <authors author="Carla Nguyen"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_mde_bench"
           title="Benchmarking Techniques for Model Transformation Testing"
           year="2019">
    <authors author="David Brown"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_mtl"
           title="A Unified Semantics for Model Transformation Languages"
           note="Draft manuscript under review">
    <authors author="Emma Wilson"/>
    <authors author="Frank Martin"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="man_tool_guide"
           title="User Guide for the HyperTransform Toolset"/>
  
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_conf18"
           title="Proceedings of the 2018 Conference on Model-Driven Engineering"
           year="2018"/>

  <!-- InProceedings (inherits authors, booktitle, title, year) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_trace"
           title="Traceability Support in Incremental Model Transformations"
           booktitle="Proceedings of the 2018 Conference on Model-Driven Engineering"
           year="2018">
    <authors author="George Clark"/>
    <authors author="Helen Turner"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_intro_mde"
           year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_practical_mde"
           title="Practical Model-Driven Engineering"
           year="2016"
           publisher="Modeling Press">
    <authors author="Ian Roberts"/>
    <authors author="Julia Lopez"/>
  </entries>

  <!-- InCollection (chapter in an edited book with booktitle concept via booktitle attribute) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_case_study"
           title="Case Studies in Industrial Model Transformations"
           year="2016"
           publisher="Modeling Press"
           booktitle="Practical Model-Driven Engineering">
    <authors author="Kevin Young"/>
  </entries>

  <!-- InBook (chapter number, shares book features) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_3"
           title="Advanced Testing Strategies"
           year="2016"
           publisher="Modeling Press"
           chapter="3">
    <authors author="Julia Lopez"/>
    <authors author="Ian Roberts"/>
  </entries>

  <!-- Misc (minimal BibTeXEntry, only id) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_web_resource"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_mde_verify"
           title="Verification Methods for Model Transformations"
           year="2015"
           school="University of Metropolis">
    <authors author="Laura Perez"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_mde_tools"
           title="Tool Support for Model Transformation Testing"
           year="2014"
           school="Institute of Software Engineering">
    <authors author="Michael Green"/>
  </entries>

</BibTeX:BibTeXFile>