<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
      id="art:multi-auth"
      title="Scalable Model Transformations in Practice"
      year="2018"
      journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Reyes"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
      id="tr:single-auth"
      title="Testing Strategies for ATL Transformations"
      year="2019">
    <authors author="Diana Clark"/>
  </entries>

  <!-- Unpublished with note and several authors -->
  <entries xsi:type="BibTeX:Unpublished"
      id="unpub:preprint"
      title="Formal Analysis of Bidirectional Transformations"
      note="Under submission to TSE">
    <authors author="Eve Laurent"/>
    <authors author="Frank Mueller"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
      id="man:tool-guide"
      title="ATL Tooling Reference Manual v3.2"/>
  
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
      id="proc:mde-2020"
      title="Proceedings of the International Conference on Model-Driven Engineering"
      year="2020"/>

  <!-- InProceedings: inherits date/title via Proceedings and authors + booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
      id="inproc:keynote"
      title="From Models to Systems: A Keynote on Industrial Adoption"
      year="2020"
      booktitle="ICMDE 2020 Main Track">
    <authors author="Grace Hopper"/>
    <authors author="Henry Ford"/>
  </entries>

  <!-- Booklet: dated only -->
  <entries xsi:type="BibTeX:Booklet"
      id="booklet:tutorial"
      year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
      id="book:mde-handbook"
      title="Handbook of Model-Driven Engineering"
      year="2015"
      publisher="Springer">
    <authors author="Isabel Newton"/>
    <authors author="John O&apos;Connor"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
      id="incol:chapter"
      title="Verification Techniques for Model Transformations"
      year="2015"
      publisher="Springer"
      booktitle="Handbook of Model-Driven Engineering">
    <authors author="Karen Li"/>
    <authors author="Luis Martinez"/>
  </entries>

  <!-- InBook: Book + chapter number -->
  <entries xsi:type="BibTeX:InBook"
      id="inbook:case-study"
      title="Industrial Case Studies in Model Testing"
      year="2016"
      publisher="Elsevier"
      chapter="7">
    <authors author="Maria Rossi"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry (id only) -->
  <entries xsi:type="BibTeX:Misc"
      id="misc:website-reference"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
      id="thesis:phd-robustness"
      title="Robustness Analysis of Model Transformations"
      year="2014"
      school="Technical University of Metropolis">
    <authors author="Nathan Green"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
      id="thesis:msc-evaluation"
      title="Empirical Evaluation of Transformation Testing Techniques"
      year="2013"
      school="Metropolis State University">
    <authors author="Olivia White"/>
    <authors author="Paul Black"/>
  </entries>

</BibTeX:BibTeXFile>