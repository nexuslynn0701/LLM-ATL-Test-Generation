<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article" id="artMultiAuthors" title="Multi-Agent Systems in Practice" year="2019" journal="Journal of Autonomous Agents">
    <authors author="Alice Johnson"/>
    <authors author="Bob Smith"/>
    <authors author="Carlos Martinez"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport" id="trSingleAuthor" title="Formal Verification of Transformations" year="2020">
    <authors author="Diana Prince"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished" id="unpubDraft" title="Preliminary Results on Model Testing" note="Draft version, not for distribution">
    <authors author="Ethan Walker"/>
    <authors author="Fiona Cheng"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual" id="manualToolGuide" title="User Guide for the MetaModeler Tool Suite"/>

  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="procConf2021" title="Proceedings of the 5th Conference on Model Transformations" year="2021"/>

  <!-- InProceedings with authors, booktitle inherited, plus title/year from Proceedings -->
  <entries xsi:type="BibTeX:InProceedings" id="inprocKeynote"
           title="Keynote on Scalable Model Transformations"
           year="2021"
           booktitle="International Conference on Software Modeling and Transformation">
    <authors author="Grace Hopper"/>
    <authors author="Henrik Schmidt"/>
  </entries>

  <!-- Booklet (only dated entry) -->
  <entries xsi:type="BibTeX:Booklet" id="bookletFlyer" year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book" id="bookMDEIntro"
           title="Introduction to Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Isabella Rossi"/>
    <authors author="James Thompson"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection" id="inCollChap"
           title="Chapter on Testing Model Transformations"
           year="2017"
           publisher="Springer"
           booktitle="Advanced Topics in Model-Driven Engineering">
    <authors author="Isabella Rossi"/>
    <authors author="Karen Müller"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook" id="inBookSec"
           title="Section on OCL-Based Validation"
           year="2017"
           publisher="Springer"
           chapter="4">
    <authors author="James Thompson"/>
  </entries>

  <!-- Misc (minimal concrete BibTeXEntry) -->
  <entries xsi:type="BibTeX:Misc" id="miscRef1"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis" id="phdThesisMDETesting"
           title="Systematic Testing of Model Transformations"
           year="2016"
           school="Technical University of Metropolis">
    <authors author="Laura Nguyen"/>
  </entries>

  <!-- MasterThesis with different school -->
  <entries xsi:type="BibTeX:MasterThesis" id="masterThesisMDETools"
           title="Tool Support for Automated Model Comparison"
           year="2015"
           school="Metropolis Institute of Technology">
    <authors author="Michael Brown"/>
  </entries>

</BibTeX:BibTeXFile>