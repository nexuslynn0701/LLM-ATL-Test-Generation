<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_smt2020"
           title="Scalable Model Transformations in Practice"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_mde_tools"
           title="Tool Support for Model-Driven Engineering"
           year="2019">
    <authors author="Carla Mendes"/>
  </entries>

  <!-- Unpublished entry with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_incremental_mt"
           title="Incremental Model Transformation Testing"
           note="Manuscript in preparation">
    <authors author="David Lee"/>
    <authors author="Emma Brown"/>
  </entries>

  <!-- Manual without authors -->
  <entries xsi:type="BibTeX:Manual"
           id="man_atl_guide"
           title="ATL Transformation Language User Guide"/>
           
  <!-- Proceedings (dated and titled, but no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_conf"
           title="Proceedings of the International Conference on Model Engineering"
           year="2018"/>

  <!-- InProceedings inherits authors, booktitle, title, year via supertypes -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_test_coverage"
           title="Achieving High Coverage in Model Transformation Testing"
           year="2018"
           booktitle="Proceedings of the International Conference on Model Engineering">
    <authors author="Frank Green"/>
  </entries>

  <!-- Booklet, only dated -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_intro_mde"
           year="2017"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns"
           title="Patterns for Model-Driven Engineering"
           year="2016"
           publisher="TechBooks Publishing">
    <authors author="Helen Clark"/>
    <authors author="Ian Wright"/>
  </entries>

  <!-- InCollection: specialized book chapter with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol_chapter_validation"
           title="Validation Patterns for Model Transformations"
           year="2016"
           publisher="TechBooks Publishing"
           booktitle="Patterns for Model-Driven Engineering">
    <authors author="Helen Clark"/>
    <authors author="James Davis"/>
  </entries>

  <!-- InBook: chapter in a book with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_tooling"
           title="Tooling Ecosystems for MDE"
           year="2016"
           publisher="TechBooks Publishing"
           chapter="7">
    <authors author="Ian Wright"/>
  </entries>

  <!-- Misc entry with only mandatory id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_model_testing"
           title="Systematic Testing of Model Transformations"
           year="2015"
           school="University of Software Engineering">
    <authors author="Karen Young"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_traceability"
           title="Traceability Management in Model Transformations"
           year="2014"
           school="Institute of Information Technology">
    <authors author="Liam Turner"/>
  </entries>

</BibTeX:BibTeXFile>