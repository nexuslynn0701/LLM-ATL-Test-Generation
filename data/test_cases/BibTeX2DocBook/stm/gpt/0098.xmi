    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplex2020"
           title="A Comprehensive Study on Model Transformations"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Rivera"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techRepMT2021"
           title="Testing Strategies for ATL Transformations"
           year="2021">
    <authors author="Dana Lee"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraft2019"
           title="Draft Guidelines for Model-Driven Testing"
           note="Internal draft, not for distribution">
    <authors author="Eve Clark"/>
    <authors author="Frank Moore"/>
  </entries>

  <!-- Manual (title only) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualToolX"
           title="User Manual for ToolX 3.0"/>
           
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procMDEConf2018"
           title="Proceedings of the 2018 Conference on Model-Driven Engineering"
           year="2018"/>

  <!-- InProceedings: inherits authors, date, title (via Proceedings), and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inProcPaper1"
           title="Traceability in Large-Scale Transformations"
           year="2018"
           booktitle="Proceedings of the 2018 Conference on Model-Driven Engineering">
    <authors author="Grace Hall"/>
    <authors author="Henry Young"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletIntroMDE"
           year="2017"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDEHandbook"
           title="Handbook of Model-Driven Engineering"
           year="2016"
           publisher="Springer">
    <authors author="Irene Novak"/>
    <authors author="Jack Wilson"/>
  </entries>

  <!-- InCollection: chapter in an edited book, with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="inCollChap5"
           title="Chapter 5: Validation of Model Transformations"
           year="2016"
           publisher="Springer"
           booktitle="Handbook of Model-Driven Engineering">
    <authors author="Karen Adams"/>
  </entries>

  <!-- InBook: specific chapter of a book -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookCaseStudy"
           title="Case Studies in Transformation Testing"
           year="2016"
           publisher="Springer"
           chapter="7">
    <authors author="Jack Wilson"/>
  </entries>

  <!-- Misc entry with only an id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscOnlineRef01"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesis2022"
           title="Ensuring Quality in Model Transformations"
           year="2022"
           school="Technical University of Exampleland">
