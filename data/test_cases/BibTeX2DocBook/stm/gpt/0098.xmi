  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesis2020"
           title="Automation of Test Data Generation for ATL"
           year="2020"
           school="Institute of Software Technology">
    <authors author="Michael Brown"/>
