<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art001"
           title="A Declarative Approach to Model Transformations"
           year="2018"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr001"
           title="Testing Strategies for Model Transformations"
           year="2019">
    <authors author="Carol White"/>
  </entries>

  <!-- Unpublished with two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub001"
           title="Preliminary Results on Bidirectional Transformations"
           note="To appear in conference proceedings.">
    <authors author="David Green"/>
    <authors author="Eva Brown"/>
  </entries>

  <!-- Manual without authors -->
  <entries xsi:type="BibTeX:Manual"
           id="man001"
           title="ATL Transformation Language Reference Manual"/>
           
  <!-- Proceedings (no authors, but dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc001"
           title="Proceedings of the International Conference on Model Transformations"
           year="2020"/>

  <!-- InProceedings with authors, booktitle, and inherited title/year from Proceedings -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc001"
           title="Scalable Testing of Model Transformations"
           year="2020"
           booktitle="ICMT 2020">
    <authors author="Frank Miller"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet001"
           year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book001"
           title="Foundations of Model-Driven Engineering"
           year="2015"
           publisher="Springer">
    <authors author="Helen Clark"/>
    <authors author="Ian Thompson"/>
  </entries>

  <!-- InCollection extending Book with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol001"
           title="Chapter on Model Transformation Testing"
           year="2015"
           publisher="Springer"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Helen Clark"/>
    <authors author="Jack Wilson"/>
  </entries>

  <!-- InBook extending Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook001"
           title="Empirical Studies in Model Transformations"
           year="2016"
           publisher="Elsevier"
           chapter="7">
    <authors author="Karen Young"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc001"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd001"
           title="Formal Verification of Model Transformations"
           year="2014"
           school="University of Metamodeling">
    <authors author="Laura Perez"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc001"
           title="Coverage Criteria for ATL Transformations"
           year="2013"
           school="Institute of Software Engineering">
    <authors author="Mark Davis"/>
  </entries>

</BibTeX:BibTeXFile>