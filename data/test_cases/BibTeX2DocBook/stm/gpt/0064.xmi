<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020deep"
           title="Deep Learning for Model Transformations"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="John Smith"/>
    <authors author="Emily Clark"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="doe2018report"
           title="A Survey on ATL Transformations"
           year="2018">
    <authors author="Alice Doe"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="miller2023draft"
           title="Draft: Testing in Model-Driven Engineering"
           note="Under review, do not cite">
    <authors author="Robert Miller"/>
    <authors author="Sophie Turner"/>
    <authors author="Liam Brown"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="atluserguide"
           title="ATL User Guide 4.0"/>
           
  <!-- Proceedings (dated + titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="models2021proc"
           title="Proceedings of the 2021 International Conference on Models"
           year="2021"/>

  <!-- InProceedings inheriting Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="garcia2021incremental"
           title="Incremental Model Transformations in Practice"
           year="2021"
           booktitle="Proceedings of the 2021 International Conference on Models">
    <authors author="Maria Garcia"/>
    <authors author="Thomas Nguyen"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="shortintroMDE"
           year="2019"/>

  <!-- Book with authors, date, title, publisher -->
  <entries xsi:type="BibTeX:Book"
           id="lee2017mdebook"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Kevin Lee"/>
    <authors author="Isabella Rossi"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="rossi2017chapter"
           title="Chapter on Model Transformation Testing"
           year="2017"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Isabella Rossi"/>
  </entries>

  <!-- InBook: Book + chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="lee2017chapter5"
           title="Validation and Verification in MDE"
           year="2017"
           publisher="Springer"
           chapter="5">
    <authors author="Kevin Lee"/>
  </entries>

  <!-- Misc with only mandatory id -->
  <entries xsi:type="BibTeX:Misc"
           id="unclassifiedRef1"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="wang2019phd"
           title="Scalable Model Transformation Frameworks"
           year="2019"
           school="Technical University of Munich">
    <authors author="Li Wang"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="kim2020master"
           title="Empirical Evaluation of ATL Transformations"
           year="2020"
           school="University of Oslo">
    <authors author="Minji Kim"/>
  </entries>

</BibTeX:BibTeXFile>