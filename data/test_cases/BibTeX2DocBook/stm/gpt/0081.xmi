<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article" id="art_survey_2020" title="A Comprehensive Survey on Model Transformations" year="2020" journal="Journal of Model-Driven Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport" id="tr_mde_tools_2019" title="Tool Support for Model-Driven Engineering" year="2019">
    <authors author="Carol White"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub_dsl_notes" title="Notes on Domain-Specific Language Design" note="Draft version, not for distribution">
    <authors author="David Brown"/>
    <authors author="Eve Green"/>
  </entries>

  <!-- Manual (no author, no date, only title) -->
  <entries xsi:type="BibTeX:Manual" id="manual_emf_core" title="EMF Core Framework Reference Manual"/>

  <!-- Proceedings (has title and year, no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc_mde_conf_2021" title="Proceedings of the 2021 Conference on Model-Driven Engineering" year="2021"/>

  <!-- InProceedings with inherited title/year and own booktitle, multiple authors -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc_testing_2021" title="Testing Model Transformations: Challenges and Solutions" year="2021" booktitle="Proceedings of the 2021 Conference on Model-Driven Engineering">
    <authors author="Frank Lee"/>
    <authors author="Grace Kim"/>
  </entries>

  <!-- Booklet (dated, no title or authors) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet_intro_mde" year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book" id="book_mde_principles" title="Principles of Model-Driven Engineering" year="2017" publisher="TechPress">
    <authors author="Helen Clark"/>
    <authors author="Ian Martinez"/>
  </entries>

  <!-- InCollection based on Book, with booktitle and publisher -->
  <entries xsi:type="BibTeX:InCollection" id="incol_chapter_metamodeling" title="Metamodeling Techniques for DSLs" year="2017" publisher="TechPress" booktitle="Principles of Model-Driven Engineering">
    <authors author="Helen Clark"/>
  </entries>

  <!-- InBook chapter with chapter number -->
  <entries xsi:type="BibTeX:InBook" id="inbook_chapter_validation" title="Validation of Model Transformations" year="2017" publisher="TechPress" chapter="7">
    <authors author="Ian Martinez"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc" id="misc_internal_memo"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd_mde_testing" title="Automated Testing of Model Transformations" year="2016" school="University of Software Engineering">
    <authors author="Julia Novak"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis" id="msc_model_validation" title="Model Validation in Large-Scale Systems" year="2015" school="Institute of Computer Science">
    <authors author="Kevin Young"/>
  </entries>

