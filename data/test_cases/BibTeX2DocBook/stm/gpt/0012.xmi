<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2022deep"
           title="Deep Learning Techniques for Model Transformations"
           year="2022"
           journal="Journal of Model Engineering">
    <authors author="John Smith"/>
    <authors author="Alice Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="doe2020mde"
           title="Model-Driven Engineering in Practice"
           year="2020">
    <authors author="Jane Doe"/>
  </entries>

  <!-- Unpublished entry with multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="brownDraft"
           title="Draft Notes on Bidirectional Transformations"
           note="Preliminary version, do not cite.">
    <authors author="Michael Brown"/>
    <authors author="Laura Green"/>
  </entries>

  <!-- Manual without authors or date -->
  <entries xsi:type="BibTeX:Manual"
           id="atlGuide"
           title="ATL User Guide and Reference Manual"/>
           
  <!-- Proceedings with title and year -->
  <entries xsi:type="BibTeX:Proceedings"
           id="models2021"
           title="Proceedings of the 2021 International Conference on Models"
           year="2021"/>

  <!-- InProceedings that is also a Proceedings, with authors and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="lee2021testing"
           title="Testing Model Transformations with Metamorphic Relations"
           year="2021"
           booktitle="MODELS 2021 Main Conference">
    <authors author="Kevin Lee"/>
    <authors author="Sara White"/>
  </entries>

  <!-- Booklet with date only -->
  <entries xsi:type="BibTeX:Booklet"
           id="flyerMDE"
           year="2019"/>

  <!-- Book with authors, date, title, publisher -->
  <entries xsi:type="BibTeX:Book"
           id="gamma1994patterns"
           title="Design Patterns: Elements of Reusable Object-Oriented Software"
           year="1994"
           publisher="Addison-Wesley">
    <authors author="Erich Gamma"/>
    <authors author="Richard Helm"/>
    <authors author="Ralph Johnson"/>
    <authors author="John Vlissides"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="smithChapterMDE"
           title="Advanced Topics in Model-Driven Engineering"
           year="2018"
           publisher="Springer"
           booktitle="Handbook of Software Engineering">
    <authors author="John Smith"/>
  </entries>

  <!-- InBook with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="chap5Verification"
           title="Model Transformation Verification"
           year="2017"
           publisher="Elsevier"
           chapter="5">
    <authors author="Emily Clark"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscResource001"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="garciaPhD"
           title="Scalable Testing Techniques for Model Transformations"
           year="2016"
           school="Technical University of Madrid">
    <authors author="Carlos Garcia"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="kimMSc"
           title="An Empirical Study of ATL Transformation Quality"
           year="2019"
           school="University of Ottawa">
    <authors author="Hannah Kim"/>
  </entries>

</BibTeX:BibTeXFile>