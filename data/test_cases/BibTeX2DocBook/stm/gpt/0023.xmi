<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artMultiAuth2020"
           title="Multi-Paradigm Modeling in Practice"
           year="2020"
           journal="Journal of Software Engineering Methods">
    <authors author="Alice Example"/>
    <authors author="Bob Researcher"/>
    <authors author="Charlie Engineer"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techRep2021"
           title="Runtime Verification of Model Transformations"
           year="2021">
    <authors author="Diana Validator"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraft2019"
           title="Preliminary Results on Bidirectional Transformations"
           note="To appear in the proceedings of MDE Workshop 2019">
    <authors author="Ethan Prototype"/>
    <authors author="Fiona Beta"/>
  </entries>

  <!-- Manual (untimed, no authors) -->
  <entries xsi:type="BibTeX:Manual"
           id="toolManual3rdEd"
           title="User Guide for the Model Transformation Toolkit, Third Edition"/>

  <!-- Proceedings (dated and titled, no authors, no booktitle) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="confProc2022"
           title="Proceedings of the International Conference on Model-Driven Tools"
           year="2022"/>

  <!-- InProceedings inheriting from Proceedings, with booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inProcKeynote2022"
           title="Keynote on Industrial Adoption of MDE"
           year="2022"
           booktitle="Proceedings of the International Conference on Model-Driven Tools">
    <authors author="Grace Keynote"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="promoBooklet2018"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="refBookMDE2017"
           title="Comprehensive Reference on Model-Driven Engineering"
           year="2017"
           publisher="Academic Tech Press">
    <authors author="Henry Architect"/>
    <authors author="Irene Designer"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry, with authors) -->
  <entries xsi:type="BibTeX:InCollection"
           id="chapterInCollection2017"
           title="Chapter on Model Transformation Testing"
           year="2017"
           publisher="Academic Tech Press"
           booktitle="Comprehensive Reference on Model-Driven Engineering">
    <authors author="John Tester"/>
    <authors author="Karen Analyst"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="sectionInBook2017"
           title="Section on Traceability Mechanisms"
           year="2017"
           publisher="Academic Tech Press"
           chapter="7">
    <authors author="Laura Tracer"/>
  </entries>

  <!-- Misc with minimal data -->
  <entries xsi:type="BibTeX:Misc"
           id="miscResource01"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesis2023"
           title="Scalable Testing Techniques for Model Transformations"
           year="2023"
           school="Institute of Advanced Software Systems">
    <authors author="Michael Doctoral"/>
  </entries>

  <!-- MasterThesis with multiple authors (synthetic, but allowed by metamodel) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesis2022"
           title="Evaluating Automation in Model-Driven Engineering Workflows"
           year="2022"
           school="Faculty of Computer Science, Example University">
    <authors author="Nina Graduate"/>
    <authors author="Oscar Collaborator"/>
  </entries>

</BibTeX:BibTeXFile>