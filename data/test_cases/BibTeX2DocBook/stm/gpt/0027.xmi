<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article exercising AuthoredEntry + DatedEntry + TitledEntry with journal -->
  <entries xsi:type="BibTeX:Article"
           id="art_mde_survey"
           year="2019"
           title="A Survey on Model-Driven Engineering Techniques"
           journal="Journal of Software Engineering Research">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport: authored, dated, titled, no extra attributes -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_mde_tools"
           year="2018"
           title="Tooling Support for Model Transformations">
    <authors author="Carol White"/>
  </entries>

  <!-- Unpublished: authored + titled + note (no year) -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_dsl_experiment"
           title="Experimental Results on DSL Adoption"
           note="Draft version, not yet submitted">
    <authors author="David Green"/>
    <authors author="Eve Black"/>
  </entries>

  <!-- Manual: only titled -->
  <entries xsi:type="BibTeX:Manual"
           id="man_atl_reference"
           title="ATL Transformation Language Reference Manual"/>
  
  <!-- Proceedings: dated + titled -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_conf_2020"
           year="2020"
           title="Proceedings of the 5th International Conference on Model-Driven Engineering"/>

  <!-- InProceedings: inherits Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_model_validation"
           year="2020"
           title="Automated Validation of Model Transformations"
           booktitle="Proceedings of the 5th International Conference on Model-Driven Engineering">
    <authors author="Frank Miller"/>
  </entries>

  <!-- Booklet: only dated -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_intro"
           year="2017"/>

  <!-- Book: authored, dated, titled, publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_practices"
           year="2016"
           title="Practical Model-Driven Engineering"
           publisher="TechPress Publishing">
    <authors author="Grace Lee"/>
    <authors author="Henry Clark"/>
  </entries>

  <!-- InCollection: book + booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol_case_study"
           year="2016"
           title="Case Studies in Industrial MDE"
           publisher="TechPress Publishing"
           booktitle="Practical Model-Driven Engineering">
    <authors author="Grace Lee"/>
    <authors author="Ian Turner"/>
  </entries>

  <!-- InBook: book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_formal"
           year="2016"
           title="Formal Foundations of Transformations"
           publisher="TechPress Publishing"
           chapter="4">
    <authors author="Henry Clark"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry (only id) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource"/>

  <!-- PhDThesis: ThesisEntry with school -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_model_transformation"
           year="2015"
           title="Scalable Model Transformation Techniques"
           school="University of Metropolis">
    <authors author="Julia Brown"/>
  </entries>

  <!-- MasterThesis: ThesisEntry with school -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_model_validation"
           year="2014"
           title="Validation Approaches for Model Transformations"
           school="Institute of Software Technology">
    <authors author="Kevin Davis"/>
  </entries>

</BibTeX:BibTeXFile>