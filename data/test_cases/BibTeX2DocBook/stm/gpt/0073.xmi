<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article" id="art_survey_2020" title="A Comprehensive Survey on Model Transformations" year="2020" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport" id="tr_mde_tools_2019" title="Evaluation of MDE Tooling in Industry" year="2019">
    <authors author="Diana Miller"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub_metamodeling_notes" title="Notes on Advanced Metamodeling Techniques" note="Draft version, not for distribution">
    <authors author="Ethan Brown"/>
    <authors author="Fiona Clark"/>
  </entries>

  <!-- Manual (no authors, only title required) -->
  <entries xsi:type="BibTeX:Manual" id="manual_atl_reference" title="ATL Transformation Language Reference Manual"/>

  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc_mde_conf_2021" title="Proceedings of the International Conference on Model-Driven Engineering" year="2021"/>

  <!-- InProceedings: authored, dated (inherited from Proceedings), with booktitle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc_testing_atl_2021"
           title="Systematic Testing of ATL Transformations"
           year="2021"
           booktitle="Proceedings of the International Conference on Model-Driven Engineering">
    <authors author="George Hall"/>
    <authors author="Hannah Lee"/>
  </entries>

  <!-- Booklet (only year required) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet_mde_tutorial_2018" year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book" id="book_mde_principles" title="Principles of Model-Driven Engineering" year="2017" publisher="TechPress Publishing">
    <authors author="Ian Walker"/>
    <authors author="Julia King"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry (chapter in an edited book) -->
  <entries xsi:type="BibTeX:InCollection" id="incollection_model_validation"
           title="Model Validation Techniques"
           year="2017"
           publisher="TechPress Publishing"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Kevin Young"/>
  </entries>

  <!-- InBook: specific chapter in a book -->
  <entries xsi:type="BibTeX:InBook" id="inbook_case_studies_mde"
           title="Industrial Case Studies in MDE"
           year="2017"
           publisher="TechPress Publishing"
           chapter="5">
    <authors author="Laura Perez"/>
    <authors author="Michael Chen"/>
  </entries>

  <!-- Misc with only mandatory id -->
  <entries xsi:type="BibTeX:Misc" id="misc_mde_blog_post"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd_mde_scalability"
           title="Scalability in Model-Driven Engineering"
           year="2016"
           school="University of Technology">
    <authors author="Natalie Rogers"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis" id="master_model_testing"
           title="Testing Strategies for Model Transformations"
           year="2015"
           school="Institute of Software Science">
    <authors author="Oliver Schmidt"/>
  </entries>

</BibTeX:BibTeXFile>