<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_authors_2020"
           title="Multi-author Article on Model Transformations"
           year="2020"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Martinez"/>
  </entries>

  <!-- TechReport single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_mde_2019"
           title="Industrial Adoption of Model-Driven Engineering"
           year="2019">
    <authors author="Diana Evans"/>
  </entries>

  <!-- Unpublished with note and several authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_tool_eval"
           title="Evaluation of a New Model Transformation Tool"
           note="Preprint under review, not yet publicly available.">
    <authors author="Erik Brown"/>
    <authors author="Fiona Green"/>
  </entries>

  <!-- Manual (no author, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_userguide"
           title="User Guide for the Transformation Workbench"/>
  
  <!-- Proceedings (dated + titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_icmt_2021"
           title="Proceedings of the International Conference on Model Transformations"
           year="2021"/>

  <!-- InProceedings that refers to the same proceedings logically (as a separate entry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study"
           title="Case Study on Testing ATL Transformations"
           year="2021"
           booktitle="Proceedings of the International Conference on Model Transformations">
    <authors author="George Hill"/>
    <authors author="Hannah Lee"/>
  </entries>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_textbook"
           title="Foundations of Model-Driven Engineering"
           year="2016"
           publisher="TechPress Publishing">
    <authors author="Ian King"/>
    <authors author="Julia Nelson"/>
  </entries>

  <!-- InCollection: chapter in an edited book, exercises BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_testing"
           title="Testing of Model Transformations"
           year="2016"
           publisher="TechPress Publishing"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Ian King"/>
  </entries>

  <!-- InBook: specific chapter with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_7"
           title="Advanced Topics in Transformation Testing"
           year="2016"
           publisher="TechPress Publishing"
           chapter="7">
    <authors author="Julia Nelson"/>
  </entries>

  <!-- Booklet: dated but otherwise minimal -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_short_intro"
           year="2018"/>

  <!-- Misc entry, only id required -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_website_resource"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_model_validation"
           title="Model Validation Techniques for Complex Systems"
           year="2015"
           school="University of Model Engineering">
    <authors author="Karen O&apos;Connor"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_transformation_prototyping"
           title="Prototyping Approaches for Model Transformations"
           year="2017"
           school="Institute of Software Technology">
    <authors author="Liam Wright"/>
  </entries>

</BibTeX:BibTeXFile>