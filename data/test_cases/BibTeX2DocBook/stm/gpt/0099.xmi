<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- An Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth"
           title="Multi-Agent Systems in Practice"
           year="2019"
           journal="Journal of Autonomous Agents">
    <authors author="Alice Johnson"/>
    <authors author="Bob Smith"/>
    <authors author="Carla Gómez"/>
  </entries>

  <!-- A TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_single"
           title="Runtime Monitoring Framework"
           year="2020">
    <authors author="David Lee"/>
  </entries>

  <!-- An Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft"
           title="Preliminary Results on Model Co-Evolution"
           note="Submitted for review; do not distribute.">
    <authors author="Emma Brown"/>
    <authors author="Frank Müller"/>
  </entries>

  <!-- A Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool"
           title="ToolX User Guide 3.1"/>
           
  <!-- A Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_conf_2021"
           title="Proceedings of the 12th International Conference on Model Transformation"
           year="2021"/>

  <!-- An InProceedings referencing a proceedings-style entry (booktitle separate) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study"
           title="Case Studies in Incremental Transformations"
           year="2021"
           booktitle="ICMT 2021: Proceedings of the 12th International Conference on Model Transformation">
    <authors author="George King"/>
    <authors author="Helen Scott"/>
  </entries>

  <!-- A Booklet (only year) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_short_course"
           year="2018"/>

  <!-- A Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde"
           title="Foundations of Model-Driven Engineering"
           year="2015"
           publisher="TechPress">
    <authors author="Ian Clarke"/>
    <authors author="Julia Novak"/>
  </entries>

  <!-- An InCollection (chapter in an edited book, has booktitle as well) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter"
           title="Testing Model Transformations"
           year="2016"
           publisher="TechPress"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Kevin Wong"/>
    <authors author="Laura Rossi"/>
  </entries>

  <!-- An InBook (chapter number in a book) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_5"
           title="Scalability of Model Transformations"
           year="2017"
           publisher="Springer"
           chapter="5">
    <authors author="Michael Green"/>
  </entries>

  <!-- A Misc entry (minimal, only id) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_website_ref"/>

  <!-- A PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_metamodel"
           title="Metamodel Evolution and Consistency Management"
           year="2014"
           school="University of Metropolis">
    <authors author="Nina Park"/>
  </entries>

  <!-- A MasterThesis with multiple authors impossible; so single author here -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_model_validation"
           title="Validation Techniques for Model Transformations"
           year="2018"
           school="Institute of Software Technology">
    <authors author="Oscar Ruiz"/>
  </entries>

</BibTeX:BibTeXFile>