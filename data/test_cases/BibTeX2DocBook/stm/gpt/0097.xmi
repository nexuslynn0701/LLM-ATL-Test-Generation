<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article entry with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth_2020"
           year="2020"
           title="Collaborative Systems for Distributed Modeling"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_mde_tools_2019"
           year="2019"
           title="Tooling Support for Model Transformations in Practice">
    <authors author="Diana Evans"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_delta_debugging_2023"
           title="Delta Debugging for Model Transformations"
           note="Submitted to International Conference on Model-Driven Engineering">
    <authors author="Ethan Brown"/>
    <authors author="Fiona Green"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_mde_framework"
           title="User Guide for the MDE Framework"/>
           
  <!-- Proceedings with date but no authors -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mbt_symposium_2018"
           year="2018"
           title="Proceedings of the Symposium on Model-Based Testing"/>
           
  <!-- InProceedings inheriting from Proceedings, AuthoredEntry, and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_test_case_gen_2018"
           year="2018"
           title="Automated Test Case Generation for ATL Transformations"
           booktitle="Proceedings of the Symposium on Model-Based Testing">
    <authors author="George Hall"/>
    <authors author="Hanna Keller"/>
  </entries>

  <!-- Booklet with only year (minimal) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mdd_tutorial_2015"
           year="2015"/>

  <!-- Book with authors, year, title, publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_foundations_mde_2012"
           year="2012"
           title="Foundations of Model-Driven Engineering"
           publisher="Springer">
    <authors author="Ian Miller"/>
    <authors author="Julia Novak"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_testing_chapter_2012"
           year="2012"
           title="Testing and Debugging Model Transformations"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Ian Miller"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_case_study_2012"
           year="2012"
           title="Case Studies in Model Transformation Testing"
           publisher="Springer"
           chapter="7">
    <authors author="Julia Novak"/>
    <authors author="Kevin Oliver"/>
  </entries>

  <!-- Misc as a generic entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_internal_report_mde_lab"/>

  <!-- PhDThesis entry -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_traceability_2016"
           year="2016"
           title="Traceability Techniques for Model Transformations"
           school="Technical University of Metropolis">
    <authors author="Laura Perez"/>
  </entries>

  <!-- MasterThesis entry -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_visual_debugger_2021"
           year="2021"
           title="A Visual Debugger for ATL Transformations"
           school="Metropolis Institute of Technology">
    <authors author="Michael Quinn"/>
  </entries>

</BibTeX:BibTeXFile>