<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Simple miscellaneous entry with only an id -->
  <entries xsi:type="BibTeX:Misc" id="miscKey001"/>

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artKey2020"
           title="A Comprehensive Survey on Model Transformation Testing"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="Alice Example"/>
    <authors author="Bob Researcher"/>
    <authors author="Carlos Tester"/>
  </entries>

  <!-- TechReport with several authors -->
  <entries xsi:type="BibTeX:TechReport"
           id="trKey2018"
           title="Industrial Experiences with ATL Transformations"
           year="2018">
    <authors author="Diana Engineer"/>
    <authors author="Eve Architect"/>
  </entries>

  <!-- Unpublished with note and single author -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubNoteX"
           title="Unreleased Notes on Incremental Model Transformations"
           note="Draft, not for distribution">
    <authors author="Frank Unpublished"/>
  </entries>

  <!-- Manual (title only, no authors or year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualToolRef"
           title="User Guide for the MDE Toolchain 4.2"/>

  <!-- Proceedings (has title and year, but no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procConf2022"
           title="Proceedings of the 10th Conference on Model-Driven Engineering"
           year="2022"/>

  <!-- InProceedings that reuses the proceedings-like structure, with its own booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocKey2022"
           title="Evaluating Test Adequacy for ATL Transformations"
           year="2022"
           booktitle="Proceedings of the 10th Conference on Model-Driven Engineering">
    <authors author="Grace Tester"/>
    <authors author="Heidi Analyst"/>
  </entries>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDE101"
           title="Model-Driven Engineering: Foundations and Practice"
           year="2015"
           publisher="TechBooks Publishing">
    <authors author="Ian Author"/>
    <authors author="Julia Coauthor"/>
  </entries>

  <!-- InCollection derived from Book, with booktitle and same authors -->
  <entries xsi:type="BibTeX:InCollection"
           id="inCollChap01"
           title="Testing Techniques for Model Transformations"
           year="2015"
           publisher="TechBooks Publishing"
           booktitle="Model-Driven Engineering: Foundations and Practice">
    <authors author="Ian Author"/>
    <authors author="Julia Coauthor"/>
  </entries>

  <!-- InBook chapter from the same book, with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookChap03"
           title="Advanced Topics in ATL"
           year="2015"
           publisher="TechBooks Publishing"
           chapter="3">
    <authors author="Ian Author"/>
  </entries>

  <!-- Booklet with only a year -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletPromo"
           year="2019"/>

  <!-- PhDThesis with required fields and authors -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisKey"
           title="Automated Testing of Model Transformations"
           year="2017"
           school="University of Model Engineering">
    <authors author="Karen Doctoral"/>
  </entries>

  <!-- MasterThesis with required fields and multiple authors (e.g., joint thesis) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisKey"
           title="Tool Support for Coverage Analysis in ATL"
           year="2019"
           school="Institute of Software Systems">
    <authors author="Leo Student"/>
    <authors author="Mona Student"/>
  </entries>

</BibTeX:BibTeXFile>