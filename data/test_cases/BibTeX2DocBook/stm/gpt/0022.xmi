<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
      id="smith2020deep"
      title="Deep Learning Techniques for Model Transformations"
      year="2020"
      journal="Journal of Model Engineering">
    <authors author="John Smith"/>
    <authors author="Alice Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
      id="lee2019report"
      title="A Survey of Model Transformation Testing"
      year="2019">
    <authors author="Michael Lee"/>
  </entries>

  <!-- Unpublished with two authors -->
  <entries xsi:type="BibTeX:Unpublished"
      id="brown_draft_mde"
      title="Draft Notes on Advanced MDE Patterns"
      note="Draft version, not yet submitted">
    <authors author="Laura Brown"/>
    <authors author="Kevin White"/>
  </entries>

  <!-- Manual (no authors, no date) -->
  <entries xsi:type="BibTeX:Manual"
      id="atl_user_manual"
      title="ATL Transformation Language User Manual"/>
      
  <!-- Proceedings entry -->
  <entries xsi:type="BibTeX:Proceedings"
      id="icmt2021"
      title="Proceedings of the 14th International Conference on Model Transformation"
      year="2021"/>

  <!-- InProceedings linked conceptually to the above proceedings via booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
      id="garcia2021trace"
      title="Traceability Techniques in Model Transformations"
      year="2021"
      booktitle="Proceedings of the 14th International Conference on Model Transformation">
    <authors author="Maria Garcia"/>
    <authors author="Thomas Müller"/>
  </entries>

  <!-- Booklet (dated but untitled, as per metamodel) -->
  <entries xsi:type="BibTeX:Booklet"
      id="short_intro_mde"
      year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
      id="mde_handbook"
      title="Handbook of Model-Driven Engineering"
      year="2017"
      publisher="TechPress Publishing">
    <authors author="Oliver King"/>
    <authors author="Sophie Martin"/>
  </entries>

  <!-- InCollection within the book above, with booktitle referring to the book title -->
  <entries xsi:type="BibTeX:InCollection"
      id="chapter_validation"
      title="Validation and Verification of Model Transformations"
      year="2017"
      publisher="TechPress Publishing"
      booktitle="Handbook of Model-Driven Engineering">
    <authors author="Sophie Martin"/>
  </entries>

  <!-- InBook chapter within the same book -->
  <entries xsi:type="BibTeX:InBook"
      id="chapter_tooling"
      title="Tooling Ecosystems for Model Transformations"
      year="2017"
      publisher="TechPress Publishing"
      chapter="5">
    <authors author="Oliver King"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
      id="misc_resources"/>

  <!-- PhDThesis with one author -->
  <entries xsi:type="BibTeX:PhDThesis"
      id="anderson_phd_2022"
      title="Scalable Testing Techniques for Model Transformations"
      year="2022"
      school="University of Software Engineering">
    <authors author="Peter Anderson"/>
  </entries>

  <!-- MasterThesis with two authors -->
  <entries xsi:type="BibTeX:MasterThesis"
      id="cohen_msc_2020"
      title="Automated Test Data Generation for ATL Transformations"
      year="2020"
      school="Institute of Computer Science">
    <authors author="Rachel Cohen"/>
    <authors author="Daniel Evans"/>
  </entries>

</BibTeX:BibTeXFile>