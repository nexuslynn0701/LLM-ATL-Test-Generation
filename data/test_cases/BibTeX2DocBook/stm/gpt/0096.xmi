<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020deepmodels"
           title="Deep Models for Model Transformations"
           year="2020"
           journal="Journal of Model-Driven Engineering">
    <authors author="John Smith"/>
    <authors author="Emily Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="brown2018report"
           title="Experimental Evaluation of Model Transformation Testing"
           year="2018">
    <authors author="Michael Brown"/>
  </entries>

  <!-- Unpublished entry with three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="lee2021draft"
           title="A Draft on Incremental ATL Transformations"
           note="Working draft, submitted for review">
    <authors author="Sophia Lee"/>
    <authors author="David Kim"/>
    <authors author="Anna Garcia"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="atltoolingmanual"
           title="ATL Tooling User Manual v3.2"/>
           
  <!-- Proceedings (dated and titled but not authored) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmt2019proc"
           title="Proceedings of the 12th International Conference on Model Transformations"
           year="2019"/>

  <!-- InProceedings with own title, booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="miller2019coverage"
           title="Coverage Criteria for Model Transformations"
           year="2019"
           booktitle="Proceedings of the 12th International Conference on Model Transformations">
    <authors author="Laura Miller"/>
    <authors author="Thomas Wagner"/>
  </entries>

  <!-- Booklet (only dated, no title) -->
  <entries xsi:type="BibTeX:Booklet"
           id="shortguide2022"
           year="2022"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="green2020mdetextbook"
           title="Foundations of Model-Driven Engineering"
           year="2020"
           publisher="Springer">
    <authors author="Helen Green"/>
    <authors author="Robert Clark"/>
  </entries>

  <!-- InCollection: chapter within an edited book (inherits Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="clark2020chapter"
           title="Testing Strategies for ATL Transformations"
           year="2020"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Robert Clark"/>
  </entries>

  <!-- InBook: concrete Book with an additional chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="green2020chapter5"
           title="Advanced Topics in Model Transformation"
           year="2020"
           publisher="Springer"
           chapter="5">
    <authors author="Helen Green"/>
  </entries>

  <!-- Misc entry with only id (no additional attributes required) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscRef01"/>

  <!-- PhDThesis with multiple authors is unusual but allowed; we keep one author -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="adams2017phd"
           title="Automated Testing of Model Transformations"
           year="2017"
           school="Tech University of Berlin">
    <authors author="James Adams"/>
  </entries>

  <!-- MasterThesis with two authors (to vary cardinality) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="nguyen2022msc"
           title="Incremental Testing Framework for ATL"
           year="2022"
           school="University of Paris">
    <authors author="Minh Nguyen"/>
    <authors author="Elena Rossi"/>
  </entries>

</BibTeX:BibTeXFile>