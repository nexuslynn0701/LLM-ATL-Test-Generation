    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article" id="art_multi_auth" title="A Comprehensive Study of Model Transformations" year="2018" journal="Journal of Software Engineering Research">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport" id="tr_single_auth" title="Testing Strategies for ATL Transformations" year="2019">
    <authors author="Diana Evans"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub_draft" title="Draft Guidelines for Model-Driven Quality Assurance" note="Draft version circulated internally in the research group.">
    <authors author="Ethan Walker"/>
    <authors author="Fiona Clark"/>
    <authors author="George Brown"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual" id="manual_tool" title="ATL Transformation Tool User Guide v3.2"/>

  <!-- Proceedings (dated + titled) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc_conf2020" title="Proceedings of the International Conference on Model Engineering" year="2020"/>

  <!-- InProceedings with booktitle, authors, and inherited title/year from Proceedings -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc_case_study" title="A Case Study on Regression Testing of Model Transformations" year="2020" booktitle="International Conference on Model Engineering 2020">
    <authors author="Hannah Lee"/>
    <authors author="Ian McDonald"/>
  </entries>

  <!-- Booklet (only dated entry) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet_overview" year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book" id="book_mde_intro" title="Introduction to Model-Driven Engineering" year="2015" publisher="TechPress Publishing">
    <authors author="Jack Nguyen"/>
    <authors author="Karen O&amp;apos;Brien"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection" id="incollection_chapter" title="Automated Testing of Model Transformations" year="2015" publisher="TechPress Publishing" booktitle="Introduction to Model-Driven Engineering: Selected Chapters">
    <authors author="Laura Perez"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook" id="inbook_specific_chapter" title="Practical Techniques for Metamodel Evolution" year="2016" publisher="Springfield Academic Press" chapter="7">
    <authors author="Michael Scott"/>
    <authors author="Nina Kowalski"/>
