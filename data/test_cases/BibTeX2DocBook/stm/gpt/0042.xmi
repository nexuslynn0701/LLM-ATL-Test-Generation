<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art001"
           title="Model-Driven Engineering in Practice"
           year="2018"
           journal="Journal of Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr001"
           title="A Comprehensive Survey of ATL Transformations"
           year="2019">
    <authors author="Carol Williams"/>
  </entries>

  <!-- Unpublished with multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub001"
           title="Towards Verified Model Transformations"
           note="To appear in conference proceedings.">
    <authors author="David Brown"/>
    <authors author="Emma Davis"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="man001"
           title="ATL Language Reference Manual v3.0"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc001"
           title="Proceedings of the International Conference on Model Transformation"
           year="2020"/>

  <!-- InProceedings: authored + proceedings + booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc001"
           title="Testing Strategies for Model Transformations"
           year="2020"
           booktitle="Proceedings of the International Conference on Model Transformation">
    <authors author="Frank Green"/>
    <authors author="Grace Martin"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet001"
           year="2017"/>

  <!-- Book: authored, dated, titled, with publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book001"
           title="Foundations of Model-Driven Engineering"
           year="2015"
           publisher="Springer">
    <authors author="Helen Clark"/>
    <authors author="Ian Lee"/>
  </entries>

  <!-- InCollection: extends Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol001"
           title="Chapter on Model Transformation Testing"
           year="2015"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Helen Clark"/>
  </entries>

  <!-- InBook: extends Book and adds chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook001"
           title="Advanced Topics in MDE"
           year="2016"
           publisher="Academic Press"
           chapter="7">
    <authors author="Jack Turner"/>
    <authors author="Karen Young"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry subclass with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc001"/>

  <!-- PhDThesis: ThesisEntry subclass -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd001"
           title="Scalable Verification of Model Transformations"
           year="2021"
           school="Technical University of Metropolis">
    <authors author="Laura Perez"/>
  </entries>

  <!-- MasterThesis: ThesisEntry subclass with multiple authors (co-supervised work) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc001"
           title="Empirical Evaluation of Transformation Testing Tools"
           year="2022"
           school="Metropolis Institute of Technology">
    <authors author="Michael Ross"/>
    <authors author="Nina Scott"/>
  </entries>

</BibTeX:BibTeXFile>