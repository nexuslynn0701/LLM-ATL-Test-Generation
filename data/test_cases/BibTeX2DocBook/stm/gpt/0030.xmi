<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-key-001"
           title="Model Transformations in Practice"
           year="2012"
           journal="Journal of Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr-key-002"
           title="Verification of Model Transformations"
           year="2015">
    <authors author="Carol White"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-key-003"
           title="Draft Survey on Bidirectional Transformations"
           note="To appear">
    <authors author="David Brown"/>
    <authors author="Eva Green"/>
    <authors author="Frank Black"/>
  </entries>

  <!-- Manual (no authors, has title only) -->
  <entries xsi:type="BibTeX:Manual"
           id="man-key-004"
           title="ATL Transformation Language Reference Manual"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-key-005"
           title="International Conference on Model-Driven Engineering"
           year="2018"/>

  <!-- InProceedings: authored paper in proceedings with booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-key-006"
           title="Testing Strategies for ATL Transformations"
           year="2018"
           booktitle="Proc. Int. Conf. on Model-Driven Engineering">
    <authors author="Grace Hopper"/>
    <authors author="Henry Ford"/>
  </entries>

  <!-- Booklet: only dated -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-key-007"
           year="2010"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book-key-008"
           title="Foundations of Model-Driven Engineering"
           year="2009"
           publisher="Springer">
    <authors author="Ian Malcolm"/>
    <authors author="Julia Roberts"/>
  </entries>

  <!-- InCollection: chapter in an edited book with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol-key-009"
           title="Reusable Transformation Patterns"
           year="2009"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Kevin Lee"/>
  </entries>

  <!-- InBook: chapter in a book with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-key-010"
           title="Case Studies in Model Transformation Testing"
           year="2011"
           publisher="Morgan Kaufmann"
           chapter="7">
    <authors author="Laura King"/>
    <authors author="Michael Young"/>
  </entries>

  <!-- Misc: minimal entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-key-011"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd-key-012"
           title="Scalable Testing of Model Transformations"
           year="2016"
           school="University of Metropolis">
    <authors author="Nina Scott"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc-key-013"
           title="Automated Generation of Test Models"
           year="2014"
           school="Tech University">
    <authors author="Oscar Price"/>
  </entries>

</BibTeX:BibTeXFile>