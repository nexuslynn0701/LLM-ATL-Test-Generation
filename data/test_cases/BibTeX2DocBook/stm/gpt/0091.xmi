<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth_2020"
           title="A Comprehensive Study on Model Transformations"
           year="2020"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_single_2018"
           title="Verification of ATL Transformations Through Testing"
           year="2018">
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft_2019"
           title="Draft Semantics for Bidirectional Transformations"
           note="Under revision for conference submission">
    <authors author="Diana Miller"/>
    <authors author="Ethan Brown"/>
  </entries>

  <!-- Manual without authors -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_2021"
           title="User Guide for the MetaTransform Toolset"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_2017"
           title="Proceedings of the International Conference on MDE"
           year="2017"/>
           
  <!-- InProceedings inheriting from Proceedings, AuthoredEntry, and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study_2017"
           title="Case Studies in Industrial Model Transformation"
           year="2017"
           booktitle="Proceedings of the International Conference on MDE">
    <authors author="Frank Green"/>
    <authors author="Grace Hall"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_intro_2015"
           year="2015"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_fundamentals_2016"
           title="Fundamentals of Model-Driven Software Engineering"
           year="2016"
           publisher="TechPress">
    <authors author="Hannah Lee"/>
    <authors author="Ian Clark"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_2016"
           title="Testing and Debugging of Model Transformations"
           year="2016"
           publisher="TechPress"
           booktitle="Fundamentals of Model-Driven Software Engineering">
    <authors author="Jack Martin"/>
  </entries>

  <!-- InBook with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_5_2016"
           title="Advanced Topics in Transformation Testing"
           year="2016"
           publisher="TechPress"
           chapter="5">
    <authors author="Hannah Lee"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_formal_2014"
           title="Formal Foundations for Model Transformation Testing"
           year="2014"
           school="University of Metropolis">
    <authors author="Karen Nelson"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_empirical_2019"
           title="Empirical Evaluation of Model Transformation Quality"
           year="2019"
           school="City Technical University">
    <authors author="Liam O&apos;Connor"/>
  </entries>

</BibTeX:BibTeXFile>