<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- An Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_smith2020"
           title="A Comprehensive Survey on Model-Driven Engineering"
           year="2020"
           journal="Journal of Software Engineering">
    <authors author="John Smith"/>
    <authors author="Emily Johnson"/>
  </entries>

  <!-- A TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_miller2019"
           title="Industrial Applications of ATL Transformations"
           year="2019">
    <authors author="Robert Miller"/>
  </entries>

  <!-- An Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_lee2021"
           title="Draft Notes on Bidirectional Transformations"
           note="Under review, do not distribute">
    <authors author="Alice Lee"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- A Manual without authors (titled only) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool2022"
           title="ATL Transformation Engine User Guide v3.1"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde2023"
           title="Proceedings of the 15th International Conference on Model-Driven Engineering"
           year="2023"/>

  <!-- InProceedings (inherits proceedings + authored + booktitle) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_khan2023"
           title="Testing Strategies for Model Transformations"
           year="2023"
           booktitle="Proceedings of the 15th International Conference on Model-Driven Engineering">
    <authors author="Sarah Khan"/>
    <authors author="David Brown"/>
  </entries>

  <!-- A Book with authors, date, title, and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mdehandbook2018"
           title="Handbook of Model-Driven Software Engineering"
           year="2018"
           publisher="TechPress Publishing">
    <authors author="Michael Green"/>
    <authors author="Laura White"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol_rossi2018"
           title="Model Transformation Testing in Practice"
           year="2018"
           publisher="TechPress Publishing"
           booktitle="Handbook of Model-Driven Software Engineering">
    <authors author="Francesco Rossi"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_tan2017"
           title="Advanced Topics in Meta-Modeling"
           year="2017"
           publisher="Global Science Press"
           chapter="7">
    <authors author="Jennifer Tan"/>
    <authors author="Oliver Clark"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_intro2016"
           year="2016"/>

  <!-- Misc (minimal, only id required) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_webresource_mdeportal"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_schmidt2015"
           title="Scalable Techniques for Model Transformation Execution"
           year="2015"
           school="University of Metropolis">
    <authors author="Thomas Schmidt"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_nguyen2022"
           title="Evaluation of Testing Approaches for ATL Transformations"
           year="2022"
           school="Institute of Software Technology">
    <authors author="Linh Nguyen"/>
  </entries>

</BibTeX:BibTeXFile>