<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article" id="artMultiAuthors" title="A Comprehensive Study of Model Transformations" year="2018" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carol White"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport" id="techReportSingle" title="Testing Strategies for ATL Transformations" year="2019">
    <authors author="David Brown"/>
  </entries>

  <!-- Unpublished with multiple authors -->
  <entries xsi:type="BibTeX:Unpublished" id="unpubDraft" title="Draft Notes on Incremental Model Synchronization" note="Draft version, not yet submitted">
    <authors author="Eve Miller"/>
    <authors author="Frank Wilson"/>
  </entries>

  <!-- Manual without authors (allowed, since Manual only extends TitledEntry) -->
  <entries xsi:type="BibTeX:Manual" id="toolManual" title="User Guide for the MegaMDE Toolkit"/>

  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="confProceedings" title="Proceedings of the International Conference on Model Engineering" year="2020"/>

  <!-- InProceedings combining proceedings, authors, and booktitle -->
  <entries xsi:type="BibTeX:InProceedings" id="inProcPaper" title="Automated Regression Testing of Model Transformations" year="2020" booktitle="ICME 2020">
    <authors author="Grace Lee"/>
    <authors author="Henry Adams"/>
  </entries>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book" id="mdeTextbook" title="Foundations of Model-Driven Engineering" year="2015" publisher="Springer">
    <authors author="Isabel Clark"/>
    <authors author="Jack Turner"/>
  </entries>

  <!-- InCollection from Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection" id="chapterInCollection" title="Model Transformation Testing in Practice" year="2015" publisher="Springer" booktitle="Foundations of Model-Driven Engineering">
    <authors author="Isabel Clark"/>
    <authors author="Laura King"/>
  </entries>

  <!-- InBook with chapter attribute -->
  <entries xsi:type="BibTeX:InBook" id="inBookChapter" title="Advanced Topics in Model Synchronization" year="2016" publisher="Academic Press" chapter="7">
    <authors author="Michael Green"/>
  </entries>

  <!-- Booklet (dated entry only) -->
  <entries xsi:type="BibTeX:Booklet" id="promoBooklet" year="2021"/>

  <!-- Misc (minimal, only id required) -->
  <entries xsi:type="BibTeX:Misc" id="miscEntry001"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis" id="phdThesisEntry" title="Scalable Techniques for Testing Model Transformations" year="2017" school="University of Metamodeling">
    <authors author="Nina Parker"/>
  </entries>

  <!-- MasterThesis with multiple authors (theoretically unusual but structurally valid) -->
  <entries xsi:type="BibTeX:MasterThesis" id="masterThesisEntry" title="Empirical Evaluation of Model Transformation Tools" year="2014" school="Institute of Software Engineering">
    <authors author="Oscar Rivera"/>
    <authors author="Patricia Young"/>
  </entries>

</BibTeX:BibTeXFile>