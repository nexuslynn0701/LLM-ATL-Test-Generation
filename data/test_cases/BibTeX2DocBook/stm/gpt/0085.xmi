<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplex001"
           title="Model-Driven Engineering for Large-Scale Systems"
           year="2018"
           journal="Journal of Software Engineering">
    <authors author="Alice Martin"/>
    <authors author="Bruno Silva"/>
    <authors author="Carla Nguyen"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="trFormalSpecs01"
           title="Formal Specifications in Practice"
           year="2015">
    <authors author="Daniel Thompson"/>
  </entries>

  <!-- Unpublished with multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraftMDE01"
           title="An Unpublished Draft on MDE Transformations"
           note="Draft under internal review">
    <authors author="Eva Schmidt"/>
    <authors author="Frank O&apos;Connor"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualToolRef01"
           title="Tool Reference Manual for Transformation Suite 3.2"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procConf2020"
           title="Proceedings of the International Conference on Model Transformations"
           year="2020"/>

  <!-- InProceedings extending Proceedings, with authors and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocSessionA01"
           title="Incremental Transformation Testing"
           year="2020"
           booktitle="Session A: Validation and Verification">
    <authors author="Grace Lee"/>
    <authors author="Hiro Tanaka"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletIntroMDE"
           year="2016"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="bookFoundationsMDE"
           title="Foundations of Model-Driven Engineering"
           year="2012"
           publisher="Springer">
    <authors author="Isabel Romero"/>
    <authors author="Juan Perez"/>
  </entries>

  <!-- InCollection: chapter in a book-like collection with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollectionChap05"
           title="Testing of Model Transformations"
           year="2012"
           publisher="Springer"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Karen Young"/>
    <authors author="Liam Brown"/>
  </entries>

  <!-- InBook: chapter with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookChap10"
           title="Case Studies in Transformation Testing"
           year="2013"
           publisher="CRC Press"
           chapter="10">
    <authors author="Maria Rossi"/>
  </entries>

  <!-- Misc: minimal, only required id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscOnlineResource01"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisMDE01"
           title="Scalable Testing Techniques for Model Transformations"
           year="2017"
           school="Technical University of Metropolis">
    <authors author="Nathan Clark"/>
  </entries>

  <!-- MasterThesis with different year and school -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mscThesisMDE02"
           title="Automated Generation of Test Models"
           year="2019"
           school="Metropolis Institute of Technology">
    <authors author="Olivia King"/>
  </entries>

</BibTeX:BibTeXFile>