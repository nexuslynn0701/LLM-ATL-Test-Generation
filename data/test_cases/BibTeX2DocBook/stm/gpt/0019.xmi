<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artMultiAuth2020"
           year="2020"
           title="A Comprehensive Survey on Model Transformations"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techRepMDE2018"
           year="2018"
           title="Industrial Adoption of Model-Driven Engineering: Challenges and Opportunities">
    <authors author="Diana Evans"/>
  </entries>

  <!-- Unpublished entry with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubMDEPatterns"
           title="Pattern-Based Testing of Model Transformations"
           note="Draft version, not yet submitted">
    <authors author="Ethan Ford"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Manual (no authors, only title as per metamodel) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualATLGuide"
           title="ATL Transformation Language Reference Guide"/>
           
  <!-- Proceedings with date and title -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procICMT2019"
           year="2019"
           title="Proceedings of the 12th International Conference on Model Transformation"/>
           
  <!-- InProceedings inheriting from Proceedings, AuthoredEntry, and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inProcTraceability2021"
           year="2021"
           title="Fine-Grained Traceability for ATL Transformations"
           booktitle="ICMT 2021: International Conference on Model Transformation">
    <authors author="Hannah Green"/>
    <authors author="Ian Brown"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletIntroMDE"
           year="2015"/>
           
  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDEPractices2016"
           year="2016"
           title="Model-Driven Engineering in Practice"
           publisher="TechPress Publishing">
    <authors author="Julia King"/>
    <authors author="Liam Scott"/>
  </entries>

  <!-- InCollection: book chapter in an edited book -->
  <entries xsi:type="BibTeX:InCollection"
           id="inCollectionTestingMT2017"
           year="2017"
           title="Testing Techniques for Model Transformations"
           publisher="Software Engineering Monographs"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Maria Rossi"/>
    <authors author="Noah Turner"/>
  </entries>

  <!-- InBook: chapter in a book, with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookChapter5Verification"
           year="2014"
           title="Formal Verification of Model Transformations"
           publisher="Academic Books Ltd."
           chapter="5">
    <authors author="Olivia Perez"/>
  </entries>

  <!-- Misc entry (no extra attributes beyond id) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscMDEBlogPost"/>
           
  <!-- PhDThesis entry -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisRefactoring2013"
           year="2013"
           title="Refactoring Techniques for Model Transformations"
           school="University of Software Engineering">
    <authors author="Peter Watson"/>
  </entries>

  <!-- MasterThesis entry with different values -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisToolSupport2019"
           year="2019"
           title="Tool Support for Testing ATL Transformations"
           school="Institute of Computer Science">
    <authors author="Quinn Adams"/>
  </entries>

</BibTeX:BibTeXFile>