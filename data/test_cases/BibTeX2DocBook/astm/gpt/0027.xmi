<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise all Article_* rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Unique Article Title"
           year="2020"
           journal="Journal Alpha">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- A2 & A3: same title, different journals ->
       first in title group & first in its journal group: Article_Title_Journal
       second in title group but first for its journal: also Article_Title_Journal
       (the transformation’s set-building causes this) -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Article Title"
           year="2021"
           journal="Journal Beta">
    <authors author="Carol White"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Shared Article Title"
           year="2021"
           journal="Journal Gamma">
    <authors author="Carol White"/>
  </entries>

  <!-- A4 & A5: different titles, same journal ->
       A4: first for its title and journal -> Article_Title_Journal
       A5: different title, same journal (journal already in set) -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="First Journal Delta Article"
           year="2019"
           journal="Journal Delta">
    <authors author="David Black"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Second Journal Delta Article"
           year="2022"
           journal="Journal Delta">
    <authors author="Eve Green"/>
  </entries>

  <!-- A6 & A7: same title and same journal ->
       A6: first for that title and journal -> Article_Title_Journal
       A7: later for both title and journal -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Duplicate Title and Journal"
           year="2018"
           journal="Journal Epsilon">
    <authors author="Frank Brown"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Duplicate Title and Journal"
           year="2018"
           journal="Journal Epsilon">
    <authors author="Grace Gray"/>
  </entries>

  <!-- Untitled entries (no TitledEntry supertype) to trigger UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="M1"/>
  <entries xsi:type="BibTeX:Booklet"
           id="BLET1"
           year="2015"/>

  <!-- Non-Article TitledEntries to trigger TitledEntry_*_NoArticle rules -->

  <!-- Unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Unique Book Title"
           year="2010"
           publisher="Publisher One">
    <authors author="Helen Indigo"/>
  </entries>

  <!-- Same title across different non-articles to cause both
       TitledEntry_Title_NoArticle and TitledEntry_NoTitle_NoArticle -->
  <!-- First occurrence of this title (for set) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Repeated NonArticle Title"
           year="2011"
           school="Tech University">
    <authors author="Ian Orange"/>
  </entries>

  <!-- Second with same title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MSC1"
           title="Repeated NonArticle Title"
           year="2012"
           school="Tech University">
    <authors author="Jane Purple"/>
  </entries>

  <!-- Another unique titled non-article -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Unique Technical Report"
           year="2013">
    <authors author="Karl Silver"/>
  </entries>

  <!-- InBook (inherits Book and adds chapter) with unique title ->
       TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="InBook Unique Title"
           year="2014"
           publisher="Publisher Two"
           chapter="3">
    <authors author="Laura Teal"/>
  </entries>

  <!-- Unpublished entry (titled, non-article) with note ->
       TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Working Draft Title"
           note="To appear">
    <authors author="Mark Umber"/>
  </entries>

  <!-- Manual (titled, non-article) unique title ->
       TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual"
           id="MAN1"
           title="Manual of Testing Tools"/>

  <!-- Proceedings and InProceedings to exercise BookTitledEntry, Proceedings, InProceedings -->
  <!-- Proceedings: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings"
           id="PROC1"
           title="Conference on Model Engineering"
           year="2016"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, BookTitledEntry;
       shares same booktitle as its own proceedings title, unique overall ->
       still TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Paper in Model Engineering"
           year="2016"
           booktitle="Conference on Model Engineering">
    <authors author="Nina Violet"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) with unique title ->
       TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Chapter in Collected Volume"
           year="2017"
           publisher="Publisher Three"
           booktitle="Collected Studies on MDE">
    <authors author="Oscar Wine"/>
  </entries>

</BibTeX:BibTeXFile>