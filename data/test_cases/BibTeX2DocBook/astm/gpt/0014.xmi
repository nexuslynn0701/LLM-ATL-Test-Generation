<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise all 4 article rules -->
  <!-- A1 & A2: same title, different journals -> title duplicate, journal unique
       A1 is representative for the title; A2 is duplicate of title -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Common Title" year="2020" journal="Journal A">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" title="Common Title" year="2021" journal="Journal B">
    <authors author="Charlie Gamma"/>
  </entries>

  <!-- A3 & A4: same journal, different titles -> journal duplicate, title unique
       A3 representative for journal; A4 duplicate of journal -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Unique Title 3" year="2018" journal="Journal C">
    <authors author="Alice Alpha"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" title="Unique Title 4" year="2019" journal="Journal C">
    <authors author="David Delta"/>
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- A5 & A6: same title and same journal -> both title and journal duplicates
       A5 is representative for both; A6 is duplicate of title and journal -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Same Title Journal" year="2017" journal="Journal D">
    <authors author="Frank Phi"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" title="Same Title Journal" year="2017" journal="Journal D">
    <authors author="Grace Gamma"/>
  </entries>

  <!-- Titled non-article entries to exercise TitledEntry_Title_NoArticle and TitledEntry_NoTitle_NoArticle -->

  <!-- B1 & B2: Books with same title
       B1 is representative (goes to titledEntrySet); B2 duplicate -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Shared Book Title" year="2010" publisher="Publisher One">
    <authors author="Henry Eta"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="B2" title="Shared Book Title" year="2011" publisher="Publisher Two">
    <authors author="Irene Iota"/>
    <authors author="Jackappa Kappa"/>
  </entries>

  <!-- MT1 & MT2: MasterThesis with same title
       MT1 representative; MT2 duplicate -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Thesis Title Duplicate" year="2012" school="Tech University">
    <authors author="Liam Lambda"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT2" title="Thesis Title Duplicate" year="2013" school="Science College">
    <authors author="Mia Mu"/>
  </entries>

  <!-- PT1: Single PhDThesis with unique title (only entry with this title) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PT1" title="Unique PhD Thesis" year="2014" school="Research Institute">
    <authors author="Noah Nu"/>
    <authors author="Olivia Omicron"/>
  </entries>

  <!-- IP1 & IP2: InProceedings with same title
       IP1 representative; IP2 duplicate -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Conference Paper Title" year="2015" booktitle="Proc. Conf 1">
    <authors author="Paul Pi"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP2" title="Conference Paper Title" year="2016" booktitle="Proc. Conf 2">
    <authors author="Quinn Qoppa"/>
  </entries>

  <!-- IC1: InCollection unique title -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Unique Collection Chapter" year="2009" publisher="Collective Pub">
    <authors author="Rachel Rho"/>
  </entries>

  <!-- INB1 & INB2: InBook with same title
       INB1 representative; INB2 duplicate -->
  <entries xsi:type="BibTeX:InBook" id="INB1" title="Book Chapter Shared" year="2008" publisher="BookHouse" chapter="1">
    <authors author="Sam Sigma"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="INB2" title="Book Chapter Shared" year="2008" publisher="BookHouse" chapter="2">
    <authors author="Tara Tau"/>
  </entries>

  <!-- P1: Proceedings unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" title="Symposium 2020" year="2020">
  </entries>

  <!-- M1: Manual unique title -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="Software User Guide">
  </entries>

  <!-- U1 & U2: Unpublished with same title
       U1 representative; U2 duplicate -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Working Draft" note="To appear">
    <authors author="Uma Upsilon"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Working Draft" note="Under review">
    <authors author="Victor Phi"/>
  </entries>

  <!-- TR1 & TR2: TechReport with same title
       TR1 representative; TR2 duplicate -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Technical Report Series" year="2005">
    <authors author="Wendy Omega"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR2" title="Technical Report Series" year="2006">
    <authors author="Xavier Xi"/>
  </entries>

  <!-- Untitled entries to exercise UntitledEntry rule -->

  <!-- Booklet with date but no title -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="2001">
  </entries>

  <!-- Misc with no additional info -->
  <entries xsi:type="BibTeX:Misc" id="MS1">
  </entries>

</BibTeX:BibTeXFile>