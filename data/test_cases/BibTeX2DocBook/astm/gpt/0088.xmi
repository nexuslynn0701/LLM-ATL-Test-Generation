<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Unique Article One" year="2015" journal="Journal Alpha">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article A2: same title as A3, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Shared Title" year="2016" journal="Journal Beta">
    <authors author="Carol White"/>
  </entries>

  <!-- Article A3: same title as A2, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Shared Title" year="2017" journal="Journal Gamma">
    <authors author="Dave Brown"/>
  </entries>

  <!-- Article A4: unique title, journal shared with A5 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" title="Alpha Studies" year="2018" journal="Journal Delta">
    <authors author="Eve Black"/>
  </entries>

  <!-- Article A5: different title, same journal as A4 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Beta Studies" year="2019" journal="Journal Delta">
    <authors author="Frank Green"/>
  </entries>

  <!-- Article A6: same title and journal as A7 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A6" title="Twinned Article" year="2020" journal="Journal Epsilon">
    <authors author="Grace Hall"/>
  </entries>

  <!-- Article A7: same title and journal as A6 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A7" title="Twinned Article" year="2021" journal="Journal Epsilon">
    <authors author="Ian King"/>
  </entries>

  <!-- Book B1: titled, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Model Engineering Book" year="2010" publisher="TechPress">
    <authors author="Alice Smith"/>
    <authors author="John Doe"/>
  </entries>

  <!-- Book B2: same title as B3, first one kept in title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B2" title="Duplicate Book Title" year="2011" publisher="EduPub">
    <authors author="Carol White"/>
  </entries>

  <!-- Book B3: same title as B2, not in title set -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B3" title="Duplicate Book Title" year="2012" publisher="EduPub">
    <authors author="Dave Brown"/>
  </entries>

  <!-- InBook IB1: titled, unique -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chaptered Insights" year="2013" publisher="ChapterHouse" chapter="3">
    <authors author="Frank Green"/>
  </entries>

  <!-- InCollection IC1: titled, unique -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Collected Works" year="2014" publisher="Collections Ltd." booktitle="Proceedings of MDE 2014">
    <authors author="Grace Hall"/>
  </entries>

  <!-- InProceedings IP1: titled, unique -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Conference Paper One" year="2016" booktitle="Proc. ICSE 2016">
    <authors author="Henry Lee"/>
  </entries>

  <!-- Proceedings P1: titled, unique -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" title="ICSE 2016 Proceedings" year="2016"/>

  <!-- Manual M1: titled, unique -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="User Guide for Tool X"/>

  <!-- TechReport TR1: titled, unique -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Technical Report on MDE" year="2009">
    <authors author="John Doe"/>
  </entries>

  <!-- PhDThesis PHD1: titled, unique -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="PhD on Model Transformations" year="2008" school="University of Metropolis">
    <authors author="Kate Long"/>
  </entries>

  <!-- MasterThesis MT1: titled, unique -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Master Thesis on ATL" year="2007" school="Tech University">
    <authors author="Liam Young"/>
  </entries>

  <!-- Unpublished U1: titled, unique -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Draft on Future Work" note="To appear soon">
    <authors author="Mike North"/>
  </entries>

  <!-- Misc MS1: untitled -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MS1"/>

  <!-- Booklet BL1: dated, untitled -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="2005"/>

</BibTeX:BibTeXFile>