<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: various combinations of duplicate titles/journals -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Unique Article Title"
           year="2020"
           journal="Journal Alpha">
    <authors author="Alice Smith"/>
    <authors author="Bob Brown"/>
  </entries>

  <!-- A2 & A3: same title, same journal -> one Article_Title_Journal, one Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Article Title"
           year="2021"
           journal="Journal Beta">
    <authors author="Carol White"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Shared Article Title"
           year="2022"
           journal="Journal Beta">
    <authors author="David Green"/>
  </entries>

  <!-- A4 & A5: same title, different journals -> one Article_Title_Journal, one Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Cross Journal Study"
           year="2019"
           journal="Journal Gamma">
    <authors author="Eve Black"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Cross Journal Study"
           year="2019"
           journal="Journal Delta">
    <authors author="Frank Orange"/>
    <authors author="Grace Yellow"/>
  </entries>

  <!-- A6 & A7: different titles, same journal -> one Article_Title_Journal, one Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Topic One"
           year="2018"
           journal="Journal Epsilon">
    <authors author="Helen Violet"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Topic Two"
           year="2018"
           journal="Journal Epsilon">
    <authors author="Ian Indigo"/>
  </entries>

  <!-- Non-article titled entries with unique titles -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Model Driven Engineering in Practice"
           year="2015"
           publisher="TechBooks Publishing">
    <authors author="Alice Smith"/>
    <authors author="John Gray"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Analysis of Transformation Testing"
           year="2017"
           school="University of Example">
    <authors author="Karen Blue"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Advanced Topics in MDE"
           year="2016"
           school="Institute of Computing">
    <authors author="Laura Silver"/>
  </entries>

  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Chapter on Model Transformations"
           year="2014"
           publisher="Academic House"
           chapter="3">
    <authors author="Michael Cyan"/>
  </entries>

  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Reusable Transformations"
           year="2013"
           publisher="SpringBook Press"
           booktitle="Collected Papers on Software Engineering">
    <authors author="Nancy Bronze"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Report on Tool Support"
           year="2012"
           school="Tech Research Lab">
    <authors author="Oscar Pink"/>
    <authors author="Paul Maroon"/>
  </entries>

  <entries xsi:type="BibTeX:Manual"
           id="M1"
           title="User Guide for Transformation Tool"
           year="2011">
  </entries>

  <entries xsi:type="BibTeX:Proceedings"
           id="PR1"
           title="Proceedings of the MDE Conference"
           year="2010">
  </entries>

  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Paper on Testing Transformations"
           year="2010"
           booktitle="Proceedings of the MDE Conference">
    <authors author="Quentin Lime"/>
    <authors author="Rachel Teal"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Draft on Metamodel Evolution"
           note="To appear">
    <authors author="Sam Amber"/>
  </entries>

  <!-- Non-article titled entries with duplicate titles -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B2"
           title="Duplicated Title Book"
           year="2009"
           publisher="First Publisher">
    <authors author="Tom Copper"/>
  </entries>

  <entries xsi:type="BibTeX:Book"
           id="B3"
           title="Duplicated Title Book"
           year="2008"
           publisher="Second Publisher">
    <authors author="Uma Coral"/>
  </entries>

  <!-- Untitled entries (not TitledEntry) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="MS1">
  </entries>

  <entries xsi:type="BibTeX:Booklet"
           id="BL1"
