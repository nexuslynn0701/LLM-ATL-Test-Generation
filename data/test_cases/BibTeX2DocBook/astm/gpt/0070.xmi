<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to hit all Article_* rules -->
  <!-- A1 & A2: same title and same journal -> Article_Title_Journal for A1, Article_NoTitle_NoJournal for A2 -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Shared Insights" year="2018" journal="Journal of Testing">
    <authors author="Alice Alpha"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" title="Shared Insights" year="2019" journal="Journal of Testing">
    <authors author="Bob Beta"/>
    <authors author="Carol Gamma"/>
  </entries>

  <!-- A3: same title as A4, different journal -> Article_Title_Journal for A3, Article_NoTitle_Journal for A4 -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Parallel Worlds" year="2017" journal="Software Engineering Notes">
    <authors author="Dave Delta"/>
  </entries>

  <!-- A4 & A5: same journal, but A4 shares title with A3, A5 unique title -->
  <entries xsi:type="BibTeX:Article" id="A4" title="Parallel Worlds" year="2020" journal="Another Journal">
    <authors author="Eve Epsilon"/>
  </entries>
  <!-- A5: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Isolated Study" year="2021" journal="Standalone Journal">
    <authors author="Frank Phi"/>
  </entries>

  <!-- Untitled entries (no TitledEntry) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Booklet" id="BLET1" year="2015"/>

  <!-- Titled non-article entries to cover both TitledEntry_* rules -->
  <!-- Unique titles -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Unique Book Title" year="2010" publisher="Fictional Press">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Mastering Testing" year="2016" school="Test University">
    <authors author="Carol Gamma"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Deep Testing" year="2014" school="Advanced Institute">
    <authors author="Dave Delta"/>
  </entries>
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="Tool Manual" year="2012"/>
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Testing Report" year="2011">
    <authors author="Eve Epsilon"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="PROC1" title="Conference One" year="2013"/>
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Proceedings Paper One" year="2013" booktitle="Conference One">
    <authors author="Frank Phi"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Collection Chapter" year="2009" publisher="Collection House" booktitle="Collected Works">
    <authors author="Alice Alpha"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Book Chapter" year="2008" publisher="Book Publisher" chapter="3">
    <authors author="Bob Beta"/>
  </entries>

  <!-- Duplicate titles for non-articles to trigger TitledEntry_NoTitle_NoArticle -->
  <!-- First occurrence takes the title (Title_NoArticle), second loses it (NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Working Draft" note="Initial version">
    <authors author="Carol Gamma"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Working Draft" note="Revised version">
    <authors author="Dave Delta"/>
  </entries>

</BibTeX:BibTeXFile>