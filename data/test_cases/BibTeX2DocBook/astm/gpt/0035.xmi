<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise all Article* rules and journal/title uniqueness combinations -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Unique Article One" year="2018" journal="Journal Alpha">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A2 & A3: same title, different journals ->
       A2 becomes representative in title-set (Article_Title_Journal),
       A3 excluded from title-set but journal unique (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Shared Insights" year="2019" journal="Journal Beta">
    <authors author="Charlie Brown"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" title="Shared Insights" year="2020" journal="Journal Gamma">
    <authors author="Dana White"/>
  </entries>

  <!-- A4 & A5: different titles, same journal ->
       A4 becomes representative in journal-set (Article_Title_NoJournal),
       A5 same journal but title not selected and journal not unique (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A4" title="Deep Study" year="2021" journal="Journal Delta">
    <authors author="Eve Adams"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" title="Another View" year="2022" journal="Journal Delta">
    <authors author="Frank Miller"/>
  </entries>

  <!-- A6 & A7: same title and same journal ->
       A6 representative for both sets (Article_Title_Journal),
       A7 excluded from both (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A6" title="Twin Study" year="2023" journal="Journal Epsilon">
    <authors author="Grace Hopper"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" title="Twin Study" year="2024" journal="Journal Epsilon">
    <authors author="Heidi Lamar"/>
  </entries>

  <!-- Untitled entries to trigger UntitledEntry (Misc, Booklet) -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Booklet" id="BKT1" year="2017"/>

  <!-- Titled, non-Article entries:
       MT1 & MT2 share same title -> MT1 in title-set (TitledEntry_Title_NoArticle),
       MT2 not in title-set (TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Duplicated Thesis Title" year="2015" school="Tech University">
    <authors author="Ivy Clark"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT2" title="Duplicated Thesis Title" year="2016" school="Tech University">
    <authors author="Jack Lee"/>
  </entries>

  <!-- PT1: unique titled thesis -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PT1" title="Unique Dissertation" year="2014" school="Science Institute">
    <authors author="Karen Davis"/>
  </entries>

  <!-- BK1: unique titled Book -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK1" title="Comprehensive Guide" year="2011" publisher="Global Press">
    <authors author="Laura King"/>
    <authors author="Mike Stone"/>
  </entries>

  <!-- IB1: InBook with extra chapter attribute, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Embedded Chapter" year="2012" publisher="Academic House" chapter="3">
    <authors author="Nina Fox"/>
  </entries>

  <!-- IC1: InCollection, unique title but shares book title with BK1 (does not affect rule) -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Collection Piece" year="2013" publisher="Global Press" booktitle="Comprehensive Guide">
    <authors author="Oscar Reed"/>
  </entries>

  <!-- IP1: InProceedings, unique title and booktitle -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Conference Contribution" year="2020" booktitle="Conf 2020 Proceedings">
    <authors author="Paul Young"/>
  </entries>

  <!-- PR1: Proceedings, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" title="Conf 2020 Proceedings" year="2020"/>

  <!-- MN1: Manual, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MN1" title="Tool User Manual"/>

  <!-- UP1 & UP2: Unpublished with distinct titles and notes;
       both unique titles -> TitledEntry_Title_NoArticle;
       also show note-based formatting and reused authors -->
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Working Draft Alpha" note="Under revision">
    <authors author="Shared Author"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="UP2" title="Working Draft Beta" note="To appear">
    <authors author="Shared Author"/>
  </entries>

  <!-- TR1: TechReport, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Technical Overview" year="2010">
    <authors author="Report Author"/>
  </entries>

  <!-- Extra standalone Author instances (not only those inside entries) to test Author rule and de-duplication -->
  <entries xsi:type="BibTeX:Misc" id="AUTH_HOLDER">
    <authors author="Alice Smith"/>
    <authors author="Standalone Author One"/>
    <authors author="Standalone Author Two"/>
    <authors author="Standalone Author One"/>
  </entries>

</BibTeX:BibTeXFile>