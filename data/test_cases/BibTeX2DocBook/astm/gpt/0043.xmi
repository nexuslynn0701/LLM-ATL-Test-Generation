<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles for all four Article rules (R6–R9) -->
  <!-- A1, A2: same title & same journal -> A1 in Article_Title_Journal, A2 in Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Shared Insights" year="2019" journal="Computing Today">
    <authors author="Alice Author"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" title="Shared Insights" year="2020" journal="Computing Today">
    <authors author="Bob Writer"/>
  </entries>

  <!-- A3, A4: same title, different journals -> A3 in Article_Title_Journal, A4 in Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Parallel Worlds" year="2018" journal="Journal Alpha">
    <authors author="Carol Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" title="Parallel Worlds" year="2018" journal="Journal Beta">
    <authors author="Carol Researcher"/>
  </entries>

  <!-- A5, A6: different titles, same journal -> one in Article_Title_Journal, one in Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Unique Vision" year="2017" journal="Data Science Notes">
    <authors author="Dan Scientist"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" title="Another View" year="2017" journal="Data Science Notes">
    <authors author="Eve Analyst"/>
  </entries>

  <!-- A7: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A7" title="Isolated Study" year="2016" journal="Solo Journal">
    <authors author="Frank Solo"/>
  </entries>

  <!-- Non-Article TitledEntries for R4 and R5 -->
  <!-- T1, T2 share title "Twin Thesis"; T1 kept in unique-title set (R4), T2 excluded (R5) -->
  <entries xsi:type="BibTeX:MasterThesis" id="T1" title="Twin Thesis" year="2015" school="Tech University">
    <authors author="Grace Graduate"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="T2" title="Twin Thesis" year="2016" school="Advanced Institute">
    <authors author="Hank Doctor"/>
  </entries>

  <!-- T3: unique non-article titled entry -> R4 -->
  <entries xsi:type="BibTeX:Book" id="T3" title="Standalone Book" year="2014" publisher="Books &amp; Co.">
    <authors author="Iris Author"/>
  </entries>

  <!-- T4, T5 share title "Conference Volume"; T4 in R4, T5 in R5 -->
  <entries xsi:type="BibTeX:InProceedings" id="T4" title="Conference Volume" year="2013" booktitle="ConfBook 2013">
    <authors author="John Speaker"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="T5" title="Conference Volume" year="2013"/>
  
  <!-- T6: Manual, unique title -> R4 -->
  <entries xsi:type="BibTeX:Manual" id="T6" title="Tool Manual v1.0"/>

  <!-- T7, T8: Unpublished with same title -> T7 in R4, T8 in R5 -->
  <entries xsi:type="BibTeX:Unpublished" id="T7" title="Working Draft" note="Initial version">
    <authors author="Kate Draft"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="T8" title="Working Draft" note="Revised version">
    <authors author="Leo Draft"/>
  </entries>

  <!-- T9: TechReport unique title -> R4 -->
  <entries xsi:type="BibTeX:TechReport" id="T9" title="Tech Report 001" year="2012">
    <authors author="Mia Reporter"/>
  </entries>

  <!-- T10, T11: InBook share title "Chaptered Book" -> T10 in R4, T11 in R5 -->
  <entries xsi:type="BibTeX:InBook" id="T10" title="Chaptered Book" year="2011" publisher="Chapter House" chapter="1">
    <authors author="Nina Chapter"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="T11" title="Chaptered Book" year="2011" publisher="Chapter House" chapter="2">
    <authors author="Nina Chapter"/>
  </entries>

  <!-- Untitled entries for R3 -->
  <entries xsi:type="BibTeX:Misc" id="U1"/>
  <entries xsi:type="BibTeX:Booklet" id="U2" year="2010"/>

</BibTeX:BibTeXFile>