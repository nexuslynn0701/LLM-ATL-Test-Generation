<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: combinations of (unique/duplicate) titles and journals -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Unique Article One" year="2018" journal="Exclusive Journal">
    <authors author="Alice Author"/>
  </entries>

  <!-- A2 & A3: same title, different journals -> A2 Article_Title_Journal, A3 Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Shared Title A" year="2019" journal="Journal Alpha">
    <authors author="Bob Writer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a3" title="Shared Title A" year="2020" journal="Journal Beta">
    <authors author="Bob Writer"/>
    <authors author="Carl Researcher"/>
  </entries>

  <!-- A4 & A5: different titles, same journal -> A4 Article_Title_Journal, A5 Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a4" title="Journal Shared First" year="2017" journal="Common Journal">
    <authors author="Diana Scholar"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a5" title="Journal Shared Second" year="2021" journal="Common Journal">
    <authors author="Evan Scientist"/>
  </entries>

  <!-- A6 & A7: same title and same journal -> A6 Article_Title_Journal, A7 Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a6" title="Twins in Same Journal" year="2015" journal="Twin Journal">
    <authors author="Frank Analyst"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a7" title="Twins in Same Journal" year="2016" journal="Twin Journal">
    <authors author="Grace Engineer"/>
  </entries>

  <!-- Non-article titled entries, with some duplicate titles to split rules R4/R5 -->
  <!-- B1: Book with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="b1" title="Unique Book Title" year="2010" publisher="UniPub Press">
    <authors author="Henry Novelist"/>
  </entries>

  <!-- B2 & B3: Books sharing the same title -> B2 TitledEntry_Title_NoArticle, B3 TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="b2" title="Repeated Book Title" year="2011" publisher="Repeat Press">
    <authors author="Irene Writer"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="b3" title="Repeated Book Title" year="2012" publisher="Repeat Press 2">
    <authors author="Jack Author"/>
    <authors author="Kelly Author"/>
  </entries>

  <!-- INB1 & INB2: InBook with same title -> one in each of R4 and R5 -->
  <entries xsi:type="BibTeX:InBook" id="inb1" title="Chaptered Work" year="2013" publisher="Chapter House" chapter="3">
    <authors author="Liam Chapterist"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="inb2" title="Chaptered Work" year="2014" publisher="Chapter House 2" chapter="5">
    <authors author="Mia Chapterist"/>
  </entries>

  <!-- INCOL1: InCollection with unique title -> R4 -->
  <entries xsi:type="BibTeX:InCollection" id="inc1" title="Collected Insights" year="2009" publisher="Collection Press" booktitle="Insightful Collection">
    <authors author="Nina Curator"/>
  </entries>

  <!-- INPROC1 & INPROC2: InProceedings with same title -> one in R4, one in R5 -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Conference Contribution" year="2016" booktitle="Proceedings of MDEConf" >
    <authors author="Oscar Developer"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="ip2" title="Conference Contribution" year="2017" booktitle="Proceedings of MDEConf" >
    <authors author="Paula Engineer"/>
  </entries>

  <!-- PROC1: Proceedings -> R4 -->
  <entries xsi:type="BibTeX:Proceedings" id="p1" title="Standalone Proceedings" year="2008"/>

  <!-- MAN1 & MAN2: Manual with same title -> one in R4, one in R5 -->
  <entries xsi:type="BibTeX:Manual" id="m1" title="Tool User Guide"/>
  <entries xsi:type="BibTeX:Manual" id="m2" title="Tool User Guide"/>

  <!-- UNP1: Unpublished unique title -> R4 -->
  <entries xsi:type="BibTeX:Unpublished" id="u1" title="Unreleased Draft" note="To appear soon">
    <authors author="Quinn Researcher"/>
  </entries>

  <!-- TR1 & TR2: TechReport with same title -> one in R4, one in R5 -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Technical Note on MDE" year="2019">
    <authors author="Rachel Engineer"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="Technical Note on MDE" year="2020">
    <authors author="Sam Analyst"/>
  </entries>

  <!-- Thesis entries -->
  <!-- PHD1: unique title -> R4 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Topics in Transformation Testing" year="2011" school="Tech University">
    <authors author="Tom Doctoral"/>
  </entries>

  <!-- MAST1 & MAST2: same title -> one in R4, one in R5 -->
  <entries xsi:type="BibTeX:MasterThesis" id="ms1" title="Model Transformation Approaches" year="2012" school="Science University">
    <authors author="Uma Student"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="ms2" title="Model Transformation Approaches" year="2013" school="Engineering College">
    <authors author="Victor Student"/>
  </entries>

  <!-- Untitled entries (no TitledEntry) -> R3 -->
  <!-- MISC1 & MISC2: Misc -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Misc" id="misc2"/>

  <!-- BKL1 & BKL2: Booklet (DatedEntry only) -->
  <entries xsi:type="BibTeX:Booklet" id="bk1" year="2005"/>
  <entries xsi:type="BibTeX:Booklet" id="bk2" year="2006"/>

</BibTeX:BibTeXFile>