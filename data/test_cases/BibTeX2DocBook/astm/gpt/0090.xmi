<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article group A: same title, different journals (tests Article_NoTitle_Journal + Title_NoJournal) -->
  <!-- First article: representative for its title and its journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a_article_main" title="Shared Insights" year="2018" journal="Journal A">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- Second article: same title, different journal -> Article_NoTitle_Journal, Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a_article_dupTitle" title="Shared Insights" year="2019" journal="Journal B">
    <authors author="Charlie Gamma"/>
  </entries>

  <!-- Article group B: distinct title, shared journal (tests Article_Title_NoJournal and journal dedup) -->
  <!-- First article in journal C: representative for its title & journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="b_article_rep" title="Unique Vision" year="2020" journal="Journal C">
    <authors author="Alice Alpha"/>
  </entries>

  <!-- Second article: different title, same journal -> Article_Title_NoJournal, no journal paragraph -->
  <entries xsi:type="BibTeX:Article" id="b_article_sameJournal" title="Another Perspective" year="2021" journal="Journal C">
    <authors author="David Delta"/>
  </entries>

  <!-- Article group C: three articles with same title and same journal (tests all four Article_* combinations) -->
  <!-- 1st: representative for title & journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="c_article_rep" title="Deep Study" year="2015" journal="Journal D">
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- 2nd: same title and same journal, but still representative for titleSet (no other "Deep Study") in set) 
       and non-representative for journalSet -> Article_Title_NoJournal, NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="c_article_sameBoth_1" title="Deep Study" year="2016" journal="Journal D">
    <authors author="Frank Phi"/>
  </entries>

  <!-- 3rd: same title and same journal, non-representative for both title and journal -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="c_article_sameBoth_2" title="Deep Study" year="2017" journal="Journal D">
    <authors author="Grace Gamma"/>
  </entries>

  <!-- Book entries with duplicate title (tests TitledEntry_Title_NoArticle + TitledEntry_NoTitle_NoArticle) -->
  <!-- First book: representative for title & its publisher combination -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book_main" title="Model Engineering Handbook" year="2010" publisher="MegaPress">
    <authors author="Henry Eta"/>
    <authors author="Alice Alpha"/>
  </entries>

  <!-- Second book: same title, different publisher -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book_dupTitle" title="Model Engineering Handbook" year="2012" publisher="OtherPress">
    <authors author="Bob Beta"/>
  </entries>

  <!-- InBook entries, distinct title and chapter to exercise InBook-specific text and unique title behavior -->
  <entries xsi:type="BibTeX:InBook" id="inbook_unique" title="Chaptered Approaches" year="2013" publisher="MegaPress" chapter="3">
    <authors author="Ian Iota"/>
  </entries>

  <!-- InBook with same overall book title but different InBook title and chapter -->
  <entries xsi:type="BibTeX:InBook" id="inbook_sameBookDifferentTitle" title="Advanced Chaptered Approaches" year="2014" publisher="MegaPress" chapter="5">
    <authors author="Ian Iota"/>
    <authors author="David Delta"/>
  </entries>

  <!-- PhDThesis and MasterThesis entries with different titles and schools -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd_main" title="Formal Methods in MDE" year="2011" school="Tech University">
    <authors author="Jane Zeta"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis" id="master_main" title="Practical MDE Patterns" year="2012" school="Tech University">
    <authors author="Karl Kappa"/>
  </entries>

  <!-- TechReport entries with same title (tests TitledEntry_NoTitle_NoArticle in another class) -->
  <!-- First TechReport: representative for title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr_rep" title="Transformation Testing" year="2016">
    <authors author="Laura Lambda"/>
  </entries>

  <!-- Second TechReport: same title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr_dup" title="Transformation Testing" year="2017">
    <authors author="Mike Mu"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- Manual and Proceedings with unique titles -->
  <entries xsi:type="BibTeX:Manual" id="manual_unique" title="MDE Tool User Guide"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc_unique" title="Proceedings of MDEConf" year="2019"/>

  <!-- InProceedings and InCollection with unique titles and booktitles -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc_unique" title="A Paper on MDE" year="2020" booktitle="MDEConf 2020">
    <authors author="Nina Nu"/>
  </entries>

  <entries xsi:type="BibTeX:InCollection" id="incol_unique" title="A Chapter on Testing" year="2018" publisher="CollPress">
    <authors author="Oscar Omicron"/>
  </entries>

  <!-- Unpublished with note, unique title -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub_main" title="Draft on MDE" note="to appear soon">
    <authors author="Peter Pi"/>
  </entries>

  <!-- Misc and Booklet (untitled entries, test UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="misc_entry"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet_entry" year="2009"/>

</BibTeX:BibTeXFile>