<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article group A: same title, same journal (for Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Shared Title A"
           year="2010"
           journal="Common Journal A">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Title A"
           year="2011"
           journal="Common Journal A">
    <authors author="Charlie Gamma"/>
  </entries>

  <!-- Article group B: same title, different journals (for Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Shared Title B"
           year="2012"
           journal="Journal X">
    <authors author="Alice Alpha"/>
  </entries>
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Shared Title B"
           year="2013"
           journal="Journal Y">
    <authors author="David Delta"/>
  </entries>

  <!-- Article group C: different titles, same journal (for Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Unique Title C1"
           year="2014"
           journal="Shared Journal C">
    <authors author="Eve Epsilon"/>
  </entries>
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Unique Title C2"
           year="2015"
           journal="Shared Journal C">
    <authors author="Frank Phi"/>
  </entries>

  <!-- Article group D: unique title and unique journal (for Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Standalone Article D"
           year="2016"
           journal="Solo Journal D">
    <authors author="Bob Beta"/>
    <authors author="Ivy Iota"/>
  </entries>

  <!-- Titled non-article entries with duplicated titles -->
  <!-- Title T1: first occurrence (goes to titledEntrySet, TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Thesis and Book Title T1"
           year="2001"
           publisher="Publisher One">
    <authors author="George Gamma"/>
  </entries>

  <!-- Title T1: second occurrence (same title, TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Thesis and Book Title T1"
           year="2002"
           school="Tech University A">
    <authors author="George Gamma"/>
  </entries>

  <!-- Title T2: first occurrence (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Thesis Title T2"
           year="2003"
           school="Research Institute B">
    <authors author="Helen Eta"/>
  </entries>

  <!-- Title T2: second occurrence (TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Thesis Title T2"
           year="2004"
           publisher="Publisher Two"
           chapter="7">
    <authors author="Helen Eta"/>
  </entries>

  <!-- Titled non-article entries with unique titles (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Collection Chapter Title U1"
           year="2005"
           publisher="Publisher Three">
    <authors author="Ivan Iota"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Conference Paper Title U2"
           year="2006"
           booktitle="Proceedings of MDE'06">
    <authors author="Jackappa"/>
    <authors author="Alice Alpha"/>
  </entries>

  <entries xsi:type="BibTeX:Proceedings"
           id="PR1"
           title="Symposium Proceedings U3"
           year="2007">
  </entries>

  <entries xsi:type="BibTeX:Manual"
           id="M1"
           title="User Manual U4">
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Working Draft U5"
           note="To appear">
    <authors author="David Delta"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Technical Report U6"
           year="2008">
    <authors author="Frank Phi"/>
  </entries>

  <!-- Untitled entries (no TitledEntry) for UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc"
           id="MS1">
  </entries>

  <entries xsi:type="BibTeX:Booklet"
           id="BL1"
           year="1999">
  </entries>

</BibTeX:BibTeXFile>