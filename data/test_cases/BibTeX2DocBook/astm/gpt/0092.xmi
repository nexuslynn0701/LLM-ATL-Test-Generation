<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc entry (untitled, unauthored, undated) -> R3 UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Booklet entry (dated only) -> R3 UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2018"/>

  <!-- Manual (titled, no authors, no date) -> R4 TitledEntry_Title_NoArticle and R3 via se1 listing -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="Tool User Guide"/>

  <!-- Manual with same title as InCollection to exercise duplicate-title logic -->
  <entries xsi:type="BibTeX:Manual" id="manual2" title="Shared Title Publication"/>

  <!-- TechReport (titled, authored, dated) unique title -> R4 -->
  <entries xsi:type="BibTeX:TechReport" id="techrep1" title="Report on Testing" year="2020">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Two Books with same title but different publishers -> one R4, one R5 -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Shared Book Title" year="2015" publisher="Alpha Press">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book2" title="Shared Book Title" year="2016" publisher="Beta Press">
    <authors author="Carol White"/>
    <authors author="David Green"/>
  </entries>

  <!-- InBook, unique title -> R4 -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Chaptered Work" year="2012" publisher="Gamma House" chapter="3">
    <authors author="Eve Black"/>
  </entries>

  <!-- InCollection sharing title with manual2 -> one of them in titledEntrySet, other out -> R4 and R5 -->
  <entries xsi:type="BibTeX:InCollection" id="incollection1" title="Shared Title Publication" year="2019" publisher="Delta Publishers">
    <authors author="Frank Brown"/>
  </entries>

  <!-- InProceedings, unique title, booktitle present -> R4 -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Conference Paper One" year="2021" booktitle="ICSE 2021">
    <authors author="Grace Kelly"/>
    <authors author="Henry Lee"/>
  </entries>

  <!-- Proceedings, unique title -> R4 -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="ICSE 2021 Proceedings" year="2021"/>

  <!-- Unpublished, two entries same title, different note -> R4 and R5 -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft Ideas" note="First version">
    <authors author="Ivy Walker"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Draft Ideas" note="Extended version">
    <authors author="Ivy Walker"/>
    <authors author="Jack Turner"/>
  </entries>

  <!-- PhDThesis and MasterThesis, distinct titles -> both R4 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Model Transformations" year="2017" school="Tech University">
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="msc1" title="Model-Based Testing" year="2016" school="Tech University">
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Articles to exercise R6, R7, R8, R9 -->

  <!-- A1: unique title, unique journal -> R6 Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Unique Article One" year="2010" journal="Journal A">
    <authors author="Carol White"/>
  </entries>

  <!-- A2 & A3: same title, different journals -> one R6, one R7 -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Repeated Title" year="2011" journal="Journal B">
    <authors author="David Green"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art3" title="Repeated Title" year="2012" journal="Journal C">
    <authors author="Eve Black"/>
  </entries>

  <!-- A4 & A5: different titles, same journal -> one R6, one R8 -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Journal Shared One" year="2013" journal="Journal D">
    <authors author="Frank Brown"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art5" title="Journal Shared Two" year="2014" journal="Journal D">
    <authors author="Grace Kelly"/>
  </entries>

  <!-- A6 & A7: same title and same journal -> one R6, one R9 -->
  <entries xsi:type="BibTeX:Article" id="art6" title="Same Both" year="2015" journal="Journal E">
    <authors author="Henry Lee"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art7" title="Same Both" year="2016" journal="Journal E">
    <authors author="Ivy Walker"/>
  </entries>

  <!-- Additional Article with unique title and journal to increase variety -> R6 -->
  <entries xsi:type="BibTeX:Article" id="art8" title="Another Unique Article" year="2017" journal="Journal F">
    <authors author="Jack Turner"/>
    <authors author="Alice Smith"/>
  </entries>

</BibTeX:BibTeXFile>