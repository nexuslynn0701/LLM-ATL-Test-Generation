<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article group A: same title, different journals (Article_NoTitle_Journal + Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Common Title Alpha" year="2018" journal="Journal One">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" title="Common Title Alpha" year="2019" journal="Journal Two">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article group B: different titles, same journal (Article_Title_NoJournal + Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Unique Title Beta" year="2020" journal="Shared Journal">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" title="Unique Title Gamma" year="2021" journal="Shared Journal">
    <authors author="David Black"/>
    <authors author="Eve Green"/>
  </entries>

  <!-- Article group C: same title and same journal (Article_NoTitle_NoJournal + Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Duplicate Title Delta" year="2022" journal="Duplicate Journal">
    <authors author="Frank Gray"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" title="Duplicate Title Delta" year="2023" journal="Duplicate Journal">
    <authors author="Helen Brown"/>
  </entries>

  <!-- Book group D: same title for two books (TitledEntry_Title_NoArticle + TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Shared Book Title" year="2015" publisher="Publisher One">
    <authors author="Ian Orange"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="B2" title="Shared Book Title" year="2016" publisher="Publisher Two">
    <authors author="Jack Purple"/>
    <authors author="Karen Yellow"/>
  </entries>

  <!-- MasterThesis with unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Mastering Model Transformations" year="2017" school="Tech University">
    <authors author="Liam Silver"/>
  </entries>

  <!-- PhDThesis with unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Advanced Topics in MDE" year="2014" school="Science Institute">
    <authors author="Mia Gold"/>
  </entries>

  <!-- InBook entries with same title and different chapters (TitledEntry_Title_NoArticle + TitledEntry_NoTitle_NoArticle)
       Both are also Books via inheritance, including publisher and year -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="InBook Shared Title" year="2013" publisher="BookPub One" chapter="3">
    <authors author="Noah Cyan"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="IB2" title="InBook Shared Title" year="2013" publisher="BookPub Two" chapter="7">
    <authors author="Olivia Magenta"/>
  </entries>

  <!-- InCollection with unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Chapter on Transformations" year="2012" publisher="Collections House" booktitle="Handbook of Software Engineering">
    <authors author="Peter Lime"/>
  </entries>

  <!-- InProceedings with unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Conference Paper on ATL" year="2011" booktitle="Proceedings of MDEConf">
    <authors author="Quinn Navy"/>
    <authors author="Rachel Indigo"/>
  </entries>

  <!-- Proceedings with unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" title="Proceedings of MDEConf" year="2011"/>

  <!-- Manual with unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="ATL User Manual"/>

  <!-- TechReport with unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Report on Model Transformation Testing" year="2010">
    <authors author="Sara Violet"/>
  </entries>

  <!-- Unpublished entries with same title (TitledEntry_Title_NoArticle + TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Draft on Traceability" note="Work in progress">
    <authors author="Tom Red"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Draft on Traceability" note="Second revision">
    <authors author="Uma Coral"/>
  </entries>

  <!-- Booklet and Misc as untitled entries (UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="2009"/>
  <entries xsi:type="BibTeX:Misc" id="MC1"/>

</BibTeX:BibTeXFile>