<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for R3: UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2018"/>

  <!-- TechReports: one unique title, two sharing same title (R4 & R5) -->
  <entries xsi:type="BibTeX:TechReport" id="tr_unique" title="Unique TechReport Title" year="2015">
    <authors author="Alice Unique"/>
  </entries>

  <!-- These two share the same title (so only the first goes into the title set) -->
  <entries xsi:type="BibTeX:TechReport" id="tr_dup1" title="Shared TechReport Title" year="2016">
    <authors author="Bob Tech"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr_dup2" title="Shared TechReport Title" year="2017">
    <authors author="Carol Tech"/>
  </entries>

  <!-- Manual (R4) -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="Tool Manual v1.0"/>

  <!-- Unpublished (R4 & distinct note for formatting) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft Paper" note="to appear">
    <authors author="Dan Draft"/>
    <authors author="Eve Draft"/>
  </entries>

  <!-- MasterThesis and PhDThesis with distinct titles (R4) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="MDE for Testing" year="2013" school="Tech University">
    <authors author="Frank Master"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Model Transformations" year="2012" school="Science Institute">
    <authors author="Grace PhD"/>
  </entries>

  <!-- Book with unique title (R4) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Foundations of MDE" year="2010" publisher="Academic Press">
    <authors author="Henry Author"/>
    <authors author="Ivy Author"/>
  </entries>

  <!-- InBook in that Book (unique title, R4 + InBook-specific chapter) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Chapter on Transformations" year="2011" publisher="Academic Press" chapter="3">
    <authors author="Henry Author"/>
  </entries>

  <!-- InCollection with its own booktitle (R4) -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Case Studies in MDE" year="2014" publisher="Springer" booktitle="MDE Case Studies">
    <authors author="Jack Collection"/>
  </entries>

  <!-- Proceedings (R4) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proceedings of MDEConf" year="2019"/>

  <!-- InProceedings (R4, BookTitledEntry, AuthoredEntry, DatedEntry) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="A Transformation Approach" year="2019" booktitle="Proceedings of MDEConf">
    <authors author="Kate Speaker"/>
    <authors author="Leo Speaker"/>
  </entries>

  <!-- Articles for all four article-specific rules R6–R9 -->

  <!-- R6: Article_Title_Journal (unique title, unique journal) -->
  <entries xsi:type="BibTeX:Article" id="art_unique" title="Unique Article Title" year="2020" journal="Unique Journal">
    <authors author="Mia Unique"/>
  </entries>

  <!-- R7: Article_NoTitle_Journal
       Two articles share the same title but have different journals.
       Only the first with that title is in the title-set; the second triggers R7. -->
  <entries xsi:type="BibTeX:Article" id="art_titledup1" title="Shared Article Title T" year="2021" journal="Journal A">
    <authors author="Nina Title"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art_titledup2" title="Shared Article Title T" year="2022" journal="Journal B">
    <authors author="Oscar Title"/>
  </entries>

  <!-- R8: Article_Title_NoJournal
       Two articles share the same journal but have different titles.
       Only the first with that journal is in the journal-set; the second triggers R8. -->
  <entries xsi:type="BibTeX:Article" id="art_journaldup1" title="Title A" year="2019" journal="Common Journal">
    <authors author="Paul Journal"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art_journaldup2" title="Title B" year="2020" journal="Common Journal">
    <authors author="Quinn Journal"/>
  </entries>

  <!-- R9: Article_NoTitle_NoJournal
       Two articles share the same title AND same journal.
       Only the first is in both title-set and journal-set; the second triggers R9. -->
  <entries xsi:type="BibTeX:Article" id="art_fulldup1" title="Fully Duplicate Title" year="2017" journal="Same Journal">
    <authors author="Rita Dup"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art_fulldup2" title="Fully Duplicate Title" year="2018" journal="Same Journal">
    <authors author="Sam Dup"/>
  </entries>

</BibTeX:BibTeXFile>