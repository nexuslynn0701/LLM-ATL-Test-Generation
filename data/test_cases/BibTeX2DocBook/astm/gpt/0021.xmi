<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles designed to exercise all four Article rules -->

  <!-- A1 + A2: same title, different journals
       - A1 should be in titleSet & journalSet => Article_Title_Journal
       - A2 not in titleSet but in journalSet => Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Shared Title 1"
           year="2018"
           journal="Unique Journal 1">
    <authors author="Author Alpha"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Title 1"
           year="2019"
           journal="Unique Journal 2">
    <authors author="Author Beta"/>
  </entries>

  <!-- A3 + A4: same journal, different titles
       - A3 in titleSet & journalSet => Article_Title_Journal
       - A4 in titleSet but not in journalSet => Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Unique Article Title 2"
           year="2020"
           journal="Shared Journal 1">
    <authors author="Author Gamma"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Unique Article Title 3"
           year="2021"
           journal="Shared Journal 1">
    <authors author="Author Delta"/>
  </entries>

  <!-- A5 + A6: same title and same journal
       - A5 in titleSet & journalSet => Article_Title_Journal
       - A6 not in titleSet & not in journalSet => Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Shared Title 2"
           year="2022"
           journal="Shared Journal 2">
    <authors author="Author Epsilon"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Shared Title 2"
           year="2023"
           journal="Shared Journal 2">
    <authors author="Author Zeta"/>
  </entries>

  <!-- Untitled entries (no TitledEntry supertype) to trigger UntitledEntry -->

  <!-- Misc (no title, date, or author) -->
  <entries xsi:type="BibTeX:Misc"
           id="M1"/>
  <!-- Booklet (dated but no title/author) -->
  <entries xsi:type="BibTeX:Booklet"
           id="B1"
           year="2015"/>

  <!-- Non-article titled entries to exercise both TitledEntry rules -->

  <!-- Title appears once across non-Article titled entries =>
       goes through TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="BK1"
           title="Unique Book Title"
           year="2010"
           publisher="Pub House 1">
    <authors author="Author Alpha"/>
    <authors author="Author Gamma"/>
  </entries>

  <!-- Two non-article entries share the same title =>
       one in titleSet (BK2), one not (BK3) to exercise
       TitledEntry_Title_NoArticle and TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="BK2"
           title="Repeated Title 1"
           year="2011"
           publisher="Pub House 2">
    <authors author="Author Beta"/>
  </entries>

  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Repeated Title 1"
           year="2012"
           publisher="Pub House 3"
           chapter="3">
    <authors author="Author Delta"/>
  </entries>

  <!-- Another unique titled non-article entry -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Unique Thesis Title"
           year="2013"
           school="Tech University">
    <authors author="Author Epsilon"/>
  </entries>

  <!-- Additional titled non-article with title that collides with an Article title
       (still non-Article, so handled by TitledEntry_* rules only) -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Shared Title 2"
           year="2014"
           school="Research Lab 1">
    <authors author="Author Zeta"/>
  </entries>

  <!-- Unpublished, to use 'note' slot and appear in titled entries sets -->
  <entries xsi:type="BibTeX:Unpublished"
           id="UP1"
           title="Working Draft Title"
           note="To appear"
           >
    <authors author="Author Eta"/>
  </entries>

  <!-- Proceedings and InProceedings to cover BookTitledEntry and Proceedings hierarchy -->

  <entries xsi:type="BibTeX:Proceedings"
           id="PR1"
           title="Conference Proceedings 2020"
           year="2020"/>
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Paper in Conference"
           year="2020"
           booktitle="Conference Proceedings 2020">
    <authors author="Author Theta"/>
    <authors author="Author Iota"/>
  </entries>

  <!-- Manual without authors, only title -->
  <entries xsi:type="BibTeX:Manual"
           id="MN1"
           title="Tool User Guide"/>

  <!-- PhDThesis to exercise ThesisEntry + AuthoredEntry + DatedEntry -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Advanced Topics in Testing"
           year="2016"
           school="Science University">
    <authors author="Author Alpha"/>
    <authors author="Author Eta"/>
  </entries>

</BibTeX:BibTeXFile>