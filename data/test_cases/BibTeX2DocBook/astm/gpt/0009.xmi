<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc (untitled, triggers UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="misc01"/>

  <!-- Booklet (untitled, triggers UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2018"/>

  <!-- Manual (titled, no article; unique title -> TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Manual" id="manual01" title="Tool User Guide"/>

  <!-- TechReport (titled, no article; duplicate title with techreport02) -->
  <!-- This one will be in the distinct-title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="techreport01" title="Survey on Modeling"/>

  <!-- Second TechReport with same title (no article; not in distinct-title set) -->
  <!-- -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="techreport02" title="Survey on Modeling"/>

  <!-- PhDThesis (titled, no article; unique title -> TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="Advanced Model Transformations" year="2019" school="Tech University">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- MasterThesis (titled, no article; duplicate title with master02) -->
  <!-- This one will be in the distinct-title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="master01" title="Model-Driven Testing" year="2020" school="City University">
    <authors author="Carol White"/>
  </entries>

  <!-- Second MasterThesis with same title (no article; not in distinct-title set) -->
  <!-- -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="master02" title="Model-Driven Testing" year="2021" school="City University">
    <authors author="Dan Brown"/>
  </entries>

  <!-- Book (titled, no article; unique title -> TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Book" id="book01" title="Foundations of MDE" year="2015" publisher="Global Press">
    <authors author="Eva Green"/>
    <authors author="Frank Black"/>
  </entries>

  <!-- InBook (titled, no article; unique title -> TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Model Transformations" year="2016" publisher="Academic House" chapter="3">
    <authors author="George King"/>
  </entries>

  <!-- Book used as container type for InCollection (inherits Book, is titled) -->
  <!-- Title duplicated with incollection01 so one will be distinct, other not -->
  <entries xsi:type="BibTeX:InCollection" id="incollection01" title="Patterns in MDE" year="2017" publisher="Scholarly Press" booktitle="Advances in Software Engineering">
    <authors author="Hannah Lee"/>
  </entries>

  <!-- InCollection with same title (no article; not in distinct-title set) -->
  <!-- -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="incollection02" title="Patterns in MDE" year="2018" publisher="Scholarly Press" booktitle="New Trends in Software">
    <authors author="Ian Clark"/>
  </entries>

  <!-- Proceedings (titled, no article; unique title -> TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Proceedings of the MDE Conference" year="2014"/>

  <!-- InProceedings (titled, no article; unique title -> TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="A Case Study in MDE" year="2014" booktitle="Proceedings of the MDE Conference">
    <authors author="Jack Miller"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Unpublished (titled, no article; unique title -> TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Guidelines for Transformations" note="To appear">
    <authors author="Karen Davis"/>
  </entries>

  <!-- TechReport with different title (unique -> TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport" id="techreport03" title="Evaluation of Transformation Tools">
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article group A: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art01" title="Single-Model Approach" year="2010" journal="Journal A">
    <authors author="Alice Smith"/>
    <authors author="Michael Stone"/>
  </entries>

  <!-- Article group B: duplicate title, same journal -> Article_NoTitle_NoJournal for second -->
  <!-- First occurrence: distinct title set & distinct journal set -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art02" title="Model Merging Techniques" year="2011" journal="Journal B">
    <authors author="Carol White"/>
  </entries>

  <!-- Second with same title and same journal -> not in distinct-title set, not in distinct-journal set -->
  <!-- -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art03" title="Model Merging Techniques" year="2012" journal="Journal B">
    <authors author="Dan Brown"/>
  </entries>

  <!-- Article group C: duplicate title, different journals -->
  <!-- First: distinct title & distinct journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art04" title="Transformation Languages" year="2013" journal="Journal C">
    <authors author="Eva Green"/>
  </entries>

  <!-- Second: same title (not in distinct-title set) but different journal with unique name -->
  <!-- journal 'Journal D' will also appear in art05 to create a duplicate-journal scenario -->
  <!-- For this one, title not distinct, journal will become distinct or not depending on later entries -->
  <!-- We design so Journal D is reused by art05, thus for art05 journal is non-distinct -->
  <!-- For art04: distinct title and journal, for art05: distinct title but non-distinct journal -->
  <entries xsi:type="BibTeX:Article" id="art05" title="Analysis of MDE Tools" year="2014" journal="Journal D">
    <authors author="Frank Black"/>
  </entries>

  <!-- Another article in Journal D with different title -->
  <!-- Title distinct, journal not distinct -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art06" title="Case Studies in MDE" year="2015" journal="Journal D">
    <authors author="George King"/>
  </entries>

</BibTeX:BibTeXFile>