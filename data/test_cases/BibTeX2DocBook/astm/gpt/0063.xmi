<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Misc" id="miscAlpha"/>
  <entries xsi:type="BibTeX:Booklet" id="bookletBeta" year="2018"/>

  <!-- Articles to cover all Article_* combinations -->

  <!-- Unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="artTJ1" title="Unique Title A" year="2020" journal="Journal X">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Same title as artNTJ1 but different journal -> participates in title-duplicate set -->
  <entries xsi:type="BibTeX:Article" id="artNTJ1" title="Shared Title B" year="2019" journal="Journal Y">
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- Duplicate title with artNTJ1, unique journal overall set -> Article_NoTitle_Journal for this or the other -->
  <entries xsi:type="BibTeX:Article" id="artNTJ2" title="Shared Title B" year="2021" journal="Journal Z">
    <authors author="Diana Green"/>
  </entries>

  <!-- Same journal as artTNJ1 but unique title overall -> Article_Title_NoJournal for one of them -->
  <entries xsi:type="BibTeX:Article" id="artTNJ1" title="Unique Title C" year="2022" journal="Journal W">
    <authors author="Evan Black"/>
  </entries>

  <!-- Duplicate journal with artTNJ1, unique title overall -> Article_Title_NoJournal for this or the other -->
  <entries xsi:type="BibTeX:Article" id="artTNJ2" title="Unique Title D" year="2017" journal="Journal W">
    <authors author="Fiona White"/>
  </entries>

  <!-- Same title and same journal as artNTNJ2 -> Article_NoTitle_NoJournal for one of them -->
  <entries xsi:type="BibTeX:Article" id="artNTNJ1" title="Repeated Title E" year="2015" journal="Journal V">
    <authors author="George King"/>
  </entries>

  <!-- Exact duplicate (title & journal) pair with artNTNJ1 -> Article_NoTitle_NoJournal for this or the other -->
  <entries xsi:type="BibTeX:Article" id="artNTNJ2" title="Repeated Title E" year="2016" journal="Journal V">
    <authors author="Hannah Lee"/>
  </entries>

  <!-- Non-article titled entries to exercise TitledEntry rules -->

  <!-- Unique titled non-article entries -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Model Engineering Handbook" year="2014" publisher="TechPress">
    <authors author="Ian Brown"/>
    <authors author="Jane Miller"/>
  </entries>

  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Advanced MDE" year="2013" publisher="Springer" chapter="3">
    <authors author="Kevin Clark"/>
  </entries>

  <entries xsi:type="BibTeX:Manual" id="manual1" title="ATL User Guide"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="ECMFA 2019" year="2019"/>
  <entries xsi:type="BibTeX:TechReport" id="techrep1" title="MDE State of the Art" year="2012">
    <authors author="Laura Scott"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Scalable Model Transformations" year="2011" school="University A">
    <authors author="Michael Young"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis" id="master1" title="Testing Transformations" year="2010" school="University B">
    <authors author="Nina Perez"/>
  </entries>

  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Aspect-Oriented MDE" year="2016" publisher="Oxford Press">
    <authors author="Oliver Reed"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="DSLs in Practice" year="2018" booktitle="MODELS 2018">
    <authors author="Paula Adams"/>
    <authors author="Quentin Fox"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Experimental MDE Framework" note="Draft version">
    <authors author="Rachel Stone"/>
  </entries>

  <!-- Duplicate title across non-articles to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book2" title="Shared NonArticle Title" year="2009" publisher="OldPub">
    <authors author="Sam Turner"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport" id="techrep2" title="Shared NonArticle Title" year="2008">
    <authors author="Uma Walker"/>
  </entries>

</BibTeX:BibTeXFile>