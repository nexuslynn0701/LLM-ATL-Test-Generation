<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc (untitled, triggers UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Booklet (untitled, triggers UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2018"/>

  <!-- Manual (titled, non-article, unique title -> TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="Guide to BibTeX"/>

  <!-- TechReport (titled, non-article, first of duplicate title -> TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport" id="tech1" title="Shared Tech Title">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
    <authors author="Alice Author"/>
    <authors author="Charles Researcher"/>
  </entries>

  <!-- TechReport (titled, non-article, duplicate title -> TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport" id="tech2" title="Shared Tech Title">
    <authors author="Diana Developer"/>
  </entries>

  <!-- PhDThesis (titled, non-article, unique title -> TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="A Novel PhD Thesis" year="2019" school="Tech University">
    <authors author="Edward Scholar"/>
  </entries>

  <!-- MasterThesis (titled, non-article, unique title -> TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:MasterThesis" id="msc1" title="Mastering Model Transformations" year="2020" school="Science University">
    <authors author="Fiona Student"/>
    <authors author="George Mentor"/>
  </entries>

  <!-- Proceedings (titled, non-article, unique title -> TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proceedings of MDE 2021" year="2021"/>

  <!-- InProceedings (titled, non-article, unique title, also BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Model Transformations in Practice" year="2021" booktitle="Proceedings of MDE 2021">
    <authors author="Henry Engineer"/>
    <authors author="Ivy Architect"/>
  </entries>

  <!-- Book (titled, non-article, unique title) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Foundations of MDE" year="2015" publisher="Springer">
    <authors author="John Editor"/>
  </entries>

  <!-- InCollection (titled, non-article, unique title, also BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Chapter on ATL" year="2015" publisher="Springer" booktitle="Foundations of MDE">
    <authors author="Kate Contributor"/>
  </entries>

  <!-- InBook (titled, non-article, unique title, also ThesisEntry/Book special handling) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Advanced ATL Usage" year="2016" publisher="TechPress" chapter="7">
    <authors author="Laura Expert"/>
    <authors author="Mark Specialist"/>
  </entries>

  <!-- Unpublished (titled, non-article, unique title) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Unreleased MDE Tutorial" note="Draft version">
    <authors author="Nina DraftWriter"/>
  </entries>

  <!-- Article A (unique title, unique journal -> Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="artA1" title="Unique Article One" year="2010" journal="Journal A">
    <authors author="Oscar Author"/>
  </entries>

  <!-- Article B1 (duplicate title, unique journal -> Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="artB1" title="Shared Article Title" year="2011" journal="Journal B">
    <authors author="Peter Researcher"/>
  </entries>

  <!-- Article B2 (first with title C in journal J, unique title & journal -> Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="artC1" title="Article Title C" year="2012" journal="Journal C">
    <authors author="Quentin Scientist"/>
  </entries>

  <!-- Article B3 (duplicate title with B1, unique journal -> Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="artB2" title="Shared Article Title" year="2013" journal="Journal D">
    <authors author="Rachel Analyst"/>
  </entries>

  <!-- Article C2 (duplicate journal with C1, unique title -> Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="artC2" title="Another Title in Journal C" year="2014" journal="Journal C">
    <authors author="Samuel Theorist"/>
  </entries>

  <!-- Article D1 (first with title D in journal E, unique title & journal -> Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="artD1" title="Repeated Title and Journal" year="2015" journal="Journal E">
    <authors author="Thomas Tester"/>
  </entries>

  <!-- Article D2 (duplicate title & journal with D1 -> Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="artD2" title="Repeated Title and Journal" year="2016" journal="Journal E">
    <authors author="Uma Evaluator"/>
  </entries>

</BibTeX:BibTeXFile>