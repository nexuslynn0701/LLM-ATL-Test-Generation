<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries to trigger R3 (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="miscAlpha"/>
  <entries xsi:type="BibTeX:Booklet" id="bookletBeta" year="2012"/>

  <!-- Titled, non-Article entries with unique titles to trigger R4 (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport" id="tr01" title="Unique TechReport Title" year="2017">
    <authors author="Alice Report"/>
    <authors author="Bob Report"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis" id="mt01" title="Unique Master Thesis Title" year="2015" school="Tech University">
    <authors author="Charlie Student"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="Unique PhD Thesis Title" year="2014" school="Science Institute">
    <authors author="Dana Researcher"/>
  </entries>

  <entries xsi:type="BibTeX:Book" id="book01" title="Unique Book Title" year="2010" publisher="Global Press">
    <authors author="Eve Writer"/>
    <authors author="Frank Writer"/>
  </entries>

  <entries xsi:type="BibTeX:InBook" id="inbook01" title="Unique InBook Title" year="2011" publisher="Chapter House" chapter="3">
    <authors author="Greg Chapter"/>
  </entries>

  <entries xsi:type="BibTeX:InCollection" id="incollection01" title="Unique InCollection Title" year="2013" publisher="Collection Press" booktitle="Collected Works A">
    <authors author="Hannah Collector"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Unique InProceedings Title" year="2018" booktitle="Conference A">
    <authors author="Ian Speaker"/>
  </entries>

  <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Unique Proceedings Title" year="2018"/>
  <entries xsi:type="BibTeX:Manual" id="manual01" title="Unique Manual Title"/>
  <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Unique Unpublished Title" note="In preparation">
    <authors author="Julia Unpublished"/>
  </entries>

  <!-- Titled, non-Article entries with duplicate titles to trigger R5 (TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport" id="tr02" title="Shared TechReport Title" year="2019">
    <authors author="Karl Report"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport" id="tr03" title="Shared TechReport Title" year="2020">
    <authors author="Laura Report"/>
  </entries>

  <!-- Articles for all combinations of title/journal uniqueness to trigger R6–R9 -->

  <!-- Unique title, unique journal: R6 (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art01" title="Unique Article A" year="2021" journal="Journal A">
    <authors author="Mona Author"/>
    <authors author="Ned Author"/>
  </entries>

  <!-- Duplicate title, unique journal: R7 (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art02" title="Duplicated Title 1" year="2020" journal="Journal B">
    <authors author="Olivia Author"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art03" title="Duplicated Title 1" year="2022" journal="Journal C">
    <authors author="Peter Author"/>
  </entries>

  <!-- Unique title, duplicate journal: R8 (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art04" title="Article in Shared Journal 1" year="2019" journal="Shared Journal">
    <authors author="Quinn Author"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art05" title="Article in Shared Journal 2" year="2019" journal="Shared Journal">
    <authors author="Rita Author"/>
  </entries>

  <!-- Duplicate title and duplicate journal: R9 (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art06" title="Same Title Same Journal" year="2018" journal="Joint Journal">
    <authors author="Sam Author"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art07" title="Same Title Same Journal" year="2018" journal="Joint Journal">
    <authors author="Tara Author"/>
  </entries>

</BibTeX:BibTeXFile>