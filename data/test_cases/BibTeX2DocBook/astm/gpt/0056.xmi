<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: A1 & A2 share title and journal (trigger Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Shared Article Title"
           year="2018"
           journal="International Journal of Testing">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Article Title"
           year="2019"
           journal="International Journal of Testing">
    <authors author="Charlie Brown"/>
  </entries>

  <!-- Article A3: unique title and unique journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Unique Article on MDE"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Articles A4 & A5: same title, different journals (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Variant Article Title"
           year="2021"
           journal="Software Practice Journal">
    <authors author="David Clark"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Variant Article Title"
           year="2022"
           journal="Systems Engineering Review">
    <authors author="Eve Miller"/>
  </entries>

  <!-- Articles A6 & A7: different titles, same journal (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="First Article in Same Journal"
           year="2017"
           journal="Common Journal of Experiments">
    <authors author="Frank Harris"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Second Article in Same Journal"
           year="2016"
           journal="Common Journal of Experiments">
    <authors author="Grace Lee"/>
  </entries>

  <!-- TechReport: TR1 unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="TechReport Unique Title"
           year="2015">
    <authors author="Hank Green"/>
  </entries>

  <!-- TechReports TR2 & TR3: same title (TitledEntry_Title_NoArticle + TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR2"
           title="Repeated TechReport Title"
           year="2014">
    <authors author="Iris Novak"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport"
           id="TR3"
           title="Repeated TechReport Title"
           year="2013">
    <authors author="Jack Black"/>
  </entries>

  <!-- Book B1: unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Distinct Book Title"
           year="2012"
           publisher="Academic Press">
    <authors author="Karen White"/>
    <authors author="Liam Young"/>
  </entries>

  <!-- InBook IB1 & IB2: same title and same journal-like context not needed (TitledEntry_* for non-Article) -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="InBook Shared Title"
           year="2011"
           publisher="Reference House"
           chapter="3">
    <authors author="Michael Stone"/>
  </entries>

  <entries xsi:type="BibTeX:InBook"
           id="IB2"
           title="InBook Shared Title"
           year="2010"
           publisher="Reference House"
           chapter="5">
    <authors author="Nina Cole"/>
  </entries>

  <!-- Misc M1: untitled entry (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc"
           id="M1"/>

  <!-- Booklet BL1: untitled dated entry (UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet"
           id="BL1"
           year="2009"/>

  <!-- PhDThesis PHD1: unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Unique PhD Thesis Title"
           year="2008"
           school="Tech University">
    <authors author="Olivia Perez"/>
  </entries>

  <!-- MasterThesis MT1 & MT2: same title (TitledEntry_Title_NoArticle + TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Shared Thesis Title"
           year="2007"
           school="State University">
    <authors author="Paul Rivera"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis"
           id="MT2"
           title="Shared Thesis Title"
           year="2006"
           school="City University">
    <authors author="Quinn Foster"/>
  </entries>

  <!-- Manual MAN1: unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Manual"
           id="MAN1"
           title="User Manual for Tool X"/>

  <!-- Unpublished U1 & U2: same title (TitledEntry_Title_NoArticle + TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Working Draft on Transformation"
           note="To appear in conference proceedings">
    <authors author="Rachel Adams"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="U2"
           title="Working Draft on Transformation"
           note="Superseded by later version">
    <authors author="Sam Turner"/>
  </entries>

  <!-- Proceedings P1: unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="P1"
           title="Proceedings of the MDE Symposium"
           year="2005"/>

  <!-- InProceedings IP1: booktitled and titled (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Paper in Proceedings"
           year="2004"
           booktitle="Proceedings of the MDE Symposium">
    <authors author="Tom Walker"/>
  </entries>

</BibTeX:BibTeXFile>