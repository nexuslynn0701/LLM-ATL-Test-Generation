<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: create situations for Article_Title_Journal, Article_NoTitle_Journal,
       Article_Title_NoJournal, Article_NoTitle_NoJournal -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Foundations of Model-Driven Engineering"
           year="2010"
           journal="Journal of Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Miller"/>
  </entries>

  <!-- A2 + A3: same title, different journals
       A2 kept in title-set and journal-set -> Article_Title_Journal
       A3 not in title-set, but in journal-set -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="A Case Study in ATL Transformations"
           year="2012"
           journal="Transactions on Modeling">
    <authors author="Carol Jones"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="A Case Study in ATL Transformations"
           year="2013"
           journal="International Journal of Modeling">
    <authors author="David Brown"/>
  </entries>

  <!-- A4 + A5: different titles, same journal
       A4 kept in title-set and journal-set -> Article_Title_Journal
       A5 kept in title-set, but not in journal-set -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Testing Model Transformations"
           year="2014"
           journal="Journal of Empirical Studies">
    <authors author="Eve Clark"/>
    <authors author="Frank Harris"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Coverage Criteria for ATL"
           year="2015"
           journal="Journal of Empirical Studies">
    <authors author="Grace Lee"/>
  </entries>

  <!-- A6 + A7: same title and same journal
       A6 kept in title-set and journal-set -> Article_Title_Journal
       A7 not in either set -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Reusable Transformation Test Suites"
           year="2016"
           journal="Software Testing Letters">
    <authors author="Helen King"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Reusable Transformation Test Suites"
           year="2017"
           journal="Software Testing Letters">
    <authors author="Ian Walker"/>
  </entries>

  <!-- Non-article titled entries to drive TitledEntry_* rules -->

  <!-- B1: Book, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Model Transformations in Practice"
           year="2008"
           publisher="Springer">
    <authors author="John Doe"/>
    <authors author="Jane Roe"/>
  </entries>

  <!-- B2 & B3: same title (TechReport + MasterThesis) -->
  <!-- B2 kept in title-set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="B2"
           title="Industrial Adoption of MDE"
           year="2009">
    <authors author="Karl Newman"/>
  </entries>

  <!-- B3 not in title-set -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="B3"
           title="Industrial Adoption of MDE"
           year="2011"
           school="Tech University">
    <authors author="Laura Green"/>
  </entries>

  <!-- B4: InBook, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook"
           id="B4"
           title="Advanced Topics in Model Testing"
           year="2013"
           publisher="Academic Press"
           chapter="5">
    <authors author="Michael Scott"/>
  </entries>

  <!-- B5 & B6: same title (PhDThesis + Book) -->
  <!-- B5 kept in title-set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="B5"
           title="Scalability of Model Transformations"
           year="2014"
           school="Engineering Institute">
    <authors author="Nina Adams"/>
  </entries>

  <!-- B6 not in title-set -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B6"
           title="Scalability of Model Transformations"
           year="2015"
           publisher="TechBooks">
    <authors author="Oscar Perry"/>
  </entries>

  <!-- B7: Manual, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual"
           id="B7"
           title="ATL Developer Guide">
  </entries>

  <!-- B8 & B9: Proceedings + InProceedings with same title -->
  <!-- B8 kept in title-set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings"
           id="B8"
           title="Proceedings of the MDE Conference"
           year="2018">
  </entries>

  <!-- B9 not in title-set -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="B9"
           title="Proceedings of the MDE Conference"
           year="2018"
           booktitle="MDE Conference 2018">
    <authors author="Paul Quinn"/>
  </entries>

  <!-- B10: Unpublished, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="B10"
           title="Draft on Transformation Oracles"
           note="To appear in 2026">
    <authors author="Rachel Stone"/>
  </entries>

  <!-- Untitled entries to trigger UntitledEntry (Misc + Booklet) -->

  <!-- U1: Misc (no title) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="U1">
  </entries>

  <!-- U2: Booklet (no title) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet"
           id="U2"
           year="2007">
  </entries>

</BibTeX:BibTeXFile>