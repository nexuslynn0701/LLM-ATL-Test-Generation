<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Graph Transformations in Practice" year="2015" journal="Software Engineering Journal">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article A2 & A3: same title, same journal -> Article_NoTitle_NoJournal for A3 -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Model-Driven Testing" year="2016" journal="Journal of MDE">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" title="Model-Driven Testing" year="2017" journal="Journal of MDE">
    <authors author="David Brown"/>
  </entries>

  <!-- Article A4 & A5: unique titles, same journal -> Article_Title_NoJournal for A5 -->
  <entries xsi:type="BibTeX:Article" id="A4" title="ATL Transformation Patterns" year="2012" journal="Transformation Systems Quarterly">
    <authors author="Eve Black"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" title="Testing Model Transformations" year="2013" journal="Transformation Systems Quarterly">
    <authors author="Frank Green"/>
  </entries>

  <!-- Article A6 & A7: same title, different journals -> Article_NoTitle_Journal for A7 -->
  <entries xsi:type="BibTeX:Article" id="A6" title="Incremental Model Transformations" year="2018" journal="Journal of Modeling">
    <authors author="Grace Lee"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" title="Incremental Model Transformations" year="2019" journal="Systems and Software Letters">
    <authors author="Grace Lee"/>
    <authors author="Henry King"/>
  </entries>

  <!-- TechReport TR1 & TR2: same title -> Title_NoArticle (TR1), NoTitle_NoArticle (TR2) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Verification of Transformations" year="2014">
    <authors author="Ian Miller"/>
    <authors author="John Doe"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR2" title="Verification of Transformations" year="2015">
    <authors author="Karen Adams"/>
  </entries>

  <!-- Book B1 & B2: same title and same publisher/year to test duplicate titles across Books -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Foundations of MDE" year="2010" publisher="TechBooks Publishing">
    <authors author="Laura Scott"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="B2" title="Foundations of MDE" year="2011" publisher="TechBooks Publishing">
    <authors author="Michael Young"/>
    <authors author="Nancy Hill"/>
  </entries>

  <!-- Manual M1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="ATL User Guide"/>
  
  <!-- Unpublished U1: unique title with note -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Draft on Model Synchronization" note="Work in progress">
    <authors author="Oliver Stone"/>
  </entries>

  <!-- Proceedings P1: unique titled proceedings -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" title="Proceedings of the International Conference on MDE" year="2020"/>

  <!-- InProceedings IP1 & IP2: same booktitle, different titles; IP1 shares author with B1 to reuse author -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Case Studies in ATL" year="2020" booktitle="ICMDE 2020">
    <authors author="Laura Scott"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP2" title="Scalability of Transformations" year="2020" booktitle="ICMDE 2020">
    <authors author="Peter Quinn"/>
  </entries>

  <!-- InBook IB1 & IB2: same title, different chapters -> Title/NoTitle pair -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chapter on Testing" year="2011" publisher="TechBooks Publishing" chapter="3">
    <authors author="Nancy Hill"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="IB2" title="Chapter on Testing" year="2011" publisher="TechBooks Publishing" chapter="7">
    <authors author="Rachel Cole"/>
  </entries>

  <!-- InCollection IC1: unique title, reuses book publisher and author -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Models at Runtime" year="2010" publisher="TechBooks Publishing" booktitle="Advanced MDE Topics">
    <authors author="John Doe"/>
  </entries>

  <!-- PhDThesis and MasterThesis sharing same title to exercise Title/NoTitle for thesis entries -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Analysis of Model Transformations" year="2012" school="University of Modeling">
    <authors author="Sarah Turner"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MSC1" title="Analysis of Model Transformations" year="2013" school="Institute of Software">
    <authors author="Tom Walker"/>
  </entries>

  <!-- Booklet BL1: untitled dated entry -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="2009"/>

  <!-- Misc MS1 & MS2: untitled entries, MS2 shares an author with an article -->
  <entries xsi:type="BibTeX:Misc" id="MS1"/>
  <entries xsi:type="BibTeX:Misc" id="MS2">
    <authors author="Alice Smith"/>
  </entries>

</BibTeX:BibTeXFile>