<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries to trigger R3 (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="miscUnique1"/>
  <entries xsi:type="BibTeX:Booklet" id="bookletUnique1" year="2015"/>

  <!-- Non-Article titled entries with unique titles to trigger R4 (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="A Unique Master Thesis" year="2012" school="Tech University">
    <authors author="Alice Unique"/>
    <authors author="Bob Contributor"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="A Unique PhD Thesis" year="2010" school="Science Institute">
    <authors author="Carol Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Unique InBook Chapter" year="2011" publisher="Publisher A" chapter="3">
    <authors author="Dave Writer"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="b1" title="Unique Book Title" year="2008" publisher="Publisher B">
    <authors author="Eve Author"/>
    <authors author="Frank Coauthor"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Unique InCollection Title" year="2013" publisher="Publisher C">
    <authors author="Grace Collector"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Unique InProceedings Paper" year="2014" booktitle="Proceedings on MDE">
    <authors author="Heidi Presenter"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="p1" title="Proceedings on MDE" year="2014"/>
  <entries xsi:type="BibTeX:Manual" id="m1" title="Unique Manual Title"/>
  <entries xsi:type="BibTeX:Unpublished" id="u1" title="Unique Unpublished Work" note="Under review">
    <authors author="Ivan Unpublished"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Unique Tech Report" year="2009">
    <authors author="Jane Reporter"/>
  </entries>

  <!-- Non-Article titled entries sharing the SAME title to trigger R5 (TitledEntry_NoTitle_NoArticle) -->
  <!-- Two Book entries with identical title -->
  <entries xsi:type="BibTeX:Book" id="b2" title="Shared Book Title" year="2007" publisher="Publisher D">
    <authors author="Karl SameTitle"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="b3" title="Shared Book Title" year="2007" publisher="Publisher E">
    <authors author="Laura SameTitle"/>
  </entries>
  <!-- Two TechReport entries with identical title -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="Shared Report Title" year="2016">
    <authors author="Mike Shared"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr3" title="Shared Report Title" year="2016">
    <authors author="Nina Shared"/>
  </entries>

  <!-- Articles: unique title & unique journal to trigger R6 (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Unique Article One" year="2020" journal="Journal of Unique Studies">
    <authors author="Olivia Unique"/>
    <authors author="Peter Unique"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a2" title="Another Unique Article" year="2019" journal="International Journal of Examples">
    <authors author="Quentin Example"/>
  </entries>

  <!-- Articles: same title, different journals to trigger R7 (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="a3" title="Repeated Title Article" year="2018" journal="Journal A">
    <authors author="Rachel Repeat"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a4" title="Repeated Title Article" year="2018" journal="Journal B">
    <authors author="Sam Repeat"/>
  </entries>

  <!-- Articles: different titles, same journal to trigger R8 (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="a5" title="First Article in Same Journal" year="2017" journal="Shared Journal">
    <authors author="Tom SharedJournal"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a6" title="Second Article in Same Journal" year="2017" journal="Shared Journal">
    <authors author="Uma SharedJournal"/>
  </entries>

  <!-- Articles: same title AND same journal to trigger R9 (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="a7" title="Duplicate Title and Journal" year="2016" journal="Duplicated Journal">
    <authors author="Victor Duplicate"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a8" title="Duplicate Title and Journal" year="2016" journal="Duplicated Journal">
    <authors author="Wendy Duplicate"/>
  </entries>

</BibTeX:BibTeXFile>