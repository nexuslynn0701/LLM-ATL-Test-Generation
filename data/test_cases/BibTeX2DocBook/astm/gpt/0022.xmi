<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles for all four article rules -->
  <!-- A1, A2: same title, same journal -> A1 in Article_Title_Journal, A2 in Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Shared Title Journal Alpha" year="2018" journal="Journal Alpha">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" title="Shared Title Journal Alpha" year="2019" journal="Journal Alpha">
    <authors author="Charlie Lee"/>
  </entries>

  <!-- A3: unique title, journal with another article (A4) -> Article_Title_NoJournal -->
  <!-- A4: participating in same journal as A3, but excluded from articleSet -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Unique Title Journal Beta" year="2020" journal="Journal Beta">
    <authors author="Dana White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" title="Other Title Journal Beta" year="2021" journal="Journal Beta">
    <authors author="Evan Green"/>
  </entries>

  <!-- A5, A6: distinct titles, same journal -> A5 in Article_Title_NoJournal, A6 excluded -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Alpha Study One" year="2015" journal="Journal Gamma">
    <authors author="Fiona Black"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" title="Alpha Study Two" year="2016" journal="Journal Gamma">
    <authors author="George Brown"/>
  </entries>

  <!-- A7: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A7" title="Lone Article Title" year="2017" journal="Solo Journal">
    <authors author="Helen Grey"/>
  </entries>

  <!-- Titled entries (non-Article) to trigger TitledEntry_* rules -->
  <!-- B1, B2: same title -> B1 in TitledEntry_Title_NoArticle, B2 in TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Common Book Title" year="2010" publisher="Global Press">
    <authors author="Ian Clark"/>
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="B2" title="Common Book Title" year="2011" publisher="Global Press 2">
    <authors author="Jack Davis"/>
  </entries>

  <!-- B3: unique title book -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B3" title="Unique Book Title" year="2012" publisher="Local House">
    <authors author="Karen Hill"/>
  </entries>

  <!-- IB1, IB2: InBook sharing book and title with B3 and each other;
       IB1 in TitledEntry_Title_NoArticle, IB2 in TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Unique Chapter Title" year="2013" publisher="Local House" chapter="1">
    <authors author="Laura King"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="IB2" title="Unique Chapter Title" year="2014" publisher="Local House" chapter="2">
    <authors author="Mike Brown"/>
  </entries>

  <!-- IC1: InCollection with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Collected Work Title" year="2009" publisher="Anthology Pub" booktitle="Collected Volume">
    <authors author="Nina Stone"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- IP1, IP2: InProceedings with same title -> IP1 in TitledEntry_Title_NoArticle, IP2 in TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Conference Paper Title" year="2019" booktitle="Conf 2019 Proceedings">
    <authors author="Oscar Reed"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP2" title="Conference Paper Title" year="2020" booktitle="Conf 2020 Proceedings">
    <authors author="Paula Young"/>
  </entries>

  <!-- PR1: Proceedings with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" title="Symposium Proceedings" year="2018"/>

  <!-- M1, M2: Manual with same title -> M1 in TitledEntry_Title_NoArticle, M2 in TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="Software Manual v1"/>
  <entries xsi:type="BibTeX:Manual" id="M2" title="Software Manual v1"/>

  <!-- U1: Unpublished with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Working Draft on Testing" note="To appear">
    <authors author="Quentin Nash"/>
  </entries>

  <!-- TR1, TR2: TechReport same title -> TR1 in TitledEntry_Title_NoArticle, TR2 in TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Tech Report Title" year="2016">
    <authors author="Rachel Scott"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR2" title="Tech Report Title" year="2017">
    <authors author="Steve Turner"/>
  </entries>

  <!-- PhD and Master theses to exercise ThesisEntry and TitledEntry rules -->
  <!-- PHD1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Doctoral Thesis on MDE" year="2014" school="Tech University">
    <authors author="Uma Patel"/>
  </entries>

  <!-- PHD2, PHD3: same title -> PHD2 in TitledEntry_Title_NoArticle, PHD3 in TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD2" title="Shared Thesis Title" year="2015" school="Science Institute">
    <authors author="Victor Hall"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Shared Thesis Title" year="2016" school="Science Institute">
    <authors author="Wendy Long"/>
  </entries>

  <!-- Untitled entries (non-TitledEntry) to trigger UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc" id="MS1"/>
  <entries xsi:type="BibTeX:Misc" id="MS2"/>
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="2005"/>
  <entries xsi:type="BibTeX:Booklet" id="BL2" year="2006"/>

</BibTeX:BibTeXFile>