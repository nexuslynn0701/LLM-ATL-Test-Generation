<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: trigger all four Article rules via title/journal duplicates -->
  <!-- A1, A2: same title and journal -> Article_Title_Journal (A1), Article_NoTitle_NoJournal (A2) -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Deep Learning in Practice" year="2020" journal="Journal of AI Research">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" title="Deep Learning in Practice" year="2021" journal="Journal of AI Research">
    <authors author="Carol White"/>
  </entries>

  <!-- A3, A4: same title, different journals -> Article_Title_Journal (A3), Article_NoTitle_Journal (A4) -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Model Transformation Testing" year="2019" journal="Software Engineering Notes">
    <authors author="David Brown"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" title="Model Transformation Testing" year="2018" journal="Empirical Software Studies">
    <authors author="Alice Smith"/>
  </entries>

  <!-- A5, A6: different titles, same journal -> Article_Title_Journal (A5), Article_Title_NoJournal (A6) -->
  <entries xsi:type="BibTeX:Article" id="A5" title="ATL Best Practices" year="2017" journal="Model-Driven Engineering Journal">
    <authors author="Eve Black"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" title="Testing ATL Transformations" year="2016" journal="Model-Driven Engineering Journal">
    <authors author="Frank Green"/>
  </entries>

  <!-- Non-article titled entries: trigger TitledEntry_Title_NoArticle and TitledEntry_NoTitle_NoArticle -->
  <!-- B1, B2: same title Book -> Title_NoArticle (B1), NoTitle_NoArticle (B2) -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Foundations of MDE" year="2015" publisher="TechPress">
    <authors author="George King"/>
    <authors author="Helen Lee"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="B2" title="Foundations of MDE" year="2014" publisher="TechPress">
    <authors author="Ian Moore"/>
  </entries>

  <!-- P1, P2: same title Proceedings -> Title_NoArticle (P1), NoTitle_NoArticle (P2) -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" title="ICMT Proceedings" year="2013"/>
  <entries xsi:type="BibTeX:Proceedings" id="P2" title="ICMT Proceedings" year="2012"/>

  <!-- I1, I2: same title InProceedings -> Title_NoArticle (I1), NoTitle_NoArticle (I2) -->
  <entries xsi:type="BibTeX:InProceedings" id="I1" title="MDE in Industry" year="2011" booktitle="ICMT Proceedings">
    <authors author="Jack Norris"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="I2" title="MDE in Industry" year="2010" booktitle="ICMT Proceedings">
    <authors author="Carol White"/>
    <authors author="David Brown"/>
  </entries>

  <!-- Thesis entries: MasterThesis and PhDThesis with duplicate title -->
  <!-- MT1, MT2: same title MasterThesis -> Title_NoArticle (MT1), NoTitle_NoArticle (MT2) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Scalable Model Transformations" year="2009" school="Tech University">
    <authors author="Laura Scott"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT2" title="Scalable Model Transformations" year="2008" school="Tech University">
    <authors author="Mike Turner"/>
  </entries>

  <!-- PHD1, PHD2: same title PhDThesis -> Title_NoArticle (PHD1), NoTitle_NoArticle (PHD2) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Advanced Transformation Verification" year="2007" school="Innovation Institute">
    <authors author="Nina Adams"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PHD2" title="Advanced Transformation Verification" year="2006" school="Innovation Institute">
    <authors author="Oscar Perry"/>
  </entries>

  <!-- Manual and TechReport with unique titles: only Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="ATL User Guide"/>
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="MDE Tool Evaluation" year="2005">
    <authors author="Paul Young"/>
  </entries>

  <!-- Unpublished entries with duplicate title: Title_NoArticle (U1), NoTitle_NoArticle (U2) -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Unreleased Case Study" note="Draft version">
    <authors author="Quinn Fox"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Unreleased Case Study" note="Internal review">
    <authors author="Rachel Hall"/>
  </entries>

  <!-- InBook and InCollection with duplicate title -->
  <!-- IB1, IB2: same title InBook -> Title_NoArticle (IB1), NoTitle_NoArticle (IB2) -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Practical EMF" year="2004" publisher="Modeling House" chapter="3">
    <authors author="Steve Clark"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="IB2" title="Practical EMF" year="2003" publisher="Modeling House" chapter="5">
    <authors author="Tina Reed"/>
  </entries>

  <!-- IC1, IC2: same title InCollection -> Title_NoArticle (IC1), NoTitle_NoArticle (IC2) -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Reusable Transformations" year="2002" publisher="Springer" booktitle="Foundations of MDE">
    <authors author="Uma Patel"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="IC2" title="Reusable Transformations" year="2001" publisher="Springer" booktitle="Foundations of MDE">
    <authors author="Victor Stone"/>
  </entries>

  <!-- Untitled entries (not TitledEntry): trigger UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="X1"/>
  <entries xsi:type="BibTeX:Booklet" id="X2" year="1999"/>

</BibTeX:BibTeXFile>