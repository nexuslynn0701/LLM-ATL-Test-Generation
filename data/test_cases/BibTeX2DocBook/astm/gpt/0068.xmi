<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: create situations for all four article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Unique Article Title"
           year="2018"
           journal="Unique Journal 1">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- A2 & A3: same title, different journals -->
  <!-- A2: appears in unique-title set, unique-journal set -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Title Article"
           year="2019"
           journal="Journal X">
    <authors author="Charlie Researcher"/>
  </entries>

  <!-- A3: same title as A2 (so not in titledEntrySet), unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Shared Title Article"
           year="2020"
           journal="Journal Y">
    <authors author="Diana Analyst"/>
  </entries>

  <!-- A4 & A5: same journal, different titles -->
  <!-- A4: title unique, journal duplicate -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Article In Journal Z - One"
           year="2021"
           journal="Journal Z">
    <authors author="Evan Scientist"/>
  </entries>

  <!-- A5: title unique, journal duplicate -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Article In Journal Z - Two"
           year="2022"
           journal="Journal Z">
    <authors author="Fiona Engineer"/>
  </entries>

  <!-- A6 & A7: same title and same journal -->
  <!-- A6: one representative in both title and journal sets -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Duplicate Title And Journal"
           year="2017"
           journal="Journal D">
    <authors author="George Theorist"/>
  </entries>

  <!-- A7: same title, same journal as A6 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Duplicate Title And Journal"
           year="2016"
           journal="Journal D">
    <authors author="Hannah Practitioner"/>
  </entries>

  <!-- Untitled entries: Misc and Booklet for UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc"
           id="M1"/>
  <entries xsi:type="BibTeX:Booklet"
           id="BKT1"
           year="2015"/>

  <!-- Titled non-article entries to hit TitledEntry rules -->
  <!-- Unique titled, no-article entries -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="BK1"
           title="Unique Book Title"
           year="2014"
           publisher="Famous Publisher">
    <authors author="Ian Bookauthor"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Unique Thesis Title"
           year="2013"
           school="Tech University">
    <authors author="Julia Doctoral"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Unique InProceedings Title"
           year="2012"
           booktitle="Conference on Testing Models">
    <authors author="Karl Conference"/>
  </entries>

  <entries xsi:type="BibTeX:Proceedings"
           id="PR1"
           title="Unique Proceedings Title"
           year="2011"/>
  
  <entries xsi:type="BibTeX:Manual"
           id="MN1"
           title="Unique Manual Title"/>

  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Unique Tech Report Title"
           year="2010">
    <authors author="Laura Reporter"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="UP1"
           title="Unique Unpublished Title"
           note="Submitted for publication">
    <authors author="Mike Unpublished"/>
  </entries>

  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Unique InBook Title"
           year="2009"
           publisher="Academic Press"
           chapter="3">
    <authors author="Nina Chapter"/>
  </entries>

  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Unique InCollection Title"
           year="2008"
           publisher="Collection House">
    <authors author="Oscar Collector"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Unique Master Thesis Title"
           year="2007"
           school="City University">
    <authors author="Paula Master"/>
  </entries>

  <!-- Duplicated title among non-article titled entries ->
       one entry in the unique-title set, others for TitledEntry_NoTitle_NoArticle -->
  <!-- First occurrence of duplicated title (will be in titledEntrySet) -->
  <entries xsi:type="BibTeX:Book"
           id="BK2"
           title="Repeated NonArticle Title"
           year="2006"
           publisher="Another Publisher">
    <authors author="Quentin Author1"/>
  </entries>

  <!-- Second occurrence with same title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT2"
           title="Repeated NonArticle Title"
           year="2005"
           school="Other University">
    <authors author="Rachel Author2"/>
  </entries>

  <!-- Third occurrence with same title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR2"
           title="Repeated NonArticle Title"
           year="2004">
    <authors author="Sam Author3"/>
  </entries>

</BibTeX:BibTeXFile>