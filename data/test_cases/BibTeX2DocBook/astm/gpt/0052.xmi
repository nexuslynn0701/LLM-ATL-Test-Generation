<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for rule UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2018"/>

  <!-- Non-article titled entries with unique titles (for TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="Unique Book Title" year="2010" publisher="UniquePub">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="ib1" title="InBook Unique Title" year="2012" publisher="ChapterPub" chapter="1">
    <authors author="Charlie Chapter"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Collection Chapter Title" year="2015" publisher="CollPub">
    <authors author="Dana Contributor"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Conference Paper Title" year="2017" booktitle="ConfBook 2017">
    <authors author="Evan Speaker"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="pr1" title="Proceedings Volume One" year="2017"/>
  <entries xsi:type="BibTeX:Manual" id="man1" title="User Manual v1"/>
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft Ideas" note="Work in progress">
    <authors author="Frank Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Tech Report Alpha" year="2013">
    <authors author="Grace Engineer"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="PhD Unique Title" year="2011" school="Tech University">
    <authors author="Henry Doctoral"/>
  </entries>

  <!-- Non-article titled entries with duplicated titles (for TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Shared Thesis Title" year="2014" school="Science Univ">
    <authors author="Ivy Graduate"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd2" title="Shared Thesis Title" year="2016" school="Science Univ">
    <authors author="Jack Doctoral"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="bk2" title="Duplicated Book Title" year="2009" publisher="DupPub">
    <authors author="Karen Author"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="ib2" title="Duplicated Book Title" year="2009" publisher="DupPub" chapter="5">
    <authors author="Leo Chapter"/>
  </entries>

  <!-- Articles to cover all four article rules -->
  <!-- Unique title and unique journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Unique Article Title" year="2020" journal="Journal A">
    <authors author="Mia Scientist"/>
    <authors author="Noah Analyst"/>
  </entries>

  <!-- Same title, different journals (Article_NoTitle_Journal for the 2nd) -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Shared Article Title" year="2019" journal="Journal B">
    <authors author="Olivia Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a3" title="Shared Article Title" year="2021" journal="Journal C">
    <authors author="Paul Investigator"/>
  </entries>

  <!-- Different titles, same journal (Article_Title_NoJournal for the 2nd) -->
  <entries xsi:type="BibTeX:Article" id="a4" title="First Journal D Article" year="2018" journal="Journal D">
    <authors author="Quinn Author"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a5" title="Second Journal D Article" year="2022" journal="Journal D">
    <authors author="Rita Author"/>
  </entries>

  <!-- Same title and same journal (Article_NoTitle_NoJournal for the 2nd and 3rd) -->
  <entries xsi:type="BibTeX:Article" id="a6" title="Repeated Title Journal E" year="2017" journal="Journal E">
    <authors author="Sam Writer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a7" title="Repeated Title Journal E" year="2018" journal="Journal E">
    <authors author="Tom Writer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a8" title="Repeated Title Journal E" year="2019" journal="Journal E">
    <authors author="Uma Writer"/>
  </entries>

</BibTeX:BibTeXFile>