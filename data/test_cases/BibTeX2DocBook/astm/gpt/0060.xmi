<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: trigger Article_* rules and provide journals & titles -->
  <!-- A1 & A2: same title & same journal -> one in Article_Title_Journal, one in Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Unified Modeling Techniques"
           year="2018"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Unified Modeling Techniques"
           year="2019"
           journal="Journal of Model Engineering">
    <authors author="Carol White"/>
  </entries>

  <!-- A3 & A4: same title, different journals -> one in Article_Title_Journal, one in Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Model Transformation Patterns"
           year="2020"
           journal="Software Systems Journal">
    <authors author="David Brown"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Model Transformation Patterns"
           year="2021"
           journal="International Journal of MDE">
    <authors author="Eve Green"/>
  </entries>

  <!-- A5 & A6: different titles, same journal -> one in Article_Title_Journal, one in Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Testing ATL Transformations"
           year="2017"
           journal="Journal of Software Quality">
    <authors author="Frank Black"/>
    <authors author="Alice Smith"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Advanced ATL Debugging"
           year="2016"
           journal="Journal of Software Quality">
    <authors author="Grace Miller"/>
  </entries>

  <!-- Untitled entries: trigger UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="M1">
  </entries>

  <entries xsi:type="BibTeX:Booklet"
           id="BKL1"
           year="2015">
  </entries>

  <!-- Titled, non-Article entries: trigger TitledEntry_*_NoArticle -->
  <!-- Unique titles -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Model-Driven Engineering in Practice"
           year="2014"
           publisher="TechBooks Publishing">
    <authors author="Alice Smith"/>
    <authors author="Henry King"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Model Transformation Testing Framework"
           year="2013"
           school="Tech University">
    <authors author="Ian Gray"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Scalable Model Management"
           year="2012"
           school="Engineering Institute">
    <authors author="Jane Doe"/>
  </entries>

  <entries xsi:type="BibTeX:Manual"
           id="MAN1"
           title="ATL Tooling Guide">
  </entries>

  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Industrial MDE Case Studies"
           year="2011"
           school="Research Labs">
    <authors author="Bob Johnson"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="UNP1"
           title="Preliminary Results on Model Testing"
           note="To appear">
    <authors author="Carol White"/>
  </entries>

  <entries xsi:type="BibTeX:Proceedings"
           id="PR1"
           title="Proceedings of the MDE Conference"
           year="2010">
  </entries>

  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="An ATL-Based Transformation Case Study"
           year="2010"
           booktitle="Proceedings of the MDE Conference">
    <authors author="David Brown"/>
    <authors author="Jane Doe"/>
  </entries>

  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Chapter on Model Validation"
           year="2013"
           publisher="TechBooks Publishing"
           booktitle="Model-Driven Engineering in Practice">
    <authors author="Frank Black"/>
  </entries>

  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Reusable Transformation Components"
           year="2014"
           publisher="TechBooks Publishing"
           chapter="5">
    <authors author="Grace Miller"/>
  </entries>

  <!-- Duplicate title among non-Article entries to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B2"
           title="Model-Driven Engineering in Practice"
           year="2019"
           publisher="NextGen Publishing">
    <authors author="Henry King"/>
  </entries>

</BibTeX:BibTeXFile>