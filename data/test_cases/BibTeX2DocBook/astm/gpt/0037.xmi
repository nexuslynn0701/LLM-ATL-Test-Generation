<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise all Article* rules via title/journal duplication patterns -->
  <!-- A1 & A2: same title, same journal => one in Article_Title_Journal, one in Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Shared Insights" year="2020" journal="Journal Alpha">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a2" title="Shared Insights" year="2021" journal="Journal Alpha">
    <authors author="Carol White"/>
  </entries>

  <!-- A3 & A4: same title, different journals => one Article_Title_Journal, one Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="a3" title="Duplicated Title" year="2019" journal="Journal Beta">
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a4" title="Duplicated Title" year="2019" journal="Journal Gamma">
    <authors author="David Black"/>
  </entries>

  <!-- A5 & A6: different titles, same journal => one Article_Title_Journal, one Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a5" title="Unique Study" year="2018" journal="Journal Delta">
    <authors author="Eve Miller"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a6" title="Another Study" year="2018" journal="Journal Delta">
    <authors author="Frank Green"/>
  </entries>

  <!-- A7: unique title and journal => Article_Title_Journal only -->
  <entries xsi:type="BibTeX:Article" id="a7" title="Isolated Article" year="2017" journal="Journal Epsilon">
    <authors author="George Brown"/>
  </entries>

  <!-- Untitled entries to trigger UntitledEntry (Misc, Booklet) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Booklet" id="b1" year="2015"/>

  <!-- Titled non-Article entries to trigger TitledEntry_* rules with various patterns -->

  <!-- Unique titles => TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="Unique Book" year="2014" publisher="Pub One">
    <authors author="Hannah King"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Unique Chapter" year="2013" publisher="Pub Two" booktitle="Collected Works">
    <authors author="Ian Lee"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Conference Paper" year="2012" booktitle="Conf A">
    <authors author="Jack Clark"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="pr1" title="Proceedings Volume" year="2011"/>
  <entries xsi:type="BibTeX:Manual" id="mn1" title="Tool Manual"/>
  <entries xsi:type="BibTeX:Unpublished" id="up1" title="Working Draft" note="To appear">
    <authors author="Lucy Gray"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Tech Report One" year="2010">
    <authors author="Mark Hall"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Master Thesis Title" year="2009" school="Uni One">
    <authors author="Nina Rose"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="ph1" title="PhD Thesis Title" year="2008" school="Uni Two">
    <authors author="Oscar Reed"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Book Chapter Title" year="2007" publisher="Pub Three" chapter="3">
    <authors author="Paul Scott"/>
  </entries>

  <!-- Duplicate title across non-Articles to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="bk2" title="Shared Book Title" year="2006" publisher="Pub Four">
    <authors author="Quinn Turner"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="bk3" title="Shared Book Title" year="2005" publisher="Pub Five">
    <authors author="Rachel Young"/>
  </entries>

  <!-- Additional duplicates for other non-Article subtypes -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="Repeated Tech Report" year="2004">
    <authors author="Steve Adams"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr3" title="Repeated Tech Report" year="2003">
    <authors author="Tina Brooks"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished" id="up2" title="Shared Draft" note="Internal">
    <authors author="Uma Fisher"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="up3" title="Shared Draft" note="Extended version">
    <authors author="Victor Hill"/>
  </entries>

</BibTeX:BibTeXFile>