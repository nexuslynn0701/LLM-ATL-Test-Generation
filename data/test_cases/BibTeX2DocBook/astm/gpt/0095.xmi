<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="MDE Foundations"
           year="2018"
           journal="Journal of Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A2: same title as A3, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Transformation Testing"
           year="2019"
           journal="Software Testing Journal">
    <authors author="Carol White"/>
  </entries>

  <!-- A3: same title as A2, journal unique (different from A2 and others) -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Transformation Testing"
           year="2020"
           journal="International Journal of MDE">
    <authors author="David Black"/>
  </entries>

  <!-- A4: unique title, journal shared with A5 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Model Synchronization"
           year="2021"
           journal="Empirical Software Engineering">
    <authors author="Alice Smith"/>
  </entries>

  <!-- A5: another article in same journal as A4, different title -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Incremental Transformations"
           year="2022"
           journal="Empirical Software Engineering">
    <authors author="Bob Johnson"/>
  </entries>

  <!-- B1: Book, title appears only once -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Intro to MDE"
           year="2015"
           publisher="TechBooks Publishing">
    <authors author="Eve Grey"/>
  </entries>

  <!-- B2: InBook, same title as B3 -> one in set (B2), one out (B3) -->
  <!-- B2: will be in unique-title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook"
           id="B2"
           title="Advanced Model Transformations"
           year="2016"
           publisher="TechBooks Publishing"
           chapter="3">
    <authors author="Frank Miller"/>
  </entries>

  <!-- B3: InCollection, same title as B2 -> not in unique-title set -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InCollection"
           id="B3"
           title="Advanced Model Transformations"
           year="2017"
           publisher="SciPress">
    <authors author="Grace Lee"/>
  </entries>

  <!-- T1: PhDThesis, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="T1"
           title="Formal Methods for Transformations"
           year="2014"
           school="University of Computing">
    <authors author="Henry King"/>
  </entries>

  <!-- T2: MasterThesis, same title as T3 -> one in set (T2), one out (T3) -->
  <!-- T2: unique representative -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="T2"
           title="Model Integration Techniques"
           year="2013"
           school="Institute of Technology">
    <authors author="Irene Stone"/>
  </entries>

  <!-- T3: TechReport, same title as T2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="T3"
           title="Model Integration Techniques"
           year="2012">
    <authors author="Jack Brown"/>
  </entries>

  <!-- U1: Unpublished, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Draft on Model Repair"
           note="To appear">
    <authors author="Karen Young"/>
  </entries>

  <!-- M1: Manual, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual"
           id="M1"
           title="Transformation Tool User Guide">
  </entries>

  <!-- P1: Proceedings, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings"
           id="P1"
           title="Proceedings of the MDE Conference"
           year="2011">
  </entries>

  <!-- IP1: InProceedings, shares booktitle with IP2, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Case Studies in MDE"
           year="2010"
           booktitle="MDE Conf 2010">
    <authors author="Laura Green"/>
  </entries>

  <!-- IP2: InProceedings, same booktitle as IP1 but different title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP2"
           title="Tool Support for MDE"
           year="2010"
           booktitle="MDE Conf 2010">
    <authors author="Michael Blue"/>
  </entries>

  <!-- BL1: Booklet (DatedEntry only, no title) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet"
           id="BL1"
           year="2009">
  </entries>

  <!-- MS1: Misc (no title, no date) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="MS1">
  </entries>

</BibTeX:BibTeXFile>