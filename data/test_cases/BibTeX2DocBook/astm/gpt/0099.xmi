<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles group 1: same title, same journal -> Article_NoTitle_NoJournal on all of them -->
  <entries xsi:type="BibTeX:Article"
           id="art1"
           title="Shared Insights"
           year="2020"
           journal="International Journal of Testing">
    <authors author="Alice Example"/>
    <authors author="Bob Sample"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="art2"
           title="Shared Insights"
           year="2021"
           journal="International Journal of Testing">
    <authors author="Alice Example"/>
  </entries>

  <!-- Articles group 2: same title, different journals -> Article_NoTitle_Journal on both -->
  <entries xsi:type="BibTeX:Article"
           id="art3"
           title="Model Transformations in Practice"
           year="2018"
           journal="Software Engineering Notes">
    <authors author="Carol Reviewer"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="art4"
           title="Model Transformations in Practice"
           year="2019"
           journal="Journal of Model Engineering">
    <authors author="Dave Researcher"/>
  </entries>

  <!-- Articles group 3: different titles, same journal -> Article_Title_NoJournal on both -->
  <entries xsi:type="BibTeX:Article"
           id="art5"
           title="Testing ATL Transformations"
           year="2017"
           journal="MDE Transactions">
    <authors author="Eve Analyst"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="art6"
           title="Validating Model Transformations"
           year="2016"
           journal="MDE Transactions">
    <authors author="Frank Architect"/>
  </entries>

  <!-- Article group 4: unique title and journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="art7"
           title="Single Article Case Study"
           year="2015"
           journal="Unique Journal of Cases">
    <authors author="Grace Engineer"/>
  </entries>

  <!-- Untitled entries to trigger UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="misc1"/>
  <entries xsi:type="BibTeX:Booklet"
           id="booklet1"
           year="2010"/>

  <!-- Titled non-article entries: some with duplicate titles to split between Title/NoTitle rules -->

  <!-- Title appears twice across different non-article types -->
  <entries xsi:type="BibTeX:Book"
           id="book1"
           title="Common Title"
           year="2011"
           publisher="TechBooks Publishing">
    <authors author="Henry Author"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis"
           id="phd1"
           title="Common Title"
           year="2012"
           school="University of Modeling">
    <authors author="Irene Scholar"/>
  </entries>

  <!-- Another pair with the same title -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mst1"
           title="Repeated Title"
           year="2013"
           school="Institute of Engineering">
    <authors author="John Student"/>
  </entries>

  <entries xsi:type="BibTeX:InBook"
           id="inbook1"
           title="Repeated Title"
           year="2014"
           publisher="Science Press"
           chapter="3">
    <authors author="Karen Writer"/>
  </entries>

  <!-- Unique-title non-article entries -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol1"
           title="Collection Chapter"
           year="2019"
           publisher="Collected Works Ltd.">
    <authors author="Laura Contributor"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings"
           id="inproc1"
           title="Proceedings Paper"
           year="2021"
           booktitle="MDE Conference 2021">
    <authors author="Mike Presenter"/>
  </entries>

  <entries xsi:type="BibTeX:Proceedings"
           id="proc1"
           title="MDE Conference 2021 Proceedings"
           year="2021"/>
          
  <entries xsi:type="BibTeX:Manual"
           id="man1"
           title="ATL User Manual"/>

  <entries xsi:type="BibTeX:Unpublished"
           id="unp1"
           title="Working Draft on Testing"
           note="Draft version, not yet submitted.">
    <authors author="Nina Draft"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport"
           id="tr1"
           title="Technical Report on MDE"
           year="2022">
    <authors author="Oscar Reporter"/>
  </entries>

</BibTeX:BibTeXFile>