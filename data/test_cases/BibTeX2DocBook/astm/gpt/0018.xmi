<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: cover all four Article rules via combinations of (title uniqueness, journal uniqueness) -->

  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="A Unique Study on Models" year="2015" journal="Exclusive Journal of MDE">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A2 & A3: same title, same journal -> first triggers Article_NoTitle_NoJournal, second triggers Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Duplicated Title in Same Journal" year="2016" journal="Journal of Repeated Studies">
    <authors author="Carol White"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="A3" title="Duplicated Title in Same Journal" year="2017" journal="Journal of Repeated Studies">
    <authors author="David Black"/>
  </entries>

  <!-- A4 & A5: same title, different journals ->
       A4: Article_NoTitle_Journal (duplicate title, unique journal)
       A5: Article_NoTitle_Journal (duplicate title, unique journal) -->
  <entries xsi:type="BibTeX:Article" id="A4" title="Cross-Journal Comparison" year="2018" journal="International MDE Review">
    <authors author="Eve Brown"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="A5" title="Cross-Journal Comparison" year="2019" journal="Software Engineering Annals">
    <authors author="Frank Green"/>
  </entries>

  <!-- A6 & A7: different titles, same journal ->
       A6: Article_Title_NoJournal (unique title, duplicate journal)
       A7: Article_NoTitle_NoJournal (duplicate journal, but its own title will be in titled set through A7 itself) -->
  <entries xsi:type="BibTeX:Article" id="A6" title="Patterns in Transformations" year="2020" journal="Shared Venue Journal">
    <authors author="Grace Hall"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="A7" title="Another Article in Shared Venue" year="2021" journal="Shared Venue Journal">
    <authors author="Henry King"/>
  </entries>

  <!-- Non-article titled entries to exercise TitledEntry rules -->

  <!-- B1: Book with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Foundations of Model Transformation" year="2010" publisher="ModelPress">
    <authors author="Isabel Lee"/>
    <authors author="Jack Martin"/>
  </entries>

  <!-- B2 & B3: Books sharing the same title ->
       B2: TitledEntry_Title_NoArticle (first occurrence of title)
       B3: TitledEntry_NoTitle_NoArticle (duplicate title) -->
  <entries xsi:type="BibTeX:Book" id="B2" title="Shared Book Title" year="2011" publisher="TechBooks">
    <authors author="Karen Nelson"/>
  </entries>

  <entries xsi:type="BibTeX:Book" id="B3" title="Shared Book Title" year="2012" publisher="TechBooks 2">
    <authors author="Luke Owens"/>
  </entries>

  <!-- P1 & P2: Proceedings sharing same title ->
       P1: TitledEntry_Title_NoArticle
       P2: TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" title="Proceedings of the MDE Symposium" year="2013"/>
  <entries xsi:type="BibTeX:Proceedings" id="P2" title="Proceedings of the MDE Symposium" year="2014"/>

  <!-- IP1: InProceedings with unique title and booktitle -> TitledEntry_Title_NoArticle, tests BookTitledEntry & AuthoredEntry -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Transformations in Practice" year="2015" booktitle="Proc. of the Practical MDE Conf.">
    <authors author="Maria Perez"/>
    <authors author="Nick Quinn"/>
  </entries>

  <!-- IC1: InCollection with unique title & booktitle -> TitledEntry_Title_NoArticle, tests BookTitledEntry via InCollection -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="A Chapter on Testing Transformations" year="2011" publisher="ChapterHouse">
    <authors author="Olivia Reed"/>
  </entries>

  <!-- IB1 & IB2: InBook sharing same title ->
       IB1: TitledEntry_Title_NoArticle (first with title)
       IB2: TitledEntry_NoTitle_NoArticle (duplicate title), also tests chapter attribute -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Advanced Topics in MDE" year="2009" publisher="BookWorld" chapter="3">
    <authors author="Paul Scott"/>
  </entries>

  <entries xsi:type="BibTeX:InBook" id="IB2" title="Advanced Topics in MDE" year="2010" publisher="BookWorld" chapter="7">
    <authors author="Quentin Turner"/>
  </entries>

  <!-- MT1 & MT2: MasterThesis and PhDThesis with same title ->
       MT1: TitledEntry_Title_NoArticle (first with the title)
       MT2: TitledEntry_NoTitle_NoArticle (duplicate) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Model Transformation Testing" year="2008" school="University A">
    <authors author="Rachel Underwood"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis" id="MT2" title="Model Transformation Testing" year="2009" school="University B">
    <authors author="Sam Vincent"/>
  </entries>

  <!-- TR1 & TR2: TechReports with different titles -> each TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Initial Report on MDE" year="2007">
    <authors author="Tom Walker"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport" id="TR2" title="Follow-up Report on MDE" year="2008">
    <authors author="Uma Xu"/>
  </entries>

  <!-- Manual and Unpublished to exercise more TitledEntry variants -->

  <!-- M1: Manual with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="ATL User Manual"/>
  
  <!-- U1 & U2: Unpublished entries with same title ->
       U1: TitledEntry_Title_NoArticle
       U2: TitledEntry_NoTitle_NoArticle, also tests note attribute -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Draft on Experimental Results" note="To be submitted soon">
    <authors author="Victor Young"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Draft on Experimental Results" note="Internal circulation only">
    <authors author="Wendy Zane"/>
  </entries>

  <!-- Untitled entries for UntitledEntry rule -->

  <!-- MS1 & MS2: Misc and Booklet (neither is TitledEntry) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MS1"/>
  <entries xsi:type="BibTeX:Booklet" id="MS2" year="2005"/>

</BibTeX:BibTeXFile>