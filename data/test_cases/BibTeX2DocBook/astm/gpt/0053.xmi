<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles group 1: same title, different journals -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Shared Title A"
           year="2020"
           journal="Journal Alpha">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Title A"
           year="2021"
           journal="Journal Beta">
    <authors author="Carol White"/>
  </entries>

  <!-- Articles group 2: different titles, same journal -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Alpha Study"
           year="2019"
           journal="Journal Gamma">
    <authors author="Dan Brown"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Beta Study"
           year="2019"
           journal="Journal Gamma">
    <authors author="Eve Black"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- Articles group 3: unique title and unique journal -->
  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Unique Insights"
           year="2018"
           journal="Journal Delta">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Misc entry: untitled, no extra features -->
  <entries xsi:type="BibTeX:Misc"
           id="M1"/>

  <!-- Booklet entry: untitled but dated -->
  <entries xsi:type="BibTeX:Booklet"
           id="Blet1"
           year="2017"/>

  <!-- TechReports: same title to exercise title-duplication in non-articles -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Duplicated Report Title"
           year="2016">
    <authors author="George King"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport"
           id="TR2"
           title="Duplicated Report Title"
           year="2016">
    <authors author="Helen Young"/>
  </entries>

  <!-- MasterThesis with unique title -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Mastering Model Transformations"
           year="2015"
           school="Tech University">
    <authors author="Ian Gray"/>
  </entries>

  <!-- PhDThesis sharing title with a Book -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Advanced Transformation Techniques"
           year="2014"
           school="Tech University">
    <authors author="Jane Doe"/>
  </entries>

  <!-- Book with same title as PHD1 -->
  <entries xsi:type="BibTeX:Book"
           id="BK1"
           title="Advanced Transformation Techniques"
           year="2013"
           publisher="Academic Press">
    <authors author="Jane Doe"/>
    <authors author="Kyle Brown"/>
  </entries>

  <!-- InBook, unique title -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Chapter on Model Testing"
           year="2012"
           publisher="Tech Books"
           chapter="7">
    <authors author="Laura Hill"/>
  </entries>

  <!-- InCollection sharing title with an InProceedings -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Collected Research on MDE"
           year="2011"
           publisher="Research Collections"
           booktitle="Collected Works in Software Engineering">
    <authors author="Mike Scott"/>
  </entries>

  <!-- Proceedings with unique title -->
  <entries xsi:type="BibTeX:Proceedings"
           id="PR1"
           title="Proceedings of the MDE Conference"
           year="2010"/>
  
  <!-- InProceedings sharing title with IC1 -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Collected Research on MDE"
           year="2011"
           booktitle="MDE Conference 2011">
    <authors author="Nina Clark"/>
  </entries>

  <!-- Manual with unique title -->
  <entries xsi:type="BibTeX:Manual"
           id="MN1"
           title="Tool User Manual"/>

  <!-- Unpublished entries: same title but different notes -->
  <entries xsi:type="BibTeX:Unpublished"
           id="UP1"
           title="Work in Progress"
           note="Draft version">
    <authors author="Oscar Reed"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="UP2"
           title="Work in Progress"
           note="Revised version">
    <authors author="Paul Adams"/>
  </entries>

</BibTeX:BibTeXFile>