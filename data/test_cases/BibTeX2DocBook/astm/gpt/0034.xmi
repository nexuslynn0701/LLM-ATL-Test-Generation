<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Two Articles sharing same title and journal -> Article_NoTitle_NoJournal for second -->
  <entries xsi:type="BibTeX:Article" id="artA1" title="Unified Modeling in Practice" year="2018" journal="Journal of Software Design">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artA2" title="Unified Modeling in Practice" year="2019" journal="Journal of Software Design">
    <authors author="Alice Smith"/>
    <authors author="Carol White"/>
  </entries>

  <!-- Two Articles sharing title but different journals -> Article_NoTitle_Journal for second -->
  <entries xsi:type="BibTeX:Article" id="artB1" title="Model Transformations Survey" year="2020" journal="Modeling Letters">
    <authors author="David Brown"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artB2" title="Model Transformations Survey" year="2021" journal="Transactions on MDE">
    <authors author="Eve Black"/>
  </entries>

  <!-- Two Articles sharing journal but different titles -> Article_Title_NoJournal for second -->
  <entries xsi:type="BibTeX:Article" id="artC1" title="Testing ATL Transformations" year="2017" journal="International Journal of MDE">
    <authors author="Frank Green"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artC2" title="Fault Localization in Model Transformations" year="2017" journal="International Journal of MDE">
    <authors author="Helen Gray"/>
  </entries>

  <!-- Single Article with unique title and journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="artD1" title="Incremental Model Synchronization" year="2016" journal="Software Systems Review">
    <authors author="Ian Clark"/>
    <authors author="Jane Miller"/>
  </entries>

  <!-- Book: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Advanced Model-Driven Engineering" year="2015" publisher="TechPress">
    <authors author="Alice Smith"/>
    <authors author="Kyle Adams"/>
  </entries>

  <!-- InBook: shares title with another InBook -> second goes to TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Patterns of Model Transformation" year="2014" publisher="MDE House" chapter="3">
    <authors author="Laura King"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="inbook2" title="Patterns of Model Transformation" year="2014" publisher="MDE House" chapter="5">
    <authors author="Michael Scott"/>
  </entries>

  <!-- Manual: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL User Guide"/>
  
  <!-- TechReport: duplicate title pair to drive Title_NoTitle split -->
  <entries xsi:type="BibTeX:TechReport" id="tech1" title="Verification of Transformations" year="2013">
    <authors author="Nina Jones"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tech2" title="Verification of Transformations" year="2013">
    <authors author="Oscar Lee"/>
  </entries>

  <!-- PhDThesis: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Scalability of Model Transformations" year="2012" school="University of Modeling">
    <authors author="Peter Quinn"/>
  </entries>

  <!-- MasterThesis: title duplicated with an InCollection below to drive NoTitle variant -->
  <entries xsi:type="BibTeX:MasterThesis" id="msc1" title="Empirical Studies in MDE" year="2011" school="Tech University">
    <authors author="Rachel Stone"/>
  </entries>

  <!-- Proceedings: two entries sharing same title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proceedings of the MDE Conference 2010" year="2010"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc2" title="Proceedings of the MDE Conference 2010" year="2010"/>

  <!-- InProceedings: BookTitledEntry + Authored + Dated + Titled -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Case Studies in ATL" year="2009" booktitle="MDE Conference 2009">
    <authors author="Steve Turner"/>
    <authors author="Uma Patel"/>
  </entries>

  <!-- Booklet: DatedEntry but not titled -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2008"/>

  <!-- Misc: basic untitled entry -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- InCollection: shares title with MasterThesis msc1 -> one of them becomes NoTitle -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Empirical Studies in MDE" year="2011" publisher="SciencePress">
    <authors author="Tom Wright"/>
  </entries>

  <!-- Unpublished: titled, with note -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft on Bidirectional Transformations" note="To appear.">
    <authors author="Victor Young"/>
  </entries>

</BibTeX:BibTeXFile>