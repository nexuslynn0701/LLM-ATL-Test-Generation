<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: designed to hit all four Article rules -->
  <!-- A1 & A2: same title, different journals -> Article_Title_Journal and Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Shared Title One" year="2015" journal="Journal Alpha">
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a2" title="Shared Title One" year="2016" journal="Journal Beta">
    <authors author="Bob Jones"/>
  </entries>

  <!-- A3 & A4: different titles, same journal -> Article_Title_Journal and Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a3" title="Unique Title A3" year="2017" journal="Journal Gamma">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a4" title="Unique Title A4" year="2018" journal="Journal Gamma">
    <authors author="Dan Brown"/>
  </entries>

  <!-- A5 & A6: same title and same journal -> Article_Title_Journal and Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a5" title="Duplicated Article" year="2019" journal="Journal Delta">
    <authors author="Eve Black"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a6" title="Duplicated Article" year="2020" journal="Journal Delta">
    <authors author="Frank Green"/>
  </entries>

  <!-- Non-article titled entries: mix of unique and duplicate titles to hit TitledEntry rules -->

  <!-- B1: unique Book title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="b1" title="MDE Foundations" year="2010" publisher="TechPress">
    <authors author="Alice Smith"/>
    <authors author="George King"/>
  </entries>

  <!-- B2 & B3: same Book title -> TitledEntry_Title_NoArticle (b2) and TitledEntry_NoTitle_NoArticle (b3) -->
  <entries xsi:type="BibTeX:Book" id="b2" title="Patterns in Modeling" year="2011" publisher="ModelPress">
    <authors author="Helen Moore"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="b3" title="Patterns in Modeling" year="2012" publisher="ModelPress">
    <authors author="Ian Clark"/>
  </entries>

  <!-- P1: Proceedings (unique title) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="p1" title="ICMT 2013 Proceedings" year="2013"/>

  <!-- IP1 & IP2: InProceedings (share booktitle, distinct titles) -> both TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Transformations in Practice" year="2013" booktitle="ICMT 2013">
    <authors author="Jack Turner"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="ip2" title="Advanced ATL Techniques" year="2013" booktitle="ICMT 2013">
    <authors author="Karen Young"/>
  </entries>

  <!-- IB1 & IB2: InBook on same Book, same title -> Title_NoArticle (ib1) and NoTitle_NoArticle (ib2) -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Chapter on MDE" year="2014" publisher="TechPress" chapter="3">
    <authors author="Laura Scott"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="ib2" title="Chapter on MDE" year="2014" publisher="TechPress" chapter="7">
    <authors author="Michael Reed"/>
  </entries>

  <!-- IC1: InCollection with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Model Transformations Survey" year="2011" publisher="ModelPress" booktitle="Studies in MDE">
    <authors author="Nancy Hill"/>
  </entries>

  <!-- MT1 & MT2: MasterThesis with same title -> Title_NoArticle (mt1) and NoTitle_NoArticle (mt2) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="DSL Development" year="2012" school="City University">
    <authors author="Oscar Price"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mt2" title="DSL Development" year="2013" school="Metro University">
    <authors author="Paula Ross"/>
  </entries>

  <!-- PHD1: PhDThesis unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Scalable Model Transformations" year="2014" school="Tech University">
    <authors author="Quentin Stone"/>
  </entries>

  <!-- TR1 & TR2: TechReport, TR1 unique title (Title_NoArticle), TR2 shares title with a Book (NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="ATL Optimization Techniques" year="2015">
    <authors author="Rachel Adams"/>
  </entries>
  <!-- Same title as Book b1 ("MDE Foundations") to force it out of the unique-title set -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="MDE Foundations" year="2016">
    <authors author="Steve Baker"/>
  </entries>

  <!-- MAN1: Manual unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL User Guide"/>

  <!-- UNP1 & UNP2: Unpublished share title -> Title_NoArticle (unp1) and NoTitle_NoArticle (unp2);
       also test 'note' field in content construction -->
  <entries xsi:type="BibTeX:Unpublished" id="unp1" title="Pending Results on MDE" note="To appear in Journal Alpha">
    <authors author="Tom Irving"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unp2" title="Pending Results on MDE" note="Extended version submitted">
    <authors author="Uma Jenkins"/>
  </entries>

  <!-- Untitled entries (no title): Misc and Booklet to trigger UntitledEntry rule -->

  <!-- M1 & M2: Misc (no title) -> both UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Misc" id="m2"/>

  <!-- BK1 & BK2: Booklet (no title, but dated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="bk1" year="2009"/>
  <entries xsi:type="BibTeX:Booklet" id="bk2" year="2011"/>

</BibTeX:BibTeXFile>