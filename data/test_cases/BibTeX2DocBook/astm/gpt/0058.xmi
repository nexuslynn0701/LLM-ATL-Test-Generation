<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: 
       A1, A2 share same journal; A2, A4 share same title; A3 unique -->
  <!-- A1: unique title, journal J-Logic -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Logic in Computer Science"
           year="2010"
           journal="J-Logic">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A2: same journal as A1, same title as A4 (duplicate title) -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Advanced Model Transformations"
           year="2012"
           journal="J-Logic">
    <authors author="Carol White"/>
  </entries>

  <!-- A3: unique title and journal -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Testing Model Transformations"
           year="2015"
           journal="J-Testing">
    <authors author="David Black"/>
    <authors author="Eve Brown"/>
  </entries>

  <!-- A4: same title as A2, different journal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Advanced Model Transformations"
           year="2011"
           journal="J-Engineering">
    <authors author="Frank Green"/>
  </entries>

  <!-- TechReports: TR1 and TR2 share the same title -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="A Study on Traceability"
           year="2013">
    <authors author="George King"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport"
           id="TR2"
           title="A Study on Traceability"
           year="2014">
    <authors author="Helen Scott"/>
  </entries>

  <!-- Unpublished entries: unique title -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Informal Notes on ATL"
           note="Work in progress">
    <authors author="Ian Wright"/>
  </entries>

  <!-- Manual (no authors, just title) -->
  <entries xsi:type="BibTeX:Manual"
           id="M1"
           title="ATL User Manual"/>
           
  <!-- Book: authored, dated, titled, publisher -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Model-Driven Engineering Fundamentals"
           year="2016"
           publisher="TechPress">
    <authors author="John Doe"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- InBook: same book as B1 (different chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Model Transformations in Practice"
           year="2016"
           publisher="TechPress"
           chapter="5">
    <authors author="John Doe"/>
  </entries>

  <!-- InCollection: book + booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Reusable Transformation Patterns"
           year="2017"
           publisher="TechPress"
           booktitle="Advances in MDE">
    <authors author="Karen Long"/>
  </entries>

  <!-- InProceedings and Proceedings sharing same booktitle/year -->
  <entries xsi:type="BibTeX:Proceedings"
           id="P1"
           title="Proceedings of the MDE Conference 2018"
           year="2018">
  </entries>

  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Scalable Model Transformations"
           year="2018"
           booktitle="Proceedings of the MDE Conference 2018">
    <authors author="Laura Hill"/>
    <authors author="Mike Stone"/>
  </entries>

  <!-- PhDThesis and MasterThesis with distinct titles and schools -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PhD1"
           title="Formal Verification of ATL Transformations"
           year="2019"
           school="University of Tech">
    <authors author="Nina Cole"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis"
           id="MSc1"
           title="Test Generation for Model Transformations"
           year="2020"
           school="Institute of Computing">
    <authors author="Oscar Reed"/>
  </entries>

  <!-- Booklet: untitled entry type (DatedEntry only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="BK1"
           year="2009"/>

  <!-- Misc: completely untitled/untyped beyond BibTeXEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="MS1"/>
           
</BibTeX:BibTeXFile>