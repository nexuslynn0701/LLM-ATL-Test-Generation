<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles designed to cover all four article rules -->

  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Unique Article One"
           year="2010"
           journal="Journal Alpha">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- A2 & A3: same title, same journal -> one Article_Title_Journal, one Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Title Same Journal"
           year="2011"
           journal="Journal Beta">
    <authors author="Carol White"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Shared Title Same Journal"
           year="2012"
           journal="Journal Beta">
    <authors author="Dave Brown"/>
  </entries>

  <!-- A4 & A5: same title, different journals -> one Article_Title_Journal, one Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Shared Title Different Journal"
           year="2013"
           journal="Journal Gamma">
    <authors author="Eve Black"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Shared Title Different Journal"
           year="2014"
           journal="Journal Delta">
    <authors author="Frank Green"/>
  </entries>

  <!-- A6 & A7: different titles, same journal -> one Article_Title_Journal, one Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="First Title Same Journal"
           year="2015"
           journal="Journal Epsilon">
    <authors author="Grace Hall"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Second Title Same Journal"
           year="2016"
           journal="Journal Epsilon">
    <authors author="Henry King"/>
  </entries>

  <!-- Non-article titled entries for TitledEntry rules -->

  <!-- B1 & B2: same title Book -> one TitledEntry_Title_NoArticle, one TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Common Book Title"
           year="2001"
           publisher="Publisher One">
    <authors author="Ian Long"/>
    <authors author="Jane Moore"/>
  </entries>

  <entries xsi:type="BibTeX:Book"
           id="B2"
           title="Common Book Title"
           year="2002"
           publisher="Publisher Two">
    <authors author="Ian Long"/>
  </entries>

  <!-- B3: unique title Book -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B3"
           title="Unique Book Title"
           year="2003"
           publisher="Publisher Three">
    <authors author="Kate Nash"/>
  </entries>

  <!-- I1 & I2: InBook with same title, different chapter -> one Title_NoArticle, one NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InBook"
           id="I1"
           title="InBook Duplicate Title"
           year="2004"
           publisher="Pub A"
           chapter="1">
    <authors author="Liam O'Neil"/>
  </entries>

  <entries xsi:type="BibTeX:InBook"
           id="I2"
           title="InBook Duplicate Title"
           year="2005"
           publisher="Pub A"
           chapter="2">
    <authors author="Mia Perez"/>
  </entries>

  <!-- M1: Manual with unique title -> Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual"
           id="M1"
           title="Tool User Manual"/>
  
  <!-- P1 & P2: Proceedings with same title -> one Title_NoArticle, one NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings"
           id="P1"
           title="Conference Proceedings 2020"
           year="2020"/>
  <entries xsi:type="BibTeX:Proceedings"
           id="P2"
           title="Conference Proceedings 2020"
           year="2021"/>

  <!-- U1: Unpublished with unique title -> Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Unpublished Work"
           note="Draft version">
    <authors author="Nina Quinn"/>
  </entries>

  <!-- T1 & T2: TechReport same title -> one Title_NoArticle, one NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="T1"
           title="Tech Report Title"
           year="2017">
    <authors author="Oscar Reed"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport"
           id="T2"
           title="Tech Report Title"
           year="2018">
    <authors author="Paul Scott"/>
  </entries>

  <!-- PhDThesis and MasterThesis with unique titles -> Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Advanced Research on Testing"
           year="2019"
           school="Tech University">
    <authors author="Rachel Turner"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis"
           id="MSC1"
           title="Model Transformations in Practice"
           year="2018"
           school="Science College">
    <authors author="Sam Underwood"/>
  </entries>

  <!-- InCollection and InProceedings with unique titles -> Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Chapter in Collection"
           year="2011"
           publisher="Collection House"
           booktitle="Collected Studies">
    <authors author="Tom Vance"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Paper in Proceedings"
           year="2012"
           booktitle="Proc. of XYZ"
           >
    <authors author="Uma West"/>
  </entries>

  <!-- Untitled entries (not TitledEntry) for UntitledEntry rule -->

  <!-- Misc entries -->
  <entries xsi:type="BibTeX:Misc"
           id="MS1"/>
  <entries xsi:type="BibTeX:Misc"
           id="MS2"/>

  <!-- Booklet entries -->
  <entries xsi:type="BibTeX:Booklet"
           id="BL1"
           year="2009"/>
  <entries xsi:type="BibTeX:Booklet"
           id="BL2"
           year="2010"/>

</BibTeX:BibTeXFile>