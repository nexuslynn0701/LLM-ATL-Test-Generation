<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2010"/>

  <!-- Articles designed to hit different Article_* rules -->
  <!-- A1 and A2: same title and same journal -> one in Article_Title_Journal set, one in Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Common Article Title" year="2020" journal="Journal X">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art2" title="Common Article Title" year="2021" journal="Journal X">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- A3 and A4: same title, different journals -> one Article_Title_Journal, one Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Repeated Title" year="2019" journal="Journal Y">
    <authors author="Dan Delta"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art4" title="Repeated Title" year="2018" journal="Journal Z">
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- A5 and A6: different titles, same journal -> one Article_Title_Journal, one Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art5" title="Unique Title 1" year="2017" journal="Journal W">
    <authors author="Frank Phi"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art6" title="Unique Title 2" year="2016" journal="Journal W">
    <authors author="Grace Gamma"/>
  </entries>

  <!-- Non-article titled entries arranged for TitledEntry_* rules -->
  <!-- Three with same title "Shared Book Title" -> one in titledEntrySet, two out -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Shared Book Title" year="2015" publisher="Publisher A">
    <authors author="Henry Helix"/>
  </entries>

  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Shared Book Title" year="2014" publisher="Publisher A" chapter="3">
    <authors author="Ivy Iota"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis" id="mthesis1" title="Shared Book Title" year="2013" school="Tech University">
    <authors author="John Kappa"/>
  </entries>

  <!-- Two with same title "Shared Thesis Title" -> one in titledEntrySet, one out -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Shared Thesis Title" year="2012" school="Science University">
    <authors author="Laura Lambda"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport" id="techrep1" title="Shared Thesis Title" year="2011">
    <authors author="Mike Mu"/>
  </entries>

  <!-- Unique-title non-article entries -> in titledEntrySet and should trigger TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="incol1" title="Unique Collection Chapter" year="2009" publisher="Publisher B">
    <authors author="Nina Nu"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Conference Paper Title" year="2008" booktitle="Conf 2008">
    <authors author="Oscar Omicron"/>
    <authors author="Paul Pi"/>
  </entries>

  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conf 2008" year="2008"/>
  <entries xsi:type="BibTeX:Manual" id="manual1" title="Tool User Manual"/>
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft Paper" note="To appear">
    <authors author="Quinn Q"/>
  </entries>

</BibTeX:BibTeXFile>