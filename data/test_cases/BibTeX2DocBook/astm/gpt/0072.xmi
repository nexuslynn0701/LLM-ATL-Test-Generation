<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: combinations to trigger all 4 Article rules -->

  <!-- A1: unique title & unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Unique Title A1"
           year="2018"
           journal="Exclusive Journal 1">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- A2 & A3: same title, different journals ->
       A2 in titledSet & journalSet: Article_Title_NoJournal
       A3 not in titledSet & not in journalSet: Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Title X"
           year="2019"
           journal="Journal X1">
    <authors author="Carol Gamma"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Shared Title X"
           year="2020"
           journal="Journal X1">
    <authors author="Dave Delta"/>
  </entries>

  <!-- A4 & A5: different titles, same journal ->
       A4 in titledSet & journalSet: Article_Title_Journal
       A5 in titledSet but not in journalSet: Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Title in Journal Y - 1"
           year="2021"
           journal="Journal Y">
    <authors author="Eve Epsilon"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Title in Journal Y - 2"
           year="2022"
           journal="Journal Y">
    <authors author="Frank Phi"/>
  </entries>

  <!-- A6 & A7: same title and same journal ->
       A6 in titledSet & journalSet: Article_Title_Journal
       A7 not in either: Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Double Shared"
           year="2023"
           journal="Twin Journal">
    <authors author="Gina Gamma"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Double Shared"
           year="2024"
           journal="Twin Journal">
    <authors author="Henry Eta"/>
  </entries>

  <!-- Untitled entries (no TitledEntry supertype) -> UntitledEntry -->

  <entries xsi:type="BibTeX:Misc"
           id="M1"/>

  <entries xsi:type="BibTeX:Booklet"
           id="BKT1"
           year="2015"/>

  <!-- Titled, non-Article entries: combinations for TitledEntry rules -->

  <!-- B1 & B2: same title -> one in titledSet, one out
       B1: TitledEntry_Title_NoArticle, B2: TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Common Book Title"
           year="2010"
           publisher="Fictional Press">
    <authors author="Ian Iota"/>
  </entries>

  <entries xsi:type="BibTeX:Book"
           id="B2"
           title="Common Book Title"
           year="2011"
           publisher="Fictional Press 2">
    <authors author="Jane Jota"/>
  </entries>

  <!-- B3: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B3"
           title="Unique Book Title"
           year="2012"
           publisher="Solo Publisher">
    <authors author="Kyle Kappa"/>
  </entries>

  <!-- IB1 & IB2: InBook with same title & different chapter
       IB1: in titledSet -> TitledEntry_Title_NoArticle
       IB2: out of titledSet -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Chaptered Work"
           year="2013"
           publisher="Academic House"
           chapter="1">
    <authors author="Laura Lambda"/>
  </entries>

  <entries xsi:type="BibTeX:InBook"
           id="IB2"
           title="Chaptered Work"
           year="2014"
           publisher="Academic House"
           chapter="2">
    <authors author="Mike Mu"/>
  </entries>

  <!-- MT1 & MT2: MasterThesis with same title
       MT1: in titledSet -> TitledEntry_Title_NoArticle
       MT2: out of titledSet -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Thesis on Testing"
           year="2016"
           school="Tech University">
    <authors author="Nina Nu"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis"
           id="MT2"
           title="Thesis on Testing"
           year="2017"
           school="Tech University 2">
    <authors author="Oscar Omicron"/>
  </entries>

  <!-- PT1: PhDThesis with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PT1"
           title="Advanced Model Transformations"
           year="2011"
           school="Science Institute">
    <authors author="Pam Pi"/>
  </entries>

  <!-- IC1: InCollection with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Collected Models"
           year="2019"
           publisher="Collection Press"
           booktitle="Proceedings of MDE Studies">
    <authors author="Quinn Q"/>
  </entries>

  <!-- IP1: InProceedings with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Conference Paper on ATL"
           year="2020"
           booktitle="MDE Conference 2020">
    <authors author="Rita Rho"/>
  </entries>

  <!-- P1: Proceedings with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings"
           id="P1"
           title="MDE Conference 2020 Proceedings"
           year="2020"/>

  <!-- MAN1: Manual with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual"
           id="MAN1"
           title="ATL User Guide"/>

  <!-- U1 & U2: Unpublished with same title
       U1 in titledSet, U2 out -> both TitledEntry rules -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Draft on Transformations"
           note="Submitted">
    <authors author="Sara Sigma"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="U2"
           title="Draft on Transformations"
           note="Revised">
    <authors author="Tom Tau"/>
  </entries>

  <!-- TR1: TechReport with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Technical Report on MDE"
           year="2009">
    <authors author="Uma Upsilon"/>
  </entries>

</BibTeX:BibTeXFile>