<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: A1,A2 same title & journal -> Article_NoTitle_NoJournal;
       A3,A4 same title diff journal (A3 in title-set & journal-set, A4 only title-set) ->
       A3: Article_Title_Journal, A4: Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Shared Insights" year="2018" journal="Journal Group 1">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" title="Shared Insights" year="2019" journal="Journal Group 1">
    <authors author="Alice Alpha"/>
    <authors author="Carol Gamma"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" title="Unique Discovery" year="2020" journal="Distinct Journal">
    <authors author="David Delta"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" title="Unique Discovery" year="2021" journal="Journal Group 2">
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- Non-article titled entries for both TitledEntry_Title_NoArticle and TitledEntry_NoTitle_NoArticle -->
  <!-- B1 single title -> in title-set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Lone Book" year="2015" publisher="Solo Press">
    <authors author="Frank Phi"/>
  </entries>

  <!-- B2,B3 share title -> exactly one included in title-set (deterministically B2) -->
  <!-- B2: TitledEntry_Title_NoArticle; B3: TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="B2" title="Collected Works" year="2016" publisher="Anthology House">
    <authors author="Grace Gamma"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="B3" title="Collected Works" year="2017" school="Tech University">
    <authors author="Heidi Theta"/>
  </entries>

  <!-- PhDThesis single title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="P1" title="Deep Research" year="2014" school="Advanced Institute">
    <authors author="Ian Iota"/>
  </entries>

  <!-- InBook single title, exercises chapter attribute -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chaptered Knowledge" year="2013" publisher="Chapter Press" chapter="7">
    <authors author="Jane Jota"/>
  </entries>

  <!-- InProceedings single title & booktitle -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Conference Paper One" year="2012" booktitle="Conf A">
    <authors author="Karl Kappa"/>
  </entries>

  <!-- Proceedings single title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" title="Proceedings of Conf A" year="2012"/>

  <!-- Manual single title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="Tool Manual v1"/>

  <!-- Unpublished entries, same title but different notes -> title-set subset will contain only one of them -->
  <!-- U1: TitledEntry_Title_NoArticle; U2: TitledEntry_NoTitle_NoArticle (also uses note) -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Working Draft" note="Preliminary results">
    <authors author="Laura Lambda"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Working Draft" note="Revised version">
    <authors author="Laura Lambda"/>
    <authors author="Mike Mu"/>
  </entries>

  <!-- TechReport single title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Technical Overview" year="2011">
    <authors author="Nina Nu"/>
  </entries>

  <!-- Untitled entries (no TitledEntry): Misc and Booklet -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="X1"/>
  <entries xsi:type="BibTeX:Booklet" id="X2" year="2010"/>

</BibTeX:BibTeXFile>