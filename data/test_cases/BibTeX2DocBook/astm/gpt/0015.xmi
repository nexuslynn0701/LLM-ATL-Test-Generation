<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="art1"
           title="Unique Article One"
           year="2010"
           journal="Journal A">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- A2: shares title with A3 and journal with A4 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="art2"
           title="Shared Title X"
           year="2011"
           journal="Shared Journal Y">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- A3: shares title with A2, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="art3"
           title="Shared Title X"
           year="2012"
           journal="Journal B">
    <authors author="Dave Delta"/>
  </entries>

  <!-- A4: unique title, shares journal with A2 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="art4"
           title="Unique Article Two"
           year="2013"
           journal="Shared Journal Y">
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- A5: another unique article to add more authors -->
  <entries xsi:type="BibTeX:Article"
           id="art5"
           title="Distinct Article Three"
           year="2014"
           journal="Journal C">
    <authors author="Frank Phi"/>
    <authors author="Grace Gamma"/>
  </entries>

  <!-- B1: Book with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="book1"
           title="Unique Book One"
           year="2005"
           publisher="Publisher P">
    <authors author="Helen Eta"/>
  </entries>

  <!-- B2: Book sharing title with B3 -> first occurrence in title-set -->
  <entries xsi:type="BibTeX:Book"
           id="book2"
           title="Shared Book Title"
           year="2006"
           publisher="Publisher Q">
    <authors author="Ian Iota"/>
  </entries>

  <!-- B3: Book sharing title with B2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="book3"
           title="Shared Book Title"
           year="2007"
           publisher="Publisher R">
    <authors author="Jane Kappa"/>
  </entries>

  <!-- T1: PhDThesis with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd1"
           title="PhD Thesis Title"
           year="2015"
           school="Tech University">
    <authors author="Liam Lambda"/>
  </entries>

  <!-- T2: MasterThesis sharing title with T3 -> first occurrence in title-set -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc1"
           title="Thesis Shared Title"
           year="2016"
           school="Science University">
    <authors author="Mia Mu"/>
  </entries>

  <!-- T3: PhDThesis sharing title with T2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd2"
           title="Thesis Shared Title"
           year="2017"
           school="Engineering Institute">
    <authors author="Noah Nu"/>
  </entries>

  <!-- IB1: InBook unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook1"
           title="InBook Unique"
           year="2001"
           publisher="Publisher S"
           chapter="3">
    <authors author="Olivia Omicron"/>
  </entries>

  <!-- IC1: InCollection shares title with IC2 -> first occurrence in title-set -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol1"
           title="Collection Shared Title"
           year="2002"
           publisher="Publisher T">
    <authors author="Peter Pi"/>
  </entries>

  <!-- IC2: InCollection shares title with IC1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol2"
           title="Collection Shared Title"
           year="2003"
           publisher="Publisher U">
    <authors author="Quinn Rho"/>
  </entries>

  <!-- IP1: InProceedings with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc1"
           title="InProceedings Unique"
           year="2008"
           booktitle="Conference One">
    <authors author="Sara Sigma"/>
  </entries>

  <!-- MISC1: Misc (untitled entry) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="misc1"/>
  
  <!-- BKT1: Booklet (untitled entry) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet1"
           year="1999"/>

  <!-- MAN1: Manual unique title -> TitledEntry_Title_NoArticle (no authors) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual1"
           title="Manual Unique Title"/>

  <!-- UNP1: Unpublished unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub1"
           title="Unpublished Findings"
           note="To appear soon">
    <authors author="Tom Tau"/>
  </entries>

  <!-- UNP2: Unpublished shares title with UNP3 -> first occurrence in title-set -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub2"
           title="Working Draft Shared"
           note="First version">
    <authors author="Uma Upsilon"/>
  </entries>

  <!-- UNP3: Unpublished shares title with UNP2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub3"
           title="Working Draft Shared"
           note="Revised version">
    <authors author="Victor V"/>
  </entries>

</BibTeX:BibTeXFile>