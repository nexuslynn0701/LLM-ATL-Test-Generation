    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article group A: same title, same journal (tests Article_NoTitle_NoJournal; only first in each set is kept in title/journal sets) -->
  <entries xsi:type="BibTeX:Article" id="artA1" title="Shared Insights" year="2018" journal="Journal of Testing">
    <authors author="Alice Smith"/>
