<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles designed to trigger all four Article rules (R6–R9) -->
  <!-- A1 & A2: same title, same journal -> A1: Article_Title_Journal, A2: Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Common Title A" year="2018" journal="Journal Alpha">
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" title="Common Title A" year="2019" journal="Journal Alpha">
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A3 & A4: same title, different journals -> A3: Article_Title_Journal, A4: Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Common Title B" year="2020" journal="Journal Beta">
    <authors author="Charlie Brown"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" title="Common Title B" year="2021" journal="Journal Gamma">
    <authors author="David Clark"/>
  </entries>

  <!-- A5 & A6: different titles, same journal -> A5: Article_Title_Journal, A6: Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Unique Title C1" year="2017" journal="Journal Delta">
    <authors author="Eve Miller"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" title="Unique Title C2" year="2016" journal="Journal Delta">
    <authors author="Frank Harris"/>
  </entries>

  <!-- A7: fully unique article -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A7" title="Isolated Article" year="2015" journal="Journal Epsilon">
    <authors author="Grace Lee"/>
  </entries>

  <!-- Untitled entries (not TitledEntry): trigger R3 (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Booklet" id="BKL1" year="2013"/>

  <!-- Non-article titled entries with unique titles: trigger R4 -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Unique Book Title" year="2010" publisher="Springer">
    <authors author="Helen King"/>
    <authors author="Ian Moore"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Unique InBook Title" year="2011" publisher="ACM Press" chapter="3">
    <authors author="John Nash"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Unique InCollection Title" year="2012" publisher="Oxford Press" booktitle="Collected Works in CS">
    <authors author="Karen Page"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Unique InProceedings Title" year="2014" booktitle="Proc. of MDE Conf.">
    <authors author="Luke Quinn"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="P1" title="Proceedings on Software Engineering" year="2008"/>
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="User Guide for Tool X"/>
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Unique Tech Report" year="2009">
    <authors author="Mary Reed"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Mastering Model Transformations" year="2018" school="Tech University">
    <authors author="Nick Stone"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Advanced Topics in MDE" year="2017" school="Science Institute">
    <authors author="Olivia Young"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Working Draft on DSLs" note="Draft version, not for citation">
    <authors author="Peter Zimmer"/>
  </entries>

  <!-- Non-article titled entries with duplicate titles: trigger R5 on non-representatives -->
  <!-- Pair with title 'Shared Title 1' -->
  <entries xsi:type="BibTeX:Book" id="B2" title="Shared Title 1" year="2016" publisher="Elsevier">
    <authors author="Quentin Ray"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="B3" title="Shared Title 1" year="2019" publisher="Elsevier">
    <authors author="Rachel Green"/>
  </entries>

  <!-- Pair with title 'Shared Title 2' -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" title="Shared Title 2" year="2011">
    <authors author="Steve Adams"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR3" title="Shared Title 2" year="2012">
    <authors author="Tom Baker"/>
  </entries>

</BibTeX:BibTeXFile>