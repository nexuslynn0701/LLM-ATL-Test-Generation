<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise Article_* rules and journal/title uniqueness logic -->
  <!-- A1 & A2: same title and same journal -> first in title set & journal set, second in neither
       A1 -> Article_Title_Journal, A2 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Shared Insights"
           year="2018"
           journal="Journal of Testing">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Insights"
           year="2019"
           journal="Journal of Testing">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- A3: unique title, journal duplicated later (JX) -> in title set, not in journal set
       -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Unique Title A3"
           year="2020"
           journal="JX Journal">
    <authors author="Dave Delta"/>
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- A4: unique title, journal JX already taken by A3 for articleSet
       -> not in journal set, but in title set -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Another Unique A4"
           year="2021"
           journal="JX Journal">
    <authors author="Frank Phi"/>
  </entries>

  <!-- A5: unique title and unique journal -> in both sets -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Standalone Study"
           year="2022"
           journal="Independent Journal">
    <authors author="Grace Gamma"/>
    <authors author="Henry Eta"/>
  </entries>

  <!-- Untitled entries to exercise UntitledEntry (Misc, Booklet) -->

  <!-- M1: Misc, untitled, unauthored, undated -->
  <entries xsi:type="BibTeX:Misc"
           id="M1"/>
  <!-- M2: Misc, with authors and year to test optional parts in string building -->
  <entries xsi:type="BibTeX:Misc"
           id="M2">
    <authors author="Isabel Iota"/>
    <authors author="John Kappa"/>
  </entries>

  <!-- Bk1: Booklet, has year (DatedEntry) -->
  <entries xsi:type="BibTeX:Booklet"
           id="Bk1"
           year="2015"/>

  <!-- Titled non-Article entries to exercise TitledEntry_*_NoArticle rules -->

  <!-- MT1 & MT2: MasterThesis, same title and same school.
       MT1 appears in titledEntrySet -> TitledEntry_Title_NoArticle
       MT2 does not -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Thesis on Testing"
           year="2014"
           school="Test University">
    <authors author="Laura Lambda"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis"
           id="MT2"
           title="Thesis on Testing"
           year="2016"
           school="Test University">
    <authors author="Mike Mu"/>
  </entries>

  <!-- PT1: PhDThesis with unique title -> in titledEntrySet -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PT1"
           title="Advanced Model Transformations"
           year="2013"
           school="Metamodel Institute">
    <authors author="Nina Nu"/>
    <authors author="Oscar Omicron"/>
  </entries>

  <!-- BK1 & BK2: Books with same title but different publisher
       BK1 in titledEntrySet -> TitledEntry_Title_NoArticle
       BK2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="BK1"
           title="Foundations of MDE"
           year="2010"
           publisher="First Publisher">
    <authors author="Paul Pi"/>
  </entries>

  <entries xsi:type="BibTeX:Book"
           id="BK2"
           title="Foundations of MDE"
           year="2011"
           publisher="Second Publisher">
    <authors author="Quentin Qoppa"/>
  </entries>

  <!-- IB1: InBook with unique title to also exercise InBook-specific chapter attribute -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Chaptered MDE"
           year="2012"
           publisher="Chapter House"
           chapter="3">
    <authors author="Rachel Rho"/>
  </entries>

  <!-- IC1: InCollection, shares title with IC2; IC1 gets into titledEntrySet -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Collected Works on Testing"
           year="2009"
           publisher="Collective Press"
           booktitle="Testing Anthology Vol. 1">
    <authors author="Steve Sigma"/>
  </entries>

  <!-- IC2: same title as IC1, different year -> not in titledEntrySet -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC2"
           title="Collected Works on Testing"
           year="2011"
           publisher="Collective Press"
           booktitle="Testing Anthology Vol. 2">
    <authors author="Trudy Tau"/>
  </entries>

  <!-- IP1: InProceedings with unique title and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Proceedings Paper One"
           year="2017"
           booktitle="MDE Conference"
           >
    <authors author="Uma Upsilon"/>
  </entries>

  <!-- P1 & P2: Proceedings with same title
       P1 -> TitledEntry_Title_NoArticle, P2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings"
           id="P1"
           title="MDE Conference"
           year="2017"/>
  <entries xsi:type="BibTeX:Proceedings"
           id="P2"
           title="MDE Conference"
           year="2018"/>

  <!-- MAN1: Manual with unique title -->
  <entries xsi:type="BibTeX:Manual"
           id="MAN1"
           title="User Guide for Transformation Tool"/>

  <!-- U1 & U2: Unpublished entries with same title
       U1 -> TitledEntry_Title_NoArticle (also uses note)
       U2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Draft on Traceability"
           note="Under review">
    <authors author="Victor V"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="U2"
           title="Draft on Traceability"
           note="Work in progress">
    <authors author="Wendy W"/>
  </entries>

  <!-- TR1: TechReport with unique title -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Model Transformation Test Report"
           year="2023">
    <authors author="Xavier Xi"/>
    <authors author="Yara Y"/>
  </entries>

</BibTeX:BibTeXFile>