<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise all Article* rules -->

  <!-- A1: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Unique Insights into Modeling"
           year="2018"
           journal="Journal of Unique Studies">
    <authors author="Alice Unique"/>
    <authors author="Bob Solo"/>
  </entries>

  <!-- A2 & A3: same title, same journal -> A2 Article_Title_Journal, A3 Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Title in Same Journal"
           year="2019"
           journal="Journal of Repeated Patterns">
    <authors author="Carol Repeat"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Shared Title in Same Journal"
           year="2020"
           journal="Journal of Repeated Patterns">
    <authors author="Dave Duplicate"/>
  </entries>

  <!-- A4 & A5: same title, different journals 
       -> one Article_Title_Journal (A4), one Article_NoTitle_Journal (A5) -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Common Title Across Journals"
           year="2017"
           journal="First Modeling Journal">
    <authors author="Eve Cross"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Common Title Across Journals"
           year="2017"
           journal="Second Modeling Journal">
    <authors author="Frank Variant"/>
  </entries>

  <!-- A6 & A7: different titles, same journal 
       -> A6 Article_Title_Journal, A7 Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="First Study in Same Venue"
           year="2016"
           journal="Venue of Multiple Articles">
    <authors author="Grace Venue"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Second Study in Same Venue"
           year="2016"
           journal="Venue of Multiple Articles">
    <authors author="Heidi Venue"/>
  </entries>

  <!-- Non-Article titled entries to exercise TitledEntry* rules -->

  <!-- B1 & B2: same title Book -> B1 in title set, B2 out -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Model-Driven Design Patterns"
           year="2015"
           publisher="Pattern Press">
    <authors author="Ivan Author"/>
    <authors author="Judy Coauthor"/>
  </entries>

  <entries xsi:type="BibTeX:Book"
           id="B2"
           title="Model-Driven Design Patterns"
           year="2016"
           publisher="Refined Pattern Press">
    <authors author="Ivan Author"/>
  </entries>

  <!-- B3: unique title Book -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B3"
           title="Isolated Modeling Handbook"
           year="2014"
           publisher="Handbook House">
    <authors author="Karen Single"/>
  </entries>

  <!-- IB1 & IB2: InBook with same title; IB1 in set, IB2 out -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Advanced Chapters in MDE"
           year="2013"
           publisher="Chapter Publishing"
           chapter="1">
    <authors author="Leo Chapter"/>
  </entries>

  <entries xsi:type="BibTeX:InBook"
           id="IB2"
           title="Advanced Chapters in MDE"
           year="2013"
           publisher="Chapter Publishing"
           chapter="2">
    <authors author="Mike Chapter"/>
  </entries>

  <!-- IC1: InCollection unique title -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Collected Works on Transformations"
           year="2012"
           publisher="Collection Press">
    <authors author="Nina Collector"/>
  </entries>

  <!-- IP1 & IP2: InProceedings sharing same title & booktitle; IP1 in set, IP2 out -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Symposium on Models"
           year="2011"
           booktitle="Proceedings of the Modeling Symposium">
    <authors author="Oscar Speaker"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings"
           id="IP2"
           title="Symposium on Models"
           year="2011"
           booktitle="Proceedings of the Modeling Symposium">
    <authors author="Pamela Speaker"/>
  </entries>

  <!-- P1: Proceedings with unique title -->
  <entries xsi:type="BibTeX:Proceedings"
           id="P1"
           title="Proceedings of Unique Conference"
           year="2010">
  </entries>

  <!-- M1: Manual with unique title -->
  <entries xsi:type="BibTeX:Manual"
           id="M1"
           title="Tool User Guide">
  </entries>

  <!-- U1 & U2: Unpublished with same title, U1 in set, U2 out -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Working Draft on Testing"
           note="Initial draft version">
    <authors author="Quentin Draft"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="U2"
           title="Working Draft on Testing"
           note="Revised draft version">
    <authors author="Rachel Draft"/>
  </entries>

  <!-- TR1: TechReport unique title -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Comprehensive Report on Transformations"
           year="2009">
    <authors author="Sam Reporter"/>
  </entries>

  <!-- Thesis entries -->

  <!-- PHD1 & PHD2: same title PhDThesis; PHD1 in set, PHD2 out -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Formal Approaches to MDE"
           year="2008"
           school="Tech University">
    <authors author="Tom Doctoral"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD2"
           title="Formal Approaches to MDE"
           year="2008"
           school="Science Institute">
    <authors author="Uma Doctoral"/>
  </entries>

  <!-- MT1: MasterThesis unique title -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Empirical Study of Model Testing"
           year="2007"
           school="Engineering College">
    <authors author="Victor Master"/>
  </entries>

  <!-- Untitled entries (non-TitledEntry) to trigger UntitledEntry -->

  <!-- BO1: Booklet (DatedEntry only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="BO1"
           year="2006">
  </entries>

  <!-- MS1: Misc (no extra attributes) -->
  <entries xsi:type="BibTeX:Misc"
           id="MS1">
  </entries>

</BibTeX:BibTeXFile>