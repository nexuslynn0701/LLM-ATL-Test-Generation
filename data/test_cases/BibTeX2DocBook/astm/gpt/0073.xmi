<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for rule R3: UntitledEntry). Also contribute authors and ids -->
  <entries xsi:type="BibTeX:Misc" id="miscRef1"/>
  <entries xsi:type="BibTeX:Booklet" id="bookletRef1" year="2005"/>

  <!-- TechReports with duplicate title (exercise R4 and R5 for TechReport) -->
  <!-- First occurrence of 'A Study on Testing' -> in unique title set (R4) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="A Study on Testing" year="2010">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- Second occurrence with same title 'A Study on Testing' -> not in unique title set (R5) -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="A Study on Testing" year="2011">
    <authors author="Charlie Brown"/>
  </entries>

  <!-- Manual with unique title (R4) -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="Tool User Guide"/>

  <!-- Proceedings and InProceedings (R4 via TitledEntry, plus BookTitledEntry usage) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="ICSE Conference" year="2018"/>
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="MDE in Practice" year="2018" booktitle="ICSE Conference">
    <authors author="Diana Prince"/>
    <authors author="Edward Nigma"/>
  </entries>

  <!-- Book, InBook, InCollection (R4; InBook also exercises chapter; InCollection uses BookTitledEntry) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Model-Driven Engineering" year="2015" publisher="TechBooks Press">
    <authors author="Frank Castle"/>
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Validation Techniques" year="2015" publisher="TechBooks Press" chapter="7">
    <authors author="George Miller"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="incol1" title="Testing Transformations" year="2016" publisher="TechBooks Press" booktitle="Advances in MDE">
    <authors author="Helen Troy"/>
  </entries>

  <!-- MasterThesis and PhDThesis, with duplicate thesis title (R4/R5 + ThesisEntry + DatedEntry) -->
  <!-- First 'Model Transformation Testing' -> R4 -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" title="Model Transformation Testing" year="2012" school="State University">
    <authors author="Ian Malcolm"/>
  </entries>
  <!-- Second with same title 'Model Transformation Testing' -> R5 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Model Transformation Testing" year="2014" school="Tech University">
    <authors author="Jane Doe"/>
  </entries>

  <!-- Unpublished with unique title (R4; also exercises Unpublished.note) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft on ATL Semantics" note="To appear">
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Articles arranged to trigger all four article rules R6–R9 -->

  <!-- Group A: Article_Title_Journal (unique title and unique journal) -> R6 -->
  <entries xsi:type="BibTeX:Article" id="artA1" title="Unique Article" year="2020" journal="Journal A">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Group B: Article_NoTitle_Journal (duplicate title, unique journals) -> R7 -->
  <!-- First occurrence of title 'Shared Title B' is selected for title set (R6-like title condition),
       second is excluded and must satisfy R7 -->
  <entries xsi:type="BibTeX:Article" id="artB1" title="Shared Title B" year="2021" journal="Journal B1">
    <authors author="Charlie Brown"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artB2" title="Shared Title B" year="2022" journal="Journal B2">
    <authors author="Diana Prince"/>
  </entries>

  <!-- Group C: Article_Title_NoJournal (unique titles, duplicate journal) -> R8 -->
  <!-- First occurrence of journal 'Journal C' chosen for articleSet; second excluded -> R8 -->
  <entries xsi:type="BibTeX:Article" id="artC1" title="Title C1" year="2019" journal="Journal C">
    <authors author="Edward Nigma"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artC2" title="Title C2" year="2019" journal="Journal C">
    <authors author="Frank Castle"/>
  </entries>

  <!-- Group D: Article_NoTitle_NoJournal (duplicate title AND duplicate journal) -> R9 -->
  <!-- First occurrence of 'Shared Title D' in 'Journal D' goes into both unique title and article sets (R6),
       second is excluded from both and must satisfy R9 -->
  <entries xsi:type="BibTeX:Article" id="artD1" title="Shared Title D" year="2017" journal="Journal D">
    <authors author="George Miller"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artD2" title="Shared Title D" year="2018" journal="Journal D">
    <authors author="Helen Troy"/>
  </entries>

</BibTeX:BibTeXFile>