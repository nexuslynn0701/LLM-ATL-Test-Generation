<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Two Articles with same title and same journal (one chosen as representative for both title and journal) -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Common Ground" year="2018" journal="Journal Alpha">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="A2" title="Common Ground" year="2019" journal="Journal Alpha">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Two Articles with same title but different journals -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Parallel Worlds" year="2020" journal="Journal Beta">
    <authors author="Carol White"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="A4" title="Parallel Worlds" year="2021" journal="Journal Gamma">
    <authors author="David Black"/>
  </entries>

  <!-- Two Articles with different titles but same journal -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Unique Path" year="2017" journal="Journal Delta">
    <authors author="Eve Brown"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="A6" title="Hidden Path" year="2016" journal="Journal Delta">
    <authors author="Frank Green"/>
  </entries>

  <!-- A single Article (unique title and journal) -->
  <entries xsi:type="BibTeX:Article" id="A7" title="Solo Study" year="2015" journal="Journal Epsilon">
    <authors author="Grace Hill"/>
  </entries>

  <!-- Two Books with the same title to trigger TitledEntry_NoTitle_NoArticle for one of them -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Design Patterns" year="1994" publisher="TechPress">
    <authors author="Erich Gamma"/>
  </entries>

  <entries xsi:type="BibTeX:Book" id="B2" title="Design Patterns" year="2000" publisher="NextGen Press">
    <authors author="John Doe"/>
  </entries>

  <!-- One unique-title Book to trigger TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B3" title="Software Architecture" year="2003" publisher="ArchPub">
    <authors author="Mary Johnson"/>
  </entries>

  <!-- Two PhDThesis with same title to exercise Title_No / NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Model Transformations" year="2010" school="Uni One">
    <authors author="Nina Orange"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis" id="PHD2" title="Model Transformations" year="2011" school="Uni Two">
    <authors author="Oscar Pink"/>
  </entries>

  <!-- One unique-title MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis" id="M1" title="Testing Transformations" year="2012" school="Uni Three">
    <authors author="Paul Gray"/>
  </entries>

  <!-- InBook with unique title (also Book subclass for attribute combinations) -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chaptered Work" year="2008" publisher="ChapterHouse" chapter="5">
    <authors author="Quinn Violet"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) with unique title and booktitle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Collected Insight" year="2013" publisher="CollectionPub" booktitle="Advances in MDE">
    <authors author="Rachel Silver"/>
  </entries>

  <!-- InProceedings (Proceedings + Authored + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Conference Paper" year="2014" booktitle="ICMT 2014">
    <authors author="Tom Indigo"/>
  </entries>

  <!-- Proceedings with unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" title="ICMT 2014" year="2014"/>

  <!-- Manual with unique title -->
  <entries xsi:type="BibTeX:Manual" id="MN1" title="Tool Manual"/>

  <!-- TechReport with unique title -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Annual Report" year="2019">
    <authors author="Uma Cyan"/>
  </entries>

  <!-- Two Unpublished with same title to trigger one Title_No and one NoTitle_NoArticle, and Unpublished-specific note -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Draft Notes" note="To appear">
    <authors author="Victor Lime"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Draft Notes" note="Internal circulation">
    <authors author="Wendy Navy"/>
  </entries>

  <!-- Booklet (DatedEntry only, no title) to exercise UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="2005"/>

  <!-- Misc (bare BibTeXEntry) to exercise UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MS1"/>

</BibTeX:BibTeXFile>