<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article group A: unique title, unique journal (R6) -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Alpha Study" year="2015" journal="Journal A">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article group B: duplicate title, same journal (R9) -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Duplicate Title 1" year="2016" journal="Journal B">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a3" title="Duplicate Title 1" year="2017" journal="Journal B">
    <authors author="Dave Black"/>
  </entries>

  <!-- Article group C: duplicate title, different journals (R7) -->
  <entries xsi:type="BibTeX:Article" id="a4" title="Shared Title 2" year="2018" journal="Journal C">
    <authors author="Eve Green"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a5" title="Shared Title 2" year="2019" journal="Journal D">
    <authors author="Frank Brown"/>
  </entries>

  <!-- Article group D: distinct titles, same journal (R8) -->
  <entries xsi:type="BibTeX:Article" id="a6" title="Unique in Journal E 1" year="2020" journal="Journal E">
    <authors author="Grace Kelly"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a7" title="Unique in Journal E 2" year="2021" journal="Journal E">
    <authors author="Henry Ford"/>
  </entries>

  <!-- Untitled entries (R3) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Booklet" id="b1" year="2010"/>

  <!-- Titled non-article entries with distinct titles (R4) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Mastering MDE" year="2012" school="Tech University">
    <authors author="Ivy Young"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Transformations" year="2013" school="Science Institute">
    <authors author="John Doe"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="bk1" title="Model Engineering Handbook" year="2011" publisher="ModelPress">
    <authors author="Alice Smith"/>
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="ib1" title="MDE Chapter" year="2014" publisher="TechBooks" chapter="3">
    <authors author="Bob Jones"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Collected Works on MDE" year="2016" publisher="CollectionsPub">
    <authors author="Dave Black"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Proceeding Paper 1" year="2017" booktitle="MDE Conf 2017">
    <authors author="Eve Green"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="pr1" title="MDE Conf 2017" year="2017"/>
  <entries xsi:type="BibTeX:Manual" id="man1" title="MDE Tool Manual"/>
  <entries xsi:type="BibTeX:Unpublished" id="un1" title="Unreleased Draft" note="To appear soon">
    <authors author="Frank Brown"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="MDE Technical Report" year="2018">
    <authors author="Grace Kelly"/>
  </entries>

  <!-- Titled non-article entries with duplicate title (R4 + R5) -->
  <entries xsi:type="BibTeX:Book" id="bk2" title="Shared Book Title" year="2019" publisher="SharedPub">
    <authors author="Henry Ford"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="ib2" title="Shared Book Title" year="2020" publisher="SharedPub" chapter="5">
    <authors author="John Doe"/>
  </entries>

</BibTeX:BibTeXFile>