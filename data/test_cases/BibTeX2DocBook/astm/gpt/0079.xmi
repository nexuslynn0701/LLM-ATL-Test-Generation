<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for R3: Misc, Booklet) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Booklet" id="bkt1" year="2018"/>

  <!-- Articles: sets to exercise all Article* rules (R6–R9) -->
  <!-- Unique title & unique journal -> R6 Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Unique Title" year="2020" journal="Unique Journal">
    <authors author="Alice Unique"/>
  </entries>

  <!-- Same title as a3 (duplicate title group) but journal alone -> R7 Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Shared Title" year="2019" journal="Journal One">
    <authors author="Bob Shared"/>
  </entries>

  <!-- Representative for title 'Shared Title' and journal 'Journal Two' -> R6 Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a3" title="Shared Title" year="2019" journal="Journal Two">
    <authors author="Carol Shared"/>
  </entries>

  <!-- Same journal as a5 (duplicate journal group) but unique title -> R8 Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a4" title="Journal Group Title" year="2021" journal="Journal Three">
    <authors author="Dave Journal"/>
  </entries>

  <!-- Second article in Journal Three, different title -> R9 Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a5" title="Another Journal Group Title" year="2021" journal="Journal Three">
    <authors author="Eve Journal"/>
  </entries>

  <!-- Non-article titled entries with unique titles -> R4 TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="Model Driven Book" year="2015" publisher="MDE Press">
    <authors author="Frank Book"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Mastering Transformations" year="2016" school="Tech University">
    <authors author="Grace Master"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced ATL Techniques" year="2014" school="Science Institute">
    <authors author="Heidi Doctor"/>
  </entries>

  <entries xsi:type="BibTeX:InBook" id="ib1" title="Chapter on Testing" year="2017" publisher="Quality Books" chapter="4">
    <authors author="Ivan Chapter"/>
  </entries>

  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Collected Studies in MDE" year="2013" publisher="Collections House">
    <authors author="Judy Collection"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Proceedings Paper One" year="2011" booktitle="MDEConf 2011">
    <authors author="Karl Conf"/>
  </entries>

  <entries xsi:type="BibTeX:Proceedings" id="pr1" title="MDEConf 2011 Proceedings" year="2011"/>
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL User Guide"/>
  <entries xsi:type="BibTeX:Unpublished" id="un1" title="Unreleased Draft on MDE" note="To appear">
    <authors author="Laura Unpub"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="MDE Technical Report" year="2010">
    <authors author="Mallory Report"/>
  </entries>

  <!-- Non-article titled entries sharing a title to trigger R5 TitledEntry_NoTitle_NoArticle -->
  <!-- First occurrence chosen into the unique-title set -> R4 -->
  <entries xsi:type="BibTeX:Book" id="bk2" title="Duplicate Title Book" year="2012" publisher="Duplicate Press">
    <authors author="Nina Duplicate"/>
  </entries>

  <!-- Second with same title, excluded from title set -> R5 -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt2" title="Duplicate Title Book" year="2013" school="Duplicate University">
    <authors author="Oscar Duplicate"/>
  </entries>

</BibTeX:BibTeXFile>