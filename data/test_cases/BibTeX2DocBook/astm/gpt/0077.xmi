<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to trigger all four Article_* rules -->
  <!-- A1 & A2: same journal, distinct titles -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Alpha Research" year="2018" journal="Journal J">
    <authors author="John Alpha"/>
    <authors author="Mary Shared"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" title="Beta Study" year="2019" journal="Journal J">
    <authors author="John Alpha"/>
  </entries>

  <!-- A3 & A4: same title, distinct journals -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Gamma Insights" year="2020" journal="Journal K">
    <authors author="Carol Gamma"/>
    <authors author="Mary Shared"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" title="Gamma Insights" year="2021" journal="Journal L">
    <authors author="Dave Delta"/>
  </entries>

  <!-- A5 & A6: same title and same journal -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Delta Analysis" year="2022" journal="Journal M">
    <authors author="Eve Epsilon"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" title="Delta Analysis" year="2023" journal="Journal M">
    <authors author="Frank Zeta"/>
  </entries>

  <!-- A7: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A7" title="Unique Article" year="2017" journal="Unique Journal">
    <authors author="Gina Eta"/>
  </entries>

  <!-- Titled non-article entries to trigger both TitledEntry_* rules -->
  <!-- B1: unique title (no other TitledEntry with this title) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Unique Book" year="2010" publisher="Unique Publisher">
    <authors author="Henry Bookman"/>
  </entries>

  <!-- Th1 & Th2: same title (one kept in title-set, one not) -->
  <!-- Th1 -> TitledEntry_Title_NoArticle, Th2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="Th1" title="Duplicated Thesis" year="2015" school="Tech University">
    <authors author="Irene Thesis"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="Th2" title="Duplicated Thesis" year="2016" school="Science University">
    <authors author="Jack Doctor"/>
  </entries>

  <!-- InBook & InCollection sharing same title as B1 to create extra duplicates -->
  <!-- Only one of them and B1 will be in the title-set; the others trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Unique Book" year="2011" publisher="Composite Publisher" chapter="3">
    <authors author="Karen Chapter"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Unique Book" year="2012" publisher="Composite Publisher">
    <authors author="Larry Collection"/>
  </entries>

  <!-- Untitled entries (no TitledEntry supertype) to trigger UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="2005"/>

</BibTeX:BibTeXFile>