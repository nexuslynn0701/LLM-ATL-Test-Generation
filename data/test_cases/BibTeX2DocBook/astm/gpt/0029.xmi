<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="a1"
           title="Unique Article One"
           year="2018"
           journal="Journal Alpha">
    <authors author="Alice A."/>
  </entries>

  <!-- A2 & A3: same title, journal unique per article -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="a2"
           title="Shared Title A"
           year="2019"
           journal="Journal Beta">
    <authors author="Bob B."/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="a3"
           title="Shared Title A"
           year="2020"
           journal="Journal Gamma">
    <authors author="Carol C."/>
  </entries>

  <!-- A4 & A5: different titles, same journal -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="a4"
           title="Alpha in Delta"
           year="2021"
           journal="Journal Delta">
    <authors author="David D."/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="a5"
           title="Beta in Delta"
           year="2022"
           journal="Journal Delta">
    <authors author="Eve E."/>
  </entries>

  <!-- A6 & A7: same title and same journal -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="a6"
           title="Duplicated Full"
           year="2017"
           journal="Journal Zeta">
    <authors author="Frank F."/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="a7"
           title="Duplicated Full"
           year="2017"
           journal="Journal Zeta">
    <authors author="Grace G."/>
  </entries>

  <!-- B1: Book with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="b1"
           title="Unique Book Title"
           year="2015"
           publisher="Publisher One">
    <authors author="Henry H."/>
    <authors author="Ivy I."/>
  </entries>

  <!-- B2 & B3: Books with same title -> first in set, second not in set -->
  <!-- B2 will trigger TitledEntry_Title_NoArticle, B3 will trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="b2"
           title="Repeated Book Title"
           year="2016"
           publisher="Publisher Two">
    <authors author="Jack J."/>
  </entries>

  <entries xsi:type="BibTeX:Book"
           id="b3"
           title="Repeated Book Title"
           year="2018"
           publisher="Publisher Three">
    <authors author="Kate K."/>
  </entries>

  <!-- T1 & T2: MasterThesis with same title -> Title/NoTitle pair -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="t1"
           title="Thesis on Testing"
           year="2013"
           school="Tech University">
    <authors author="Liam L."/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis"
           id="t2"
           title="Thesis on Testing"
           year="2014"
           school="Science College">
    <authors author="Mia M."/>
  </entries>

  <!-- P1: PhDThesis, unique title -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="p1"
           title="Advanced Model Transformations"
           year="2012"
           school="Engineering Institute">
    <authors author="Noah N."/>
  </entries>

  <!-- IB1 & IB2: InBook, one unique title, one duplicate with B1 -->
  <!-- IB1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook"
           id="ib1"
           title="Chapter on Metamodeling"
           year="2011"
           publisher="Publisher Four"
           chapter="5">
    <authors author="Olivia O."/>
  </entries>

  <!-- IB2: same title as B1 ("Unique Book Title") -> NoTitle rule -->
  <entries xsi:type="BibTeX:InBook"
           id="ib2"
           title="Unique Book Title"
           year="2010"
           publisher="Publisher Five"
           chapter="2">
    <authors author="Peter P."/>
  </entries>

  <!-- IC1 & IC2: InCollection sharing a title -->
  <entries xsi:type="BibTeX:InCollection"
           id="ic1"
           title="Collected Models"
           year="2019"
           publisher="Collection House"
           booktitle="Proceedings of Modeling">
    <authors author="Quinn Q."/>
  </entries>

  <entries xsi:type="BibTeX:InCollection"
           id="ic2"
           title="Collected Models"
           year="2020"
           publisher="Collection House"
           booktitle="Yearbook of Modeling">
    <authors author="Rita R."/>
  </entries>

  <!-- IP1: InProceedings, unique title -->
  <entries xsi:type="BibTeX:InProceedings"
           id="ip1"
           title="Proceedings Paper One"
           year="2018"
           booktitle="Conference MDE 2018">
    <authors author="Sam S."/>
  </entries>

  <!-- PR1 & PR2: Proceedings sharing a title -->
  <entries xsi:type="BibTeX:Proceedings"
           id="pr1"
           title="Symposium on Modeling"
           year="2017"/>
  <entries xsi:type="BibTeX:Proceedings"
           id="pr2"
           title="Symposium on Modeling"
           year="2019"/>

  <!-- M1 & M2: Manual entries, one unique, one duplicate -->
  <entries xsi:type="BibTeX:Manual"
           id="m1"
           title="Tool Manual A"/>
  <entries xsi:type="BibTeX:Manual"
           id="m2"
           title="Tool Manual A"/>

  <!-- U1 & U2: Unpublished with same title but different note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="u1"
           title="Draft on MDE"
           note="First version">
    <authors author="Tom T."/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="u2"
           title="Draft on MDE"
           note="Revised version">
    <authors author="Uma U."/>
  </entries>

  <!-- TR1: TechReport with unique title -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr1"
           title="Report on Transformations"
           year="2016">
    <authors author="Victor V."/>
  </entries>

  <!-- TR2 & TR3: TechReport sharing a title -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr2"
           title="Annual Transformation Report"
           year="2017">
    <authors author="Wendy W."/>
  </entries>

  <entries xsi:type="BibTeX:TechReport"
           id="tr3"
           title="Annual Transformation Report"
           year="2018">
    <authors author="Xander X."/>
  </entries>

  <!-- BO1: Booklet (no title) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet"
           id="bo1"
           year="2010"/>

  <!-- MS1: Misc (no title) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="ms1"/>

</BibTeX:BibTeXFile>