<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to cover all Article_* rules -->
  <!-- A1 & A2: same title, different journals -> one in Article_NoTitle_Journal, one in Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Common Title A" year="2018" journal="Journal Alpha">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art2" title="Common Title A" year="2019" journal="Journal Beta">
    <authors author="Alice Smith"/>
  </entries>

  <!-- A3 & A4: different titles, same journal -> one in Article_Title_NoJournal, one in Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Unique Title B" year="2020" journal="Journal Gamma">
    <authors author="Carol White"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art4" title="Unique Title C" year="2021" journal="Journal Gamma">
    <authors author="David Black"/>
    <authors author="Eve Green"/>
  </entries>

  <!-- A5 & A6: same title and same journal -> Article_NoTitle_NoJournal and Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art5" title="Shared Title D" year="2017" journal="Journal Delta">
    <authors author="Frank Brown"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art6" title="Shared Title D" year="2016" journal="Journal Delta">
    <authors author="Grace Blue"/>
  </entries>

  <!-- Untitled entries to trigger UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2015"/>

  <!-- Titled, non-Article entries to cover TitledEntry_*_NoArticle -->
  <!-- Distinct titles -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Book Title One" year="2010" publisher="Fictional Press">
    <authors author="Henry Ivory"/>
  </entries>

  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Chapter Title X" year="2012" publisher="Academic House" chapter="3">
    <authors author="Isabel Silver"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Thesis Title Alpha" year="2013" school="Tech University">
    <authors author="John Copper"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis" id="ms1" title="Thesis Title Beta" year="2014" school="Science College">
    <authors author="Kate Amber"/>
  </entries>

  <entries xsi:type="BibTeX:InCollection" id="incol1" title="Collected Work Title" year="2011" publisher="Collection Pub">
    <authors author="Leo Gray"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Conference Paper One" year="2019" booktitle="Proceedings of XYZ">
    <authors author="Mia Violet"/>
  </entries>

  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proceedings of XYZ" year="2019"/>

  <entries xsi:type="BibTeX:Manual" id="man1" title="User Manual 1"/>

  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Technical Report 2020" year="2020">
    <authors author="Nick Orange"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft Paper Z" note="under submission">
    <authors author="Olivia Pink"/>
  </entries>

  <!-- Duplicate title among non-articles -> triggers TitledEntry_NoTitle_NoArticle on the later occurrence -->
  <entries xsi:type="BibTeX:Book" id="book2" title="Duplicate NonArticle Title" year="2008" publisher="Retro Press">
    <authors author="Paul Yellow"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport" id="tr2" title="Duplicate NonArticle Title" year="2009">
    <authors author="Quentin Red"/>
  </entries>

</BibTeX:BibTeXFile>