<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise all four Article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Unique Article Title One" year="2019" journal="Exclusive Journal A">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A2 & A3: same title, different journals -->
  <!-- A2: chosen into titleSet, journalSet -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Shared Article Title" year="2020" journal="Journal B1">
    <authors author="Carol Brown"/>
  </entries>
  <!-- A3: not in titleSet, in journalSet -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Shared Article Title" year="2021" journal="Journal B2">
    <authors author="Dave Wilson"/>
  </entries>

  <!-- A4 & A5: different titles, same journal -->
  <!-- A4: in titleSet, not in journalSet -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" title="Article in Popular Journal" year="2022" journal="Popular Journal C">
    <authors author="Eve Davis"/>
  </entries>
  <!-- A5: not in titleSet, not in journalSet -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Another Article in Popular Journal" year="2023" journal="Popular Journal C">
    <authors author="Frank Moore"/>
  </entries>

  <!-- Titled non-article entries to exercise R4 and R5 -->

  <!-- B1: Book, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Model Driven Engineering Basics" year="2015" publisher="TechBooks Press">
    <authors author="Grace Hall"/>
    <authors author="Henry King"/>
  </entries>

  <!-- B2 & B3: books with same title -->
  <!-- B2: in titledEntrySet -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B2" title="Duplicate Book Title" year="2016" publisher="Science House">
    <authors author="Ian Lee"/>
  </entries>
  <!-- B3: not in titledEntrySet -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B3" title="Duplicate Book Title" year="2017" publisher="Science House 2">
    <authors author="Ian Lee"/>
    <authors author="Jack White"/>
  </entries>

  <!-- MT1 & MT2: MasterThesis with same title -->
  <!-- MT1: in titledEntrySet -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Shared Thesis Title" year="2018" school="Engineering University">
    <authors author="Karen Young"/>
  </entries>
  <!-- MT2: not in titledEntrySet -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT2" title="Shared Thesis Title" year="2019" school="Engineering University 2">
    <authors author="Luke Green"/>
  </entries>

  <!-- P1: Proceedings with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" title="Proceedings of the MDE Conference" year="2014">
  </entries>

  <!-- IP1: InProceedings with unique title and booktitle -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="InProceedings Paper Title" year="2013" booktitle="MDE Conf 2013">
    <authors author="Mary Scott"/>
  </entries>

  <!-- IB1: InBook with unique title, chapter, publisher -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chapter on Model Transformations" year="2012" publisher="Academic Press" chapter="5">
    <authors author="Nathan Clark"/>
  </entries>

  <!-- IC1: InCollection with unique title and booktitle -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Collected Works on DSLs" year="2011" publisher="Collections Pub" booktitle="DSL Anthology">
    <authors author="Olivia Turner"/>
  </entries>

  <!-- PHD1: PhDThesis unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Advanced Topics in Model Transformation" year="2010" school="Tech University">
    <authors author="Peter Adams"/>
  </entries>

  <!-- TR1: TechReport unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Industrial Applications of MDE" year="2009">
    <authors author="Queen Baker"/>
  </entries>

  <!-- U1 & U2: Unpublished with same title -->
  <!-- U1: in titledEntrySet -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Draft on Transformation Testing" note="Under review">
    <authors author="Roberto Diaz"/>
  </entries>
  <!-- U2: not in titledEntrySet -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Draft on Transformation Testing" note="To appear">
    <authors author="Sarah Evans"/>
  </entries>

  <!-- M1: Manual, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="Tool User Manual">
  </entries>

  <!-- Untitled entries (no TitledEntry) to exercise R3 -->

  <!-- MS1: Misc (no title) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MS1">
  </entries>

  <!-- BK1: Booklet (DatedEntry only) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="BK1" year="2008">
  </entries>

</BibTeX:BibTeXFile>