<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article group A: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="artA1" title="Deep Learning in Healthcare" year="2021" journal="Journal of Medical AI">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article group B: same title, different journals -> one Title_Journal + one NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="artB1" title="Blockchain for Supply Chains" year="2019" journal="Distributed Systems Review">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artB2" title="Blockchain for Supply Chains" year="2020" journal="International Journal of Logistics">
    <authors author="David Brown"/>
  </entries>

  <!-- Article group C: different titles, same journal -> one Title_Journal + one Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="artC1" title="Edge Computing Architectures" year="2018" journal="Future Internet Journal">
    <authors author="Eve Black"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artC2" title="Secure Edge Analytics" year="2018" journal="Future Internet Journal">
    <authors author="Frank Green"/>
  </entries>

  <!-- Article group D: same title and same journal -> one Title_Journal + one NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="artD1" title="Quantum Networking Overview" year="2022" journal="Quantum Communications Letters">
    <authors author="Grace Miller"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artD2" title="Quantum Networking Overview" year="2023" journal="Quantum Communications Letters">
    <authors author="Hank Wilson"/>
  </entries>

  <!-- Titled non-article entries with unique titles -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Model-Driven Engineering Fundamentals" year="2015" publisher="TechPress">
    <authors author="Ian Clark"/>
    <authors author="Jane Lee"/>
  </entries>

  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Chapter on Model Transformations" year="2016" publisher="TechPress" chapter="3">
    <authors author="Ian Clark"/>
  </entries>

  <entries xsi:type="BibTeX:InCollection" id="incol1" title="Reusable Transformation Patterns" year="2017" publisher="Springer" booktitle="Advances in Software Modeling">
    <authors author="Karen Adams"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Scalability of ATL Transformations" year="2018" booktitle="MDE Conference 2018">
    <authors author="Luke Turner"/>
  </entries>

  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="MDE Conference 2018" year="2018">
  </entries>

  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL User Guide">
  </entries>

  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft on Model Testing" note="To appear">
    <authors author="Mary Scott"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport" id="tech1" title="Industrial Applications of MDE" year="2014">
    <authors author="Nancy Young"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis" id="mst1" title="Testing Model Transformations" year="2013" school="State University">
    <authors author="Oscar Perez"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Techniques in Model Transformation Testing" year="2012" school="Tech University">
    <authors author="Paul Rivera"/>
  </entries>

  <!-- Titled non-article duplicate titles -> TitledEntry_NoTitle_NoArticle on the second one -->
  <entries xsi:type="BibTeX:Book" id="book2" title="Patterns in Software Design" year="2005" publisher="DesignHouse">
    <authors author="Quinn Davis"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book3" title="Patterns in Software Design" year="2008" publisher="Architecture Press">
