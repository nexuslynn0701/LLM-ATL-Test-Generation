<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- A Misc entry (untitled, unauthored, undated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="miscA"/>

  <!-- A Booklet entry (untitled but dated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="bookletA" year="2001"/>

  <!-- Two TechReports with the same title -> one TitledEntry_Title_NoArticle + one TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Unified Tech Report" year="2015">
    <authors author="Alice Tech"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="Unified Tech Report" year="2016">
    <authors author="Bob Tech"/>
  </entries>

  <!-- PhDThesis and MasterThesis with unique titles -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced MDE Techniques" year="2012" school="Tech University">
    <authors author="Carol Researcher"/>
    <authors author="Dave Scholar"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="msc1" title="Model Transformation Testing" year="2018" school="Engineering Institute">
    <authors author="Eve Student"/>
  </entries>

  <!-- InBook with unique title, showing chapter and publisher inheritance through Book -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Chapter on ATL" year="2010" publisher="Springer">
    <authors author="Frank Author"/>
    <authors author="Grace Author"/>
    <chapter>5</chapter>
  </entries>

  <!-- InCollection and Book sharing the same title: one kept in title set, one excluded -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Collected MDE Works" year="2011" publisher="Academic Press">
    <authors author="Henry Editor"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="incol1" title="Collected MDE Works" year="2011" publisher="Academic Press" booktitle="Proceedings of MDE Conference">
    <authors author="Ivy Writer"/>
  </entries>

  <!-- Manual with unique title -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Tool User Guide"/>

  <!-- Unpublished with note and unique title -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft on DSLs" note="Under review">
    <authors author="John Draft"/>
  </entries>

  <!-- Proceedings, unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conference on Software Engineering" year="2020"/>

  <!-- InProceedings with same booktitle as proc1 to exercise BookTitledEntry info -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Paper on Variability" year="2020" booktitle="Conference on Software Engineering">
    <authors author="Kate Presenter"/>
  </entries>

  <!-- Articles -->
  <!-- a1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Testing ATL Transformations" year="2013" journal="Journal A">
    <authors author="Laura Tester"/>
  </entries>

  <!-- a2 and a3: same title, different journals -> one Article_Title_Journal, one Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="a2" title="MDE in Practice" year="2014" journal="Journal B">
    <authors author="Mike Engineer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a3" title="MDE in Practice" year="2015" journal="Journal C">
    <authors author="Nina Architect"/>
  </entries>

  <!-- a4 and a5: different titles, same journal -> one Article_Title_Journal, one Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a4" title="Variability Management" year="2016" journal="Journal D">
    <authors author="Oscar Designer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a5" title="Feature Models" year="2017" journal="Journal D">
    <authors author="Paul Analyst"/>
  </entries>

  <!-- a6 and a7: same title and same journal -> one Article_Title_Journal, one Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a6" title="Reusable Transformations" year="2018" journal="Journal E">
    <authors author="Quinn Developer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a7" title="Reusable Transformations" year="2019" journal="Journal E">
    <authors author="Rita Developer"/>
  </entries>

</BibTeX:BibTeXFile>