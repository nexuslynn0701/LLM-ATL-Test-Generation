<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- A. Articles to cover all Article_* rules -->

  <!-- A1 & A2: same journal, different titles -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="DocBook Transformation" year="2018" journal="Journal of MDE">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" title="ATL Testing Techniques" year="2019" journal="Journal of MDE">
    <authors author="Carol White"/>
  </entries>

  <!-- A3 & A4: same title, different journals -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Model Transformations in Practice" year="2020" journal="Software Engineering Review">
    <authors author="David Brown"/>
    <authors author="Eva Green"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" title="Model Transformations in Practice" year="2021" journal="International Journal of Modeling">
    <authors author="Frank Black"/>
  </entries>

  <!-- A5 & A6: same title and same journal -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Empirical Study of ATL" year="2022" journal="MDE Journal">
    <authors author="Grace Lee"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" title="Empirical Study of ATL" year="2023" journal="MDE Journal">
    <authors author="Henry King"/>
    <authors author="Isaac Long"/>
  </entries>

  <!-- A7: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A7" title="Advanced BibTeX Modeling" year="2017" journal="Journal of Advanced Modeling">
    <authors author="Alice Smith"/>
  </entries>

  <!-- B. Non-Article Titled Entries for TitledEntry_* rules -->

  <!-- B1 & B2: same title, non-Article -> first in distinct-set, second not -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Foundations of MDE" year="2015" publisher="MDE Publishers">
    <authors author="Jack Miller"/>
    <authors author="Karen Adams"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="B2" title="Foundations of MDE" year="2016" publisher="MDE Publishers" chapter="3">
    <authors author="Laura Scott"/>
  </entries>

  <!-- B3: unique non-Article titled entry with BookTitledEntry & ThesisEntry inheritance -->
  <entries xsi:type="BibTeX:InCollection" id="B3" title="Reusable Transformations" year="2014" publisher="Patterns Press" booktitle="Handbook of Model Transformations">
    <authors author="Michael Turner"/>
    <authors author="Nina Olson"/>
  </entries>

  <!-- B4 & B5: Thesis entries with same title for additional overlaps -->
  <entries xsi:type="BibTeX:PhDThesis" id="B4" title="Verification of Model Transformations" year="2013" school="Tech University">
    <authors author="Oscar Perez"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="B5" title="Verification of Model Transformations" year="2012" school="City University">
    <authors author="Paul Young"/>
  </entries>

  <!-- B6: InProceedings (inherits BookTitledEntry, AuthoredEntry, DatedEntry, TitledEntry, Proceedings) -->
  <entries xsi:type="BibTeX:InProceedings" id="B6" title="Incremental Transformation Testing" year="2020" booktitle="ICMT 2020">
    <authors author="Quinn Fox"/>
    <authors author="Rachel Day"/>
  </entries>

  <!-- B7: Manual (TitledEntry only) with unique title -->
  <entries xsi:type="BibTeX:Manual" id="B7" title="ATL User Guide"/>
  
  <!-- B8: TechReport with unique title -->
  <entries xsi:type="BibTeX:TechReport" id="B8" title="Survey of Model Transformation Tools" year="2011">
    <authors author="Steve Hall"/>
  </entries>

  <!-- B9: Unpublished with unique title and note -->
  <entries xsi:type="BibTeX:Unpublished" id="B9" title="Draft on Bidirectional Transformations" note="To appear">
    <authors author="Tom Clark"/>
  </entries>

  <!-- C. Untitled Entries for UntitledEntry rule -->

  <!-- C1: Misc (no title, no authors, no date) -->
  <entries xsi:type="BibTeX:Misc" id="C1"/>
  
  <!-- C2: Booklet (DatedEntry only, no title) -->
  <entries xsi:type="BibTeX:Booklet" id="C2" year="2010"/>

</BibTeX:BibTeXFile>