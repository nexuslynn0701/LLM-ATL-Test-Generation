<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article A1: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Unique Article One"
           year="2010"
           journal="Exclusive Journal">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- Article A2 & A3: same title, different journals -> one Title_Journal, one NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Title Articles"
           year="2011"
           journal="Journal X">
    <authors author="Carol Gamma"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Shared Title Articles"
           year="2012"
           journal="Journal Y">
    <authors author="Dave Delta"/>
  </entries>

  <!-- Article A4 & A5: same journal, different titles ->
       one Title_Journal, one Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Alpha in Common Journal"
           year="2013"
           journal="Common Journal">
    <authors author="Eve Epsilon"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Beta in Common Journal"
           year="2014"
           journal="Common Journal">
    <authors author="Frank Phi"/>
  </entries>

  <!-- Article A6 & A7: same title and same journal ->
       one Title_Journal, one NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Duplicated Full Article"
           year="2015"
           journal="Repeated Journal">
    <authors author="Grace Gamma"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Duplicated Full Article"
           year="2016"
           journal="Repeated Journal">
    <authors author="Henry Eta"/>
  </entries>

  <!-- TechReport TR1 & TR2: same title (one in title-set, one out) to exercise
       TitledEntry_Title_NoArticle and TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Common Titled Report"
           year="2017">
    <authors author="Alice Alpha"/>
    <authors author="Ivan Iota"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport"
           id="TR2"
           title="Common Titled Report"
           year="2018">
    <authors author="John Kappa"/>
  </entries>

  <!-- Book B1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Unique Book Title"
           year="2009"
           publisher="Top Publisher">
    <authors author="Carol Gamma"/>
    <authors author="Liam Lambda"/>
  </entries>

  <!-- MasterThesis MT1 & MT2: same title -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Thesis on Testing"
           year="2019"
           school="Tech University A">
    <authors author="Eve Epsilon"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis"
           id="MT2"
           title="Thesis on Testing"
           year="2020"
           school="Tech University B">
    <authors author="Mike Mu"/>
  </entries>

  <!-- PhDThesis PHD1: unique title -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Advanced Model Transformations"
           year="2021"
           school="Institute of MDE">
    <authors author="Bob Beta"/>
  </entries>

  <!-- InBook IB1 & IB2: same title, different chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Embedded in Big Book"
           year="2008"
           publisher="Series Publisher"
           chapter="3">
    <authors author="Frank Phi"/>
  </entries>

  <entries xsi:type="BibTeX:InBook"
           id="IB2"
           title="Embedded in Big Book"
           year="2008"
           publisher="Series Publisher"
           chapter="4">
    <authors author="Grace Gamma"/>
  </entries>

  <!-- InCollection IC1: book + booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Chapter in Collection"
           year="2007"
           publisher="Collection Publisher"
           booktitle="Collected Works Volume 1">
    <authors author="Henry Eta"/>
  </entries>

  <!-- InProceedings IP1 & IP2: same title within Proceedings hierarchy -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Conference Paper Title"
           year="2005"
           booktitle="Proceedings of MDEConf">
    <authors author="Ivan Iota"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings"
           id="IP2"
           title="Conference Paper Title"
           year="2006"
           booktitle="Proceedings of MDEConf">
    <authors author="John Kappa"/>
  </entries>

  <!-- Manual M1: unique title -->
  <entries xsi:type="BibTeX:Manual"
           id="M1"
           title="Tool User Manual"/>
           
  <!-- Proceedings PR1: unique title -->
  <entries xsi:type="BibTeX:Proceedings"
           id="PR1"
           title="Workshop on Model Testing"
           year="2004"/>

  <!-- Unpublished U1 & U2: same title -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Draft on Transformations"
           note="Work in progress">
    <authors author="Liam Lambda"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="U2"
           title="Draft on Transformations"
           note="Second draft">
    <authors author="Mike Mu"/>
  </entries>

  <!-- Booklet BL1: untitled dated entry -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet"
           id="BL1"
           year="2003"/>

  <!-- Misc MISC1 & MISC2: untitled generic entries -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="MISC1"/>

  <entries xsi:type="BibTeX:Misc"
           id="MISC2"/>

</BibTeX:BibTeXFile>