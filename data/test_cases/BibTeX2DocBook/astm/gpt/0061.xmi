<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- A1 & A2: same title, different journals -> one Article_NoTitle_Journal, one Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Shared Title" year="2019" journal="Journal X">
    <authors author="Alice Alpha"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" title="Shared Title" year="2020" journal="Journal Y">
    <authors author="Bob Beta"/>
  </entries>

  <!-- A3 & A4: different titles, same journal -> one Article_Title_NoJournal, one Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Unique Title 1" year="2018" journal="Same Journal">
    <authors author="Charlie Gamma"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" title="Unique Title 2" year="2017" journal="Same Journal">
    <authors author="Dana Delta"/>
  </entries>

  <!-- A5 & A6: same title and same journal -> one Article_NoTitle_NoJournal, one Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Dup Title Journal" year="2016" journal="Duplicated Journal">
    <authors author="Eve Epsilon"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" title="Dup Title Journal" year="2015" journal="Duplicated Journal">
    <authors author="Frank Phi"/>
  </entries>

  <!-- T1 & T2: MasterThesis with same title -> one TitledEntry_NoTitle_NoArticle, one TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="T1" title="Thesis Shared" year="2014" school="Tech University">
    <authors author="Grace Gamma"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="T2" title="Thesis Shared" year="2013" school="Tech University">
    <authors author="Heidi Eta"/>
  </entries>

  <!-- T3 & T4: Book with different titles -> both TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="T3" title="Book One" year="2012" publisher="PubHouse A">
    <authors author="Ivan Iota"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="T4" title="Book Two" year="2011" publisher="PubHouse B">
    <authors author="Judy Kappa"/>
  </entries>

  <!-- U1: TechReport with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="U1" title="Report Solo" year="2010">
    <authors author="Leo Lambda"/>
  </entries>

  <!-- U2 & U3: InProceedings with same title -> one TitledEntry_NoTitle_NoArticle, one TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="U2" title="Conference Paper" year="2009" booktitle="Conf Book 1">
    <authors author="Mallory Mu"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="U3" title="Conference Paper" year="2008" booktitle="Conf Book 2">
    <authors author="Niaj Nu"/>
  </entries>

  <!-- U4: Misc (untitled entry) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- U5: Booklet (dated but not titled) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="2007"/>

  <!-- U6: Manual (titled, no authors/date) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="User Manual"/>

  <!-- U7: Unpublished (titled, with note) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Working Draft" note="To appear soon">
    <authors author="Olivia Omicron"/>
  </entries>

  <!-- U8: InBook (chaptered book) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chaptered Book" year="2006" publisher="Chapter Pub" chapter="3">
    <authors author="Peggy Pi"/>
  </entries>

</BibTeX:BibTeXFile>