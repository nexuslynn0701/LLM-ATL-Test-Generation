<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: unique title + unique journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Unique Article One" year="2010" journal="Journal Alpha">
    <authors author="Alice Author"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" title="Unique Article Two" year="2011" journal="Journal Beta">
    <authors author="Bob Writer"/>
    <authors author="Carol Researcher"/>
  </entries>

  <!-- Articles: duplicate title, same journal (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Repeated Title JX" year="2012" journal="Journal X">
    <authors author="Dave Scholar"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" title="Repeated Title JX" year="2013" journal="Journal X">
    <authors author="Eve Scientist"/>
  </entries>

  <!-- Articles: duplicate title, different journal (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Shared Title DiffJournal" year="2014" journal="Journal Y">
    <authors author="Frank Author"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" title="Shared Title DiffJournal" year="2015" journal="Journal Z">
    <authors author="Grace Contributor"/>
  </entries>

  <!-- Articles: unique title, shared journal (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A7" title="Alpha Study" year="2016" journal="Journal Shared">
    <authors author="Henry Writer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A8" title="Beta Study" year="2017" journal="Journal Shared">
    <authors author="Ivy Analyst"/>
  </entries>

  <!-- Non-article titled entries with unique titles (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Unique Book Title" year="2001" publisher="Publisher One">
    <authors author="Alice Author"/>
    <authors author="John Doe"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="B2" title="Unique InBook Title" year="2002" publisher="Publisher Two" chapter="3">
    <authors author="Bob Writer"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="B3" title="Unique InCollection Title" year="2003" publisher="Publisher Three" booktitle="Collected Works One">
    <authors author="Carol Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="B4" title="Unique InProceedings Title" year="2004" booktitle="Conference One">
    <authors author="Dave Scholar"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="B5" title="Unique Proceedings Title" year="2005"/>
  <entries xsi:type="BibTeX:Manual" id="B6" title="Unique Manual Title"/>
  <entries xsi:type="BibTeX:Unpublished" id="B7" title="Unique Unpublished Title" note="To appear soon.">
    <authors author="Eve Scientist"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="B8" title="Unique TechReport Title" year="2006">
    <authors author="Frank Author"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="B9" title="Unique PhD Thesis Title" year="2007" school="Tech University">
    <authors author="Grace Contributor"/>
  </entries>

  <!-- Non-article titled entries with duplicate title (TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:MasterThesis" id="B10" title="Shared Thesis Title" year="2008" school="Science Institute">
    <authors author="Henry Writer"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="B11" title="Shared Thesis Title" year="2009" school="Science Institute">
    <authors author="Ivy Analyst"/>
  </entries>

  <!-- Untitled entries (not TitledEntry) to trigger UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="U1"/>
  <entries xsi:type="BibTeX:Booklet" id="U2" year="1999"/>

</BibTeX:BibTeXFile>