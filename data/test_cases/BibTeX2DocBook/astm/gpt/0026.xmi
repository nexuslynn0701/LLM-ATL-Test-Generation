<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- A Misc entry (untitled, unauthored, undated) -> R3 UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="miscUnique"/>

  <!-- A Booklet entry (untitled, dated) -> R3 UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="booklet2001" year="2001"/>

  <!-- Two Articles with same title and same journal -> first: R6, second: R9
       both authored and dated to exercise concatenations -->
  <entries xsi:type="BibTeX:Article" id="artA1" title="Shared Title A" year="2010" journal="Journal X">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artA2" title="Shared Title A" year="2011" journal="Journal X">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Two Articles with same title but different journals -> first: R6, second: R7 -->
  <entries xsi:type="BibTeX:Article" id="artB1" title="Shared Title B" year="2012" journal="Journal Y">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artB2" title="Shared Title B" year="2013" journal="Journal Z">
    <authors author="Dan Brown"/>
    <authors author="Eve Black"/>
  </entries>

  <!-- Two Articles with different titles but same journal -> first: R6, second: R8 -->
  <entries xsi:type="BibTeX:Article" id="artC1" title="Unique Title C1" year="2014" journal="Journal W">
    <authors author="Frank Green"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artC2" title="Unique Title C2" year="2015" journal="Journal W">
    <authors author="Helen Gray"/>
  </entries>

  <!-- MasterThesis: unique title -> R4 -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Thesis Alpha" year="2016" school="Tech University">
    <authors author="Ian Miller"/>
  </entries>

  <!-- Two PhDThesis with same title -> first: R4, second: R5 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Deep Study" year="2017" school="Science Institute">
    <authors author="Jane Doe"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd2" title="Deep Study" year="2018" school="Science Institute">
    <authors author="John Roe"/>
  </entries>

  <!-- InBook with extra features: chapter and publisher via Book superclass -> R4 -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Book Chapter One" year="2019" publisher="Global Press" chapter="3">
    <authors author="Kate Long"/>
    <authors author="Larry Page"/>
  </entries>

  <!-- Book with unique title -> R4 -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Stand-alone Book" year="2005" publisher="Academic Press">
    <authors author="Mary Johnson"/>
  </entries>

  <!-- Two InCollection with same title -> first: R4, second: R5 -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Collected Chapter" year="2008" publisher="Series House">
    <authors author="Nick Young"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="incoll2" title="Collected Chapter" year="2009" publisher="Series House">
    <authors author="Olivia King"/>
  </entries>

  <!-- InProceedings, Proceedings, Manual, TechReport, Unpublished to cover more subclasses -->
  <!-- InProceedings (titled, authored, dated, booktitled) -> R4 -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Conference Paper One" year="2020" booktitle="Conf 2020">
    <authors author="Paul Adams"/>
    <authors author="Quinn Lee"/>
  </entries>

  <!-- Proceedings (titled, dated) -> R4 -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proceedings of Conf 2020" year="2020"/>

  <!-- Manual (titled only) with same title as unpublished2 to force R5 for one of them -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="Draft Guide"/>

  <!-- TechReport with unique title -> R4 -->
  <entries xsi:type="BibTeX:TechReport" id="tech1" title="Tech Report 1" year="2000">
    <authors author="Sara Lee"/>
  </entries>

  <!-- Two Unpublished with same title "Draft Guide" to play with R4/R5 and note attribute -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft Guide" note="Version 1 notes">
    <authors author="Tom Hardy"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Draft Guide" note="Version 2 notes">
    <authors author="Uma Thurman"/>
  </entries>

</BibTeX:BibTeXFile>