<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article A1: unique title & unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Unique Article Title 1"
           year="2010"
           journal="Journal Alpha">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- Article A2: duplicate title with A3, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Article Title"
           year="2011"
           journal="Journal Beta">
    <authors author="Carol Researcher"/>
  </entries>

  <!-- Article A3: same title and journal as A4 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Repeated Title in Same Journal"
           year="2012"
           journal="Journal Gamma">
    <authors author="Dave Scientist"/>
    <authors author="Eve Analyst"/>
  </entries>

  <!-- Article A4: second with same title & journal as A3 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Repeated Title in Same Journal"
           year="2013"
           journal="Journal Gamma">
    <authors author="Frank Engineer"/>
  </entries>

  <!-- Article A5: unique title, duplicate journal with A6 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Gamma Journal First Title"
           year="2014"
           journal="Journal Delta">
    <authors author="Grace Scholar"/>
  </entries>

  <!-- Article A6: duplicate title with A2, duplicate journal with A5
       Not in titleSet or journalSet -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Shared Article Title"
           year="2015"
           journal="Journal Delta">
    <authors author="Henry Contributor"/>
  </entries>

  <!-- Misc M1: untitled, should trigger UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="M1"/>
  
  <!-- Booklet Bk1: dated but untitled, should trigger UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet"
           id="Bk1"
           year="2009"/>

  <!-- Manual Man1: titled, no authors/date -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual"
           id="Man1"
           title="Tool User Guide"/>

  <!-- TechReport TR1: titled, authors & date -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Tech Report Unique Title"
           year="2016">
    <authors author="Alice Author"/>
  </entries>

  <!-- TechReport TR2 & TR3: same title, authors/date ->
       TR2 in titleSet -> TitledEntry_Title_NoArticle
       TR3 not in titleSet -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR2"
           title="Duplicated Tech Report"
           year="2017">
    <authors author="Bob Writer"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport"
           id="TR3"
           title="Duplicated Tech Report"
           year="2018">
    <authors author="Carol Researcher"/>
  </entries>

  <!-- PhDThesis PHD1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Advanced Modeling Techniques"
           year="2019"
           school="University One">
    <authors author="Dave Scientist"/>
  </entries>

  <!-- MasterThesis MSC1 & MSC2: same title ->
       MSC1 in titleSet -> TitledEntry_Title_NoArticle
       MSC2 not in titleSet -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MSC1"
           title="Model Transformation Case Studies"
           year="2020"
           school="Tech Institute">
    <authors author="Eve Analyst"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis"
           id="MSC2"
           title="Model Transformation Case Studies"
           year="2021"
           school="Tech Institute">
    <authors author="Frank Engineer"/>
  </entries>

  <!-- Book BK2: titled book with publisher & authors -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="BK2"
           title="Foundations of MDE"
           year="2008"
           publisher="Publishing House A">
    <authors author="Grace Scholar"/>
    <authors author="Henry Contributor"/>
  </entries>

  <!-- InBook IB1: chaptered entry within a book -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="In-Depth Chapter on ATL"
           year="2011"
           publisher="Publishing House B"
           chapter="5">
    <authors author="Alice Author"/>
  </entries>

  <!-- InCollection IC1: book-like collection with booktitle -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Case Study in Model Testing"
           year="2012"
           publisher="Publishing House C"
           booktitle="Proceedings of MDE 2012">
    <authors author="Bob Writer"/>
  </entries>

  <!-- Proceedings PR1: titled & dated -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings"
           id="PR1"
           title="Proceedings of MDE 2015"
           year="2015"/>

  <!-- InProceedings IP1: authored, booktitle & proceedings supertype -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Testing Model Transformations"
           year="2015"
           booktitle="Proceedings of MDE 2015">
    <authors author="Carol Researcher"/>
    <authors author="Dave Scientist"/>
  </entries>

  <!-- Unpublished UP1 & UP2: same title, note distinguishes them
       UP1 in titleSet -> TitledEntry_Title_NoArticle
       UP2 not in titleSet -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="UP1"
           title="Draft on Traceability"
           note="First draft">
    <authors author="Eve Analyst"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="UP2"
           title="Draft on Traceability"
           note="Revised version">
    <authors author="Frank Engineer"/>
  </entries>

</BibTeX:BibTeXFile>