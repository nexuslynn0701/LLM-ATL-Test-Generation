<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles designed to trigger all four Article rules plus duplicates -->
  <!-- A1 & A2 : same title, same journal -> one Article_Title_Journal, one Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Common Title A"
           year="2010"
           journal="Journal Alpha">
    <authors author="Alice Smith"/>
    <authors author="Bob Brown"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Common Title A"
           year="2011"
           journal="Journal Alpha">
    <authors author="Charlie Clark"/>
  </entries>

  <!-- A3 & A4 : same title, different journals -> one Article_Title_Journal, one Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Shared Title B"
           year="2012"
           journal="Journal Beta">
    <authors author="David Doe"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Shared Title B"
           year="2013"
           journal="Journal Gamma">
    <authors author="Eve Evans"/>
  </entries>

  <!-- A5 & A6 : different titles, same journal -> one Article_Title_Journal, one Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Unique Title C"
           year="2014"
           journal="Journal Delta">
    <authors author="Frank Ford"/>
    <authors author="Grace Green"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Distinct Title D"
           year="2015"
           journal="Journal Delta">
    <authors author="Helen Hall"/>
  </entries>

  <!-- Non-Article titled entries to exercise TitledEntry rules with shared and unique titles -->

  <!-- Two PhDThesis with same title -> one in TitledEntry_Title_NoArticle, one in TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Thesis on Modeling"
           year="2016"
           school="Tech University">
    <authors author="Ian Irving"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD2"
           title="Thesis on Modeling"
           year="2017"
           school="Tech University">
    <authors author="Jack Johnson"/>
  </entries>

  <!-- MasterThesis with same title as a Book (cross-type duplicate) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MSC1"
           title="Software Engineering Basics"
           year="2018"
           school="City College">
    <authors author="Karen King"/>
  </entries>

  <!-- Book with title shared with MSC1, plus publisher -->
  <entries xsi:type="BibTeX:Book"
           id="BK1"
           title="Software Engineering Basics"
           year="2019"
           publisher="Global Press">
    <authors author="Laura Lane"/>
    <authors author="Mike Miller"/>
  </entries>

  <!-- InBook with unique title and chapter, should be in titledEntrySet -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Advanced Components"
           year="2020"
           publisher="TechBooks"
           chapter="3">
    <authors author="Nancy Nolan"/>
  </entries>

  <!-- InCollection with unique title and booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Patterns in Practice"
           year="2021"
           publisher="Patterns Press"
           booktitle="Proceedings of PatternsConf">
    <authors author="Oscar Owen"/>
  </entries>

  <!-- InProceedings with unique title, booktitle and inherited Proceedings/DatedEntry features -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Model Transformations in Industry"
           year="2022"
           booktitle="Proceedings of MODELCONF">
    <authors author="Paul Price"/>
    <authors author="Quinn Queen"/>
  </entries>

  <!-- Proceedings with unique title -->
  <entries xsi:type="BibTeX:Proceedings"
           id="PR1"
           title="Proceedings of MODELCONF"
           year="2022"/>
  
  <!-- Manual with unique title -->
  <entries xsi:type="BibTeX:Manual"
           id="MN1"
           title="User Guide for Tool X"/>
  
  <!-- Unpublished with unique title and note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="UNP1"
           title="Draft on Testing"
           note="In preparation">
    <authors author="Rachel Rose"/>
  </entries>

  <!-- TechReport with unique title -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Internal Report on MDE"
           year="2023">
    <authors author="Steve Stone"/>
  </entries>

  <!-- Untitled entries to trigger UntitledEntry rule -->

  <!-- Misc, no title -->
  <entries xsi:type="BibTeX:Misc"
           id="MISC1"/>
  
  <!-- Booklet, untitled dated entry -->
  <entries xsi:type="BibTeX:Booklet"
           id="BKT1"
           year="2009"/>

</BibTeX:BibTeXFile>