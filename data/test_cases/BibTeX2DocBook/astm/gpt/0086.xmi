<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: 
       A1, A2 share same title "Shared Title 1", different journals -> Article_Title_NoJournal for both
       A3, A4 share same journal "Journal X", different title sets:
         - A3 title duplicated by A6 (book), so its title is not unique in TitledEntry set -> Article_NoTitle_Journal
         - A4 unique title overall -> Article_Title_Journal
       A5, A7 share title and journal -> Article_NoTitle_NoJournal for both
  -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Shared Title 1"
           year="2015"
           journal="Journal Alpha">
    <authors author="Alice Smith"/>
    <authors author="Bob Miller"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Title 1"
           year="2016"
           journal="Journal Beta">
    <authors author="Carol Jones"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Title Also Used By Book"
           year="2017"
           journal="Journal X">
    <authors author="Alice Smith"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Unique Article Title"
           year="2018"
           journal="Journal X">
    <authors author="David Brown"/>
    <authors author="Eve Davis"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Duplicate AJ"
           year="2019"
           journal="Journal Y">
    <authors author="Frank Green"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Duplicate AJ"
           year="2020"
           journal="Journal Y">
    <authors author="Helen White"/>
  </entries>

  <!-- Titled, non-Article entries with unique titles -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Mastering MDE"
           year="2014"
           school="Tech University">
    <authors author="Ian Black"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Advanced Model Transformations"
           year="2013"
           school="Science Institute">
    <authors author="Julia Gray"/>
    <authors author="Alice Smith"/>
  </entries>

  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="InBook Unique Title"
           year="2012"
           publisher="Global Press"
           chapter="3">
    <authors author="Kevin Lee"/>
  </entries>

  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="InCollection Unique Title"
           year="2011"
           publisher="Scholarly House"
           booktitle="Collected Studies in MDE">
    <authors author="Linda King"/>
    <authors author="Mark Young"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Proceedings Paper Title"
           year="2010"
           booktitle="MDE Conference 2010">
    <authors author="Nina Clark"/>
  </entries>

  <entries xsi:type="BibTeX:Proceedings"
           id="PR1"
           title="MDE Conference 2010"
           year="2010">
  </entries>

  <entries xsi:type="BibTeX:Manual"
           id="MA1"
           title="Tool User Guide">
  </entries>

  <!-- Titled, non-Article entries participating in title duplicates
       "Title Also Used By Book" shared with A3 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Title Also Used By Book"
           year="2009"
           publisher="Tech Books Ltd.">
    <authors author="Oscar Perez"/>
  </entries>

  <!-- Another pair of titled, non-Article entries sharing a title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Shared Tech Report Title"
           year="2008">
    <authors author="Paul Adams"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="UN1"
           title="Shared Tech Report Title"
           note="To appear">
    <authors author="Quentin Fox"/>
  </entries>

  <!-- Untitled entries (not instances of TitledEntry) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="M1">
  </entries>

  <entries xsi:type="BibTeX:Booklet"
           id="BL1"
           year="2007">
  </entries>

</BibTeX:BibTeXFile>