<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: designed to hit all four Article rules -->
  <!-- A1 & A2: same journal, same title -> one in Article_NoTitle_NoJournal, one excluded from journal-set -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Shared Insights" year="2018" journal="Journal Alpha">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" title="Shared Insights" year="2019" journal="Journal Alpha">
    <authors author="Carol White"/>
  </entries>

  <!-- A3 & A4: same title, different journals -> one in Article_Title_Journal, one in Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Deep Learning Advances" year="2020" journal="Journal Beta">
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" title="Deep Learning Advances" year="2021" journal="Journal Gamma">
    <authors author="David Black"/>
  </entries>

  <!-- A5 & A6: different titles, same journal -> one in Article_Title_NoJournal, one excluded from both sets -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Unique Topic One" year="2022" journal="Journal Delta">
    <authors author="Eve Adams"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" title="Unique Topic Two" year="2023" journal="Journal Delta">
    <authors author="Frank Moore"/>
  </entries>

  <!-- Non-article titled entries to exercise TitledEntry rules -->
  <!-- Distinct titles: should go to TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Model Engineering Handbook" year="2015" publisher="TechPress">
    <authors author="George King"/>
    <authors author="Helen Brown"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chapter on MDE" year="2016" publisher="TechPress" chapter="3">
    <authors author="Ian Gray"/>
  </entries>
  <entries xsi:type="BibTeX:Manual" id="M1" title="ATL User Guide" year="2014">
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="P1" title="ICMT 2017 Proceedings" year="2017">
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Transformation Testing Techniques" year="2013">
    <authors author="Jane Doe"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Testing Model Transformations" year="2012" school="University One">
    <authors author="Kevin Long"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Scalable Model Transformations" year="2011" school="University Two">
    <authors author="Laura Stone"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="MDE in Practice" year="2010" publisher="Springer">
    <authors author="Mike Green"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Practical ATL Applications" year="2019" booktitle="ECMFA 2019 Proceedings">
    <authors author="Nina Orange"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Draft on Model Testing" note="To appear" >
    <authors author="Oscar Pink"/>
  </entries>

  <!-- Duplicate titles among non-articles to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B2" title="Duplicate Title Case" year="2010" publisher="OldPub">
    <authors author="Paul Red"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="B3" title="Duplicate Title Case" year="2011" publisher="NewPub">
    <authors author="Queen Silver"/>
  </entries>

  <!-- Untitled entries to trigger UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc" id="MS1">
  </entries>
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="2009">
  </entries>

</BibTeX:BibTeXFile>