<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Two Articles with the same title and same journal (to drive Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Shared Insights"
           year="2018"
           journal="International Journal of Testing">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Insights"
           year="2019"
           journal="International Journal of Testing">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- Two Articles with unique titles but the same journal (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="MDE in Practice"
           year="2020"
           journal="Software Modeling Journal">
    <authors author="Alice Alpha"/>
  </entries>
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Testing Transformations"
           year="2021"
           journal="Software Modeling Journal">
    <authors author="David Delta"/>
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- Two Articles with the same title but different journals (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Pattern-Based Engineering"
           year="2017"
           journal="Patterns Monthly">
    <authors author="Frank Phi"/>
  </entries>
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Pattern-Based Engineering"
           year="2017"
           journal="Design Patterns Review">
    <authors author="Grace Gamma"/>
  </entries>

  <!-- An Article with unique title and unique journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Unique Article Title"
           year="2016"
           journal="Singular Journal of Research">
    <authors author="Henry Eta"/>
  </entries>

  <!-- MasterThesis: unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Model-Driven Testing"
           year="2015"
           school="Tech University">
    <authors author="Ian Iota"/>
  </entries>

  <!-- PhDThesis: shares title with MT1 (TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Model-Driven Testing"
           year="2014"
           school="Advanced Tech Institute">
    <authors author="Jane Jota"/>
  </entries>

  <!-- Book: unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Foundations of MDE"
           year="2013"
           publisher="Modeling Press">
    <authors author="Karl Kappa"/>
    <authors author="Laura Lambda"/>
  </entries>

  <!-- InBook: shares title with B1 (TitledEntry_NoTitle_NoArticle) and uses chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Foundations of MDE"
           year="2013"
           publisher="Modeling Press"
           chapter="2">
    <authors author="Mike Mu"/>
  </entries>

  <!-- InCollection: unique title (TitledEntry_Title_NoArticle) and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Chapter on Transformations"
           year="2012"
           publisher="Collections House"
           booktitle="Collected Works on MDE">
    <authors author="Nina Nu"/>
  </entries>

  <!-- InProceedings: shares title with a Proceedings (TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Proceedings on Testing"
           year="2011"
           booktitle="MDE Testing Conference"
           >
    <authors author="Oscar Omicron"/>
  </entries>

  <!-- Proceedings: same title as IP1 (TitledEntry_Title_NoArticle candidate) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="PR1"
           title="Proceedings on Testing"
           year="2011">
  </entries>

  <!-- Manual: unique titled, no authors (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Manual"
           id="M1"
           title="ATL User Guide">
  </entries>

  <!-- Unpublished: pair with same title to trigger TitledEntry_NoTitle_NoArticle and note text -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Working Draft on MDE"
           note="Draft version">
    <authors author="Peter Pi"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished"
           id="U2"
           title="Working Draft on MDE"
           note="Revised draft">
    <authors author="Quinn Q"/>
  </entries>

  <!-- TechReport: unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Report on Transformation Testing"
           year="2010">
    <authors author="Rachel Rho"/>
  </entries>

  <!-- UntitledEntry examples (Misc and Booklet) for rule UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="MISC1">
  </entries>

  <entries xsi:type="BibTeX:Booklet"
           id="BK1"
           year="2009">
  </entries>

</BibTeX:BibTeXFile>