<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for R3: Misc, Booklet) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Booklet" id="b1" year="2018"/>

  <!-- Articles to cover all four article rules (R6–R9) -->
  <!-- a1: unique title & unique journal -> Article_Title_Journal (R6) -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Unique Article" year="2019" journal="Journal A">
    <authors author="Alice Smith"/>
  </entries>

  <!-- a2 & a3: same title, different journals
       One journal appears in set, one not -> Article_NoTitle_Journal (R7) and Article_Title_NoJournal (R8) -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Shared Title" year="2020" journal="Journal B">
    <authors author="Bob Brown"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a3" title="Shared Title" year="2021" journal="Journal C">
    <authors author="Carol Clark"/>
  </entries>

  <!-- a4 & a5: same title and same journal -> Article_NoTitle_NoJournal (R9) for one of them -->
  <entries xsi:type="BibTeX:Article" id="a4" title="Duplicate In Same Journal" year="2022" journal="Journal D">
    <authors author="Dan Davis"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a5" title="Duplicate In Same Journal" year="2023" journal="Journal D">
    <authors author="Eve Evans"/>
  </entries>

  <!-- Non-article titled entries for R4/R5 and title-duplicate behaviour -->
  <!-- mt1: MasterThesis, unique title -> TitledEntry_Title_NoArticle (R4) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Mastering MDE" year="2017" school="Tech University">
    <authors author="Frank Foster"/>
  </entries>

  <!-- pt1 & pt2: PhDThesis with same title -> one in titledEntrySet (R4), another out (R5) -->
  <entries xsi:type="BibTeX:PhDThesis" id="pt1" title="Duplicate Thesis Title" year="2016" school="Science Institute">
    <authors author="Grace Green"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="pt2" title="Duplicate Thesis Title" year="2015" school="Science Institute">
    <authors author="Henry Hall"/>
  </entries>

  <!-- bk1: Book, unique title -> R4 -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="MDE in Practice" year="2014" publisher="ModelPress">
    <authors author="Irene Ivy"/>
    <authors author="Jack Johnson"/>
  </entries>

  <!-- inb1 & inb2: InBook with same title -> R4 and R5 -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Patterns in Models" year="2013" publisher="DesignBooks" chapter="3">
    <authors author="Karen King"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="ib2" title="Patterns in Models" year="2012" publisher="DesignBooks" chapter="5">
    <authors author="Leo Long"/>
  </entries>

  <!-- inc1: InCollection (shares book inheritance and booktitle) -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Chapter on Transformations" year="2011" publisher="CollectionPub" booktitle="Collected Works on MDE">
    <authors author="Mia Moore"/>
  </entries>

  <!-- inp1 & inp2: InProceedings with same title and different booktitles -> R4/R5 -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Conference Paper Title" year="2010" booktitle="Proc. MDEConf 2010">
    <authors author="Nina North"/>
    <authors author="Oscar Owen"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="ip2" title="Conference Paper Title" year="2010" booktitle="Proc. MDEConf 2011">
    <authors author="Paul Price"/>
  </entries>

  <!-- pr1: Proceedings, unique title -> R4 -->
  <entries xsi:type="BibTeX:Proceedings" id="pr1" title="Proceedings of the MDE Symposium" year="2009"/>

  <!-- man1 & man2: Manual with shared title -> R4/R5 -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Tool User Guide"/>
  <entries xsi:type="BibTeX:Manual" id="man2" title="Tool User Guide"/>

  <!-- unp1 & unp2: Unpublished with shared title -> R4/R5, also note field used -->
  <entries xsi:type="BibTeX:Unpublished" id="u1" title="Working Draft on MDE" note="Draft version">
    <authors author="Quinn Quick"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="u2" title="Working Draft on MDE" note="Revised draft">
    <authors author="Rachel Reed"/>
  </entries>

  <!-- tr1 & tr2: TechReport with same title -> R4/R5 -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Technical Report on Transformations" year="2008">
    <authors author="Sam Stone"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="Technical Report on Transformations" year="2007">
    <authors author="Tina Turner"/>
  </entries>

</BibTeX:BibTeXFile>