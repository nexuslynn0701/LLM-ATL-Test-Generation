<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries to trigger R3 (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="miscA"/>
  <entries xsi:type="BibTeX:Booklet" id="bookletB" year="2016"/>

  <!-- Titled, non-Article entries with unique titles to trigger R4 -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Mastering MDE" year="2018" school="Tech University">
    <authors author="Alice Masters"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Model Transformations" year="2019" school="Science Institute">
    <authors author="Bob Doctor"/>
    <authors author="Carol Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book1" title="Practical ATL" year="2015" publisher="ModelPub">
    <authors author="Alice Masters"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Practical ATL" year="2015" publisher="ModelPub" chapter="3">
    <authors author="Dave Chapter"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Transformation Collections" year="2017" publisher="CollPub">
    <authors author="Eve Collector"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="ATL in Practice" year="2020" booktitle="MDEConf 2020">
    <authors author="Frank Speaker"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="MDEConf 2020" year="2020"/>
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL Tooling Guide"/>
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Unreleased ATL Ideas" note="Draft version">
    <authors author="Grace Unpub"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="ATL Report" year="2014">
    <authors author="Henry Reporter"/>
  </entries>

  <!-- Titled, non-Article entries with duplicate titles to trigger R5 -->
  <entries xsi:type="BibTeX:Book" id="book2" title="Duplicate Title Book" year="2013" publisher="OldPub">
    <authors author="Ivan Author"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book3" title="Duplicate Title Book" year="2014" publisher="NewPub">
    <authors author="Jack Writer"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="ATL Report" year="2015">
    <authors author="Henry Reporter"/>
  </entries>

  <!-- Articles for all four article rules R6–R9 -->

  <!-- Unique title and unique journal: R6 (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Unique Article One" year="2011" journal="Journal A">
    <authors author="Alice Masters"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art2" title="Unique Article Two" year="2012" journal="Journal B">
    <authors author="Bob Doctor"/>
  </entries>

  <!-- Duplicate title (same title, different journals): R7 (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Shared Title" year="2013" journal="Journal C">
    <authors author="Carol Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art4" title="Shared Title" year="2014" journal="Journal D">
    <authors author="Dave Chapter"/>
  </entries>

  <!-- Duplicate journal (different titles, same journal): R8 (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art5" title="Journal Repeat One" year="2015" journal="Journal E">
    <authors author="Eve Collector"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art6" title="Journal Repeat Two" year="2016" journal="Journal E">
    <authors author="Frank Speaker"/>
  </entries>

  <!-- Duplicate title and duplicate journal: R9 (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art7" title="Same Title Same Journal" year="2017" journal="Journal F">
    <authors author="Grace Unpub"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art8" title="Same Title Same Journal" year="2018" journal="Journal F">
    <authors author="Henry Reporter"/>
  </entries>

</BibTeX:BibTeXFile>