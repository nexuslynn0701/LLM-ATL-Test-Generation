<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc (untitled) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="miscAlpha"/>

  <!-- Booklet (untitled, dated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="bookletBeta" year="2017"/>

  <!-- Manual (titled, no authors/dates) ->
       - unique title for TitledEntry_Title_NoArticle
       - appears in Titles List -->
  <entries xsi:type="BibTeX:Manual" id="manualGuide" title="Model Transformation Guide"/>

  <!-- TechReport #1 (titled, authored, dated) ->
       - unique title for TitledEntry_Title_NoArticle
       - distinct author -->
  <entries xsi:type="BibTeX:TechReport" id="techRep1" title="MDE Testing Techniques" year="2018">
    <authors author="Alice Smith"/>
  </entries>

  <!-- TechReport #2 (same title as techRep1) ->
       - repeats title, so TitledEntry_NoTitle_NoArticle
       - different author set -->
  <entries xsi:type="BibTeX:TechReport" id="techRep2" title="MDE Testing Techniques" year="2019">
    <authors author="Bob Johnson"/>
    <authors author="Carol White"/>
  </entries>

  <!-- Book #1 (titled, authored, dated, publisher) ->
       - unique book title for TitledEntry_Title_NoArticle
       - contributes two authors -->
  <entries xsi:type="BibTeX:Book" id="bookPatterns" title="Patterns in Model Engineering" year="2015" publisher="Springer">
    <authors author="Dan Brown"/>
    <authors author="Eve Black"/>
  </entries>

  <!-- Book #2 (same title as Book #1) ->
       - TitledEntry_NoTitle_NoArticle
       - different year/publisher/authors -->
  <entries xsi:type="BibTeX:Book" id="bookPatterns2" title="Patterns in Model Engineering" year="2016" publisher="Elsevier">
    <authors author="Frank Green"/>
  </entries>

  <!-- InBook (titled, authored, dated, publisher, chapter) ->
       - unique title for TitledEntry_Title_NoArticle
       - tests chapter and book-related fields -->
  <entries xsi:type="BibTeX:InBook" id="inbookChap3" title="Advanced MDE" year="2020" publisher="Morgan&amp;Claypool" chapter="3">
    <authors author="Grace Lee"/>
  </entries>

  <!-- InCollection (titled, authored, dated, publisher, booktitle) ->
       - title duplicates MasterThesis below to test cross-type duplication
       - booktitle used in entry formatting -->
  <entries xsi:type="BibTeX:InCollection" id="inCollSec" title="Evaluation of Transformation Tools" year="2021" publisher="ACM Press" booktitle="Proceedings of MDEConf">
    <authors author="Henry King"/>
    <authors author="Ivy Young"/>
  </entries>

  <!-- InProceedings (titled, authored, dated, booktitle; also Proceedings via inheritance) ->
       - unique title for TitledEntry_Title_NoArticle
       - different authors -->
  <entries xsi:type="BibTeX:InProceedings" id="inProcMain" title="Benchmarking ATL Transformations" year="2014" booktitle="ICMT 2014">
    <authors author="Jack Miller"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Proceedings (titled, dated) ->
       - same title as inProcMain to create shared booktitle with different type
       - no authors -->
  <entries xsi:type="BibTeX:Proceedings" id="proceedICMT" title="ICMT 2014" year="2014"/>

  <!-- Unpublished #1 (titled, authored, note) ->
       - unique title for TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="unpubDraft1" title="Unreleased MDE Results" note="Draft version">
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Unpublished #2 (same title as #1) ->
       - TitledEntry_NoTitle_NoArticle
       - different author and note -->
  <entries xsi:type="BibTeX:Unpublished" id="unpubDraft2" title="Unreleased MDE Results" note="Internal only">
    <authors author="Carol White"/>
  </entries>

  <!-- PhDThesis (titled, authored, dated, school) ->
       - unique thesis title for TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phdThesis" title="Scalable Model Transformations" year="2013" school="Tech University">
    <authors author="Laura Gray"/>
  </entries>

  <!-- MasterThesis (titled, authored, dated, school) ->
       - same title as InCollection above to test titles across types -->
  <entries xsi:type="BibTeX:MasterThesis" id="masterThesis" title="Evaluation of Transformation Tools" year="2012" school="City University">
    <authors author="Mike Stone"/>
  </entries>

  <!-- Article group A: same title, same journal -> Article_NoTitle_NoJournal on 2nd & 3rd -->
  <entries xsi:type="BibTeX:Article" id="artA1" title="Automated Test Generation" year="2010" journal="Journal of MDE">
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artA2" title="Automated Test Generation" year="2011" journal="Journal of MDE">
    <authors author="Bob Johnson"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artA3" title="Automated Test Generation" year="2012" journal="Journal of MDE">
    <authors author="Carol White"/>
  </entries>

  <!-- Article group B: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="artB1" title="Coverage Criteria for Transformations" year="2013" journal="Software Testing Journal">
    <authors author="Dan Brown"/>
  </entries>

  <!-- Article group C: same title, different journals ->
       - first: Article_Title_Journal
       - second: Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="artC1" title="Traceability in ATL" year="2014" journal="Modeling Journal">
    <authors author="Eve Black"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artC2" title="Traceability in ATL" year="2015" journal="Systems Journal">
    <authors author="Grace Lee"/>
  </entries>

  <!-- Article group D: different titles, same journal ->
       - first: Article_Title_Journal
       - second: Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="artD1" title="Refactoring Transformations" year="2016" journal="Journal of Modeling Practice">
    <authors author="Henry King"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artD2" title="Incremental MDE" year="2017" journal="Journal of Modeling Practice">
    <authors author="Ivy Young"/>
  </entries>

  <!-- Article group E: unique title, journal shared with group B is also unique there,
       so this still behaves as unique journal overall -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="artE1" title="Industrial Applications of ATL" year="2018" journal="Enterprise MDE Journal">
    <authors author="Jack Miller"/>
  </entries>

</BibTeX:BibTeXFile>