<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article group 1: same journal, same title (two articles) -->
  <!-- a1 will be chosen in title set and journal set -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Shared Title A" year="2018" journal="Journal Alpha">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- a2 duplicate: same title and journal as a1; not selected in title or journal sets -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Shared Title A" year="2019" journal="Journal Alpha">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article group 2: two different titles in the same journal -->
  <!-- a3 will be chosen in title set and journal set -->
  <entries xsi:type="BibTeX:Article" id="a3" title="Unique Title B" year="2020" journal="Journal Beta">
    <authors author="Carol White"/>
  </entries>
  <!-- a4 duplicate journal, different title; not in journal set, but its title is unique -->
  <entries xsi:type="BibTeX:Article" id="a4" title="Unique Title C" year="2021" journal="Journal Beta">
    <authors author="David Green"/>
  </entries>

  <!-- Book entries: same title, different years (exercise title-duplication for non-articles) -->
  <!-- b1 first occurrence selected for title set -->
  <entries xsi:type="BibTeX:Book" id="b1" title="Shared Book Title" year="2010" publisher="Publisher One">
    <authors author="Eve Black"/>
  </entries>
  <!-- b2 duplicate title, not selected for title set -->
  <entries xsi:type="BibTeX:Book" id="b2" title="Shared Book Title" year="2012" publisher="Publisher Two">
    <authors author="Frank Brown"/>
  </entries>

  <!-- Manual with unique title -->
  <entries xsi:type="BibTeX:Manual" id="m1" title="Tool Manual X"/>

  <!-- MasterThesis and PhDThesis with distinct titles -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Mastering MDE" year="2015" school="Tech University">
    <authors author="Grace Miller"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="pt1" title="Advanced Model Transformations" year="2016" school="Science Institute">
    <authors author="Henry Wilson"/>
  </entries>

  <!-- InBook with chapter and unique title -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Chapter on Testing" year="2013" publisher="Academic Press" chapter="7">
    <authors author="Irene Scott"/>
  </entries>

  <!-- InCollection with booktitle and unique title -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Collected Paper One" year="2011" publisher="Collections House" booktitle="Collected Works">
    <authors author="John Taylor"/>
  </entries>

  <!-- InProceedings with booktitle and unique title -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Conference Paper A" year="2017" booktitle="Proceedings of XYZ Conference">
    <authors author="Karen Adams"/>
    <authors author="Leo King"/>
  </entries>

  <!-- Proceedings with unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="pr1" title="Proceedings of XYZ Conference" year="2017"/>

  <!-- TechReport with unique title -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Technical Report on Models" year="2014">
    <authors author="Mike Davis"/>
  </entries>

  <!-- Unpublished with unique title -->
  <entries xsi:type="BibTeX:Unpublished" id="u1" title="Unreleased Draft" note="To appear soon">
    <authors author="Nina Edwards"/>
  </entries>

  <!-- Booklet: untitled dated entry (triggers UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="bl1" year="2009"/>

  <!-- Misc: completely untitled, unauthored, undated (triggers UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

</BibTeX:BibTeXFile>