<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article group A: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Graph Transformations in Practice" year="2015" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article group B: same title, same journal -> first in titleSet & journalSet -->
  <!-- triggers Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Model Synchronization Techniques" year="2016" journal="Software Systems Journal">
    <authors author="Carol White"/>
  </entries>

  <!-- Article group B: same title, same journal -> duplicate for both title and journal -->
  <!-- triggers Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Model Synchronization Techniques" year="2017" journal="Software Systems Journal">
    <authors author="David Green"/>
  </entries>

  <!-- Article group C: same title, different journal -->
  <!-- first occurrence: unique title, unique journal at selection time -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A4" title="Domain-Specific Languages Overview" year="2014" journal="Programming Concepts Review">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article group C: duplicate title but new journal -> same-title; journal becomes duplicate -->
  <!-- triggers Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Domain-Specific Languages Overview" year="2018" journal="Programming Concepts Review">
    <authors author="Eve Black"/>
  </entries>

  <!-- Article group D: different title, same journal as A1 -->
  <!-- journal already in articleSet, title new -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A6" title="Metamodel Evolution Patterns" year="2019" journal="Journal of Model Engineering">
    <authors author="Frank Martin"/>
  </entries>

  <!-- Non-article titled entries with unique titles -> TitledEntry_Title_NoArticle -->

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis" id="T1" title="Scalable Model Transformations" year="2013" school="Tech University">
    <authors author="George King"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis" id="T2" title="Testing Transformations Automatically" year="2012" school="Engineering Institute">
    <authors author="Helen Brown"/>
  </entries>

  <!-- InBook -->
  <entries xsi:type="BibTeX:InBook" id="T3" title="Practical EMF Usage" year="2011" publisher="Modeling Press" chapter="5">
    <authors author="Ian Gray"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book -->
  <entries xsi:type="BibTeX:Book" id="T4" title="Foundations of Model-Driven Engineering" year="2010" publisher="Academic House">
    <authors author="John Doe"/>
  </entries>

  <!-- InCollection -->
  <entries xsi:type="BibTeX:InCollection" id="T5" title="Reusable Transformation Components" year="2016" publisher="Springer">
    <authors author="Karen Lee"/>
  </entries>

  <!-- InProceedings -->
  <entries xsi:type="BibTeX:InProceedings" id="T6" title="Incremental Code Generation" year="2018" booktitle="MDE Conference 2018">
    <authors author="Laura Moore"/>
  </entries>

  <!-- Proceedings -->
  <entries xsi:type="BibTeX:Proceedings" id="T7" title="Proceedings of the 10th MDE Conference" year="2018">
  </entries>

  <!-- Manual (no author, no date) -->
  <entries xsi:type="BibTeX:Manual" id="T8" title="EMF Tooling Reference">
  </entries>

  <!-- Unpublished with unique title -->
  <entries xsi:type="BibTeX:Unpublished" id="T9" title="Draft on Transformation Optimization" note="To appear in 2026">
    <authors author="Michael Scott"/>
  </entries>

  <!-- TechReport with duplicated title relative to T2 -->
  <!-- "Testing Transformations Automatically" -> duplicate titled entry -->
  <!-- triggers TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="T10" title="Testing Transformations Automatically" year="2014">
    <authors author="Nina Patel"/>
  </entries>

  <!-- Another Unpublished with a new title -->
  <entries xsi:type="BibTeX:Unpublished" id="T11" title="Early Results on Bidirectional Transformations" note="Internal report">
    <authors author="Oscar Reed"/>
  </entries>

  <!-- Untitled entries (no TitledEntry) -> UntitledEntry -->

  <!-- Misc: untitled, unauthored, undated -->
  <entries xsi:type="BibTeX:Misc" id="U1">
  </entries>

  <!-- Booklet: DatedEntry only -->
  <entries xsi:type="BibTeX:Booklet" id="U2" year="2009">
  </entries>

</BibTeX:BibTeXFile>