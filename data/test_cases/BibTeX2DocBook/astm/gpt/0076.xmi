    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article group A: same title, different journals (Article_NoTitle_Journal and Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Shared Insights" year="2018" journal="Journal Alpha">
    <authors author="Alice Smith"/>
    <authors author="Bob Clark"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" title="Shared Insights" year="2019" journal="Journal Beta">
    <authors author="Carlos Ruiz"/>
  </entries>

  <!-- Article group B: different titles, same journal (Article_Title_NoJournal and Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Exploring Models" year="2020" journal="Journal Gamma">
    <authors author="Diana Prince"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" title="Advanced Modeling" year="2021" journal="Journal Gamma">
    <authors author="Evan Stone"/>
  </entries>

  <!-- Article group C: same title and same journal (Article_NoTitle_NoJournal and Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Parallel Worlds" year="2017" journal="Journal Delta">
    <authors author="Frank Hall"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" title="Parallel Worlds" year="2016" journal="Journal Delta">
    <authors author="Grace Lee"/>
  </entries>

  <!-- Single Article with unique title and unique journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="A7" title="Isolated Study" year="2015" journal="Journal Epsilon">
    <authors author="Henry King"/>
  </entries>

  <!-- Non-Article titled entries (TitledEntry_*_NoArticle) -->

