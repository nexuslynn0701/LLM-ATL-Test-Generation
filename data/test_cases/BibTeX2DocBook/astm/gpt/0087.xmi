<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Unique Insights into MDE" year="2018" journal="Journal of MDE Research">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article A2 & A3: same title, same journal -> Article_Title_Journal (A2), Article_NoTitle_NoJournal (A3) -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Duplicated Article Title" year="2019" journal="Software Engineering Today">
    <authors author="Carol Evans"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" title="Duplicated Article Title" year="2020" journal="Software Engineering Today">
    <authors author="Daniel Wright"/>
  </entries>

  <!-- Article A4 & A5: same title, different journals -> Article_Title_Journal (A4), Article_NoTitle_Journal (A5) -->
  <entries xsi:type="BibTeX:Article" id="A4" title="Cross-Journal Study" year="2021" journal="Systems Journal">
    <authors author="Eve Thompson"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" title="Cross-Journal Study" year="2022" journal="International Review of Computing">
    <authors author="Frank Martin"/>
  </entries>

  <!-- Article A6 & A7: different titles, same journal -> Article_Title_Journal (A6), Article_Title_NoJournal (A7) -->
  <entries xsi:type="BibTeX:Article" id="A6" title="First in Shared Journal" year="2017" journal="Shared Journal of Informatics">
    <authors author="Grace Lee"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" title="Second in Shared Journal" year="2017" journal="Shared Journal of Informatics">
    <authors author="Henry Clark"/>
  </entries>

  <!-- Book B1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Foundations of Model Transformation" year="2015" publisher="Academic Press">
    <authors author="Ian Walker"/>
    <authors author="Julia Adams"/>
  </entries>

  <!-- Book B2 & B3: same title -> TitledEntry_Title_NoArticle (B2), TitledEntry_NoTitle_NoArticle (B3) -->
  <entries xsi:type="BibTeX:Book" id="B2" title="Repeated Book Title" year="2010" publisher="TechBooks Ltd.">
    <authors author="Kevin Brown"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="B3" title="Repeated Book Title" year="2011" publisher="TechBooks Ltd.">
    <authors author="Laura Davis"/>
  </entries>

  <!-- PhDThesis PHD1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Model-Driven Testing Approaches" year="2016" school="University of Example">
    <authors author="Michael Scott"/>
  </entries>

  <!-- MasterThesis MST1 & MST2: same title -> TitledEntry_Title_NoArticle (MST1), TitledEntry_NoTitle_NoArticle (MST2) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MST1" title="Empirical Studies in MDE" year="2014" school="Tech University">
    <authors author="Nancy Green"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MST2" title="Empirical Studies in MDE" year="2013" school="Science Institute">
    <authors author="Oscar King"/>
  </entries>

  <!-- InBook IB1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chapter-Level Transformations" year="2012" publisher="Scholarly House" chapter="3">
    <authors author="Paul Young"/>
  </entries>

  <!-- InCollection IC1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Collected Works on DSLs" year="2011" publisher="Collections Press">
    <authors author="Quentin Hall"/>
  </entries>

  <!-- InProceedings IP1: unique title, uses Proceedings (via inheritance) and BookTitledEntry -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Proceedings Paper on ATL" year="2019" booktitle="Proceedings of the MDE Conference">
    <authors author="Rachel Scott"/>
  </entries>

  <!-- Proceedings PR1 & PR2: same title -> TitledEntry_Title_NoArticle (PR1), TitledEntry_NoTitle_NoArticle (PR2) -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" title="Symposium on Model Engineering" year="2018"/>
  <entries xsi:type="BibTeX:Proceedings" id="PR2" title="Symposium on Model Engineering" year="2019"/>

  <!-- Manual M1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="ATL User Manual"/>

  <!-- Unpublished U1 & U2: same title, note included -> TitledEntry_Title_NoArticle (U1), TitledEntry_NoTitle_NoArticle (U2) -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Draft on Transformation Testing" note="Submitted for review">
    <authors author="Susan Parker"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Draft on Transformation Testing" note="Work in progress">
    <authors author="Tom Richards"/>
  </entries>

  <!-- TechReport TR1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Industrial Report on MDE Tools" year="2010">
    <authors author="Uma Patel"/>
  </entries>

  <!-- Misc entries: untitled (non-TitledEntry) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MISC1"/>
  <entries xsi:type="BibTeX:Misc" id="MISC2"/>

  <!-- Booklet entries: DatedEntry but not TitledEntry -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="BKLT1" year="2009"/>
  <entries xsi:type="BibTeX:Booklet" id="BKLT2" year="2011"/>

</BibTeX:BibTeXFile>