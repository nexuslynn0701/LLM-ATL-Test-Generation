<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article group 1: same title, same journal (exercise Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article"
           id="art1"
           title="Shared Title A"
           year="2019"
           journal="Journal X">
    <authors author="Alice Alpha"/>
  </entries>
  <entries xsi:type="BibTeX:Article"
           id="art2"
           title="Shared Title A"
           year="2020"
           journal="Journal X">
    <authors author="Bob Beta"/>
  </entries>

  <!-- Article group 2: same title, different journals (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article"
           id="art3"
           title="Shared Title B"
           year="2018"
           journal="Journal Y">
    <authors author="Charlie Gamma"/>
  </entries>
  <entries xsi:type="BibTeX:Article"
           id="art4"
           title="Shared Title B"
           year="2017"
           journal="Journal Z">
    <authors author="Dana Delta"/>
  </entries>

  <!-- Article group 3: different titles, same journal (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article"
           id="art5"
           title="Unique Title C1"
           year="2016"
           journal="Journal W">
    <authors author="Evan Epsilon"/>
  </entries>
  <entries xsi:type="BibTeX:Article"
           id="art6"
           title="Unique Title C2"
           year="2015"
           journal="Journal W">
    <authors author="Fay Phi"/>
  </entries>

  <!-- Article group 4: distinct title and journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article"
           id="art7"
           title="Lone Title D"
           year="2021"
           journal="Solo Journal">
    <authors author="George Gamma"/>
  </entries>

  <!-- Titled non-Article entries:
       One unique title (TitledEntry_Title_NoArticle) and
       two with the same title (TitledEntry_Title_NoArticle + TitledEntry_NoTitle_NoArticle) -->

  <!-- Unique title for non-article -->
  <entries xsi:type="BibTeX:Book"
           id="book1"
           title="Unique Book U1"
           year="2014"
           publisher="Publisher One">
    <authors author="Helen Eta"/>
    <authors author="Ian Iota"/>
  </entries>

  <!-- Duplicate title across different non-article types -->
  <!-- First occurrence kept in titledEntrySet -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr1"
           title="Repeated NonArticle Title"
           year="2013">
    <authors author="Jack Kappa"/>
  </entries>

  <!-- Second occurrence excluded from titledEntrySet -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd1"
           title="Repeated NonArticle Title"
           year="2012"
           school="Tech University">
    <authors author="Laura Lambda"/>
  </entries>

  <!-- Untitled entries (not TitledEntry) for UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc"
           id="misc1"/>
  <entries xsi:type="BibTeX:Booklet"
           id="booklet1"
           year="2011"/>

</BibTeX:BibTeXFile>