<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Unique Insights into Modeling"
           year="2018"
           journal="Journal of Exclusive Studies">
    <authors author="Alice Unique"/>
  </entries>

  <!-- Article A2 & A3: same title, same journal -> one Article_Title_Journal, one Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Repeated Title Same Journal"
           year="2019"
           journal="International Modeling Journal">
    <authors author="Bob Shared"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Repeated Title Same Journal"
           year="2020"
           journal="International Modeling Journal">
    <authors author="Carol Shared"/>
  </entries>

  <!-- Article A4 & A5: same title, different journals -> one Article_Title_Journal, one Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Cross-Journal Case Study"
           year="2021"
           journal="Model Engineering Letters">
    <authors author="Dave Cross"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Cross-Journal Case Study"
           year="2022"
           journal="Systems Analysis Review">
    <authors author="Eve Cross"/>
  </entries>

  <!-- Article A6 & A7: different titles, same journal -> one Article_Title_Journal, one Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="First in Shared Journal"
           year="2017"
           journal="Unified Modeling Quarterly">
    <authors author="Frank Journal"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Second in Shared Journal"
           year="2017"
           journal="Unified Modeling Quarterly">
    <authors author="Grace Journal"/>
  </entries>

  <!-- TechReport T1 & T2: same title -> TitledEntry_Title_NoArticle and TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Duplicated TechReport Title"
           year="2016">
    <authors author="Henry Report"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport"
           id="TR2"
           title="Duplicated TechReport Title"
           year="2016">
    <authors author="Ivy Report"/>
  </entries>

  <!-- Book B1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Standalone Book on Modeling"
           year="2015"
           publisher="Modeling Press">
    <authors author="John Book"/>
  </entries>

  <!-- InBook IB1: unique title, own chapter, shares publisher with B1 but still independent title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Chapter-Based Modeling"
           year="2014"
           publisher="Modeling Press"
           chapter="3">
    <authors author="Karen Chapter"/>
  </entries>

  <!-- InCollection IC1: same title as B1 to create another duplicate-title pair for non-articles -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Standalone Book on Modeling"
           year="2015"
           publisher="Advanced Collections">
    <authors author="Laura Collection"/>
  </entries>

  <!-- Manual M1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual"
           id="M1"
           title="Modeling Tool Reference Manual"/>
  
  <!-- Proceedings P1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings"
           id="P1"
           title="Proceedings of the Modeling Conference"
           year="2013"/>
  
  <!-- InProceedings IP1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Paper in Modeling Conference"
           year="2013"
           booktitle="Proceedings of the Modeling Conference">
    <authors author="Mike InProc"/>
  </entries>

  <!-- PhDThesis and MasterThesis: same title -> one Title, one NoTitle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Unified Model Transformations"
           year="2012"
           school="Tech University">
    <authors author="Nina PhD"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis"
           id="MSC1"
           title="Unified Model Transformations"
           year="2011"
           school="Tech University">
    <authors author="Oscar MSc"/>
  </entries>

  <!-- Unpublished U1 & U2: same title -> one Title, one NoTitle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Early Draft on Modeling"
           note="Draft version">
    <authors author="Pat Unpub"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="U2"
           title="Early Draft on Modeling"
           note="Second draft">
    <authors author="Quinn Unpub"/>
  </entries>

  <!-- Booklet BL1: Dated but untitled (no TitledEntry) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet"
           id="BL1"
           year="2010"/>
  
  <!-- Misc MISC1: completely untitled and undated -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="MISC1"/>

</BibTeX:BibTeXFile>