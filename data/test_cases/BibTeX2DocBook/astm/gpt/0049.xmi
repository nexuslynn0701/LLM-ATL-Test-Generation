<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles (various title/journal duplication patterns) -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Alpha Studies" year="2020" journal="Journal A">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- A2: same title as A3, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Duplicate Title" year="2021" journal="Journal B">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- A3: same title as A2, same journal as A4 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Duplicate Title" year="2022" journal="Journal C">
    <authors author="Dave Delta"/>
  </entries>

  <!-- A4: unique title, same journal as A3 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" title="Gamma Insights" year="2023" journal="Journal C">
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- A5: another unique article to enrich sets -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Zeta Explorations" year="2019" journal="Journal D">
    <authors author="Frank Zeta"/>
    <authors author="Alice Alpha"/>
  </entries>

  <!-- TechReport (titled, non-Article, unique title) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Report One" year="2018">
    <authors author="Henry Eta"/>
  </entries>

  <!-- Two Books with same title -> first: TitledEntry_Title_NoArticle, second: TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Shared Book Title" year="2015" publisher="Pub One">
    <authors author="Ivy Theta"/>
  </entries>

  <entries xsi:type="BibTeX:Book" id="B2" title="Shared Book Title" year="2016" publisher="Pub Two">
    <authors author="Jack Iota"/>
  </entries>

  <!-- InBook with same title as B1/B2 (still considered for title-duplication handling) -->
  <!-- This will also be treated via the TitledEntry_NoTitle_NoArticle rule because its title duplicates -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Shared Book Title" year="2017" publisher="Pub Three" chapter="3">
    <authors author="Karen Kappa"/>
  </entries>

  <!-- PhDThesis with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Doctoral Research" year="2014" school="Tech University">
    <authors author="Leo Lambda"/>
  </entries>

  <!-- MasterThesis with same title as PHD1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MST1" title="Doctoral Research" year="2013" school="Science College">
    <authors author="Mia Mu"/>
  </entries>

  <!-- InProceedings with unique title and booktitle -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Conference Paper One" year="2011" booktitle="Conf A">
    <authors author="Ned Nu"/>
  </entries>

  <!-- Proceedings with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" title="Proceedings of Conf B" year="2010"/>
  
  <!-- Manual with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="Tool Manual"/>
  
  <!-- Unpublished with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="UNP1" title="Working Draft" note="In preparation">
    <authors author="Oscar Omicron"/>
  </entries>

  <!-- Unpublished sharing title with MAN1 to force NoTitle variant on one of them -->
  <entries xsi:type="BibTeX:Unpublished" id="UNP2" title="Tool Manual" note="Draft version">
    <authors author="Paul Pi"/>
  </entries>

  <!-- Misc (untitled entry) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MISC1"/>

  <!-- Booklet (dated but untitled) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="BKL1" year="2009"/>

</BibTeX:BibTeXFile>