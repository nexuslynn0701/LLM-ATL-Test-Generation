<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article group 1: same title, same journal => one in Article_NoTitle_NoJournal, one in Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Shared Title 1" year="2018" journal="International Journal of Testing">
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" title="Shared Title 1" year="2019" journal="International Journal of Testing">
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article group 2: same title, different journal => Article_NoTitle_Journal for A4 -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Shared Title 2" year="2020" journal="Software Engineering Notes">
    <authors author="Carol White"/>
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" title="Shared Title 2" year="2021" journal="Journal of Software Studies">
    <authors author="David Black"/>
  </entries>

  <!-- Article group 3: unique title, journal repeated with A6 => Article_Title_NoJournal for A5 -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Unique Title 3" year="2017" journal="Transactions on Modeling">
    <authors author="Eve Green"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" title="Another Title in Same Journal" year="2016" journal="Transactions on Modeling">
    <authors author="Frank Brown"/>
  </entries>

  <!-- Article group 4: unique title and unique journal => Article_Title_Journal for A7 -->
  <entries xsi:type="BibTeX:Article" id="A7" title="Standalone Article" year="2015" journal="Isolated Journal of Computing">
    <authors author="Grace Hall"/>
    <authors author="Henry King"/>
  </entries>

  <!-- Titled, non-Article entries: distinct titles => TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Unique Book Title" year="2010" publisher="Global Press">
    <authors author="Alice Smith"/>
    <authors author="Ian Miller"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Conference Paper Title" year="2012" booktitle="Proceedings of MDE Conference">
    <authors author="John Doe"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Tech Report Title" year="2013">
    <authors author="Carol White"/>
  </entries>

  <!-- Titled, non-Article entries: duplicated title => first in TitledEntry_Title_NoArticle, second in TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Duplicated Thesis Title" year="2011" school="Tech University">
    <authors author="Bob Jones"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MST1" title="Duplicated Thesis Title" year="2014" school="Science Institute">
    <authors author="David Black"/>
  </entries>

  <!-- Untitled entries (not TitledEntry): trigger UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MISC1"/>
  <entries xsi:type="BibTeX:Booklet" id="BKL1" year="2009"/>

</BibTeX:BibTeXFile>