  <!-- InProceedings and Proceedings with same title to create title duplicates across types -->
  <entries xsi:type="BibTeX:Proceedings" id="p1" title="ICMT 2015" year="2015"/>
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="ICMT 2015" year="2015" booktitle="Proceedings of ICMT 2015">
