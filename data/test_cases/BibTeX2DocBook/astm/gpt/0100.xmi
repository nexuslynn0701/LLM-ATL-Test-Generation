    <authors author="Jack Orange"/>
    <authors author="Karen Silver"/>
  </entries>

  <!-- TechReports: group with duplicate title to trigger Title_NoTitle_NoArticle and Title_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Metamodel Evolution" year="2011">
    <authors author="Laura Copper"/>
  </entries>
