<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- UntitledEntry: Misc (no title, no authors, no date) -->
  <entries xsi:type="BibTeX:Misc" id="miscA"/>

  <!-- UntitledEntry: Booklet (dated, but no title/authors) -->
  <entries xsi:type="BibTeX:Booklet" id="bookletA" year="2015"/>

  <!-- TitledEntry_Title_NoArticle: PhDThesis with unique title -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd_unique" title="Unique PhD Thesis" year="2018" school="Tech University">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TitledEntry_NoTitle_NoArticle: two MasterThesis entries sharing same title -->
  <!-- First occurrence of the title goes into the 'distinct title' set -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" title="Shared Thesis Title" year="2019" school="Science Institute">
    <authors author="Carol White"/>
  </entries>

  <!-- Duplicate title: should NOT be in distinct-title set -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst2" title="Shared Thesis Title" year="2020" school="Science Institute">
    <authors author="David Black"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle: Book with unique title -->
  <entries xsi:type="BibTeX:Book" id="book_unique" title="Model Engineering Handbook" year="2012" publisher="Modeling Press">
    <authors author="Emily Green"/>
  </entries>

  <!-- TitledEntry_NoTitle_NoArticle: two InBook entries sharing same title -->
  <!-- First occurrence of repeated title -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Chapter on Testing" year="2013" publisher="Software House" chapter="3">
    <authors author="Frank Brown"/>
  </entries>

  <!-- Second occurrence of repeated title -->
  <entries xsi:type="BibTeX:InBook" id="inbook2" title="Chapter on Testing" year="2014" publisher="Software House" chapter="5">
    <authors author="Grace Miller"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle: InCollection, unique title -->
  <entries xsi:type="BibTeX:InCollection" id="incollection_unique" title="Collected Papers in MDE" year="2011" publisher="Collections Pub" booktitle="Proceedings of MDE Symposium">
    <authors author="Henry Adams"/>
  </entries>

  <!-- TitledEntry_NoTitle_NoArticle: InProceedings duplicates by title -->
  <!-- First occurrence -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Conference Paper on Transformation" year="2016" booktitle="Intl. Conf. on Transformations">
    <authors author="Ivy Scott"/>
  </entries>

  <!-- Second occurrence -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" title="Conference Paper on Transformation" year="2017" booktitle="Intl. Conf. on Transformations">
    <authors author="Jack Turner"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle: Proceedings unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc_unique" title="Proceedings of the Testing Conference" year="2010"/>

  <!-- TitledEntry_NoTitle_NoArticle: Manual duplicated title -->
  <!-- First occurrence -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="Tool User Guide"/>
  <!-- Second occurrence -->
  <entries xsi:type="BibTeX:Manual" id="manual2" title="Tool User Guide"/>

  <!-- TitledEntry_Title_NoArticle: Unpublished with unique title -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub_unique" title="Draft on Model Transformations" note="Work in progress">
    <authors author="Laura King"/>
  </entries>

  <!-- TitledEntry_NoTitle_NoArticle: TechReport duplicated title -->
  <!-- First occurrence -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Annual Report on MDE" year="2021">
    <authors author="Mike Dean"/>
  </entries>
  <!-- Second occurrence -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="Annual Report on MDE" year="2022">
    <authors author="Nina Rose"/>
  </entries>

  <!-- Articles for all four article rules -->

  <!-- Article_Title_Journal: unique title, unique journal -->
  <entries xsi:type="BibTeX:Article" id="art_unique" title="Single Article" year="2009" journal="Journal of Single Cases">
    <authors author="Oliver Stone"/>
  </entries>

  <!-- Article_NoTitle_NoJournal: two articles with same title AND same journal -->
  <!-- First occurrence -->
  <entries xsi:type="BibTeX:Article" id="art_ttjj_1" title="Cloned Study" year="2011" journal="Journal of Duplicates">
    <authors author="Paul Reed"/>
  </entries>
  <!-- Second occurrence -->
  <entries xsi:type="BibTeX:Article" id="art_ttjj_2" title="Cloned Study" year="2012" journal="Journal of Duplicates">
    <authors author="Quinn Ford"/>
  </entries>

  <!-- Article_NoTitle_Journal: same title, different journals -->
  <!-- First occurrence: goes into title-set, and also into journal-set -->
  <entries xsi:type="BibTeX:Article" id="art_t_same_1" title="Repeated Title Only" year="2013" journal="Journal A">
    <authors author="Rachel Young"/>
  </entries>
  <!-- Second occurrence: same title, new journal => in journal-set, but not in title-set -->
  <entries xsi:type="BibTeX:Article" id="art_t_same_2" title="Repeated Title Only" year="2014" journal="Journal B">
    <authors author="Steve Cole"/>
  </entries>

  <!-- Article_Title_NoJournal: same journal, different titles -->
  <!-- First occurrence: goes into all-unique article journal-set -->
  <entries xsi:type="BibTeX:Article" id="art_j_same_1" title="First in Common Journal" year="2015" journal="Shared Journal">
    <authors author="Tom Gray"/>
  </entries>
  <!-- Second occurrence: same journal, different title; not included in journal-set -->
  <entries xsi:type="BibTeX:Article" id="art_j_same_2" title="Second in Common Journal" year="2016" journal="Shared Journal">
    <authors author="Uma Hill"/>
  </entries>

</BibTeX:BibTeXFile>