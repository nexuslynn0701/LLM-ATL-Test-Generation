  <entries xsi:type="BibTeX:Article" id="a4" title="Data Structures" year="2019" journal="Systems Journal">
    <authors author="Barbara Liskov"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a5" title="Data Structures" year="2020" journal="Programming Journal">
