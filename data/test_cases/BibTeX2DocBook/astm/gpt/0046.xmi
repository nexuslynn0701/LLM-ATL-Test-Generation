    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries to trigger R3 (Misc, Booklet) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Booklet" id="bkt1" year="2018"/>

  <!-- Articles in same journal, all with distinct titles
       -> R6 (Article_Title_Journal) for all three -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Graph Algorithms" year="2020" journal="Journal of Computing">
    <authors author="Alan Turing"/>
    <authors author="Grace Hopper"/>
  </entries>
