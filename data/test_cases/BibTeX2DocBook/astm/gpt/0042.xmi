<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article that is first for its title and first for its journal:
       triggers Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="MDE Foundations"
           year="2018"
           journal="Journal of MDE">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article same title & same journal as A1: triggers Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="MDE Foundations"
           year="2019"
           journal="Journal of MDE">
    <authors author="Carol White"/>
  </entries>

  <!-- Article new title, but same journal as A1/A2:
       not picked in articleSet (journal duplicated) but first for its title:
       triggers Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Advanced ATL Transformations"
           year="2020"
           journal="Journal of MDE">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article with new journal but duplicate title with A3:
       picked in articleSet (unique journal) but not in titledEntrySet:
       triggers Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Advanced ATL Transformations"
           year="2021"
           journal="Software Modeling Today">
    <authors author="David Black"/>
  </entries>

  <!-- Book with unique title: in titledEntrySet, non-Article:
       triggers TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Model-Driven Engineering in Practice"
           year="2015"
           publisher="TechPress">
    <authors author="Emily Green"/>
    <authors author="Frank Brown"/>
  </entries>

  <!-- Another Book with different unique title:
       triggers TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B2"
           title="Transformations and Verification"
           year="2017"
           publisher="Academic Press">
    <authors author="George Gray"/>
  </entries>

  <!-- MasterThesis first with its title: in titledEntrySet:
       triggers TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Testing Model Transformations"
           year="2016"
           school="University of Engineering">
    <authors author="Helen Brown"/>
  </entries>

  <!-- MasterThesis second with same title as MT1:
       duplicate title, not in titledEntrySet:
       triggers TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT2"
           title="Testing Model Transformations"
           year="2017"
           school="Institute of Software Science">
    <authors author="Ian Orange"/>
  </entries>

  <!-- Misc entry (not TitledEntry): triggers UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="M1"/>
  
  <!-- Booklet entry (DatedEntry but not TitledEntry): triggers UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet"
           id="BL1"
           year="2014"/>

  <!-- TechReport with unique title: in titledEntrySet,
       Authored & Dated: triggers TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="ATL Performance Evaluation"
           year="2013">
    <authors author="Jack Silver"/>
    <authors author="Karen Gold"/>
  </entries>

  <!-- Unpublished with unique title and note: in titledEntrySet:
       triggers TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Unreleased Transformation Study"
           note="Draft version, not for distribution">
    <authors author="Laura Violet"/>
  </entries>

  <!-- InBook with unique title: in titledEntrySet:
       triggers TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Chapter on Traceability"
           year="2012"
           publisher="Modeling House"
           chapter="3">
    <authors author="Michael Blue"/>
  </entries>

  <!-- PhDThesis with unique title: in titledEntrySet:
       triggers TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Scalable Model Transformation Testing"
           year="2011"
           school="Polytechnic University">
    <authors author="Nina Indigo"/>
  </entries>

  <!-- InProceedings with unique title and booktitle: in titledEntrySet:
       triggers TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Incremental Transformations"
           year="2019"
           booktitle="Proceedings of the MDE Symposium">
    <authors author="Oscar Pink"/>
    <authors author="Paul Lime"/>
  </entries>

  <!-- Manual with unique title: in titledEntrySet:
       triggers TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual"
           id="MAN1"
           title="ATL User Guide"/>
</BibTeX:BibTeXFile>