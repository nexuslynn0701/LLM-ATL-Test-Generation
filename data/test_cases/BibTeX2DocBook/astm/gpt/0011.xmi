<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="a1"
           title="Unique Article Title 1"
           year="2018"
           journal="Journal A">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article A2: same title as A3, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="a2"
           title="Shared Article Title"
           year="2019"
           journal="Journal B">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article A3: same title as A2, same journal as A4 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="a3"
           title="Shared Article Title"
           year="2020"
           journal="Journal C">
    <authors author="Charlie Brown"/>
  </entries>

  <!-- Article A4: unique title, same journal as A3 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="a4"
           title="Another Unique Title"
           year="2021"
           journal="Journal C">
    <authors author="Dana White"/>
  </entries>

  <!-- Book B1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="b1"
           title="Unique Book Title"
           year="2010"
           publisher="Publisher One">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book B2: first occurrence of duplicated title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="b2"
           title="Duplicated Book Title"
           year="2011"
           publisher="Publisher Two">
    <authors author="Bob Jones"/>
  </entries>

  <!-- Book B3: same title as B2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="b3"
           title="Duplicated Book Title"
           year="2012"
           publisher="Publisher Three">
    <authors author="Charlie Brown"/>
  </entries>

  <!-- InBook IB1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook"
           id="ib1"
           title="InBook Title"
           year="2013"
           publisher="Publisher Four"
           chapter="5">
    <authors author="Dana White"/>
    <authors author="Eve Adams"/>
  </entries>

  <!-- InCollection IC1: shares title with MT1 and PT1 (first occurrence) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection"
           id="ic1"
           title="Thesis and Collection Shared Title"
           year="2014"
           publisher="Publisher Five">
    <authors author="Frank Green"/>
  </entries>

  <!-- MasterThesis MT1: same title as IC1 and PT1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mt1"
           title="Thesis and Collection Shared Title"
           year="2015"
           school="Tech University">
    <authors author="George Hall"/>
  </entries>

  <!-- PhDThesis PT1: same title as IC1 and MT1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="pt1"
           title="Thesis and Collection Shared Title"
           year="2016"
           school="Science Institute">
    <authors author="Helen King"/>
  </entries>

  <!-- TechReport TR1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr1"
           title="TechReport Unique"
           year="2017">
    <authors author="Ian Lee"/>
  </entries>

  <!-- Unpublished U1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="u1"
           title="Unpublished Work 1"
           note="To appear">
    <authors author="John Doe"/>
  </entries>

  <!-- Unpublished U2: same title as U3 (first occurrence) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="u2"
           title="Repeated Unpublished Title"
           note="Draft version">
    <authors author="John Doe"/>
  </entries>

  <!-- Unpublished U3: same title as U2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="u3"
           title="Repeated Unpublished Title"
           note="Extended abstract">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Manual M1: titled, no authors, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual"
           id="m1"
           title="Software Manual 1"/>
           
  <!-- Proceedings P1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings"
           id="p1"
           title="Proceedings 2020"
           year="2020"/>

  <!-- InProceedings IP1: unique title, references a booktitle, has authors and year -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="ip1"
           title="Conference Paper 1"
           year="2020"
           booktitle="Proceedings 2020">
    <authors author="Eve Adams"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- Booklet BL1: untitled (DatedEntry only) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet"
           id="bl1"
           year="2009"/>

  <!-- Misc MS1: untitled, no other features -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="ms1"/>

</BibTeX:BibTeXFile>