<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to trigger all Article* rules -->
  <!-- A1: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Unique Insights into MDE"
           year="2018"
           journal="Journal of Unique Studies">
    <authors author="Alice Unique"/>
  </entries>

  <!-- A2 & A3: same title, different journals -->
  <!-- A2 will be in title-set, journal-set -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Title Across Journals"
           year="2019"
           journal="Journal One">
    <authors author="Bob Shared"/>
  </entries>

  <!-- A3: duplicate title, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Shared Title Across Journals"
           year="2020"
           journal="Journal Two">
    <authors author="Carol Shared"/>
  </entries>

  <!-- A4 & A5: same journal, different titles -->
  <!-- A4: first in that journal and unique title -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="First in Same Journal"
           year="2021"
           journal="Common Journal">
    <authors author="Dave Common"/>
  </entries>

  <!-- A5: same journal as A4, unique title -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Second in Same Journal"
           year="2022"
           journal="Common Journal">
    <authors author="Eve Common"/>
  </entries>

  <!-- A6 & A7: same title and same journal -->
  <!-- A6: first occurrence -> Article_Title_NoJournal (in title-set, not in journal-set) -->
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Twin Paper"
           year="2017"
           journal="Twin Journal">
    <authors author="Frank Twin"/>
  </entries>

  <!-- A7: duplicate title and journal -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Twin Paper"
           year="2017"
           journal="Twin Journal">
    <authors author="Grace Twin"/>
  </entries>

  <!-- Non-article titled entries to trigger TitledEntry* rules -->

  <!-- B1 & B2: Books with same title and same publisher/year -->
  <!-- B1 will be in titledEntrySet -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Model-Driven Book"
           year="2015"
           publisher="TechPress">
    <authors author="Henry Author"/>
  </entries>

  <!-- B2: same title as B1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B2"
           title="Model-Driven Book"
           year="2016"
           publisher="TechPress">
    <authors author="Ivy Author"/>
  </entries>

  <!-- MT1 & MT2: MasterThesis with same title -->
  <!-- MT1 in title-set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Thesis on Transformation"
           year="2014"
           school="University A">
    <authors author="Jack Thesis"/>
  </entries>

  <!-- MT2: duplicate title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT2"
           title="Thesis on Transformation"
           year="2014"
           school="University B">
    <authors author="Kate Thesis"/>
  </entries>

  <!-- PHD1: unique PhDThesis title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Advanced MDE Research"
           year="2013"
           school="Institute of Technology">
    <authors author="Liam Doctor"/>
  </entries>

  <!-- IB1: InBook with chapter -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="InBook Entry Title"
           year="2012"
           publisher="BookHouse"
           chapter="3">
    <authors author="Mia Chapter"/>
  </entries>

  <!-- IC1: InCollection with booktitle -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Collected Works on MDE"
           year="2011"
           publisher="CollectionPub">
    <authors author="Nina Collection"/>
  </entries>

  <!-- IP1: InProceedings (also BookTitledEntry and Proceedings via inheritance) -->
  <!-- Unique title, booktitle, and year -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Conference Paper on MDE"
           year="2010"
           booktitle="Proceedings of MDEConf">
    <authors author="Oscar Conference"/>
  </entries>

  <!-- PR1: Proceedings (titled and dated) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings"
           id="PR1"
           title="Proceedings of AnotherConf"
           year="2009"/>
  
  <!-- MAN1: Manual -> titled only -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual"
           id="MAN1"
           title="User Guide for ToolX"/>

  <!-- UNP1 & UNP2: Unpublished with same title but different notes -->
  <!-- UNP1: in title-set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="UNP1"
           title="Draft on MDE"
           note="First draft">
    <authors author="Paul Draft"/>
  </entries>

  <!-- UNP2: duplicate title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="UNP2"
           title="Draft on MDE"
           note="Revised draft">
    <authors author="Quinn Draft"/>
  </entries>

  <!-- TR1: TechReport -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Technical Report on Transformations"
           year="2008">
    <authors author="Rita Report"/>
  </entries>

  <!-- Untitled entries to trigger UntitledEntry rule -->

  <!-- MISC1 & MISC2: Misc entries (no title) -->
  <entries xsi:type="BibTeX:Misc"
           id="MISC1"/>
  <entries xsi:type="BibTeX:Misc"
           id="MISC2"/>

  <!-- BOOKLET1: Booklet (dated, no title) -->
  <entries xsi:type="BibTeX:Booklet"
           id="BOOKLET1"
           year="2007"/>

</BibTeX:BibTeXFile>