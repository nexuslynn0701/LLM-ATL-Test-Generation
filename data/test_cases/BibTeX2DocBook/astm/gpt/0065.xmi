<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- A1: Article, unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="artUnique1" title="Unique Insights into MDE" year="2019" journal="Journal of Unique Software">
    <authors author="Alice Unique"/>
    <authors author="Bob Unique"/>
  </entries>

  <!-- A2 & A3: same title, different journals -> Article_Title_Journal (first), Article_NoTitle_Journal (second) -->
  <entries xsi:type="BibTeX:Article" id="artSameTitle1" title="Repeated Title Study" year="2020" journal="Journal A">
    <authors author="Carol Title"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artSameTitle2" title="Repeated Title Study" year="2021" journal="Journal B">
    <authors author="Dave Title"/>
  </entries>

  <!-- A4 & A5: different titles, same journal -> Article_Title_Journal (first), Article_Title_NoJournal (second) -->
  <entries xsi:type="BibTeX:Article" id="artSameJournal1" title="First Journal Entry" year="2018" journal="Shared Journal">
    <authors author="Eve Journal"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artSameJournal2" title="Second Journal Entry" year="2018" journal="Shared Journal">
    <authors author="Frank Journal"/>
  </entries>

  <!-- A6 & A7: same title and same journal -> Article_Title_Journal (first), Article_NoTitle_NoJournal (second) -->
  <entries xsi:type="BibTeX:Article" id="artSameBoth1" title="Cloned Study" year="2017" journal="Clone Journal">
    <authors author="Grace Clone"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artSameBoth2" title="Cloned Study" year="2017" journal="Clone Journal">
    <authors author="Heidi Clone"/>
  </entries>

  <!-- B1 & B2: Books with same title -> first in distinct-title set, second outside -->
  <entries xsi:type="BibTeX:Book" id="bookMulti1" title="MDE Foundations" year="2015" publisher="Famous Publisher">
    <authors author="Ian Book"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="bookMulti2" title="MDE Foundations" year="2016" publisher="Another Publisher">
    <authors author="Jack Book"/>
  </entries>

  <!-- B3: Book with unique title -->
  <entries xsi:type="BibTeX:Book" id="bookUnique" title="Isolated Book Title" year="2014" publisher="Solo Publisher">
    <authors author="Karen Solo"/>
  </entries>

  <!-- C1: MasterThesis (ThesisEntry) unique title -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" title="Mastering Transformations" year="2013" school="Tech University">
    <authors author="Liam Master"/>
  </entries>

  <!-- C2: PhDThesis (ThesisEntry) unique title -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Topics in MDE" year="2012" school="Research Institute">
    <authors author="Mia Doctor"/>
  </entries>

  <!-- D1 & D2: InBook with same title, different chapters -> first in distinct-title set, second outside -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Chaptered MDE" year="2011" publisher="Chapter Press" chapter="1">
    <authors author="Noah InBook"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="inbook2" title="Chaptered MDE" year="2011" publisher="Chapter Press" chapter="2">
    <authors author="Olivia InBook"/>
  </entries>

  <!-- E1: InCollection with unique title and booktitle -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Collection Piece" year="2010" publisher="Collection House" booktitle="Collected Works on MDE">
    <authors author="Paul Collection"/>
  </entries>

  <!-- F1 & F2: InProceedings with same title -> first in distinct-title set, second outside -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Conference Paper" year="2009" booktitle="MDE Conference 2009">
    <authors author="Quinn Conf"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" title="Conference Paper" year="2010" booktitle="MDE Conference 2010">
    <authors author="Riley Conf"/>
  </entries>

  <!-- G1: Proceedings (Titled, Dated) unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proceedings of MDE 2008" year="2008"/>

  <!-- H1 & H2: Manual with same title -> first in set, second outside -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Tool Manual v1"/>
  <entries xsi:type="BibTeX:Manual" id="man2" title="Tool Manual v1"/>

  <!-- I1 & I2: TechReport with same title -> first in set, second outside -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Technical Report on MDE" year="2007">
    <authors author="Sam Report"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="Technical Report on MDE" year="2007">
    <authors author="Taylor Report"/>
  </entries>

  <!-- J1 & J2: Unpublished with same title -> first in set, second outside -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Unreleased Draft" note="To appear soon">
    <authors author="Uma Unpub"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Unreleased Draft" note="Withdrawn">
    <authors author="Victor Unpub"/>
  </entries>

  <!-- K1 & K2: Misc and Booklet (untitled entries) to trigger UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="miscItem1"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2006"/>

</BibTeX:BibTeXFile>