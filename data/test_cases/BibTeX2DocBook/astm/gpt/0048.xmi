<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- A Misc entry: untitled, unauthored, undated => R3 (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="miscUnique"/>

  <!-- A Booklet entry: dated but not titled/authored => R3 (UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="bookletYearOnly" year="2010"/>

  <!-- Two Books with distinct titles, both should be in titled set => R4 (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Book" id="bookOne" title="MDE in Practice" year="2015" publisher="TechPress">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <entries xsi:type="BibTeX:Book" id="bookTwo" title="Advanced ATL" year="2016" publisher="ModelingHouse">
    <authors author="Carol Developer"/>
  </entries>

  <!-- Two MasterThesis with the same title:
       first goes to titled set => R4;
       second does NOT => R5 -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Common Title" year="2018" school="Uni A">
    <authors author="Dave Student"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis" id="mt2" title="Common Title" year="2019" school="Uni B">
    <authors author="Eve Student"/>
  </entries>

  <!-- Two Articles, distinct title and journal:
       both in title set and journal set => R6 (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art1" title="First Unique Article" year="2020" journal="Journal A">
    <authors author="Frank Researcher"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art2" title="Second Unique Article" year="2021" journal="Journal B">
    <authors author="Grace Analyst"/>
  </entries>

  <!-- Two Articles with same title but different journals:
       first in title set, second not; both in journal set => R6 (for art3), R7 (for art4) -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Shared Title Article" year="2022" journal="Journal C">
    <authors author="Heidi Scientist"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art4" title="Shared Title Article" year="2023" journal="Journal D">
    <authors author="Ivan Scientist"/>
  </entries>

  <!-- Two Articles with different titles but same journal:
       first in journal set, second not; both in title set => R6 (for art5), R8 (for art6) -->
  <entries xsi:type="BibTeX:Article" id="art5" title="Journal Shared Article One" year="2024" journal="Journal E">
    <authors author="Judy Writer"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art6" title="Journal Shared Article Two" year="2025" journal="Journal E">
    <authors author="Karl Writer"/>
  </entries>

  <!-- Two Articles with same title and same journal:
       first in both title and journal sets, second in neither => R6 (for art7), R9 (for art8) -->
  <entries xsi:type="BibTeX:Article" id="art7" title="Duplicate Full" year="2026" journal="Journal F">
    <authors author="Laura Researcher"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art8" title="Duplicate Full" year="2027" journal="Journal F">
    <authors author="Mallory Researcher"/>
  </entries>

  <!-- An Unpublished entry: titled, unauthored => R4 (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Working Draft on MDE" note="forthcoming"/>

  <!-- A TechReport entry: titled, authored, dated => R4 (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="MDE Tools Survey" year="2019">
    <authors author="Nina Engineer"/>
  </entries>

  <!-- An InBook entry: titled, authored, dated, chapter => R4 (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Chapter on ATL" year="2014" publisher="EduPub" chapter="3">
    <authors author="Oscar Author"/>
  </entries>

  <!-- An InCollection entry: titled, authored, dated, booktitle/publisher => R4 (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:InCollection" id="incol1" title="A Chapter in Collection" year="2013" publisher="CollectivePress" booktitle="Collected Papers on MDE">
    <authors author="Peggy Writer"/>
  </entries>

  <!-- An InProceedings entry: titled, authored, dated, booktitle/proceedings inheritance => R4 -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Conference Paper on ATL" year="2012" booktitle="Proceedings of MDEConf">
    <authors author="Quinn Presenter"/>
  </entries>

  <!-- A PhDThesis entry: titled, authored, dated, school => R4 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Deep Dive into Model Transformations" year="2011" school="Tech University">
    <authors author="Rita PhD"/>
  </entries>

  <!-- A Manual entry: titled only => R4 -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="ATL User Manual"/>
</BibTeX:BibTeXFile>