<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise all four Article rules -->
  <!-- A1: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Unique Article One"
           year="2017"
           journal="Journal Alpha">
    <authors author="Alice Unique"/>
  </entries>

  <!-- A2: duplicate title with A3, own journal, first in title set -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Title A"
           year="2018"
           journal="Journal Beta">
    <authors author="Bob Shared"/>
  </entries>

  <!-- A3: duplicate title with A2, own journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Shared Title A"
           year="2019"
           journal="Journal Gamma">
    <authors author="Carol Shared"/>
  </entries>

  <!-- A4: unique title, shared journal with A5, first in journal set -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Unique Title B"
           year="2020"
           journal="Journal Delta">
    <authors author="David SameJournal"/>
  </entries>

  <!-- A5: unique title, shared journal with A4 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Another Title B"
           year="2021"
           journal="Journal Delta">
    <authors author="Eve SameJournal"/>
  </entries>

  <!-- Titled non-article entries to exercise TitledEntry rules -->
  <!-- B1: unique titled entry -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Distinct Book Title"
           year="2010"
           publisher="Publisher One">
    <authors author="Frank BookAuthor"/>
  </entries>

  <!-- B2 and B3 share same title: one goes to titled set, the other to no-title rule -->
  <!-- B2: first with this title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="B2"
           title="Repeated Thesis Title"
           year="2012"
           school="Tech University">
    <authors author="Grace Thesis"/>
  </entries>

  <!-- B3: same title as B2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="B3"
           title="Repeated Thesis Title"
           year="2013"
           school="Science University">
    <authors author="Heidi Thesis"/>
  </entries>

  <!-- B4 and B5 share a title across different subclasses -->
  <!-- B4: first occurrence -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook"
           id="B4"
           title="Cross-Type Shared Title"
           year="2014"
           publisher="Publisher Two"
           chapter="5">
    <authors author="Ivan InBook"/>
  </entries>

  <!-- B5: same title as B4 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InCollection"
           id="B5"
           title="Cross-Type Shared Title"
           year="2015"
           publisher="Publisher Three">
    <authors author="Judy InCollection"/>
  </entries>

  <!-- Proceedings / InProceedings / Manual / Unpublished / TechReport -->
  <!-- P1: Proceedings (titled, dated) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings"
           id="P1"
           title="ConfProc 2016"
           year="2016"/>
  
  <!-- IP1: InProceedings (authored, booktitled, dated, titled) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="InProc Paper One"
           year="2016"
           booktitle="ConfProc 2016">
    <authors author="Ken InProc"/>
  </entries>

  <!-- M1: Manual (titled only) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual"
           id="M1"
           title="Tool User Manual"/>
  
  <!-- U1 and U2 share same title and are Unpublished -->
  <!-- U1: first -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Working Paper Draft"
           note="First preprint version">
    <authors author="Laura Unpub"/>
  </entries>

  <!-- U2: same title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U2"
           title="Working Paper Draft"
           note="Second preprint version">
    <authors author="Mike Unpub"/>
  </entries>

  <!-- R1: TechReport with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="R1"
           title="Tech Report on Systems"
           year="2011">
    <authors author="Nina Report"/>
  </entries>

  <!-- Untitled entries to exercise UntitledEntry rule -->
  <!-- MC1: Misc (no title/year) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="MC1"/>
  
  <!-- BK1: Booklet (dated, no title) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet"
           id="BK1"
           year="2009"/>

  <!-- Extra authored/titled entries to enrich author set and titles -->
  <entries xsi:type="BibTeX:Book"
           id="B6"
           title="Yet Another Book"
           year="2022"
           publisher="Publisher Four">
    <authors author="Oscar MultiAuthor"/>
    <authors author="Peggy MultiAuthor"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Completely Isolated Article"
           year="2023"
           journal="Journal Zeta">
    <authors author="Quentin Isolated"/>
    <authors author="Rachel Isolated"/>
  </entries>

</BibTeX:BibTeXFile>