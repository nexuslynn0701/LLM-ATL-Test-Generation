  <entries xsi:type="BibTeX:Book"
           id="B2"
           title="Model Engineering Handbook"
           year="2016"
           publisher="Global Science">
    <authors author="Irene Young"/>
  </entries>

  <!-- Manual M1: unique titled, no authors, no date -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual"
           id="M1"
           title="Tool Reference Guide"/>

  <!-- TechReport TR1 and TR2: same title -> one TitledEntry_Title_NoArticle, one TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
