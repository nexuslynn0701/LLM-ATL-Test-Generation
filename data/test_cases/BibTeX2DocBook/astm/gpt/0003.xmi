           title="Diverging Paths"
           year="2023"
           journal="Transactions on Transformation">
    <authors author="Grace Miller"/>
  </entries>

  <!-- Book B1 and B2: same title -> one TitledEntry_Title_NoArticle, one TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Model Engineering Handbook"
           year="2015"
           publisher="TechPress">
    <authors author="Henry King"/>
