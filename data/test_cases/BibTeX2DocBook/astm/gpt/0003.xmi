  <!-- InProceedings IP1 and IP2: same title and booktitle -> one TitledEntry_Title_NoArticle, one TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Systems in Practice"
           year="2010"
           booktitle="Symposium on Practical Systems">
