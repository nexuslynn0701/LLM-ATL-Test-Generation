  <!-- Booklet BL1 and BL2: untitled entries -> both UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet"
           id="BL1"
           year="2008"/>
  <entries xsi:type="BibTeX:Booklet"
           id="BL2"
           year="2008"/>

  <!-- Misc MS1: untitled entry -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
