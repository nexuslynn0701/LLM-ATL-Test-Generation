  <!-- MasterThesis MT1 and PhDThesis PT1: distinct titles and schools -> both TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Analysis of Transformations"
           year="2014"
           school="City University">
