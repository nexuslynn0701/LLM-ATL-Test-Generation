    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article A1 and A2: same title and same journal -> one Article_Title_Journal, one Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Shared Foundations"
           year="2018"
           journal="Journal of Testing">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Foundations"
           year="2019"
           journal="Journal of Testing">
    <authors author="Carol White"/>
  </entries>

  <!-- Article A3 and A4: same title, different journals -> one Article_Title_Journal, one Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Parallel Worlds"
           year="2020"
           journal="International Journal of Models">
    <authors author="David Brown"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Parallel Worlds"
           year="2021"
           journal="Proceedings of Experiments">
    <authors author="Eve Black"/>
