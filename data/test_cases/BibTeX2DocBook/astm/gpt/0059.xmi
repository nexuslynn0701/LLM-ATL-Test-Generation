<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to trigger all four Article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Unique Article One" year="2020" journal="Journal Alpha">
    <authors author="Alice Smith"/>
  </entries>

  <!-- A2 & A3: same title, different journals
       A2 chosen into title-set, both in journal-set
       -> A2: Article_Title_Journal
       -> A3: Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Shared Title Article" year="2021" journal="Journal Beta">
    <authors author="Bob Johnson"/>
    <authors author="Carol White"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="A3" title="Shared Title Article" year="2022" journal="Journal Gamma">
    <authors author="Dan Brown"/>
  </entries>

  <!-- A4 & A5: different titles, same journal
       A4 chosen into title-set and not into journal-set
       A5 not in title-set and not in journal-set
       -> A4: Article_Title_NoJournal
       -> A5: Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" title="Journal Duplicate One" year="2019" journal="Journal Delta">
    <authors author="Eve Black"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="A5" title="Journal Duplicate Two" year="2019" journal="Journal Delta">
    <authors author="Frank Green"/>
  </entries>

  <!-- Non-article titled entries to trigger TitledEntry rules -->
  <!-- B1: Book with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Unique Book Title" year="2015" publisher="Global Press">
    <authors author="Helen Clark"/>
    <authors author="Ian Gray"/>
  </entries>

  <!-- B2 & B3: Books with identical title
       B2 chosen into title-set, B3 excluded
       -> B2: TitledEntry_Title_NoArticle
       -> B3: TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B2" title="Repeated Book Title" year="2016" publisher="TechWorld">
    <authors author="Jack Long"/>
  </entries>

  <entries xsi:type="BibTeX:Book" id="B3" title="Repeated Book Title" year="2017" publisher="TechWorld">
    <authors author="Karen Young"/>
  </entries>

  <!-- P1 & P2: Proceedings with identical title
       P1 chosen into title-set, P2 excluded
       -> P1: TitledEntry_Title_NoArticle
       -> P2: TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" title="Conference on MDE" year="2018"/>
  <entries xsi:type="BibTeX:Proceedings" id="P2" title="Conference on MDE" year="2019"/>

  <!-- I1: InProceedings, uses BookTitledEntry via booktitle -->
  <entries xsi:type="BibTeX:InProceedings" id="I1" title="Model Transformation Testing" year="2023" booktitle="Proceedings of Conference on MDE">
    <authors author="Laura Evans"/>
    <authors author="Mike Stone"/>
  </entries>

  <!-- T1: TechReport with unique title -->
  <entries xsi:type="BibTeX:TechReport" id="T1" title="Industrial Report on MDE" year="2014">
    <authors author="Nina Hart"/>
  </entries>

  <!-- MT1 & MT2: MasterThesis with same title
       MT1 in title-set, MT2 out
       -> MT1: TitledEntry_Title_NoArticle
       -> MT2: TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Empirical Study of ATL" year="2012" school="Tech University">
    <authors author="Oscar Reed"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis" id="MT2" title="Empirical Study of ATL" year="2013" school="Tech University">
    <authors author="Pat Fox"/>
  </entries>

  <!-- PhD1: PhDThesis unique title -->
  <entries xsi:type="BibTeX:PhDThesis" id="PhD1" title="Advanced Topics in MDE" year="2011" school="Science Institute">
    <authors author="Quinn Dale"/>
  </entries>

  <!-- IB1: InBook with chapter and publisher -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chapter on Model Transformations" year="2010" publisher="Academic House" chapter="5">
    <authors author="Rachel King"/>
  </entries>

  <!-- IC1: InCollection with booktitle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Reusable Transformations" year="2009" publisher="Scholars Press" booktitle="Collected Works on MDE">
    <authors author="Sam Turner"/>
  </entries>

  <!-- U1 & U2: Unpublished with same title but different notes -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Draft on Transformation Testing" note="Under review">
    <authors author="Tom Walker"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Draft on Transformation Testing" note="To appear in workshop">
    <authors author="Uma Kelly"/>
  </entries>

  <!-- M1: Manual -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="Tool User Guide"/>
  
  <!-- Dated but untitled entry: Booklet -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="2008"/>

  <!-- Purely untitled and unauthored entry: Misc -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MS1"/>

  <!-- Misc with authors & PhD-like pattern but still Misc -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MS2">
    <authors author="Victor Hall"/>
  </entries>

</BibTeX:BibTeXFile>