<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to trigger all Article_* rules -->

  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="art1"
           title="Unique Article One"
           year="2019"
           journal="Journal A">
    <authors author="Alice Author"/>
  </entries>

  <!-- A2 & A3: same title, different journals
       -> only first by title (A2) in titleSet
       -> distinct journals, so both in articleSet
       A2: Article_Title_Journal
       A3: Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="art2"
           title="Shared Title X"
           year="2020"
           journal="Journal B">
    <authors author="Bob Writer"/>
    <authors author="Carol Researcher"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="art3"
           title="Shared Title X"
           year="2021"
           journal="Journal C">
    <authors author="Bob Writer"/>
  </entries>

  <!-- A4 & A5: same journal, different titles
       -> titleSet keeps both (different titles)
       -> only first by journal (A4) in articleSet
       A4: Article_Title_Journal
       A5: Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="art4"
           title="Journal D Title 1"
           year="2022"
           journal="Journal D">
    <authors author="Diana Scientist"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="art5"
           title="Journal D Title 2"
           year="2023"
           journal="Journal D">
    <authors author="Edward Analyst"/>
  </entries>

  <!-- A6 & A7: same title and same journal
       -> only first by title (A6) in titleSet
       -> only first by journal (A6) in articleSet
       A6: Article_Title_Journal
       A7: Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="art6"
           title="Repeated Everywhere"
           year="2018"
           journal="Journal E">
    <authors author="Frank Scholar"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="art7"
           title="Repeated Everywhere"
           year="2018"
           journal="Journal E">
    <authors author="Grace Professor"/>
  </entries>

  <!-- Authored + Dated + Titled entries for TitledEntry rules -->

  <!-- B1 & B2: Book with same title -> one in titleSet, one not
       B1: TitledEntry_Title_NoArticle
       B2: TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="book1"
           title="Model-Driven Development"
           year="2015"
           publisher="TechPress">
    <authors author="Alice Author"/>
  </entries>

  <entries xsi:type="BibTeX:Book"
           id="book2"
           title="Model-Driven Development"
           year="2016"
           publisher="TechPress">
    <authors author="Henry Engineer"/>
  </entries>

  <!-- B3: Book with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="book3"
           title="Software Language Engineering"
           year="2017"
           publisher="Academic House">
    <authors author="Carol Researcher"/>
    <authors author="Diana Scientist"/>
  </entries>

  <!-- IC1: InCollection with unique title (also BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol1"
           title="Chapter on Transformations"
           year="2014"
           publisher="Academic House"
           booktitle="Advances in MDE">
    <authors author="Bob Writer"/>
  </entries>

  <!-- IB1 & IB2: InBook sharing title with book3
       Only the earliest with that title is kept in titleSet.
       book3 is earlier in allInstances order, so:
       IB1, IB2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook1"
           title="Software Language Engineering"
           year="2018"
           publisher="Academic House"
           chapter="3">
    <authors author="Diana Scientist"/>
  </entries>

  <entries xsi:type="BibTeX:InBook"
           id="inbook2"
           title="Software Language Engineering"
           year="2019"
           publisher="Academic House"
           chapter="5">
    <authors author="Edward Analyst"/>
  </entries>

  <!-- IP1 & IP2: InProceedings with same title;
       first kept in titleSet (IP1), second excluded (IP2) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc1"
           title="On Testing Transformations"
           year="2013"
           booktitle="ICMT 2013">
    <authors author="Frank Scholar"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings"
           id="inproc2"
           title="On Testing Transformations"
           year="2013"
           booktitle="ICMT 2013">
    <authors author="Grace Professor"/>
  </entries>

  <!-- PR1: Proceedings with unique title -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc1"
           title="Proceedings of the MDE Conference"
           year="2012">
  </entries>

  <!-- MA1: Manual with unique title -->
  <entries xsi:type="BibTeX:Manual"
           id="man1"
           title="ATL User Manual">
  </entries>

  <!-- TR1 & TR2: TechReport sharing a title
       TR1 in titleSet, TR2 not -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr1"
           title="Transformation Testing Survey"
           year="2011">
    <authors author="Henry Engineer"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport"
           id="tr2"
           title="Transformation Testing Survey"
           year="2012">
    <authors author="Alice Author"/>
  </entries>

  <!-- UN1: Unpublished with unique title -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unp1"
           title="Unreleased MDE Results"
           note="Work in progress">
    <authors author="Carol Researcher"/>
  </entries>

  <!-- Thesis entries -->

  <!-- PHD1 & PHD2: same title -> first in titleSet, second not -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd1"
           title="Model Transformation Testing"
           year="2010"
           school="Tech University">
    <authors author="Frank Scholar"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis"
           id="phd2"
           title="Model Transformation Testing"
           year="2011"
           school="Tech University">
    <authors author="Grace Professor"/>
  </entries>

  <!-- MS1: MasterThesis with unique title -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mst1"
           title="A Study on ATL Transformations"
           year="2009"
           school="Science Institute">
    <authors author="Henry Engineer"/>
  </entries>

  <!-- Untitled entries (no TitledEntry) to trigger UntitledEntry rule -->

  <!-- MISC1 & MISC2: Misc (no title, no authors/year/journal) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc1">
  </entries>

  <entries xsi:type="BibTeX:Misc"
           id="misc2">
  </entries>

  <!-- BKLT1: Booklet (DatedEntry only, no title) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bkl1"
           year="2008">
  </entries>

</BibTeX:BibTeXFile>