<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article group 1: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Graph Transformations in Practice" year="2016" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article group 2: two articles share same title, different journals
       B1 is representative for its title and its journal -> Article_Title_Journal
       B2 shares the title but has distinct journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="B1" title="Testing Model Transformations" year="2017" journal="Software Testing Letters">
    <authors author="Carlos Diaz"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="B2" title="Testing Model Transformations" year="2018" journal="Empirical SW Engineering Reports">
    <authors author="Carlos Diaz"/>
    <authors author="Diana Evans"/>
  </entries>

  <!-- Article group 3: two articles share same journal, different titles
       C1 is representative for its title and journal -> Article_Title_Journal
       C2 shares the journal but has distinct title -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="C1" title="ATL Transformation Patterns" year="2015" journal="Model-Driven Dev Journal">
    <authors author="Emma Ford"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="C2" title="Advanced ATL Debugging" year="2019" journal="Model-Driven Dev Journal">
    <authors author="Frank Green"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article group 4: two articles share same title and same journal
       D1 is representative for its title and journal -> Article_Title_Journal
       D2 shares both title and journal -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="D1" title="Bidirectional Transformations" year="2014" journal="Rewriting Systems Quarterly">
    <authors author="Henry Irving"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="D2" title="Bidirectional Transformations" year="2014" journal="Rewriting Systems Quarterly">
    <authors author="Henry Irving"/>
    <authors author="Grace Hall"/>
  </entries>

  <!-- TechReport group: duplicate title
       R1 kept in unique-title set -> TitledEntry_Title_NoArticle
       R2 excluded from that set -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="R1" title="Evaluation of OCL Tools" year="2013">
    <authors author="Ian James"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="R2" title="Evaluation of OCL Tools" year="2015">
    <authors author="Ian James"/>
    <authors author="Kate Lewis"/>
  </entries>

  <!-- Book group: duplicate title
       BK1 representative -> TitledEntry_Title_NoArticle
       BK2 with same title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK1" title="Model-Driven Engineering Handbook" year="2011" publisher="TechBooks Publishing">
    <authors author="John Martin"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="BK2" title="Model-Driven Engineering Handbook" year="2012" publisher="Advanced TechBooks">
    <authors author="John Martin"/>
    <authors author="Laura Nelson"/>
  </entries>

  <!-- InBook (distinct title) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chapter on ATL" year="2010" publisher="Springer MDE" chapter="7">
    <authors author="Michael Olson"/>
  </entries>

  <!-- InCollection (distinct title) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Reusable Transformation Libraries" year="2018" publisher="Conference Press" booktitle="Proceedings of MDE Reuse">
    <authors author="Nina Perez"/>
    <authors author="Oscar Quinn"/>
  </entries>

  <!-- InProceedings (distinct title, uses BookTitledEntry + Proceedings hierarchy) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Tracing in Model Transformations" year="2020" booktitle="ICMT 2020" >
    <authors author="Peter Reed"/>
  </entries>

  <!-- Proceedings (distinct title) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" title="Proceedings of the ATL Symposium" year="2019"/>

  <!-- Manual (distinct title) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="User Guide for ATL IDE"/>

  <!-- Unpublished group: duplicate title to trigger both rules -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Draft on Model Testing" note="Work in progress">
    <authors author="Sara Thompson"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Draft on Model Testing" note="Extended version">
    <authors author="Tom Underwood"/>
  </entries>

  <!-- MasterThesis (distinct title) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Testing ATL Transformations" year="2012" school="University of Modeling">
    <authors author="Uma Vargas"/>
  </entries>

  <!-- PhDThesis (distinct title) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Scalability of Model Transformations" year="2016" school="Institute of Software Science">
    <authors author="Victor White"/>
  </entries>

  <!-- Booklet: untitled entry with date -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="2010"/>

  <!-- Misc: untitled entry without extra features -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MS1"/>

</BibTeX:BibTeXFile>