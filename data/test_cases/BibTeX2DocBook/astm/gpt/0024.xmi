<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: A1 & A2 share same title and journal (for Article_NoTitle_NoJournal);
       A3 & A4 share title but different journals (for Article_NoTitle_Journal);
       A5 & A6 share journal but different titles (for Article_Title_NoJournal);
       A7 has unique title and journal (for Article_Title_Journal). -->

  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Shared Title TJ"
           year="2010"
           journal="Journal TJ">
    <authors author="Alice Alpha"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Title TJ"
           year="2011"
           journal="Journal TJ">
    <authors author="Bob Beta"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Shared Title T"
           year="2012"
           journal="Journal X">
    <authors author="Carol Gamma"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Shared Title T"
           year="2013"
           journal="Journal Y">
    <authors author="Dave Delta"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Unique Title 1"
           year="2014"
           journal="Journal Z">
    <authors author="Eve Epsilon"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Unique Title 2"
           year="2015"
           journal="Journal Z">
    <authors author="Frank Phi"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Solo Article"
           year="2016"
           journal="Solo Journal">
    <authors author="Grace Gamma"/>
  </entries>

  <!-- Titled non-Article entries:
       B1 unique title (TitledEntry_Title_NoArticle),
       B2 & B3 share title (TitledEntry_Title_NoArticle + TitledEntry_NoTitle_NoArticle),
       P1 unique,
       P2 & P3 share. -->

  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Unique Book"
           year="2001"
           publisher="UniPub">
    <authors author="Henry Author"/>
  </entries>

  <entries xsi:type="BibTeX:Book"
           id="B2"
           title="Duplicate Book Title"
           year="2002"
           publisher="DupPub1">
    <authors author="Ivy Iota"/>
  </entries>

  <entries xsi:type="BibTeX:Book"
           id="B3"
           title="Duplicate Book Title"
           year="2003"
           publisher="DupPub2">
    <authors author="Jack Kappa"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis"
           id="P1"
           title="Solo Thesis"
           year="2004"
           school="Tech University">
    <authors author="Laura Lambda"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis"
           id="P2"
           title="Shared Thesis Title"
           year="2005"
           school="Science Institute">
    <authors author="Mike Mu"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis"
           id="P3"
           title="Shared Thesis Title"
           year="2006"
           school="Research Center">
    <authors author="Nina Nu"/>
  </entries>

  <!-- Untitled entries: Misc and Booklet trigger UntitledEntry -->

  <entries xsi:type="BibTeX:Misc"
           id="M1"/>
  <entries xsi:type="BibTeX:Booklet"
           id="BK1"
           year="1999"/>

  <!-- Additional titled non-Article variety -->

  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="InBook Sample"
           year="2007"
           publisher="ChapterHouse"
           chapter="1">
    <authors author="Oscar Omicron"/>
  </entries>

  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Collection Chapter"
           year="2008"
           publisher="Collective Press">
    <authors author="Paula Pi"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Conference Paper"
           year="2009"
           booktitle="BestConf 2009">
    <authors author="Quentin Q"/>
  </entries>

  <entries xsi:type="BibTeX:Manual"
           id="MAN1"
           title="User Manual"/>
  <entries xsi:type="BibTeX:Proceedings"
           id="PROC1"
           title="Proceedings 2010"
           year="2010"/>
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Draft Work"
           note="Under review">
