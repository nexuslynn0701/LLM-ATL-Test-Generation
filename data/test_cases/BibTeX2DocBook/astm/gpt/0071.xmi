<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Alpha Study on Models" year="2018" journal="Journal A">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article A2 & A3: same title, different journals -> Article_NoTitle_Journal for A3 -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Shared Title Article" year="2019" journal="Journal B">
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" title="Shared Title Article" year="2020" journal="Journal C">
    <authors author="Charlie King"/>
  </entries>

  <!-- Article A4 & A5: same journal, different titles -> Article_Title_NoJournal for A5 -->
  <entries xsi:type="BibTeX:Article" id="A4" title="First JournalD Article" year="2021" journal="Journal D">
    <authors author="Bob Jones"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" title="Second JournalD Article" year="2022" journal="Journal D">
    <authors author="Diana Prince"/>
  </entries>

  <!-- Article A6 & A7: same title and same journal -> Article_NoTitle_NoJournal for A7 -->
  <entries xsi:type="BibTeX:Article" id="A6" title="Repeated in Same Journal" year="2017" journal="Journal E">
    <authors author="Evan Stone"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" title="Repeated in Same Journal" year="2017" journal="Journal E">
    <authors author="Fiona Lake"/>
  </entries>

  <!-- TechReport T1 & T2: same title -> TitledEntry_Title_NoArticle for T1, TitledEntry_NoTitle_NoArticle for T2 -->
  <entries xsi:type="BibTeX:TechReport" id="T1" title="Duplicated Report Title" year="2015" school="Tech University">
    <authors author="George Hall"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="T2" title="Duplicated Report Title" year="2016" school="Tech University">
    <authors author="Hannah Miles"/>
  </entries>

  <!-- Book B1: unique titled entry, authored, dated, publisher -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Model Engineering Handbook" year="2014" publisher="ModelPress">
    <authors author="Alice Smith"/>
    <authors author="Ian Wright"/>
  </entries>

  <!-- InBook IB1: unique titled entry, chapter -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chapter on Transformations" year="2013" publisher="TechBooks" chapter="3">
    <authors author="Bob Jones"/>
  </entries>

  <!-- InCollection IC1: unique titled entry, booktitle via BookTitledEntry, publisher -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Collected Paper" year="2012" publisher="CollectionsPub" booktitle="Collected Works on MDE">
    <authors author="Charlie King"/>
  </entries>

  <!-- InProceedings IP1 & IP2: same title -> title uniqueness broken for IP2 -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Conference Paper Title" year="2019" booktitle="MDE Conference 2019">
    <authors author="Diana Prince"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP2" title="Conference Paper Title" year="2020" booktitle="MDE Conference 2020">
    <authors author="Ian Wright"/>
  </entries>

  <!-- Proceedings P1: unique titled entry, dated -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" title="Proceedings of MDE 2020" year="2020"/>

  <!-- Manual M1: unique titled entry, not authored or dated -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="Tool User Manual"/>

  <!-- Unpublished U1 & U2: same title -> U2 loses title distinctness -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Working Draft on Testing" note="Internal draft">
    <authors author="George Hall"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Working Draft on Testing" note="Revised internal draft">
    <authors author="Hannah Miles"/>
  </entries>

  <!-- PhDThesis PHD1: unique titled entry, thesis-specific school -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Advanced MDE Techniques" year="2011" school="Software University">
    <authors author="Evan Stone"/>
  </entries>

  <!-- MasterThesis MT1 & MT2: same title -> MT2 loses title distinctness -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Introductory MDE Study" year="2010" school="Engineering Institute">
    <authors author="Fiona Lake"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT2" title="Introductory MDE Study" year="2012" school="Engineering Institute">
    <authors author="Ian Wright"/>
  </entries>

  <!-- Booklet BO1: DatedEntry only, no title -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="BO1" year="2009"/>

  <!-- Misc MS1: plain BibTeXEntry, no title, authors, or date -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MS1"/>

</BibTeX:BibTeXFile>