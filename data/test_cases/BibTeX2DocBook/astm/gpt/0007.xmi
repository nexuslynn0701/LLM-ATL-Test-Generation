<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles designed to hit Article_* combinations and title/journal uniqueness logic -->

  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Lambda Calculus Foundations"
           year="2001"
           journal="Journal of Pure Theory">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A2: same title as A1, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Lambda Calculus Foundations"
           year="2002"
           journal="Computing Letters">
    <authors author="Carol White"/>
  </entries>

  <!-- A3: unique title, same journal as A2 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Distributed Systems Overview"
           year="2003"
           journal="Computing Letters">
    <authors author="Dan Brown"/>
  </entries>

  <!-- A4: same title as A3, same journal as A2/A3 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Distributed Systems Overview"
           year="2004"
           journal="Computing Letters">
    <authors author="Alice Smith"/>
  </entries>

  <!-- A5: unique title, same journal as A1 (so A1 no longer in journalSet),
           but A5 becomes the representative for that journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Category Theory in Practice"
           year="2005"
           journal="Journal of Pure Theory">
    <authors author="Eve Black"/>
  </entries>

  <!-- Titled non-Article entries to exercise TitledEntry_* rules -->

  <!-- B1: Book with unique title and publisher -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Model-Driven Engineering Essentials"
           year="2010"
           publisher="TechPress">
    <authors author="Frank Green"/>
    <authors author="Grace Hall"/>
  </entries>

  <!-- B2: Book with same title as B1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B2"
           title="Model-Driven Engineering Essentials"
           year="2011"
           publisher="NextGen Publishing">
    <authors author="Helen King"/>
  </entries>

  <!-- MT1: MasterThesis unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Verification of Model Transformations"
           year="2015"
           school="University of Metropolis">
    <authors author="Ian Lee"/>
  </entries>

  <!-- MT2: MasterThesis sharing title with MT1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT2"
           title="Verification of Model Transformations"
           year="2016"
           school="Polytechnic Institute">
    <authors author="Jane Doe"/>
  </entries>

  <!-- PHD1: PhDThesis with fully unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Scalable Model Transformation Testing"
           year="2018"
           school="Tech University">
    <authors author="John Doe"/>
  </entries>

  <!-- IB1: InBook with unique title and chapter -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Advanced Topics in MDE"
           year="2012"
           publisher="Academic House"
           chapter="3">
    <authors author="Kevin Young"/>
  </entries>

  <!-- IC1: InCollection with unique title and same publisher as B1 (publisher does not affect rule selection) -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Case Studies in Model Transformation"
           year="2013"
           publisher="TechPress">
    <authors author="Laura Gray"/>
  </entries>

  <!-- IP1: InProceedings with unique title, referencing a proceedings/booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Testing ATL Transformations"
           year="2014"
           booktitle="Proceedings of the MDE Conference">
    <authors author="Mike Brown"/>
    <authors author="Nina Rose"/>
  </entries>

  <!-- PR1: Proceedings (TitledEntry + DatedEntry) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings"
           id="PR1"
           title="Proceedings of the MDE Conference"
           year="2014"/>
           
  <!-- M1: Manual (TitledEntry only) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual"
           id="M1"
           title="ATL User Guide"/>
           
  <!-- U1: Unpublished with unique title and note -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Draft on Model Synchronization"
           note="To appear in internal proceedings">
    <authors author="Oscar Green"/>
  </entries>

  <!-- U2: Unpublished sharing title with U1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U2"
           title="Draft on Model Synchronization"
           note="Second revision">
    <authors author="Paul Blue"/>
  </entries>

  <!-- TR1: TechReport unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Model Transformation Benchmarks"
           year="2017">
    <authors author="Quinn Violet"/>
  </entries>

  <!-- Untitled entries to exercise UntitledEntry rule -->

  <!-- MS1: Misc without title -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="MS1"/>

  <!-- BK1: Booklet (DatedEntry only) without title -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet"
           id="BK1"
           year="2009"/>

</BibTeX:BibTeXFile>