<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles designed to hit all four Article rules -->

  <!-- A1: unique title & unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Unique Article One"
           year="2018"
           journal="Distinct Journal 1">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- A2 & A3: same title, different journals -> one Title_Journal, one NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Shared Article Title"
           year="2019"
           journal="Journal Alpha">
    <authors author="Carol White"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Shared Article Title"
           year="2020"
           journal="Journal Beta">
    <authors author="Dan Brown"/>
  </entries>

  <!-- A4 & A5: different titles, same journal -> one Title_Journal, one Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Journal Reused Title One"
           year="2021"
           journal="Common Journal X">
    <authors author="Eve Black"/>
    <authors author="Frank Green"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Journal Reused Title Two"
           year="2022"
           journal="Common Journal X">
    <authors author="George King"/>
  </entries>

  <!-- A6 & A7: same title and same journal -> one Title_Journal, one NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Duplicate Everything"
           year="2017"
           journal="Overlap Journal">
    <authors author="Helen Clark"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Duplicate Everything"
           year="2017"
           journal="Overlap Journal">
    <authors author="Ian Moore"/>
  </entries>

  <!-- Non-article titled entries to drive TitledEntry rules -->

  <!-- B1 & B2: Book, same title -> one Title_NoArticle, one NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Repeated Book Title"
           year="2015"
           publisher="BookHouse Press">
    <authors author="Alice Smith"/>
    <authors author="Carol White"/>
  </entries>

  <entries xsi:type="BibTeX:Book"
           id="B2"
           title="Repeated Book Title"
           year="2016"
           publisher="BookHouse Press">
    <authors author="Bob Jones"/>
  </entries>

  <!-- B3: Book with unique title -> Title_NoArticle (and Book-specific fields used) -->
  <entries xsi:type="BibTeX:Book"
           id="B3"
           title="Unique Book Title"
           year="2014"
           publisher="Unique Publisher Ltd">
    <authors author="Dan Brown"/>
  </entries>

  <!-- IB1 & IB2: InBook, same title -> one Title_NoArticle, one NoTitle_NoArticle, chapter used -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Chaptered Work"
           year="2013"
           publisher="Chapter Press"
           chapter="3">
    <authors author="Eve Black"/>
  </entries>

  <entries xsi:type="BibTeX:InBook"
           id="IB2"
           title="Chaptered Work"
           year="2013"
           publisher="Chapter Press"
           chapter="7">
    <authors author="Frank Green"/>
  </entries>

  <!-- IC1: InCollection, unique title -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Collected Insights"
           year="2012"
           publisher="Collection House"
           booktitle="Advances in MDE">
    <authors author="George King"/>
    <authors author="Helen Clark"/>
  </entries>

  <!-- IP1 & IP2: InProceedings, same title, different booktitles -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Conference Paper Title"
           year="2011"
           booktitle="Proceedings of MDEConf 2011">
    <authors author="Ian Moore"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings"
           id="IP2"
           title="Conference Paper Title"
           year="2011"
           booktitle="Proceedings of AltMDE 2011">
    <authors author="Alice Smith"/>
  </entries>

  <!-- P1 & P2: Proceedings, same title -->
  <entries xsi:type="BibTeX:Proceedings"
           id="P1"
           title="MDE Conference Proceedings"
           year="2010">
  </entries>

  <entries xsi:type="BibTeX:Proceedings"
           id="P2"
           title="MDE Conference Proceedings"
           year="2010">
  </entries>

  <!-- M1: Manual, unique title -->
  <entries xsi:type="BibTeX:Manual"
           id="M1"
           title="Tool User Guide">
  </entries>

  <!-- U1 & U2: Unpublished, same title, note field used -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Working Draft on MDE"
           note="To appear">
    <authors author="Bob Jones"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="U2"
           title="Working Draft on MDE"
           note="Revised version">
    <authors author="Carol White"/>
  </entries>

  <!-- T1: TechReport, unique title -->
  <entries xsi:type="BibTeX:TechReport"
           id="T1"
           title="Technical Report on Transformations"
           year="2009">
    <authors author="Dan Brown"/>
  </entries>

  <!-- Thesis entries exercising ThesisEntry school field -->

  <!-- PHD1 & PHD2: PhDThesis, same title -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Model Transformation Verification"
           year="2008"
           school="University A">
    <authors author="Eve Black"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD2"
           title="Model Transformation Verification"
           year="2008"
           school="University B">
    <authors author="Frank Green"/>
  </entries>

  <!-- MT1: MasterThesis, unique title -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Testing ATL Transformations"
           year="2007"
           school="Tech University">
    <authors author="George King"/>
  </entries>

  <!-- Untitled entries (not TitledEntry) for UntitledEntry rule -->

  <!-- BO1: Booklet (DatedEntry only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="BO1"
           year="2006">
  </entries>

  <!-- BO2: another Booklet to show variety -->
  <entries xsi:type="BibTeX:Booklet"
           id="BO2"
           year="2005">
  </entries>

  <!-- MS1 & MS2: Misc (base BibTeXEntry only) -->
  <entries xsi:type="BibTeX:Misc"
           id="MS1">
  </entries>

  <entries xsi:type="BibTeX:Misc"
           id="MS2">
  </entries>

</BibTeX:BibTeXFile>