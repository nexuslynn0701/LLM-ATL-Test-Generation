<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (trigger R3: Misc, Booklet) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2018"/>

  <!-- TechReport: unique title (R4) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Tech Report Alpha" year="2017">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- TechReports: duplicate title to trigger R5 on one of them -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="Shared Report" year="2019">
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr3" title="Shared Report" year="2020">
    <authors author="Carol White"/>
  </entries>

  <!-- Manual: unique title (R4, no authors/dates) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Tool Reference Manual"/>

  <!-- Unpublished: unique title (R4) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft Ideas" note="Under revision">
    <authors author="Bob Jones"/>
  </entries>

  <!-- MasterThesis and PhDThesis with same title (R4 + R5) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Unified Modelling" year="2015" school="Tech University">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Unified Modelling" year="2016" school="Tech University">
    <authors author="David Black"/>
  </entries>

  <!-- Book: unique title (R4) -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="Model Engineering Basics" year="2012" publisher="ModelPress">
    <authors author="Alice Smith"/>
    <authors author="David Black"/>
  </entries>

  <!-- InCollection and InProceedings with same title (R4 + R5) -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Patterns in MDE" year="2013" publisher="Springer" booktitle="Advances in MDE">
    <authors author="Eve Gray"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Patterns in MDE" year="2014" booktitle="MDE Conference">
    <authors author="Bob Jones"/>
    <authors author="Eve Gray"/>
  </entries>

  <!-- InBook: unique title (R4) -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Chapter on Testing" year="2011" publisher="Quality Books" chapter="7">
    <authors author="Carol White"/>
  </entries>

  <!-- Proceedings: unique title (R4) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proceedings of the Testing Symposium" year="2019"/>

  <!-- Articles for all four article rules -->
  <!-- A1: unique title, unique journal (R6) -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Intro to MDE" year="2010" journal="Journal A">
    <authors author="Alice Smith"/>
  </entries>

  <!-- A2 & A3: same title, different journals -->
  <!-- A2: first with title "Shared Title 1" (R6) -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Shared Title 1" year="2011" journal="Journal B">
    <authors author="Bob Jones"/>
  </entries>
  <!-- A3: second with same title, journal still unique (R7) -->
  <entries xsi:type="BibTeX:Article" id="a3" title="Shared Title 1" year="2012" journal="Journal C">
    <authors author="Carol White"/>
  </entries>

  <!-- A4 & A5: different titles, same journal -->
  <!-- A4: first in journal "Journal D" (R6) -->
  <entries xsi:type="BibTeX:Article" id="a4" title="Unique Article in D" year="2013" journal="Journal D">
    <authors author="David Black"/>
  </entries>
  <!-- A5: second in same journal, different title (R8) -->
  <entries xsi:type="BibTeX:Article" id="a5" title="Another Article in D" year="2014" journal="Journal D">
    <authors author="Eve Gray"/>
  </entries>

  <!-- A6 & A7: same title, same journal -->
  <!-- A6: first "Repeated Study" in "Journal E" (R6) -->
  <entries xsi:type="BibTeX:Article" id="a6" title="Repeated Study" year="2015" journal="Journal E">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>
  <!-- A7: second "Repeated Study" in "Journal E" (R9) -->
  <entries xsi:type="BibTeX:Article" id="a7" title="Repeated Study" year="2016" journal="Journal E">
    <authors author="Carol White"/>
  </entries>

</BibTeX:BibTeXFile>