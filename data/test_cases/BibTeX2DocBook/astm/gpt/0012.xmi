  <!-- Titled, non-Article: unique titles (R4) -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Advanced MDE" year="2013" publisher="TechBooks Publishing">
    <authors author="Kevin Martin"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="C1" title="Reusable Transformations" year="2012" publisher="Springer">
