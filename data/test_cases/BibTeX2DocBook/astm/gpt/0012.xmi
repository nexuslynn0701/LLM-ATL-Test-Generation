    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: distinct titles & journals (R6 + R1/R2/R4) -->
  <entries xsi:type="BibTeX:Article" id="A1" title="MDE Foundations" year="2015" journal="SoSyM Journal">
    <authors author="Alice Smith"/>
