  </entries>

  <!-- Articles: different titles, same journal (R8 for second) -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Tracing in MDE" year="2019" journal="EMF Journal">
    <authors author="Frank Green"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" title="Testing Transformations" year="2020" journal="EMF Journal">
    <authors author="Grace Hall"/>
  </entries>

  <!-- Articles: same title AND same journal (R9 for second) -->
  <entries xsi:type="BibTeX:Article" id="A7" title="Incremental Transformations" year="2014" journal="MODELS Journal">
