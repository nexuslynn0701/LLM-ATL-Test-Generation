<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: cover all 4 article rules via title/journal duplication patterns -->

  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="A Journey Through Models"
           year="2015"
           journal="Journal of Model Engineering">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- A2 / A3: same title, same journal -> one Title_Journal, one NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Cloning in Model Transformations"
           year="2016"
           journal="Software Systems Journal">
    <authors author="Carol Gamma"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Cloning in Model Transformations"
           year="2017"
           journal="Software Systems Journal">
    <authors author="Dave Delta"/>
  </entries>

  <!-- A4 / A5: same title, different journals (and those journals duplicated) ->
       first per title & first per journal in SJJ2 -> Title_Journal,
       second per title, second per journal -> NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Measuring Transformation Quality"
           year="2018"
           journal="Empirical Software Studies">
    <authors author="Eve Epsilon"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Measuring Transformation Quality"
           year="2019"
           journal="International Journal of Transformation Research">
    <authors author="Frank Phi"/>
  </entries>

  <!-- A6 / A7: unique titles but journals also used by A4/A5 -->
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Patterns for Empirical Studies"
           year="2020"
           journal="Empirical Software Studies">
    <authors author="Grace Gamma"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Traceability in Practice"
           year="2021"
           journal="International Journal of Transformation Research">
    <authors author="Hank Eta"/>
  </entries>

  <!-- A8 / A9: same journal, different titles not used anywhere else ->
       journal set keeps first (A8), so A8: Title_Journal, A9: Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A8"
           title="Intermediate Models Explained"
           year="2014"
           journal="Journal of Model Experiments">
    <authors author="Ivan Iota"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A9"
           title="Composable Transformation Chains"
           year="2013"
           journal="Journal of Model Experiments">
    <authors author="Judy Jota"/>
  </entries>

  <!-- A10 / A11: same title, different journal that appears only here ->
       both journals distinct & not reused;
       A10: Title_Journal, A11: NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A10"
           title="Refactoring ATL Transformations"
           year="2011"
           journal="Advanced MDE Topics">
    <authors author="Karl Kappa"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A11"
           title="Refactoring ATL Transformations"
           year="2012"
           journal="Model Reuse Letters">
    <authors author="Laura Lambda"/>
  </entries>

  <!-- Non-article titled entries: both unique and duplicate titles -->

  <!-- B1 / B2: two Books with same title "The Big MDE Book":
       B1 selected into titledEntrySet -> Title_NoArticle,
       B2 -> NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="The Big MDE Book"
           year="2010"
           publisher="MetaModeling Press">
    <authors author="Alice Alpha"/>
    <authors author="Carol Gamma"/>
  </entries>

  <entries xsi:type="BibTeX:Book"
           id="B2"
           title="The Big MDE Book"
           year="2011"
           publisher="MetaModeling Press">
    <authors author="Bob Beta"/>
  </entries>

  <!-- B3: unique Book title -> Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B3"
           title="Transformations for Everyone"
           year="2009"
           publisher="Springer-like Publishing">
    <authors author="Dave Delta"/>
  </entries>

  <!-- InBook with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Refinement Layers in Practice"
           year="2008"
           publisher="TechBooks Ltd."
           chapter="3">
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- InCollection sharing a title with Proceedings below (duplicate across types) -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Proceedings of the MDE Conference"
           year="2016"
           publisher="Conference Publishing House">
    <authors author="Frank Phi"/>
  </entries>

  <!-- TechReport: unique title -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="A Study on Bidirectional Transformations"
           year="2014">
    <authors author="Grace Gamma"/>
  </entries>

  <!-- Unpublished entries with same title to trigger NoTitle_NoArticle on second -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Unreleased MDE Manifesto"
           note="Draft version stored internally">
    <authors author="Hank Eta"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="U2"
           title="Unreleased MDE Manifesto"
           note="Revised draft with annotations">
    <authors author="Ivan Iota"/>
  </entries>

  <!-- Manual with unique title -->
  <entries xsi:type="BibTeX:Manual"
           id="M1"
           title="ATL User Guide"/>
  
  <!-- Proceedings with duplicated title (with InCollection) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="P1"
           title="Proceedings of the MDE Conference"
           year="2016"/>

  <!-- InProceedings with same booktitle as P1 title -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="A Case Study on InProceedings"
           year="2016"
           booktitle="Proceedings of the MDE Conference">
    <authors author="Judy Jota"/>
  </entries>

  <!-- Thesis entries -->

  <!-- PhDThesis with unique title -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Model Transformations for Large-Scale Systems"
           year="2012"
           school="University of Modeling Sciences">
    <authors author="Karl Kappa"/>
  </entries>

  <!-- MasterThesis with same title as PhDThesis above -> second one uses NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MSC1"
           title="Model Transformations for Large-Scale Systems"
           year="2013"
           school="Technical Institute of Software">
    <authors author="Laura Lambda"/>
  </entries>

  <!-- Dated but not titled: Booklet (untitled entry rule) -->
  <entries xsi:type="BibTeX:Booklet"
           id="BK1"
           year="2007"/>

  <!-- Misc: untitled entry rule -->
  <entries xsi:type="BibTeX:Misc"
           id="MS1"/>

</BibTeX:BibTeXFile>