<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to cover all Article* rules -->
  <!-- A1: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Unique Insights into MDE" year="2020" journal="Journal of Unique Results">
    <authors author="Alice Unique"/>
  </entries>

  <!-- A2 & A3: same title, different journals -> first Article_Title_Journal, second Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Shared Title Study" year="2021" journal="Journal of Variant Contexts">
    <authors author="Bob Shared"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a3" title="Shared Title Study" year="2022" journal="Proceedings of Mixed Journals">
    <authors author="Carol Shared"/>
  </entries>

  <!-- A4 & A5: different titles, same journal -> first Article_Title_Journal, second Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a4" title="First in Same Journal" year="2019" journal="Common Journal of Experiments">
    <authors author="Dan Common"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a5" title="Second in Same Journal" year="2018" journal="Common Journal of Experiments">
    <authors author="Eve Common"/>
  </entries>

  <!-- A6 & A7: same title and same journal -> first Article_Title_Journal, second Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a6" title="Duplicate Everything" year="2017" journal="Journal of Duplicates">
    <authors author="Frank Duplicate"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a7" title="Duplicate Everything" year="2016" journal="Journal of Duplicates">
    <authors author="Grace Duplicate"/>
  </entries>

  <!-- Titled non-Article entries for TitledEntry_*_NoArticle rules -->
  <!-- Unique titles -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="b1" title="Model-Driven Book Alpha" year="2015" publisher="Alpha Press">
    <authors author="Henry Book"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="A Singular Master Thesis" year="2014" school="Tech University">
    <authors author="Ivy Master"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="One-of-a-kind Doctoral Study" year="2013" school="Research Institute">
    <authors author="Jack Doctor"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Chapter on Unique Modelling" year="2012" publisher="Chapter House" chapter="3">
    <authors author="Kelly Chapter"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Unique Collection Entry" year="2011" publisher="Collection Press">
    <authors author="Liam Collection"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Standalone Conference Paper" year="2010" booktitle="Conference on Unique Papers">
    <authors author="Mona Conference"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="p1" title="Proceedings of a Single Event" year="2009"/>
  <entries xsi:type="BibTeX:Manual" id="man1" title="User Guide for Unique Tool"/>
  <entries xsi:type="BibTeX:Unpublished" id="u1" title="Unreleased but Unique" note="To appear soon">
    <authors author="Nate Unpublished"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Single Technical Report" year="2008">
    <authors author="Olivia Report"/>
  </entries>

  <!-- Duplicate titles among non-Article titled entries -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="b2" title="Repeated Title in Books" year="2007" publisher="Repeat Press">
    <authors author="Paul Repeat"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="ic2" title="Repeated Title in Books" year="2006" publisher="Repeat Press 2">
    <authors author="Quinn Repeat"/>
  </entries>

  <!-- Untitled entries (non-TitledEntry) for UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Booklet" id="bo1" year="2005"/>

  <!-- Extra entries to reuse some authors and titles -->
  <!-- Article sharing an existing author name but otherwise unique pattern -->
  <entries xsi:type="BibTeX:Article" id="a8" title="Another Unique Paper" year="2023" journal="Journal of Extra Cases">
    <authors author="Alice Unique"/>
  </entries>

  <!-- Non-article titled entry reusing an existing title with article titles to ensure cross-type sharing does not alter rule selection -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="Shared Title Study"/>

</BibTeX:BibTeXFile>