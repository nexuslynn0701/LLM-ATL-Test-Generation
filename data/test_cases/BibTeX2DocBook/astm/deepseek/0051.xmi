<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Manual"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Two Unpublished with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Notes" note="Initial version">
        <authors author="Alice Smith"/>
    </entries>
    <entries xsi:type="BibTeX:Unpublished" id="unpub02" title="Draft Notes" note="Revised version">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tech01" title="Technical Report 2024" year="2024">
        <authors author="Charlie Brown"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Advanced Topics" year="2022" publisher="Academic Press">
        <authors author="Diana Prince"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter Analysis" year="2021" publisher="Springer" chapter="5">
        <authors author="Eve Adams"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Article" year="2020" publisher="MIT Press" booktitle="Best Papers">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Workshop Paper" year="2023" booktitle="Workshop Proceedings">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msthesis01" title="Master Thesis Research" year="2022" school="University A">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phdthesis01" title="PhD Dissertation" year="2023" school="University B">
        <authors author="Iris Johnson"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - first triggers R6, second triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Novel Algorithm" year="2023" journal="Journal of Computing">
        <authors author="Jack Davis"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Novel Algorithm" year="2024" journal="Journal of Computing">
        <authors author="Karen White"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Quantum Computing" year="2024" journal="Nature Physics">
        <authors author="Leo Brown"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - first triggers R6, second triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Data Mining" year="2022" journal="Data Science Journal">
        <authors author="Maria Garcia"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art05" title="Data Mining" year="2023" journal="Machine Learning Review">
        <authors author="Nathan Clark"/>
    </entries>
    
    <!-- Two Articles with different titles but same journal - first triggers R6, second triggers R8 -->
    <entries xsi:type="BibTeX:Article" id="art06" title="Network Security" year="2021" journal="IEEE Security">
        <authors author="Olivia Taylor"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art07" title="Cryptography Advances" year="2022" journal="IEEE Security">
        <authors author="Peter Anderson"/>
    </entries>
    
    <!-- Author entries for distinct authors (some already referenced above) -->
    <entries xsi:type="BibTeX:Article" id="art08" title="Distinct Author Test" year="2024" journal="Test Journal">
        <authors author="Quinn Thomas"/>
        <authors author="Rachel Moore"/>
    </entries>
    
</BibTeX:BibTeXFile>