<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Documentation Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="International Conference on AI" year="2023"/>
    
    <!-- Two Unpublished with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Research Notes" note="Preliminary findings">
        <authors author="Alice Smith"/>
    </entries>
    <entries xsi:type="BibTeX:Unpublished" id="unpub02" title="Draft Research Notes" note="Updated version">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tech01" title="Technical Report on ML" year="2022">
        <authors author="Charlie Brown"/>
    </entries>
    
    <!-- Book - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Introduction to MDE" year="2021" publisher="Springer">
        <authors author="Diana Prince"/>
    </entries>
    
    <!-- InBook - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Transformations" year="2020" publisher="Wiley" chapter="5">
        <authors author="Eve Adams"/>
    </entries>
    
    <!-- InCollection - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Advances in Model Checking" year="2019" publisher="ACM" booktitle="LNCS Volume 1">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- InProceedings - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Verification Techniques" year="2023" booktitle="Proceedings of FM 2023">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- MasterThesis - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis on Testing" year="2022" school="MIT">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- PhDThesis - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation on Verification" year="2021" school="Stanford">
        <authors author="Ivy Chen"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - first triggers R6, second triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Novel Algorithm" year="2023" journal="J. Software Eng.">
        <authors author="Jack Davis"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Novel Algorithm" year="2024" journal="J. Software Eng.">
        <authors author="Karen White"/>
    </entries>
    
    <!-- Article with unique title but same journal as above - triggers R8 (title unique, journal not unique) -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Different Approach" year="2023" journal="J. Software Eng.">
        <authors author="Leo Martinez"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="New Paradigm" year="2022" journal="ACM Computing Surveys">
        <authors author="Maria Garcia"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - first triggers R6, second triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Shared Title" year="2021" journal="IEEE Software">
        <authors author="Nathan Kim"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art06" title="Shared Title" year="2020" journal="J. Systems">
        <authors author="Olivia Brown"/>
    </entries>
    
</BibTeX:BibTeXFile>