<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- R2: Author (distinct author) -->
    <entries xsi:type="BibTeX:Article" id="art1" title="Quantum Computing" year="2023" journal="Nature">
        <authors author="Alice Smith"/>
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- R6: Article_Title_Journal (unique title, unique journal) -->
    <entries xsi:type="BibTeX:Article" id="art2" title="Machine Learning Advances" year="2024" journal="Science">
        <authors author="Carol Lee"/>
    </entries>
    
    <!-- R7: Article_NoTitle_Journal (same title as art1, unique journal) -->
    <entries xsi:type="BibTeX:Article" id="art3" title="Quantum Computing" year="2022" journal="IEEE">
        <authors author="David Wang"/>
    </entries>
    
    <!-- R8: Article_Title_NoJournal (unique title, same journal as art2) -->
    <entries xsi:type="BibTeX:Article" id="art4" title="Deep Learning" year="2024" journal="Science">
        <authors author="Eve Brown"/>
    </entries>
    
    <!-- R9: Article_NoTitle_NoJournal (same title as art3, same journal as art4) -->
    <entries xsi:type="BibTeX:Article" id="art5" title="Deep Learning" year="2023" journal="Science">
        <authors author="Frank Davis"/>
    </entries>
    
    <!-- R3: UntitledEntry - Misc (no title) -->
    <entries xsi:type="BibTeX:Misc" id="misc1"/>
    
    <!-- R3: UntitledEntry - Booklet (no title) -->
    <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2020"/>
    
    <!-- R4: TitledEntry_Title_NoArticle - PhDThesis (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Neural Networks" year="2023" school="MIT">
        <authors author="Grace Kim"/>
    </entries>
    
    <!-- R5: TitledEntry_NoTitle_NoArticle - Book (same title as phd1) -->
    <entries xsi:type="BibTeX:Book" id="book1" title="Neural Networks" year="2022" publisher="Springer">
        <authors author="Henry Lee"/>
    </entries>
    
    <!-- R4: TitledEntry_Title_NoArticle - MasterThesis (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="ms1" title="Data Mining" year="2024" school="Stanford">
        <authors author="Iris Chen"/>
    </entries>
    
    <!-- R4: TitledEntry_Title_NoArticle - InBook with chapter (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbk1" title="Advanced Algorithms" year="2023" publisher="Wiley" chapter="5">
        <authors author="Jack Wilson"/>
    </entries>
    
    <!-- R4: TitledEntry_Title_NoArticle - TechReport (unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tr1" title="System Architecture" year="2024">
        <authors author="Karen Taylor"/>
    </entries>
    
    <!-- R4: TitledEntry_Title_NoArticle - Unpublished with note (unique title) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Preliminary Results" note="Draft version">
        <authors author="Leo Martinez"/>
    </entries>
    
    <!-- R4: TitledEntry_Title_NoArticle - Proceedings (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conference 2024" year="2024"/>
    
    <!-- R4: TitledEntry_Title_NoArticle - InProceedings with booktitle (unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Network Security" year="2024" booktitle="Security Symposium">
        <authors author="Mia Anderson"/>
    </entries>
    
    <!-- R4: TitledEntry_Title_NoArticle - InCollection with booktitle (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol1" title="Database Systems" year="2023" publisher="ACM" booktitle="DB Conference">
        <authors author="Noah Thomas"/>
    </entries>
    
    <!-- R4: TitledEntry_Title_NoArticle - Manual (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="man1" title="User Guide"/>
    
</BibTeX:BibTeXFile>