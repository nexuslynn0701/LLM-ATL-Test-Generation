<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Documentation Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Under review">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report on AI" year="2022">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Introduction to MDE" year="2021" publisher="Springer">
        <authors author="Carol Williams"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Transformations" year="2021" publisher="Springer" chapter="5">
        <authors author="Carol Williams"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Article" year="2020" publisher="ACM" booktitle="Best of MDE">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Conference Paper" year="2023" booktitle="MDE 2023">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:MasterThesis" id="mt01" title="Master Thesis on Model Checking" year="2022" school="MIT">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation on Formal Methods" year="2023" school="Stanford">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Novel Approach to MDE" year="2023" journal="Journal of Software Engineering">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- Article with duplicate title (same as art02) but unique journal - triggers R7 Article_NoTitle_Journal -->
    <entries xsi:type="BibTeX:Article" id="art02" title="Duplicate Title Article" year="2022" journal="ACM Computing Surveys">
        <authors author="Iris Taylor"/>
    </entries>
    
    <!-- Article with duplicate title (same as art02) but unique journal - triggers R7 Article_NoTitle_Journal -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Duplicate Title Article" year="2021" journal="IEEE Software">
        <authors author="Jack Anderson"/>
    </entries>
    
    <!-- Article with unique title but duplicate journal (same as art05) - triggers R8 Article_Title_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Unique Title in Shared Journal" year="2023" journal="Communications of the ACM">
        <authors author="Karen Thomas"/>
    </entries>
    
    <!-- Article with unique title but duplicate journal (same as art04) - triggers R8 Article_Title_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Another Unique Title" year="2022" journal="Communications of the ACM">
        <authors author="Leo Garcia"/>
    </entries>
    
    <!-- Article with duplicate title and duplicate journal - triggers R9 Article_NoTitle_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art06" title="Common Title" year="2023" journal="Journal of Systems">
        <authors author="Maria Rodriguez"/>
    </entries>
    
    <!-- Article with duplicate title and duplicate journal (same as art06) - triggers R9 Article_NoTitle_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art07" title="Common Title" year="2022" journal="Journal of Systems">
        <authors author="Nathan Clark"/>
    </entries>
    
    <!-- Additional authors to trigger R2 Author rule -->
    <entries xsi:type="BibTeX:Article" id="art08" title="Additional Article" year="2023" journal="New Journal">
        <authors author="Olivia Martinez"/>
        <authors author="Peter White"/>
    </entries>
    
</BibTeX:BibTeXFile>