<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Manual"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings" year="2023"/>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Unpublished manuscript">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report" year="2022">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Introduction to MDE" year="2021" publisher="Springer">
        <authors author="Carol Williams"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Transformations" year="2021" publisher="Springer" chapter="5">
        <authors author="Carol Williams"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Chapter" year="2020" publisher="ACM" booktitle="Advances in MDE">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Model Transformation Patterns" year="2023" booktitle="MODELS 2023">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation on MDE" year="2022" school="MIT">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis on ATL" year="2023" school="Stanford">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="MDE Foundations" year="2023" journal="SoSyM">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- Second Article with same title as art01 but different journal - triggers R7 Article_NoTitle_Journal -->
    <entries xsi:type="BibTeX:Article" id="art02" title="MDE Foundations" year="2022" journal="JSS">
        <authors author="Ivy Taylor"/>
    </entries>
    
    <!-- Third Article with different title but same journal as art01 - triggers R8 Article_Title_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Advanced MDE" year="2023" journal="SoSyM">
        <authors author="Jack Anderson"/>
    </entries>
    
    <!-- Fourth Article with same title as art03 and same journal as art03 - triggers R9 Article_NoTitle_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Advanced MDE" year="2024" journal="SoSyM">
        <authors author="Karen Thomas"/>
    </entries>
    
    <!-- Duplicate author to test Author rule deduplication -->
    <entries xsi:type="BibTeX:Article" id="art05" title="New MDE Techniques" year="2024" journal="TSE">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- Duplicate title to test TitledEntry_NoTitle_NoArticle (R5) -->
    <entries xsi:type="BibTeX:Manual" id="manual02" title="Software Manual"/>
    
    <!-- Another duplicate title for R5 testing -->
    <entries xsi:type="BibTeX:TechReport" id="tr02" title="Technical Report" year="2021">
        <authors author="Bob Johnson"/>
    </entries>
    
</BibTeX:BibTeXFile>