<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2023"/>
    
    <!-- Manual (titled entry, no article) -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="LaTeX Guide"/>
    
    <!-- Proceedings (titled entry, no article) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="ICSE 2023" year="2023"/>
    
    <!-- Unpublished (titled entry, no article) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Under review">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report 2024" year="2024">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book (titled entry, no article) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2022" publisher="Addison-Wesley">
        <authors author="Ian Sommerville"/>
    </entries>
    
    <!-- InBook (titled entry, no article) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter 5" year="2022" publisher="MIT Press" chapter="5">
        <authors author="John Doe"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Advances in MDE" year="2023" publisher="Springer" booktitle="MDE Handbook">
        <authors author="Jane Roe"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Model Transformations" year="2023" booktitle="MODELS 2023">
        <authors author="Carlos Mendez"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis on MDE" year="2024" school="MIT">
        <authors author="Eva Green"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation" year="2023" school="Stanford">
        <authors author="Frank White"/>
    </entries>
    
    <!-- Article 1: unique title and unique journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="ATL in Practice" year="2024" journal="SoSyM">
        <authors author="Grace Hopper"/>
    </entries>
    
    <!-- Article 2: same title as Article 3, unique journal -->
    <entries xsi:type="BibTeX:Article" id="art02" title="Model Checking" year="2023" journal="TSE">
        <authors author="Henry Ford"/>
    </entries>
    
    <!-- Article 3: same title as Article 2, unique journal -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Model Checking" year="2023" journal="JSS">
        <authors author="Iris Chang"/>
    </entries>
    
    <!-- Article 4: unique title, same journal as Article 5 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Code Generation" year="2024" journal="EMSE">
        <authors author="Jack Black"/>
    </entries>
    
    <!-- Article 5: unique title, same journal as Article 4 -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Refactoring" year="2024" journal="EMSE">
        <authors author="Karen White"/>
    </entries>
    
    <!-- Article 6: same title as Article 7, same journal as Article 7 -->
    <entries xsi:type="BibTeX:Article" id="art06" title="Testing" year="2023" journal="STVR">
        <authors author="Leo Messi"/>
    </entries>
    
    <!-- Article 7: same title as Article 6, same journal as Article 6 -->
    <entries xsi:type="BibTeX:Article" id="art07" title="Testing" year="2023" journal="STVR">
        <authors author="Maria Santos"/>
    </entries>
    
</BibTeX:BibTeXFile>