<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2023"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Manual"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings" year="2022"/>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Under review">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report" year="2021">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Data Structures" year="2020" publisher="Academic Press">
        <authors author="Carol Williams"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Sorting" year="2019" publisher="Tech Books" chapter="5">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Article" year="2018" publisher="Springer" booktitle="Advances in Computing">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Conference Paper" year="2017" booktitle="ICSE 2017">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation" year="2016" school="MIT">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis" year="2015" school="Stanford">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - triggers R7 Article_NoTitle_Journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Machine Learning" year="2023" journal="JMLR">
        <authors author="Iris Taylor"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Machine Learning" year="2022" journal="AI Journal">
        <authors author="Jack Anderson"/>
    </entries>
    
    <!-- Two Articles with different titles but same journal - triggers R8 Article_Title_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Neural Networks" year="2021" journal="Nature">
        <authors author="Karen Thomas"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art04" title="Deep Learning" year="2020" journal="Nature">
        <authors author="Leo Garcia"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - triggers R9 Article_NoTitle_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Quantum Computing" year="2019" journal="Science">
        <authors author="Maria Rodriguez"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art06" title="Quantum Computing" year="2018" journal="Science">
        <authors author="Nathan Clark"/>
    </entries>
    
    <!-- Unique Article (unique title and unique journal) - triggers R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="art07" title="Unique Article Title" year="2017" journal="Unique Journal">
        <authors author="Olivia Martinez"/>
    </entries>
    
    <!-- Duplicate author to test Author rule deduplication -->
    <entries xsi:type="BibTeX:Manual" id="manual02" title="Another Manual">
        <authors author="Alice Smith"/>
    </entries>
    
</BibTeX:BibTeXFile>