<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="Software Manual"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Two Unpublished with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Notes" note="Preliminary version">
        <authors author="Alice Smith"/>
    </entries>
    <entries xsi:type="BibTeX:Unpublished" id="unpub02" title="Draft Notes" note="Revised version">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- TechReport - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tech01" title="Technical Report Alpha" year="2022">
        <authors author="Carol White"/>
    </entries>
    
    <!-- Book - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Introduction to MDE" year="2021" publisher="Springer">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InBook - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Transformations" year="2020" publisher="Wiley" chapter="5">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- InCollection - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Article" year="2019" publisher="ACM" booktitle="Best of 2019">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- InProceedings - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Model Checking Paper" year="2023" booktitle="MODELS 2023">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- MasterThesis - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="mst01" title="Master Thesis on MDE" year="2022" school="MIT">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- PhDThesis - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation on Transformations" year="2021" school="Stanford">
        <authors author="Ivy Taylor"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - first triggers R6, second triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="New Algorithm" year="2023" journal="J. Software">
        <authors author="Jack Anderson"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="New Algorithm" year="2024" journal="J. Software">
        <authors author="Karen Thomas"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Unique Article Title" year="2022" journal="Unique Journal">
        <authors author="Leo Garcia"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - first triggers R6, second triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Shared Title" year="2021" journal="Journal A">
        <authors author="Maria Rodriguez"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art05" title="Shared Title" year="2020" journal="Journal B">
        <authors author="Nathan Clark"/>
    </entries>
    
    <!-- Two Articles with different titles but same journal - first triggers R6, second triggers R8 -->
    <entries xsi:type="BibTeX:Article" id="art06" title="First Journal Article" year="2023" journal="Shared Journal">
        <authors author="Olivia Martinez"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art07" title="Second Journal Article" year="2022" journal="Shared Journal">
        <authors author="Paul Robinson"/>
    </entries>
    
</BibTeX:BibTeXFile>