<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2023"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Documentation Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Unpublished manuscript">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report 2023" year="2023">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Introduction to MDE" year="2022" publisher="Springer">
        <authors author="Carol Williams"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Transformations" year="2022" publisher="Springer" chapter="5">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Article" year="2021" publisher="ACM" booktitle="Best of MDE">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Conference Paper" year="2023" booktitle="MDE 2023">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:MasterThesis" id="mt01" title="Master Thesis on MDE" year="2023" school="MIT">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation on Transformations" year="2022" school="Stanford">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- Duplicate title with Manual - triggers R5 TitledEntry_NoTitle_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="manual02" title="Software Documentation Guide"/>
    
    <!-- Article with unique title and unique journal - triggers R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Novel MDE Approach" year="2023" journal="Journal of MDE">
        <authors author="Iris Taylor"/>
    </entries>
    
    <!-- Article with duplicate title (same as art01) but unique journal - triggers R7 Article_NoTitle_Journal -->
    <entries xsi:type="BibTeX:Article" id="art02" title="Novel MDE Approach" year="2023" journal="Software Engineering Journal">
        <authors author="Jack Anderson"/>
    </entries>
    
    <!-- Article with unique title but duplicate journal (same as art01) - triggers R8 Article_Title_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Advanced Model Checking" year="2022" journal="Journal of MDE">
        <authors author="Karen White"/>
    </entries>
    
    <!-- Article with duplicate title (same as art03) and duplicate journal (same as art01) - triggers R9 Article_NoTitle_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Advanced Model Checking" year="2022" journal="Journal of MDE">
        <authors author="Leo Martin"/>
    </entries>
    
    <!-- Additional author for testing Author rule (R2) - distinct author -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Testing Author Rule" year="2024" journal="Testing Journal">
        <authors author="Maria Garcia"/>
    </entries>
    
</BibTeX:BibTeXFile>