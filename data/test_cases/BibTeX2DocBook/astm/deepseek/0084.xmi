<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2023"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="Software Documentation Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2024" year="2024"/>
    
    <!-- Two Unpublished with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Notes" note="Initial draft">
        <authors author="Alice Smith"/>
    </entries>
    <entries xsi:type="BibTeX:Unpublished" id="unpub02" title="Draft Notes" note="Revised version">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- TechReport - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report on AI" year="2024">
        <authors author="Carol White"/>
    </entries>
    
    <!-- Book - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Advanced Programming" year="2023" publisher="TechPress">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InBook - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Algorithms" year="2023" publisher="AcademicPub" chapter="5">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- InCollection - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collected Works Volume 3" year="2022" publisher="Springer" booktitle="Advances in Computing">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- InProceedings - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Novel Approach to Data Mining" year="2024" booktitle="ICDM 2024">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- PhDThesis - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="Deep Learning Architectures" year="2024" school="MIT">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- MasterThesis - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="ms01" title="Machine Learning Applications" year="2023" school="Stanford">
        <authors author="Ivy Taylor"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - first triggers R6, second triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Quantum Computing Survey" year="2024" journal="Nature Computing">
        <authors author="Jack Anderson"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Quantum Computing Survey" year="2024" journal="Nature Computing">
        <authors author="Karen Thomas"/>
    </entries>
    
    <!-- Article with unique title but duplicate journal - first triggers R6, second triggers R8 -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Machine Vision Advances" year="2023" journal="Nature Computing">
        <authors author="Leo Garcia"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Blockchain Technology Review" year="2024" journal="Journal of Cryptography">
        <authors author="Maria Rodriguez"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - first triggers R6, second triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Data Structures Optimization" year="2023" journal="ACM Computing Surveys">
        <authors author="Nathan Clark"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art06" title="Data Structures Optimization" year="2024" journal="IEEE Software">
        <authors author="Olivia Martinez"/>
    </entries>
    
</BibTeX:BibTeXFile>