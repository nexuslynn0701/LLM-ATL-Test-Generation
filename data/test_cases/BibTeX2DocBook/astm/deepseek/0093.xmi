<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Documentation Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Two TechReports with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report on AI" year="2022">
        <authors author="Alice Smith"/>
    </entries>
    <entries xsi:type="BibTeX:TechReport" id="tr02" title="Technical Report on AI" year="2023">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper on Semantics" note="Under review">
        <authors author="Carol White"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Model-Driven Engineering" year="2021" publisher="Springer">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Transformations" year="2020" publisher="Wiley" chapter="5">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection on MDE" year="2019" publisher="ACM" booktitle="Advances in MDE">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Paper at MODELS" year="2023" booktitle="MODELS 2023">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD on Verification" year="2022" school="MIT">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="MSc on Testing" year="2021" school="Stanford">
        <authors author="Iris Taylor"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - first triggers R6, second triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Article on ATL" year="2023" journal="SoSyM">
        <authors author="Jack Anderson"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Article on ATL" year="2024" journal="SoSyM">
        <authors author="Karen Thomas"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Unique Article Title" year="2022" journal="JSS">
        <authors author="Leo Garcia"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - first triggers R6, second triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Common Title" year="2021" journal="TSE">
        <authors author="Maria Lopez"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art05" title="Common Title" year="2020" journal="EMSE">
        <authors author="Nathan Clark"/>
    </entries>
    
    <!-- Two Articles with different titles but same journal - first triggers R6, second triggers R8 -->
    <entries xsi:type="BibTeX:Article" id="art06" title="First Journal Article" year="2023" journal="IST">
        <authors author="Olivia Hall"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art07" title="Second Journal Article" year="2022" journal="IST">
        <authors author="Paul Young"/>
    </entries>
    
</BibTeX:BibTeXFile>