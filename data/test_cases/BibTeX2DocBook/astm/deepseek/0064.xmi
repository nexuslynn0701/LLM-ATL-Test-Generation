<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- UntitledEntry: Misc (no title, no author, no date) -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- UntitledEntry: Booklet (dated, no title) -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2021"/>
    
    <!-- Author rule: distinct author -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Design Patterns" year="1994" publisher="Addison-Wesley">
        <authors author="Erich Gamma"/>
        <authors author="Richard Helm"/>
        <authors author="Ralph Johnson"/>
        <authors author="John Vlissides"/>
    </entries>
    
    <!-- Author rule: duplicate author (should not trigger Author rule separately for author4) -->
    <entries xsi:type="BibTeX:Book" id="book02" title="Refactoring" year="1999" publisher="Addison-Wesley">
        <authors author="Martin Fowler"/>
        <authors author="Kent Beck"/>
        <authors author="John Brant"/>
        <authors author="William Opdyke"/>
        <authors author="Don Roberts"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: Manual (titled, no author, no date) -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="LaTeX Manual"/>
    
    <!-- TitledEntry_Title_NoArticle: Proceedings (titled, dated, no author) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="ICSE 2020" year="2020"/>
    
    <!-- TitledEntry_Title_NoArticle: TechReport (authored, dated, titled) -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report 001" year="2022">
        <authors author="Alan Turing"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: Unpublished (authored, titled, with note) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Unpublished Manuscript" note="Draft version">
        <authors author="Charles Babbage"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: MasterThesis (thesis entry) -->
    <entries xsi:type="BibTeX:MasterThesis" id="mt01" title="Master Thesis on AI" year="2023" school="MIT">
        <authors author="Ada Lovelace"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: PhDThesis (thesis entry) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation on CS" year="2024" school="Stanford">
        <authors author="Grace Hopper"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: InBook (with chapter) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Advanced Programming" year="2018" publisher="O'Reilly" chapter="5">
        <authors author="John McCarthy"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: Book (already included above as book01 and book02) -->
    
    <!-- TitledEntry_NoTitle_NoArticle: Manual with duplicate title -->
    <entries xsi:type="BibTeX:Manual" id="man02" title="LaTeX Manual"/>
    
    <!-- TitledEntry_NoTitle_NoArticle: TechReport with duplicate title -->
    <entries xsi:type="BibTeX:TechReport" id="tr02" title="Technical Report 001" year="2023">
        <authors author="John von Neumann"/>
    </entries>
    
    <!-- Article_Title_Journal: first Article with unique title and unique journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Deep Learning" year="2020" journal="Nature">
        <authors author="Yann LeCun"/>
        <authors author="Yoshua Bengio"/>
    </entries>
    
    <!-- Article_NoTitle_Journal: second Article with duplicate title, unique journal -->
    <entries xsi:type="BibTeX:Article" id="art02" title="Deep Learning" year="2021" journal="Science">
        <authors author="Geoffrey Hinton"/>
    </entries>
    
    <!-- Article_Title_NoJournal: Article with unique title, duplicate journal -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Quantum Computing" year="2022" journal="Nature">
        <authors author="Peter Shor"/>
    </entries>
    
    <!-- Article_NoTitle_NoJournal: Article with duplicate title and duplicate journal -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Quantum Computing" year="2023" journal="Nature">
        <authors author="David Deutsch"/>
    </entries>
    
    <!-- InCollection: combines Book and BookTitledEntry -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Database Systems" year="2019" booktitle="Conference Proceedings" publisher="Springer">
        <authors author="Edgar Codd"/>
    </entries>
    
    <!-- InProceedings: combines Proceedings, AuthoredEntry, BookTitledEntry -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Software Engineering" year="2022" booktitle="ICSE 2022">
        <authors author="Fred Brooks"/>
    </entries>
    
</BibTeX:BibTeXFile>