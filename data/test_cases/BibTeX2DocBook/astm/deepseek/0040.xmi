<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="Software Documentation Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Under review">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report Alpha" year="2022">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Introduction to MDE" year="2021" publisher="Springer">
        <authors author="Carol Williams"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Advanced MDE Concepts" year="2021" publisher="Springer" chapter="5">
        <authors author="Carol Williams"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Model Transformations" year="2020" publisher="ACM" booktitle="Best of MDE">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="ATL in Practice" year="2023" booktitle="MODELS 2023">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Research on MDE" year="2022" school="MIT">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis on Transformations" year="2021" school="Stanford">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - triggers R7 Article_NoTitle_Journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Common Title" year="2023" journal="Journal of Software">
        <authors author="Henry Wilson"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Common Title" year="2024" journal="Journal of Systems">
        <authors author="Ivy Clark"/>
    </entries>
    
    <!-- Two Articles with different titles but same journal - triggers R8 Article_Title_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Unique Article A" year="2022" journal="Same Journal">
        <authors author="Jack White"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art04" title="Unique Article B" year="2023" journal="Same Journal">
        <authors author="Kate Black"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - triggers R9 Article_NoTitle_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Duplicate Title" year="2020" journal="Duplicate Journal">
        <authors author="Liam Green"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art06" title="Duplicate Title" year="2021" journal="Duplicate Journal">
        <authors author="Mia Hall"/>
    </entries>
    
    <!-- Single Article with unique title and unique journal - triggers R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="art07" title="Unique Research" year="2024" journal="Unique Journal">
        <authors author="Noah Adams"/>
    </entries>
    
    <!-- Additional authors to trigger R2 Author rule -->
    <entries xsi:type="BibTeX:Article" id="art08" title="Another Study" year="2023" journal="Science Today">
        <authors author="Olivia Taylor"/>
        <authors author="Peter Anderson"/>
    </entries>
    
</BibTeX:BibTeXFile>