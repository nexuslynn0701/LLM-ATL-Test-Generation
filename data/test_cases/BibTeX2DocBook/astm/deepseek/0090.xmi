<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- UntitledEntry: Misc (no TitledEntry ancestor) -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- UntitledEntry: Booklet (no TitledEntry ancestor, DatedEntry) -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2021"/>
    
    <!-- TitledEntry_Title_NoArticle: Manual (TitledEntry only, unique title) -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="The LaTeX Manual"/>
    
    <!-- TitledEntry_Title_NoArticle: Proceedings (DatedEntry + TitledEntry, unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Software Engineering Conference" year="2023"/>
    
    <!-- TitledEntry_Title_NoArticle: TechReport (AuthoredEntry + DatedEntry + TitledEntry, unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="AI Report" year="2022">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: Unpublished (AuthoredEntry + TitledEntry, unique title) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Notes" note="Unpublished work">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: Book (AuthoredEntry + DatedEntry + TitledEntry, unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Design Patterns" year="1994" publisher="Addison-Wesley">
        <authors author="Erich Gamma"/>
        <authors author="Richard Helm"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: InBook (Book + TitledEntry, with chapter, unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2000" publisher="Pearson" chapter="5">
        <authors author="Jane Doe"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: InCollection (Book + BookTitledEntry, unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Advances in Computing" year="2020" publisher="Springer" booktitle="CS Proceedings">
        <authors author="Tom Lee"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: InProceedings (Proceedings + AuthoredEntry + BookTitledEntry, unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="New Algorithms" year="2023" booktitle="ICSE 2023">
        <authors author="Sarah Connor"/>
        <authors author="Kyle Reese"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: PhDThesis (ThesisEntry, unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Research on MDE" year="2020" school="MIT">
        <authors author="Carol White"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: MasterThesis (ThesisEntry, unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis on Transformations" year="2019" school="Stanford">
        <authors author="David Brown"/>
    </entries>
    
    <!-- Duplicate title triggers TitledEntry_NoTitle_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="manual02" title="The LaTeX Manual"/>
    
    <!-- Article_Title_Journal: Unique title AND unique journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Model-Driven Engineering" year="2021" journal="IEEE Software">
        <authors author="John Smith"/>
    </entries>
    
    <!-- Duplicate journal with Article_NoTitle_NoJournal: same title and journal as art01? No, different title but same journal -->
    <entries xsi:type="BibTeX:Article" id="art02" title="Model-Driven Engineering" year="2021" journal="IEEE Software"/>
    
    <!-- Try to trigger Article_Title_NoJournal: unique title, but journal duplicates an existing one -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Another Approach" year="2022" journal="IEEE Software">
        <authors author="Nancy Wilson"/>
    </entries>
    
    <!-- Try to trigger Article_NoTitle_Journal: duplicate title (same as art01), unique journal -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Model-Driven Engineering" year="2023" journal="ACM Computing Surveys"/>
    
    <!-- Article_NoTitle_NoJournal: duplicate title (same as art01) and duplicate journal (same as art01) -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Model-Driven Engineering" year="2024" journal="IEEE Software"/>
    
</BibTeX:BibTeXFile>