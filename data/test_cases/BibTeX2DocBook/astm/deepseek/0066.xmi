<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry - triggers R3) -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry with date - triggers R3) -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2023"/>
    
    <!-- Two Articles with same title, different journals - triggers R6 and R7 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Machine Learning" year="2022" journal="JMLR">
        <authors author="Alice Smith"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Machine Learning" year="2023" journal="Nature">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- Two Articles with same journal, different titles - triggers R6 and R8 -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Deep Learning" year="2021" journal="JMLR">
        <authors author="Carol White"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="AI Ethics" year="2023" journal="AI Magazine">
        <authors author="David Brown"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art05" title="AI Ethics" year="2024" journal="AI Magazine">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- MasterThesis (triggers R4 - unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="mt01" title="Neural Networks" year="2022" school="MIT">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- PhDThesis with same title as MasterThesis (triggers R5 - duplicate title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="Neural Networks" year="2023" school="Stanford">
        <authors author="Grace Wilson"/>
    </entries>
    
    <!-- Book with unique title (triggers R4) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Data Structures" year="2020" publisher="Addison-Wesley">
        <authors author="Henry Taylor"/>
    </entries>
    
    <!-- InBook with chapter (triggers R4) -->
    <entries xsi:type="BibTeX:InBook" id="ib01" title="Algorithms" year="2021" publisher="OReilly" chapter="5">
        <authors author="Iris Clark"/>
    </entries>
    
    <!-- InCollection (triggers R4) -->
    <entries xsi:type="BibTeX:InCollection" id="ic01" title="Database Systems" year="2022" publisher="Springer" booktitle="Advanced DB">
        <authors author="Jack Lee"/>
    </entries>
    
    <!-- InProceedings (triggers R4) -->
    <entries xsi:type="BibTeX:InProceedings" id="ip01" title="Software Engineering" year="2023" booktitle="ICSE 2023">
        <authors author="Karen Adams"/>
    </entries>
    
    <!-- Proceedings (triggers R4) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Manual (triggers R4) -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="User Guide v2.0"/>
    
    <!-- Unpublished (triggers R4) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Under review">
        <authors author="Liam Moore"/>
    </entries>
    
    <!-- TechReport (triggers R4) -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report 2024" year="2024">
        <authors author="Maria Garcia"/>
    </entries>
    
    <!-- Duplicate author (should only appear once in Authors List - triggers R2) -->
    <entries xsi:type="BibTeX:Article" id="art06" title="Quantum Computing" year="2024" journal="Physics Today">
        <authors author="Alice Smith"/>
    </entries>
    
</BibTeX:BibTeXFile>