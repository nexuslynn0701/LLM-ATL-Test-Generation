<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2023"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="Software Documentation Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Two Unpublished with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Notes" note="Preliminary version">
        <authors author="Alice Smith"/>
    </entries>
    <entries xsi:type="BibTeX:Unpublished" id="unpub02" title="Draft Notes" note="Revised version">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- TechReport - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report on MDE" year="2024">
        <authors author="Carol White"/>
    </entries>
    
    <!-- Book - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Model-Driven Engineering" year="2022" publisher="Springer">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InBook - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Transformations" year="2021" publisher="Wiley" chapter="5">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- InCollection - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Article" year="2020" publisher="ACM" booktitle="Advances in MDE">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- InProceedings - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Paper at Conference" year="2023" booktitle="MDE 2023">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- PhDThesis - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation on MDE" year="2024" school="MIT">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- MasterThesis - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis on Transformations" year="2023" school="Stanford">
        <authors author="Ivy Taylor"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - first triggers R6, second triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="MDE Approaches" year="2024" journal="Software Engineering Journal">
        <authors author="Jack Anderson"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="MDE Approaches" year="2023" journal="Software Engineering Journal">
        <authors author="Karen Thomas"/>
    </entries>
    
    <!-- Article with unique title but same journal as above - triggers R8 (title unique, journal not unique) -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Model Transformations" year="2024" journal="Software Engineering Journal">
        <authors author="Leo Garcia"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Testing Strategies" year="2023" journal="Journal of Software Testing">
        <authors author="Maria Rodriguez"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - first triggers R6, second triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Code Generation" year="2024" journal="Journal of Code Generation">
        <authors author="Nathan Clark"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art06" title="Code Generation" year="2023" journal="Software Engineering Review">
        <authors author="Olivia Martinez"/>
    </entries>
    
</BibTeX:BibTeXFile>