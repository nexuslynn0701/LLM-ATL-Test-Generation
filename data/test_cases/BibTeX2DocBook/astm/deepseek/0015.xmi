<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Documentation Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Under review">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report 2024" year="2024">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Introduction to MDE" year="2022" publisher="Springer">
        <authors author="Carol Williams"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Advanced MDE Concepts" year="2022" publisher="Springer" chapter="5">
        <authors author="Carol Williams"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="MDE Case Studies" year="2021" publisher="ACM" booktitle="MDE Handbook">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Model Transformations" year="2023" booktitle="MODELS 2023">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="Automated Model Analysis" year="2023" school="MIT">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Model-Driven Testing" year="2024" school="Stanford">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - triggers R7 Article_NoTitle_Journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Software Engineering" year="2023" journal="JSS">
        <authors author="Henry Wilson"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Software Engineering" year="2024" journal="TSE">
        <authors author="Ivy Chen"/>
    </entries>
    
    <!-- Two Articles with same journal but different titles - triggers R8 Article_Title_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Model Checking" year="2023" journal="FSE">
        <authors author="Jack Taylor"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art04" title="Program Analysis" year="2024" journal="FSE">
        <authors author="Karen White"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - triggers R9 Article_NoTitle_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Code Generation" year="2023" journal="SCP">
        <authors author="Leo Anderson"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art06" title="Code Generation" year="2024" journal="SCP">
        <authors author="Maria Thomas"/>
    </entries>
    
    <!-- Unique Article (unique title and unique journal) - triggers R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="art07" title="Unique Research" year="2024" journal="Unique Journal">
        <authors author="Nathan Clark"/>
    </entries>
    
    <!-- Duplicate author names to test Author rule (R2) deduplication -->
    <entries xsi:type="BibTeX:Book" id="book02" title="Duplicate Author Test" year="2024" publisher="Wiley">
        <authors author="Oliver Harris"/>
        <authors author="Oliver Harris"/>
    </entries>
    
</BibTeX:BibTeXFile>