<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc - triggers R3 (UntitledEntry) -->
    <entries xsi:type="BibTeX:Misc" id="Misc01"/>
    
    <!-- Booklet - triggers R3 (UntitledEntry) -->
    <entries xsi:type="BibTeX:Booklet" id="Booklet01" year="2020"/>
    
    <!-- Manual - triggers R4 (TitledEntry_Title_NoArticle) - unique title -->
    <entries xsi:type="BibTeX:Manual" id="Manual01" title="User Manual for System X"/>
    
    <!-- Proceedings - triggers R4 (TitledEntry_Title_NoArticle) - unique title -->
    <entries xsi:type="BibTeX:Proceedings" id="Proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Two MasterThesis with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:MasterThesis" id="Thesis01" title="Machine Learning Applications" year="2021" school="MIT">
        <authors author="Alice Smith"/>
        <authors author="Bob Jones"/>
    </entries>
    <entries xsi:type="BibTeX:MasterThesis" id="Thesis02" title="Machine Learning Applications" year="2022" school="Stanford">
        <authors author="Carol White"/>
    </entries>
    
    <!-- PhDThesis - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="Thesis03" title="Advanced Algorithms" year="2020" school="Oxford">
        <authors author="David Brown"/>
    </entries>
    
    <!-- Book with publisher - triggers R4 -->
    <entries xsi:type="BibTeX:Book" id="Book01" title="Software Engineering" year="2019" publisher="Addison-Wesley">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- InBook with chapter - triggers R4 -->
    <entries xsi:type="BibTeX:InBook" id="InBook01" title="Chapter on Testing" year="2020" publisher="O'Reilly" chapter="5">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- InCollection - triggers R4 -->
    <entries xsi:type="BibTeX:InCollection" id="InCol01" title="Data Mining Techniques" year="2021" publisher="Springer" booktitle="Advances in Data Mining">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- InProceedings - triggers R4 -->
    <entries xsi:type="BibTeX:InProceedings" id="InProc01" title="Neural Networks" year="2022" booktitle="ICML 2022">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- Unpublished with note - triggers R4 -->
    <entries xsi:type="BibTeX:Unpublished" id="Unpub01" title="Unpublished Notes" note="Draft version">
        <authors author="Iris Taylor"/>
    </entries>
    
    <!-- TechReport - triggers R4 -->
    <entries xsi:type="BibTeX:TechReport" id="Tech01" title="Technical Report on Security" year="2023">
        <authors author="Jack Anderson"/>
    </entries>
    
    <!-- Two Articles with same journal but different titles - first triggers R6 (Article_Title_Journal), second triggers R7 (Article_NoTitle_Journal) -->
    <entries xsi:type="BibTeX:Article" id="Art01" title="Quantum Computing" year="2022" journal="Nature Communications">
        <authors author="Karen White"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="Art02" title="Classical Computing" year="2023" journal="Nature Communications">
        <authors author="Leo Black"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - first triggers R6 (unique journal so gets R6), second triggers R8 (Article_Title_NoJournal) -->
    <entries xsi:type="BibTeX:Article" id="Art03" title="Renewable Energy" year="2021" journal="Energy Journal">
        <authors author="Maria Garcia"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="Art04" title="Renewable Energy" year="2022" journal="Sustainability Review">
        <authors author="Nick Harris"/>
    </entries>
    
    <!-- Two Articles with same title AND same journal - first triggers R6 (first unique combo), second triggers R9 (Article_NoTitle_NoJournal) -->
    <entries xsi:type="BibTeX:Article" id="Art05" title="AI Ethics" year="2023" journal="AI Magazine">
        <authors author="Olivia Martinez"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="Art06" title="AI Ethics" year="2024" journal="AI Magazine">
        <authors author="Peter Clark"/>
    </entries>
    
    <!-- Additional unique article to ensure distinct authors and journals lists -->
    <entries xsi:type="BibTeX:Article" id="Art07" title="Blockchain Technology" year="2021" journal="IEEE Transactions">
        <authors author="Quinn Rogers"/>
    </entries>

</BibTeX:BibTeXFile>