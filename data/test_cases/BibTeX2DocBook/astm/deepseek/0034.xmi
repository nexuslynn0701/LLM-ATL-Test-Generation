<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="LaTeX User Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="ICSE 2023" year="2023"/>
    
    <!-- Two Unpublished with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Notes" note="Preliminary version">
        <authors author="Alice Smith"/>
    </entries>
    <entries xsi:type="BibTeX:Unpublished" id="unpub02" title="Draft Notes" note="Revised version">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- TechReport - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report 2024" year="2024">
        <authors author="Charlie Brown"/>
    </entries>
    
    <!-- Book - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2022" publisher="Addison-Wesley">
        <authors author="David Wilson"/>
    </entries>
    
    <!-- InBook - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2021" publisher="Springer" chapter="5">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- InCollection - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Advances in MDE" year="2023" publisher="ACM" booktitle="MDE Conference">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- InProceedings - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Model Transformations" year="2023" booktitle="MODELS 2023">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- PhDThesis - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="Automated Reasoning" year="2022" school="MIT">
        <authors author="Henry Taylor"/>
    </entries>
    
    <!-- MasterThesis - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Code Generation" year="2023" school="Stanford">
        <authors author="Ivy Anderson"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="New Algorithms" year="2024" journal="J. Computing">
        <authors author="Jack Thomas"/>
    </entries>
    
    <!-- Two Articles with same title, different journals - first triggers R6, second triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art02" title="Data Mining" year="2023" journal="J. Data Science">
        <authors author="Karen White"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art03" title="Data Mining" year="2023" journal="J. AI Research">
        <authors author="Leo Black"/>
    </entries>
    
    <!-- Two Articles with different titles, same journal - first triggers R6, second triggers R8 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Cloud Computing" year="2022" journal="J. Systems">
        <authors author="Maria Green"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art05" title="Distributed Systems" year="2022" journal="J. Systems">
        <authors author="Nathan Hall"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - first triggers R6, second triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art06" title="Machine Learning" year="2021" journal="J. AI">
        <authors author="Olivia King"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art07" title="Machine Learning" year="2021" journal="J. AI">
        <authors author="Paul Wright"/>
    </entries>
    
</BibTeX:BibTeXFile>