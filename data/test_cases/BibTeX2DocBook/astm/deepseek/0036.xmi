<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Manual"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings" year="2021"/>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Unpublished manuscript">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report" year="2022">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2023" publisher="Addison-Wesley">
        <authors author="Charlie Brown"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2023" publisher="Springer" chapter="5">
        <authors author="Diana Prince"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collected Works" year="2021" publisher="MIT Press" booktitle="Advances in Computing">
        <authors author="Eve Adams"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Research Paper" year="2022" booktitle="ICSE 2022">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:MasterThesis" id="mthesis01" title="Master Thesis" year="2020" school="MIT">
        <authors author="Grace Hopper"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation" year="2021" school="Stanford">
        <authors author="Henry Ford"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Unique Article" year="2023" journal="Journal of Software">
        <authors author="Iris Chang"/>
    </entries>
    
    <!-- Article with duplicate title (same as art02) but unique journal - triggers R7 Article_NoTitle_Journal -->
    <entries xsi:type="BibTeX:Article" id="art02" title="Duplicate Title" year="2022" journal="ACM Computing Surveys">
        <authors author="Jack Daniels"/>
    </entries>
    
    <!-- Article with duplicate title (same as art01) and unique journal - triggers R7 Article_NoTitle_Journal -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Duplicate Title" year="2021" journal="IEEE Software">
        <authors author="Karen White"/>
    </entries>
    
    <!-- Article with unique title and duplicate journal (same as art05) - triggers R8 Article_Title_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Unique Title Two" year="2020" journal="Duplicate Journal">
        <authors author="Leo Messi"/>
    </entries>
    
    <!-- Article with unique title and duplicate journal (same as art04) - triggers R8 Article_Title_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Another Unique Title" year="2019" journal="Duplicate Journal">
        <authors author="Maria Santos"/>
    </entries>
    
    <!-- Article with duplicate title and duplicate journal - triggers R9 Article_NoTitle_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art06" title="Common Title" year="2023" journal="Common Journal">
        <authors author="Nathan Drake"/>
    </entries>
    
    <!-- Article with duplicate title and duplicate journal (same as art06) - triggers R9 Article_NoTitle_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art07" title="Common Title" year="2022" journal="Common Journal">
        <authors author="Olivia Pope"/>
    </entries>
    
    <!-- Additional author entries to trigger R2 Author rule -->
    <entries xsi:type="BibTeX:Article" id="art08" title="Another Paper" year="2023" journal="Journal of Research">
        <authors author="Alice Smith"/>
        <authors author="Bob Jones"/>
    </entries>
    
</BibTeX:BibTeXFile>