<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc - triggers UntitledEntry (R3) -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet - triggers UntitledEntry (R3) -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="Software Documentation Guide"/>
    
    <!-- Proceedings - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="International Conference on AI" year="2023"/>
    
    <!-- Unpublished - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper on Quantum Computing" note="Unpublished manuscript">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report on Network Security" year="2022">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Introduction to Machine Learning" year="2021" publisher="Springer">
        <authors author="Carol Williams"/>
    </entries>
    
    <!-- InBook - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Advanced Topics in AI" year="2020" publisher="MIT Press" chapter="5">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InCollection - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Data Mining Techniques" year="2019" publisher="Wiley" booktitle="Handbook of Data Science">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- InProceedings - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Novel Approaches in NLP" year="2023" booktitle="ACL 2023 Proceedings">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- MasterThesis - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:MasterThesis" id="mt01" title="Deep Learning for Image Recognition" year="2022" school="Stanford University">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- PhDThesis - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="Reinforcement Learning in Robotics" year="2021" school="MIT">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers Article_Title_Journal (R6) -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Quantum Machine Learning" year="2023" journal="Nature Computing">
        <authors author="Iris Taylor"/>
    </entries>
    
    <!-- Article with duplicate title (same as art02) but unique journal - triggers Article_NoTitle_Journal (R7) -->
    <entries xsi:type="BibTeX:Article" id="art02" title="Quantum Machine Learning" year="2022" journal="IEEE Transactions">
        <authors author="Jack Anderson"/>
    </entries>
    
    <!-- Article with unique title but duplicate journal (same as art01) - triggers Article_Title_NoJournal (R8) -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Cloud Computing Security" year="2023" journal="Nature Computing">
        <authors author="Karen White"/>
    </entries>
    
    <!-- Article with duplicate title (same as art03) and duplicate journal (same as art01) - triggers Article_NoTitle_NoJournal (R9) -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Cloud Computing Security" year="2021" journal="Nature Computing">
        <authors author="Leo Martinez"/>
    </entries>
    
    <!-- Duplicate title for TitledEntry_NoTitle_NoArticle (R5) - same title as man01 -->
    <entries xsi:type="BibTeX:Manual" id="man02" title="Software Documentation Guide"/>
    
    <!-- Additional author to trigger Author rule (R2) -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Distributed Systems" year="2023" journal="ACM Computing">
        <authors author="Maria Garcia"/>
    </entries>
    
</BibTeX:BibTeXFile>