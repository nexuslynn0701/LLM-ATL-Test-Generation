<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Manual"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings" year="2021"/>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Unpublished manuscript">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report" year="2022">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2023" publisher="Springer">
        <authors author="Charlie Brown"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2023" publisher="Springer" chapter="5">
        <authors author="Diana Prince"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collected Works" year="2022" publisher="Academic Press" booktitle="Advances in Computing">
        <authors author="Eve Adams"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Research Results" year="2021" booktitle="ICSE 2021">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:MasterThesis" id="mt01" title="Master Thesis" year="2020" school="MIT">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation" year="2023" school="Stanford">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- First Article with unique title and unique journal - triggers R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Novel Approach" year="2023" journal="JSS">
        <authors author="Iris Chen"/>
    </entries>
    
    <!-- Second Article with same title as art01 but different journal - triggers R7 Article_NoTitle_Journal -->
    <entries xsi:type="BibTeX:Article" id="art02" title="Novel Approach" year="2022" journal="TSE">
        <authors author="Jack Davis"/>
    </entries>
    
    <!-- Third Article with different title but same journal as art01 - triggers R8 Article_Title_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Another Study" year="2023" journal="JSS">
        <authors author="Karen White"/>
    </entries>
    
    <!-- Fourth Article with same title as art03 and same journal as art01 - triggers R9 Article_NoTitle_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Another Study" year="2021" journal="JSS">
        <authors author="Leo Black"/>
    </entries>
    
    <!-- Duplicate author to test Author rule deduplication (R2) -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Duplicate Author Test" year="2023" journal="EMSE">
        <authors author="Iris Chen"/>
    </entries>
    
</BibTeX:BibTeXFile>