<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="Software Manual"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings" year="2021"/>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Unpublished manuscript">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report" year="2022">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2023" publisher="Addison-Wesley">
        <authors author="Ian Sommerville"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2023" publisher="Springer" chapter="5">
        <authors author="Jane Doe"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collected Works" year="2021" publisher="MIT Press" booktitle="Advances in Computing">
        <authors author="John Smith"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Research Paper" year="2022" booktitle="ICSE 2022">
        <authors author="Emily Brown"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation" year="2023" school="Stanford University">
        <authors author="Michael Green"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis" year="2022" school="MIT">
        <authors author="Sarah White"/>
    </entries>
    
    <!-- Two Articles with SAME title but DIFFERENT journals - triggers R7 Article_NoTitle_Journal for second -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Common Title" year="2020" journal="Journal of Computing">
        <authors author="David Lee"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Common Title" year="2021" journal="Software Practice">
        <authors author="David Lee"/>
    </entries>
    
    <!-- Two Articles with DIFFERENT titles but SAME journal - triggers R8 Article_Title_NoJournal for second -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Unique Title A" year="2022" journal="Same Journal">
        <authors author="Anna Taylor"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art04" title="Unique Title B" year="2023" journal="Same Journal">
        <authors author="Anna Taylor"/>
    </entries>
    
    <!-- Two Articles with SAME title and SAME journal - triggers R9 Article_NoTitle_NoJournal for second -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Duplicate Article" year="2020" journal="Duplicate Journal">
        <authors author="Chris Wilson"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art06" title="Duplicate Article" year="2021" journal="Duplicate Journal">
        <authors author="Chris Wilson"/>
    </entries>
    
    <!-- Unique Article (unique title, unique journal) - triggers R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="art07" title="Unique Article" year="2024" journal="Unique Journal">
        <authors author="Laura Adams"/>
    </entries>
    
    <!-- Duplicate author to test Author rule deduplication -->
    <entries xsi:type="BibTeX:Book" id="book02" title="Another Book" year="2020" publisher="O'Reilly">
        <authors author="Ian Sommerville"/>
    </entries>
    
</BibTeX:BibTeXFile>