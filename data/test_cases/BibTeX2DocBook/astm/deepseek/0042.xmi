<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2023"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="LaTeX Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="ICSE 2023" year="2023"/>
    
    <!-- Two Unpublished with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Unpublished draft">
        <authors author="Alice Smith"/>
    </entries>
    <entries xsi:type="BibTeX:Unpublished" id="unpub02" title="Draft Paper" note="Another version">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report 2024" year="2024">
        <authors author="Charlie Brown"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2022" publisher="Addison-Wesley">
        <authors author="David Miller"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2022" publisher="Springer" chapter="5">
        <authors author="Eve Wilson"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Chapter" year="2021" publisher="MIT Press" booktitle="Advances in CS">
        <authors author="Frank Lee"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Conference Paper" year="2023" booktitle="MODELS 2023">
        <authors author="Grace Kim"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation" year="2024" school="MIT">
        <authors author="Henry Davis"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis" year="2023" school="Stanford">
        <authors author="Iris Chen"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - first triggers R6, second triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Model Transformation" year="2024" journal="SoSyM">
        <authors author="Jack White"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Model Transformation" year="2023" journal="SoSyM">
        <authors author="Karen Black"/>
    </entries>
    
    <!-- Article with unique title but same journal as above - triggers R8 (unique title, non-unique journal) -->
    <entries xsi:type="BibTeX:Article" id="art03" title="ATL Testing" year="2024" journal="SoSyM">
        <authors author="Leo Green"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="MDE Foundations" year="2023" journal="TSE">
        <authors author="Maria Brown"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - first triggers R6, second triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Code Generation" year="2024" journal="JSS">
        <authors author="Nick Adams"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art06" title="Code Generation" year="2023" journal="STTT">
        <authors author="Olivia Taylor"/>
    </entries>
    
    <!-- Author instances for testing R2 (distinct authors) -->
    <entries xsi:type="BibTeX:Article" id="art07" title="Unique Article" year="2024" journal="EMSE">
        <authors author="Paul Garcia"/>
        <authors author="Quinn Harris"/>
    </entries>
    
</BibTeX:BibTeXFile>