<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2023"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Manual"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings" year="2022"/>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Unpublished manuscript">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report" year="2021">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2020" publisher="Addison-Wesley">
        <authors author="Ian Sommerville"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2019" publisher="Springer" chapter="5">
        <authors author="Jane Doe"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InCollection" id="incoll01" title="Collected Works" year="2018" publisher="MIT Press" booktitle="Advances in Computing">
        <authors author="John Smith"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Research Paper" year="2023" booktitle="ICSE 2023">
        <authors author="Mary Johnson"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation" year="2022" school="Stanford University">
        <authors author="David Brown"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis" year="2021" school="MIT">
        <authors author="Sarah Wilson"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - triggers R7 Article_NoTitle_Journal for the second -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Machine Learning" year="2023" journal="Nature">
        <authors author="Alan Turing"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Machine Learning" year="2022" journal="Science">
        <authors author="Grace Hopper"/>
    </entries>
    
    <!-- Two Articles with same journal but different titles - triggers R8 Article_Title_NoJournal for the second -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Quantum Computing" year="2023" journal="IEEE Computer">
        <authors author="Richard Feynman"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art04" title="Data Structures" year="2022" journal="IEEE Computer">
        <authors author="Donald Knuth"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - triggers R9 Article_NoTitle_NoJournal for the second -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Algorithms" year="2023" journal="ACM Computing">
        <authors author="Edsger Dijkstra"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art06" title="Algorithms" year="2022" journal="ACM Computing">
        <authors author="Tony Hoare"/>
    </entries>
    
    <!-- Unique Article (unique title and unique journal) - triggers R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="art07" title="Unique Research" year="2023" journal="Unique Journal">
        <authors author="Unique Author"/>
    </entries>
    
</BibTeX:BibTeXFile>