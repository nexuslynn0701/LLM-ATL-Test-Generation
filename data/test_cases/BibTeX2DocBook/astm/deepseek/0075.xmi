<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="Software Documentation Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Two Unpublished with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Notes" note="Preliminary version">
        <authors author="Alice Smith"/>
    </entries>
    <entries xsi:type="BibTeX:Unpublished" id="unpub02" title="Draft Notes" note="Revised version">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- TechReport - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tech01" title="Technical Report on MDE" year="2022">
        <authors author="Carol White"/>
    </entries>
    
    <!-- Book - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Model-Driven Engineering" year="2021" publisher="Springer">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InBook - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Advanced Topics in MDE" year="2021" publisher="Springer" chapter="5">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- InCollection - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Chapter on Transformations" year="2020" publisher="ACM" booktitle="MDE Handbook">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- InProceedings - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Novel Transformation Approach" year="2023" booktitle="MODELS 2023">
        <authors author="Grace Wilson"/>
    </entries>
    
    <!-- PhDThesis - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation on Model Transformations" year="2022" school="MIT">
        <authors author="Henry Taylor"/>
    </entries>
    
    <!-- MasterThesis - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis on Code Generation" year="2021" school="Stanford">
        <authors author="Iris Anderson"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - first triggers R6, second triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Software Engineering Advances" year="2023" journal="IEEE Software">
        <authors author="Jack Thomas"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Software Engineering Advances" year="2024" journal="IEEE Software">
        <authors author="Karen Lee"/>
    </entries>
    
    <!-- Article with unique title but same journal as above - triggers R8 (title in set, journal not in set) -->
    <entries xsi:type="BibTeX:Article" id="art03" title="New Research Directions" year="2023" journal="IEEE Software">
        <authors author="Liam Harris"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Quantum Computing Survey" year="2024" journal="ACM Computing Surveys">
        <authors author="Mia Clark"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - first triggers R6, second triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art05" title="AI in Healthcare" year="2023" journal="Nature Medicine">
        <authors author="Noah Wright"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art06" title="AI in Healthcare" year="2024" journal="The Lancet Digital Health">
        <authors author="Olivia Adams"/>
    </entries>
    
    <!-- Article with unique title but same journal as art05 - triggers R8 -->
    <entries xsi:type="BibTeX:Article" id="art07" title="Machine Learning Applications" year="2023" journal="Nature Medicine">
        <authors author="Peter Scott"/>
    </entries>
    
</BibTeX:BibTeXFile>