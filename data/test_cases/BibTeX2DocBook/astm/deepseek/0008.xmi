<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- UntitledEntry: Misc (no title, no authors, no date) -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- UntitledEntry: Booklet (dated but no title) -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- TitledEntry_Title_NoArticle: Manual (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Manual"/>
    
    <!-- TitledEntry_Title_NoArticle: Proceedings (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- TitledEntry_Title_NoArticle: TechReport (authored, dated, titled) -->
    <entries xsi:type="BibTeX:TechReport" id="tech01" title="Technical Report Alpha" year="2022">
        <authors author="Alice Smith"/>
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: Unpublished (authored, titled, with note) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Under review">
        <authors author="Carol White"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: Book (authored, dated, titled, publisher) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Data Structures" year="2021" publisher="Academic Press">
        <authors author="David Brown"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: InBook (book with chapter) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Sorting" year="2021" publisher="Academic Press" chapter="5">
        <authors author="David Brown"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: InCollection (book with booktitle) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collections in Java" year="2020" publisher="Tech Publishers" booktitle="Advanced Java Topics">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: InProceedings (authored, dated, titled, booktitle) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Machine Learning Advances" year="2023" booktitle="ML Conference 2023">
        <authors author="Frank Green"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: PhDThesis (thesis with school) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Research" year="2022" school="MIT">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: MasterThesis (thesis with school) -->
    <entries xsi:type="BibTeX:MasterThesis" id="ms01" title="Master Thesis" year="2021" school="Stanford">
        <authors author="Henry Kim"/>
    </entries>
    
    <!-- Duplicate title to trigger TitledEntry_NoTitle_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="manual02" title="Software Manual"/>
    
    <!-- Article_Title_Journal: unique title and unique journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Quantum Computing" year="2023" journal="Nature Physics">
        <authors author="Iris Wang"/>
    </entries>
    
    <!-- Article_NoTitle_Journal: duplicate title, unique journal -->
    <entries xsi:type="BibTeX:Article" id="art02" title="Quantum Computing" year="2024" journal="Science">
        <authors author="Jack Liu"/>
    </entries>
    
    <!-- Article_Title_NoJournal: unique title, duplicate journal -->
    <entries xsi:type="BibTeX:Article" id="art03" title="AI Ethics" year="2023" journal="Nature Physics">
        <authors author="Karen Moore"/>
    </entries>
    
    <!-- Article_NoTitle_NoJournal: duplicate title and duplicate journal -->
    <entries xsi:type="BibTeX:Article" id="art04" title="AI Ethics" year="2024" journal="Nature Physics">
        <authors author="Leo Patel"/>
    </entries>
    
    <!-- Additional author to trigger Author rule (distinct from all authors above) -->
    <entries xsi:type="BibTeX:Misc" id="misc02">
        <authors author="Maria Garcia"/>
    </entries>
    
</BibTeX:BibTeXFile>