<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry - triggers R3 UntitledEntry) -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry - triggers R3 UntitledEntry) -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2023"/>
    
    <!-- Manual (TitledEntry, not Article - triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="LaTeX Guide"/>
    
    <!-- Proceedings (TitledEntry, not Article - triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Model-Driven Engineering Conference" year="2024"/>
    
    <!-- Unpublished (TitledEntry, not Article - triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Notes" note="Not yet published">
        <authors author="Jane Smith"/>
    </entries>
    
    <!-- TechReport (TitledEntry, not Article - triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Overview" year="2023">
        <authors author="Alice Brown"/>
    </entries>
    
    <!-- Book (TitledEntry, not Article - triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2022" publisher="MIT Press">
        <authors author="Bob Wilson"/>
    </entries>
    
    <!-- InBook (TitledEntry, not Article - triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Advanced Topics" year="2021" publisher="Springer" chapter="5">
        <authors author="Carol Davis"/>
    </entries>
    
    <!-- InCollection (TitledEntry, not Article - triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Research Papers" year="2020" publisher="Elsevier" booktitle="Compendium of CS">
        <authors author="David Lee"/>
    </entries>
    
    <!-- InProceedings (TitledEntry, not Article - triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="New Methods" year="2024" booktitle="ICSE 2024">
        <authors author="Eva Martinez"/>
    </entries>
    
    <!-- PhDThesis (TitledEntry, not Article - triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="Formal Verification" year="2023" school="MIT">
        <authors author="Frank Garcia"/>
    </entries>
    
    <!-- MasterThesis (TitledEntry, not Article - triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Model Analysis" year="2022" school="Stanford">
        <authors author="Grace Kim"/>
    </entries>
    
    <!-- Second entry with same title "New Methods" (triggers R5 TitledEntry_NoTitle_NoArticle) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc02" title="New Methods" year="2023" booktitle="FSE 2023">
        <authors author="Henry Wang"/>
    </entries>
    
    <!-- Article with unique title and unique journal (triggers R6 Article_Title_Journal) -->
    <entries xsi:type="BibTeX:Article" id="art01" title="AI Advances" year="2024" journal="Nature AI">
        <authors author="Iris Taylor"/>
    </entries>
    
    <!-- Second article with same title but unique journal (triggers R7 Article_NoTitle_Journal) -->
    <entries xsi:type="BibTeX:Article" id="art02" title="AI Advances" year="2023" journal="Machine Learning">
        <authors author="Jack Anderson"/>
    </entries>
    
    <!-- Article with unique title but same journal as art01 (triggers R8 Article_Title_NoJournal) -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Quantum Computing" year="2024" journal="Nature AI">
        <authors author="Karen White"/>
    </entries>
    
    <!-- Second article with same title as art03 and same journal (triggers R9 Article_NoTitle_NoJournal) -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Quantum Computing" year="2023" journal="Nature AI">
        <authors author="Leo Harris"/>
    </entries>

</BibTeX:BibTeXFile>