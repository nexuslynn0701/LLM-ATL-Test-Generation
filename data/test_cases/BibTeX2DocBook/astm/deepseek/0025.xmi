<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Manual"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings" year="2021"/>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Unpublished manuscript">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 -->
    <entries xsi:type="BibTeX:TechReport" id="tech01" title="Technical Report" year="2022">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2019" publisher="Addison-Wesley">
        <authors author="Ian Sommerville"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2020" publisher="Springer" chapter="5">
        <authors author="Jane Doe"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Paper" year="2021" publisher="IEEE" booktitle="Advances in Computing">
        <authors author="John Smith"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Conference Paper" year="2022" booktitle="ICSE 2022">
        <authors author="Mary Johnson"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation" year="2023" school="MIT">
        <authors author="David Brown"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis" year="2022" school="Stanford">
        <authors author="Emma Wilson"/>
    </entries>
    
    <!-- Duplicate title with manual01 - triggers R5 -->
    <entries xsi:type="BibTeX:Manual" id="manual02" title="Software Manual"/>
    
    <!-- Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Model-Driven Engineering" year="2023" journal="IEEE Software">
        <authors author="Tom Harris"/>
    </entries>
    
    <!-- Article with duplicate title (same as art01) but unique journal - triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art02" title="Model-Driven Engineering" year="2024" journal="ACM Computing Surveys">
        <authors author="Lisa White"/>
    </entries>
    
    <!-- Article with unique title but duplicate journal (same as art01) - triggers R8 -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Software Testing Techniques" year="2023" journal="IEEE Software">
        <authors author="Chris Green"/>
    </entries>
    
    <!-- Article with duplicate title (same as art03) and duplicate journal (same as art01) - triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Software Testing Techniques" year="2024" journal="IEEE Software">
        <authors author="Pat Black"/>
    </entries>
    
</BibTeX:BibTeXFile>