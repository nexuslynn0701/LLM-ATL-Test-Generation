<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2023"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Manual"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings" year="2022"/>
    
    <!-- Two Unpublished with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Unpublished draft">
        <authors author="Alice Smith"/>
    </entries>
    <entries xsi:type="BibTeX:Unpublished" id="unpub02" title="Draft Paper" note="Revised version">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- TechReport - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:TechReport" id="tech01" title="Technical Report 2024" year="2024">
        <authors author="Carol White"/>
    </entries>
    
    <!-- Book - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Introduction to MDE" year="2021" publisher="Springer">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InBook - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Transformations" year="2020" publisher="Wiley" chapter="5">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- InCollection - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Article" year="2019" publisher="ACM" booktitle="Best Papers">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- InProceedings - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Conference Paper" year="2023" booktitle="ICSE 2023">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- MasterThesis - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:MasterThesis" id="msthesis01" title="Master Thesis on MDE" year="2022" school="MIT">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- PhDThesis - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:PhDThesis" id="phdthesis01" title="PhD Dissertation on Transformations" year="2023" school="Stanford">
        <authors author="Ivy Taylor"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Novel MDE Approach" year="2024" journal="Journal of Software Engineering">
        <authors author="Jack Anderson"/>
    </entries>
    
    <!-- Article with same title as another article but different journal - first triggers R6, second triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art02" title="Model Transformation Techniques" year="2023" journal="IEEE Software">
        <authors author="Karen Thomas"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art03" title="Model Transformation Techniques" year="2023" journal="ACM Computing Surveys">
        <authors author="Leo Garcia"/>
    </entries>
    
    <!-- Article with unique title but same journal as another - first triggers R6, second triggers R8 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Testing Strategies" year="2022" journal="Journal of Software Engineering">
        <authors author="Maria Rodriguez"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - first triggers R6, second triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Code Generation" year="2021" journal="Software Practice and Experience">
        <authors author="Nathan Clark"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art06" title="Code Generation" year="2021" journal="Software Practice and Experience">
        <authors author="Olivia Martinez"/>
    </entries>
    
    <!-- Additional author for testing Author rule (R2) - distinct author -->
    <entries xsi:type="BibTeX:Article" id="art07" title="Distinct Author Test" year="2020" journal="Journal of Systems">
        <authors author="Paul White"/>
    </entries>
    
</BibTeX:BibTeXFile>