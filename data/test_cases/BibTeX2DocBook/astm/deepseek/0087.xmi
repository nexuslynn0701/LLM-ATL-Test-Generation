<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Documentation Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Two Manuals with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:Manual" id="manual02" title="User Manual"/>
    <entries xsi:type="BibTeX:Manual" id="manual03" title="User Manual"/>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Unpublished manuscript">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tech01" title="Technical Report 2024" year="2024">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2022" publisher="Springer">
        <authors author="Charlie Brown"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2022" publisher="Springer" chapter="5">
        <authors author="Diana Prince"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Article" year="2021" publisher="Elsevier" booktitle="Advances in Computing">
        <authors author="Eve Adams"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Conference Paper" year="2023" booktitle="ICSE 2023">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation on MDE" year="2023" school="MIT">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis on Transformations" year="2022" school="Stanford">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - first triggers R6, second triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Model Transformation" year="2023" journal="JSS">
        <authors author="Ivy Chen"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Model Transformation" year="2024" journal="JSS">
        <authors author="Jack Davis"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Testing Approaches" year="2023" journal="TSE">
        <authors author="Karen White"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - first triggers R6, second triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Code Analysis" year="2022" journal="EMSE">
        <authors author="Leo Brown"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art05" title="Code Analysis" year="2023" journal="STVR">
        <authors author="Maria Garcia"/>
    </entries>
    
    <!-- Two Articles with different titles but same journal - first triggers R6, second triggers R8 -->
    <entries xsi:type="BibTeX:Article" id="art06" title="Verification Methods" year="2023" journal="FSE">
        <authors author="Nick Taylor"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art07" title="Validation Techniques" year="2024" journal="FSE">
        <authors author="Olivia Martinez"/>
    </entries>
    
    <!-- Duplicate author to test Author rule filtering -->
    <entries xsi:type="BibTeX:Book" id="book02" title="Duplicate Author Test" year="2020" publisher="Wiley">
        <authors author="Alice Smith"/>
    </entries>
    
</BibTeX:BibTeXFile>