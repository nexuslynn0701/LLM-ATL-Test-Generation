<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc - triggers UntitledEntry (R3) -->
    <entries xsi:type="BibTeX:Misc" id="Misc2024"/>
    
    <!-- Booklet - triggers UntitledEntry (R3) -->
    <entries xsi:type="BibTeX:Booklet" id="Booklet2023" year="2023"/>
    
    <!-- Article with unique title and unique journal - triggers Article_Title_Journal (R6) -->
    <entries xsi:type="BibTeX:Article" id="Art01" title="Quantum Computing" year="2022" journal="Nature">
        <authors author="Einstein"/>
        <authors author="Bohr"/>
    </entries>
    
    <!-- Article with same title as Art03 but unique journal - triggers Article_NoTitle_Journal (R7) -->
    <entries xsi:type="BibTeX:Article" id="Art02" title="Quantum Computing" year="2021" journal="Science">
        <authors author="Feynman"/>
    </entries>
    
    <!-- Article with unique title but same journal as Art04 - triggers Article_Title_NoJournal (R8) -->
    <entries xsi:type="BibTeX:Article" id="Art03" title="Machine Learning" year="2023" journal="Nature">
        <authors author="Turing"/>
    </entries>
    
    <!-- Article with same title as Art02 and same journal as Art03 - triggers Article_NoTitle_NoJournal (R9) -->
    <entries xsi:type="BibTeX:Article" id="Art04" title="Machine Learning" year="2023" journal="Nature">
        <authors author="Neumann"/>
    </entries>
    
    <!-- Book with unique title - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Book" id="Book01" title="Data Structures" year="2020" publisher="MIT Press">
        <authors author="Knuth"/>
    </entries>
    
    <!-- InBook with same title as Book02 - triggers TitledEntry_NoTitle_NoArticle (R5) -->
    <entries xsi:type="BibTeX:InBook" id="InBook01" title="Data Structures" year="2021" publisher="Springer" chapter="1">
        <authors author="Wirth"/>
    </entries>
    
    <!-- Book with different title - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Book" id="Book02" title="Algorithms" year="2019" publisher="Addison-Wesley">
        <authors author="Cormen"/>
    </entries>
    
    <!-- Proceedings - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Proceedings" id="Proc01" title="ICSE 2022" year="2022"/>
    
    <!-- Manual - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Manual" id="Man01" title="User Guide"/>
    
    <!-- Unpublished - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Unpublished" id="Unpub01" title="Draft Notes" note="Under review">
        <authors author="Hawking"/>
    </entries>
    
    <!-- PhDThesis - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:PhDThesis" id="PhD01" title="Cosmology" year="2018" school="Cambridge">
        <authors author="Penrose"/>
    </entries>
    
    <!-- MasterThesis - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:MasterThesis" id="MSc01" title="Robot Vision" year="2020" school="MIT">
        <authors author="Minsky"/>
    </entries>
    
    <!-- TechReport - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:TechReport" id="TR01" title="Network Security" year="2021">
        <authors author="Shannon"/>
    </entries>
    
    <!-- InCollection - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:InCollection" id="IC01" title="Compiler Design" year="2022" booktitle="CS Surveys" publisher="Elsevier">
        <authors author="Aho"/>
    </entries>
    
    <!-- InProceedings - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:InProceedings" id="IP01" title="Logic Programming" year="2020" booktitle="LP Conference">
        <authors author="Kowalski"/>
    </entries>
    
    <!-- Additional authors that are not attached to any entry (still Author instances) -->
    <entries xsi:type="BibTeX:Misc" id="Misc99"/>
    <entries xsi:type="BibTeX:Misc" id="Misc98"/>
    
</BibTeX:BibTeXFile>