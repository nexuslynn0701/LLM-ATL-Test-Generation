<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- UntitledEntry: Misc (no title, no authors, no date) -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- UntitledEntry: Booklet (dated but no title) -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2023"/>
    
    <!-- TitledEntry_Title_NoArticle: Manual (titled, no authors, no date) -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="LaTeX User Guide"/>
    
    <!-- TitledEntry_Title_NoArticle: Proceedings (titled, dated, no authors) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="ICSE 2023" year="2023"/>
    
    <!-- TitledEntry_Title_NoArticle: TechReport (authored, dated, titled) -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Model-Driven Engineering Report" year="2022">
        <authors author="Jane Smith"/>
        <authors author="John Doe"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: Unpublished (authored, titled, with note) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper on MDE" note="Under review">
        <authors author="Alice Brown"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: Book (authored, dated, titled, publisher) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2021" publisher="Addison-Wesley">
        <authors author="Ian Sommerville"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: InBook (authored, dated, titled, publisher, chapter) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Advanced Topics" year="2020" publisher="Springer" chapter="5">
        <authors author="Robert Martin"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: InCollection (authored, dated, titled, booktitle, publisher) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Chapter" year="2019" booktitle="MDE Advances" publisher="Springer">
        <authors author="Elena Garcia"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: InProceedings (authored, dated, titled, booktitle) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Model Transformations" year="2023" booktitle="MODELS 2023">
        <authors author="Carlos Lopez"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: PhDThesis (authored, dated, titled, school) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="Automated Model Analysis" year="2022" school="MIT">
        <authors author="Sarah Johnson"/>
    </entries>
    
    <!-- TitledEntry_Title_NoArticle: MasterThesis (authored, dated, titled, school) -->
    <entries xsi:type="BibTeX:MasterThesis" id="mst01" title="Code Generation Techniques" year="2023" school="Stanford">
        <authors author="David Kim"/>
    </entries>
    
    <!-- Duplicate title to trigger TitledEntry_NoTitle_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="manual02" title="LaTeX User Guide"/>
    
    <!-- Article_Title_Journal: unique title and unique journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="New MDE Approach" year="2023" journal="JSS">
        <authors author="Maria Rossi"/>
    </entries>
    
    <!-- Article_NoTitle_Journal: duplicate title with art01, unique journal -->
    <entries xsi:type="BibTeX:Article" id="art02" title="New MDE Approach" year="2022" journal="TSE">
        <authors author="Luis Chen"/>
    </entries>
    
    <!-- Article_Title_NoJournal: unique title, duplicate journal with art01 -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Testing Strategies" year="2023" journal="JSS">
        <authors author="Anna White"/>
    </entries>
    
    <!-- Article_NoTitle_NoJournal: duplicate title with art01, duplicate journal with art01 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="New MDE Approach" year="2021" journal="JSS">
        <authors author="Tom Black"/>
    </entries>
    
</BibTeX:BibTeXFile>