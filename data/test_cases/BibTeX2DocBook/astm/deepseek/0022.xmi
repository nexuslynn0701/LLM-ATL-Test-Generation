<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="LaTeX Manual"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Two InProceedings with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Model-Driven Engineering" year="2022" booktitle="MODELS 2022">
        <authors author="Alice Smith"/>
        <authors author="Bob Johnson"/>
    </entries>
    <entries xsi:type="BibTeX:InProceedings" id="inproc02" title="Model-Driven Engineering" year="2023" booktitle="ICSE 2023">
        <authors author="Charlie Brown"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2021" publisher="Addison-Wesley">
        <authors author="David Wilson"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2020" publisher="Springer" chapter="5">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="Automated Verification" year="2022" school="MIT">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Code Generation" year="2023" school="Stanford">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report on MDE" year="2023">
        <authors author="Henry Taylor"/>
    </entries>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Under review">
        <authors author="Iris Anderson"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Chapter" year="2021" booktitle="Advances in CS" publisher="ACM">
        <authors author="Jack Thomas"/>
    </entries>
    
    <!-- First Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="New Approach to Testing" year="2023" journal="JSS">
        <authors author="Karen White"/>
    </entries>
    
    <!-- Second Article with same title as art01 but different journal - triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art02" title="New Approach to Testing" year="2024" journal="TSE">
        <authors author="Leo Black"/>
    </entries>
    
    <!-- Third Article with different title but same journal as art01 - triggers R8 -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Novel Verification Method" year="2023" journal="JSS">
        <authors author="Maria Green"/>
    </entries>
    
    <!-- Fourth Article with same title as art03 and same journal as art01 - triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Novel Verification Method" year="2024" journal="JSS">
        <authors author="Nathan Brown"/>
    </entries>
    
    <!-- Additional author to trigger R2 (distinct from authors already present) -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Distinct Journal Article" year="2022" journal="EMSE">
        <authors author="Olivia Clark"/>
    </entries>
    
</BibTeX:BibTeXFile>