<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc - triggers UntitledEntry (R3) -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet - triggers UntitledEntry (R3) -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2023"/>
    
    <!-- Manual - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="Software Documentation Guide"/>
    
    <!-- Proceedings - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="International Conference on AI" year="2024"/>
    
    <!-- Unpublished - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper on Quantum Computing" note="Under review">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Annual Technical Report 2024" year="2024">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Introduction to Machine Learning" year="2023" publisher="Springer">
        <authors author="Carol Williams"/>
    </entries>
    
    <!-- InBook - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Advanced Topics in ML" year="2023" publisher="Springer" chapter="5">
        <authors author="Carol Williams"/>
    </entries>
    
    <!-- InCollection - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Data Mining Techniques" year="2023" publisher="Elsevier" booktitle="Handbook of Data Science">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InProceedings - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Neural Network Optimization" year="2024" booktitle="Proceedings of ICML 2024">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- PhDThesis - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="Deep Learning Architectures" year="2024" school="MIT">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- MasterThesis - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Reinforcement Learning Applications" year="2023" school="Stanford">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers Article_Title_Journal (R6) -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Novel Approaches in NLP" year="2024" journal="Journal of AI Research">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- Article with duplicate title (same as art02) but unique journal - triggers Article_NoTitle_Journal (R7) -->
    <entries xsi:type="BibTeX:Article" id="art02" title="Duplicate Title Article" year="2024" journal="ACM Computing Surveys">
        <authors author="Iris Taylor"/>
    </entries>
    
    <!-- Article with duplicate title (same as art02) and duplicate journal (same as art03) - triggers Article_NoTitle_NoJournal (R9) -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Duplicate Title Article" year="2023" journal="IEEE Software">
        <authors author="Jack Anderson"/>
    </entries>
    
    <!-- Article with unique title but duplicate journal (same as art03) - triggers Article_Title_NoJournal (R8) -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Software Engineering Best Practices" year="2023" journal="IEEE Software">
        <authors author="Karen Thomas"/>
    </entries>
    
    <!-- Additional author to trigger Author rule (R2) - distinct author name -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Cloud Computing Trends" year="2024" journal="Journal of Cloud Computing">
        <authors author="Laura Garcia"/>
    </entries>
    
</BibTeX:BibTeXFile>