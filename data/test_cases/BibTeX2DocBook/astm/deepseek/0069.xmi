<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="Software Documentation Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Two Unpublished with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Notes" note="Preliminary version">
        <authors author="Alice Smith"/>
    </entries>
    <entries xsi:type="BibTeX:Unpublished" id="unpub02" title="Draft Notes" note="Revised version">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- TechReport - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tech01" title="Technical Report on AI" year="2022">
        <authors author="Charlie Brown"/>
    </entries>
    
    <!-- Book - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2021" publisher="Addison-Wesley">
        <authors author="David Lee"/>
    </entries>
    
    <!-- InBook - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2021" publisher="Springer" chapter="5">
        <authors author="Eve Wilson"/>
    </entries>
    
    <!-- InCollection - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collected Works" year="2020" publisher="MIT Press" booktitle="Advances in Computing">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- InProceedings - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Novel Algorithms" year="2023" booktitle="ICSE 2023">
        <authors author="Grace Kim"/>
    </entries>
    
    <!-- PhDThesis - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Research on MDE" year="2022" school="MIT">
        <authors author="Henry Adams"/>
    </entries>
    
    <!-- MasterThesis - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis on Testing" year="2021" school="Stanford">
        <authors author="Iris Chen"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - first triggers R6, second triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Machine Learning Advances" year="2023" journal="JMLR">
        <authors author="Jack Davis"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Machine Learning Advances" year="2024" journal="JMLR">
        <authors author="Karen White"/>
    </entries>
    
    <!-- Article with unique title but same journal as above - triggers R8 (title unique, journal not unique) -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Deep Learning Survey" year="2023" journal="JMLR">
        <authors author="Leo Brown"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Quantum Computing" year="2024" journal="Nature">
        <authors author="Maria Garcia"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - first triggers R6, second triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Data Mining Techniques" year="2022" journal="KDD">
        <authors author="Nathan Park"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art06" title="Data Mining Techniques" year="2023" journal="TKDE">
        <authors author="Olivia Taylor"/>
    </entries>
    
</BibTeX:BibTeXFile>