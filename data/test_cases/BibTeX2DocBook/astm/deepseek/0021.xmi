<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="LaTeX Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Unpublished manuscript">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tech01" title="Technical Report 2024" year="2024">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2022" publisher="Addison-Wesley">
        <authors author="Ian Sommerville"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2021" publisher="Springer" chapter="5">
        <authors author="Jane Doe"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Advances in MDE" year="2023" publisher="IEEE" booktitle="MDE Handbook">
        <authors author="John Smith"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Model Transformation Testing" year="2024" booktitle="ICSE 2024">
        <authors author="Mary Jones"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="mthesis01" title="Master Thesis on MDE" year="2023" school="MIT">
        <authors author="Tom Brown"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phthesis01" title="PhD Thesis on ATL" year="2022" school="Stanford">
        <authors author="Sarah Wilson"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - triggers R7 (Article_NoTitle_Journal) -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Common Title" year="2023" journal="Journal of Software">
        <authors author="David Lee"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Common Title" year="2024" journal="Journal of Systems">
        <authors author="Emma Davis"/>
    </entries>
    
    <!-- Two Articles with different titles but same journal - triggers R8 (Article_Title_NoJournal) -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Unique Title One" year="2022" journal="Same Journal">
        <authors author="Frank Miller"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art04" title="Unique Title Two" year="2023" journal="Same Journal">
        <authors author="Grace Taylor"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - triggers R9 (Article_NoTitle_NoJournal) -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Duplicate Article" year="2021" journal="Duplicate Journal">
        <authors author="Henry Clark"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art06" title="Duplicate Article" year="2022" journal="Duplicate Journal">
        <authors author="Iris White"/>
    </entries>
    
    <!-- Single unique Article - triggers R6 (Article_Title_Journal) -->
    <entries xsi:type="BibTeX:Article" id="art07" title="Unique Article" year="2024" journal="Unique Journal">
        <authors author="Jack Black"/>
    </entries>
    
    <!-- Duplicate author to test Author rule deduplication -->
    <entries xsi:type="BibTeX:Book" id="book02" title="Another Book" year="2020" publisher="O'Reilly">
        <authors author="Alice Smith"/>
    </entries>
    
</BibTeX:BibTeXFile>