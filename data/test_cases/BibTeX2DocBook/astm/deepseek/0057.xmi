<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Manual"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Two Unpublished with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Initial version">
        <authors author="Alice Smith"/>
    </entries>
    <entries xsi:type="BibTeX:Unpublished" id="unpub02" title="Draft Paper" note="Revised version">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tech01" title="Technical Report 2024" year="2024">
        <authors author="Charlie Brown"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Advanced Programming" year="2022" publisher="Springer">
        <authors author="Diana Prince"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Algorithms" year="2021" publisher="MIT Press" chapter="5">
        <authors author="Eve Adams"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collected Works" year="2020" publisher="Oxford Press" booktitle="Anthology of CS">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Conference Paper" year="2023" booktitle="ICSE 2023">
        <authors author="Grace Hopper"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation" year="2023" school="MIT">
        <authors author="Henry Ford"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis" year="2022" school="Stanford">
        <authors author="Iris Chang"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - first triggers R6, second triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Quantum Computing" year="2024" journal="Nature">
        <authors author="Jack Smith"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Quantum Computing" year="2024" journal="Nature">
        <authors author="Karen White"/>
    </entries>
    
    <!-- Article with unique title and same journal as above - triggers R8 (unique title, duplicate journal) -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Machine Learning Advances" year="2023" journal="Nature">
        <authors author="Leo Brown"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Data Science Trends" year="2024" journal="Science">
        <authors author="Maria Garcia"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - first triggers R6, second triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art05" title="AI Ethics" year="2023" journal="IEEE">
        <authors author="Nathan Lee"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art06" title="AI Ethics" year="2023" journal="ACM">
        <authors author="Olivia Taylor"/>
    </entries>
    
</BibTeX:BibTeXFile>