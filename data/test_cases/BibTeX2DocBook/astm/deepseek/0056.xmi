<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Untitled entries: Misc and Booklet (R3) -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2023"/>
    
    <!-- Unique titled non-article entries (R4) -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="LaTeX User Guide"/>
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="ICSE 2023" year="2023"/>
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Model Checking Report" year="2022">
        <authors author="Edmund Clarke"/>
    </entries>
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Notes" note="Under review">
        <authors author="Alan Turing"/>
    </entries>
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2021" publisher="Addison-Wesley">
        <authors author="Ian Sommerville"/>
    </entries>
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2020" publisher="Springer" chapter="5">
        <authors author="Glenford Myers"/>
    </entries>
    <entries xsi:type="BibTeX:InCollection" id="incoll01" title="Advances in MDE" year="2019" publisher="Springer" booktitle="MDE Handbook">
        <authors author="Jean Bezivin"/>
    </entries>
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="ATL Transformations" year="2018" booktitle="MODELS 2018">
        <authors author="Frederic Jouault"/>
    </entries>
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Model Transformation Testing" year="2022" school="University of York">
        <authors author="Jane Doe"/>
    </entries>
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="Formal Methods in MDE" year="2021" school="TU Berlin">
        <authors author="John Smith"/>
    </entries>
    
    <!-- Duplicate title entries (R5) - same title as another entry -->
    <entries xsi:type="BibTeX:Manual" id="man02" title="LaTeX User Guide"/>
    <entries xsi:type="BibTeX:TechReport" id="tr02" title="Model Checking Report" year="2021">
        <authors author="Gerard Holzmann"/>
    </entries>
    
    <!-- Articles with unique titles and unique journals (R6) -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Model-Driven Engineering" year="2020" journal="IEEE Software">
        <authors author="Bran Selic"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="ATL: A Model Transformation Language" year="2019" journal="SoSyM">
        <authors author="Frederic Jouault"/>
        <authors author="Ivan Kurtev"/>
    </entries>
    
    <!-- Articles with duplicate titles but unique journals (R7) -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Model-Driven Engineering" year="2018" journal="JSS">
        <authors author="Douglas Schmidt"/>
    </entries>
    
    <!-- Articles with unique titles but duplicate journals (R8) -->
    <entries xsi:type="BibTeX:Article" id="art04" title="UML 2.0 Semantics" year="2017" journal="IEEE Software">
        <authors author="James Rumbaugh"/>
    </entries>
    
    <!-- Articles with duplicate titles and duplicate journals (R9) -->
    <entries xsi:type="BibTeX:Article" id="art05" title="UML 2.0 Semantics" year="2016" journal="IEEE Software">
        <authors author="Grady Booch"/>
    </entries>
    
    <!-- Additional author to trigger Author rule (R2) -->
    <entries xsi:type="BibTeX:Book" id="book02" title="Design Patterns" year="1994" publisher="Addison-Wesley">
        <authors author="Erich Gamma"/>
        <authors author="Richard Helm"/>
        <authors author="Ralph Johnson"/>
