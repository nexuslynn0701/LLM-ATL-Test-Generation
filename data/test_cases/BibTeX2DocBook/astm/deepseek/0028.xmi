<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2023"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="Software Documentation Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Two TechReports with same title - one triggers R4, other triggers R5 -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report on AI" year="2022">
        <authors author="Alice Smith"/>
    </entries>
    <entries xsi:type="BibTeX:TechReport" id="tr02" title="Technical Report on AI" year="2023">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Under review">
        <authors author="Carol White"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Introduction to MDE" year="2021" publisher="Springer">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Transformations" year="2020" publisher="Wiley" chapter="5">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Article" year="2019" publisher="ACM" booktitle="Advances in MDE">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Conference Paper" year="2023" booktitle="MODELS 2023">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation on MDE" year="2022" school="MIT">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis on Transformations" year="2021" school="Stanford">
        <authors author="Ivy Taylor"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - one triggers R6, other triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="MDE Advances" year="2023" journal="SoSyM">
        <authors author="Jack Anderson"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="MDE Advances" year="2024" journal="SoSyM">
        <authors author="Karen Thomas"/>
    </entries>
    
    <!-- Article with unique title but duplicate journal - triggers R8 -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Model Checking" year="2023" journal="SoSyM">
        <authors author="Leo Garcia"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Code Generation" year="2022" journal="TSE">
        <authors author="Maria Rodriguez"/>
    </entries>
    
    <!-- Article with duplicate title but unique journal - triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Code Generation" year="2023" journal="EMSE">
        <authors author="Nathan Clark"/>
    </entries>
    
</BibTeX:BibTeXFile>