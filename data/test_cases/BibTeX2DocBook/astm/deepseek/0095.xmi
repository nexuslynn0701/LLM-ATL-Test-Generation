<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Untitled entries: Misc (R3) -->
    <entries xsi:type="BibTeX:Misc" id="misc1"/>
    <entries xsi:type="BibTeX:Misc" id="misc2"/>
    
    <!-- Untitled entries: Booklet (R3) -->
    <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2020"/>
    <entries xsi:type="BibTeX:Booklet" id="booklet2" year="2021"/>
    
    <!-- Unique titled non-article entries (R4) -->
    <entries xsi:type="BibTeX:Manual" id="manual1" title="Unique Manual Title">
        <authors author="Smith"/>
    </entries>
    <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Unique Proceedings Title" year="2022"/>
    <entries xsi:type="BibTeX:TechReport" id="tr1" title="Unique TechReport Title" year="2022">
        <authors author="Jones"/>
    </entries>
    <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Unique Unpublished Title" note="Draft">
        <authors author="Brown"/>
    </entries>
    <entries xsi:type="BibTeX:Book" id="book1" title="Unique Book Title" year="2021" publisher="Springer">
        <authors author="Lee"/>
    </entries>
    <entries xsi:type="BibTeX:InBook" id="inbook1" title="Unique InBook Title" year="2020" publisher="Wiley" chapter="5">
        <authors author="Wang"/>
    </entries>
    <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Unique InCollection Title" year="2019" publisher="IEEE" booktitle="ICSE 2019">
        <authors author="Chen"/>
    </entries>
    <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Unique InProceedings Title" year="2022" booktitle="MODELS 2022">
        <authors author="Miller"/>
    </entries>
    <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Unique PhD Thesis Title" year="2023" school="MIT">
        <authors author="Davis"/>
    </entries>
    <entries xsi:type="BibTeX:MasterThesis" id="msc1" title="Unique MSc Thesis Title" year="2023" school="Stanford">
        <authors author="Wilson"/>
    </entries>
    
    <!-- Titled non-article entries with duplicate titles (R5 - duplicates of existing titles) -->
    <entries xsi:type="BibTeX:Manual" id="manual2" title="Unique Manual Title">
        <authors author="Taylor"/>
    </entries>
    <entries xsi:type="BibTeX:Proceedings" id="proc2" title="Unique Proceedings Title" year="2021"/>
    
    <!-- Unique articles (R6: unique title AND unique journal) -->
    <entries xsi:type="BibTeX:Article" id="art1" title="Quantum Computing Survey" year="2023" journal="ACM Computing Surveys">
        <authors author="Kim"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art2" title="Machine Learning Advances" year="2023" journal="Nature Machine Intelligence">
        <authors author="Patel"/>
    </entries>
    
    <!-- Articles with duplicate title but unique journal (R7) -->
    <entries xsi:type="BibTeX:Article" id="art3" title="Software Engineering Methods" year="2022" journal="TSE">
        <authors author="Garcia"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art4" title="Software Engineering Methods" year="2022" journal="JSS">
        <authors author="Martinez"/>
    </entries>
    
    <!-- Articles with unique title but duplicate journal (R8) -->
    <entries xsi:type="BibTeX:Article" id="art5" title="AI in Healthcare" year="2023" journal="IEEE Access">
        <authors author="Anderson"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art6" title="Blockchain Applications" year="2023" journal="IEEE Access">
        <authors author="Thompson"/>
    </entries>
    
    <!-- Articles with duplicate title AND duplicate journal (R9) -->
    <entries xsi:type="BibTeX:Article" id="art7" title="Data Science Trends" year="2022" journal="Data Science Journal">
        <authors author="Robinson"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art8" title="Data Science Trends" year="2021" journal="Data Science Journal">
        <authors author="Clark"/>
    </entries>

</BibTeX:BibTeXFile>