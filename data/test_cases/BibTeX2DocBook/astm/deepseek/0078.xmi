<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    <!-- UntitledEntry (R3): Misc and Booklet -->
    <entries xsi:type="BibTeX:Misc" id="misc1"/>
    <entries xsi:type="BibTeX:Misc" id="misc2"/>
    <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2020"/>

    <!-- TitledEntry_Title_NoArticle (R4): Unique titles for non-Article types -->
    <entries xsi:type="BibTeX:Manual" id="man1" title="Unix Guide"/>
    <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conference 2024" year="2024"/>
    <entries xsi:type="BibTeX:TechReport" id="tr1" title="TR Report" year="2023">
        <authors author="Alice White"/>
    </entries>
    <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft Notes" note="Unpublished manuscript">
        <authors author="Bob Green"/>
    </entries>
    <entries xsi:type="BibTeX:Book" id="book1" title="Software Engineering" year="2021" publisher="MIT Press">
        <authors author="Mary Johnson"/>
    </entries>
    <entries xsi:type="BibTeX:InBook" id="ibook1" title="Chapter Insights" year="2020" publisher="Springer" chapter="5">
        <authors author="Tom Harris"/>
    </entries>
    <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="PhD Thesis" year="2022" school="Stanford">
        <authors author="Jane Doe"/>
    </entries>
    <entries xsi:type="BibTeX:MasterThesis" id="msc1" title="Master Thesis" year="2021" school="MIT">
        <authors author="John Doe"/>
    </entries>
    <entries xsi:type="BibTeX:InCollection" id="incol1" title="Collection Essay" year="2019" publisher="Elsevier" booktitle="Book of Essays">
        <authors author="Laura King"/>
    </entries>
    <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Paper in Proceedings" year="2023" booktitle="Workshop 2023">
        <authors author="David Lee"/>
    </entries>

    <!-- TitledEntry_NoTitle_NoArticle (R5): Duplicate title for non-Article types -->
    <entries xsi:type="BibTeX:Manual" id="man2" title="Unix Guide"/>

    <!-- Article_Title_Journal (R6): Unique title and unique journal -->
    <entries xsi:type="BibTeX:Article" id="art1" title="Quantum Computing" year="2024" journal="Nature">
        <authors author="Einstein"/>
    </entries>

    <!-- Article_NoTitle_Journal (R7): Duplicate title but unique journal -->
    <entries xsi:type="BibTeX:Article" id="art2" title="Quantum Computing" year="2023" journal="Science">
        <authors author="Bohr"/>
    </entries>

    <!-- Article_Title_NoJournal (R8): Unique title but duplicate journal -->
    <entries xsi:type="BibTeX:Article" id="art3" title="AI Advances" year="2022" journal="Nature">
        <authors author="Turing"/>
    </entries>

    <!-- Article_NoTitle_NoJournal (R9): Duplicate title and duplicate journal -->
    <entries xsi:type="BibTeX:Article" id="art4" title="AI Advances" year="2021" journal="Nature">
        <authors author="Shannon"/>
    </entries>
</BibTeX:BibTeXFile>