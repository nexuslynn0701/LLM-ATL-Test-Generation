<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="LaTeX Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="ICSE 2023" year="2023"/>
    
    <!-- Two Unpublished with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Unpublished">
        <authors author="Alice Smith"/>
    </entries>
    <entries xsi:type="BibTeX:Unpublished" id="unpub02" title="Draft Paper" note="Unpublished draft">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report 2024" year="2024">
        <authors author="Carol White"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2022" publisher="Addison-Wesley">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2021" publisher="Springer" chapter="5">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Paper" year="2020" publisher="IEEE" booktitle="Advances in CS">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Conference Paper" year="2023" booktitle="MODELS 2023">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation" year="2024" school="MIT">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis" year="2023" school="Stanford">
        <authors author="Ivy Taylor"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - triggers R9 (Article_NoTitle_NoJournal) -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Duplicate Article" year="2023" journal="JSS">
        <authors author="Jack Anderson"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Duplicate Article" year="2024" journal="JSS">
        <authors author="Karen Thomas"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 (Article_Title_Journal) -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Unique Article" year="2022" journal="TSE">
        <authors author="Leo Garcia"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - first triggers R6, second triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Shared Title" year="2021" journal="EMSE">
        <authors author="Maria Rodriguez"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art05" title="Shared Title" year="2020" journal="IST">
        <authors author="Nathan Clark"/>
    </entries>
    
    <!-- Two Articles with different titles but same journal - first triggers R6, second triggers R8 -->
    <entries xsi:type="BibTeX:Article" id="art06" title="First in Journal" year="2023" journal="SQJ">
        <authors author="Olivia Hall"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art07" title="Second in Journal" year="2022" journal="SQJ">
        <authors author="Paul Young"/>
    </entries>
    
</BibTeX:BibTeXFile>