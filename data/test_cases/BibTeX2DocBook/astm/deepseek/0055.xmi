<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc entry (untitled) to trigger R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Misc" id="Misc01"/>
    <entries xsi:type="BibTeX:Misc" id="Misc02"/>
    
    <!-- Booklet entry (untitled, dated) to trigger R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Booklet" id="Booklet01" year="2020"/>
    <entries xsi:type="BibTeX:Booklet" id="Booklet02" year="2021"/>
    
    <!-- Two Manual entries with unique titles to trigger R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="Manual01" title="LaTeX Manual"/>
    <entries xsi:type="BibTeX:Manual" id="Manual02" title="Word Processing Guide"/>
    
    <!-- Two Manual entries with the same title to trigger R5 TitledEntry_NoTitle_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="Manual03" title="Duplicate Title"/>
    <entries xsi:type="BibTeX:Manual" id="Manual04" title="Duplicate Title"/>
    
    <!-- Two Proceedings entries with unique titles to trigger R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Proceedings" id="Proc01" title="ICSE 2023" year="2023"/>
    <entries xsi:type="BibTeX:Proceedings" id="Proc02" title="MoDELS 2022" year="2022"/>
    
    <!-- InProceedings entry (triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:InProceedings" id="InProc01" title="Model Transformation Testing" year="2024" booktitle="ICSE 2024">
        <authors author="Alice Smith"/>
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Unpublished entry (triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:Unpublished" id="Unpub01" title="Draft Paper" note="Unpublished work">
        <authors author="Charlie Brown"/>
    </entries>
    
    <!-- TechReport entry (triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:TechReport" id="TR01" title="Technical Report" year="2023">
        <authors author="Diana Prince"/>
    </entries>
    
    <!-- Book entry (triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:Book" id="Book01" title="Software Engineering" year="2021" publisher="Addison-Wesley">
        <authors author="Ian Sommerville"/>
    </entries>
    
    <!-- InBook entry (triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:InBook" id="InBook01" title="Chapter on Testing" year="2020" publisher="Springer" chapter="5">
        <authors author="Jane Doe"/>
    </entries>
    
    <!-- PhDThesis entry (triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:PhDThesis" id="PhD01" title="Automated Verification" year="2022" school="MIT">
        <authors author="John Smith"/>
    </entries>
    
    <!-- MasterThesis entry (triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:MasterThesis" id="MS01" title="Model Checking" year="2023" school="Stanford">
        <authors author="Mary Jones"/>
    </entries>
    
    <!-- Article with unique title and unique journal to trigger R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="Art01" title="New Approach to MDE" year="2024" journal="SoSyM">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- Article with unique title and unique journal to trigger R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="Art02" title="Transformation Analysis" year="2023" journal="Software &amp; Systems Modeling">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Two Articles with the same title but unique journals to trigger R7 Article_NoTitle_Journal -->
    <entries xsi:type="BibTeX:Article" id="Art03" title="Shared Title" year="2024" journal="JSS">
        <authors author="Charlie Brown"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="Art04" title="Shared Title" year="2023" journal="TSE">
        <authors author="Diana Prince"/>
    </entries>
    
    <!-- Two Articles with unique titles but same journal to trigger R8 Article_Title_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="Art05" title="Reusable Patterns" year="2024" journal="SoSyM">
        <authors author="Eve Adams"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="Art06" title="Domain-Specific Languages" year="2023" journal="SoSyM">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- Two Articles with same title and same journal to trigger R9 Article_NoTitle_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="Art07" title="Duplicate" year="2024" journal="IEEE Software">
        <authors author="Grace Lee"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="Art08" title="Duplicate" year="2023" journal="IEEE Software">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- InCollection entry (triggers R4 TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:InCollection" id="InCol01" title="Collection Chapter" year="2022" booktitle="Advances in SE" publisher="Springer">
        <authors author="Irene Chen"/>
    </entries>
    
    <!-- Additional authors to exercise R2 Author rule -->
    <entries xsi:type="BibTeX:Article" id="Art09" title="Data-Driven Methods" year="2024" journal="EMSE">
        <authors author="Jack Black"/>
        <authors author="Kyle White"/>
    </entries>
    
</BibTeX:BibTeXFile>