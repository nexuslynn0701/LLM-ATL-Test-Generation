<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="LaTeX User Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="MODELS 2023" year="2023"/>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Notes" note="Unfinished work">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report 2024" year="2024">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Model-Driven Engineering" year="2022" publisher="Springer">
        <authors author="Charlie Brown"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Transformations" year="2022" publisher="Springer" chapter="5">
        <authors author="Diana Prince"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Advances in MDE" year="2021" publisher="ACM" booktitle="Best of MODELS">
        <authors author="Eve Adams"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Model Transformations" year="2023" booktitle="MODELS 2023 Proceedings">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:MasterThesis" id="mt01" title="Master Thesis on MDE" year="2023" school="MIT">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Thesis on Transformations" year="2024" school="Stanford">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- Duplicate title to trigger R5 TitledEntry_NoTitle_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="man02" title="LaTeX User Guide"/>
    
    <!-- Article with unique title and unique journal - triggers R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="New MDE Techniques" year="2024" journal="SoSyM">
        <authors author="Iris Chen"/>
    </entries>
    
    <!-- Article with duplicate title (same as art01) but unique journal - triggers R7 Article_NoTitle_Journal -->
    <entries xsi:type="BibTeX:Article" id="art02" title="New MDE Techniques" year="2024" journal="JSS">
        <authors author="Jack Davis"/>
    </entries>
    
    <!-- Article with unique title but duplicate journal (same as art01) - triggers R8 Article_Title_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Advanced MDE" year="2024" journal="SoSyM">
        <authors author="Karen White"/>
    </entries>
    
    <!-- Article with duplicate title (same as art03) and duplicate journal (same as art01) - triggers R9 Article_NoTitle_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Advanced MDE" year="2024" journal="SoSyM">
        <authors author="Leo Black"/>
    </entries>
    
    <!-- Additional author to trigger R2 Author rule (distinct author names) -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Software Engineering" year="2023" journal="TSE">
        <authors author="Maria Garcia"/>
    </entries>
    
</BibTeX:BibTeXFile>