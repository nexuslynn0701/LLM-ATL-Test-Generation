<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="Software Manual"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings" year="2021"/>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Notes" note="Unfinished work">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report" year="2022">
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2023" publisher="Springer">
        <authors author="Charlie Brown"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2023" publisher="Springer" chapter="5">
        <authors author="Diana Prince"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collected Works" year="2021" publisher="Academic Press" booktitle="Advances in Computing">
        <authors author="Eve Adams"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Research Paper" year="2022" booktitle="ICSE 2022">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:MasterThesis" id="mt01" title="Master Thesis" year="2020" school="MIT">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation" year="2023" school="Stanford">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- Two Articles with same title but different journals - triggers R7 Article_NoTitle_Journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Common Title" year="2020" journal="Journal of Science">
        <authors author="Ivy Clark"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Common Title" year="2021" journal="Journal of Engineering">
        <authors author="Jack White"/>
    </entries>
    
    <!-- Two Articles with different titles but same journal - triggers R8 Article_Title_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Unique Title A" year="2022" journal="Same Journal">
        <authors author="Karen Black"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art04" title="Unique Title B" year="2023" journal="Same Journal">
        <authors author="Leo Green"/>
    </entries>
    
    <!-- One Article with unique title and unique journal - triggers R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Solo Article" year="2024" journal="Unique Journal">
        <authors author="Maria Brown"/>
    </entries>
    
    <!-- Two Articles with same title and same journal - triggers R9 Article_NoTitle_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art06" title="Duplicate Article" year="2020" journal="Duplicate Journal">
        <authors author="Nathan Grey"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art07" title="Duplicate Article" year="2021" journal="Duplicate Journal">
        <authors author="Olivia Blue"/>
    </entries>
    
    <!-- Additional author to trigger R2 Author rule -->
    <entries xsi:type="BibTeX:Article" id="art08" title="Another Article" year="2022" journal="Another Journal">
        <authors author="Unique Author"/>
    </entries>
    
</BibTeX:BibTeXFile>