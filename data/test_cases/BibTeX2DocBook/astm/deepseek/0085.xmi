<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Untitled entries: Misc and Booklet (R3) -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="1999"/>
    
    <!-- Two authors with same name to test Author rule (R2) deduplication -->
    <entries xsi:type="BibTeX:TechReport" id="tech01" title="Network Security" year="2020">
        <authors author="Alice Smith"/>
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- Two Articles with same title "Data Mining" and same journal "IEEE" for R9 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Data Mining" year="2018" journal="IEEE">
        <authors author="Charlie Brown"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="Data Mining" year="2019" journal="IEEE">
        <authors author="Diana Prince"/>
    </entries>
    
    <!-- An Article with unique title and unique journal for R6 -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Quantum Computing" year="2021" journal="Nature">
        <authors author="Eve Adams"/>
    </entries>
    
    <!-- Two Articles with same title "Deep Learning", different journals for R7 (same title, different journals) -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Deep Learning" year="2020" journal="AI Journal">
        <authors author="Frank Lee"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art05" title="Deep Learning" year="2021" journal="ML Review">
        <authors author="Grace Hopper"/>
    </entries>
    
    <!-- Two Articles with different titles, same journal "ACM" for R8 -->
    <entries xsi:type="BibTeX:Article" id="art06" title="Algorithms" year="2017" journal="ACM">
        <authors author="Henry Ford"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art07" title="Data Structures" year="2018" journal="ACM">
        <authors author="Iris Chang"/>
    </entries>
    
    <!-- Titled non-article entries for R4 (unique titles) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2015" publisher="Addison-Wesley">
        <authors author="Jack Wilson"/>
    </entries>
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="Machine Learning Theory" year="2022" school="MIT">
        <authors author="Karen Lee"/>
    </entries>
    <entries xsi:type="BibTeX:MasterThesis" id="ms01" title="Web Development" year="2021" school="Stanford">
        <authors author="Leo Messi"/>
    </entries>
    <entries xsi:type="BibTeX:Manual" id="manual01" title="User Guide"/>
    
    <!-- Two entries with same title "Database Systems" for R5 -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Database Systems" year="2019" booktitle="DB Conf">
        <authors author="Maria Santos"/>
    </entries>
    <entries xsi:type="BibTeX:InProceedings" id="inproc02" title="Database Systems" year="2020" booktitle="VLDB">
        <authors author="Nathan Drake"/>
    </entries>
    
    <!-- InBook with chapter for testing -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Advanced Topics" year="2020" publisher="Springer" chapter="5">
        <authors author="Olivia Wang"/>
    </entries>
    
    <!-- InCollection for testing -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Data Science Methods" year="2021" publisher="CRC Press" booktitle="Big Data Handbook">
        <authors author="Peter Pan"/>
    </entries>
    
    <!-- Unpublished with note for testing -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Research Notes" note="Draft version">
        <authors author="Quinn Hughes"/>
    </entries>
    
    <!-- Proceedings for testing -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings" year="2022"/>
    
</BibTeX:BibTeXFile>