<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2023"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="LaTeX Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="ICSE 2023" year="2023"/>
    
    <!-- Unpublished (titled entry, no article, authored) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Under review">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article, authored, dated) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report 2024" year="2024">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book (titled entry, no article, authored, dated) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2022" publisher="Addison-Wesley">
        <authors author="Ian Sommerville"/>
    </entries>
    
    <!-- InBook (titled entry, no article, authored, dated, chapter) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2021" publisher="Springer" chapter="5">
        <authors author="Jane Doe"/>
    </entries>
    
    <!-- InCollection (titled entry, no article, authored, dated, booktitle) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="MDE Advances" year="2020" publisher="Springer" booktitle="Advances in MDE">
        <authors author="John Smith"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article, authored, dated, booktitle) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Model Transformations" year="2023" booktitle="MODELS 2023">
        <authors author="Sarah Lee"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article, authored, dated, school) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:MasterThesis" id="mt01" title="Master Thesis on ATL" year="2024" school="MIT">
        <authors author="Tom Brown"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article, authored, dated, school) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD on Model Checking" year="2022" school="Stanford">
        <authors author="Lisa White"/>
    </entries>
    
    <!-- Duplicate title to trigger R5 TitledEntry_NoTitle_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="man02" title="LaTeX Guide"/>
    
    <!-- Article with unique title and unique journal - triggers R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="art01" title="ATL Transformations" year="2023" journal="SoSyM">
        <authors author="Erik Meijer"/>
    </entries>
    
    <!-- Article with duplicate title (same as art01) but unique journal - triggers R7 Article_NoTitle_Journal -->
    <entries xsi:type="BibTeX:Article" id="art02" title="ATL Transformations" year="2024" journal="JSS">
        <authors author="Martin Fowler"/>
    </entries>
    
    <!-- Article with unique title but duplicate journal (same as art01) - triggers R8 Article_Title_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Model-Driven Development" year="2023" journal="SoSyM">
        <authors author="Kent Beck"/>
    </entries>
    
    <!-- Article with duplicate title (same as art03) and duplicate journal (same as art01) - triggers R9 Article_NoTitle_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Model-Driven Development" year="2024" journal="SoSyM">
        <authors author="Grady Booch"/>
    </entries>
    
</BibTeX:BibTeXFile>