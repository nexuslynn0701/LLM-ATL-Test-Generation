<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 UntitledEntry -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="Software Manual"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings" year="2021"/>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Unpublished manuscript">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report 2023" year="2023">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Introduction to MDE" year="2022" publisher="Springer">
        <authors author="Carol Williams"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Transformations" year="2022" publisher="Springer" chapter="5">
        <authors author="David Brown"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Article" year="2021" publisher="ACM" booktitle="Best of MDE">
        <authors author="Eve Davis"/>
    </entries>
    
    <!-- InProceedings (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Model Checking" year="2023" booktitle="MODELS 2023">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation" year="2023" school="MIT">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 TitledEntry_Title_NoArticle -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis" year="2022" school="Stanford">
        <authors author="Henry Wilson"/>
    </entries>
    
    <!-- Two Articles with SAME title and SAME journal - triggers R9 Article_NoTitle_NoJournal for the second -->
    <entries xsi:type="BibTeX:Article" id="art01" title="ATL Patterns" year="2023" journal="SoSyM">
        <authors author="Ivy Taylor"/>
    </entries>
    <entries xsi:type="BibTeX:Article" id="art02" title="ATL Patterns" year="2024" journal="SoSyM">
        <authors author="Jack Anderson"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers R6 Article_Title_Journal -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Model Transformations" year="2022" journal="JSS">
        <authors author="Karen Thomas"/>
    </entries>
    
    <!-- Article with unique title but duplicate journal (same as art03) - triggers R8 Article_Title_NoJournal -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Advanced Transformations" year="2022" journal="JSS">
        <authors author="Leo Garcia"/>
    </entries>
    
    <!-- Article with duplicate title (same as art01/art02) but unique journal - triggers R7 Article_NoTitle_Journal -->
    <entries xsi:type="BibTeX:Article" id="art05" title="ATL Patterns" year="2023" journal="TSE">
        <authors author="Maria Rodriguez"/>
    </entries>
    
    <!-- Additional author to trigger R2 Author rule -->
    <entries xsi:type="BibTeX:Article" id="art06" title="New Approach" year="2024" journal="EMSE">
        <authors author="Nancy Chen"/>
    </entries>
    
</BibTeX:BibTeXFile>