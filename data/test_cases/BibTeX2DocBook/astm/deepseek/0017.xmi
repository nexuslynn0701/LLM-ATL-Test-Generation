<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc - triggers UntitledEntry (R3) -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet - triggers UntitledEntry (R3) -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2023"/>
    
    <!-- Manual - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Manual" id="manual01" title="Software Manual"/>
    
    <!-- Proceedings - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings" year="2022"/>
    
    <!-- Unpublished - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft Paper" note="Unpublished manuscript">
        <authors author="Alice Smith"/>
    </entries>
    
    <!-- TechReport - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:TechReport" id="tr01" title="Technical Report" year="2021">
        <authors author="Bob Johnson"/>
    </entries>
    
    <!-- Book - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Software Engineering" year="2020" publisher="Addison-Wesley">
        <authors author="Ian Sommerville"/>
    </entries>
    
    <!-- InBook - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Testing" year="2019" publisher="Springer" chapter="5">
        <authors author="Jane Doe"/>
    </entries>
    
    <!-- InCollection - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection Article" year="2018" publisher="IEEE" booktitle="Advances in Computing">
        <authors author="John Smith"/>
    </entries>
    
    <!-- InProceedings - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Conference Paper" year="2017" booktitle="ICSE 2017">
        <authors author="Mary Johnson"/>
    </entries>
    
    <!-- PhDThesis - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Dissertation" year="2016" school="MIT">
        <authors author="David Brown"/>
    </entries>
    
    <!-- MasterThesis - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:MasterThesis" id="msc01" title="Master Thesis" year="2015" school="Stanford">
        <authors author="Emma Wilson"/>
    </entries>
    
    <!-- Article with unique title and unique journal - triggers Article_Title_Journal (R6) -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Unique Article Title" year="2024" journal="Journal of Software">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- Article with duplicate title (same as art02) but unique journal - triggers Article_NoTitle_Journal (R7) -->
    <entries xsi:type="BibTeX:Article" id="art02" title="Duplicate Title" year="2023" journal="ACM Computing Surveys">
        <authors author="Grace Lee"/>
    </entries>
    
    <!-- Article with duplicate title (same as art02) and duplicate journal (same as art04) - triggers Article_NoTitle_NoJournal (R9) -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Duplicate Title" year="2022" journal="ACM Computing Surveys">
        <authors author="Henry Davis"/>
    </entries>
    
    <!-- Article with unique title but duplicate journal (same as art02) - triggers Article_Title_NoJournal (R8) -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Another Unique Title" year="2021" journal="ACM Computing Surveys">
        <authors author="Iris Chen"/>
    </entries>
    
    <!-- Duplicate author to test Author rule (R2) deduplication -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Second Article by Frank" year="2020" journal="IEEE Software">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- Additional author to test Author rule (R2) -->
    <entries xsi:type="BibTeX:Book" id="book02" title="Another Book" year="2019" publisher="O'Reilly">
        <authors author="Jack Black"/>
    </entries>
    
</BibTeX:BibTeXFile>