<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Misc" id="misc01"/>
    
    <!-- Booklet (untitled entry) - triggers R3 -->
    <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2020"/>
    
    <!-- Manual (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Manual" id="man01" title="Software Documentation Guide"/>
    
    <!-- Proceedings (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Conference Proceedings 2023" year="2023"/>
    
    <!-- Two InProceedings with same title - first triggers R4, second triggers R5 -->
    <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="Advances in MDE" year="2022" booktitle="MODELS 2022">
        <authors author="Alice Smith"/>
        <authors author="Bob Jones"/>
    </entries>
    <entries xsi:type="BibTeX:InProceedings" id="inproc02" title="Advances in MDE" year="2023" booktitle="MODELS 2023">
        <authors author="Charlie Brown"/>
    </entries>
    
    <!-- Book (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Book" id="book01" title="Model-Driven Engineering" year="2021" publisher="Springer">
        <authors author="David Wilson"/>
    </entries>
    
    <!-- InBook (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on Transformations" year="2020" publisher="Wiley" chapter="5">
        <authors author="Eve Martin"/>
    </entries>
    
    <!-- InCollection (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:InCollection" id="incol01" title="Collection on Verification" year="2019" publisher="ACM" booktitle="Verification Methods">
        <authors author="Frank Lee"/>
    </entries>
    
    <!-- Unpublished (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub01" title="Draft on Testing" note="Under review">
        <authors author="Grace Kim"/>
    </entries>
    
    <!-- TechReport (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:TechReport" id="tech01" title="Technical Report on Tools" year="2024">
        <authors author="Henry Davis"/>
    </entries>
    
    <!-- MasterThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:MasterThesis" id="mst01" title="Master Thesis on Code Generation" year="2023" school="MIT">
        <authors author="Irene White"/>
    </entries>
    
    <!-- PhDThesis (titled entry, no article) - triggers R4 (unique title) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd01" title="PhD Thesis on Model Analysis" year="2022" school="Stanford">
        <authors author="Jack Black"/>
    </entries>
    
    <!-- First Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art01" title="Novel Transformation Approach" year="2024" journal="Journal of Software Engineering">
        <authors author="Kate Green"/>
    </entries>
    
    <!-- Second Article with same title as first but different journal - triggers R7 -->
    <entries xsi:type="BibTeX:Article" id="art02" title="Novel Transformation Approach" year="2023" journal="IEEE Transactions on Software">
        <authors author="Leo Adams"/>
    </entries>
    
    <!-- Third Article with different title but same journal as first - triggers R8 -->
    <entries xsi:type="BibTeX:Article" id="art03" title="Testing Strategies for MDE" year="2024" journal="Journal of Software Engineering">
        <authors author="Maria Garcia"/>
    </entries>
    
    <!-- Fourth Article with same title as second and same journal as second - triggers R9 -->
    <entries xsi:type="BibTeX:Article" id="art04" title="Novel Transformation Approach" year="2022" journal="IEEE Transactions on Software">
        <authors author="Nathan Taylor"/>
    </entries>
    
    <!-- Fifth Article with unique title and unique journal - triggers R6 -->
    <entries xsi:type="BibTeX:Article" id="art05" title="Model Quality Metrics" year="2023" journal="Journal of Systems and Software">
        <authors author="Olivia Brown"/>
    </entries>
    
</BibTeX:BibTeXFile>