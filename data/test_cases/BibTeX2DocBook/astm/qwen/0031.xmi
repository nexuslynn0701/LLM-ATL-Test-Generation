<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
  <!-- UntitledEntry: Misc -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  
  <!-- UntitledEntry: Booklet -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2020"/>
  
  <!-- TitledEntry_NoTitle_NoArticle: Two TechReports with same title -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Shared Title" year="2021">
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="Shared Title" year="2022">
    <authors author="Bob Johnson"/>
  </entries>
  
  <!-- TitledEntry_Title_NoArticle: Unique titled entries (no Article) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Algorithms" year="2019" school="MIT">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Chapter on MDE" year="2023" publisher="Springer" chapter="5">
    <authors author="David Brown"/>
  </entries>
  <entries xsi:type="BibTeX:Manual" id="manual1" title="User Guide" year="2024"/>
  
  <!-- Article_Title_Journal: Article with unique title and unique journal -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Model Transformations" year="2023" journal="IEEE Transactions">
    <authors author="Eve Davis"/>
  </entries>
  
  <!-- Article_NoTitle_Journal: Two Articles with same title, different journals (so second triggers NoTitle) -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Duplicate Title Paper" year="2022" journal="ACM TOSEM">
    <authors author="Frank Wilson"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art3" title="Duplicate Title Paper" year="2023" journal="Software Engineering Journal">
    <authors author="Grace Lee"/>
  </entries>
  
  <!-- Article_Title_NoJournal: Two Articles with same journal, different titles (so second triggers NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art4" title="First Paper in Journal X" year="2021" journal="Journal X">
    <authors author="Henry Moore"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art5" title="Second Paper in Journal X" year="2022" journal="Journal X">
    <authors author="Irene Taylor"/>
  </entries>
  
  <!-- Article_NoTitle_NoJournal: Two Articles with same title AND same journal -->
  <entries xsi:type="BibTeX:Article" id="art6" title="Fully Duplicate" year="2020" journal="Duplicate Journal">
    <authors author="Jack Robinson"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art7" title="Fully Duplicate" year="2021" journal="Duplicate Journal">
    <authors author="Kate Adams"/>
  </entries>
  
  <!-- Additional distinct authors for Authors List section -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Work in Progress" note="Not yet published">
    <authors author="Liam Clark"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conference Proceedings" year="2024"/>
</BibTeX:BibTeXFile>