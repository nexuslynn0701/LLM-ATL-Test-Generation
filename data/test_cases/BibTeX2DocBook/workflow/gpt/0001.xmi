<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles (distinct titles and journals to hit Article_Title_Journal, and to populate titles/journals lists) -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model Transformations in Practice" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" year="2005" title="Testing ATL Transformations" journal="Software Testing Journal">
    <authors author="Carol White"/>
  </entries>

  <!-- Booklet and Misc (untitled entries to trigger UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="BKL1" year="1999"/>
  <entries xsi:type="BibTeX:Misc" id="MISC1"/>

  <!-- Manual (titled, no authors/year, triggers TitledEntry_Title_NoArticle and only title in References) -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="ATL User Guide"/>

  <!-- Book (titled, authored, dated, publisher; triggers TitledEntry_Title_NoArticle and OCL9) -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="2010" title="Model-Driven Engineering Handbook" publisher="TechPress">
    <authors author="Alice Smith"/>
    <authors author="David Lee"/>
  </entries>

  <!-- InBook (titled, authored, dated, publisher, chapter; triggers TitledEntry_Title_NoArticle and OCL10) -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2012" title="Advanced ATL Patterns" publisher="TechPress" chapter="3">
    <authors author="Eve Adams"/>
  </entries>

  <!-- Proceedings (titled, dated; triggers TitledEntry_Title_NoArticle and OCL13) -->
  <entries xsi:type="BibTeX:Proceedings" id="PROC1" year="2015" title="MDE Conference 2015"/>

  <!-- InProceedings (authored, dated, booktitle; triggers TitledEntry_Title_NoArticle and OCL14) -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2015" title="Transforming Large Models" booktitle="MDE Conference 2015">
    <authors author="Frank Green"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry; triggers TitledEntry_Title_NoArticle and OCL15) -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2011" title="Industrial Case Studies in MDE" publisher="TechPress" booktitle="Model-Driven Engineering Handbook">
    <authors author="Carol White"/>
    <authors author="George Brown"/>
  </entries>

  <!-- TechReport (authored, dated, titled; triggers TitledEntry_Title_NoArticle and OCL11) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2008" title="Verification of Model Transformations">
    <authors author="Helen Black"/>
  </entries>

  <!-- Unpublished (authored, titled, note; triggers TitledEntry_Title_NoArticle and OCL6) -->
  <entries xsi:type="BibTeX:Unpublished" id="UNP1" title="Early Draft on Model Testing" note="To appear">
    <authors author="Ian Gray"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- PhDThesis (authored, dated, titled, school; triggers TitledEntry_Title_NoArticle and OCL8) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2013" title="Formal Foundations of ATL" school="University of Modeling">
    <authors author="John Doe"/>
    <authors author="David Lee"/>
  </entries>

  <!-- MasterThesis (authored, dated, titled, school; exercises TitledEntry_Title_NoArticle, though OCL7 is commented out) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MSC1" year="2014" title="Practical Testing of Model Transformations" school="Institute of Software Engineering">
    <authors author="Kate Miller"/>
  </entries>
</BibTeX:BibTeXFile>