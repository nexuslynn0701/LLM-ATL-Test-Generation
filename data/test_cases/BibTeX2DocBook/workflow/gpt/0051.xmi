<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles exercising different Article_* rules and journal/title uniqueness variants -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="MDE in Practice" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- A2: duplicate title with A1, unique journal for that title -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="MDE in Practice" journal="Transactions on Software Models">
    <authors author="Carol White"/>
  </entries>
  <!-- A3: duplicate journal with A1, unique title in that journal -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="DSL Design Patterns" journal="Journal of Model Engineering">
    <authors author="Dave Brown"/>
    <authors author="Eve Black"/>
  </entries>
  <!-- A4: duplicate title with A3 and duplicate journal with A1/A3 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="DSL Design Patterns" journal="Journal of Model Engineering">
    <authors author="Frank Green"/>
  </entries>

  <!-- Misc and Booklet to trigger UntitledEntry -->
  <!-- M1: Misc (untitled, unauthored, undated) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <!-- Bk1: Booklet (dated, no title) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1999"/>

  <!-- Manual: titled, no authors, no date -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL User Guide"/>

  <!-- TechReport with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2010" title="Testing Model Transformations">
    <authors author="Alice Smith"/>
  </entries>

  <!-- TechReport with duplicate title of tr1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2011" title="Testing Model Transformations">
    <authors author="George King"/>
  </entries>

  <!-- MasterThesis unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" year="2005" title="Model Transformation Testing" school="University of Examples">
    <authors author="Helen Lee"/>
    <authors author="Ian Clark"/>
  </entries>

  <!-- PhDThesis unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2008" title="Scalable Model Transformations" school="Institute of Modeling">
    <authors author="John Miller"/>
  </entries>

  <!-- Book with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" year="1995" title="Foundations of MDE" publisher="ModelPress">
    <authors author="Karen Adams"/>
    <authors author="Larry Scott"/>
  </entries>

  <!-- Book with duplicate title (book1) -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book2" year="1997" title="Foundations of MDE" publisher="Advanced Models Publishing">
    <authors author="Mike Turner"/>
  </entries>

  <!-- InBook (subclass of Book) with its own title; treated like other titled entries -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2000" title="Chapter-Based Modeling" publisher="ModelPress" chapter="3">
    <authors author="Karen Adams"/>
  </entries>

  <!-- Proceedings base type with unique title -> TitledEntry_Title_NoArticle (but not its children) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2012" title="ICMT Proceedings 2012"/>

  <!-- Proceedings with duplicate title of proc1 -> TitledEntry_NoTitle_NoArticle (base type only) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2013" title="ICMT Proceedings 2012"/>

  <!-- InProceedings (child of Proceedings) unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2012" title="Bidirectional Transformations in Practice" booktitle="ICMT 2012">
    <authors author="Nancy Young"/>
    <authors author="Oscar Perez"/>
  </entries>

  <!-- InProceedings with duplicate title of inproc1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" year="2013" title="Bidirectional Transformations in Practice" booktitle="ICMT 2013">
    <authors author="Peter Quinn"/>
  </entries>

  <!-- InCollection (child of Book and BookTitledEntry) unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" year="2014" title="Quality of Service in MDE" publisher="ModelPress" booktitle="Advances in Model Engineering">
    <authors author="Rachel Stone"/>
    <authors author="Steve Walker"/>
  </entries>

  <!-- Unpublished entries -->
  <!-- U1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="unp1" title="Unpublished MDE Case Study" note="Draft version">
    <authors author="Tom Harris"/>
    <authors author="Uma Patel"/>
  </entries>
  <!-- U2: duplicate title of U1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="unp2" title="Unpublished MDE Case Study" note="Extended abstract">
    <authors author="Victor Ross"/>
  </entries>
</BibTeX:BibTeXFile>