<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (exercise R3: Misc, Booklet) -->
  <entries xsi:type="BibTeX:Misc" id="e01_misc_alpha"/>
  <entries xsi:type="BibTeX:Booklet" id="e02_booklet_beta" year="1990"/>

  <!-- Manual (titled, no authors, no year -> R4 / R5 case) -->
  <entries xsi:type="BibTeX:Manual" id="e03_manual_gamma" title="MDE Foundations"/>

  <!-- Unpublished (titled, authored, note) -->
  <entries xsi:type="BibTeX:Unpublished" id="e04_unpub_delta" title="Testing Model Transformations" note="under revision">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- MasterThesis (titled, authored, dated, school) -->
  <entries xsi:type="BibTeX:MasterThesis" id="e05_mthesis_epsilon" year="2015" title="Model-Driven Engineering in Practice" school="Tech University">
    <authors author="Carol White"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- PhDThesis (titled, authored, dated, school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="e06_phd_zeta" year="2012" title="Scalable Model Transformations" school="Science Institute">
    <authors author="David Brown"/>
  </entries>

  <!-- Book (unique title, publisher) -->
  <entries xsi:type="BibTeX:Book" id="e07_book_eta" year="2008" title="Advanced ATL Transformations" publisher="ModelPress">
    <authors author="Alice Smith"/>
    <authors author="Eve Black"/>
  </entries>

  <!-- Book (same title as another Book to trigger duplicate-title behavior) -->
  <entries xsi:type="BibTeX:Book" id="e08_book_theta" year="2010" title="Advanced ATL Transformations" publisher="SoftPub">
    <authors author="Frank Green"/>
  </entries>

  <!-- InBook (child of Book, own chapter) -->
  <entries xsi:type="BibTeX:InBook" id="e09_inbook_iota" year="2009" title="Chapter on Testing" publisher="ModelPress" chapter="3">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection" id="e10_incoll_kappa" year="2011" title="Case Studies in MDE" publisher="CaseHouse" booktitle="Proceedings of the MDE Symposium">
    <authors author="Carol White"/>
    <authors author="George King"/>
  </entries>

  <!-- Proceedings (parent only, no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="e11_proc_lambda" year="2013" title="MDE Conference 2013"/>

  <!-- InProceedings (child of Proceedings, authored, has booktitle) -->
  <entries xsi:type="BibTeX:InProceedings" id="e12_inproc_mu" year="2013" title="Mutation Testing for ATL" booktitle="MDE Conference 2013">
    <authors author="Alice Smith"/>
    <authors author="Helen Clark"/>
  </entries>

  <!-- TechReport (titled, authored, dated) -->
  <entries xsi:type="BibTeX:TechReport" id="e13_tech_nu" year="2014" title="Survey on Model Transformation Testing">
    <authors author="Bob Johnson"/>
    <authors author="David Brown"/>
  </entries>

  <!-- Articles to exercise all Article_* rules and journal/title uniqueness combinations -->

  <!-- Article A: unique title, unique journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="e14_art_xi" year="2016" title="Empirical Study of ATL Mutations" journal="Journal of MDE Research">
    <authors author="Alice Smith"/>
    <authors author="Ian Lee"/>
  </entries>

  <!-- Article B: shares title with C, journal unique (Article_Title_Journal for B, Article_NoTitle_Journal for C) -->
  <entries xsi:type="BibTeX:Article" id="e15_art_omicron" year="2017" title="Industrial Experiences with ATL" journal="Software Engineering Notes">
    <authors author="Carol White"/>
  </entries>

  <!-- Article C: same title as B, different journal, both journals unique -->
  <entries xsi:type="BibTeX:Article" id="e16_art_pi" year="2018" title="Industrial Experiences with ATL" journal="International Journal of Software Tools">
    <authors author="Frank Green"/>
    <authors author="George King"/>
  </entries>

  <!-- Article D: shares journal with E, unique title (Article_Title_NoJournal for both D and E) -->
  <entries xsi:type="BibTeX:Article" id="e17_art_rho" year="2019" title="Traceability in Model Transformations" journal="Journal of Software Models">
    <authors author="Helen Clark"/>
  </entries>

  <!-- Article E: different title, same journal as D -->
  <entries xsi:type="BibTeX:Article" id="e18_art_sigma" year="2020" title="Automated Test Generation for ATL" journal="Journal of Software Models">
    <authors author="Ian Lee"/>
    <authors author="David Brown"/>
  </entries>

  <!-- Article F: same title and same journal as G (Article_Title_Journal for F, Article_NoTitle_NoJournal for G) -->
  <entries xsi:type="BibTeX:Article" id="e19_art_tau" year="2021" title="Bidirectional Transformations in Practice" journal="Transactions on MDE Systems">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article G: duplicate of F in both title and journal -->
  <entries xsi:type="BibTeX:Article" id="e20_art_upsilon" year="2022" title="Bidirectional Transformations in Practice" journal="Transactions on MDE Systems">
    <authors author="Bob Johnson"/>
    <authors author="Carol White"/>
  </entries>

</BibTeX:BibTeXFile>