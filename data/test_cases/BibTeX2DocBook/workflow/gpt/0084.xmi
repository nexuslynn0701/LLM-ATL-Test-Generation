<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles designed to exercise Article_Title_Journal and Article_Title_NoJournal and Article_NoTitle_NoJournal -->
  <!-- a1: unique title, unique journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Title One" journal="Journal Alpha">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>
  <!-- a2 & a3: same title, different journals -> one Article_Title_Journal, one Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title X" journal="Journal Beta">
    <authors author="Charlie Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Title X" journal="Journal Gamma">
    <authors author="Alice Author"/>
    <authors author="Diana Scientist"/>
  </entries>
  <!-- a4 & a5: different titles, same journal -> one Article_Title_Journal, one Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Alpha Study" journal="Journal Delta">
    <authors author="Eve Engineer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Beta Study" journal="Journal Delta">
    <authors author="Frank Analyst"/>
    <authors author="Bob Writer"/>
  </entries>
  <!-- a6 & a7: same title, same journal -> one Article_Title_Journal, one Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Duplicate Article Title" journal="Journal Epsilon">
    <authors author="Gina Expert"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Duplicate Article Title" journal="Journal Epsilon">
    <authors author="Henry Scholar"/>
    <authors author="Charlie Researcher"/>
  </entries>

  <!-- TechReport: titled non-article -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="1999" title="TechReport Title 1">
    <authors author="Ivy Investigator"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- Proceedings: include duplicate title to exercise TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2010" title="Proceedings Title Unique"/>
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2011" title="Proceedings Title Duplicate"/>
  <entries xsi:type="BibTeX:Proceedings" id="PR3" year="2012" title="Proceedings Title Duplicate"/>

  <!-- Manual: titled entry -->
  <entries xsi:type="BibTeX:Manual" id="MN1" title="Manual Title 1"/>

  <!-- Booklet: dated, untitled (no title attribute) -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="1995"/>

  <!-- Misc: completely untitled/unauthored/undated -->
  <entries xsi:type="BibTeX:Misc" id="MC1"/>

  <!-- Unpublished: authored, titled, with note -->
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Unpublished Work 1" note="Preliminary results">
    <authors author="Alice Author"/>
    <authors author="Julia Researcher"/>
  </entries>

  <!-- PhDThesis: ThesisEntry, authored, dated, titled -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2015" title="PhD Thesis Title" school="Graduate School Z">
    <authors author="Kevin Doctor"/>
    <authors author="Laura Advisor"/>
  </entries>

  <!-- MasterThesis: include a different thesis type -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2013" title="Master Thesis Title" school="Engineering School Y">
    <authors author="Mike Student"/>
  </entries>

  <!-- Book: base Book (not subclass), authored, dated, titled, publisher -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="1990" title="Standalone Book Title" publisher="Publisher One">
    <authors author="Nina Novelist"/>
    <authors author="Oscar Coauthor"/>
  </entries>

  <!-- InBook: subclass of Book, authored, dated, titled, publisher, chapter -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="1998" title="InBook Chapter Title" publisher="Publisher Two" chapter="3">
    <authors author="Peter ChapterAuthor"/>
    <authors author="Laura Advisor"/>
  </entries>

  <!-- InCollection: subclass of Book plus BookTitledEntry (booktitle) -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2008" title="InCollection Title" publisher="Publisher Three" booktitle="Collected Volume Title">
    <authors author="Quentin Contributor"/>
    <authors author="Ivy Investigator"/>
  </entries>

  <!-- InProceedings: Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2018" title="InProceedings Paper Title" booktitle="Conference Book Title">
    <authors author="Rachel Presenter"/>
    <authors author="Steve CoPresenter"/>
  </entries>
</BibTeX:BibTeXFile>