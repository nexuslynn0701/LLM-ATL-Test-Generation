<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to drive Article_* rules and journals list -->
  <!-- a1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="MDE in Practice" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>
  <!-- a2: shares title with a1, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="MDE in Practice" journal="Software Transformation Journal">
    <authors author="Bob Jones"/>
    <authors author="Carol White"/>
  </entries>
  <!-- a3: unique title, shares journal with a4 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Testing Model Transformations" journal="Empirical Software Modeling">
    <authors author="David Brown"/>
  </entries>
  <!-- a4: unique title, shares journal with a3 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Mutation Analysis for ATL" journal="Empirical Software Modeling">
    <authors author="Eve Black"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- TechReport: titled, non-article -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2005" title="Scalable Model Repositories">
    <authors author="Alice Smith"/>
    <authors author="Henry King"/>
  </entries>

  <!-- Manual: titled, non-authored, non-dated -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="ATL User Guide"/>

  <!-- Proceedings: two with same title to trigger Title/NoTitle split -->
  <!-- p1: first "International Conference on Model Transformations" -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2006" title="International Conference on Model Transformations"/>
  <!-- p2: same title, different year -->
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2007" title="International Conference on Model Transformations"/>

  <!-- Book: base Book only (not subclass), unique title -->
  <entries xsi:type="BibTeX:Book" id="B1" year="2008" title="Principles of Model-Driven Engineering" publisher="Springer MDE Series">
    <authors author="Carol White"/>
    <authors author="Ian Gray"/>
  </entries>
  <!-- Book: second base Book with same title as B1 to exercise NoTitle rule -->
  <entries xsi:type="BibTeX:Book" id="B2" year="2009" title="Principles of Model-Driven Engineering" publisher="ACM Press">
    <authors author="Ian Gray"/>
  </entries>

  <!-- InBook: subclass of Book, distinct title -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2010" title="MDE Case Study Chapter" publisher="TechBooks" chapter="3">
    <authors author="David Brown"/>
    <authors author="Julia Rose"/>
  </entries>

  <!-- InCollection: subclass of Book with BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2011" title="Model Transformation Patterns" publisher="World Scientific" booktitle="Handbook of Model Transformations">
    <authors author="Frank Green"/>
    <authors author="Karen Miller"/>
  </entries>

  <!-- InProceedings: Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2012" title="Testing ATL Transformations" booktitle="Proceedings of MTiP">
    <authors author="Alice Smith"/>
    <authors author="Laura Scott"/>
  </entries>

  <!-- PhDThesis and MasterThesis -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2013" title="Model Transformation Testing" school="University of Engineering">
    <authors author="Mike Turner"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MSC1" year="2014" title="Automated Test Generation for MDE" school="Tech University">
    <authors author="Nina Adams"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Unpublished entries -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Industrial Experiences with ATL" note="Submitted for publication">
    <authors author="Eve Black"/>
    <authors author="Oscar Reed"/>
  </entries>
  <!-- Second Unpublished with same title as U1 to trigger NoTitle variant -->
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Industrial Experiences with ATL" note="Draft version">
    <authors author="Oscar Reed"/>
  </entries>

  <!-- Booklet: dated, untitled -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="2015"/>
  <!-- Second Booklet to ensure multiple UntitledEntry applications -->
  <entries xsi:type="BibTeX:Booklet" id="BL2" year="2016"/>

  <!-- Misc: truly untitled, undated -->
  <entries xsi:type="BibTeX:Misc" id="MS1"/>
  <entries xsi:type="BibTeX:Misc" id="MS2"/>
</BibTeX:BibTeXFile>