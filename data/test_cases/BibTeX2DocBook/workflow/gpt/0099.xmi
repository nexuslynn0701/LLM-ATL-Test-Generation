<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise all four Article_* rules and journal/title OCLs -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model Transformations in Practice" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Miller"/>
  </entries>
  <!-- A2: shares title with A3, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Testing Model Transformations" journal="Software Testing Journal">
    <authors author="Carol Johnson"/>
  </entries>
  <!-- A3: same title as A2, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Testing Model Transformations" journal="Empirical Software Engineering Letters">
    <authors author="David Brown"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- A4 & A5: share journal "International Journal of MDE" and distinct titles -->
  <!-- A4: first in sorted title order for that journal -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Automated Model Mutation" journal="International Journal of MDE">
    <authors author="Eve Clark"/>
  </entries>
  <!-- A5: same journal, different title -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Coverage Criteria for ATL" journal="International Journal of MDE">
    <authors author="Frank Wilson"/>
    <authors author="Bob Miller"/>
  </entries>

  <!-- Untitled entries (Booklet, Misc) to trigger UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1999"/>
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- Manual entries (Titled, no authors/date) -->
  <!-- MAN1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="ATL User Guide"/>
  <!-- MAN2: same title as MAN1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MAN2" title="ATL User Guide"/>

  <!-- Books, InBook, InCollection to trigger title/no-title rules and subclass-specific concatenations -->
  <!-- BK1: unique title -> Book + TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="2010" title="Model-Driven Engineering Handbook" publisher="Springer MDE Press">
    <authors author="George King"/>
    <authors author="Helen Scott"/>
  </entries>
  <!-- BK2: shares title with IC1, first in title order -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="2012" title="Domain-Specific Languages in Practice" publisher="TechBooks Publishing">
    <authors author="Ian Lee"/>
  </entries>
  <!-- IB1: unique title, InBook (Book subclass) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2011" title="Advanced Topics in Model Weaving" publisher="Springer MDE Press" chapter="7">
    <authors author="John Doe"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- IC1: InCollection, same title as BK2 (later in sorted order) -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2013" title="Domain-Specific Languages in Practice" publisher="TechBooks Publishing">
    <authors author="Karen White"/>
  </entries>

  <!-- Proceedings and InProceedings -->
  <!-- PR1 and PR2 share title; only one gets a title paragraph -->
  <!-- PR1: first in title order "Proceedings of the MDE Conference" -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2014" title="Proceedings of the MDE Conference"/>
  <!-- PR2: same title, later id -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2015" title="Proceedings of the MDE Conference"/>
  <!-- IP1: InProceedings with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2016" title="Refactoring ATL Transformations" booktitle="Proceedings of the MDE Conference">
    <authors author="Laura Green"/>
    <authors author="Michael Young"/>
  </entries>

  <!-- TechReport entries -->
  <!-- TR1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2008" title="Static Analysis of ATL Transformations">
    <authors author="Nina Adams"/>
  </entries>
  <!-- TR2: same title as TR1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2009" title="Static Analysis of ATL Transformations">
    <authors author="Oscar Perez"/>
    <authors author="Nina Adams"/>
  </entries>

  <!-- Thesis entries -->
  <!-- PHD1: PhDThesis with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2007" title="Testing Bidirectional Transformations" school="University of Model Engineering">
    <authors author="Peter Zhang"/>
    <authors author="Quinn Rivera"/>
  </entries>
  <!-- MT1: MasterThesis sharing title with PHD1; later id -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2006" title="Testing Bidirectional Transformations" school="Institute of Software Systems">
    <authors author="Rachel Stone"/>
  </entries>
</BibTeX:BibTeXFile>