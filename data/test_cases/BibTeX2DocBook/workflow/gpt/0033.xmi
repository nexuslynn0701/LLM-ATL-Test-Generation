<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise Article_* rules with combinations of duplicate titles/journals -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Single Article Title" journal="Unique Journal One">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- A2, A3: same title, different journals -> Article_NoTitle_Journal (for A3) + Article_Title_Journal (for A2) -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Article Title" journal="Journal Alpha">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Article Title" journal="Journal Beta">
    <authors author="Dave Brown"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- A4, A5: different titles, same journal -> Article_Title_NoJournal (for A5) + Article_Title_Journal (for A4) -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Journal Shared Title One" journal="Shared Journal">
    <authors author="Eve Black"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Journal Shared Title Two" journal="Shared Journal">
    <authors author="Frank Green"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- A6, A7: same title and same journal -> Article_NoTitle_NoJournal (for A7) + Article_Title_NoJournal or Article_NoTitle_Journal for A6 depending on sets -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Fully Duplicated Article" journal="Duplicated Journal">
    <authors author="Grace Hill"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Fully Duplicated Article" journal="Duplicated Journal">
    <authors author="Henry King"/>
    <authors author="Carol White"/>
  </entries>

  <!-- TechReport to exercise TitledEntry_* (non-article) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="1999" title="TechReport Unique Title">
    <authors author="Ivan Lee"/>
  </entries>
  <!-- Manual without authors/year to exercise minimal TitledEntry handling -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="Manual Unique Title"/>
  <!-- Manual sharing title with a Book (duplicate titled entry) to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M2" title="Duplicate Title Across Types"/>
  
  <!-- Book to exercise Book specific attributes and duplicate title with M2 -->
  <entries xsi:type="BibTeX:Book" id="B1" year="2010" title="Duplicate Title Across Types" publisher="Publisher One">
    <authors author="Alice Smith"/>
    <authors author="John Doe"/>
  </entries>
  <!-- Book with unique title -->
  <entries xsi:type="BibTeX:Book" id="B2" year="2011" title="Unique Book Title" publisher="Publisher Two">
    <authors author="Carol White"/>
  </entries>

  <!-- InBook to exercise chapter and book inheritance -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2012" title="InBook Unique Title" publisher="Publisher Three" chapter="5">
    <authors author="Kevin Young"/>
    <authors author="Laura Scott"/>
  </entries>

  <!-- InCollection to exercise BookTitledEntry + Book -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2013" title="InCollection Unique Title" publisher="Publisher Four" booktitle="Booktitle One">
    <authors author="Mike Adams"/>
  </entries>

  <!-- Proceedings: two with same title, one different -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2014" title="Shared Proceedings Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2015" title="Shared Proceedings Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="P3" year="2016" title="Unique Proceedings Title"/>

  <!-- InProceedings to exercise BookTitledEntry + AuthoredEntry + Proceedings hierarchy -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2017" title="InProceedings First Title" booktitle="Conference One">
    <authors author="Nancy Turner"/>
    <authors author="Oscar Perez"/>
  </entries>
  <!-- Another InProceedings with different title and booktitle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2018" title="InProceedings Second Title" booktitle="Conference Two">
    <authors author="Peter Quinn"/>
  </entries>

  <!-- Booklet entries to exercise UntitledEntry rule -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="1990"/>
  <entries xsi:type="BibTeX:Booklet" id="BL2" year="1991"/>

  <!-- Misc entries to exercise UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc" id="MS1"/>
  <entries xsi:type="BibTeX:Misc" id="MS2"/>

  <!-- PhDThesis and MasterThesis to exercise ThesisEntry and TitledEntry rules -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2000" title="Thesis Shared Title" school="Graduate School One">
    <authors author="Rachel Stone"/>
    <authors author="John Doe"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2001" title="Thesis Shared Title" school="Graduate School Two">
    <authors author="Steve Clark"/>
  </entries>
  <!-- Additional PhDThesis with unique title -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD2" year="2002" title="Unique PhD Thesis Title" school="Graduate School Three">
    <authors author="Tina Evans"/>
  </entries>

  <!-- Unpublished entries: two sharing a title, one unique -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Unpublished Shared Title" note="Preprint Version">
    <authors author="Uma Fisher"/>
    <authors author="Victor Gomez"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Unpublished Shared Title" note="Revised Version">
    <authors author="Walter Hall"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U3" title="Unique Unpublished Title" note="Draft Notes">
    <authors author="Yvonne Irwin"/>
    <authors author="Zack Johnson"/>
  </entries>
</BibTeX:BibTeXFile>