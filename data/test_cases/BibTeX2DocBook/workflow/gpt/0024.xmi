<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles exercising all four article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Unique Article Title One" journal="Journal A">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- A2: duplicate title with A3, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Shared Article Title" journal="Journal B">
    <authors author="Carol Gamma"/>
    <authors author="Dan Delta"/>
  </entries>

  <!-- A3: same title as A2, different journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Shared Article Title" journal="Journal C">
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- A4: unique title, journal shared with A5 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Another Unique Article" journal="Journal D">
    <authors author="Frank Phi"/>
    <authors author="Grace Gamma"/>
  </entries>

  <!-- A5: different title, same journal as A4 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Sibling Article in Same Journal" journal="Journal D">
    <authors author="Heidi Eta"/>
  </entries>

  <!-- Non-article titled entries covering both titled-entry rules -->

  <!-- B1: Book with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" year="1999" title="Distinct Book Title" publisher="Publisher One">
    <authors author="Alice Alpha"/>
    <authors author="Carol Gamma"/>
  </entries>

  <!-- B2 & B3: Books with same title -> first in set gets title para, second does not -->
  <!-- B2: in title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book2" year="2000" title="Repeated Book Title" publisher="Publisher Two">
    <authors author="Ivan Iota"/>
  </entries>

  <!-- B3: not in title set -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book3" year="2001" title="Repeated Book Title" publisher="Publisher Three">
    <authors author="Judy Kappa"/>
  </entries>

  <!-- IB1 & IB2: InBook entries with same title -> one with title para, one without -->
  <!-- IB1: in title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2010" title="InBook Shared Title" publisher="Pub InBook" chapter="3">
    <authors author="Liam Lambda"/>
  </entries>

  <!-- IB2: not in title set -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="inbook2" year="2011" title="InBook Shared Title" publisher="Pub InBook 2" chapter="7">
    <authors author="Mia Mu"/>
    <authors author="Noah Nu"/>
  </entries>

  <!-- IC1: InCollection with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="incol1" year="2012" title="Collection Chapter Title" publisher="Collection Publisher">
    <authors author="Olivia Omicron"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- IP1: InProceedings with unique title and booktitle -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2013" title="Conference Paper Title" booktitle="Proceedings of Conf X">
    <authors author="Peggy Pi"/>
    <authors author="Quinn Q"/>
  </entries>

  <!-- P1 & P2: Proceedings with same title -> one in title set, one out -->
  <!-- P1: in title set -> TitledEntry_Title_NoArticle (but constrained OCL13 only looks at oclIsTypeOf) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2014" title="Symposium Title One"/>
  <!-- P2: not in title set -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2015" title="Symposium Title One"/>

  <!-- P3: Proceedings with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="proc3" year="2016" title="Unique Symposium Title"/>

  <!-- TR1: TechReport unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="1995" title="TechReport Unique Title">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- U1 & U2: Unpublished entries, distinct titles; both in title set -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Unpublished Work Alpha" note="internal draft alpha">
    <authors author="Dan Delta"/>
    <authors author="Eve Epsilon"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Unpublished Work Beta" note="internal draft beta">
    <authors author="Frank Phi"/>
  </entries>

  <!-- Theses -->
  <!-- PHD1 & PHD2: PhDThesis with same title -> one with title para, one without -->
  <!-- PHD1: in title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2007" title="Thesis Shared Title" school="Tech University">
    <authors author="Grace Gamma"/>
  </entries>

  <!-- PHD2: not in title set -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd2" year="2008" title="Thesis Shared Title" school="Science Institute">
    <authors author="Heidi Eta"/>
    <authors author="Ivan Iota"/>
  </entries>

  <!-- MST1: MasterThesis with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="2009" title="Master Thesis Unique Title" school="Engineering School">
    <authors author="Judy Kappa"/>
  </entries>

  <!-- Manuals -->
  <!-- M1 & M2: Manuals with same title -> one in title set, one out -->
  <!-- M1: in title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Tool Manual Title">
  </entries>

  <!-- M2: not in title set -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="Tool Manual Title">
  </entries>

  <!-- M3: Manual with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man3" title="Secondary Manual Title">
  </entries>

  <!-- Untitled entries: Misc and Booklet use UntitledEntry rule -->

  <!-- BL1, BL2, BL3: Booklets -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1990"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet2" year="1991"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet3" year="1992"/>

  <!-- MC1, MC2: Misc -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Misc" id="misc2"/>

</BibTeX:BibTeXFile>