<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: designed to hit all four article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model Transformations in Practice" journal="Journal of MDE Research">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A2 + A3: same title, different journals ->
       one in titleSet & journalSet (A2: Article_Title_Journal),
       the other only in journalSet (A3: Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Testing Model Transformations" journal="Software Quality Journal">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Testing Model Transformations" journal="Empirical Software Engineering">
    <authors author="Dave Brown"/>
  </entries>

  <!-- A4 + A5: same journal, different titles ->
       one in titleSet & journalSet (A4: Article_Title_Journal),
       the other only in titleSet (A5: Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Traceability in ATL" journal="International Journal of Software Tools">
    <authors author="Eve Black"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Incremental Model Transformation" journal="International Journal of Software Tools">
    <authors author="Frank Green"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- A6 + A7: same title and same journal ->
       one in titleSet & journalSet (A6: Article_Title_Journal),
       the other in neither set (A7: Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Metamodeling Fundamentals" journal="Journal of MDE Research">
    <authors author="Grace Lee"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Metamodeling Fundamentals" journal="Journal of MDE Research">
    <authors author="Henry King"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Manual: titled, no authors/date -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="ATL User Guide"/>

  <!-- TechReport: titled, authored, dated -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="Evaluation of Model Transformation Testing Techniques">
    <authors author="Irene Novak"/>
    <authors author="John Doe"/>
  </entries>

  <!-- Book: titled, authored, dated, publisher -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B1" year="1999" title="Foundations of Model-Driven Engineering" publisher="Springer MDE Press">
    <authors author="Alice Smith"/>
    <authors author="Kevin Clark"/>
  </entries>

  <!-- InBook: child of Book (thus also TitledEntry, AuthoredEntry, DatedEntry) with chapter ->
       different title than B1, so it will also be in titleSet ->
       TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2000" title="Chapter on ATL Semantics" publisher="Springer MDE Press" chapter="3">
    <authors author="Kevin Clark"/>
    <authors author="Laura Martin"/>
  </entries>

  <!-- InCollection: child of Book and BookTitledEntry ->
       also TitledEntry, AuthoredEntry, DatedEntry, BookTitledEntry ->
       TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2012" title="Reusable Model Transformations" publisher="ACM Digital Library" booktitle="Proceedings of the MDE Symposium">
    <authors author="Mike O'Neil"/>
    <authors author="John Doe"/>
  </entries>

  <!-- Proceedings: titled, dated; distinct title so in titleSet ->
       TitledEntry_Title_NoArticle;
       OCL13 only refers to base Proceedings, which this is -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2015" title="International Conference on Model Transformation"/>

  <!-- Unpublished: titled, authored, note (no year) ->
       TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Draft on Model Transformation Benchmarks" note="To appear">
    <authors author="Nina Patel"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- PhDThesis: ThesisEntry child (TitledEntry, AuthoredEntry, DatedEntry) ->
       TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2018" title="Scalable Model Transformations" school="University of Example">
    <authors author="Oscar Ruiz"/>
  </entries>

  <!-- MasterThesis: ThesisEntry child ->
       TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2019" title="Testing of Model Transformations" school="Institute of Software Testing">
    <authors author="Pat Quinn"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Booklet: dated, not titled -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="1995"/>

  <!-- Misc: untitled, no other info -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MS1"/>

</BibTeX:BibTeXFile>