<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to trigger all four Article rules with title/journal combinations -->
  <!-- A1, A2: same title, different journals -> one in titleSet, both in journalSet -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Shared Title A" journal="Unique Journal 1">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Shared Title A" journal="Unique Journal 2">
    <authors author="Carol Researcher"/>
  </entries>
  <!-- A3, A4: different titles, same journal -> both in titleSet, one in journalSet -->
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Title B" journal="Shared Journal 1">
    <authors author="Dave Scientist"/>
    <authors author="Alice Author"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Title C" journal="Shared Journal 1">
    <authors author="Eve Engineer"/>
  </entries>
  <!-- A5, A6: same title and same journal -> one in both sets, the other in none -->
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Shared Title D" journal="Shared Journal 2">
    <authors author="Frank Analyst"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art6" year="2006" title="Shared Title D" journal="Shared Journal 2">
    <authors author="Grace Developer"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- Untitled entries (no TitledEntry supertype) to trigger UntitledEntry: Misc + Booklet -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1999"/>

  <!-- Titled non-Article entries with unique titles to trigger TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="Unique Manual Title">
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tech1" year="2010" title="Unique TechReport Title">
    <authors author="Henry Tester"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book1" year="2011" title="Unique Book Title" publisher="Unique Publisher 1">
    <authors author="Ivy Architect"/>
    <authors author="Jake Designer"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2012" title="Unique InBook Title" publisher="Unique Publisher 2" chapter="3">
    <authors author="Kate Developer"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="incol1" year="2013" title="Unique InCollection Title" publisher="Unique Publisher 3" booktitle="Unique Booktitle 1">
    <authors author="Leo Writer"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2014" title="Unique InProceedings Title" booktitle="Unique Conference 1">
    <authors author="Mia Scientist"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2015" title="Unique Proceedings Title"/>
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2016" title="Unique PhD Thesis Title" school="Unique University 1">
    <authors author="Nina PhD"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="2017" title="Unique Master Thesis Title" school="Unique University 2">
    <authors author="Oscar MSc"/>
  </entries>

  <!-- Titled non-Article entries sharing titles to trigger TitledEntry_NoTitle_NoArticle -->
  <!-- Two Books with same title -->
  <entries xsi:type="BibTeX:Book" id="book2" year="2018" title="Repeated Book Title" publisher="Publisher A">
    <authors author="Paul Author"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book3" year="2019" title="Repeated Book Title" publisher="Publisher B">
    <authors author="Quinn Writer"/>
  </entries>
  <!-- Two Proceedings with same title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2020" title="Repeated Proceedings Title">
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="proc3" year="2021" title="Repeated Proceedings Title">
  </entries>
  <!-- Two Unpublished with same title -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Repeated Unpublished Title" note="Note 1">
    <authors author="Rachel Researcher"/>
    <authors author="Sam Scientist"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Repeated Unpublished Title" note="Note 2">
    <authors author="Tom Theorist"/>
  </entries>
</BibTeX:BibTeXFile>