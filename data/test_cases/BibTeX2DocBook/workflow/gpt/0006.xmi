<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise all four Article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Unique Title One" journal="Journal Alpha">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>
  <!-- A2 & A3: same title, different journals -> one Article_Title_Journal, one Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Shared Title A" journal="Journal Beta">
    <authors author="Charlie Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Shared Title A" journal="Journal Gamma">
    <authors author="Alice Author"/>
    <authors author="Dana Scholar"/>
  </entries>
  <!-- A4 & A5: same journal, different titles -> one Article_Title_Journal, one Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Journal Shared Title One" journal="Journal Delta">
    <authors author="Evan Expert"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Journal Shared Title Two" journal="Journal Delta">
    <authors author="Fiona Fellow"/>
    <authors author="Bob Writer"/>
  </entries>
  <!-- A6 & A7: same title and same journal -> one Article_Title_Journal, one Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art6" year="2006" title="Fully Shared Title" journal="Journal Epsilon">
    <authors author="George Guru"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art7" year="2007" title="Fully Shared Title" journal="Journal Epsilon">
    <authors author="Hannah Hacker"/>
    <authors author="Ian Investigator"/>
  </entries>

  <!-- Untitled entries (no TitledEntry supertype) to trigger UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Misc" id="misc2"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet2" year="2010"/>

  <!-- Titled non-Article entries to hit TitledEntry_Title_NoArticle and TitledEntry_NoTitle_NoArticle -->
  <!-- Unique titles (will be in distinct-title set) -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="Manual Unique Title">
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tech1" year="2011" title="Tech Report Unique" >
    <authors author="Charlie Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2012" title="Unique Proceedings One"/>
  <entries xsi:type="BibTeX:Book" id="book1" year="2008" title="Unique Book One" publisher="Publisher One">
    <authors author="Bob Writer"/>
    <authors author="Ian Investigator"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2013" title="Unique InBook One" publisher="Publisher Two" chapter="3">
    <authors author="Dana Scholar"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="incol1" year="2014" title="Unique InCollection One" publisher="Publisher Three" booktitle="InCollection Book">
    <authors author="George Guru"/>
    <authors author="Alice Author"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2015" title="Unique PhD Thesis" school="Grad School A">
    <authors author="Fiona Fellow"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="master1" year="2016" title="Unique Master Thesis" school="Grad School B">
    <authors author="Hannah Hacker"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Unique Unpublished Title" note="Unpublished note one">
    <authors author="Alice Author"/>
    <authors author="Charlie Researcher"/>
  </entries>

  <!-- Duplicate-title groups (only first of each title in distinct-title set) -->
  <!-- Group G1: Book + InProceedings share title "Duplicate Title One" -->
  <entries xsi:type="BibTeX:Book" id="book2" year="2009" title="Duplicate Title One" publisher="Publisher Four">
    <authors author="Evan Expert"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2017" title="Duplicate Title One" booktitle="Conference One">
    <authors author="Ian Investigator"/>
    <authors author="Bob Writer"/>
  </entries>
  <!-- Group G2: TechReport + Manual share title "Duplicate Title Two" -->
  <entries xsi:type="BibTeX:TechReport" id="tech2" year="2018" title="Duplicate Title Two">
    <authors author="George Guru"/>
  </entries>
  <entries xsi:type="BibTeX:Manual" id="manual2" title="Duplicate Title Two">
  </entries>

  <!-- Additional Unpublished with shared title to also use NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Shared Unpublished Title" note="Note two">
    <authors author="Dana Scholar"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub3" title="Shared Unpublished Title" note="Note three">
    <authors author="George Guru"/>
    <authors author="Hannah Hacker"/>
  </entries>
</BibTeX:BibTeXFile>