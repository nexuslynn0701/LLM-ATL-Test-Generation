<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise all four Article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Research on MDE" journal="Journal of Model Engineering">
    <authors author="Alice Author"/>
    <authors author="Bob Builder"/>
  </entries>
  <!-- A2 & A3: same title, different journals -> first in title-set uses Article_Title_Journal, second uses Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title Article" journal="Journal One">
    <authors author="Charlie Coder"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Title Article" journal="Journal Two">
    <authors author="Dana Designer"/>
  </entries>
  <!-- A4 & A5: same journal, different titles -> first in journal-set uses Article_Title_Journal, second uses Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="First Journal Duplicate" journal="Common Journal">
    <authors author="Evan Engineer"/>
    <authors author="Fiona Framework"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Second Journal Duplicate" journal="Common Journal">
    <authors author="George Generator"/>
  </entries>
  <!-- A6 & A7: same title and same journal -> first uses Article_Title_Journal, second uses Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Full Duplicate Article" journal="Duplicated Journal">
    <authors author="Helen Hacker"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Full Duplicate Article" journal="Duplicated Journal">
    <authors author="Ian Integrator"/>
    <authors author="Jack Joiner"/>
  </entries>

  <!-- Untitled entries for UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Misc" id="M2"/>
  <entries xsi:type="BibTeX:Booklet" id="Blet1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="Blet2" year="2010"/>

  <!-- Non-article titled entries, unique titles -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="Book1" year="2011" title="Unique Book Title" publisher="Unique Publisher Ltd">
    <authors author="Alice Author"/>
    <authors author="Carl Compiler"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="InBook1" year="2012" title="Unique InBook Title" publisher="Chapter Press" chapter="3">
    <authors author="Dana Designer"/>
  </entries>
  <entries xsi:type="BibTeX:Manual" id="Man1" title="Unique Manual Title"/>
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2013" title="Unique TechReport Title">
    <authors author="Fiona Framework"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PhD1" year="2014" title="Unique PhD Thesis Title" school="Tech University">
    <authors author="Greg Graduate"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MSc1" year="2015" title="Unique Master Thesis Title" school="Science Institute">
    <authors author="Holly Human"/>
    <authors author="Ian Integrator"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="Proc1" year="2016" title="Unique Proceedings Title"/>

  <!-- Non-article titled entries with duplicated titles -> TitledEntry_NoTitle_NoArticle -->
  <!-- Two InProceedings sharing the same title -->
  <entries xsi:type="BibTeX:InProceedings" id="InProc1" year="2017" title="Shared InProceedings Title" booktitle="Conf A">
    <authors author="Jack Joiner"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="InProc2" year="2018" title="Shared InProceedings Title" booktitle="Conf B">
    <authors author="Kate Keeper"/>
  </entries>
  <!-- Book and InCollection sharing the same title -->
  <entries xsi:type="BibTeX:Book" id="Book2" year="2019" title="Shared Book Title" publisher="Duplicate Publisher">
    <authors author="Liam Librarian"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="InColl1" year="2020" title="Shared Book Title" publisher="Duplicate Publisher" booktitle="Collected Works">
    <authors author="Mona Modeler"/>
    <authors author="Ned Notator"/>
  </entries>
</BibTeX:BibTeXFile>