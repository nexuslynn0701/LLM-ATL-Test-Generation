<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: exercise all 4 article rules via title/journal duplication patterns -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Model-Driven Development Foundations" journal="Journal of MDE Research">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- A2 + A3: same title, different journals -> first in title set gets title (R6), second loses title (R7) -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Testing Model Transformations" journal="Software Quality Journal">
    <authors author="Carol Gamma"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Testing Model Transformations" journal="International Journal of Software Tools">
    <authors author="Dave Delta"/>
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- A4 + A5: different titles, same journal -> first in journal set gets journal (R6), second loses journal (R8) -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Metamodel Evolution in Practice" journal="Empirical Software Engineering Letters">
    <authors author="Frank Phi"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Industrial Adoption of ATL" journal="Empirical Software Engineering Letters">
    <authors author="Grace Gamma"/>
    <authors author="Henry Eta"/>
  </entries>

  <!-- A6 + A7: same title and same journal -> first gets title+journal (R6), second loses both (R9) -->
  <entries xsi:type="BibTeX:Article" id="art6" year="2006" title="Automated Mutation Testing for ATL" journal="Journal of MDE Research">
    <authors author="Ivan Iota"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art7" year="2007" title="Automated Mutation Testing for ATL" journal="Journal of MDE Research">
    <authors author="Jackappa Kappa"/>
    <authors author="Alice Alpha"/>
  </entries>

  <!-- TechReport: TitledEntry_*_NoArticle -->
  <!-- TR1 + TR2 share title -> TR1 gets title para (R4), TR2 only entry para (R5) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2010" title="Traceability in Model Transformations">
    <authors author="Laura Lambda"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2011" title="Traceability in Model Transformations">
    <authors author="Mike Mu"/>
    <authors author="Nancy Nu"/>
  </entries>

  <!-- Manual: unique title -> R4 -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL User Guide 3.0"/>

  <!-- Unpublished: UN1 + UN2 share title to exercise R4/R5 and OCL6 -->
  <entries xsi:type="BibTeX:Unpublished" id="un1" title="Unreleased Case Study on MDE" note="First internal draft">
    <authors author="Oscar Omicron"/>
    <authors author="Peggy Pi"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="un2" title="Unreleased Case Study on MDE" note="Revised internal draft">
    <authors author="Quentin Q"/>
  </entries>

  <!-- PhDThesis and MasterThesis: distinct titles to hit R4 and OCL8/OCL7-style checks -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2015" title="Scalable Model Transformation Testing" school="Tech University of Delta">
    <authors author="Rachel Rho"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="2016" title="Lightweight Trace Metamodels" school="Institute of Software Systems">
    <authors author="Steve Sigma"/>
    <authors author="Trudy Tau"/>
  </entries>

  <!-- Book: two books with same title to hit R4/R5 and OCL9 -->
  <entries xsi:type="BibTeX:Book" id="book1" year="2012" title="Foundations of Model Transformations" publisher="Springer Delta">
    <authors author="Uma Upsilon"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book2" year="2013" title="Foundations of Model Transformations" publisher="Omega Press">
    <authors author="Victor V"/>
    <authors author="Wendy W"/>
  </entries>

  <!-- InBook: unique title to hit R4 and OCL10 -->
  <entries xsi:type="BibTeX:InBook" id="inb1" year="2014" title="Chapter on ATL Optimization" publisher="Springer Delta" chapter="7">
    <authors author="Xavier Xi"/>
    <authors author="Yara Ypsilon"/>
  </entries>

  <!-- InCollection: unique title to hit R4 and OCL15 -->
  <entries xsi:type="BibTeX:InCollection" id="inc1" year="2018" title="Reusable Transformation Patterns" publisher="Patterns Publishing">
    <authors author="Zoe Zeta"/>
    <authors author="Alice Alpha"/>
  </entries>

  <!-- InProceedings: two with same title, different year/booktitle to exercise R4/R5 and OCL14 -->
  <entries xsi:type="BibTeX:InProceedings" id="inp1" year="2019" title="Benchmarking ATL Engines" booktitle="Proceedings of the MDE Symposium">
    <authors author="Bob Beta"/>
    <authors author="Carol Gamma"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inp2" year="2020" title="Benchmarking ATL Engines" booktitle="Proceedings of the Software Engineering Conference">
    <authors author="Dave Delta"/>
  </entries>

  <!-- Proceedings: PR1 + PR2 share title -> R4/R5, OCL13 -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2008" title="Proceedings of the MDE Symposium"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2009" title="Proceedings of the MDE Symposium"/>

  <!-- Booklet: untitled dated entries to hit UntitledEntry rule and OCL5 -->
  <entries xsi:type="BibTeX:Booklet" id="bklt1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="bklt2" year="2000"/>

  <!-- Misc: pure untitled, undated entries to hit UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Misc" id="misc2"/>

</BibTeX:BibTeXFile>