<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (exercise UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="m001"/>
  <entries xsi:type="BibTeX:Misc" id="m002"/>
  <entries xsi:type="BibTeX:Booklet" id="b001" year="1990"/>
  <entries xsi:type="BibTeX:Booklet" id="b002" year="1995"/>

  <!-- Manual (titled, no authors/year) -->
  <entries xsi:type="BibTeX:Manual" id="man01" title="DocBook User Guide"/>

  <!-- Proceedings: one unique title, two with same title (dup title to hit NoTitle) -->
  <entries xsi:type="BibTeX:Proceedings" id="p001" year="2001" title="International Conference on MDE"/>
  <entries xsi:type="BibTeX:Proceedings" id="p002" year="2005" title="Software Quality Workshop"/>
  <entries xsi:type="BibTeX:Proceedings" id="p003" year="2010" title="Software Quality Workshop"/>

  <!-- Books: one unique-title book, two books share a title -->
  <entries xsi:type="BibTeX:Book" id="bk01" year="2000" title="Model-Driven Engineering in Practice" publisher="TechPress">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="bk02" year="2003" title="Advanced ATL Transformations" publisher="MDE Publishers">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="bk03" year="2007" title="Advanced ATL Transformations" publisher="Global Science">
    <authors author="David Brown"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- InBook: unique title, own chapter -->
  <entries xsi:type="BibTeX:InBook" id="ib01" year="2012" title="Refinement Patterns" publisher="TechPress" chapter="3">
    <authors author="Eve Black"/>
  </entries>

  <!-- InCollection: shares booktitle/publisher form but different title -->
  <entries xsi:type="BibTeX:InCollection" id="ic01" year="2015" title="Case Studies in MDE" publisher="CasePress" booktitle="Proceedings of MDE Case Studies">
    <authors author="Frank Green"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Unpublished: two entries with same title to trigger NoTitle for second -->
  <entries xsi:type="BibTeX:Unpublished" id="u001" title="Draft on Model Testing" note="Under submission">
    <authors author="George King"/>
    <authors author="Helen Clark"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="u002" title="Draft on Model Testing" note="Second version">
    <authors author="Ian Lee"/>
  </entries>

  <!-- TechReport: one unique title, one shares title with an Article -->
  <entries xsi:type="BibTeX:TechReport" id="tr01" year="2018" title="Survey on Model Transformations">
    <authors author="John Miller"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr02" year="2019" title="Journal-Based Testing Overview">
    <authors author="Karen Young"/>
  </entries>

  <!-- Thesis entries: PhD and Master with distinct titles -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd01" year="2016" title="Formal Approaches to Model Transformation Testing" school="University of Example">
    <authors author="Laura Adams"/>
    <authors author="Mike Owen"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mst01" year="2014" title="Empirical Study of ATL Transformations" school="Example Institute of Technology">
    <authors author="Nina Perez"/>
  </entries>

  <!-- Articles to exercise all four article rules via title/journal duplicates -->

  <!-- A1, A2: same title, different journals -> one Title_Journal, one NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="a001" year="2020" title="Model-Based Mutation Testing" journal="Journal of MDE">
    <authors author="Alice Smith"/>
    <authors author="John Miller"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a002" year="2021" title="Model-Based Mutation Testing" journal="Software Testing Letters">
    <authors author="Carol White"/>
  </entries>

  <!-- A3, A4: different titles, same journal -> one Title_Journal, one Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a003" year="2019" title="Traceability in Model Transformations" journal="International Journal of Software Engineering">
    <authors author="David Brown"/>
    <authors author="George King"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a004" year="2019" title="Coverage Criteria for ATL" journal="International Journal of Software Engineering">
    <authors author="Helen Clark"/>
  </entries>

  <!-- A5, A6: same title and same journal -> one Title_Journal, one NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a005" year="2018" title="Optimization of Model Transformations" journal="Journal of MDE">
    <authors author="Ian Lee"/>
    <authors author="Karen Young"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a006" year="2018" title="Optimization of Model Transformations" journal="Journal of MDE">
    <authors author="Laura Adams"/>
  </entries>

  <!-- A7: title reused from TechReport tr02 but different journal -->
  <entries xsi:type="BibTeX:Article" id="a007" year="2022" title="Journal-Based Testing Overview" journal="Software Testing Letters">
    <authors author="Mike Owen"/>
    <authors author="Nina Perez"/>
  </entries>

</BibTeX:BibTeXFile>