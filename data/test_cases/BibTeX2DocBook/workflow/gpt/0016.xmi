<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles: three distinct titles, three distinct journals -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model-Driven Engineering in Practice" journal="Journal of Software Modeling">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Incremental Model Transformations" journal="International Journal on Model Transformation">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Testing ATL Transformations" journal="Software Testing Letters">
    <authors author="Bob Johnson"/>
    <authors author="Diana Clark"/>
  </entries>

  <!-- Manuals (TitledEntry only) -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="ATL Reference Manual"/>
  <entries xsi:type="BibTeX:Manual" id="M2" title="EMF User Guide"/>

  <!-- TechReport (Authored, Dated, Titled) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2004" title="Scalable Model Repositories">
    <authors author="Alice Smith"/>
    <authors author="Evan Lewis"/>
  </entries>

  <!-- Unpublished (Authored, Titled, with note) -->
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Unpublished MDE Case Study" note="To appear in conference proceedings">
    <authors author="Frank Moore"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book and InBook share the same title (to exercise TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:Book" id="B1" year="2005" title="Fundamentals of Model Transformation" publisher="Springer">
    <authors author="George King"/>
    <authors author="Helen Scott"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2006" title="Fundamentals of Model Transformation" publisher="Elsevier" chapter="7">
    <authors author="Ian Turner"/>
  </entries>

  <!-- Proceedings and InProceedings share same title (also exercises duplication logic) -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2007" title="Proceedings of the MDE Symposium"/>
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2007" title="Proceedings of the MDE Symposium" booktitle="LNCS 9999">
    <authors author="Jane Doe"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2008" title="Domain-Specific Languages for MDE" publisher="ACM Press" booktitle="Advanced Topics in Model Engineering">
    <authors author="Carol White"/>
    <authors author="Kevin Brown"/>
  </entries>

  <!-- PhDThesis and MasterThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2009" title="Formal Verification of Model Transformations" school="Tech University">
    <authors author="Laura Green"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2010" title="Model Transformation Testing Framework" school="City University">
    <authors author="Mike Black"/>
    <authors author="Jane Doe"/>
  </entries>

  <!-- Booklet (DatedEntry only, untitled) -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="2011"/>

  <!-- Misc (pure BibTeXEntry, untitled, unauthored, undated) -->
  <entries xsi:type="BibTeX:Misc" id="MSC1"/>
</BibTeX:BibTeXFile>