<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles: cover all 4 article rules via title/journal duplicates -->
  <!-- A1: unique title & unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Title_A1" journal="Journal_A1">
    <authors author="Author_1"/>
    <authors author="Author_2"/>
  </entries>
  <!-- A2,A3: same title, different journals -> A2 in title-set, A3 not; both in journal-set
       A2 -> Article_Title_Journal, A3 -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Title_A2A3" journal="Journal_A2">
    <authors author="Author_3"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Title_A2A3" journal="Journal_A3">
    <authors author="Author_3"/>
    <authors author="Author_4"/>
  </entries>
  <!-- A4,A5: different titles, same journal -> A4 in title- & journal-set, A5 in title-set only
       A4 -> Article_Title_Journal, A5 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Title_A4" journal="Journal_Shared">
    <authors author="Author_5"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Title_A5" journal="Journal_Shared">
    <authors author="Author_6"/>
  </entries>
  <!-- A6,A7: same title AND same journal -> A6 in both sets, A7 in none
       A6 -> Article_Title_Journal, A7 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Title_A6A7" journal="Journal_A6A7">
    <authors author="Author_7"/>
    <authors author="Author_8"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Title_A6A7" journal="Journal_A6A7">
    <authors author="Author_8"/>
  </entries>

  <!-- Untitled entries: Booklet and Misc -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="Blet1" year="1999"/>
  <entries xsi:type="BibTeX:Misc" id="Misc1"/>

  <!-- Titled non-articles: distinct titles -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="Man1" title="Manual_Title_1"/>
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="TR_Title_1">
    <authors author="Author_9"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="Book1" year="2011" title="Book_Title_1" publisher="Publisher_1">
    <authors author="Author_10"/>
    <authors author="Author_11"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="InBook1" year="2012" title="InBook_Title_1" publisher="Publisher_2" chapter="3">
    <authors author="Author_11"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="InColl1" year="2013" title="InColl_Title_1" publisher="Publisher_3" booktitle="BookTitle_IC1">
    <authors author="Author_12"/>
    <authors author="Author_3"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="InProc1" year="2014" title="InProc_Title_1" booktitle="BookTitle_IP1">
    <authors author="Author_13"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="Proc1" year="2015" title="Proc_Title_1"/>
  <entries xsi:type="BibTeX:MasterThesis" id="MTh1" year="2016" title="MThesis_Title_1" school="School_1">
    <authors author="Author_14"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PhD1" year="2017" title="PhD_Title_1" school="School_2">
    <authors author="Author_15"/>
    <authors author="Author_5"/>
  </entries>

  <!-- Titled non-articles: duplicated title -> first in set (Title-entry rule), second not (NoTitle rule) -->
  <entries xsi:type="BibTeX:Unpublished" id="Unpub1" title="Shared_Titled_Entry" note="Note_Unpub1">
    <authors author="Author_16"/>
    <authors author="Author_1"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="Unpub2" title="Shared_Titled_Entry" note="Note_Unpub2">
    <authors author="Author_17"/>
  </entries>
</BibTeX:BibTeXFile>