<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise all Article-variant rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="artA1" year="2001" title="Model Transformations in Practice" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- A2 & A3: same title, different journals -> one Article_Title_Journal, one Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="artA2" year="2002" title="Testing ATL Transformations" journal="Software Quality Letters">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artA3" year="2003" title="Testing ATL Transformations" journal="International Journal of MDE">
    <authors author="Dave Brown"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- A4 & A5: same journal, different titles -> one Article_Title_Journal, one Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="artA4" year="2004" title="Optimizing Model Transformations" journal="Journal of Transformation Research">
    <authors author="Eve Black"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artA5" year="2005" title="Scalable Model Validation" journal="Journal of Transformation Research">
    <authors author="Frank Green"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- A6 & A7: same title and same journal -> one Article_Title_Journal, one Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="artA6" year="2006" title="Concurrent Model Transformations" journal="Concurrency and Models">
    <authors author="Grace Lee"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artA7" year="2007" title="Concurrent Model Transformations" journal="Concurrency and Models">
    <authors author="Henry King"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Untitled entries to trigger UntitledEntry: Booklet, Misc -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet2" year="2010"/>
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Non-article titled entries to exercise TitledEntry_Title_NoArticle and TitledEntry_NoTitle_NoArticle -->
  <!-- Unique-title instances (go to titledEntrySet) -->
  <!-- Manual -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL User Guide"/>
  <!-- TechReport with unique title -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2011" title="Verification of Model Transformations">
    <authors author="Ian Clark"/>
  </entries>
  <!-- PhDThesis with unique title -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2012" title="Model-Driven Performance Engineering" school="University of Metropolis">
    <authors author="Jane Doe"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- MasterThesis with unique title -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="2013" title="Testing Model Transformations" school="Tech University">
    <authors author="Kevin Young"/>
  </entries>
  <!-- Book with unique title -->
  <entries xsi:type="BibTeX:Book" id="book1" year="2000" title="Introduction to MDE" publisher="MDE Press">
    <authors author="Laura Hill"/>
    <authors author="Mike Scott"/>
  </entries>
  <!-- InBook with unique title -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2008" title="Advanced ATL Patterns" publisher="Patterns Publishing" chapter="3">
    <authors author="Nina Adams"/>
    <authors author="Oscar Price"/>
  </entries>
  <!-- InCollection with unique title -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" year="2014" title="Traceability in MDE" publisher="Springer" booktitle="Recent Advances in MDE">
    <authors author="Peter Quinn"/>
  </entries>
  <!-- Proceedings with unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2015" title="Proceedings of the MDE Conference"/>

  <!-- Duplicate-title pairs to force TitledEntry_NoTitle_NoArticle for second element -->
  <!-- Unpublished pair -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft on Model Repository" note="First version">
    <authors author="Rachel Stone"/>
    <authors author="Tom Walker"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Draft on Model Repository" note="Revised version">
    <authors author="Rachel Stone"/>
  </entries>
  <!-- Book pair -->
  <entries xsi:type="BibTeX:Book" id="book2" year="2009" title="Patterns of Model Transformations" publisher="Patterns Publishing">
    <authors author="Steve Adams"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book3" year="2010" title="Patterns of Model Transformations" publisher="Second Edition Press">
    <authors author="Steve Adams"/>
    <authors author="Uma Fox"/>
  </entries>
  <!-- Proceedings pair -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2016" title="Workshop on Testing Transformations"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc3" year="2017" title="Workshop on Testing Transformations"/>
  <!-- TechReport pair (second will have no title paragraph) -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2018" title="Verification of Model Transformations">
    <authors author="Ian Clark"/>
    <authors author="Victor Gray"/>
  </entries>
  <!-- InProceedings pair -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2019" title="Testing ATL Transformations in the Large" booktitle="ICMT 2019" >
    <authors author="Wendy Hall"/>
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" year="2020" title="Testing ATL Transformations in the Large" booktitle="ICMT 2020">
    <authors author="Xavier Long"/>
  </entries>
</BibTeX:BibTeXFile>