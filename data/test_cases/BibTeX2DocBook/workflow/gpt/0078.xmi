<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise all 4 Article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Title 1" journal="Unique Journal 1">
    <authors author="Author One"/>
    <authors author="Author Two"/>
  </entries>
  <!-- A2: duplicate title with A3, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title A" journal="Unique Journal 2">
    <authors author="Author Three"/>
  </entries>
  <!-- A3: another article with Shared Title A, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Title A" journal="Unique Journal 3">
    <authors author="Author Four"/>
    <authors author="Author Five"/>
  </entries>
  <!-- A4: unique title, journal duplicated with A5 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Unique Title 2" journal="Shared Journal A">
    <authors author="Author Six"/>
  </entries>
  <!-- A5: different title, same journal as A4 -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Another Title 3" journal="Shared Journal A">
    <authors author="Author Seven"/>
    <authors author="Author Eight"/>
  </entries>
  <!-- A6: same title as A7 and same journal as A8 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Shared Title B" journal="Shared Journal B">
    <authors author="Author Nine"/>
  </entries>
  <!-- A7: same title as A6, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Shared Title B" journal="Unique Journal 4">
    <authors author="Author Ten"/>
  </entries>
  <!-- A8: unique title, same journal as A6 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A8" year="2008" title="Unique Title 4" journal="Shared Journal B">
    <authors author="Author Eleven"/>
    <authors author="Author Twelve"/>
  </entries>

  <!-- Untitled entries to trigger UntitledEntry (Booklet, Misc, Booklet duplicate year pattern not relevant) -->
  <entries xsi:type="BibTeX:Booklet" id="U1" year="1990"/>
  <entries xsi:type="BibTeX:Booklet" id="U2" year="1991"/>
  <entries xsi:type="BibTeX:Misc" id="U3"/>

  <!-- Titled entries (non-articles) to exercise R4 and R5 -->
  <!-- T1: Book with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="T1" year="2010" title="Book Unique Title 1" publisher="Publisher One">
    <authors author="Author Thirteen"/>
    <authors author="Author Fourteen"/>
  </entries>
  <!-- T2: Book with title duplicated by T3 -> in minimal distinct title set (T2), so R4 -->
  <entries xsi:type="BibTeX:Book" id="T2" year="2011" title="Book Shared Title" publisher="Publisher Two">
    <authors author="Author Fifteen"/>
  </entries>
  <!-- T3: Book sharing title with T2 -> not in distinct title set, so R5 -->
  <entries xsi:type="BibTeX:Book" id="T3" year="2012" title="Book Shared Title" publisher="Publisher Three">
    <authors author="Author Sixteen"/>
    <authors author="Author Seventeen"/>
  </entries>
  <!-- T4: InBook with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="T4" year="2013" title="InBook Unique Title" publisher="Publisher Four" chapter="5">
    <authors author="Author Eighteen"/>
  </entries>
  <!-- T5/T6: Proceedings pair sharing a title -> R4 for T5, R5 for T6 -->
  <entries xsi:type="BibTeX:Proceedings" id="T5" year="2014" title="Proceedings Shared Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="T6" year="2015" title="Proceedings Shared Title"/>
  <!-- T7: TechReport unique title -> R4 -->
  <entries xsi:type="BibTeX:TechReport" id="T7" year="2016" title="TechReport Unique Title">
    <authors author="Author Nineteen"/>
  </entries>
  <!-- T8/T9: PhDThesis pair sharing a title -> R4 for T8, R5 for T9 -->
  <entries xsi:type="BibTeX:PhDThesis" id="T8" year="2017" title="Thesis Shared Title" school="School One">
    <authors author="Author Twenty"/>
    <authors author="Author TwentyOne"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="T9" year="2018" title="Thesis Shared Title" school="School Two">
    <authors author="Author TwentyTwo"/>
  </entries>
  <!-- T10: MasterThesis unique title -> R4 -->
  <entries xsi:type="BibTeX:MasterThesis" id="T10" year="2019" title="Master Thesis Unique Title" school="School Three">
    <authors author="Author TwentyThree"/>
  </entries>
  <!-- T11: Manual unique title -> R4 -->
  <entries xsi:type="BibTeX:Manual" id="T11" title="Manual Unique Title"/>
  <!-- T12/T13: Unpublished pair sharing a title -> R4 for T12, R5 for T13 -->
  <entries xsi:type="BibTeX:Unpublished" id="T12" title="Unpublished Shared Title" note="Note One">
    <authors author="Author TwentyFour"/>
    <authors author="Author TwentyFive"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="T13" title="Unpublished Shared Title" note="Note Two">
    <authors author="Author TwentySix"/>
  </entries>
  <!-- T14: InCollection unique title -> R4 -->
  <entries xsi:type="BibTeX:InCollection" id="T14" year="2020" title="InCollection Unique Title" publisher="Publisher Five" booktitle="Booktitle One">
    <authors author="Author TwentySeven"/>
    <authors author="Author TwentyEight"/>
  </entries>
  <!-- T15: InProceedings unique title -> R4 -->
  <entries xsi:type="BibTeX:InProceedings" id="T15" year="2021" title="InProceedings Unique Title" booktitle="Booktitle Two">
    <authors author="Author TwentyNine"/>
  </entries>
</BibTeX:BibTeXFile>