<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles designed to exercise all four Article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Unique Article One" journal="Journal A">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>
  <!-- A2 & A3: same title, different journals
       A2 in title-set & journal-set -> Article_Title_Journal
       A3 not in title-set, in journal-set -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Shared Title 1" journal="Journal B">
    <authors author="Carol Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Shared Title 1" journal="Journal C">
    <authors author="Dave Scholar"/>
    <authors author="Alice Author"/>
  </entries>
  <!-- A4 & A5: different titles, same journal
       A4 in title-set & journal-set -> Article_Title_Journal
       A5 in title-set, not in journal-set -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Journal D Title 1" journal="Journal D">
    <authors author="Eve Writer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Journal D Title 2" journal="Journal D">
    <authors author="Frank Author"/>
    <authors author="George Researcher"/>
  </entries>
  <!-- A6 & A7: same title and same journal
       A6 in title-set & journal-set -> Article_Title_Journal
       A7 not in either -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art6" year="2006" title="Fully Shared Title" journal="Journal E">
    <authors author="Helen Scientist"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art7" year="2007" title="Fully Shared Title" journal="Journal E">
    <authors author="Ian Researcher"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- Untitled entries to trigger UntitledEntry (Booklet & Misc) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet2" year="2010"/>
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Misc" id="misc2"/>

  <!-- Titled non-Article entries to exercise TitledEntry rules -->
  <!-- T1: unique title -> TitledEntry_Title_NoArticle (Book) -->
  <entries xsi:type="BibTeX:Book" id="book1" year="1995" title="Unique Book Title" publisher="Publisher One">
    <authors author="Carol Researcher"/>
    <authors author="Alice Author"/>
  </entries>
  <!-- T2 & T3: same title for non-articles
       T2 in title-set -> TitledEntry_Title_NoArticle (InBook)
       T3 not in set -> TitledEntry_NoTitle_NoArticle (InCollection) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="1998" title="Repeated NonArticle Title" publisher="Publisher Two" chapter="3">
    <authors author="Frank Author"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="incol1" year="2000" title="Repeated NonArticle Title" publisher="Publisher Three" booktitle="Collected Works Volume 1">
    <authors author="George Researcher"/>
    <authors author="Helen Scientist"/>
  </entries>

  <!-- Other titled non-articles with distinct titles to trigger TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="Manual Title A"/>
  <entries xsi:type="BibTeX:Manual" id="manual2" title="Manual Title B"/>
  <entries xsi:type="BibTeX:TechReport" id="tech1" year="2015" title="Tech Report Title" >
    <authors author="Ian Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Unpublished Work Title" note="Draft version">
    <authors author="Jane Contributor"/>
    <authors author="Bob Writer"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2012" title="PhD Thesis Title" school="University X">
    <authors author="Kate Student"/>
    <authors author="Alice Author"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="msc1" year="2018" title="Master Thesis Title" school="Institute Y">
    <authors author="Luke Graduate"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2020" title="Conference Proceedings 2020"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2021" title="Symposium on Model Engineering"/>

</BibTeX:BibTeXFile>