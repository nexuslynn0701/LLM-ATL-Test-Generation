<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise all four article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Title One" journal="Journal Alpha">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- A2 & A3: same title, different journals -->
  <!-- A2: representative for title 'Shared Title' & journal 'Journal Beta' -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title" journal="Journal Beta">
    <authors author="Charlie Scribe"/>
  </entries>

  <!-- A3: same title 'Shared Title', journal 'Journal Gamma' not first for that journal -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Title" journal="Journal Gamma">
    <authors author="Dave Editor"/>
    <authors author="Alice Author"/>
  </entries>

  <!-- A4 & A5 & A6: same journal, different titles -->
  <!-- A4: first for title 'Title JDelta 1' and first for journal 'Journal Delta' -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Title JDelta 1" journal="Journal Delta">
    <authors author="Eve Researcher"/>
  </entries>

  <!-- A5: first for title 'Title JDelta 2', but not first for journal 'Journal Delta' -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Title JDelta 2" journal="Journal Delta">
    <authors author="Frank Analyst"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- A6: first for title 'Another Delta Title', journal 'Journal Gamma' already represented by A3 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Another Delta Title" journal="Journal Gamma">
    <authors author="Grace Scholar"/>
  </entries>

  <!-- A7 & A8: same title and same journal -->
  <!-- A7: first for title 'Same TJ' and first for journal 'Journal Epsilon' -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Same TJ" journal="Journal Epsilon">
    <authors author="Heidi Author"/>
  </entries>

  <!-- A8: same title 'Same TJ', same journal 'Journal Epsilon' not representative for either -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A8" year="2008" title="Same TJ" journal="Journal Epsilon">
    <authors author="Ivan Writer"/>
    <authors author="Charlie Scribe"/>
  </entries>

  <!-- Booklets (untitled, dated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="BLET1" year="1990"/>
  <entries xsi:type="BibTeX:Booklet" id="BLET2" year="1991"/>

  <!-- Misc (untitled, undated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MISC1"/>
  <entries xsi:type="BibTeX:Misc" id="MISC2"/>

  <!-- Manuals (titled, no authors, no year) -> TitledEntry_*_NoArticle -->
  <!-- MAN1: title unique -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="Manual Unique Title">
  </entries>

  <!-- MAN2 & MAN3: same title: MAN2 representative, MAN3 duplicate -->
  <!-- MAN2: in unique-title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MAN2" title="Repeated Manual Title">
  </entries>

  <!-- MAN3: not in unique-title set -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MAN3" title="Repeated Manual Title">
  </entries>

  <!-- TechReports (authored, dated, titled) -->
  <!-- TR1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="TechReport Unique Title">
    <authors author="Jack Researcher"/>
  </entries>

  <!-- TR2 & TR3: same title: TR2 representative, TR3 duplicate -->
  <!-- TR2: -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2011" title="Shared TechReport Title">
    <authors author="Karen Scientist"/>
    <authors author="Alice Author"/>
  </entries>

  <!-- TR3: -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR3" year="2012" title="Shared TechReport Title">
    <authors author="Leo Engineer"/>
  </entries>

  <!-- Unpublished (authored, titled, no year) -->
  <!-- UNP1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="UNP1" title="Unpublished Unique" note="To appear soon">
    <authors author="Mallory Writer"/>
  </entries>

  <!-- UNP2 & UNP3: same title: UNP2 representative, UNP3 duplicate -->
  <!-- UNP2: -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="UNP2" title="Shared Unpublished" note="Preprint version">
    <authors author="Nina Author"/>
    <authors author="Oscar Researcher"/>
  </entries>

  <!-- UNP3: -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="UNP3" title="Shared Unpublished" note="Revised version">
    <authors author="Peggy Scholar"/>
  </entries>

  <!-- Books (authored, dated, titled, publisher) -->
  <!-- BK1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="1995" title="Book Unique Title" publisher="Publisher One">
    <authors author="Quentin Author"/>
    <authors author="Rachel Writer"/>
  </entries>

  <!-- BK2 & BK3: same title: BK2 representative, BK3 duplicate -->
  <!-- BK2: -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="1996" title="Shared Book Title" publisher="Publisher Two">
    <authors author="Steve Scholar"/>
  </entries>

  <!-- BK3: -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK3" year="1997" title="Shared Book Title" publisher="Publisher Three">
    <authors author="Trudy Researcher"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- InBook (authored, dated, titled, publisher, chapter) -->
  <!-- IB1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="1998" title="InBook Unique Title" publisher="Publisher Four" chapter="3">
    <authors author="Uma Author"/>
  </entries>

  <!-- IB2 & IB3: same title: IB2 representative, IB3 duplicate -->
  <!-- IB2: -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB2" year="1999" title="Shared InBook Title" publisher="Publisher Five" chapter="5">
    <authors author="Victor Writer"/>
    <authors author="Wendy Editor"/>
  </entries>

  <!-- IB3: -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB3" year="2000" title="Shared InBook Title" publisher="Publisher Six" chapter="7">
    <authors author="Xavier Researcher"/>
  </entries>

  <!-- Proceedings (dated, titled, no authors) -->
  <!-- PR1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2013" title="Proceedings Unique Title">
  </entries>

  <!-- PR2 & PR3: same title: PR2 representative, PR3 duplicate -->
  <!-- PR2: -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2014" title="Shared Proceedings Title">
  </entries>

  <!-- PR3: -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR3" year="2015" title="Shared Proceedings Title">
  </entries>

  <!-- InProceedings (authored, dated, titled, booktitle) -->
  <!-- IP1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2016" title="InProceedings Unique Title" booktitle="Conference One">
    <authors author="Yvonne Scientist"/>
  </entries>

  <!-- IP2 & IP3: same title: IP2 representative, IP3 duplicate -->
  <!-- IP2: -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2017" title="Shared InProceedings Title" booktitle="Conference Two">
    <authors author="Zack Author"/>
    <authors author="Oscar Researcher"/>
  </entries>

  <!-- IP3: -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP3" year="2018" title="Shared InProceedings Title" booktitle="Conference Three">
    <authors author="Alice Author"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry: authored, dated, titled, booktitle, publisher) -->
  <!-- IC1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2019" title="InCollection Unique Title" booktitle="Collection One" publisher="Publisher Seven">
    <authors author="Charlie Scribe"/>
    <authors author="Nina Author"/>
  </entries>

  <!-- IC2 & IC3: same title: IC2 representative, IC3 duplicate -->
  <!-- IC2: -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC2" year="2020" title="Shared InCollection Title" booktitle="Collection Two" publisher="Publisher Eight">
    <authors author="Peggy Scholar"/>
  </entries>

  <!-- IC3: -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC3" year="2021" title="Shared InCollection Title" booktitle="Collection Three" publisher="Publisher Nine">
    <authors author="Rachel Writer"/>
    <authors author="Victor Writer"/>
  </entries>

  <!-- PhDThesis (ThesisEntry: authored, dated, titled, school) -->
  <!-- PHD1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2009" title="PhD Unique Title" school="University One">
    <authors author="Heidi Author"/>
    <authors author="Jack Researcher"/>
  </entries>

  <!-- PHD2 & PHD3: same title: PHD2 representative, PHD3 duplicate -->
  <!-- PHD2: -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD2" year="2010" title="Shared PhD Title" school="University Two">
    <authors author="Trudy Researcher"/>
  </entries>

  <!-- PHD3: -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD3" year="2011" title="Shared PhD Title" school="University Three">
    <authors author="Grace Scholar"/>
    <authors author="Steve Scholar"/>
  </entries>

  <!-- MasterThesis (ThesisEntry: authored, dated, titled, school) -->
  <!-- MST1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MST1" year="2012" title="Master Unique Title" school="Institute One">
    <authors author="Yvonne Scientist"/>
  </entries>

  <!-- MST2 & MST3: same title: MST2 representative, MST3 duplicate -->
  <!-- MST2: -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MST2" year="2013" title="Shared Master Title" school="Institute Two">
    <authors author="Mallory Writer"/>
    <authors author="Leo Engineer"/>
  </entries>

  <!-- MST3: -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MST3" year="2014" title="Shared Master Title" school="Institute Three">
    <authors author="Quentin Author"/>
  </entries>

</BibTeX:BibTeXFile>