<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles for each Article_* rule combination -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Title 1" journal="Unique Journal 1">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>
  <!-- A2 & A3: same title, different journals -> one Article_Title_Journal (A2), one Article_NoTitle_Journal (A3) -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title T1" journal="Journal J2">
    <authors author="Carol Gamma"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Title T1" journal="Journal J3">
    <authors author="Dave Delta"/>
    <authors author="Eve Epsilon"/>
  </entries>
  <!-- A4 & A5: same journal, different titles -> one Article_Title_Journal (A4), one Article_Title_NoJournal (A5) -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Shared Journal Title 1" journal="Journal J4">
    <authors author="Frank Phi"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Shared Journal Title 2" journal="Journal J4">
    <authors author="Grace Gamma"/>
    <authors author="Helen Eta"/>
  </entries>
  <!-- A6 to A8: same title and same journal -> one Article_Title_Journal (A6), two Article_NoTitle_NoJournal (A7,A8) -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Fully Shared Title" journal="Shared Journal SJ1">
    <authors author="Ivy Iota"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Fully Shared Title" journal="Shared Journal SJ1">
    <authors author="Jack Kappa"/>
    <authors author="Laura Lambda"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A8" year="2008" title="Fully Shared Title" journal="Shared Journal SJ1">
    <authors author="Mike Mu"/>
  </entries>

  <!-- Titled non-Article entries to exercise TitledEntry_* rules -->
  <!-- B1 & B2 & B3: Books; B1 gets title_para, B2/B3 only entry_para -->
  <entries xsi:type="BibTeX:Book" id="B1" year="2010" title="Book Title Unique" publisher="Publisher P1">
    <authors author="Nina Nu"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="B2" year="2011" title="Common Title C1" publisher="Publisher P2">
    <authors author="Oscar Omicron"/>
    <authors author="Peter Pi"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="B3" year="2012" title="Common Title C1" publisher="Publisher P3">
    <authors author="Quinn Theta"/>
  </entries>

  <!-- INB1 & INB2: InBook; INB1 gets title_para, INB2 only entry_para -->
  <entries xsi:type="BibTeX:InBook" id="INB1" year="2013" title="InBook Unique Title" publisher="Publisher P4" chapter="1">
    <authors author="Rachel Rho"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="INB2" year="2014" title="Common Title C2" publisher="Publisher P5" chapter="2">
    <authors author="Sam Sigma"/>
    <authors author="Tina Tau"/>
  </entries>

  <!-- INC1 & INC2: InCollection; INC1 gets title_para, INC2 only entry_para -->
  <entries xsi:type="BibTeX:InCollection" id="INC1" year="2015" title="InCollection Unique Title" publisher="Publisher P6" booktitle="Booktitle BT1">
    <authors author="Uma Upsilon"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="INC2" year="2016" title="Common Title C2" publisher="Publisher P7" booktitle="Booktitle BT2">
    <authors author="Victor Vee"/>
  </entries>

  <!-- IP1 & IP2: InProceedings; IP1 gets title_para, IP2 only entry_para -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2017" title="InProceedings Unique Title" booktitle="Conf Booktitle CB1">
    <authors author="Wendy Omega"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2018" title="Common Title C3" booktitle="Conf Booktitle CB2">
    <authors author="Yanni Psi"/>
    <authors author="Zoe Zeta"/>
  </entries>

  <!-- PR1 & PR2: Proceedings; PR1 gets title_para (as Proceedings), PR2 only entry_para -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2019" title="Proceedings Unique Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2020" title="Common Title C3"/>

  <!-- M1 & M2: Manual; M1 gets title_para, M2 only entry_para -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="Manual Unique Title"/>
  <entries xsi:type="BibTeX:Manual" id="M2" title="Common Title C4"/>

  <!-- U1 & U2: Unpublished; U1 gets title_para, U2 only entry_para -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Unpublished Unique Title" note="Note for U1">
    <authors author="Alice Alpha"/>
    <authors author="Carol Gamma"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Common Title C4" note="Note for U2">
    <authors author="Bob Beta"/>
  </entries>

  <!-- TR1 & TR2: TechReport; TR1 gets title_para, TR2 only entry_para -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2021" title="TechReport Unique Title">
    <authors author="Helen Eta"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2022" title="Common Title C5">
    <authors author="Jack Kappa"/>
    <authors author="Laura Lambda"/>
  </entries>

  <!-- Thesis entries -->
  <!-- MT1 & MT2: MasterThesis with distinct titles -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2010" title="Master Thesis Title 1" school="School S1">
    <authors author="Mike Mu"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT2" year="2011" title="Master Thesis Title 2" school="School S2">
    <authors author="Nina Nu"/>
    <authors author="Oscar Omicron"/>
  </entries>
  <!-- PHD1 & PHD2: PhDThesis with distinct titles -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2012" title="PhD Thesis Title 1" school="School S3">
    <authors author="Peter Pi"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PHD2" year="2013" title="PhD Thesis Title 2" school="School S4">
    <authors author="Quinn Theta"/>
    <authors author="Rachel Rho"/>
  </entries>

  <!-- Untitled entries for UntitledEntry rule -->
  <entries xsi:type="BibTeX:Booklet" id="BK1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="BK2" year="2000"/>
  <entries xsi:type="BibTeX:Misc" id="MS1"/>
  <entries xsi:type="BibTeX:Misc" id="MS2"/>
</BibTeX:BibTeXFile>