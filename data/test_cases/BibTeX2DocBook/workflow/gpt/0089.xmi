<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles designed to trigger different Article_* rules and journal/title uniqueness handling -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model Transformation Testing" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A2: shares title with A3, unique journal for that title -> second occurrence by title -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Metamodeling Basics" journal="Software Architecture Letters">
    <authors author="Carol White"/>
  </entries>

  <!-- A3: same title as A2; different journal, but title already in set -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Metamodeling Basics" journal="Journal of Formal Models">
    <authors author="Dave Brown"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- A4: shares journal with A5, unique title for that journal -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Traceability in MDE" journal="International Journal of Software Evolution">
    <authors author="Eve Black"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- A5: second article in same journal as A4 with different title -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Refactoring Transformations" journal="International Journal of Software Evolution">
    <authors author="George King"/>
  </entries>

  <!-- A6: shares title with A7 and journal with A8 and A9 to exercise Article_NoTitle_NoJournal and title/journal duplication -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="ATL Case Studies" journal="Model Transformation Journal">
    <authors author="Helen Clark"/>
    <authors author="Ian Miller"/>
  </entries>

  <!-- A7: same title and journal as A6 -> will fall under Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="ATL Case Studies" journal="Model Transformation Journal">
    <authors author="John Lewis"/>
  </entries>

  <!-- A8: different title, same journal as A6/A7 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A8" year="2008" title="Reusable Transformation Libraries" journal="Model Transformation Journal">
    <authors author="Kelly Adams"/>
  </entries>

  <!-- A9: another different title in same journal as A6/A7/A8 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A9" year="2009" title="Bidirectional Synchronization" journal="Model Transformation Journal">
    <authors author="Laura Scott"/>
    <authors author="Mike Turner"/>
  </entries>

  <!-- Booklets (DatedEntry but not TitledEntry) -> UntitledEntry rule -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="B2" year="2010"/>

  <!-- Misc entries (pure BibTeXEntry) -> UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Misc" id="M2"/>

  <!-- Manual (TitledEntry only) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="User Guide for ATL IDE"/>

  <!-- Manual with same title as MAN1 -> triggers TitledEntry_NoTitle_NoArticle for this second one -->
  <entries xsi:type="BibTeX:Manual" id="MAN2" title="User Guide for ATL IDE"/>

  <!-- TechReport (Authored+Dated+Titled) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2011" title="Testing Model Transformations">
    <authors author="Nina Perez"/>
    <authors author="Oscar Reed"/>
  </entries>

  <!-- TechReport with duplicated title of TR1 -> TitledEntry_NoTitle_NoArticle for this one -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2012" title="Testing Model Transformations">
    <authors author="Paul Young"/>
  </entries>

  <!-- Book (Authored+Dated+Titled) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="2013" title="Foundations of MDE" publisher="Springer MDE Series">
    <authors author="Quentin Hall"/>
    <authors author="Rachel Gray"/>
  </entries>

  <!-- Book with same title as BK1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="2014" title="Foundations of MDE" publisher="TechBooks Publishing">
    <authors author="Sam Walker"/>
  </entries>

  <!-- InBook (Book + chapter) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2015" title="Chapter on Metamodel Evolution" publisher="Springer MDE Series" chapter="3">
    <authors author="Rachel Gray"/>
    <authors author="Tom Hughes"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2016" title="Case Study on Refactoring" publisher="Springer MDE Series" booktitle="Advances in Model Transformations">
    <authors author="Uma Patel"/>
  </entries>

  <!-- InProceedings (Proceedings + Authored + BookTitled) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2017" title="Testing ATL Transformations" booktitle="ICMT 2017 Proceedings">
    <authors author="Victor Stone"/>
    <authors author="Wendy Fox"/>
  </entries>

  <!-- Proceedings base type (Dated+Titled) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2018" title="Proceedings of the MDE Conference"/>
  <!-- Another Proceedings with distinct title so it also gets a title paragraph -->
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2019" title="Workshops on Model Transformation"/>

  <!-- PhDThesis (ThesisEntry) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2020" title="Scalable Model Transformations" school="University of Example">
    <authors author="Yara Knight"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MSC1" year="2021" title="Test Data Generation for MDE" school="Institute of Software Science">
    <authors author="Zack Irving"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Unpublished entries (Authored+Titled) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Draft on Model Versioning" note="To appear">
    <authors author="Bob Johnson"/>
    <authors author="Carol White"/>
  </entries>

  <!-- Second Unpublished with distinct title to ensure multiple titles -->
  <entries xsi:type="BibTeX:Unpublished" id="UP2" title="Notes on Transformation Coverage" note="Internal report">
    <authors author="Ian Miller"/>
  </entries>

</BibTeX:BibTeXFile>