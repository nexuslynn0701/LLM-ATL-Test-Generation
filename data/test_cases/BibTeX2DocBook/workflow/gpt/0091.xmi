<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles designed to exercise all four article rules:
       - A1,A2: same title, different journals  -> one in title-set, one not; both in journal-set
       - A3,A4: same journal, different titles -> one in journal-set, one not; both in title-set
       - A5,A6: same title and same journal    -> one in both sets, one in neither set -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001"
           title="Shared Title TJ" journal="Journal Alpha">
    <authors author="Author One"/>
    <authors author="Author Two"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art2" year="2002"
           title="Shared Title TJ" journal="Journal Beta">
    <authors author="Author Three"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art3" year="2003"
           title="Distinct Title J" journal="Journal Gamma">
    <authors author="Author Four"/>
    <authors author="Author Five"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art4" year="2004"
           title="Another Distinct Title" journal="Journal Gamma">
    <authors author="Author Six"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art5" year="2005"
           title="Shared Title JJ" journal="Journal Delta">
    <authors author="Author Seven"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art6" year="2006"
           title="Shared Title JJ" journal="Journal Delta">
    <authors author="Author Eight"/>
    <authors author="Author Nine"/>
  </entries>

  <!-- One TechReport with a unique title -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2010"
           title="Unique TechReport Title">
    <authors author="Author Ten"/>
    <authors author="Author Eleven"/>
  </entries>

  <!-- Two Manuals sharing the same title: one will be in the distinct-title set, one not -->
  <entries xsi:type="BibTeX:Manual" id="man1"
           title="Repeated Manual Title"/>
  <entries xsi:type="BibTeX:Manual" id="man2"
           title="Repeated Manual Title"/>

  <!-- Two Proceedings sharing the same title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2015"
           title="Repeated Proceedings Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2016"
           title="Repeated Proceedings Title"/>

  <!-- Book with unique title -->
  <entries xsi:type="BibTeX:Book" id="book1" year="1999"
           title="Unique Book Title" publisher="Publisher One">
    <authors author="Author Twelve"/>
    <authors author="Author Thirteen"/>
  </entries>

  <!-- Two InBook entries with the same title (and same other fields except chapter) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2000"
           title="Repeated InBook Title" publisher="Publisher Two" chapter="1">
    <authors author="Author Fourteen"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="inbook2" year="2001"
           title="Repeated InBook Title" publisher="Publisher Two" chapter="2">
    <authors author="Author Fifteen"/>
  </entries>

  <!-- InCollection with unique title -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" year="2007"
           title="Unique InCollection Title" publisher="Publisher Three" booktitle="Collection Alpha">
    <authors author="Author Sixteen"/>
    <authors author="Author Seventeen"/>
  </entries>

  <!-- Unpublished entries:
       unpub1 and unpub2 share the same title; unpub3 has a distinct title -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1"
           title="Repeated Unpublished Title" note="Note One">
    <authors author="Author Eighteen"/>
    <authors author="Author Nineteen"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub2"
           title="Repeated Unpublished Title" note="Note Two">
    <authors author="Author Twenty"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub3"
           title="Unique Unpublished Title" note="Note Three">
    <authors author="Author Twenty-One"/>
    <authors author="Author Twenty-Two"/>
  </entries>

  <!-- Two PhDThesis entries with distinct titles -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2012"
           title="First PhD Thesis Title" school="School One">
    <authors author="Author Twenty-Three"/>
    <authors author="Author Twenty-Four"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd2" year="2013"
           title="Second PhD Thesis Title" school="School Two">
    <authors author="Author Twenty-Five"/>
  </entries>

  <!-- Three Booklet entries (untitled, dated) to exercise UntitledEntry rule -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1990"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet2" year="1991"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet3" year="1992"/>

  <!-- Two Misc entries (untitled, undated) to exercise UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Misc" id="misc2"/>

</BibTeX:BibTeXFile>