<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise Article_* rules, duplicated titles/journals -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model Transformations in Practice" journal="Journal of MDE Research">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- Same title, different journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Model Transformations in Practice" journal="Software Engineering Letters">
    <authors author="Carol White"/>
  </entries>
  <!-- Same journal as A1, different title -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Testing ATL Transformations" journal="Journal of MDE Research">
    <authors author="Dave Brown"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- Unique title and journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="OCL Constraints for Models" journal="International Journal of Modeling">
    <authors author="Eve Black"/>
  </entries>
  <!-- Same title and same journal as A4 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="OCL Constraints for Models" journal="International Journal of Modeling">
    <authors author="Frank Green"/>
    <authors author="Carol White"/>
  </entries>

  <!-- Booklets to exercise UntitledEntry and OCL5 -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="B2" year="2010"/>

  <!-- Misc to exercise UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Misc" id="M2"/>

  <!-- Unpublished entries to exercise TitledEntry_Title_NoArticle, titles partially duplicated -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Verified Model Transformations" note="to appear">
    <authors author="Alice Smith"/>
    <authors author="George King"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Automated Test Generation for MDE" note="under review">
    <authors author="Helen Clark"/>
  </entries>

  <!-- Manual to exercise TitledEntry_Title_NoArticle & OCL12 -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="ATL Language Reference"/>

  <!-- Proceedings with duplicate titles to exercise TitledEntry_NoTitle_* and OCL13 -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2015" title="Proceedings of the MDE Conference"/>
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2016" title="Proceedings of the MDE Conference"/>

  <!-- TechReport with unique title to exercise TitledEntry_Title_NoArticle & OCL11 -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2012" title="Scalability of Model Transformations">
    <authors author="Bob Johnson"/>
    <authors author="Ian Lee"/>
  </entries>

  <!-- Books and InBook/InCollection to exercise Book, InBook, InCollection and title-duplication logic -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="2008" title="Model-Driven Engineering Handbook" publisher="Springer MDE Series">
    <authors author="John Doe"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- Same title as BK1 to force TitledEntry_NoTitle_NoArticle for this one -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="2010" title="Model-Driven Engineering Handbook" publisher="TechPress">
    <authors author="Karen Miller"/>
  </entries>

  <!-- InBook with title equal to A3 to create cross-type title duplication and exercise InBook-specific fields -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2011" title="Testing ATL Transformations" publisher="MDE Books" chapter="7">
    <authors author="Laura Scott"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- InCollection with its own title -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2009" title="Case Studies in Model Transformations" publisher="Springer MDE Series" booktitle="Model-Driven Engineering Handbook">
    <authors author="Mike Adams"/>
    <authors author="John Doe"/>
  </entries>

  <!-- PhDThesis to exercise ThesisEntry, TitledEntry_Title_NoArticle & OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2013" title="Formal Verification of Model Transformations" school="University of Metamodeling">
    <authors author="Nina Perez"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- MasterThesis to exercise ThesisEntry; its OCL rule is commented in constraints but transformation still handles it -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2014" title="Empirical Evaluation of ATL Transformations" school="Institute of Software Engineering">
    <authors author="Oscar Reed"/>
    <authors author="Carol White"/>
  </entries>

</BibTeX:BibTeXFile>