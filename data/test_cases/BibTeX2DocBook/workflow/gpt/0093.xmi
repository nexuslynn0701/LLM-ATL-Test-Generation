<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles designed to exercise all four Article rules -->
  <!-- A1: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Article Title" journal="Unique Journal One">
    <authors author="Author Alpha"/>
    <authors author="Author Beta"/>
  </entries>
  <!-- A2 & A3: same title, different journals -->
  <!-- A2 chosen by distinct-title helper, A3 not; both journals unique -> A2: Article_Title_Journal, A3: Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title 1" journal="Journal X">
    <authors author="Author Gamma"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Title 1" journal="Journal Y">
    <authors author="Author Delta"/>
    <authors author="Author Alpha"/>
  </entries>
  <!-- A4 & A5: different titles, same journal -->
  <!-- A4 chosen by distinct-journal helper, A5 not; both titles unique -> A4: Article_Title_NoJournal, A5: Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Article In Journal Z - First" journal="Journal Z">
    <authors author="Author Epsilon"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Article In Journal Z - Second" journal="Journal Z">
    <authors author="Author Zeta"/>
    <authors author="Author Beta"/>
  </entries>

  <!-- Untitled entries: Booklet + Misc -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1990"/>
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- Titled non-article entries to exercise both titled-entry rules -->
  <!-- T1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="1995" title="Unique Book Title" publisher="Publisher One">
    <authors author="Author Theta"/>
    <authors author="Author Alpha"/>
  </entries>
  <!-- T2 & T3: same title "Duplicate Thesis Title" -->
  <!-- T2 chosen in distinct-title helper, T3 not -->
  <!-- T2: TitledEntry_Title_NoArticle, T3: TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="1999" title="Duplicate Thesis Title" school="Famous University">
    <authors author="Author Iota"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2000" title="Duplicate Thesis Title" school="Famous University">
    <authors author="Author Kappa"/>
    <authors author="Author Lambda"/>
  </entries>

  <!-- Additional titled non-article entries with unique titles (all via TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="1998" title="Chapter Based Book" publisher="Publisher Two" chapter="3">
    <authors author="Author Mu"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2002" title="Collected Work Title" publisher="Publisher Three" booktitle="Collection Proceedings 2002">
    <authors author="Author Nu"/>
    <authors author="Author Xi"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2007" title="Conference Paper Title" booktitle="Conference 2007">
    <authors author="Author Omicron"/>
    <authors author="Author Alpha"/>
  </entries>
  <!-- Two Proceedings with same title to exercise selection + non-selection on non-article side -->
  <!-- PR1 kept in distinct-title helper; PR2 filtered out -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2010" title="Repeated Proceedings Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2011" title="Repeated Proceedings Title"/>
  <!-- Single Manual with unique title -->
  <entries xsi:type="BibTeX:Manual" id="MN1" title="Tool User Manual"/>
  <!-- Single TechReport with unique title -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="1993" title="Technical Report on Systems">
    <authors author="Author Sigma"/>
    <authors author="Author Tau"/>
  </entries>

  <!-- Unpublished entries with distinct titles (only one per title kept in title-dedup set) -->
  <entries xsi:type="BibTeX:Unpublished" id="UN1" title="Early Draft Paper" note="To appear soon">
    <authors author="Author Alpha"/>
    <authors author="Author Rho"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="UN2" title="Working Notes on Experiments" note="Internal circulation">
    <authors author="Author Phi"/>
  </entries>
</BibTeX:BibTeXFile>