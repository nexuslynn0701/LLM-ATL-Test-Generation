<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles: set up combinations for all four article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Unique Title One" journal="Unique Journal One">
    <authors author="Alice Unique"/>
    <authors author="Bob Shared"/>
  </entries>
  <!-- A2 & A3: same title, different journals -->
  <!-- A2: chosen as representative for the title -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Shared Title Alpha" journal="Journal Alpha">
    <authors author="Carol Alpha"/>
    <authors author="Bob Shared"/>
  </entries>
  <!-- A3: same title as A2, so no-title; journal unique -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Shared Title Alpha" journal="Journal Beta">
    <authors author="Dave Beta"/>
  </entries>
  <!-- A4 & A5: same journal, different titles -->
  <!-- A4: representative for the journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Title Gamma One" journal="Journal Gamma">
    <authors author="Eve Gamma"/>
  </entries>
  <!-- A5: same journal, title unique -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Title Gamma Two" journal="Journal Gamma">
    <authors author="Frank Gamma"/>
    <authors author="Bob Shared"/>
  </entries>
  <!-- A6 & A7: same title and same journal -->
  <!-- A6: representative -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art6" year="2006" title="Duplicated Title Journal" journal="Duplicated Journal">
    <authors author="Grace Dup"/>
  </entries>
  <!-- A7: non-representative for both title and journal -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art7" year="2007" title="Duplicated Title Journal" journal="Duplicated Journal">
    <authors author="Heidi Dup"/>
    <authors author="Bob Shared"/>
  </entries>

  <!-- UntitledEntry rule: Misc and Booklet; Booklet has year but no title -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1999"/>

  <!-- TitledEntry rules (non-Article) with duplicate titles across types -->
  <!-- Two Books sharing same title: first goes to Title_NoArticle, second to NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" year="2010" title="Shared Book Title" publisher="Publisher One">
    <authors author="Ian Book"/>
    <authors author="Bob Shared"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book2" year="2011" title="Shared Book Title" publisher="Publisher Two">
    <authors author="Jack Book"/>
  </entries>

  <!-- Two InProceedings sharing same title -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2012" title="Repeated Proceedings Title" booktitle="Proc Book One">
    <authors author="Karen Proc"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" year="2013" title="Repeated Proceedings Title" booktitle="Proc Book Two">
    <authors author="Leo Proc"/>
    <authors author="Bob Shared"/>
  </entries>

  <!-- One TechReport with unique title -->
  <entries xsi:type="BibTeX:TechReport" id="tech1" year="2008" title="Unique TechReport Title">
    <authors author="Mallory Tech"/>
  </entries>

  <!-- One Manual with unique title -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="Standalone Manual Title"/>

  <!-- One Unpublished with unique title -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Unique Unpublished Title" note="Internal draft note">
    <authors author="Niaj Unpub"/>
    <authors author="Bob Shared"/>
  </entries>

  <!-- Thesis hierarchy: distinct titles for PhD and Master -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2015" title="PhD Thesis Title One" school="Graduate School One">
    <authors author="Oscar PhD"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="master1" year="2016" title="Master Thesis Title One" school="Graduate School Two">
    <authors author="Peggy Master"/>
    <authors author="Bob Shared"/>
  </entries>

  <!-- InBook and InCollection to exercise Book and BookTitledEntry paths -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2017" title="InBook Chapter Title" publisher="InBook Publisher" chapter="3">
    <authors author="Quinn InBook"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="incol1" year="2018" title="InCollection Title" publisher="Collection Publisher" booktitle="Collection Book Title">
    <authors author="Ruth Collection"/>
    <authors author="Bob Shared"/>
  </entries>

  <!-- Pure Proceedings (non-InProceedings) with distinct titles -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2020" title="Standalone Proceedings Title One"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2021" title="Standalone Proceedings Title Two"/>
</BibTeX:BibTeXFile>