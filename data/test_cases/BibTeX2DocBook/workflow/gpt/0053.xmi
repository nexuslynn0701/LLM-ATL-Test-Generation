<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles configured to hit different Article_* rules -->
  <!-- Unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Unique Title One" journal="Journal A">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>
  <!-- Same title as art2, unique journal -> Article_Title_Journal (title rep, journal unique) -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Shared Title AB" journal="Journal B">
    <authors author="Charlie Creator"/>
  </entries>
  <!-- Same title as art2, different journal already used once -> Article_NoTitle_Journal (duplicate title, journal unique) -->
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Shared Title AB" journal="Journal C">
    <authors author="Alice Author"/>
    <authors author="Diana Designer"/>
  </entries>
  <!-- Unique title, journal J-D that will be shared with art5 -> Article_Title_NoJournal (title unique, journal duplicate) -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Title JD1" journal="Journal D">
    <authors author="Evan Engineer"/>
  </entries>
  <!-- Different title, same journal J-D as art4 -> Article_NoTitle_NoJournal (title duplicate class-wise, journal duplicate) -->
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Title JD2" journal="Journal D">
    <authors author="Bob Writer"/>
    <authors author="Fay Framework"/>
  </entries>

  <!-- Untitled entries (Booklet + Misc) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1999"/>
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Titled non-Article entries with distinct titles -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="Manual Title X"/>
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2010" title="TechReport Title Y">
    <authors author="Gina Guru"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2015" title="Proceedings Title Z"/>
  <entries xsi:type="BibTeX:Book" id="book1" year="2000" title="Book Title U" publisher="Publisher P">
    <authors author="Helen Hacker"/>
    <authors author="Ian Integrator"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2008" title="InBook Title V" publisher="Publisher Q" chapter="3">
    <authors author="John Joiner"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="incol1" year="2012" title="InCollection Title W" publisher="Publisher R">
    <authors author="Karen Keeper"/>
    <authors author="Leo Leader"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Unpublished Title S" note="Note S">
    <authors author="Mike Maintainer"/>
    <authors author="Nina Network"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" year="2013" title="Master Thesis Title M" school="School M">
    <authors author="Oscar Operator"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2014" title="PhD Thesis Title P" school="School P">
    <authors author="Paul Professor"/>
    <authors author="Quinn Query"/>
  </entries>

  <!-- Pair of entries sharing the same title to trigger TitledEntry_NoTitle_NoArticle -->
  <!-- First with that title: goes to TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2011" title="Duplicated Title D">
    <authors author="Rita Reviewer"/>
  </entries>
  <!-- Second with same title: TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book2" year="2002" title="Duplicated Title D" publisher="Publisher S">
    <authors author="Sam Scribe"/>
  </entries>

  <!-- Another duplicated title pair among non-articles -->
  <entries xsi:type="BibTeX:Manual" id="manual2" title="Duplicated Manual Title">
    <authors author="Tom Tester"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2017" title="Duplicated Manual Title" booktitle="Conference C">
    <authors author="Uma User"/>
    <authors author="Vic Validator"/>
  </entries>
</BibTeX:BibTeXFile>