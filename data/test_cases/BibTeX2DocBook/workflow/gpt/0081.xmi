<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles: designed to exercise all four Article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model Transformation Testing" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>
  <!-- A2 & A3: duplicate title, same journal -> one Title_Journal, one NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Duplicate Title Case" journal="Cloned Journal">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Duplicate Title Case" journal="Cloned Journal">
    <authors author="David Black"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- A4 & A5: duplicate title, different journals -> one Title_Journal, one NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Shared Title Different Journals" journal="Journal One">
    <authors author="Emma Green"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Shared Title Different Journals" journal="Journal Two">
    <authors author="Frank Brown"/>
  </entries>
  <!-- A6 & A7: unique titles, same journal -> one Title_Journal, one Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="First in Common Journal" journal="Common Journal">
    <authors author="Grace Kelly"/>
    <authors author="Henry Ford"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Second in Common Journal" journal="Common Journal">
    <authors author="Ian Curtis"/>
  </entries>

  <!-- Manuals: unique and duplicate titles to hit Title rules -->
  <!-- M1: unique title Manual -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="Manual Unique Title 1"/>
  <!-- M2 & M3: duplicate title Manuals -->
  <entries xsi:type="BibTeX:Manual" id="M2" title="Repeated Manual Title"/>
  <entries xsi:type="BibTeX:Manual" id="M3" title="Repeated Manual Title"/>

  <!-- Books: include duplicate title with Article (A1) -->
  <!-- B1: shares title with A1, first occurrence for that title among titled entries -->
  <entries xsi:type="BibTeX:Book" id="B1" year="2010" title="Model Transformation Testing" publisher="MDE Press">
    <authors author="Alice Smith"/>
  </entries>
  <!-- B2: unique title Book -->
  <entries xsi:type="BibTeX:Book" id="B2" year="2011" title="Unique Book Title" publisher="Unique Publisher">
    <authors author="John Doe"/>
    <authors author="Jane Roe"/>
  </entries>

  <!-- InBook: unique title -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2012" title="InBook Unique Title" publisher="Chaptered Publisher" chapter="3">
    <authors author="Kevin Lee"/>
  </entries>

  <!-- InCollection: shares title with B2 (duplicate), so only one gets title paragraph -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2013" title="Unique Book Title" publisher="Collection Publisher">
    <authors author="Laura Hill"/>
  </entries>

  <!-- InProceedings: two with same title to trigger NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2014" title="Conference Paper Title" booktitle="Proc. MDEConf 2014">
    <authors author="Mike Clark"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2015" title="Conference Paper Title" booktitle="Proc. MDEConf 2015">
    <authors author="Nina Brown"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Proceedings: two sharing a title, one unique -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2016" title="MDE Symposium 2016"/>
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2017" title="MDE Symposium 2016"/>
  <entries xsi:type="BibTeX:Proceedings" id="P3" year="2018" title="Distinct Proceedings Title"/>

  <!-- TechReports: one unique, one sharing title with Article A4 -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2019" title="Tech Report Unique Title">
    <authors author="Olivia Stone"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2020" title="Shared Title Different Journals">
    <authors author="Peter Wright"/>
    <authors author="Emma Green"/>
  </entries>

  <!-- PhDThesis and MasterThesis -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2021" title="Thesis on Model Transformations" school="University of MDE">
    <authors author="Quentin Rice"/>
    <authors author="Rachel Adams"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2022" title="Thesis on Model Transformations" school="Tech Institute of MDE">
    <authors author="Sam Taylor"/>
  </entries>

  <!-- Unpublished: one unique title, one sharing title with TR1 -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Unpublished Unique Title" note="Draft version under review">
    <authors author="Tom Harris"/>
    <authors author="Uma King"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Tech Report Unique Title" note="Working paper note">
    <authors author="Victor Young"/>
  </entries>

  <!-- Booklets: untitled entries (DatedEntry but not TitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="BL2" year="2000"/>

  <!-- Misc entries: untitled, non-dated -->
  <entries xsi:type="BibTeX:Misc" id="MISC1"/>
  <entries xsi:type="BibTeX:Misc" id="MISC2"/>
</BibTeX:BibTeXFile>