<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise all four Article rules -->
  <!-- Unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a1" year="2001" title="Model Driven Testing Overview" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Duplicate title with a5, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="a2" year="2002" title="Transformation Testing Techniques" journal="Software Quality Letters">
    <authors author="Carol White"/>
  </entries>

  <!-- Unique title, duplicate journal with a4,a6 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a3" year="2003" title="Traceability in MDE" journal="International Journal of Software Metrics">
    <authors author="David Black"/>
    <authors author="Eve Brown"/>
  </entries>

  <!-- Unique title, duplicate journal with a3,a6 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a4" year="2004" title="Constraint-Based Testing" journal="International Journal of Software Metrics">
    <authors author="Frank Green"/>
  </entries>

  <!-- Duplicate title with a2, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="a5" year="2005" title="Transformation Testing Techniques" journal="Journal of Advanced Transformations">
    <authors author="Alice Smith"/>
    <authors author="Henry Gray"/>
  </entries>

  <!-- Duplicate title with a7, duplicate journal with a3,a4 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a6" year="2006" title="Coverage Criteria for Transformations" journal="International Journal of Software Metrics">
    <authors author="Ian Clark"/>
  </entries>

  <!-- Duplicate title with a6, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="a7" year="2007" title="Coverage Criteria for Transformations" journal="Empirical Software Transformation Journal">
    <authors author="Bob Jones"/>
    <authors author="Julia King"/>
  </entries>

  <!-- Titled, non-article entries to exercise TitledEntry_* rules -->

  <!-- Title appears once -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="b1" year="2010" title="Foundations of Model Transformations" publisher="Springer MDE Press">
    <authors author="Alice Smith"/>
    <authors author="Kevin Lee"/>
  </entries>

  <!-- Title appears once -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="b2" year="2011" title="Executable Metamodeling" publisher="TechBooks Publishing" chapter="3">
    <authors author="Laura Hill"/>
  </entries>

  <!-- Title appears once -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="b3" year="2012" title="Testing Transformation Chains" booktitle="Proceedings of MDE Testing" publisher="ACME Publishing">
    <authors author="Mike Davis"/>
    <authors author="Nina Rose"/>
  </entries>

  <!-- Title appears once -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="b4" year="2013" title="Search-Based Test Data Generation" booktitle="IEEE MDE Conference" >
    <authors author="Oscar Reed"/>
  </entries>

  <!-- Title appears once -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="b5" title="ATL User Guide 3.0"/>
  
  <!-- Title appears twice as Manual vs Book -> only first in title set, second in no-title rule -->
  <!-- First occurrence (by creation order) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="b6" title="OCL Standard Library Reference"/>
  <!-- Second occurrence with same title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="b7" year="2014" title="OCL Standard Library Reference" publisher="UML Consortium Press">
    <authors author="Peter Young"/>
  </entries>

  <!-- Proceedings with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="p1" year="2015" title="Model Transformation Symposium 2015"/>
  
  <!-- Proceedings duplicated title -> first in title set, second in no-title rule -->
  <!-- First occurrence -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="p2" year="2016" title="International Workshop on MDE Testing"/>
  <!-- Second occurrence -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="p3" year="2017" title="International Workshop on MDE Testing"/>

  <!-- TechReport unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="t1" year="2018" title="State of the Art in Transformation Testing">
    <authors author="Quentin Stone"/>
  </entries>

  <!-- Unpublished unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="u1" title="Draft Guidelines for Transformation Testing" note="Internal review version">
    <authors author="Rachel Adams"/>
    <authors author="Steve Turner"/>
  </entries>

  <!-- PhDThesis unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2019" title="Scalable Testing of Model Transformations" school="University of Metamodeling">
    <authors author="Tom Walker"/>
  </entries>

  <!-- MasterThesis unique title -> TitledEntry_Title_NoArticle (OCL7 commented but still transformation rule) -->
  <entries xsi:type="BibTeX:MasterThesis" id="msc1" year="2020" title="Mutation Analysis for ATL Transformations" school="Institute of Software Testing">
    <authors author="Uma Patel"/>
  </entries>

  <!-- Untitled entries (Booklet and Misc) for UntitledEntry rule -->

  <entries xsi:type="BibTeX:Booklet" id="bk1" year="2021"/>
  <entries xsi:type="BibTeX:Booklet" id="bk2" year="2022"/>
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Misc" id="m2"/>

