<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise Article_* rules and journals list -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A001" year="2001" title="Model-Driven Testing Approaches" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- A2: same title as A3, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A002" year="2002" title="Duplicate Titles in Transformation Testing" journal="Software Quality Letters">
    <authors author="Carol White"/>
  </entries>
  <!-- A3: same title as A2, different journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A003" year="2003" title="Duplicate Titles in Transformation Testing" journal="Empirical Software Engineering Reports">
    <authors author="David Brown"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- A4: unique title, same journal as A5 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A004" year="2004" title="Shared Journal First Article" journal="Simulation and Modelling Journal">
    <authors author="Eve Black"/>
  </entries>
  <!-- A5: different title, same journal as A4 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A005" year="2005" title="Shared Journal Second Article" journal="Simulation and Modelling Journal">
    <authors author="Frank Green"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Untitled entries (no title attribute) for UntitledEntry rule -->
  <!-- M1: Misc -->
  <entries xsi:type="BibTeX:Misc" id="M001"/>
  <!-- Bklt1-3: Booklet -->
  <entries xsi:type="BibTeX:Booklet" id="BKT001" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="BKT002" year="2000"/>
  <entries xsi:type="BibTeX:Booklet" id="BKT003" year="2001"/>

  <!-- Titled non-Article entries to exercise TitledEntry_Title_NoArticle / NoTitle variants -->
  <!-- Manual with unique title -->
  <entries xsi:type="BibTeX:Manual" id="MAN001" title="ATL Transformation User Manual"/>
  <!-- Manual sharing title with InBook, to drive TitledEntry_NoTitle_NoArticle on one of them -->
  <entries xsi:type="BibTeX:Manual" id="MAN002" title="Advanced Traceability Techniques"/>

  <!-- Book with unique title -->
  <entries xsi:type="BibTeX:Book" id="BK001" year="1998" title="Foundations of Model-Driven Engineering" publisher="Springer Verlag">
    <authors author="George King"/>
    <authors author="Helen Clark"/>
