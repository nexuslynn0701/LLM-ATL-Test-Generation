  <entries xsi:type="BibTeX:InBook" id="IB002" year="2004" title="Case Studies in Model Transformation" publisher="TechBooks Ltd" chapter="12">
    <authors author="Laura Scott"/>
  </entries>

  <!-- PhDThesis entries: one unique title, one sharing title with BK002 to create another duplicate set -->
