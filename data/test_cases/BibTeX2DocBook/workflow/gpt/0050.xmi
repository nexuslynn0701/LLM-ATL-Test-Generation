  <!-- Second Book with a different unique title -->
  <entries xsi:type="BibTeX:Book" id="BK002" year="2000" title="Testing Model Transformations" publisher="Academic Press">
    <authors author="Ian Gray"/>
  </entries>

  <!-- InBook entries: one shares title with MAN002 to create duplicate title scenario -->
  <entries xsi:type="BibTeX:InBook" id="IB001" year="2003" title="Advanced Traceability Techniques" publisher="TechBooks Ltd" chapter="7">
