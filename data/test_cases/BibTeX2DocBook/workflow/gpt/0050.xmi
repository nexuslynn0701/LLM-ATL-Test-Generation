    <authors author="Michael Adams"/>
  </entries>

  <!-- Proceedings: one unique title, one pair with duplicate title to mix Title_NoArticle / NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PROC001" year="2018" title="International Conference on Model Engineering"/>
  <entries xsi:type="BibTeX:Proceedings" id="PROC002" year="2019" title="Workshop on Transformation Testing"/>
