<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise all four article rules and journal/title uniqueness handling -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Article One" journal="Unique Journal One">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>
  <!-- A2 & A3: same title, different journals.
       - First in title-set: Article_Title_Journal
       - Second: Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title Article" journal="Journal Alpha">
    <authors author="Charlie Scribe"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Title Article" journal="Journal Beta">
    <authors author="Diana Researcher"/>
    <authors author="Alice Author"/>
  </entries>
  <!-- A4 & A5: same journal, different titles.
       - First in journal-set: Article_Title_Journal
       - Second: Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="First Journal Repeat" journal="Repeated Journal">
    <authors author="Eve Analyst"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Second Journal Repeat" journal="Repeated Journal">
    <authors author="Frank Scientist"/>
    <authors author="Bob Writer"/>
  </entries>
  <!-- A6 & A7: same title AND same journal.
       - First: Article_Title_Journal
       - Second: Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Twins Article" journal="Twin Journal">
    <authors author="Grace Developer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Twins Article" journal="Twin Journal">
    <authors author="Henry Engineer"/>
    <authors author="Grace Developer"/>
  </entries>

  <!-- Untitled entries -> UntitledEntry (Booklet + Misc) -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="B2" year="2010"/>
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Misc" id="M2"/>

  <!-- Titled non-article entries to hit both TitledEntry_Title_NoArticle and TitledEntry_NoTitle_NoArticle -->
  <!-- Unique title Book -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="1995" title="Unique Book Title" publisher="Publisher One">
    <authors author="Ian Architect"/>
    <authors author="Alice Author"/>
  </entries>
  <!-- Duplicate title Books: first in title-set triggers Title rule, second triggers NoTitle rule -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="1996" title="Duplicate Book Title" publisher="Publisher Two">
    <authors author="Jack Designer"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="BK3" year="1997" title="Duplicate Book Title" publisher="Publisher Three">
    <authors author="Kate Modeler"/>
    <authors author="Ian Architect"/>
  </entries>

  <!-- InBook with its own title (distinct) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="1998" title="InBook Chapter One" publisher="Publisher Four" chapter="3">
    <authors author="Laura Chapter"/>
  </entries>

  <!-- InCollection with duplicate title with a TechReport to create cross-type shared title -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2011" title="Cross Type Title" publisher="Publisher Five" booktitle="Collection One">
    <authors author="Mike Collector"/>
    <authors author="Nina Curator"/>
  </entries>

  <!-- Proceedings: one unique title, one sharing title with a Manual -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2012" title="Proceedings Unique Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2013" title="Manual Shared Title"/>

  <!-- Manual: one unique, one sharing title with PR2 -->
  <entries xsi:type="BibTeX:Manual" id="MN1" title="Standalone Manual Title"/>
  <entries xsi:type="BibTeX:Manual" id="MN2" title="Manual Shared Title"/>

  <!-- TechReports: TR1 unique title, TR2 shares title with IC1 ("Cross Type Title") -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2014" title="TechReport Solo Title">
    <authors author="Oscar Reporter"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2015" title="Cross Type Title">
    <authors author="Nina Curator"/>
    <authors author="Paul Analyst"/>
  </entries>

  <!-- Unpublished entries: one unique title, one sharing with a PhDThesis -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Unpublished Unique Title" note="Note for unique unpublished">
    <authors author="Quentin Theorist"/>
    <authors author="Rachel Practitioner"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Thesis Shared Title" note="Note for shared-title unpublished">
    <authors author="Steve Reviewer"/>
  </entries>

  <!-- PhDThesis: one unique, one sharing title with U2 -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2016" title="Unique PhD Thesis" school="Tech University">
    <authors author="Tom Doctoral"/>
    <authors author="Uma Mentor"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PHD2" year="2017" title="Thesis Shared Title" school="Science Institute">
    <authors author="Victor Student"/>
    <authors author="Steve Reviewer"/>
  </entries>

  <!-- MasterThesis with its own title (no explicit OCL, but exercises rule) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MS1" year="2018" title="Master Thesis Exclusive" school="Engineering School">
    <authors author="Wendy Graduate"/>
  </entries>

  <!-- InProceedings entries: one unique title, one sharing with a Book to create another cross-type shared title -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2019" title="Conference Paper One" booktitle="Conference Book One">
    <authors author="Xavier Presenter"/>
    <authors author="Yara Coauthor"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2020" title="Duplicate Book Title" booktitle="Conference Book Two">
    <authors author="Zack Speaker"/>
  </entries>
</BibTeX:BibTeXFile>