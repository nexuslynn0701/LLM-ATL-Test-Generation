<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: designed to exercise all 4 Article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model Transformation Testing" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A2 & A3: same title, different journals
       -> one in title-set + journal-set (Article_Title_Journal)
       -> one not in title-set but in journal-set (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Duplicate Title Study" journal="Software Quality Letters">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Duplicate Title Study" journal="Empirical Software Journal">
    <authors author="Dave Brown"/>
  </entries>

  <!-- A4 & A5: same journal, different titles
       -> one in title-set + journal-set (Article_Title_Journal)
       -> one in title-set but not in journal-set (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Traceability in MDE" journal="Journal of Experimental Results">
    <authors author="Alice Smith"/>
    <authors author="Eve Black"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Mutation Analysis for ATL" journal="Journal of Experimental Results">
    <authors author="Frank Green"/>
  </entries>

  <!-- A6 & A7: same title AND same journal
       -> one in title-set + journal-set (Article_Title_Journal)
       -> one not in title-set and not in journal-set (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Cloned Article" journal="Testing Times">
    <authors author="Grace Lee"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Cloned Article" journal="Testing Times">
    <authors author="Helen King"/>
  </entries>

  <!-- TechReports: for TitledEntry rules -->
  <!-- TR1: title appears only once -> TitledEntry_Title_NoArticle, also distinct title -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="TechReport Unique Title" >
    <authors author="Ian Gray"/>
  </entries>

  <!-- TR2 & TR3: same title
       -> TR2 in title-set (TitledEntry_Title_NoArticle)
       -> TR3 NOT in title-set (TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2011" title="Repeated TechReport Title">
    <authors author="Jack Hill"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR3" year="2012" title="Repeated TechReport Title">
    <authors author="Kate Moore"/>
  </entries>

  <!-- Manual entries: titled but not authored/dated, also exercise duplicates on title -->
  <!-- M1: unique manual title -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="Manual for Transformation Tool"/>
  <!-- M2 & M3: same title
       -> M2 in title-set, M3 not in title-set, both via TitledEntry rules -->
  <entries xsi:type="BibTeX:Manual" id="M2" title="Installation Guide"/>
  <entries xsi:type="BibTeX:Manual" id="M3" title="Installation Guide"/>

  <!-- Proceedings: base Proceedings and duplicate title -->
  <!-- P1: unique title, exercises Proceedings as TitledEntry -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2015" title="Proceedings of MDE 2015"/>
  <!-- P2 & P3: same title -->
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2016" title="Proceedings of Testing 2016"/>
  <entries xsi:type="BibTeX:Proceedings" id="P3" year="2017" title="Proceedings of Testing 2016"/>

  <!-- Booklets: untitled dated entries -> UntitledEntry rule -->
  <entries xsi:type="BibTeX:Booklet" id="Blet1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="Blet2" year="2000"/>

  <!-- Misc: untitled, no other properties -> UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc" id="Misc1"/>
  <entries xsi:type="BibTeX:Misc" id="Misc2"/>

  <!-- Books, InBook, InCollection, InProceedings, Thesis, Unpublished:
       all exercise TitledEntry rules, AuthoredEntry, DatedEntry, BookTitledEntry, ThesisEntry, etc. -->

  <!-- Book with distinct title -->
  <entries xsi:type="BibTeX:Book" id="Book1" year="2008" title="Foundations of Model-Driven Engineering" publisher="MDESoft Press">
    <authors author="Alice Smith"/>
    <authors author="Laura Scott"/>
  </entries>

  <!-- Book2 & InBook1 share same title to create duplicates across subclasses -->
  <entries xsi:type="BibTeX:Book" id="Book2" year="2009" title="Shared Book Title" publisher="Global Publishers">
    <authors author="Mike Turner"/>
  </entries>

  <!-- InBook: child of Book with chapter -->
  <entries xsi:type="BibTeX:InBook" id="InBook1" year="2010" title="Shared Book Title" publisher="Global Publishers" chapter="3">
    <authors author="Nina Adams"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- InCollection: child of Book, also BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2011" title="Patterns in Transformations" publisher="Pattern House" booktitle="Handbook of MDE Patterns">
    <authors author="Oscar Perez"/>
    <authors author="Carol White"/>
  </entries>

  <!-- InProceedings: child of Proceedings and AuthoredEntry and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2012" title="Evaluating Model Transformations" booktitle="Proceedings of MDE 2012">
    <authors author="Peter Quinn"/>
    <authors author="Dave Brown"/>
  </entries>

  <!-- Unpublished entries, with distinct and duplicate titles -->
  <!-- U1: unique title -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Draft on Transformation Coverage" note="Submitted to journal">
    <authors author="Grace Lee"/>
    <authors author="Ian Gray"/>
  </entries>

  <!-- U2 & U3: same title; U2 in titled-set, U3 not -->
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Unpublished Experiment Report" note="Internal use only">
    <authors author="Helen King"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U3" title="Unpublished Experiment Report" note="Second revision">
    <authors author="Laura Scott"/>
    <authors author="Mike Turner"/>
  </entries>

  <!-- PhDThesis and MasterThesis (both ThesisEntry subclasses) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2013" title="PhD on ATL Transformations" school="University of Testing">
    <authors author="Quentin Reed"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MSC1" year="2014" title="Master Thesis on Model Validation" school="Institute of Modeling">
    <authors author="Rachel Young"/>
    <authors author="Steve Clark"/>
  </entries>

</BibTeX:BibTeXFile>