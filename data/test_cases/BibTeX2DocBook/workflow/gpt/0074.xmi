<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles: four different patterns for title/journal uniqueness -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model Transformations in Practice" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- A2: shares title with A3, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Testing ATL Transformations" journal="Software Testing Journal">
    <authors author="Carol White"/>
  </entries>
  <!-- A3: shares title with A2, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Testing ATL Transformations" journal="Journal of Empirical Software Engineering">
    <authors author="Daniel Green"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- A4: unique title, shares journal with A5 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Metamodel Evolution Case Study" journal="International Journal of MDE">
    <authors author="Eve Black"/>
  </entries>
  <!-- A5: different title, same journal as A4 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Incremental Model Synchronization" journal="International Journal of MDE">
    <authors author="Frank Brown"/>
    <authors author="George King"/>
  </entries>

  <!-- Unpublished entries: one title used twice to trigger Title_NoTitle_NoArticle + NoTitle_NoArticle -->
  <!-- U1: first with title T1 -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Early Results on ATL Testing" note="draft version">
    <authors author="Helen Clark"/>
    <authors author="Ian Gray"/>
  </entries>
  <!-- U2: same title T1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Early Results on ATL Testing" note="extended abstract">
    <authors author="Jack Lee"/>
  </entries>
  <!-- U3: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U3" title="Survey of Model Transformation Languages" note="internal report">
    <authors author="Alice Smith"/>
    <authors author="Karen Adams"/>
  </entries>

  <!-- TechReport: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="Coverage Criteria for Model Transformations">
    <authors author="Laura Hill"/>
  </entries>

  <!-- Manual: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="ATL User Guide 3.0"/>

  <!-- Proceedings: P1 and P2 share title to trigger Title_NoTitle_NoArticle + NoTitle_NoArticle -->
  <!-- P1: first with title T2 -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2012" title="Proceedings of the MDE Conference"/>
  <!-- P2: same title T2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2013" title="Proceedings of the MDE Conference"/>

  <!-- Booklet: untitled dated entries -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="Bkt1" year="2015"/>
  <entries xsi:type="BibTeX:Booklet" id="Bkt2" year="2016"/>

  <!-- Misc: pure untitled, undated entries -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="Misc1"/>
  <entries xsi:type="BibTeX:Misc" id="Misc2"/>

  <!-- Book / InBook / InCollection / InProceedings to hit various combinations -->
  <!-- Book1: unique title T3 -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="Bk1" year="2008" title="Foundations of Model-Driven Engineering" publisher="Springer">
    <authors author="Michael Rose"/>
    <authors author="Nancy Young"/>
  </entries>
  <!-- Book2: shares title with InBook1 to exercise same-title across different subclasses -->
  <!-- First occurrence with title T4 from Bk2 -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="Bk2" year="2009" title="Practical ATL Transformation Patterns" publisher="TechPress">
    <authors author="Oliver Stone"/>
  </entries>
  <!-- InBook1: same title T4 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2011" title="Practical ATL Transformation Patterns" publisher="TechPress" chapter="7">
    <authors author="Peter West"/>
    <authors author="Quentin Fox"/>
  </entries>
  <!-- InCollection: unique title T5 -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2014" title="Testing Bidirectional Transformations" publisher="Academic Press" booktitle="Advances in Model Transformations">
    <authors author="Rachel Green"/>
  </entries>
  <!-- InProceedings: unique title T6 -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2018" title="Debugging ATL Transformations" booktitle="ICMT 2018">
    <authors author="Sam Turner"/>
    <authors author="Uma Patel"/>
  </entries>

  <!-- PhDThesis and MasterThesis: distinct titles -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PhD1" year="2007" title="Formal Semantics of ATL" school="University of Metamodeling">
    <authors author="Victor Knight"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MSc1" year="2019" title="Tool Support for Model Transformation Testing" school="Institute of Software Testing">
    <authors author="Wendy Scott"/>
  </entries>
</BibTeX:BibTeXFile>