<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: designed to exercise all 4 Article rules via shared titles/journals -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Model Transformations in Practice" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A2 + A3: same title, different journals -->
  <!-- A2: first with title T1 -> Article_Title_Journal (title unique, journal unique) -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Testing Model Transformations" journal="Software Quality Journal">
    <authors author="Carol White"/>
    <authors author="David Brown"/>
  </entries>
  <!-- A3: same title as A2, different journal -> Article_NoTitle_Journal (no title para, journal unique) -->
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Testing Model Transformations" journal="Empirical Software Engineering">
    <authors author="Eve Black"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- A4 + A5: different titles, same journal -->
  <!-- A4: first with journal J2 -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Analysis of ATL Transformations" journal="International Journal of MDE">
    <authors author="Grace Hall"/>
  </entries>
  <!-- A5: same journal as A4, different title -> Article_Title_NoJournal (title unique, journal non-unique) -->
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Coverage Criteria for Model Transformations" journal="International Journal of MDE">
    <authors author="Henry King"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- A6 + A7: same title AND same journal -->
  <!-- A6: first with title T3 and journal J3 -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art6" year="2006" title="Mutation Testing for ATL" journal="Journal of Model Engineering">
    <authors author="Ian Lee"/>
  </entries>
  <!-- A7: duplicate title/journal -> Article_NoTitle_NoJournal (no title or journal paras) -->
  <entries xsi:type="BibTeX:Article" id="art7" year="2007" title="Mutation Testing for ATL" journal="Journal of Model Engineering">
    <authors author="Jane Moore"/>
    <authors author="David Brown"/>
  </entries>

  <!-- Manual: TitledEntry without authors/year -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL User Guide"/>

  <!-- Manual pair with shared title: first triggers Title rule, second NoTitle rule -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="EMF Reference Manual"/>
  <entries xsi:type="BibTeX:Manual" id="man3" title="EMF Reference Manual"/>

  <!-- Book: authored, dated, titled -->
  <entries xsi:type="BibTeX:Book" id="book1" year="2010" title="Model-Driven Engineering Fundamentals" publisher="TechBooks Publishing">
    <authors author="Alice Smith"/>
    <authors author="Kevin Clark"/>
  </entries>

  <!-- Book pair with same title, different publisher: first Title rule, second NoTitle rule -->
  <entries xsi:type="BibTeX:Book" id="book2" year="2011" title="Advanced ATL Techniques" publisher="Springer MDE">
    <authors author="Laura Scott"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book3" year="2012" title="Advanced ATL Techniques" publisher="Elsevier Software">
    <authors author="Michael Adams"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- InBook: child of Book, adds chapter -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2013" title="Verification of Model Transformations" publisher="TechBooks Publishing" chapter="3">
    <authors author="Nina Perez"/>
    <authors author="Ian Lee"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection" id="incol1" year="2014" title="Traceability in MDE" publisher="Conference Publishing House" booktitle="Proceedings of the MDE Symposium">
    <authors author="Oscar Reed"/>
    <authors author="Carol White"/>
  </entries>

  <!-- InProceedings pair with shared title: first Title rule, second NoTitle rule -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2015" title="Testing Model Transformations" booktitle="Proceedings of the Testing Conference">
    <authors author="Paul Young"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" year="2016" title="Testing Model Transformations" booktitle="Proceedings of the Verification Workshop">
    <authors author="Grace Hall"/>
    <authors author="Henry King"/>
  </entries>

  <!-- Proceedings pair with shared title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2017" title="International Conference on MDE"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2018" title="International Conference on MDE"/>

  <!-- TechReport: authored, dated, titled -->
  <entries xsi:type="BibTeX:TechReport" id="tech1" year="2019" title="Report on Model Transformation Benchmarks">
    <authors author="Kevin Clark"/>
    <authors author="Laura Scott"/>
  </entries>

  <!-- TechReport with same title to trigger NoTitle rule -->
  <entries xsi:type="BibTeX:TechReport" id="tech2" year="2020" title="Report on Model Transformation Benchmarks">
    <authors author="Michael Adams"/>
  </entries>

  <!-- Unpublished: titled, authored, note -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Specification of a Transformation Language" note="Under submission">
    <authors author="Nina Perez"/>
    <authors author="Oscar Reed"/>
  </entries>

  <!-- Unpublished pair with shared title -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Draft Guidelines for MDE" note="Internal review">
    <authors author="Paul Young"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub3" title="Draft Guidelines for MDE" note="Revised version">
    <authors author="Jane Moore"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- PhDThesis pair with shared title -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2021" title="Scalable Model Transformation Testing" school="University of Metropolis">
    <authors author="David Brown"/>
    <authors author="Eve Black"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd2" year="2022" title="Scalable Model Transformation Testing" school="Institute of Software Technology">
    <authors author="Frank Green"/>
  </entries>

  <!-- MasterThesis pair with shared title -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="2018" title="Empirical Studies of ATL" school="City University">
    <authors author="Henry King"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mst2" year="2019" title="Empirical Studies of ATL" school="Tech University">
    <authors author="Grace Hall"/>
    <authors author="Kevin Clark"/>
  </entries>

  <!-- Booklet: untitled entry with year only -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2000"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet2" year="2005"/>

  <!-- Misc entries: pure untitled, unauthored -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Misc" id="misc2"/>

</BibTeX:BibTeXFile>