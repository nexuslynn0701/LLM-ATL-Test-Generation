<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles: exercise all four Article rules (R6–R9) plus R1, R2 -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model Checking for Embedded Systems" journal="Journal of Embedded Systems">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- A2 & A3: same title, different journals -> one Article_NoTitle_Journal, one Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Runtime Verification Techniques" journal="Software Engineering Letters">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Runtime Verification Techniques" journal="Journal of Software Testing">
    <authors author="David Brown"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- A4 & A5: different titles, same journal -> one Article_Title_NoJournal, one Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Domain-Specific Modeling Tools" journal="International Journal of Modeling">
    <authors author="Eve Black"/>
    <authors author="Frank Green"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Executable UML Approaches" journal="International Journal of Modeling">
    <authors author="Grace Hall"/>
  </entries>

  <!-- Untitled entries: Booklet and Misc -> UntitledEntry (R3) -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1999"/>
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- Titled, non-Article entries: exercise R4 and R5 with duplicates -->
  <!-- Unique titles (in titledEntrySet) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MN1" title="ATL User Guide"/>
  <entries xsi:type="BibTeX:Book" id="BK1" year="2010" title="Model-Driven Architecture in Practice" publisher="TechPress">
    <authors author="Alice Smith"/>
    <authors author="Ian Clark"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2012" title="Proceedings of MDE Symposium" />
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2011" title="Transformations in Practice" publisher="TechPress" chapter="7">
    <authors author="John King"/>
    <authors author="Laura Scott"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2008" title="State of Practice in Model Transformations">
    <authors author="Mike Lee"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Survey on Model-Driven Testing" note="submitted for publication">
    <authors author="Nancy Young"/>
    <authors author="Oscar Reed"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2013" title="Scalable Model Transformation Engines" school="University of Metropolis">
    <authors author="Peter Adams"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2014" title="Testing of ATL Transformations" school="Tech University">
    <authors author="Quinn Baker"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2015" title="Incremental Model Synchronization" booktitle="Proceedings of MDE Symposium">
    <authors author="Rachel Carter"/>
    <authors author="Steve Davis"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2016" title="Industrial Applications of MDE" booktitle="Handbook of Software Engineering" publisher="GlobalScience">
    <authors author="Tom Evans"/>
  </entries>

  <!-- Duplicate-title group 1: "Reusable Model Transformations" -->
  <!-- First occurrence will be in titledEntrySet (R4), second will not (R5) -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="2011" title="Reusable Model Transformations" publisher="TechPress">
    <authors author="Uma Fisher"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="IB2" year="2012" title="Reusable Model Transformations" publisher="TechPress" chapter="3">
    <authors author="Victor Gray"/>
  </entries>

  <!-- Duplicate-title group 2: "Foundations of Model-Driven Engineering" -->
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2010" title="Foundations of Model-Driven Engineering"/>
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2009" title="Foundations of Model-Driven Engineering">
    <authors author="Wendy Hill"/>
    <authors author="Xavier Irvine"/>
  </entries>

  <!-- Duplicate-title group 3: "Advanced Topics in Model Transformation" -->
  <entries xsi:type="BibTeX:Manual" id="MN2" title="Advanced Topics in Model Transformation"/>
  <entries xsi:type="BibTeX:Unpublished" id="UP2" title="Advanced Topics in Model Transformation" note="draft version">
