  <!-- ARTICLE GROUP 1: two articles with same title, different journals -->
  <entries xsi:type="BibTeX:Article" id="e18_art_sameTitle_j1" year="2010" title="Optimizing ATL Transformations" journal="International Journal of Model Transformation">
