  <entries xsi:type="BibTeX:Booklet" id="e04_booklet_2015" year="2015"/>

  <!-- Manual (titled, no authors, no year) -->
  <entries xsi:type="BibTeX:Manual" id="e05_manual_tool" title="User Guide for Transformation Tool"/>

  <!-- Proceedings pair with same title, different years (to exercise Proceedings + duplicated title handling) -->
  <entries xsi:type="BibTeX:Proceedings" id="e06_proc_2010" year="2010" title="International Conference on Model Transformations"/>
  <entries xsi:type="BibTeX:Proceedings" id="e07_proc_2012" year="2012" title="International Conference on Model Transformations"/>

  <!-- Book with unique title and repeated author -->
  <entries xsi:type="BibTeX:Book" id="e08_book_unique" year="2005" title="Foundations of Model-Driven Engineering" publisher="TechPress">
    <authors author="Alice Modeler"/>
    <authors author="Bob Engineer"/>
    <authors author="Alice Modeler"/>
  </entries>

  <!-- Book with a title that will be shared with an InBook -->
  <entries xsi:type="BibTeX:Book" id="e09_book_shared" year="2008" title="Advanced Topics in Metamodeling" publisher="MetaPub">
    <authors author="Carol Architect"/>
    <authors author="Dave Designer"/>
  </entries>

  <!-- InBook sharing the same title (to trigger TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:InBook" id="e10_inbook_shared" year="2010" title="Advanced Topics in Metamodeling" publisher="MetaPub" chapter="3">
    <authors author="Eve Analyst"/>
  </entries>

  <!-- InCollection, unique title -->
  <entries xsi:type="BibTeX:InCollection" id="e11_incoll_unique" year="2011" title="Reusable Transformation Patterns" publisher="PatternsHouse">
    <authors author="Frank Developer"/>
    <authors author="Bob Engineer"/>
  </entries>

  <!-- MasterThesis with a title duplicated by a PhDThesis -->
  <entries xsi:type="BibTeX:MasterThesis" id="e12_mthesis_dup" year="2013" title="Scalable Model Transformations" school="University of Models">
    <authors author="Grace Student"/>
    <authors author="Heidi Researcher"/>
  </entries>

  <!-- PhDThesis sharing the same title (to trigger TitledEntry_NoTitle_NoArticle for one of them) -->
  <entries xsi:type="BibTeX:PhDThesis" id="e13_phd_dup" year="2016" title="Scalable Model Transformations" school="Institute of Engineering">
    <authors author="Ivan Doctor"/>
