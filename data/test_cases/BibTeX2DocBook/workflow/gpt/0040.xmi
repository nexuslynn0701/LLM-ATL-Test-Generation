<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles designed to exercise all four Article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Insights into MDE" journal="Journal of Exclusive Studies">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- A2 & A3: same title, different journals -> one Title_Journal, one NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title Different Journals" journal="Journal Alpha">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Title Different Journals" journal="Journal Beta">
    <authors author="Dave Brown"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- A4 & A5: different titles, same journal -> one Title_NoJournal, one NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="First Title in Common Journal" journal="Common Journal of Software">
    <authors author="Eve Davis"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Second Title in Common Journal" journal="Common Journal of Software">
    <authors author="Frank Miller"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Untitled entries (Misc + Booklet) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1990"/>

  <!-- Titled non-article entries -->
  <!-- Manual -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MN1" title="Manual of Model Transformations"/>

  <!-- TechReport duplicated title with article A4 to force NoTitle rule for TechReport -->
  <!-- Title not the first with that string, so -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="First Title in Common Journal">
    <authors author="Grace Lee"/>
  </entries>

  <!-- Book with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="1995" title="Foundations of Model-Driven Engineering" publisher="MDE Press">
    <authors author="Henry King"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- InBook sharing title with BK1 -> NoTitle_NoArticle for InBook -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="1996" title="Foundations of Model-Driven Engineering" publisher="Advanced MDE Press" chapter="7">
    <authors author="Irene Novak"/>
  </entries>

  <!-- Proceedings with duplicate title to trigger both Title and NoTitle flavours -->
  <!-- PR1: first occurrence -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2015" title="Proceedings of the MDE Conference"/>
  <!-- PR2: second with same title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2016" title="Proceedings of the MDE Conference"/>

  <!-- InProceedings with unique title and booktitle -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2018" title="Model Transformations in Practice" booktitle="Proceedings of the Practical MDE Workshop">
    <authors author="John Oliver"/>
    <authors author="Carol White"/>
  </entries>

  <!-- InCollection shares title with IP1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2019" title="Model Transformations in Practice" booktitle="Collected Works on MDE" publisher="Collections Publishing">
    <authors author="Karen Perez"/>
  </entries>

  <!-- PhDThesis and MasterThesis with unique titles -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2012" title="Advanced Topics in Model Transformations" school="University of Modeling">
    <authors author="Laura Quinn"/>
    <authors author="Frank Miller"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MS1" year="2013" title="Introduction to Model-Driven Testing" school="Institute of Software">
    <authors author="Mike Ross"/>
  </entries>

  <!-- Unpublished entries: one unique title, one duplicated title to force NoTitle_NoArticle for second -->
  <!-- U1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Early Draft on Model Testing" note="To appear in MDE Journal">
    <authors author="Nina Scott"/>
    <authors author="Grace Lee"/>
  </entries>
  <!-- U2: shares title with BK1/IB1 to exercise additional share; still falls under NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Foundations of Model-Driven Engineering" note="Internal report">
    <authors author="Oscar Trent"/>
  </entries>
</BibTeX:BibTeXFile>