<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: designed to exercise Article_* variants and journal/title dedup -->
  <!-- A1: unique title, unique journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2010" title="Model Transformations in Practice" journal="Journal of Model Engineering">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- A2: same title as A3, unique journal for that title pair -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2011" title="Testing ATL Transformations" journal="Software Testing Journal">
    <authors author="Charlie Gamma"/>
    <authors author="Dave Delta"/>
  </entries>

  <!-- A3: same title as A2, same journal as A5 (journal repeated) -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2012" title="Testing ATL Transformations" journal="Experimental Software Letters">
    <authors author="Alice Alpha"/>
  </entries>

  <!-- A4: unique title, journal duplicated with A6 (same journal, different title) -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2013" title="Bidirectional Model Synchronization" journal="Journal of Model Engineering">
    <authors author="Eve Epsilon"/>
    <authors author="Frank Phi"/>
  </entries>

  <!-- A5: unique title, journal duplicated with A3 (same journal, different title) -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2014" title="Mutation Analysis for Transformations" journal="Experimental Software Letters">
    <authors author="Grace Gamma"/>
  </entries>

  <!-- A6: title duplicated with B3 (non-Article), journal duplicated with A4 -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2015" title="Model-Driven Engineering Overview" journal="Journal of Model Engineering">
    <authors author="Henry Eta"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- Non-article titled entries -->

  <!-- B1: Book with unique title -->
  <entries xsi:type="BibTeX:Book" id="B1" year="2005" title="Foundations of Model-Driven Architecture" publisher="Springfield Publishing">
    <authors author="Alice Alpha"/>
    <authors author="Ian Iota"/>
  </entries>

  <!-- B2: Book with same title as T1 (PhDThesis) to trigger duplicate-title path -->
  <entries xsi:type="BibTeX:Book" id="B2" year="2006" title="Verification of Model Transformations" publisher="Metro Books">
    <authors author="Jack Jota"/>
  </entries>

  <!-- B3: Book sharing title with A6 (Article) but still a TitledEntry -->
  <entries xsi:type="BibTeX:Book" id="B3" year="2007" title="Model-Driven Engineering Overview" publisher="TechPress">
    <authors author="Kelly Kappa"/>
    <authors author="Laura Lambda"/>
  </entries>

  <!-- IB1: InBook with distinct title -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2008" title="Model Query Techniques" publisher="Graphline House" chapter="3">
    <authors author="Mike Mu"/>
    <authors author="Nina Nu"/>
  </entries>

  <!-- IC1: InCollection with unique title -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2009" title="Scalability of Model Repositories" publisher="Clustered Press" booktitle="Proceedings of the MDE Workshop">
    <authors author="Oscar Omicron"/>
  </entries>

  <!-- IP1: InProceedings with unique title -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2016" title="Incremental Transformation Testing" booktitle="ICMT 2016">
    <authors author="Peggy Pi"/>
    <authors author="Quentin Qoppa"/>
  </entries>

  <!-- P1 & P2: Proceedings with same title to exercise title-duplicate handling -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2017" title="International Conference on Model Transformation"/>
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2018" title="International Conference on Model Transformation"/>

  <!-- M1 & M2: Manuals with distinct titles -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="User Guide for MDE Toolkit"/>
  <entries xsi:type="BibTeX:Manual" id="M2" title="ATL Transformation Reference Manual"/>

  <!-- U1 & U2: Unpublished, with U2 sharing title with A2/A3 (extra title duplicate) -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Industrial Experiences with ATL" note="Draft version">
    <authors author="Rachel Rho"/>
    <authors author="Steve Sigma"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Testing ATL Transformations" note="Extended abstract">
    <authors author="Tina Tau"/>
  </entries>

  <!-- TechReport -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2003" title="Static Analysis of Transformations">
    <authors author="Uma Upsilon"/>
    <authors author="Victor Vee"/>
  </entries>

  <!-- Theses: one MasterThesis (not referenced in OCL but used by ATL), one PhDThesis (OCL) -->

  <!-- MT1: MasterThesis with unique title -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2001" title="Tool Support for Model Refactoring" school="City University">
    <authors author="Wendy Omega"/>
  </entries>

  <!-- T1: PhDThesis sharing title with B2 (Book) -->
  <entries xsi:type="BibTeX:PhDThesis" id="T1" year="2002" title="Verification of Model Transformations" school="State Technical University">
    <authors author="Xavier Xi"/>
    <authors author="Yvonne Psi"/>
  </entries>

  <!-- Untitled entries (no title attribute): Booklet and Misc -->

