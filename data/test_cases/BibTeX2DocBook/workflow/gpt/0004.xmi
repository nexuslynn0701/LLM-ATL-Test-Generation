<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles for all four article rules (distinct/same titles and journals) -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="MDE Foundations" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Brown"/>
  </entries>

  <!-- A2: duplicate title with A1, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="MDE Foundations" journal="Transactions on Software Design">
    <authors author="Carol White"/>
  </entries>

  <!-- A3: unique title, journal shared with A4 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Transformations in Practice" journal="Journal of Metamodeling">
    <authors author="David Green"/>
    <authors author="Eve Black"/>
  </entries>

  <!-- A4: duplicate title with A5, journal shared with A3 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Advanced Model Testing" journal="Journal of Metamodeling">
    <authors author="Frank Gray"/>
  </entries>

  <!-- A5: duplicate title with A4, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Advanced Model Testing" journal="International Journal of MDE">
    <authors author="Grace Blue"/>
    <authors author="Bob Brown"/>
  </entries>

  <!-- Booklets (UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="B2" year="2000"/>

  <!-- Misc (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Misc" id="M2"/>

  <!-- Manuals (TitledEntry, no authors, no date) -->
  <!-- Unique manual title -> TitledEntry_Title_NoArticle (+ title para) -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="ATL Reference Guide"/>
  <!-- Duplicate manual title -> TitledEntry_NoTitle_NoArticle (no title para) -->
  <entries xsi:type="BibTeX:Manual" id="MAN2" title="ATL Reference Guide"/>

  <!-- TechReports (Authored, Dated, Titled) -->
  <!-- Unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="Model Transformation Testing Techniques">
    <authors author="Alice Smith"/>
    <authors author="Henry Orange"/>
  </entries>
  <!-- Duplicate TechReport title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2011" title="Model Transformation Testing Techniques">
    <authors author="Ian Violet"/>
  </entries>

  <!-- Books, InBook, InCollection to exercise Book/BookTitledEntry paths -->
  <!-- Book with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="2007" title="Introduction to DSLs" publisher="Springer MDE Series">
    <authors author="Carol White"/>
    <authors author="John Silver"/>
  </entries>

  <!-- Book with title duplicated by InBook (same title, different type) -->
  <!-- Still in titledEntrySet once (some instance chosen); others use NoTitle rule -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="2008" title="Patterns of Model Transformations" publisher="TechPress">
    <authors author="Kevin Amber"/>
  </entries>

  <!-- InBook shares title with BK2 -> one of them will be in titledEntrySet -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2009" title="Patterns of Model Transformations" publisher="TechPress" chapter="3">
    <authors author="Laura Cyan"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- InCollection: own title, with booktitle/publisher -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2012" title="Case Studies in MDE" booktitle="Proceedings of the MDE Symposium" publisher="ACM Press">
    <authors author="Mike Yellow"/>
  </entries>

  <!-- Proceedings (Dated,Titled, not Authored) -->
  <!-- Unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2013" title="MDE Conference 2013"/>
  <!-- Duplicate title with PR1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2014" title="MDE Conference 2013"/>

  <!-- InProceedings (Authored, Dated, Titled, BookTitledEntry) -->
  <!-- Unique title, unique booktitle -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2015" title="Testing ATL Transformations" booktitle="MDE Conference 2015">
    <authors author="Nina Indigo"/>
    <authors author="Oscar Red"/>
  </entries>

  <!-- Theses (PhDThesis, MasterThesis) -->
  <!-- PhDThesis, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2016" title="Scalability of Model Transformations" school="University of Model Engineering">
    <authors author="Peter Brown"/>
    <authors author="Quinn Lime"/>
  </entries>

  <!-- MasterThesis with title duplicated by PhDThesis -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MS1" year="2017" title="Scalability of Model Transformations" school="Institute of Software Systems">
    <authors author="Rachel Pink"/>
  </entries>

  <!-- Unpublished entries (Authored, Titled, no date) -->
  <!-- Unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Draft on Model Synchronization" note="Work in progress">
    <authors author="Steve Gray"/>
    <authors author="Tom Azure"/>
  </entries>
  <!-- Duplicate title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="UP2" title="Draft on Model Synchronization" note="Extended version">
    <authors author="Uma Gold"/>
  </entries>

</BibTeX:BibTeXFile>