<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles: designed to cover distinct/same titles and journals to trigger all Article_* rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model Transformation Testing" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Miller"/>
  </entries>
  <!-- A2: same title as A1, different journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Model Transformation Testing" journal="International Journal of Software Tools">
    <authors author="Carol Johnson"/>
  </entries>
  <!-- A3: different title, same journal as A1 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Metamodel Evolution in Practice" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="David Brown"/>
  </entries>
  <!-- A4: same title as A3 and same journal as A1/A3 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Metamodel Evolution in Practice" journal="Journal of Model Engineering">
    <authors author="Eve Davis"/>
  </entries>

  <!-- Misc entry to trigger UntitledEntry and OCL on BibTeXEntry with no additional fields -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- Booklet entries (DatedEntry, non-titled) -> UntitledEntry + OCL5 -->
  <entries xsi:type="BibTeX:Booklet" id="BLET1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="BLET2" year="2010"/>

  <!-- Manual entries (TitledEntry, no authors/date) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="ATL User Guide"/>
  <!-- Same title different id to exercise TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MAN2" title="ATL User Guide"/>

  <!-- TechReport (Authored, Dated, Titled) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2015" title="Testing Model Transformations">
    <authors author="Frank Green"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Unpublished entries (Authored, Titled) -> TitledEntry_* and OCL6 -->
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Evaluating ATL Transformations" note="Submitted for publication">
    <authors author="Bob Miller"/>
    <authors author="Grace Lee"/>
  </entries>
  <!-- Same title as UP1 to activate TitledEntry_NoTitle_NoArticle for one of them -->
  <entries xsi:type="BibTeX:Unpublished" id="UP2" title="Evaluating ATL Transformations" note="Internal technical report">
    <authors author="Grace Lee"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) -> TitledEntry_Title_NoArticle (OCL7 commented but still consistent) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2012" title="Model-Driven Testing Approaches" school="Tech University of Metropolis">
    <authors author="Helen Clark"/>
  </entries>

  <!-- PhDThesis (ThesisEntry) -> TitledEntry_Title_NoArticle and OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2018" title="Scalable Model Transformations" school="Institute of Advanced Software">
    <authors author="Ian Thompson"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book (Authored, Dated, Titled) -> TitledEntry_Title_NoArticle and OCL9 -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="2005" title="Foundations of Model-Driven Engineering" publisher="Springfield Publishing">
    <authors author="John Walker"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- InBook (Book + chapter) -> TitledEntry_Title_NoArticle and OCL10 -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2007" title="Chapter on ATL Transformations" publisher="Springfield Publishing" chapter="3">
    <authors author="John Walker"/>
    <authors author="Kevin Adams"/>
  </entries>

  <!-- Proceedings (Dated, Titled) -> TitledEntry_Title_NoArticle and OCL13 -->
  <entries xsi:type="BibTeX:Proceedings" id="PROC1" year="2011" title="Proceedings of the MDE Conference"/>

  <!-- InProceedings (Authored, Dated, BookTitledEntry) -> TitledEntry_Title_NoArticle and OCL14 -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2011" title="Testing Transformations at Scale" booktitle="Proceedings of the MDE Conference">
    <authors author="Grace Lee"/>
    <authors author="David Brown"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -> TitledEntry_Title_NoArticle and OCL15 -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2009" title="Case Studies in Model-Driven Engineering" booktitle="Advances in Software Engineering" publisher="Northbridge Press">
    <authors author="Kevin Adams"/>
    <authors author="Helen Clark"/>
  </entries>
</BibTeX:BibTeXFile>