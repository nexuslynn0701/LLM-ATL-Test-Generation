<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles designed to trigger different Article* rules and journal/title dedup logic -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Title One" journal="Journal Alpha">
    <authors author="Author A"/>
    <authors author="Author B"/>
  </entries>

  <!-- A2 & A3: same title, different journals -->
  <!-- A2 should be representative for its journal (Article_NoTitle_Journal due to duplicate title) -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title X" journal="Journal Beta">
    <authors author="Author C"/>
  </entries>

  <!-- A3: same title as A2, different journal; non-representative for its journal -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Title X" journal="Journal Gamma">
    <authors author="Author A"/>
    <authors author="Author D"/>
  </entries>

  <!-- A4 & A5: different titles, same journal -->
  <!-- A4: representative for journal, unique title -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Journal Delta Paper One" journal="Journal Delta">
    <authors author="Author E"/>
  </entries>

  <!-- A5: non-representative for journal, unique title -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Journal Delta Paper Two" journal="Journal Delta">
    <authors author="Author F"/>
    <authors author="Author B"/>
  </entries>

  <!-- Titled, non-article entries covering many subclasses -->

  <!-- B1 & B2: Books with same title -->
  <!-- B1 representative -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B1" year="1999" title="Common Book Title" publisher="Publisher One">
    <authors author="Author G"/>
    <authors author="Author H"/>
  </entries>

  <!-- B2 non-representative -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B2" year="2000" title="Common Book Title" publisher="Publisher Two">
    <authors author="Author A"/>
  </entries>

  <!-- IB1: InBook with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2010" title="InBook Unique Title" publisher="Publisher Three" chapter="7">
    <authors author="Author I"/>
  </entries>

  <!-- IC1: InCollection with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2011" title="Collected Works Volume 1" publisher="Publisher Four" booktitle="Collection Alpha">
    <authors author="Author J"/>
    <authors author="Author B"/>
  </entries>

  <!-- IP1 & IP2: InProceedings with same title -->
  <!-- IP1 representative -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2012" title="Conference Paper Title" booktitle="Proceedings of MDE Conf">
    <authors author="Author K"/>
  </entries>

  <!-- IP2 non-representative -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2013" title="Conference Paper Title" booktitle="Proceedings of Testing Conf">
    <authors author="Author L"/>
    <authors author="Author A"/>
  </entries>

  <!-- P1 & P2: Proceedings with same title -->
  <!-- P1 representative -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2014" title="Symposium on Modeling"/>
  <!-- P2 non-representative -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2015" title="Symposium on Modeling"/>

  <!-- M1: Manual unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="Manual for Tool X"/>

  <!-- U1 & U2: Unpublished with same title -->
  <!-- U1 representative -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Unpublished Study" note="First version note">
    <authors author="Author M"/>
    <authors author="Author N"/>
  </entries>

  <!-- U2 non-representative -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Unpublished Study" note="Revised version note">
    <authors author="Author A"/>
  </entries>

  <!-- TR1 & TR2: TechReport with same title -->
  <!-- TR1 representative -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="1995" title="Tech Report on MDE">
    <authors author="Author O"/>
  </entries>

  <!-- TR2 non-representative -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="1996" title="Tech Report on MDE">
    <authors author="Author B"/>
    <authors author="Author P"/>
  </entries>

  <!-- Thesis hierarchy -->

  <!-- MT1: MasterThesis unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2008" title="Master Thesis on Transformation Testing" school="University One">
    <authors author="Author Q"/>
  </entries>

  <!-- PT1 & PT2: PhDThesis with same title -->
  <!-- PT1 representative -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PT1" year="2009" title="PhD Thesis on Model Engineering" school="University Two">
    <authors author="Author R"/>
    <authors author="Author S"/>
  </entries>

  <!-- PT2 non-representative -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PT2" year="2010" title="PhD Thesis on Model Engineering" school="University Three">
    <authors author="Author B"/>
  </entries>

  <!-- Untitled entries (no TitledEntry) to trigger UntitledEntry rule -->

  <!-- BO1 & BO2: Booklet entries -->
  <entries xsi:type="BibTeX:Booklet" id="BO1" year="1990"/>
  <entries xsi:type="BibTeX:Booklet" id="BO2" year="1991"/>

  <!-- Misc entries -->
  <entries xsi:type="BibTeX:Misc" id="MS1"/>
  <entries xsi:type="BibTeX:Misc" id="MS2"/>

</BibTeX:BibTeXFile>