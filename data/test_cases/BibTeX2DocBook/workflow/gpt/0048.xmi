<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise all four Article rules (R6–R9) and journal/title uniqueness handling -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="State-based testing of model transformations" journal="Journal of Model Engineering">
    <authors author="Alice Doe"/>
    <authors author="Bob Roe"/>
  </entries>
  <!-- A2 & A3: same title, same journal -> only A2 in title/journal sets, A3 triggers Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Mutation analysis for ATL transformations" journal="Empirical Software Studies">
    <authors author="Carol Smith"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Mutation analysis for ATL transformations" journal="Empirical Software Studies">
    <authors author="Dave Clark"/>
    <authors author="Eve Adams"/>
  </entries>
  <!-- A4 & A5: same title, different journals -> A4 in title set, both in journal set; A4->Article_Title_Journal, A5->Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Search-based testing for model transformations" journal="International Journal of Software Tools">
    <authors author="Frank Miller"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Search-based testing for model transformations" journal="Transactions on Model-Driven Engineering">
    <authors author="Grace Lee"/>
    <authors author="Henry King"/>
  </entries>
  <!-- A6 & A7: different titles, same journal -> A6 in journal set, both in title set; A6->Article_Title_Journal, A7->Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art6" year="2006" title="Traceability in bidirectional transformations" journal="Journal of Model Engineering">
    <authors author="Ian Young"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art7" year="2007" title="Contracts for model transformation correctness" journal="Journal of Model Engineering">
    <authors author="Jane Brown"/>
    <authors author="Kevin White"/>
  </entries>

  <!-- Untitled entries: Booklet and Misc to trigger UntitledEntry (R3) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1999"/>
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Titled, non-Article entries for TitledEntry rules R4 & R5 -->

  <!-- Unique titles (go through TitledEntry_Title_NoArticle and create title paras) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="User guide for model mutation tooling"/>
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2010" title="Industrial evaluation of transformation testing">
    <authors author="Laura Green"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book1" year="2011" title="Foundations of Model-Driven Engineering" publisher="Springer MDE Series">
    <authors author="Michael Black"/>
    <authors author="Nina Gray"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2012" title="Coverage criteria for transformation testing" publisher="Springer MDE Series" chapter="3">
    <authors author="Oliver Stone"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="incol1" year="2013" title="Transformation testing in practice" publisher="ACM Press" booktitle="Proceedings of the MDE Testing Workshop">
    <authors author="Paul Green"/>
    <authors author="Quinn Ivy"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2014" title="Automated oracle generation for ATL" booktitle="Conference on Model Transformation Testing">
    <authors author="Rachel Long"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2015" title="Proceedings of the MDE Testing Workshop"/>
  <entries xsi:type="BibTeX:Unpublished" id="unp1" title="Position paper on negative testing of transformations" note="Submitted to MDE Vision Track">
    <authors author="Steve Hall"/>
    <authors author="Tina Fox"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2016" title="Testing model transformations with search" school="University of Metamodeling">
    <authors author="Uma Patel"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="2017" title="Scenario-based testing of QVT" school="Institute of Software Quality">
    <authors author="Victor Chen"/>
  </entries>

  <!-- Duplicate titles among non-Article entries (second and later duplicates -> TitledEntry_NoTitle_NoArticle) -->
  <!-- Duplicate Manual title -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="User guide for model mutation tooling"/>
  <!-- Duplicate Book title -->
  <entries xsi:type="BibTeX:Book" id="book2" year="2018" title="Foundations of Model-Driven Engineering" publisher="Elsevier Modeling Series">
    <authors author="Wendy Scott"/>
  </entries>
  <!-- Duplicate Proceedings title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2019" title="Proceedings of the MDE Testing Workshop"/>

  <!-- Additional Unpublished entries, some sharing titles with articles to couple lists -->
  <entries xsi:type="BibTeX:Unpublished" id="unp2" title="Traceability in bidirectional transformations" note="Extended abstract for tool demo">
