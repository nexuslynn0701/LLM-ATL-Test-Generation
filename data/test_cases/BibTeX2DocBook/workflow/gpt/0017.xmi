<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles: design to exercise Article_Title_Journal, Article_NoTitle_Journal, Article_Title_NoJournal, Article_NoTitle_NoJournal -->
  <!-- A1 & A2 share both title and journal: one in title-set (A1), one not (A2) -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Duplicate Title" journal="Shared Journal">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Duplicate Title" journal="Shared Journal">
    <authors author="Carol Researcher"/>
  </entries>
  <!-- A3 & A4 share the journal but have unique titles: both in articleSet, only A3 in title-set -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Unique Title 1" journal="Clustered Journal">
    <authors author="Dave Scientist"/>
    <authors author="Eve Engineer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Unique Title 2" journal="Clustered Journal">
    <authors author="Frank Analyst"/>
  </entries>
  <!-- A5 has a unique title and journal: Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Isolated Article" journal="Solo Journal">
    <authors author="Grace Author"/>
    <authors author="Henry Developer"/>
  </entries>

  <!-- Booklets and Misc to exercise UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="Blet1" year="1990"/>
  <entries xsi:type="BibTeX:Booklet" id="Blet2" year="1991"/>
  <entries xsi:type="BibTeX:Misc" id="Misc1"/>
  <entries xsi:type="BibTeX:Misc" id="Misc2"/>

  <!-- Unpublished, Manual, TechReport, Book, InBook, InCollection, InProceedings, Proceedings, PhDThesis, MasterThesis -->
  <!-- Two Books sharing same title to trigger TitledEntry_NoTitle_NoArticle for the second -->
  <entries xsi:type="BibTeX:Book" id="Book1" year="2010" title="Shared Book Title" publisher="Main Publisher">
    <authors author="Alice Author"/>
    <authors author="Carol Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="Book2" year="2011" title="Shared Book Title" publisher="Secondary Publisher">
    <authors author="Dave Scientist"/>
  </entries>

  <!-- InBook with unique title -->
  <entries xsi:type="BibTeX:InBook" id="InBook1" year="2012" title="InBook Title" publisher="Chapter Publisher" chapter="7">
    <authors author="Bob Writer"/>
    <authors author="Frank Analyst"/>
  </entries>

  <!-- InCollection with its own title and booktitle -->
  <entries xsi:type="BibTeX:InCollection" id="InColl1" year="2013" title="Collected Chapter" booktitle="Collected Works" publisher="Collection House">
    <authors author="Grace Author"/>
  </entries>

  <!-- InProceedings with its own title and booktitle -->
  <entries xsi:type="BibTeX:InProceedings" id="InProc1" year="2014" title="Conference Paper" booktitle="Best Conference 2014">
    <authors author="Henry Developer"/>
    <authors author="Eve Engineer"/>
  </entries>

  <!-- Two Proceedings with same title to get one in title-set, one not -->
  <entries xsi:type="BibTeX:Proceedings" id="Proc1" year="2015" title="Annual Meeting"/>
  <entries xsi:type="BibTeX:Proceedings" id="Proc2" year="2016" title="Annual Meeting"/>

  <!-- Manual with unique title -->
  <entries xsi:type="BibTeX:Manual" id="Man1" title="User Guide Manual"/>

  <!-- TechReport with unique title -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2009" title="Tech Report on Systems">
    <authors author="Ian Tester"/>
  </entries>

  <!-- Unpublished with unique title -->
  <entries xsi:type="BibTeX:Unpublished" id="Unpub1" title="Early Draft Paper" note="unpublished draft v1">
    <authors author="Julia Researcher"/>
    <authors author="Alice Author"/>
  </entries>

  <!-- PhDThesis and MasterThesis with unique titles -->
  <entries xsi:type="BibTeX:PhDThesis" id="PhD1" year="2007" title="PhD Thesis Title" school="Big University">
    <authors author="Kevin Doctoral"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MSc1" year="2008" title="Master Thesis Title" school="Tech Institute">
    <authors author="Laura Student"/>
    <authors author="Bob Writer"/>
  </entries>
</BibTeX:BibTeXFile>