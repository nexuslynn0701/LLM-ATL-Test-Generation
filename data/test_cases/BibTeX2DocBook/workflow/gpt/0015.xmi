<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article A1: unique title, unique journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Article One" journal="Journal Alpha">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- Article A2 & A3: same title, different journals (duplicate title case) -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title Article" journal="Journal Beta">
    <authors author="Carol Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Title Article" journal="Journal Gamma">
    <authors author="Dave Scientist"/>
  </entries>

  <!-- Article A4 & A5: different titles, same journal (duplicate journal case) -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="First Journal Duplicate" journal="Journal Delta">
    <authors author="Eve Engineer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Second Journal Duplicate" journal="Journal Delta">
    <authors author="Frank Developer"/>
  </entries>

  <!-- Article A6 & A7: same title and same journal (duplicate title & journal case) -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Same Title Same Journal" journal="Journal Epsilon">
    <authors author="Grace Analyst"/>
    <authors author="Heidi Designer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Same Title Same Journal" journal="Journal Epsilon">
    <authors author="Ivan Architect"/>
  </entries>

  <!-- Manual M1 & M2: distinct titles -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="Manual for Tool X"/>
  <entries xsi:type="BibTeX:Manual" id="M2" title="Guide to Framework Y"/>

  <!-- TechReport T1 & T2: distinct titles -->
  <entries xsi:type="BibTeX:TechReport" id="T1" year="2010" title="Tech Report Alpha">
    <authors author="Alice Author"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="T2" year="2011" title="Tech Report Beta">
    <authors author="Bob Writer"/>
  </entries>

  <!-- Manual M3 and TechReport T3: same title to force TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M3" title="Shared TitledEntry Document"/>
  <entries xsi:type="BibTeX:TechReport" id="T3" year="2012" title="Shared TitledEntry Document">
    <authors author="Carol Researcher"/>
  </entries>

  <!-- Book B1: unique title -->
  <entries xsi:type="BibTeX:Book" id="B1" year="2013" title="Book on Systems" publisher="Publisher One">
    <authors author="Dave Scientist"/>
    <authors author="Eve Engineer"/>
  </entries>

  <!-- Book B2: shares title with InBook IB1 to trigger duplicate-title behavior across types -->
  <entries xsi:type="BibTeX:Book" id="B2" year="2014" title="Composite Structures" publisher="Publisher Two">
    <authors author="Frank Developer"/>
  </entries>

  <!-- InBook IB1: same title as B2 -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2015" title="Composite Structures" publisher="Publisher Three" chapter="5">
    <authors author="Grace Analyst"/>
  </entries>

  <!-- InCollection IC1: unique title -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2016" title="Collection Chapter One" publisher="Publisher Four" booktitle="Collected Works Volume 1">
    <authors author="Heidi Designer"/>
    <authors author="Ivan Architect"/>
  </entries>

  <!-- Proceedings P1 & P2: same title, different years, to exercise Proceedings duplicate-title handling -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2017" title="Conference on Modeling"/>
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2018" title="Conference on Modeling"/>

  <!-- Booklet BL1: dated entry without title -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="2019"/>

  <!-- Misc MS1: completely untitled and undated -->
  <entries xsi:type="BibTeX:Misc" id="MS1"/>

  <!-- Unpublished U1 & U2: distinct titles and notes -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Draft on MDE" note="To appear in proceedings">
    <authors author="Alice Author"/>
    <authors author="Grace Analyst"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Notes on Transformation Testing" note="Internal technical report">
    <authors author="Bob Writer"/>
    <authors author="Ivan Architect"/>
  </entries>

  <!-- PhDThesis PHD1 & PHD2: distinct titles, distinct schools -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2020" title="PhD Thesis on Model Transformations" school="Tech University A">
    <authors author="Carol Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PHD2" year="2021" title="PhD Thesis on Verification" school="Tech University B">
    <authors author="Dave Scientist"/>
    <authors author="Heidi Designer"/>
  </entries>

  <!-- MasterThesis MT1: distinct title -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2022" title="Master Thesis on Metamodeling" school="Engineering School C">
    <authors author="Frank Developer"/>
    <authors author="Eve Engineer"/>
  </entries>

</BibTeX:BibTeXFile>