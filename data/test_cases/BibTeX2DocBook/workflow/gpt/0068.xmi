<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise all four Article rules (R6–R9) and journal/title uniqueness variations -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Model Transformations in Practice" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A2 & A3: same title, different journals -> one in title-set (A2, R7), one not (A3, R7) -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Testing Model Transformations" journal="Software Testing Letters">
    <authors author="Charlie Brown"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Testing Model Transformations" journal="Empirical Software Engineering Reports">
    <authors author="Alice Smith"/>
    <authors author="Diana Prince"/>
  </entries>

  <!-- A4 & A5: different titles, same journal -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Incremental Transformation Frameworks" journal="Journal of Reusable Artifacts">
    <authors author="Evan Davis"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Scalable Traceability Management" journal="Journal of Reusable Artifacts">
    <authors author="Bob Johnson"/>
    <authors author="Grace Hopper"/>
  </entries>

  <!-- A6 & A7: same title and same journal -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art6" year="2006" title="Metamodel Evolution Case Studies" journal="International Journal of Software Modeling">
    <authors author="Henry Ford"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art7" year="2007" title="Metamodel Evolution Case Studies" journal="International Journal of Software Modeling">
    <authors author="Charlie Brown"/>
    <authors author="Ivan Petrov"/>
  </entries>

  <!-- Untitled entries to exercise R3 (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2010"/>

  <!-- Titled non-Article entries to exercise R4 and R5 -->

  <!-- Unique titles (in distinct-title set) -> R4 -->
  <entries xsi:type="BibTeX:Book" id="book1" year="2011" title="Advanced Model-Driven Architecture" publisher="Modeling Press">
    <authors author="Alice Smith"/>
    <authors author="Grace Hopper"/>
  </entries>

  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2012" title="Transforming Legacy Systems" publisher="Legacy Publishers" chapter="3">
    <authors author="John Doe"/>
  </entries>

  <entries xsi:type="BibTeX:InCollection" id="incol1" year="2013" title="Domain-Specific Languages in Practice" publisher="DSL House" booktitle="Proceedings of the DSL Symposium">
    <authors author="Kate Miller"/>
    <authors author="Luke Skywalker"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2014" title="Symbolic Execution for Transformations" booktitle="Proceedings of the MDE Testing Workshop">
    <authors author="Bob Johnson"/>
  </entries>

  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2015" title="Proceedings of the Transformation Conference"/>
  <entries xsi:type="BibTeX:Manual" id="manual1" title="ATL Transformation Reference Manual"/>

  <entries xsi:type="BibTeX:TechReport" id="tech1" year="2016" title="Industrial Experience with MDE Testing">
    <authors author="Evan Davis"/>
    <authors author="Nina Novak"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Unreleased Transformation Benchmark" note="Internal draft">
    <authors author="John Doe"/>
    <authors author="Grace Hopper"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2017" title="Quality Assurance for Model Transformations" school="University of Modeling">
    <authors author="Kate Miller"/>
    <authors author="Alice Smith"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis" id="msc1" year="2018" title="Testing Strategies for ATL Transformations" school="Institute of Software Quality">
    <authors author="Ivan Petrov"/>
  </entries>

  <!-- Duplicate-title group (not in distinct-title set) -> R5 -->
  <entries xsi:type="BibTeX:Book" id="book2" year="2019" title="Reusable Transformation Patterns" publisher="Pattern Press">
    <authors author="Luke Skywalker"/>
  </entries>

  <!-- First occurrence of this title, will be in distinct-title set -> R4 -->
  <entries xsi:type="BibTeX:Manual" id="manual2" title="Reusable Transformation Patterns"/>

  <!-- Second occurrence, not in distinct-title set -> R5 -->
  <entries xsi:type="BibTeX:TechReport" id="tech2" year="2020" title="Reusable Transformation Patterns">
    <authors author="Henry Ford"/>
    <authors author="Nina Novak"/>
  </entries>

  <!-- Another duplicate-title pair exclusively among non-Articles to further exercise R5 -->
  <!-- First occurrence -> R4 -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2021" title="Benchmarking Model Transformations"/>
  <!-- Second occurrence -> R5 -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Benchmarking Model Transformations" note="Submitted version">
    <authors author="Diana Prince"/>
  </entries>

</BibTeX:BibTeXFile>