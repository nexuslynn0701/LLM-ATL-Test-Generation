  <!-- Second InProceedings with same title to exercise NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2018" title="Testing Transformations in Practice" booktitle="Proceedings of Advanced MDE">
