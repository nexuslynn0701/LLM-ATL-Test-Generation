  </entries>

  <!-- Proceedings (titled, dated) with unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2015" title="Proceedings of MDE Conference"/>
  <!-- Proceedings sharing a title -> one in title set, one out -->
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2016" title="Proceedings of MDE Conference"/>

  <!-- InProceedings (titled, authored, dated, booktitle, extends Proceedings) -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2017" title="Testing Transformations in Practice" booktitle="Proceedings of MDE Conference">
    <authors author="Alice Smith"/>
    <authors author="Kevin Yellow"/>
