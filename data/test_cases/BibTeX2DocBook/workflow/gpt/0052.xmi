  <!-- Articles: distinct title & journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model Transformation Testing" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- Article: same title as A1, same journal -> duplicate title & journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Model Transformation Testing" journal="Journal of Model Engineering">
    <authors author="Carol White"/>
  </entries>
  <!-- Article: same title as A1 but different journal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Model Transformation Testing" journal="Software Quality Journal">
    <authors author="Alice Smith"/>
  </entries>
  <!-- Article: different title, same journal as A1 -> duplicate journal only -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Automated Test Generation" journal="Journal of Model Engineering">
    <authors author="David Black"/>
    <authors author="Eve Gray"/>
  </entries>
  <!-- Article: unique title, unique journal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Traceability in MDE" journal="International Journal of Software Tools">
    <authors author="Frank Green"/>
  </entries>

  <!-- Booklet (untitled, dated) -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1999"/>
  <!-- Second Booklet to increase coverage -->
  <entries xsi:type="BibTeX:Booklet" id="B2" year="2000"/>

  <!-- Misc (untitled, undated) -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <!-- Second Misc -->
  <entries xsi:type="BibTeX:Misc" id="M2"/>

  <!-- Manual (titled, no authors, no year) -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="ATL User Guide"/>

  <!-- TechReport (titled, authored, dated) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="Testing Model Transformations">
