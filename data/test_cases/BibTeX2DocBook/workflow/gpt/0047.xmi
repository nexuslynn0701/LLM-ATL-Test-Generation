<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles group 1: same title, same journal (triggers Article_Title_Journal for first, Article_NoTitle_NoJournal for second) -->
  <entries xsi:type="BibTeX:Article" id="art01" year="2010" title="Shared Title A" journal="Journal X">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art02" year="2011" title="Shared Title A" journal="Journal X">
    <authors author="Carol White"/>
  </entries>

  <!-- Articles group 2: same title, different journals (Article_Title_Journal then Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art03" year="2012" title="Shared Title B" journal="Journal Y">
    <authors author="David Brown"/>
    <authors author="Eve Black"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art04" year="2013" title="Shared Title B" journal="Journal Z">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Articles group 3: different titles, same journal (Article_Title_Journal then Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art05" year="2014" title="Unique Title C" journal="Journal Y">
    <authors author="Frank Green"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art06" year="2015" title="Unique Title D" journal="Journal Y">
    <authors author="Bob Jones"/>
    <authors author="Gina Gray"/>
  </entries>

  <!-- Article group 4: unique title and unique journal (Article_Title_Journal only) -->
  <entries xsi:type="BibTeX:Article" id="art07" year="2016" title="Standalone Article" journal="Journal W">
    <authors author="Helen King"/>
  </entries>

  <!-- Untitled entries: Misc + Booklet (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="misc01"/>
  <entries xsi:type="BibTeX:Booklet" id="bkl01" year="2001"/>

  <!-- Titled, non-Article, non-duplicate titles: use TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man01" title="MDE User Guide"/>
  <entries xsi:type="BibTeX:TechReport" id="tr01" year="2005" title="Tech Report on MDE Testing">
    <authors author="Ivan Novak"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="bk01" year="2008" title="MDE Foundations" publisher="TechBooks Press">
    <authors author="John Doe"/>
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="ib01" year="2009" title="Chapter on Transformations" publisher="TechBooks Press" chapter="3">
    <authors author="John Doe"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="ic01" year="2011" title="Collected MDE Papers" publisher="Conference Pub" booktitle="Proceedings of MDE Symposium">
    <authors author="Carol White"/>
    <authors author="David Brown"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="ip01" year="2012" title="Proceedings Paper on Testing" booktitle="ICST Conference">
    <authors author="Eve Black"/>
    <authors author="Frank Green"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="proc01" year="2010" title="MDE Conference 2010"/>
  <entries xsi:type="BibTeX:PhDThesis" id="phd01" year="2013" title="PhD on Model Transformations" school="University A">
    <authors author="Gina Gray"/>
    <authors author="Helen King"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mst01" year="2014" title="Master Thesis on ATL" school="University B">
    <authors author="Ivan Novak"/>
  </entries>

  <!-- Titled non-Article with duplicate title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="bk02" year="2015" title="MDE Foundations" publisher="Another Publisher">
    <authors author="John Doe"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="proc02" year="2016" title="MDE Conference 2010"/>

  <!-- Titled non-Article sharing a title with an Article (still handled by TitledEntry_Title_NoArticle / NoTitle_NoArticle, not Article rules) -->
  <entries xsi:type="BibTeX:Manual" id="man02" title="Standalone Article"/>
</BibTeX:BibTeXFile>