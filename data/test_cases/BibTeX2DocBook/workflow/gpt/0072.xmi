<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise all Article* rules and journal/title uniqueness logic -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="1990" title="Adaptive Model Transformations" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>
  <!-- A2: same title as A1, different journal -> Article_NoTitle_Journal (duplicate title, unique journal) -->
  <entries xsi:type="BibTeX:Article" id="art2" year="1992" title="Adaptive Model Transformations" journal="Software Modelling Letters">
    <authors author="Charlie Brown"/>
  </entries>
  <!-- A3: unique title, journal J2 that will have a duplicate (A3 &amp; A4) -> Article_Title_NoJournal for one of them -->
  <entries xsi:type="BibTeX:Article" id="art3" year="1995" title="Incremental Meta-Modelling" journal="International Journal of Software Patterns">
    <authors author="David Clark"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- A4: different title, same journal as A3 -> Article_NoTitle_NoJournal for one of the pair in that journal set -->
  <entries xsi:type="BibTeX:Article" id="art4" year="1996" title="Scalable Transformation Testing" journal="International Journal of Software Patterns">
    <authors author="Eva Adams"/>
  </entries>

  <!-- Titled no-Article entries: some with shared titles to trigger both TitledEntry rules -->
  <!-- B1: Book with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" year="2000" title="Foundations of Model Transformation" publisher="ModelPress">
    <authors author="Frank Miller"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- B2: Book with title duplicated by InBook1 -> only first occurrence in distinct-title set will get title paragraph -->
  <entries xsi:type="BibTeX:Book" id="book2" year="2001" title="Patterns of Model Management" publisher="TechBooks">
    <authors author="George Wilson"/>
  </entries>
  <!-- IB1: InBook sharing title with B2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2002" title="Patterns of Model Management" publisher="TechBooks" chapter="5">
    <authors author="Hannah Lee"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Proceedings with duplicate title to test select(oclIsTypeOf) and title duplication handling -->
  <!-- P1: Proceedings with shared title (first one in distinct titles) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2010" title="Model-Driven Engineering Conference">
    <!-- no authors -->
  </entries>
  <!-- P2: same title as P1, different year -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2012" title="Model-Driven Engineering Conference">
  </entries>

  <!-- InCollection with unique title -> TitledEntry_Title_NoArticle; also tests BookTitledEntry &amp; Book inheritance -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" year="2005" title="Reusable Transformation Libraries" publisher="LibraryHouse" booktitle="Advances in Model-Driven Engineering">
    <authors author="Ian Turner"/>
    <authors author="Charlie Brown"/>
  </entries>

  <!-- Manual with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="User Guide for Transformation Tool"/>
  <!-- Manual sharing title with an Unpublished below to create a duplicate title across different types -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="Experimental Evaluation Notes"/>

  <!-- TechReport with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="1999" title="Survey of Model Transformation Languages">
    <authors author="John Doe"/>
  </entries>

  <!-- Thesis entries -->
  <!-- PhDThesis with unique title -> TitledEntry_Title_NoArticle and OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2003" title="Verification of Model Transformations" school="University of Modelling">
    <authors author="Kate Johnson"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- MasterThesis with unique title -> TitledEntry_Title_NoArticle (OCL7 commented but still covered by rules) -->
  <entries xsi:type="BibTeX:MasterThesis" id="ms1" year="2004" title="Testing of Meta-Models" school="Institute of Software Quality">
    <authors author="Leo Martin"/>
  </entries>

  <!-- Unpublished entries -->
  <!-- U1: Unpublished with unique title -> TitledEntry_Title_NoArticle, OCL6 -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Formal Semantics for ATL" note="Under submission">
    <authors author="Mike Green"/>
    <authors author="John Doe"/>
  </entries>
  <!-- U2: Unpublished sharing title with Manual man2 -> one of them will miss the title paragraph via TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Experimental Evaluation Notes" note="Draft version">
    <authors author="Nina White"/>
  </entries>

  <!-- Untitled entries (no TitledEntry) -> UntitledEntry rule -->
  <!-- Misc -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <!-- Booklet entries with required year attribute -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2015"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet2" year="2018"/>
</BibTeX:BibTeXFile>