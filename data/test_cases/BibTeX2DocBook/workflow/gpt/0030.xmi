<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles group A: same title, same journal (exercise Article_NoTitle_NoJournal and title/journal dedup) -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Shared Title A" journal="Shared Journal A">
    <authors author="Author One"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title A" journal="Shared Journal A">
    <authors author="Author Two"/>
    <authors author="Author Three"/>
  </entries>

  <!-- Articles group B: same title, different journals (exercise Article_NoTitle_Journal and journal dedup) -->
  <entries xsi:type="BibTeX:Article" id="B1" year="2003" title="Shared Title B" journal="Journal B1">
    <authors author="Author Four"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="B2" year="2004" title="Shared Title B" journal="Journal B2">
    <authors author="Author Five"/>
  </entries>

  <!-- Articles group C: different titles, same journal (exercise Article_Title_NoJournal and title dedup) -->
  <entries xsi:type="BibTeX:Article" id="C1" year="2005" title="Unique Title C1" journal="Shared Journal C">
    <authors author="Author Six"/>
    <authors author="Author Seven"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="C2" year="2006" title="Unique Title C2" journal="Shared Journal C">
    <authors author="Author Eight"/>
  </entries>

  <!-- Article D: unique title, unique journal (exercise Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="D1" year="2007" title="Completely Unique Title D" journal="Completely Unique Journal D">
    <authors author="Author Nine"/>
  </entries>

  <!-- Booklets (untitled, exercise UntitledEntry and OCL5) -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="BL2" year="2010"/>

  <!-- Misc (untitled, exercise UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Misc" id="M2"/>

  <!-- Manuals (titled, no authors/dates, exercise TitledEntry_Title_NoArticle and OCL12) -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="Unique Manual Title 1"/>
  <entries xsi:type="BibTeX:Manual" id="MAN2" title="Duplicate Manual Title"/>
  <entries xsi:type="BibTeX:Manual" id="MAN3" title="Duplicate Manual Title"/>

  <!-- TechReports (titled, authored, dated, exercise TitledEntry_* and OCL11) -->
  <!-- First TechReport with a title shared with an Article to test title dedup across types -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2011" title="Unique Title C1">
    <authors author="Author Ten"/>
  </entries>
  <!-- TechReports sharing same title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2012" title="Shared TechReport Title">
    <authors author="Author Eleven"/>
    <authors author="Author Twelve"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR3" year="2013" title="Shared TechReport Title">
    <authors author="Author Thirteen"/>
  </entries>

  <!-- Unpublished entries (titled, authored, no year, exercise TitledEntry_* and OCL6) -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Unpublished Title 1" note="Note U1">
    <authors author="Author Fourteen"/>
    <authors author="Author Fifteen"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Unpublished Title 2" note="Note U2">
    <authors author="Author Sixteen"/>
  </entries>

  <!-- Books (titled, authored, dated, publisher, exercise TitledEntry_* and OCL9) -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="1995" title="Book Title 1" publisher="Publisher One">
    <authors author="Author Seventeen"/>
    <authors author="Author Eighteen"/>
  </entries>
  <!-- Two Books with same title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="1996" title="Duplicated Book Title" publisher="Publisher Two">
    <authors author="Author Nineteen"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="BK3" year="1997" title="Duplicated Book Title" publisher="Publisher Three">
    <authors author="Author Twenty"/>
    <authors author="Author Twenty-One"/>
  </entries>

  <!-- InBook (titled, authored, dated, publisher, chapter, exercise TitledEntry_* and OCL10) -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="1998" title="InBook Unique Title" publisher="Publisher Four" chapter="3">
    <authors author="Author Twenty-Two"/>
    <authors author="Author Twenty-Three"/>
  </entries>

  <!-- Proceedings (titled, dated, no authors, exercise TitledEntry_* and OCL13) -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2014" title="Proceedings Title 1"/>
  <!-- Two Proceedings with same title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2015" title="Duplicated Proceedings Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="PR3" year="2016" title="Duplicated Proceedings Title"/>

  <!-- InProceedings (titled, authored, dated, booktitle, exercise TitledEntry_* and OCL14) -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2017" title="InProceedings Title 1" booktitle="Booktitle One">
    <authors author="Author Twenty-Four"/>
  </entries>
  <!-- Two InProceedings with same title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2018" title="Shared InProceedings Title" booktitle="Booktitle Two">
    <authors author="Author Twenty-Five"/>
    <authors author="Author Twenty-Six"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP3" year="2019" title="Shared InProceedings Title" booktitle="Booktitle Three">
    <authors author="Author Twenty-Seven"/>
  </entries>

  <!-- InCollection (titled, authored, dated, booktitle, publisher, exercise TitledEntry_* and OCL15) -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2020" title="InCollection Unique Title" publisher="Publisher Five" booktitle="IC Booktitle 1">
    <authors author="Author Twenty-Eight"/>
    <authors author="Author Twenty-Nine"/>
  </entries>
  <!-- Two InCollection with same title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC2" year="2021" title="Duplicated InCollection Title" publisher="Publisher Six" booktitle="IC Booktitle 2">
    <authors author="Author Thirty"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="IC3" year="2022" title="Duplicated InCollection Title" publisher="Publisher Seven" booktitle="IC Booktitle 3">
    <authors author="Author Thirty-One"/>
    <authors author="Author Thirty-Two"/>
  </entries>

  <!-- PhDThesis (titled, authored, dated, school, exercise TitledEntry_* and OCL8) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2010" title="PhD Thesis Unique Title" school="School One">
    <authors author="Author Thirty-Three"/>
    <authors author="Author Thirty-Four"/>
  </entries>
  <!-- MasterThesis (titled, authored, dated, school, exercise TitledEntry_* and OCL7) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2011" title="Master Thesis Unique Title" school="School Two">
    <authors author="Author Thirty-Five"/>
  </entries>
</BibTeX:BibTeXFile>