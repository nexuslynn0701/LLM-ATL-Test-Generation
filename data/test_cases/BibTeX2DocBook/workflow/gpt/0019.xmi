<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles designed to hit all four Article rules -->
  <!-- A1: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="TitleA1" journal="JournalA1">
    <authors author="Author1"/>
    <authors author="Author2"/>
  </entries>
  <!-- A2: same title as A1, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="TitleA1" journal="JournalA2">
    <authors author="Author3"/>
  </entries>
  <!-- A3: unique title, journal shared with A4 -> Article_Title_NoJournal for A3 -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="TitleA3" journal="JournalShared1">
    <authors author="Author1"/>
    <authors author="Author4"/>
  </entries>
  <!-- A4: same title and journal as A3 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="TitleA3" journal="JournalShared1">
    <authors author="Author5"/>
  </entries>
  <!-- A5: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="TitleA5" journal="JournalA5">
    <authors author="Author2"/>
    <authors author="Author3"/>
    <authors author="Author6"/>
  </entries>

  <!-- Untitled entries -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="B2" year="2010"/>
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- Titled non-Article entries with unique titles -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="1995" title="BookTitle1" publisher="Pub1">
    <authors author="Author1"/>
    <authors author="Author7"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="IB1" year="1998" title="InBookTitle1" publisher="Pub2" chapter="3">
    <authors author="Author4"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2000" title="InCollectionTitle1" publisher="Pub3" booktitle="BookTitleIC1">
    <authors author="Author2"/>
    <authors author="Author8"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2012" title="InProceedingsTitle1" booktitle="ProcBook1">
    <authors author="Author5"/>
    <authors author="Author9"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2015" title="ProceedingsTitle1"/>
  <entries xsi:type="BibTeX:Manual" id="MN1" title="ManualTitle1"/>
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="UnpublishedTitle1" note="Note1">
    <authors author="Author6"/>
    <authors author="Author7"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="1990" title="TechReportTitle1">
    <authors author="Author8"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2008" title="PhDTitle1" school="School1">
    <authors author="Author9"/>
    <authors author="Author10"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2007" title="MasterTitle1" school="School2">
    <authors author="Author3"/>
  </entries>

  <!-- Titled non-Article entries creating duplicate-title cases -> TitledEntry_NoTitle_NoArticle for 2nd instances -->
  <!-- Duplicate title with BK1 -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="1996" title="BookTitle1" publisher="Pub4">
    <authors author="Author10"/>
  </entries>
  <!-- Duplicate title with TR1 -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="1991" title="TechReportTitle1">
    <authors author="Author4"/>
    <authors author="Author6"/>
  </entries>
  <!-- Duplicate title with MN1 -->
  <entries xsi:type="BibTeX:Manual" id="MN2" title="ManualTitle1"/>
</BibTeX:BibTeXFile>