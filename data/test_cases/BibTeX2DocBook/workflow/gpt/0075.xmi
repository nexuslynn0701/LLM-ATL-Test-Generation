<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles: designed to trigger different Article* rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Model Driven Testing Strategies" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Clark"/>
  </entries>
  <!-- A2: same title as A1, different journal -> Article_NoTitle_Journal (no title paragraph) -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Model Driven Testing Strategies" journal="Software Quality Letters">
    <authors author="Carol Jones"/>
  </entries>
  <!-- A3: different title, same journal as A1 -> Article_Title_NoJournal (no journal paragraph) -->
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Metamodel Evolution in Practice" journal="Journal of Model Engineering">
    <authors author="David Lee"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Misc and Booklet: UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1999"/>

  <!-- Manual: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL Transformation Handbook"/>

  <!-- Manual with duplicated title -> TitledEntry_NoTitle_NoArticle (no title paragraph) -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="ATL Transformation Handbook"/>

  <!-- TechReport: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2010" title="Testing Model Transformations in the Large">
    <authors author="Bob Clark"/>
  </entries>

  <!-- TechReport with duplicated title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2011" title="Testing Model Transformations in the Large">
    <authors author="Eve Brown"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- Book: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" year="2005" title="Foundations of Model Transformations" publisher="MDE Press">
    <authors author="Carol Jones"/>
    <authors author="George White"/>
  </entries>

  <!-- Book with duplicated title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book2" year="2006" title="Foundations of Model Transformations" publisher="Advanced MDE Publications">
    <authors author="Helen Black"/>
  </entries>

  <!-- InBook: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2007" title="Executable Metamodeling Techniques" publisher="Springer MDE Series" chapter="3">
    <authors author="Ian Gray"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- InCollection: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" year="2008" title="Scalability of Transformation Testing" publisher="ICMT Proceedings" booktitle="Proceedings of the International Conference on Model Transformation">
    <authors author="David Lee"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- InProceedings: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2009" title="Benchmarks for ATL Transformations" booktitle="Proceedings of the MDE Quality Workshop">
    <authors author="George White"/>
    <authors author="Helen Black"/>
  </entries>

  <!-- Proceedings: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2012" title="International Conference on Model Transformation 2012"/>
  <!-- Proceedings with duplicated title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2013" title="International Conference on Model Transformation 2012"/>

  <!-- Unpublished: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft Guidelines for Transformation Testing" note="Under submission to JSS">
    <authors author="Ian Gray"/>
    <authors author="Jack Miller"/>
  </entries>

  <!-- Unpublished with duplicated title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Draft Guidelines for Transformation Testing" note="Extended technical report version">
    <authors author="Jack Miller"/>
  </entries>

  <!-- PhDThesis: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2014" title="Quality Assurance for Model Transformations" school="University of Model Engineering">
    <authors author="Karen Young"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- MasterThesis: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="2015" title="Automated Oracles for ATL Transformations" school="Institute of Software Testing">
    <authors author="Leo Turner"/>
  </entries>
</BibTeX:BibTeXFile>