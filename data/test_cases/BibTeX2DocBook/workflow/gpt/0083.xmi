<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry: Booklet (R3 + OCL5) -->
  <entries xsi:type="BibTeX:Booklet" id="b1" year="1990"/>

  <!-- Untitled entry: Misc (R3) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>

  <!-- Manual (titled, no authors, R4 + OCL12) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Manual One"/>

  <!-- TechReport with a certain title (unique title, R4 + OCL11) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2001" title="Tech Report A">
    <authors author="Alice"/>
  </entries>

  <!-- TechReport with duplicated title (second instance, R5 + OCL11) -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2002" title="Tech Report A">
    <authors author="Bob"/>
    <authors author="Charlie"/>
  </entries>

  <!-- Unpublished with distinct title (R4 + OCL6) -->
  <entries xsi:type="BibTeX:Unpublished" id="up1" title="Unpublished Work One" note="Note A">
    <authors author="David"/>
    <authors author="Eve"/>
  </entries>

  <!-- Unpublished sharing title with a Book (forces duplicate title handling, R5 + OCL6) -->
  <entries xsi:type="BibTeX:Unpublished" id="up2" title="Shared Title" note="Note B">
    <authors author="Frank"/>
  </entries>

  <!-- MasterThesis (R4, OCL7 is commented but semantics still exercised) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" year="2010" title="Master Thesis Title" school="Tech University">
    <authors author="Grace"/>
  </entries>

  <!-- PhDThesis with unique title and unique school (R4 + OCL8) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2015" title="PhD Thesis One" school="Science Institute">
    <authors author="Heidi"/>
    <authors author="Ivan"/>
  </entries>

  <!-- PhDThesis sharing title with above PhDThesis, but different school (R5 + OCL8) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd2" year="2016" title="PhD Thesis One" school="Another Institute">
    <authors author="Judy"/>
  </entries>

  <!-- Book with unique title (R4 + OCL9) -->
  <entries xsi:type="BibTeX:Book" id="bk1" year="2005" title="Unique Book Title" publisher="Publisher A">
    <authors author="Alice"/>
    <authors author="Karen"/>
  </entries>

  <!-- Book with title that will also be used by Unpublished and InCollection (duplicate across types, R5 + OCL9,15) -->
  <entries xsi:type="BibTeX:Book" id="bk2" year="2008" title="Shared Title" publisher="Publisher B">
    <authors author="Leo"/>
  </entries>

  <!-- InBook (inherits Book; R4 + OCL10) -->
  <entries xsi:type="BibTeX:InBook" id="ib1" year="2011" title="InBook Title One" publisher="Publisher C" chapter="3">
    <authors author="Mallory"/>
    <authors author="Niaj"/>
  </entries>

  <!-- Proceedings with unique title (R4 + OCL13) -->
  <entries xsi:type="BibTeX:Proceedings" id="pr1" year="2000" title="Conf Proc A"/>

  <!-- Proceedings sharing title with another Proceedings (R5 + OCL13) -->
  <entries xsi:type="BibTeX:Proceedings" id="pr2" year="2001" title="Conf Proc A"/>

  <!-- InProceedings with unique title and journal-like booktitle (R4 + OCL14) -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" year="2003" title="InProceedings One" booktitle="Conf Proc A">
    <authors author="Oscar"/>
    <authors author="Peggy"/>
  </entries>

  <!-- InCollection with title also "Shared Title" (duplicate with Book and Unpublished, R4 + OCL15) -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" year="2009" title="Shared Title" publisher="Publisher D" booktitle="Collected Works">
    <authors author="Quentin"/>
    <authors author="Rachel"/>
  </entries>

  <!-- Article A1: unique title, unique journal (R6 + OCL16) -->
  <entries xsi:type="BibTeX:Article" id="a1" year="1999" title="Article One" journal="Journal Alpha">
    <authors author="Alice"/>
    <authors author="Bob"/>
  </entries>

  <!-- Article A2: shares title with A3, but unique journal (R7 + OCL16) -->
  <entries xsi:type="BibTeX:Article" id="a2" year="2000" title="Duplicated Article" journal="Journal Beta">
    <authors author="Charlie"/>
  </entries>

  <!-- Article A3: same title "Duplicated Article", different journal (R7 + OCL16) -->
  <entries xsi:type="BibTeX:Article" id="a3" year="2001" title="Duplicated Article" journal="Journal Gamma">
    <authors author="David"/>
    <authors author="Eve"/>
  </entries>

  <!-- Article A4 and A5: share journal but different titles (R8 + OCL16) -->
  <entries xsi:type="BibTeX:Article" id="a4" year="2002" title="Journal Shared One" journal="Journal Shared">
    <authors author="Frank"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a5" year="2003" title="Journal Shared Two" journal="Journal Shared">
    <authors author="Grace"/>
    <authors author="Heidi"/>
  </entries>

  <!-- Article A6 and A7: share both title and journal (R9 + OCL16) -->
  <entries xsi:type="BibTeX:Article" id="a6" year="2004" title="Fully Duplicated" journal="Journal Delta">
    <authors author="Ivan"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a7" year="2005" title="Fully Duplicated" journal="Journal Delta">
    <authors author="Judy"/>
    <authors author="Karen"/>
  </entries>

</BibTeX:BibTeXFile>