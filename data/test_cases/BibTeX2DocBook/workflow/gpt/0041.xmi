<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles for all four Article rules and journal/title uniqueness handling -->
  <!-- A1: unique title, unique journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art01" year="2001"
           title="Model Transformation Testing Framework"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A2 & A3: same title, different journals -->
  <!-- One in titleSet (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art02" year="2002"
           title="Duplicate Title Across Journals"
           journal="International Journal of Software Metrics">
    <authors author="Carol White"/>
  </entries>
  <!-- One not in titleSet (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art03" year="2003"
           title="Duplicate Title Across Journals"
           journal="Transactions on Embedded Systems">
    <authors author="David Brown"/>
  </entries>

  <!-- A4 & A5: different titles, same journal -->
  <!-- One in journalSet (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art04" year="2004"
           title="Shared Journal First Article"
           journal="Software Quality Journal">
    <authors author="Eve Davis"/>
  </entries>
  <!-- One not in journalSet (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art05" year="2005"
           title="Shared Journal Second Article"
           journal="Software Quality Journal">
    <authors author="Frank Miller"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- A6 & A7: same title and same journal -->
  <!-- One in both titleSet and journalSet (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art06" year="2006"
           title="Same Title Same Journal"
           journal="Journal of Testing Studies">
    <authors author="Grace Lee"/>
  </entries>
  <!-- One in neither (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art07" year="2007"
           title="Same Title Same Journal"
           journal="Journal of Testing Studies">
    <authors author="Henry King"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd01" year="2010"
           title="Formal Approaches to Model Transformations"
           school="University of Example">
    <authors author="Ivan Novak"/>
    <authors author="Jane Roe"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst01" year="2011"
           title="Empirical Studies in Model-Driven Engineering"
           school="Institute of Computing">
    <authors author="Kevin Young"/>
  </entries>

  <!-- InBook (Book subclass, BookTitledEntry, AuthoredEntry, DatedEntry, TitledEntry) -->
  <entries xsi:type="BibTeX:InBook" id="inb01" year="2012"
           title="Case Studies in Model Transformation"
           publisher="Springer Examples"
           chapter="3">
    <authors author="Laura Green"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book (Book, AuthoredEntry, DatedEntry, TitledEntry) -->
  <entries xsi:type="BibTeX:Book" id="bok01" year="2013"
           title="Foundations of Model-Driven Engineering"
           publisher="Example Press">
    <authors author="Michael Black"/>
    <authors author="Nina Grey"/>
  </entries>

  <!-- Proceedings, unique title (TitledEntry_Title_NoArticle with Proceedings) -->
  <entries xsi:type="BibTeX:Proceedings" id="pro01" year="2014"
           title="Proceedings of the First MDE Conference">
  </entries>

  <!-- Proceedings, duplicate title with pro03 -->
  <!-- This one will be in titleSet (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Proceedings" id="pro02" year="2015"
           title="Proceedings of the Shared Title Workshop">
  </entries>

  <!-- Proceedings, same title as pro02, not in titleSet (TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:Proceedings" id="pro03" year="2016"
           title="Proceedings of the Shared Title Workshop">
  </entries>

  <!-- InProceedings (Proceedings child, AuthoredEntry, BookTitledEntry, TitledEntry, DatedEntry) -->
  <entries xsi:type="BibTeX:InProceedings" id="inp01" year="2017"
           title="An InProceedings Example"
           booktitle="Proceedings of the First MDE Conference">
    <authors author="Oscar Perez"/>
    <authors author="Peter Quinn"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry, AuthoredEntry, DatedEntry, TitledEntry) -->
  <entries xsi:type="BibTeX:InCollection" id="inc01" year="2018"
           title="InCollection Chapter on Testing"
           booktitle="Handbook of Model Engineering"
           publisher="Example Press">
    <authors author="Quincy Reed"/>
    <authors author="Rachel Scott"/>
  </entries>

  <!-- Manual (TitledEntry only) -->
  <entries xsi:type="BibTeX:Manual" id="man01"
           title="User Guide for Transformation Tool">
  </entries>

  <!-- Unpublished (AuthoredEntry + TitledEntry) -->
  <entries xsi:type="BibTeX:Unpublished" id="unp01"
           title="Draft on Advanced Mutation Testing"
           note="Work in progress">
    <authors author="Sam Turner"/>
    <authors author="Tina Underwood"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- TechReport (AuthoredEntry, DatedEntry, TitledEntry) -->
  <entries xsi:type="BibTeX:TechReport" id="trp01" year="2019"
           title="Technical Report on Model Transformation Benchmarks">
    <authors author="Victor White"/>
  </entries>

  <!-- Booklet (DatedEntry only, untitled) -->
  <entries xsi:type="BibTeX:Booklet" id="bkl01" year="2020">
  </entries>

  <!-- Misc (BibTeXEntry only, untitled) -->
  <entries xsi:type="BibTeX:Misc" id="msc01">
  </entries>

</BibTeX:BibTeXFile>