<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise all four Article rules -->
  <!-- A1: unique title & unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Title One" journal="Unique Journal One">
    <authors author="Author A"/>
    <authors author="Author B"/>
  </entries>
  <!-- A2 & A3: same title, different journals -> Article_NoTitle_Journal on A3 -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Repeated Title" journal="Journal X">
    <authors author="Author C"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Repeated Title" journal="Journal Y">
    <authors author="Author D"/>
  </entries>
  <!-- A4 & A5: different titles, same journal -> Article_Title_NoJournal on A5 -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Title For Shared Journal 1" journal="Shared Journal">
    <authors author="Author E"/>
    <authors author="Author F"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Title For Shared Journal 2" journal="Shared Journal">
    <authors author="Author G"/>
  </entries>
  <!-- A6 & A7: same title and same journal -> Article_NoTitle_NoJournal on A7 -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Same Title Same Journal" journal="Journal Z">
    <authors author="Author H"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Same Title Same Journal" journal="Journal Z">
    <authors author="Author I"/>
    <authors author="Author J"/>
  </entries>

  <!-- Untitled entries for UntitledEntry (Booklet and Misc) -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1999"/>
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- Titled non-Article entries to exercise TitledEntry rules -->
  <!-- Unique titles: TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="Manual Unique Title">
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="TechReport Unique Title">
    <authors author="Author K"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2011" title="Proceedings Unique Title">
  </entries>
  <entries xsi:type="BibTeX:Book" id="BK1" year="2012" title="Book Unique Title" publisher="Unique Publisher One">
    <authors author="Author L"/>
    <authors author="Author M"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2013" title="InBook Unique Title" publisher="Unique Publisher Two" chapter="3">
    <authors author="Author N"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2014" title="InCollection Unique Title" publisher="Collection Publisher" booktitle="Collection Book Title">
    <authors author="Author O"/>
    <authors author="Author P"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2015" title="MasterThesis Unique Title" school="Unique School One">
    <authors author="Author Q"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2016" title="PhDThesis Unique Title" school="Unique School Two">
    <authors author="Author R"/>
    <authors author="Author S"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Unpublished Unique Title" note="Unpublished Note One">
    <authors author="Author T"/>
    <authors author="Author U"/>
  </entries>

  <!-- Duplicated-title non-Article pair: one in titled set, one out -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="2017" title="Shared NonArticle Title" publisher="Another Publisher">
    <authors author="Author V"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2018" title="Shared NonArticle Title">
    <authors author="Author W"/>
    <authors author="Author X"/>
  </entries>
</BibTeX:BibTeXFile>