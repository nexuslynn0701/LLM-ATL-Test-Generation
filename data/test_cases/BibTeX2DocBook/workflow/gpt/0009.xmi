<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles designed to exercise all four Article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a1" year="2001" title="Unique Title 1" journal="Unique Journal 1">
    <authors author="Alice A."/>
    <authors author="Bob B."/>
  </entries>
  <!-- A2 & A3: same title, different journals ->
       A2 in titleSet, journalSet -> Article_Title_Journal
       A3 not in titleSet, in journalSet -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="a2" year="2002" title="Shared Title T1" journal="Journal X">
    <authors author="Carol C."/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a3" year="2003" title="Shared Title T1" journal="Journal Y">
    <authors author="Dave D."/>
  </entries>
  <!-- A4 & A5: different titles, same journal ->
       A4 in titleSet, in journalSet? Only one rep per journal set:
         A4 is first for Journal Z -> in journalSet -> Article_Title_Journal
       A5 not in journalSet -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a4" year="2004" title="Title JZ 1" journal="Journal Z">
    <authors author="Eve E."/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a5" year="2005" title="Title JZ 2" journal="Journal Z">
    <authors author="Frank F."/>
  </entries>
  <!-- A6 & A7: same title and same journal ->
       A6 in titleSet and in journalSet -> Article_Title_Journal
       A7 not in either set -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a6" year="2006" title="Duplicate TJ" journal="Dup Journal">
    <authors author="Grace G."/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a7" year="2007" title="Duplicate TJ" journal="Dup Journal">
    <authors author="Heidi H."/>
  </entries>

  <!-- Untitled entries (Misc and Booklet) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Misc" id="m2"/>
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2010"/>
  <entries xsi:type="BibTeX:Booklet" id="bkl2" year="2011"/>

  <!-- Titled non-Article entries to exercise TitledEntry rules -->
  <!-- Distinct title, non-Article -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Manual Title 1"/>
  <!-- Two Books with same title: book1 in titleSet, book2 not ->
       book1 -> TitledEntry_Title_NoArticle, book2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" year="1999" title="Shared Book Title" publisher="Publisher P1">
    <authors author="Alice A."/>
    <authors author="Carol C."/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book2" year="2000" title="Shared Book Title" publisher="Publisher P2">
    <authors author="Bob B."/>
    <authors author="Dave D."/>
  </entries>

  <!-- InBook with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="ib1" year="2012" title="InBook Unique Title" publisher="InBook Publisher" chapter="3">
    <authors author="Ivan I."/>
  </entries>

  <!-- PhDThesis and MasterThesis with distinct titles ->
       both go through TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2013" title="PhD Thesis Title" school="PhD School">
    <authors author="Grace G."/>
    <authors author="Ivan I."/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="2014" title="Master Thesis Title" school="Master School">
    <authors author="Heidi H."/>
  </entries>

  <!-- InCollection and InProceedings with distinct titles -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" year="2015" title="InCollection Title" publisher="IC Publisher" booktitle="IC Booktitle">
    <authors author="Frank F."/>
    <authors author="Bob B."/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="ip1" year="2016" title="InProceedings Title" booktitle="IP Booktitle">
    <authors author="Alice A."/>
    <authors author="Eve E."/>
  </entries>

  <!-- Proceedings with duplicate title to exercise Proceedings + TitledEntry_NoTitle_NoArticle -->
  <!-- proc1 in titleSet, proc2 not -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2017" title="Shared Proc Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2018" title="Shared Proc Title"/>

  <!-- TechReports: one unique title, one sharing title with an Article
       Both non-Article, so only title uniqueness across all TitledEntry matters.
       tr1 unique title -> TitledEntry_Title_NoArticle
       tr2 shares title "Shared Title T1" with Article a2/a3; the titleSet picks
       one representative among all with that title (could be an Article or this),
       but all TitledEntry (including Articles) participate. To keep a TechReport
       in the titleSet for this title, we give it a new title instead, to avoid
       interfering with Article titleSet behavior already designed above. -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2019" title="TechReport Unique Title">
    <authors author="Carol C."/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2020" title="Another TechReport Title">
    <authors author="Dave D."/>
  </entries>

  <!-- Unpublished entries with distinct titles -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="up1" title="Unpublished Title 1" note="Note for UP1">
    <authors author="Alice A."/>
    <authors author="Frank F."/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="up2" title="Unpublished Title 2" note="Note for UP2">
    <authors author="Bob B."/>
    <authors author="Grace G."/>
  </entries>
</BibTeX:BibTeXFile>