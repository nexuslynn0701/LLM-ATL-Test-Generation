<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article A: unique title and unique journal -->
  <entries xsi:type="BibTeX:Article" id="artA" year="2001" title="Unique Title A" journal="Journal A">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- Article B1 & B2: same title, same journal (duplicates both) -->
  <entries xsi:type="BibTeX:Article" id="artB1" year="2002" title="Shared Title BJ" journal="Journal B">
    <authors author="Carol Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artB2" year="2003" title="Shared Title BJ" journal="Journal B">
    <authors author="Dave Scientist"/>
  </entries>

  <!-- Article C1 & C2: same title, different journals (duplicate title only) -->
  <entries xsi:type="BibTeX:Article" id="artC1" year="2004" title="Shared Title C" journal="Journal C1">
    <authors author="Eve Analyst"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artC2" year="2005" title="Shared Title C" journal="Journal C2">
    <authors author="Frank Engineer"/>
  </entries>

  <!-- Article D1 & D2: different titles, same journal (duplicate journal only) -->
  <entries xsi:type="BibTeX:Article" id="artD1" year="2006" title="Title D1" journal="Journal D">
    <authors author="Grace Developer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artD2" year="2007" title="Title D2" journal="Journal D">
    <authors author="Heidi Architect"/>
  </entries>

  <!-- Manual entries (titled, no authors) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Manual One"/>
  <entries xsi:type="BibTeX:Manual" id="man2" title="Manual Two"/>

  <!-- Unpublished entries (titled, authors, note) with same title to explore title-duplication behaviour -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Unpub Shared Title" note="Note One">
    <authors author="Ivan Theorist"/>
    <authors author="Judy Practitioner"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Unpub Shared Title" note="Note Two">
    <authors author="Alice Author"/>
  </entries>

  <!-- TechReport entries: one unique title, one sharing an Article title -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2010" title="TechReport Unique Title">
    <authors author="Karl Reviewer"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2011" title="Title D1">
    <authors author="Leo Consultant"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- Proceedings entries: one unique title, two with same title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2012" title="Proceedings Title P1"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2013" title="Proceedings Shared Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc3" year="2014" title="Proceedings Shared Title"/>

  <!-- Book entries -->
  <!-- Book1: unique titled, authors, publisher -->
  <entries xsi:type="BibTeX:Book" id="book1" year="2015" title="Book Title One" publisher="Publisher One">
    <authors author="Mallory Author"/>
    <authors author="Niaj Writer"/>
  </entries>

  <!-- Book2 & Book3: same title, different years/publishers to create title duplicates -->
  <entries xsi:type="BibTeX:Book" id="book2" year="2016" title="Book Shared Title" publisher="Publisher Two">
    <authors author="Oscar Editor"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book3" year="2017" title="Book Shared Title" publisher="Publisher Three">
    <authors author="Peggy Contributor"/>
    <authors author="Quinn Reviewer"/>
  </entries>

  <!-- InBook: subclass of Book with chapter -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2018" title="InBook Title One" publisher="Publisher Four" chapter="1">
    <authors author="Rupert Author"/>
  </entries>

  <!-- InCollection: subclass of Book, also BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection" id="incol1" year="2019" title="InCollection Title" publisher="Publisher Five" booktitle="Collected Works Volume 1">
    <authors author="Sybil Researcher"/>
    <authors author="Trent Collaborator"/>
  </entries>

  <!-- InProceedings: Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2020" title="InProceedings Unique Title" booktitle="Conference Book A">
    <authors author="Uma Speaker"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" year="2021" title="InProceedings Shared Title" booktitle="Conference Book B">
    <authors author="Victor Presenter"/>
    <authors author="Wendy CoAuthor"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inproc3" year="2022" title="InProceedings Shared Title" booktitle="Conference Book B">
    <authors author="Xavier Contributor"/>
  </entries>

  <!-- Booklet entries: dated, not titled -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet2" year="2000"/>

  <!-- Misc entries: untitled, un-authored, un-dated -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Misc" id="misc2"/>

  <!-- PhDThesis entries: ThesisEntry (titled, authored, dated, school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="1995" title="PhD Unique Title" school="University One">
    <authors author="Yvonne Doctor"/>
  </entries>
  <!-- PhDThesis sharing a title with a Book to create cross-type title duplicates -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd2" year="1996" title="Book Shared Title" school="University Two">
    <authors author="Zack Scholar"/>
  </entries>

  <!-- MasterThesis entries: more ThesisEntry coverage -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="1997" title="Master Thesis One" school="Institute A">
    <authors author="Alice Author"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mst2" year="1998" title="Master Shared Title" school="Institute B">
    <authors author="Carol Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mst3" year="1999" title="Master Shared Title" school="Institute C">
    <authors author="Trent Collaborator"/>
  </entries>

</BibTeX:BibTeXFile>