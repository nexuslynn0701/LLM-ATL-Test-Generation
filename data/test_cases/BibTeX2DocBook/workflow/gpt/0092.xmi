<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles (exercise Article_* rules and journals list) -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Model-Driven Testing in Practice" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A2: duplicate title with A3, unique journal -> Article_NoTitle_Journal (duplicate title) -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Unified Transformation Language" journal="Software Transformation Journal">
    <authors author="Carol White"/>
  </entries>

  <!-- A3: same title as A2, same journal as A4 -> Article_NoTitle_NoJournal (dup title + dup journal) -->
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Unified Transformation Language" journal="International Journal of Metamodeling">
    <authors author="David Black"/>
    <authors author="Eve Green"/>
  </entries>

  <!-- A4: unique title, duplicate journal with A3 -> Article_Title_NoJournal (dup journal) -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Traceability Techniques for ATL" journal="International Journal of Metamodeling">
    <authors author="Frank Gray"/>
  </entries>

  <!-- A5: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Incremental Model Synchronization" journal="Transactions on Software Architecture">
    <authors author="Grace Lee"/>
    <authors author="Henry King"/>
  </entries>

  <!-- TechReport (titled, authored, dated) -->
  <!-- TR1: unique title among titled entries -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2006" title="Scalable Model Transformation Engines">
    <authors author="Ian Brown"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- TechReport with duplicated title (to trigger TitledEntry_NoTitle_NoArticle) -->
  <!-- TR2: same title as MT1 & BK1 -> not in unique-title set -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2007" title="Quality-Driven Model Transformations">
    <authors author="John Miller"/>
  </entries>

  <!-- Unpublished (authored, titled, no date) -->
  <!-- U1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="up1" title="Draft of MDE Guidelines" note="Under internal review">
    <authors author="Karen Young"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Manual (titled only) -->
  <!-- M1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL User Manual Version 1.0"/>
  
  <!-- Proceedings (titled, dated; base type, not InProceedings) -->
  <!-- P1: unique title -> TitledEntry_Title_NoArticle; base Proceedings should be tested -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2008" title="Proceedings of the MDE Conference"/>

  <!-- Proceedings with duplicated title (to hit TitledEntry_NoTitle_NoArticle on one of them) -->
  <!-- P2: same title as P3 -> one in unique set, one out -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2009" title="Symposium on Model Transformation"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc3" year="2010" title="Symposium on Model Transformation"/>

  <!-- Booklet (untitled, dated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2011"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet2" year="2012"/>

  <!-- Misc (untitled, no date) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Misc" id="misc2"/>

  <!-- Book (authored, dated, titled, publisher) -->
  <!-- BK1: shared title with MT1 and TR2 to exercise title-dup set for non-Article -->
  <entries xsi:type="BibTeX:Book" id="book1" year="2013" title="Quality-Driven Model Transformations" publisher="Springer MDE Press">
    <authors author="Laura Scott"/>
    <authors author="Michael Adams"/>
  </entries>

  <!-- BK2: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book2" year="2014" title="Foundations of Model-Driven Engineering" publisher="Academic Modeling House">
    <authors author="Nancy Turner"/>
  </entries>

  <!-- InBook (Book subclass, authored, dated, titled, publisher, chapter) -->
  <!-- IB1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2015" title="Chapter on Test Case Generation" publisher="Testing Books Ltd" chapter="5">
    <authors author="Oliver Clark"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry; authored, dated, titled, publisher, booktitle) -->
  <!-- IC1: unique title, unique booktitle -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" year="2016" title="Reusable Transformation Patterns" publisher="Patterns Publishing" booktitle="Handbook of Software Patterns">
    <authors author="Peter Davis"/>
  </entries>

  <!-- InProceedings (Proceedings + Authored + BookTitledEntry; to test that child of Proceedings uses TitledEntry rules, not base Proceedings rules directly) -->
  <!-- IP1: unique title, unique booktitle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2017" title="Evaluating Model Transformation Quality" booktitle="Proceedings of the MDE Conference">
    <authors author="Quentin Evans"/>
    <authors author="Rachel Ford"/>
  </entries>

  <!-- ThesisEntry subclasses: PhDThesis and MasterThesis (authored, dated, titled, school) -->
  <!-- PhD1: unique title -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2018" title="Consistency Management in Bidirectional Transformations" school="University of Modelia">
    <authors author="Sarah Hughes"/>
    <authors author="Ian Brown"/>
  </entries>

  <!-- MasterThesis with duplicated title (to exercise TitledEntry_NoTitle_NoArticle) -->
  <!-- MT1: same title as BK1 and TR2 -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="2019" title="Quality-Driven Model Transformations" school="Institute of Software Design">
    <authors author="Tom Johnson"/>
  </entries>

</BibTeX:BibTeXFile>