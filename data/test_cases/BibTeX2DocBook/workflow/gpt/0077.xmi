<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles: exercise Article_Title_Journal (unique title & journal), Article_NoTitle_Journal (duplicate title, unique journal), Article_Title_NoJournal (unique title, duplicate journal) -->
  <!-- A1: unique title and journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Static Analysis for Security" journal="Journal of Secure Software">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>
  <!-- A2: shares title with A3, unique journal -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Model Transformations in Practice" journal="Software Engineering Today">
    <authors author="Carol White"/>
  </entries>
  <!-- A3: same title as A2, different (unique) journal -->
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Model Transformations in Practice" journal="International Journal of MDE">
    <authors author="Dave Brown"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- A4: unique title, but journal duplicated with A5 -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Testing Model Transformations" journal="Modeling Journal">
    <authors author="Eve Black"/>
  </entries>
  <!-- A5: different title, same journal as A4 -->
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Advanced Topics in ATL" journal="Modeling Journal">
    <authors author="Frank Green"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Booklets: UntitledEntry rule (no title; DatedEntry only) -->
  <entries xsi:type="BibTeX:Booklet" id="bkt1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="bkt2" year="2010"/>

  <!-- Misc: UntitledEntry rule (no title, no date) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Misc" id="misc2"/>

  <!-- Manual: TitledEntry rules, unique title -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL Language Reference"/>

  <!-- Manuals with duplicate title to trigger TitledEntry_NoTitle_NoArticle for man3 -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="User Guide for MDE Tools"/>
  <entries xsi:type="BibTeX:Manual" id="man3" title="User Guide for MDE Tools"/>

  <!-- TechReports: some unique title, some duplicate with Article to test title set across types -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2012" title="Static Analysis for Security">
    <authors author="Grace Hall"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2013" title="Scalable Model Checking">
    <authors author="Henry King"/>
    <authors author="Ian Lee"/>
  </entries>

  <!-- Unpublished: various titles, one duplicate with TechReport title -->
  <entries xsi:type="BibTeX:Unpublished" id="up1" title="Draft on Model Transformations" note="In preparation">
    <authors author="Alice Smith"/>
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="up2" title="Static Analysis for Security" note="To appear">
    <authors author="Dave Brown"/>
  </entries>

  <!-- PhDThesis: TitledEntry rules -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2015" title="Model Transformation Testing" school="University of Example">
    <authors author="John Doe"/>
  </entries>

  <!-- MasterThesis: also TitledEntry rules, with a duplicate title to force NoTitle for one -->
  <entries xsi:type="BibTeX:MasterThesis" id="msc1" year="2016" title="Incremental Model Transformations" school="Tech University">
    <authors author="Jane Roe"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="msc2" year="2017" title="Incremental Model Transformations" school="Tech University">
    <authors author="Kyle Raynor"/>
  </entries>

  <!-- Book: Authored, Dated, Titled, unique title -->
  <entries xsi:type="BibTeX:Book" id="book1" year="2008" title="Introduction to Model-Driven Engineering" publisher="MDE Press">
    <authors author="Laura Nash"/>
    <authors author="Michael Scott"/>
  </entries>

  <!-- Book with duplicate title to trigger TitledEntry_NoTitle_NoArticle for book3 -->
  <entries xsi:type="BibTeX:Book" id="book2" year="2010" title="Patterns of Model Transformations" publisher="Patterns House">
    <authors author="Nina Owens"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book3" year="2012" title="Patterns of Model Transformations" publisher="Patterns House">
    <authors author="Oscar Price"/>
    <authors author="Nina Owens"/>
  </entries>

  <!-- InBook: child of Book, also BookTitledEntry, has chapter -->
  <entries xsi:type="BibTeX:InBook" id="inb1" year="2011" title="Case Studies in MDE" publisher="MDE Press" chapter="3">
    <authors author="Paul Quinn"/>
    <authors author="Michael Scott"/>
  </entries>

  <!-- Proceedings: standalone (not children), unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2020" title="Proceedings of the MDE Conference"/>
  <!-- Proceedings with duplicate title to exercise NoTitle on proc3 -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2019" title="Symposium on Model Transformation Testing"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc3" year="2021" title="Symposium on Model Transformation Testing"/>

  <!-- InProceedings: child of Proceedings and Authored & BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings" id="inp1" year="2020" title="Evaluating Transformation Quality" booktitle="Proceedings of the MDE Conference">
    <authors author="Rachel Stone"/>
    <authors author="John Doe"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inp2" year="2019" title="Mutation Testing for ATL" booktitle="Symposium on Model Transformation Testing">
    <authors author="Steve Taylor"/>
    <authors author="Jane Roe"/>
  </entries>

  <!-- InCollection: child of Book & BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection" id="inc1" year="2009" title="Chapter on Model Weaving" booktitle="Introduction to Model-Driven Engineering" publisher="MDE Press">
    <authors author="Uma Vega"/>
    <authors author="Laura Nash"/>
  </entries>
</BibTeX:BibTeXFile>