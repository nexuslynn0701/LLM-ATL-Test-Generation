<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Article that is unique both in title and journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model Transformation Testing" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Articles sharing the same title but different journals (one Title+Journal, one NoTitle+Journal) -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Duplicate Title Case" journal="Journal Alpha">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Duplicate Title Case" journal="Journal Beta">
    <authors author="Dave Brown"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Articles sharing the same journal but different titles (one Title+Journal, one Title+NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Shared Journal First" journal="Journal Gamma">
    <authors author="Eve Black"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Shared Journal Second" journal="Journal Gamma">
    <authors author="Frank Green"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Articles sharing same title and same journal (one Title+Journal, one NoTitle+NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Same Title And Journal" journal="Journal Delta">
    <authors author="Grace Miller"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Same Title And Journal" journal="Journal Delta">
    <authors author="Henry Wilson"/>
    <authors author="Carol White"/>
  </entries>

  <!-- Booklet (UntitledEntry rule via BibTeXEntry without title) -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1999"/>

  <!-- Misc (UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- Manual, unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="Manual of Testing Patterns"/>

  <!-- Manuals with same title (first triggers Title_NoArticle, second NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:Manual" id="MAN2" title="Repeated Manual Title"/>
  <entries xsi:type="BibTeX:Manual" id="MAN3" title="Repeated Manual Title"/>

  <!-- TechReport, unique title -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="TechReport on Model Coverage">
    <authors author="Ian Clark"/>
  </entries>

  <!-- TechReports with same title (one Title_NoArticle, one NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2011" title="Duplicated TechReport Title">
    <authors author="John King"/>
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR3" year="2012" title="Duplicated TechReport Title">
    <authors author="Karl Young"/>
  </entries>

  <!-- Book (base Book, not subtype), unique title -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="1995" title="Foundations of MDE" publisher="MDE Press">
    <authors author="Laura Scott"/>
    <authors author="Michael Adams"/>
  </entries>

  <!-- Book used as parent type only via InCollection -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="1998" title="Collection Host Book" publisher="Host Publisher">
    <authors author="Nancy Turner"/>
  </entries>

  <!-- InBook (Book + extra chapter) with distinct title -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2000" title="Chapter-Based Testing" publisher="ChapPub" chapter="3">
    <authors author="Oscar Perry"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Proceedings (base type), one unique title and two with same title to exercise both TitledEntry rules -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2015" title="MDE Symposium"/>
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2016" title="Duplicated Proceedings Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="PR3" year="2017" title="Duplicated Proceedings Title"/>

  <!-- InProceedings with unique title, booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2018" title="InProceedings First" booktitle="MDE Symposium 2018">
    <authors author="Peter Quinn"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- InProceedings sharing title (Title_NoArticle + NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2019" title="Shared InProc Title" booktitle="Conf One">
    <authors author="Rachel Stone"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP3" year="2020" title="Shared InProc Title" booktitle="Conf Two">
    <authors author="Steve Taylor"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- InCollection with unique title -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2013" title="InCollection Case Study" publisher="Case Publisher" booktitle="Collection Host Book">
    <authors author="Tom Underwood"/>
  </entries>

  <!-- InCollection with duplicated title -->
  <entries xsi:type="BibTeX:InCollection" id="IC2" year="2014" title="Duplicated InCollection Title" publisher="Another Publisher" booktitle="Alt Collection">
    <authors author="Uma Vance"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="IC3" year="2015" title="Duplicated InCollection Title" publisher="Another Publisher 2" booktitle="Alt Collection 2">
