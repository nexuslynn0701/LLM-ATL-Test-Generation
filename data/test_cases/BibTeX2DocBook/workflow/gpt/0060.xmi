<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles (to exercise all Article_* rules and journals list) -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Adaptive Service Composition" journal="Journal of Web Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- A2: same title as A1, different journal -> Article_NoTitle_Journal (no title, journal unique) -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2003" title="Adaptive Service Composition" journal="International Journal of Software Tools">
    <authors author="Carol White"/>
  </entries>
  <!-- A3: different title, journal J2 (duplicate journal with A4) -> Article_Title_NoJournal (title unique, journal not in journalSet) -->
  <entries xsi:type="BibTeX:Article" id="art3" year="2005" title="Model Transformations in Practice" journal="Software Architecture Notes">
    <authors author="David Brown"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- A4: same journal as A3 but different title -> Article_NoTitle_NoJournal (title duplicate with A5, journal duplicate with A3) -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2007" title="Test-Driven Transformation Development" journal="Software Architecture Notes">
    <authors author="Eve Black"/>
    <authors author="Frank Green"/>
  </entries>
  <!-- A5: same title as A4, different journal J4 -> Article_NoTitle_Journal (title duplicate, journal unique) -->
  <entries xsi:type="BibTeX:Article" id="art5" year="2008" title="Test-Driven Transformation Development" journal="Modeling Systems Quarterly">
    <authors author="Bob Johnson"/>
  </entries>
  <!-- A6: unique title, same journal as A2 (creates second article in J3) -> Article_Title_NoJournal (title unique, journal duplicate) -->
  <entries xsi:type="BibTeX:Article" id="art6" year="2010" title="Quality-Driven Model Evolution" journal="International Journal of Software Tools">
    <authors author="Carol White"/>
    <authors author="Helen King"/>
  </entries>

  <!-- Unpublished entries (titled, not Article) -->
  <!-- U1: title appears only once among TitledEntry -> goes to titledEntrySet -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft Guidelines for MDE Testing" note="Internal technical note">
    <authors author="Ian Gray"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- U2: title appears twice with U3 -> only U2 in titledEntrySet -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Preliminary Results on Traceability" note="First version submitted">
    <authors author="Jack Miller"/>
  </entries>
  <!-- U3: same title as U2 -> not in titledEntrySet -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub3" title="Preliminary Results on Traceability" note="Extended technical report">
    <authors author="Kate Wilson"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Manual entries (titled, no authors/year) -->
  <!-- M1: unique manual title -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL User Guide"/>
  <!-- M2 & M3: same title to exercise TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="EMF Reference Manual"/>
  <entries xsi:type="BibTeX:Manual" id="man3" title="EMF Reference Manual"/>

  <!-- TechReport entries (titled, authored, dated) -->
  <!-- R1: unique title -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2012" title="Scalable Model Transformation Engines">
    <authors author="Laura Scott"/>
  </entries>
  <!-- R2: shares title with TR3 to force duplicate title scenario -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2013" title="Evaluation of Transformation Testing Approaches">
    <authors author="Mike Adams"/>
    <authors author="Nina Brown"/>
  </entries>
  <!-- R3: same title as TR2 -->
  <entries xsi:type="BibTeX:TechReport" id="tr3" year="2014" title="Evaluation of Transformation Testing Approaches">
    <authors author="Owen Clark"/>
  </entries>

  <!-- Thesis entries: PhDThesis and MasterThesis -->
  <!-- P1: PhDThesis, unique title -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2011" title="Formal Foundations of Model Transformations" school="Tech University">
    <authors author="Peter Lewis"/>
    <authors author="Quinn Baker"/>
  </entries>
  <!-- P2 & P3: PhDThesis with same title -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd2" year="2010" title="Analysis of Model Transformation Languages" school="City University">
    <authors author="Rachel Young"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd3" year="2015" title="Analysis of Model Transformation Languages" school="State University">
    <authors author="Steve Hall"/>
  </entries>
  <!-- MTh1: MasterThesis with unique title -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="2016" title="Empirical Studies on ATL Transformations" school="Institute of Technology">
    <authors author="Tom Reed"/>
    <authors author="Uma Patel"/>
  </entries>

  <!-- Book and its subclasses -->
  <!-- B1: Book with unique title -->
  <entries xsi:type="BibTeX:Book" id="book1" year="2009" title="Principles of Model-Driven Engineering" publisher="Springer Press">
    <authors author="Victor Hughes"/>
    <authors author="Wendy Stone"/>
  </entries>
  <!-- B2 & B3: Books with same title -->
  <entries xsi:type="BibTeX:Book" id="book2" year="2005" title="Fundamentals of Software Architecture" publisher="TechBooks Ltd.">
    <authors author="Xavier Long"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book3" year="2006" title="Fundamentals of Software Architecture" publisher="Global Science">
    <authors author="Yvonne Price"/>
    <authors author="Zack Turner"/>
  </entries>

  <!-- InBook: subclass of Book, also uses chapter -->
  <!-- IB1: unique title to be in titledEntrySet -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2004" title="Case Studies in MDE Education" publisher="Academic Press" chapter="3">
    <authors author="Alice Smith"/>
    <authors author="Mike Adams"/>
  </entries>
  <!-- IB2: shares title with IB3 to trigger duplicate title -->
  <entries xsi:type="BibTeX:InBook" id="inbook2" year="2004" title="Reusable Transformation Patterns" publisher="Academic Press" chapter="5">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="inbook3" year="2007" title="Reusable Transformation Patterns" publisher="TechBooks Ltd." chapter="7">
    <authors author="David Brown"/>
  </entries>

  <!-- InCollection: subclass of Book and BookTitledEntry (has booktitle) -->
  <!-- IC1: unique title -->
  <entries xsi:type="BibTeX:InCollection" id="inc1" year="2013" title="Traceability in Model Transformations" publisher="Springer Press" booktitle="Proceedings of the MDE Workshop">
    <authors author="Eve Black"/>
    <authors author="Helen King"/>
  </entries>
  <!-- IC2 & IC3: share same title -->
  <entries xsi:type="BibTeX:InCollection" id="inc2" year="2014" title="Industrial Experiences with ATL" publisher="Global Science" booktitle="Advances in Model-Driven Engineering">
    <authors author="Ian Gray"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="inc3" year="2015" title="Industrial Experiences with ATL" publisher="Global Science" booktitle="Recent Trends in Software Modeling">
    <authors author="Jack Miller"/>
  </entries>

  <!-- Proceedings and InProceedings -->
  <!-- PR1: Proceedings with unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2018" title="International Conference on Model Transformations"/>
  <!-- PR2 & PR3: same title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2019" title="Symposium on Software Modeling"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc3" year="2020" title="Symposium on Software Modeling"/>
  <!-- IP1: InProceedings with unique title and booktitle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2018" title="Testing ATL Transformations" booktitle="International Conference on Model Transformations">
    <authors author="Laura Scott"/>
    <authors author="Mike Adams"/>
  </entries>
  <!-- IP2 & IP3: same title to force duplicate title behavior -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" year="2019" title="Scenarios for Model Transformation Testing" booktitle="Symposium on Software Modeling">
    <authors author="Nina Brown"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inproc3" year="2020" title="Scenarios for Model Transformation Testing" booktitle="Workshop on Empirical Software Engineering">
    <authors author="Owen Clark"/>
    <authors author="Peter Lewis"/>
  </entries>

  <!-- Booklet (DatedEntry, not titled) to trigger UntitledEntry rule -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2002"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet2" year="2003"/>

  <!-- Misc (plain BibTeXEntry, no title/year) to trigger UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Misc" id="misc2"/>
</BibTeX:BibTeXFile>