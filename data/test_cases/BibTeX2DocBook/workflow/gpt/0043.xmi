<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article A1: unique title, unique journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="MDE for Embedded Systems" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article A2: same title as A3, unique journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Testing Model Transformations" journal="Software Quality Journal">
    <authors author="Carol White"/>
  </entries>

  <!-- Article A3: same title as A2, same journal as A4 (duplicate title, duplicate journal) -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Testing Model Transformations" journal="International Journal on Software Tools">
    <authors author="Alice Smith"/>
    <authors author="David Brown"/>
  </entries>

  <!-- Article A4: unique title, same journal as A3 -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Incremental Transformation Engines" journal="International Journal on Software Tools">
    <authors author="Eve Black"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Booklet B1: untitled, dated -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1999"/>

  <!-- Misc M1: untitled, undated -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- Manual MAN1: titled, not authored, not dated -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="ATL User Guide"/>

  <!-- Manual MAN2: another distinct Manual title -->
  <entries xsi:type="BibTeX:Manual" id="MAN2" title="EMF Core Reference"/>

  <!-- TechReport TR1: titled, authored, dated -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="Scalable Model Transformations">
    <authors author="Frank Green"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book BK1: plain Book (no subclasses), unique title -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="2008" title="Model-Driven Engineering in Practice" publisher="TechBooks Press">
    <authors author="George Gray"/>
    <authors author="Carol White"/>
  </entries>

  <!-- InBook IB1: same title as BK2, same publisher as BK2, has chapter -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2012" title="Domain-Specific Modeling Patterns" publisher="Architecture Press" chapter="3">
    <authors author="Helen Clark"/>
    <authors author="Ian Miller"/>
  </entries>

  <!-- Book BK2: plain Book, same title as IB1, same publisher -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="2011" title="Domain-Specific Modeling Patterns" publisher="Architecture Press">
    <authors author="Jack Wilson"/>
  </entries>

  <!-- Proceedings PR1: plain Proceedings, unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2015" title="Proceedings of the MDE Conference"/>

  <!-- Proceedings PR2: plain Proceedings, same title as PR1 (to trigger NoTitle variant) -->
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2016" title="Proceedings of the MDE Conference"/>

  <!-- InProceedings IP1: authored, has booktitle, dated, unique title -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2013" title="Refactoring ATL Transformations" booktitle="Proceedings of the MDE Conference">
    <authors author="Laura King"/>
    <authors author="Mike Turner"/>
  </entries>

  <!-- InCollection IC1: child of Book, has booktitle and publisher -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2009" title="Traceability in Model Transformations" booktitle="Handbook of Model-Driven Engineering" publisher="TechBooks Press">
    <authors author="Nina Adams"/>
    <authors author="Oscar Perez"/>
  </entries>

  <!-- PhDThesis PHD1 -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2005" title="Verification of Model Transformations" school="University of Example">
    <authors author="Peter Young"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- MasterThesis MT1 -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2007" title="Testing Strategies for ATL" school="Institute of Computing">
    <authors author="Quentin Hall"/>
  </entries>

  <!-- Unpublished U1 -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Industrial Adoption of MDE" note="Submitted to Journal of Model Engineering">
    <authors author="Rachel Scott"/>
    <authors author="Bob Johnson"/>
  </entries>

</BibTeX:BibTeXFile>