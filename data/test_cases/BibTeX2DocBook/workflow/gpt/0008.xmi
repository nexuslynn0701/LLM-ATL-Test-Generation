<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise Article_* rules -->
  <!-- a1: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Model Transformation Testing" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- a2 and a3: same title, different journals -> Article_Title_Journal (one per journal) -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Duplicate Titles in BibTeX" journal="Software Quality Journal">
    <authors author="Carol White"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Duplicate Titles in BibTeX" journal="International Journal of Software Tools">
    <authors author="Dave Brown"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- a4 and a5: unique title, same journal -> Article_Title_NoJournal (two articles in same journal name) -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Testing Transformations with OCL" journal="Shared Journal">
    <authors author="Eve Black"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Coverage Criteria for ATL" journal="Shared Journal">
    <authors author="Frank Green"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- a6 and a7: same title and same journal -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art6" year="2006" title="Repeated Article in Same Journal" journal="Journal of Repetition">
    <authors author="Helen Clark"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art7" year="2007" title="Repeated Article in Same Journal" journal="Journal of Repetition">
    <authors author="Ian King"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport to exercise TitledEntry rules -->
  <!-- tr1 and tr2 share same title -> TitledEntry_Title_NoArticle for one, TitledEntry_NoTitle_NoArticle for the other -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2008" title="Empirical Study on Model Transformations">
    <authors author="Jack Miller"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2009" title="Empirical Study on Model Transformations">
    <authors author="Karen Adams"/>
    <authors author="Laura Scott"/>
  </entries>

  <!-- Manual with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL User Guide">
  </entries>

  <!-- Manual sharing a title with a Book, to create duplicate title across different types -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="Comprehensive MDE Handbook">
  </entries>

  <!-- Book with same title as man2 -> only one of them in titleSet; both exercise TitledEntry rules -->
  <entries xsi:type="BibTeX:Book" id="book1" year="2010" title="Comprehensive MDE Handbook" publisher="MDE Press">
    <authors author="Mike Turner"/>
    <authors author="Nina Perez"/>
  </entries>

  <!-- InBook unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2011" title="Chapter on Transformation Testing" publisher="Academic Publishers" chapter="3">
    <authors author="Oscar Reed"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- PhDThesis unique title -> TitledEntry_Title_NoArticle and Thesis-specific text -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2012" title="Formal Verification of Model Transformations" school="Technical University">
    <authors author="Peter Young"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- MasterThesis unique title -> TitledEntry_Title_NoArticle (commented constraint in OCL but still transformed) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="2013" title="Automated Testing of ATL Rules" school="Engineering Institute">
    <authors author="Quinn Hall"/>
  </entries>

  <!-- Proceedings: p1 and p2 same title, different years -> TitledEntry_* and OCL13 selection on Proceedings only -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2014" title="Proceedings of the MDE Conference">
  </entries>

  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2015" title="Proceedings of the MDE Conference">
  </entries>

  <!-- InProceedings unique title, sharing booktitle with inproc2 to trigger BookTitledEntry part -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2016" title="Paper on ATL Mutation Testing" booktitle="Proceedings of the Testing Workshop">
    <authors author="Rachel Fox"/>
    <authors author="Jack Miller"/>
  </entries>

  <!-- Second InProceedings with same booktitle but different title -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" year="2017" title="Paper on Trace Models" booktitle="Proceedings of the Testing Workshop">
    <authors author="Steve Grant"/>
  </entries>

  <!-- InCollection unique title, refers to same publisher as book1 to reuse string -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" year="2018" title="Case Studies in MDE" publisher="MDE Press" booktitle="Collected Works on Software Engineering">
    <authors author="Tina Holmes"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Unpublished entries to exercise note and duplicate titles -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Early Draft on MDE Quality" note="Internal report version 1">
    <authors author="Uma Norris"/>
    <authors author="Victor Price"/>
  </entries>

  <!-- unpub2 shares title with unpub1 -> TitledEntry_NoTitle_NoArticle for the second -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Early Draft on MDE Quality" note="Revised version with corrections">
    <authors author="Walter Reed"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Additional Unpublished with unique title -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub3" title="Position Paper on Model Management" note="To appear">
    <authors author="Yvonne Cole"/>
  </entries>

  <!-- Booklet entries (Dated but not Titled, UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2019"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet2" year="2020"/>

  <!-- Booklet sharing year with none, still distinct -->
  <entries xsi:type="BibTeX:Booklet" id="booklet3" year="2021"/>

  <!-- Misc entry to exercise pure UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Misc" id="misc2"/>

</BibTeX:BibTeXFile>