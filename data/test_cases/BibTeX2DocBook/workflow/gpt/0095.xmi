<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article group A: same title, same journal (exercises Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Shared Title A" journal="Shared Journal A">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title A" journal="Shared Journal A">
    <authors author="Charlie Gamma"/>
  </entries>

  <!-- Article group B: same title, different journals (exercises Article_Title_Journal for one, Article_NoTitle_Journal for the other) -->
  <entries xsi:type="BibTeX:Article" id="B1" year="2003" title="Shared Title B" journal="Journal B1">
    <authors author="Dana Delta"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="B2" year="2004" title="Shared Title B" journal="Journal B2">
    <authors author="Evan Epsilon"/>
  </entries>

  <!-- Article group C: unique title, shared journal (exercises Article_Title_NoJournal and Article_NoTitle_NoJournal on same journal) -->
  <entries xsi:type="BibTeX:Article" id="C1" year="2005" title="Unique Title C1" journal="Shared Journal C">
    <authors author="Frank Phi"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="C2" year="2006" title="Unique Title C2" journal="Shared Journal C">
    <authors author="Grace Gamma"/>
  </entries>

  <!-- Article group D: single, fully unique (also in title and journal sets) -->
  <entries xsi:type="BibTeX:Article" id="D1" year="2007" title="Standalone Article D" journal="Standalone Journal D">
    <authors author="Hector Eta"/>
    <authors author="Ivy Iota"/>
  </entries>

  <!-- Manual pair with identical title (one in title set, one out: TitledEntry_Title_NoArticle and TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="Repeated Manual Title">
  </entries>
  <entries xsi:type="BibTeX:Manual" id="M2" title="Repeated Manual Title">
  </entries>

  <!-- Book pair with identical title (only first in title set; both are authored, dated, titled) -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="2010" title="Shared Book Title" publisher="Publisher One">
    <authors author="Alice Alpha"/>
    <authors author="John Jota"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="BK2" year="2011" title="Shared Book Title" publisher="Publisher Two">
    <authors author="Kevin Kappa"/>
  </entries>

  <!-- InBook with distinct title (in title set) -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2012" title="InBook Title One" publisher="InBook Publisher" chapter="3">
    <authors author="Laura Lambda"/>
    <authors author="Mike Mu"/>
  </entries>

  <!-- InCollection with distinct title & booktitle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2013" title="InCollection Title" publisher="Collection Publisher" booktitle="Collection Booktitle">
    <authors author="Nina Nu"/>
  </entries>

  <!-- InProceedings pair sharing title (one in titled set, one out; both share same booktitle and year to exercise thesis- and proceedings-like fields) -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2014" title="Repeated InProceedings Title" booktitle="Conference X">
    <authors author="Oscar Omicron"/>
    <authors author="Peter Pi"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2015" title="Repeated InProceedings Title" booktitle="Conference Y">
    <authors author="Quinn Qoppa"/>
  </entries>

  <!-- Proceedings triple: two share title, one unique (to exercise typeOf filter and title-set selection) -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2016" title="Shared Proceedings Title">
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2017" title="Shared Proceedings Title">
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="PR3" year="2018" title="Unique Proceedings Title">
  </entries>

  <!-- TechReport pair with identical title -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2019" title="Repeated TechReport Title">
    <authors author="Rachel Rho"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2020" title="Repeated TechReport Title">
    <authors author="Sam Sigma"/>
  </entries>

  <!-- PhDThesis with distinct title and school -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2021" title="PhD Thesis Title One" school="University One">
    <authors author="Tom Tau"/>
    <authors author="Uma Upsilon"/>
  </entries>

  <!-- MasterThesis with distinct title and school (constraint commented out but participates in general titled rules) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2022" title="Master Thesis Title One" school="Institute One">
    <authors author="Victor Vee"/>
  </entries>

  <!-- Unpublished triple: two share title and one unique, to exercise title-dup logic and Unpublished-specific note usage -->
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Shared Unpublished Title" note="First note for shared unpublished">
    <authors author="Wendy Waw"/>
    <authors author="Xavier Xi"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="UP2" title="Shared Unpublished Title" note="Second note for shared unpublished">
    <authors author="Yara Ya"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="UP3" title="Unique Unpublished Title" note="Unique unpublished note">
    <authors author="Zane Zeta"/>
  </entries>

  <!-- Booklet entries (no title, only id and year) exercising UntitledEntry rule with DatedEntry -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="1990"/>
  <entries xsi:type="BibTeX:Booklet" id="BL2" year="1991"/>

  <!-- Misc entries (purely untitled, non-authored, non-dated) also for UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MS1"/>
  <entries xsi:type="BibTeX:Misc" id="MS2"/>

</BibTeX:BibTeXFile>