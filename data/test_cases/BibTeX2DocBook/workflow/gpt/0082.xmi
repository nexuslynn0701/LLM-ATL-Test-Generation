<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: design to trigger all four Article rules at once -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Article One" journal="Journal Alpha">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- A2 & A3: same title, different journals -->
  <!-- A2: representative for title "Shared Title T1" in journal "Journal Beta" (unique journal) -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title T1" journal="Journal Beta">
    <authors author="Carol Researcher"/>
  </entries>

  <!-- A3: same title "Shared Title T1", journal "Journal Gamma" also used by A4 -> title representative, non-representative journal -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Title T1" journal="Journal Gamma">
    <authors author="Dave Scientist"/>
    <authors author="Eve Analyst"/>
  </entries>

  <!-- A4 & A5: different titles, same journal -->
  <!-- A4: title "Shared Title T2" chosen as representative for title set, journal "Journal Gamma" representative for journal set -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Shared Title T2" journal="Journal Gamma">
    <authors author="Frank Engineer"/>
  </entries>

  <!-- A5: title "Duplicate Title T3" non-representative in title set, journal "Journal Delta" unique -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Duplicate Title T3" journal="Journal Delta">
    <authors author="Grace Designer"/>
    <authors author="Heidi Architect"/>
  </entries>

  <!-- A6 & A7: same title and same journal -->
  <!-- A6: representative in both title and journal sets for "Duplicate Title T3" / "Journal Epsilon" -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Duplicate Title T3" journal="Journal Epsilon">
    <authors author="Ivan Developer"/>
  </entries>

  <!-- A7: non-representative in both title and journal sets for that pair -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Duplicate Title T3" journal="Journal Epsilon">
    <authors author="Judy Tester"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- Titled non-Article entries to exercise TitledEntry rules -->

  <!-- B1 & B2: Books with same title -> one Title_NoArticle (B1), one NoTitle_NoArticle (B2) -->
  <entries xsi:type="BibTeX:Book" id="B1" year="1999" title="Book Shared Title" publisher="Publisher One">
    <authors author="Alice Author"/>
    <authors author="Carol Researcher"/>
  </entries>

  <entries xsi:type="BibTeX:Book" id="B2" year="2000" title="Book Shared Title" publisher="Publisher Two">
    <authors author="Dave Scientist"/>
  </entries>

  <!-- B3: Book with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B3" year="2010" title="Unique Book Title" publisher="Publisher Three">
    <authors author="Frank Engineer"/>
    <authors author="Grace Designer"/>
  </entries>

  <!-- IB1 & IB2: InBook with same title, different chapters -> one Title_NoArticle (IB1), one NoTitle_NoArticle (IB2) -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2011" title="InBook Shared Title" publisher="Publisher Four" chapter="1">
    <authors author="Heidi Architect"/>
  </entries>

  <entries xsi:type="BibTeX:InBook" id="IB2" year="2012" title="InBook Shared Title" publisher="Publisher Five" chapter="2">
    <authors author="Ivan Developer"/>
    <authors author="Judy Tester"/>
  </entries>

  <!-- MT1 & MT2: MasterThesis with same title -> one Title_NoArticle (MT1), one NoTitle_NoArticle (MT2) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2013" title="Thesis Shared Title" school="Tech University">
    <authors author="Alice Author"/>
  </entries>

  <entries xsi:type="BibTeX:MasterThesis" id="MT2" year="2014" title="Thesis Shared Title" school="Science Institute">
    <authors author="Carol Researcher"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- PHD1: PhDThesis unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2015" title="Unique PhD Thesis" school="Advanced Studies Center">
    <authors author="Dave Scientist"/>
    <authors author="Eve Analyst"/>
  </entries>

  <!-- IP1 & IP2: InProceedings with same title to hit both title rules; also exercise BookTitledEntry and Proceedings hierarchy -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2016" title="Conference Paper Shared" booktitle="Proc. Conf. 1">
    <authors author="Frank Engineer"/>
    <authors author="Grace Designer"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2017" title="Conference Paper Shared" booktitle="Proc. Conf. 2">
    <authors author="Heidi Architect"/>
  </entries>

  <!-- IC1: InCollection unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2018" title="Collected Chapter Unique" publisher="Publisher Six" booktitle="Collected Volume 1">
    <authors author="Ivan Developer"/>
    <authors author="Judy Tester"/>
  </entries>

  <!-- PR1 & PR2: Proceedings with same title -> one Title_NoArticle (PR1), one NoTitle_NoArticle (PR2) -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2019" title="Symposium Shared Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2020" title="Symposium Shared Title"/>

  <!-- PR3: unique Proceedings title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR3" year="2021" title="Unique Symposium Title"/>

  <!-- M1 & M2: Manual with same title -> one Title_NoArticle (M1), one NoTitle_NoArticle (M2) -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="Manual Shared Title"/>
  <entries xsi:type="BibTeX:Manual" id="M2" title="Manual Shared Title"/>

  <!-- M3: Manual unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M3" title="Unique Manual Title"/>

  <!-- U1 & U2: Unpublished with same title -> one Title_NoArticle (U1), one NoTitle_NoArticle (U2) -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Unpublished Shared Title" note="First note">
    <authors author="Alice Author"/>
    <authors author="Eve Analyst"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Unpublished Shared Title" note="Second note">
    <authors author="Carol Researcher"/>
  </entries>

  <!-- U3: Unpublished unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U3" title="Unique Unpublished Title" note="Unique note">
    <authors author="Frank Engineer"/>
    <authors author="Grace Designer"/>
    <authors author="Heidi Architect"/>
  </entries>

  <!-- TR1 & TR2: TechReport with same title -> one Title_NoArticle (TR1), one NoTitle_NoArticle (TR2) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="1990" title="Report Shared Title">
    <authors author="Ivan Developer"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport" id="TR2" year="1991" title="Report Shared Title">
    <authors author="Judy Tester"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- TR3: TechReport unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR3" year="1992" title="Unique Report Title">
    <authors author="Alice Author"/>
    <authors author="Carol Researcher"/>
  </entries>

  <!-- Untitled entries (no title): Booklet and Misc to trigger UntitledEntry rule -->

  <!-- BK1, BK2, BK3: Booklet entries without title -->
  <entries xsi:type="BibTeX:Booklet" id="BK1" year="1980"/>
  <entries xsi:type="BibTeX:Booklet" id="BK2" year="1981"/>
  <entries xsi:type="BibTeX:Booklet" id="BK3" year="1982"/>

  <!-- MS1 & MS2: Misc entries -->
  <entries xsi:type="BibTeX:Misc" id="MS1"/>
  <entries xsi:type="BibTeX:Misc" id="MS2"/>

</BibTeX:BibTeXFile>