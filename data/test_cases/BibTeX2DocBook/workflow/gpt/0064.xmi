<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles (to exercise all Article* rules, and journal/title dedup) -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model-Driven Testing Overview" journal="Journal of Software Engineering Experiments">
    <authors author="Alice Smith"/>
    <authors author="Bob Miller"/>
  </entries>

  <!-- A2 & A3: same title, different journals -> one Title, two journals -->
  <!-- A2: in title-unique set & journal-unique set -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Metamodeling Best Practices" journal="International Journal of Modeling">
    <authors author="Carol Johnson"/>
  </entries>
  <!-- A3: same title as A2, new journal -> not in title-unique set, in journal-unique set -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Metamodeling Best Practices" journal="Transactions on Conceptual Modeling">
    <authors author="David Brown"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- A4 & A5: same journal, different titles -> one Journal, two titles -->
  <!-- A4: first with this journal & unique title -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Traceability in Model Transformations" journal="Journal of Model Engineering">
    <authors author="Eve Green"/>
  </entries>
  <!-- A5: same journal as A4, unique title -> not in journal-unique set, in title-unique set -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Incremental Transformation Techniques" journal="Journal of Model Engineering">
    <authors author="Frank White"/>
    <authors author="Bob Miller"/>
  </entries>

  <!-- A6 & A7: same title and same journal -> one Title, one Journal -->
  <!-- A6: first occurrence -> in both title-unique and journal-unique sets -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Testing ATL Transformations" journal="Model Transformation Journal">
    <authors author="Grace Lee"/>
  </entries>
  <!-- A7: same title & journal -> not in either set -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Testing ATL Transformations" journal="Model Transformation Journal">
    <authors author="Henry King"/>
    <authors author="Carol Johnson"/>
  </entries>

  <!-- Booklets (untitled, dated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="BKL1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="BKL2" year="2000"/>

  <!-- Misc (untitled, undated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MSC1"/>
  <entries xsi:type="BibTeX:Misc" id="MSC2"/>

  <!-- Manuals (titled only, no authors/year) -> TitledEntry_*_NoArticle -->
  <!-- M1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="ATL User Guide"/>
  <!-- M2: duplicate title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MAN2" title="ATL User Guide"/>

  <!-- TechReports (titled, dated, authored) -->
  <!-- TR1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="OCL Constraints in Practice">
    <authors author="Ian Thomas"/>
  </entries>
  <!-- TR2: same title as TR1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2011" title="OCL Constraints in Practice">
    <authors author="Jane Doe"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Proceedings (titled, dated, no authors) -->
  <!-- PR1: unique title -> TitledEntry_Title_NoArticle (and counted in OCL as Proceedings) -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2012" title="International Conference on Model Transformations"/>
  <!-- PR2: different title -> also TitledEntry_Title_NoArticle but helps test oclIsTypeOf filter in OCL13 -->
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2013" title="Workshop on Model-Driven Engineering"/>

  <!-- Book (titled, dated, authored, publisher) -->
  <!-- BK1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="2008" title="Foundations of Model-Driven Engineering" publisher="MDE Press">
    <authors author="Kevin Martin"/>
    <authors author="Laura Scott"/>
  </entries>

  <!-- InBook (subclass of Book, adds chapter) -->
  <!-- IB1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2009" title="Advanced ATL Patterns" publisher="MDE Press" chapter="3">
    <authors author="Mike Turner"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry, titled, dated, authored, publisher, booktitle) -->
  <!-- IC1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2015" title="Scalability of Model Transformations" publisher="Springer" booktitle="Lecture Notes in Software Engineering">
    <authors author="Nina Rogers"/>
    <authors author="David Brown"/>
  </entries>

  <!-- InProceedings (Proceedings + Authored + BookTitledEntry, titled, dated, authored, booktitle) -->
  <!-- IP1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2016" title="Case Studies in Transformation Testing" booktitle="Proceedings of the MDE Test Workshop">
    <authors author="Oscar Perez"/>
    <authors author="Frank White"/>
  </entries>

  <!-- PhDThesis (ThesisEntry: titled, dated, authored, school) -->
  <!-- PHD1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2014" title="Analysis of Model Transformation Quality" school="University of Modeling">
    <authors author="Paul Young"/>
    <authors author="Jane Doe"/>
  </entries>

  <!-- MasterThesis (ThesisEntry: titled, dated, authored, school) -->
  <!-- MT1: unique title -> TitledEntry_Title_NoArticle (OCL7 is commented but rule still executed) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2013" title="Automated Test Generation for ATL" school="Institute of Software Systems">
    <authors author="Quinn Allen"/>
    <authors author="Laura Scott"/>
  </entries>

  <!-- Unpublished (titled, authored, note) -->
  <!-- U1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Empirical Studies in Model Transformation Testing" note="To appear">
    <authors author="Rachel Green"/>
    <authors author="Ian Thomas"/>
  </entries>

</BibTeX:BibTeXFile>