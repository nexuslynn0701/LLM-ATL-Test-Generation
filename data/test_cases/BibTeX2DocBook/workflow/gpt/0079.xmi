<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- A. Articles to exercise all four Article rules (R6–R9) plus OCL16/19/27 -->

  <!-- A1: unique title + unique journal -> Article_Title_Journal (R6) -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001"
           title="Unique Title A" journal="Unique Journal A">
    <authors author="Author Alpha"/>
    <authors author="Author Beta"/>
  </entries>

  <!-- A2 & A3: same title, distinct journals -> two titles, each journal unique
       -> both in R7 (Article_NoTitle_Journal), one of them will be in title-set -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002"
           title="Shared Title B" journal="Journal B1">
    <authors author="Author Gamma"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art3" year="2003"
           title="Shared Title B" journal="Journal B2">
    <authors author="Author Delta"/>
    <authors author="Author Alpha"/>
  </entries>

  <!-- A4 & A5: distinct titles, same journal -> Article_Title_NoJournal (R8) and/or R9,
       one title in title-set, one journal in journal-set -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004"
           title="Title C1" journal="Shared Journal C">
    <authors author="Author Epsilon"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art5" year="2005"
           title="Title C2" journal="Shared Journal C">
    <authors author="Author Zeta"/>
    <authors author="Author Beta"/>
  </entries>

  <!-- B. Non-Article TitledEntries to exercise R4/R5 and OCL18/20/25 -->

  <!-- B1 & B2: two Books with identical title -> first in titledEntrySet (R4),
       second excluded (R5). Both also exercise Book-specific pieces. -->
  <entries xsi:type="BibTeX:Book" id="book1" year="1999"
           title="Duplicated Book Title" publisher="Publisher One">
    <authors author="Author Alpha"/>
    <authors author="Author Theta"/>
  </entries>

  <entries xsi:type="BibTeX:Book" id="book2" year="2000"
           title="Duplicated Book Title" publisher="Publisher Two">
    <authors author="Author Iota"/>
  </entries>

  <!-- B3: InBook with unique title to exercise InBook path in R4
           (title, authors, year, publisher, chapter) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2010"
           title="InBook Unique Title" publisher="InBook Publisher"
           chapter="7">
    <authors author="Author Kappa"/>
    <authors author="Author Lambda"/>
  </entries>

  <!-- B4: InCollection with unique title to exercise InCollection path in R4
           (title, authors, year, booktitle, publisher) -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" year="2011"
           title="Collection Title" publisher="Collection Publisher"
           booktitle="Collection Booktitle">
    <authors author="Author Mu"/>
  </entries>

  <!-- B5 & B6: Proceedings, one “plain” (no children) and another also plain
       with same title to exercise R4/R5 + type filter in OCL13 -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2015"
           title="Proceedings Title D"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2016"
           title="Proceedings Title D"/>

  <!-- B7: Manual with unique title -> R4 (no children) and OCL12 -->
  <entries xsi:type="BibTeX:Manual" id="man1"
           title="Manual Title E"/>

  <!-- B8 & B9: Unpublished entries, distinct titles -> R4, OCL6 -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1"
           title="Unpublished Title F" note="Note F">
    <authors author="Author Nu"/>
    <authors author="Author Xi"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished" id="unpub2"
           title="Unpublished Title G" note="Note G">
    <authors author="Author Omicron"/>
  </entries>

  <!-- B10: TechReport with unique title -> R4, OCL11 -->
  <entries xsi:type="BibTeX:TechReport" id="tech1" year="1995"
           title="TechReport Title H">
    <authors author="Author Pi"/>
  </entries>

  <!-- B11: MasterThesis with unique title -> R4, OCL7 (commented in file but still useful) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mth1" year="2008"
           title="Master Thesis Title I" school="School I">
    <authors author="Author Rho"/>
    <authors author="Author Sigma"/>
  </entries>

  <!-- B12: PhDThesis with unique title -> R4, OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2009"
           title="PhD Thesis Title J" school="School J">
    <authors author="Author Tau"/>
  </entries>

  <!-- C. Untitled entries (Misc and Booklet) to exercise R3 + OCL5 -->

  <!-- C1 & C2: Booklets (no title) -> UntitledEntry (R3), OCL5 -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1980"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet2" year="1981"/>

  <!-- C3 & C4: Misc entries -> UntitledEntry (R3), not TitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Misc" id="misc2"/>

</BibTeX:BibTeXFile>