<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise all four Article rules (R6–R9) and journal/title uniqueness handling -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model-Driven Testing Framework" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- A2 & A3: same title, same journal -> one in title set / one out; both not in journal set -> Article_Title_NoJournal and Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Reusable Transformation Patterns" journal="Software Modeling Quarterly">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Reusable Transformation Patterns" journal="Software Modeling Quarterly">
    <authors author="David Brown"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- A4 & A5: same title, different journals -> one included in title set, both in journal set -> Article_Title_Journal and Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Scalable Model Transformations" journal="International Journal of Software Tools">
    <authors author="Eva Green"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Scalable Model Transformations" journal="Empirical Software Engineering Letters">
    <authors author="Frank Black"/>
    <authors author="George King"/>
  </entries>
  <!-- A6 & A7: distinct titles, same journal -> both in title set, only first in journal set -> Article_Title_Journal and Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Incremental Transformation Maintenance" journal="Journal of Experimental Software Design">
    <authors author="Helen Clark"/>
    <authors author="Ian Gray"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Bidirectional Synchronization in Practice" journal="Journal of Experimental Software Design">
    <authors author="Jane Miller"/>
  </entries>

  <!-- Untitled entries for UntitledEntry rule (R3): two Booklets and one Misc -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="B2" year="2010"/>
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- Titled non-article entries to exercise TitledEntry_Title_NoArticle and TitledEntry_NoTitle_NoArticle (R4, R5) -->
  <!-- Unique titles -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="ATL User Guide"/>
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2011" title="Performance Analysis of Model Transformations">
    <authors author="Bob Johnson"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2012" title="Automated Testing of Model Transformations" school="University of Metamodeling">
    <authors author="Carol White"/>
    <authors author="David Brown"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2013" title="Traceability in Model-Driven Engineering" school="Tech University of Abstraction">
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2014" title="Patterns of Model Transformation" publisher="MDE Press" chapter="3">
    <authors author="Eva Green"/>
    <authors author="Frank Black"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2015" title="Domain-Specific Modeling Languages" publisher="Software Science House" booktitle="Advances in MDE">
    <authors author="George King"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2016" title="Models Conference 2016"/>
  <entries xsi:type="BibTeX:Book" id="BK1" year="2017" title="Fundamentals of Model-Driven Engineering" publisher="SpringCity Publishing">
    <authors author="Helen Clark"/>
    <authors author="Ian Gray"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Early Results on Model Transformation Coverage" note="Technical draft under review">
    <authors author="Jane Miller"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Duplicate titles among non-articles to trigger NoTitle variants (R5) while still having at least one representative in title set -->
  <!-- Two Proceedings with same title -->
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2018" title="Models Conference 2018"/>
  <entries xsi:type="BibTeX:Proceedings" id="PR3" year="2019" title="Models Conference 2018"/>
  <!-- Two Books with same title -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="2020" title="Advanced Topics in Model Engineering" publisher="SpringCity Publishing">
    <authors author="David Brown"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="BK3" year="2021" title="Advanced Topics in Model Engineering" publisher="Global MDE Press">
    <authors author="George King"/>
    <authors author="Helen Clark"/>
  </entries>
  <!-- Two Unpublished with same title -->
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Case Studies in Transformation Testing" note="Extended abstract">
    <authors author="Ian Gray"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U3" title="Case Studies in Transformation Testing" note="Full version in preparation">
    <authors author="Bob Johnson"/>
    <authors author="Jane Miller"/>
  </entries>
</BibTeX:BibTeXFile>