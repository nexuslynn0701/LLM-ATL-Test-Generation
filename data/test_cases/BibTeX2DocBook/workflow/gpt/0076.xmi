<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles configured to exercise all four article rules -->
  <!-- A1: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a1" year="2001" title="Unique Article Title" journal="Unique Journal A">
    <authors author="Alice A. Author"/>
    <authors author="Bob B. Writer"/>
  </entries>

  <!-- A2 & A3: same title, different journals ->
       first in title-set with unique journal: Article_Title_Journal
       second not in title-set with unique journal: Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="a2" year="2002" title="Shared Article Title" journal="Journal X">
    <authors author="Charlie C. Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a3" year="2003" title="Shared Article Title" journal="Journal Y">
    <authors author="Dana D. Scientist"/>
    <authors author="Alice A. Author"/>
  </entries>

  <!-- A4 & A5: same journal, different titles ->
       first in journal-set with unique title: Article_Title_Journal
       second in journal-set but not in journal-set subset: Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a4" year="2004" title="Journal-Shared Title 1" journal="Shared Journal Z">
    <authors author="Evan E. Engineer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a5" year="2005" title="Journal-Shared Title 2" journal="Shared Journal Z">
    <authors author="Fiona F. Analyst"/>
  </entries>

  <!-- A6 & A7: same title and same journal ->
       first: Article_Title_Journal
       second: Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a6" year="2006" title="Duplicate Everything" journal="Duplicated Journal">
    <authors author="Greg G. Developer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a7" year="2007" title="Duplicate Everything" journal="Duplicated Journal">
    <authors author="Helen H. Architect"/>
    <authors author="Bob B. Writer"/>
  </entries>

  <!-- Untitled entries to trigger UntitledEntry (Booklet, Misc) -->
  <entries xsi:type="BibTeX:Booklet" id="b1" year="1999"/>
  <entries xsi:type="BibTeX:Misc" id="m1"/>

  <!-- Titled, non-article entries with unique titles ->
       TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Unique Manual Title"/>
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2010" title="Unique TechReport Title">
    <authors author="Isaac I. Investigator"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book1" year="2011" title="Unique Book Title" publisher="Unique Publisher 1">
    <authors author="Jane J. Author"/>
    <authors author="Kevin K. Editor"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2012" title="Unique InBook Title" publisher="Unique Publisher 2" chapter="3">
    <authors author="Laura L. Writer"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="inc1" year="2013" title="Unique InCollection Title" publisher="Unique Publisher 3" booktitle="Unique Collection Booktitle">
    <authors author="Mike M. Contributor"/>
    <authors author="Nina N. Contributor"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inp1" year="2014" title="Unique InProceedings Title" booktitle="ProcConf 2014">
    <authors author="Oscar O. Presenter"/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2015" title="Unique Proceedings Title"/>
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2016" title="Unique PhD Thesis Title" school="Unique University">
    <authors author="Paula P. Doctoral"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="2017" title="Unique Master Thesis Title" school="Another University">
    <authors author="Quentin Q. Student"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Unique Unpublished Title" note="Unpublished Note A">
    <authors author="Rachel R. Researcher"/>
  </entries>

  <!-- Titled, non-article entries with duplicated titles to trigger TitledEntry_NoTitle_NoArticle -->
  <!-- Two TechReports with the same title -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2018" title="Repeated TechReport Title">
    <authors author="Sara S. Scientist"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr3" year="2019" title="Repeated TechReport Title">
    <authors author="Tom T. Technologist"/>
  </entries>

  <!-- Two Books with the same title -->
  <entries xsi:type="BibTeX:Book" id="book2" year="2020" title="Repeated Book Title" publisher="Publisher Alpha">
    <authors author="Uma U. Writer"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book3" year="2021" title="Repeated Book Title" publisher="Publisher Beta">
    <authors author="Victor V. Author"/>
    <authors author="Kevin K. Editor"/>
  </entries>
</BibTeX:BibTeXFile>