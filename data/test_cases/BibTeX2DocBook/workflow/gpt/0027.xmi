<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Misc" id="E01"/>
  <entries xsi:type="BibTeX:Booklet" id="E02" year="2001"/>

  <!-- Articles set up to exercise the four Article rules -->
  <!-- A1: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="E03" year="2005" title="TitleA" journal="Journal1">
    <authors author="Alice A."/>
    <authors author="Bob B."/>
  </entries>

  <!-- A2 and A3 share title but have unique journals among all articles
       -> A2 = representative for title "TitleB" (Article_Title_Journal)
          A3 = non-representative (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="E04" year="2006" title="TitleB" journal="Journal2">
    <authors author="Carol C."/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="E05" year="2007" title="TitleB" journal="Journal3">
    <authors author="Dave D."/>
  </entries>

  <!-- A4 and A5 share journal but have unique titles
       -> A4 = representative for journal "Journal4" (Article_Title_NoJournal)
          A5 = non-representative (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="E06" year="2008" title="TitleC" journal="Journal4">
    <authors author="Eve E."/>
    <authors author="Frank F."/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="E07" year="2009" title="TitleD" journal="Journal4">
    <authors author="Grace G."/>
  </entries>

  <!-- Non-article titled entries with unique titles -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="E08" title="ManualTitle1"/>
  <entries xsi:type="BibTeX:Book" id="E09" year="2010" title="BookTitle1" publisher="Pub1">
    <authors author="Helen H."/>
    <authors author="Ian I."/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="E10" year="2011" title="InBookTitle1" publisher="Pub2" chapter="3">
    <authors author="Jack J."/>
  </entries>
  <entries xsi:type="BibTeX:Proceedings" id="E11" year="2012" title="ProcTitle1"/>
  <entries xsi:type="BibTeX:TechReport" id="E12" year="2013" title="TechTitle1">
    <authors author="Karen K."/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="E13" title="UnpubTitle1" note="Note for Unpub1">
    <authors author="Leo L."/>
    <authors author="Mia M."/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="E14" year="2014" title="PhDTitle1" school="School1">
    <authors author="Nick N."/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="E15" year="2015" title="MasterTitle1" school="School2">
    <authors author="Olivia O."/>
    <authors author="Peter P."/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="E16" year="2016" title="InCollectionTitle1" publisher="Pub3" booktitle="BookSeries1">
    <authors author="Quinn Q."/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="E17" year="2017" title="InProceedingsTitle1" booktitle="Conf1">
    <authors author="Rachel R."/>
    <authors author="Sam S."/>
  </entries>

  <!-- Non-article titled entries sharing a title for TitledEntry_NoTitle_NoArticle -->
  <!-- R1: representative for title "SharedTitle1" (appears in dedup set) -->
  <entries xsi:type="BibTeX:Manual" id="E18" title="SharedTitle1"/>
  <!-- R2: same title "SharedTitle1", non-representative -> NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="E19" year="2018" title="SharedTitle1" publisher="Pub4">
    <authors author="Tim T."/>
  </entries>

  <!-- Additional titled entries with distinct titles -->
  <entries xsi:type="BibTeX:Booklet" id="E20" year="2019"/>
  <entries xsi:type="BibTeX:Misc" id="E21"/>

</BibTeX:BibTeXFile>