<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise all Article_* rules with shared titles and journals -->
  <!-- A1: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Title A" journal="Journal 1">
    <authors author="Author One"/>
    <authors author="Author Two"/>
  </entries>
  <!-- A2: shares title with A1, same journal as A1 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Title A" journal="Journal 1">
    <authors author="Author Three"/>
  </entries>
  <!-- A3: shares title with A2 but different journal, journal unique -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Title A" journal="Journal 2">
    <authors author="Author Four"/>
    <authors author="Author Two"/>
  </entries>
  <!-- A4: title unique, journal shared with A3 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Title B" journal="Journal 2">
    <authors author="Author Five"/>
  </entries>

  <!-- Booklets (untitled, dated) -> UntitledEntry + OCL5 -->
  <entries xsi:type="BibTeX:Booklet" id="BKT1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="BKT2" year="2000"/>

  <!-- Misc (untitled, undated) -> UntitledEntry only -->
  <entries xsi:type="BibTeX:Misc" id="MSC1"/>
  <entries xsi:type="BibTeX:Misc" id="MSC2"/>

  <!-- Manuals (titled, no authors, no date) -> TitledEntry_Title_NoArticle + OCL12 -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="Manual Title 1"/>
  <entries xsi:type="BibTeX:Manual" id="MAN2" title="Manual Title 2"/>

  <!-- Proceedings: one unique title, two sharing a title -> TitledEntry_Title_NoArticle and TitledEntry_NoTitle_NoArticle + OCL13 -->
  <entries xsi:type="BibTeX:Proceedings" id="PRO1" year="2010" title="Proc X"/>
  <entries xsi:type="BibTeX:Proceedings" id="PRO2" year="2011" title="Proc Y"/>
  <entries xsi:type="BibTeX:Proceedings" id="PRO3" year="2012" title="Proc Y"/>

  <!-- TechReports: two sharing same title to trigger TitledEntry_Title_NoArticle and _NoTitle_ + OCL11 -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2013" title="Tech Title">
    <authors author="Author Six"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2014" title="Tech Title">
    <authors author="Author Seven"/>
    <authors author="Author One"/>
  </entries>

  <!-- Unpublished (titled, authored, note) -> TitledEntry_* + OCL6 -->
  <entries xsi:type="BibTeX:Unpublished" id="UNP1" title="Unpub Title 1" note="Note 1">
    <authors author="Author Eight"/>
    <authors author="Author Nine"/>
  </entries>
  <!-- Second Unpublished with different title -->
  <entries xsi:type="BibTeX:Unpublished" id="UNP2" title="Unpub Title 2" note="Note 2">
    <authors author="Author Two"/>
  </entries>

  <!-- MasterThesis (titled, authored, dated, school) -> TitledEntry_* + OCL7 (commented in OCL but still covered by rules) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2015" title="Thesis Title 1" school="School A">
    <authors author="Author Ten"/>
  </entries>

  <!-- PhDThesis: two sharing same title -> TitledEntry_Title_NoArticle + _NoTitle_ + OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2016" title="Thesis Shared" school="School B">
    <authors author="Author Eleven"/>
    <authors author="Author Five"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PHD2" year="2017" title="Thesis Shared" school="School C">
    <authors author="Author Twelve"/>
  </entries>

  <!-- Book: unique title -> TitledEntry_Title_NoArticle + OCL9 -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="2005" title="Book Title 1" publisher="Pub A">
    <authors author="Author One"/>
    <authors author="Author Three"/>
  </entries>

  <!-- Book: two with same title to exercise TitledEntry_NoTitle_NoArticle for one, + OCL9 -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="2006" title="Book Shared" publisher="Pub B">
    <authors author="Author Four"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="BK3" year="2007" title="Book Shared" publisher="Pub C">
    <authors author="Author Six"/>
    <authors author="Author Seven"/>
  </entries>

  <!-- InBook: uses chapter, publisher, authors, shares a title with none -> TitledEntry_Title_NoArticle + OCL10 -->
  <entries xsi:type="BibTeX:InBook" id="INB1" year="2008" title="InBook Title" publisher="Pub D" chapter="3">
    <authors author="Author Eight"/>
    <authors author="Author Two"/>
  </entries>

  <!-- InCollection: uses booktitle and publisher, share title with none -> TitledEntry_Title_NoArticle + OCL15 -->
  <entries xsi:type="BibTeX:InCollection" id="INC1" year="2009" title="InCollection Title" publisher="Pub E" booktitle="Book Col 1">
    <authors author="Author Nine"/>
    <authors author="Author Eleven"/>
  </entries>

  <!-- InProceedings: two with different titles but sharing booktitle to stress BookTitledEntry handling + OCL14 -->
  <entries xsi:type="BibTeX:InProceedings" id="INP1" year="2018" title="InProc Title 1" booktitle="Conf Shared">
    <authors author="Author Twelve"/>
    <authors author="Author Ten"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="INP2" year="2019" title="InProc Title 2" booktitle="Conf Shared">
    <authors author="Author Five"/>
  </entries>
</BibTeX:BibTeXFile>