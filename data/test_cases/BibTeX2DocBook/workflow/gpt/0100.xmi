<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles designed to exercise all four Article rules -->

  <!-- A1: unique title & unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           year="2001"
           title="Model Transformation Testing"
           journal="Journal of Model Engineering">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- A2 & A3: two articles share the same title but have different journals
       One goes to titleSet, the other not -> Article_Title_Journal + Article_NoTitle_Journal -->

  <!-- A2: in titleSet & in journalSet -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           year="2002"
           title="Duplicate Title Case"
           journal="Journal X">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- A3: not in titleSet but in journalSet -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           year="2003"
           title="Duplicate Title Case"
           journal="Journal Y">
    <authors author="Dave Delta"/>
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- A4 & A5: two articles share the same journal but have different titles
       One goes to journalSet, the other not -> Article_Title_Journal + Article_Title_NoJournal -->

  <!-- A4: in titleSet & in journalSet -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           year="2004"
           title="Shared Journal First"
           journal="Common Journal">
    <authors author="Frank Phi"/>
  </entries>

  <!-- A5: in titleSet but not in journalSet -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A5"
           year="2005"
           title="Shared Journal Second"
           journal="Common Journal">
    <authors author="Grace Gamma"/>
    <authors author="Heidi Eta"/>
  </entries>

  <!-- A6 & A7: same title and same journal
       One representative in both sets, the other in none ->
       Article_Title_Journal + Article_NoTitle_NoJournal -->

  <!-- A6: in titleSet & in journalSet -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A6"
           year="2006"
           title="Fully Duplicated Article"
           journal="Duplicated Journal">
    <authors author="Ivan Iota"/>
  </entries>

  <!-- A7: neither in titleSet nor in journalSet -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A7"
           year="2007"
           title="Fully Duplicated Article"
           journal="Duplicated Journal">
    <authors author="Judy Jota"/>
    <authors author="Karl Kappa"/>
  </entries>

  <!-- Non-article titled entries to exercise TitledEntry_* rules -->

  <!-- B1 & B2: Books with same title
       One representative in titleSet -> TitledEntry_Title_NoArticle,
       the other not -> TitledEntry_NoTitle_NoArticle -->

  <!-- B1: in titleSet -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           year="2010"
           title="Repeated Book Title"
           publisher="Model Publishing House">
    <authors author="Liam Lambda"/>
    <authors author="Mia Mu"/>
  </entries>

  <!-- B2: not in titleSet -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="B2"
           year="2011"
           title="Repeated Book Title"
           publisher="Second Publisher">
    <authors author="Nina Nu"/>
  </entries>

  <!-- IB1: InBook to cover Book + InBook special fields in content -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           year="2012"
           title="InBook Example Case"
           publisher="InBook Publisher"
           chapter="3">
    <authors author="Oscar Omicron"/>
    <authors author="Peggy Pi"/>
  </entries>

  <!-- IC1: InCollection to exercise Book + BookTitledEntry path -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           year="2013"
           title="InCollection Example"
           publisher="Collection Publisher"
           booktitle="Collected Works on MDE">
    <authors author="Quentin Qoppa"/>
  </entries>

  <!-- IP1: InProceedings to exercise Proceedings + BookTitledEntry + AuthoredEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           year="2014"
           title="InProceedings Sample"
           booktitle="Proceedings of Model 2014">
    <authors author="Rachel Rho"/>
    <authors author="Sam Sigma"/>
  </entries>

  <!-- P1 & P2: Proceedings with same title, to combine with titleSet logic
       P1 will be in titleSet, P2 not, thus both TitledEntry_Title_NoArticle and
       TitledEntry_NoTitle_NoArticle for Proceedings -->

  <!-- P1: in titleSet -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings"
           id="P1"
           year="2015"
           title="Annual MDE Conference">
  </entries>

  <!-- P2: not in titleSet -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings"
           id="P2"
           year="2016"
           title="Annual MDE Conference">
  </entries>

  <!-- TR1 & TR2: TechReports with different titles (both in titleSet) -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           year="2017"
           title="First TechReport Example">
    <authors author="Tom Tau"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport"
           id="TR2"
           year="2018"
           title="Second TechReport Example">
    <authors author="Uma Upsilon"/>
    <authors author="Victor V"/>
  </entries>

  <!-- MNU1 & MNU2: Manuals with distinct titles -->
  <entries xsi:type="BibTeX:Manual"
           id="MNU1"
           title="User Manual for Tool X">
  </entries>

  <entries xsi:type="BibTeX:Manual"
           id="MNU2"
           title="Developer Manual for Tool Y">
  </entries>

  <!-- U1 & U2: Unpublished entries with distinct titles -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Unpublished Artifact One"
           note="Internal draft version A">
    <authors author="Wendy Omega"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished"
           id="U2"
           title="Unpublished Artifact Two"
           note="Confidential notes B">
    <authors author="Xavier Xi"/>
    <authors author="Yara Ypsilon"/>
  </entries>

  <!-- PhD and Master theses to exercise ThesisEntry & PhDThesis/MasterThesis -->

  <!-- PH1 & PH2: distinct PhDThesis titles -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PH1"
           year="2019"
           title="PhD on Model-Driven Testing"
           school="University of Testing">
    <authors author="Zack Zeta"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis"
           id="PH2"
           year="2020"
           title="PhD on Transformation Verification"
           school="Institute of Verification">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- MT1: a MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           year="2021"
           title="Master Thesis on ATL Mutations"
           school="Model University">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- Booklets (untitled / dated, to exercise UntitledEntry rule) -->

  <entries xsi:type="BibTeX:Booklet"
           id="BL1"
           year="1999">
  </entries>

  <entries xsi:type="BibTeX:Booklet"
           id="BL2"
           year="2000">
  </entries>

  <!-- Misc entries (completely untitled / undated) -->

  <entries xsi:type="BibTeX:Misc"
           id="MS1">
  </entries>

  <entries xsi:type="BibTeX:Misc"
           id="MS2">
  </entries>

</BibTeX:BibTeXFile>