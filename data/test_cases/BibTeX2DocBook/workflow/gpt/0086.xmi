<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise all four Article rules and journal/title uniqueness handling -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Unique Article One" journal="Journal Alpha">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- A2 + A3: same title, different journals -->
  <!-- A2: kept in title-set, in journal-set -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Shared Title AB" journal="Journal Beta">
    <authors author="Charlie Researcher"/>
  </entries>
  <!-- A3: not kept in title-set, journal-set includes it -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Shared Title AB" journal="Journal Gamma">
    <authors author="Alice Author"/>
    <authors author="Dana Scholar"/>
  </entries>

  <!-- A4 + A5: different titles, same journal -->
  <!-- A4: kept in title-set, not in journal-set (journal dup) -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Journal Shared One" journal="Journal Delta">
    <authors author="Eve Expert"/>
  </entries>
  <!-- A5: not in title-set, not in journal-set -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Journal Shared Two" journal="Journal Delta">
    <authors author="Bob Writer"/>
    <authors author="Frank Analyst"/>
  </entries>

  <!-- Non-article titled entries to exercise TitledEntry rules -->
  <!-- B1: Book, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" year="1999" title="Unique Book Title" publisher="Publisher One">
    <authors author="Grace Author"/>
    <authors author="Henry Editor"/>
  </entries>

  <!-- B2 + B3: Books with same title -> Title-set contains only B2 -->
  <!-- B2: in set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book2" year="2000" title="Duplicated Titled Entry" publisher="Publisher Two">
    <authors author="Ian Writer"/>
  </entries>
  <!-- B3: not in set -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book3" year="2001" title="Duplicated Titled Entry" publisher="Publisher Three">
    <authors author="Jane Scholar"/>
    <authors author="Alice Author"/>
  </entries>

  <!-- InBook to hit book + chapter handling in TitledEntry rules -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2010" title="InBook Case Study" publisher="Publisher Four" chapter="7">
    <authors author="Kevin Contributor"/>
    <authors author="Laura Researcher"/>
  </entries>

  <!-- TechReport with unique title -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="1995" title="TechReport Unique" >
    <authors author="Mike Engineer"/>
  </entries>

  <!-- PhDThesis with unique title -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2012" title="PhD Thesis Case" school="University One">
    <authors author="Nina Student"/>
    <authors author="Oscar Supervisor"/>
  </entries>

  <!-- MasterThesis with unique title (rule commented in OCL but used by transformation) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="2013" title="Master Thesis Study" school="University Two">
    <authors author="Peter Graduate"/>
  </entries>

  <!-- Proceedings: one unique, two with same title to combine with TitledEntry rules -->
  <!-- P1 unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2008" title="Unique Proceedings Title"/>
  <!-- P2 + P3 share title (also used by PhDThesis/Book/TechReport title uniqueness logic if same) -->
  <!-- First occurrence goes into title-set -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2009" title="Shared Proceedings Title"/>
  <!-- Second occurrence not in title-set -->
  <entries xsi:type="BibTeX:Proceedings" id="proc3" year="2010" title="Shared Proceedings Title"/>

  <!-- InProceedings with its own title and booktitle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2015" title="Conference Paper One" booktitle="Conf Book A">
    <authors author="Quentin Speaker"/>
    <authors author="Rachel Coauthor"/>
  </entries>

  <!-- InCollection with title and publisher/booktitle -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" year="2016" title="Collection Chapter" booktitle="Collected Works" publisher="Publisher Five">
    <authors author="Steve Writer"/>
  </entries>

  <!-- Manual with unique title -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Unique Manual Title"/>

  <!-- Unpublished entries: one unique title, one sharing title with a Book to test title-set across types -->
  <!-- U1 unique title -->
  <entries xsi:type="BibTeX:Unpublished" id="unp1" title="Unpublished Unique" note="First note">
    <authors author="Tom Researcher"/>
    <authors author="Uma Collaborator"/>
  </entries>
  <!-- U2 shares title with existing Book2/Book3 ("Duplicated Titled Entry") -->
  <entries xsi:type="BibTeX:Unpublished" id="unp2" title="Duplicated Titled Entry" note="Shared title note">
    <authors author="Victor Scientist"/>
  </entries>

  <!-- Untitled entries to exercise UntitledEntry rule -->
  <!-- Two Booklets and one Misc -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1990"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet2" year="1991"/>
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

</BibTeX:BibTeXFile>