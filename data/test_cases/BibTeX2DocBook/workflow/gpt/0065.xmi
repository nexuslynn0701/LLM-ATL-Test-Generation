<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles (to exercise all 4 article rules with title/journal uniqueness combinations) -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="MDE Testing Strategies" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- A2: title duplicated with A3, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Duplicate Title Study" journal="Software Validation Journal">
    <authors author="Carol White"/>
  </entries>
  <!-- A3: title duplicated with A2, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Duplicate Title Study" journal="Parallel Systems Review">
    <authors author="David Black"/>
    <authors author="Eve Green"/>
  </entries>
  <!-- A4: unique title, journal duplicated with A5 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Shared Journal First" journal="Journal of Shared Contexts">
    <authors author="Frank Miller"/>
  </entries>
  <!-- A5: unique title, journal duplicated with A4 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Shared Journal Second" journal="Journal of Shared Contexts">
    <authors author="Grace Lee"/>
    <authors author="Henry Adams"/>
  </entries>
  <!-- A6: title duplicated with A7, journal duplicated with A8 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Repeated Title and Journal" journal="Systems Integration Monthly">
    <authors author="Ivan Petrov"/>
  </entries>
  <!-- A7: title duplicated with A6, journal unique -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Repeated Title and Journal" journal="Unique Integration Quarterly">
    <authors author="Julia Clark"/>
  </entries>
  <!-- A8: title unique, journal duplicated with A6 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A8" year="2008" title="Only Journal Repeated" journal="Systems Integration Monthly">
    <authors author="Kevin Brown"/>
    <authors author="Laura King"/>
  </entries>

  <!-- Misc and Booklet (untitled entries -> UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Misc" id="M2"/>
  <entries xsi:type="BibTeX:Booklet" id="BLET1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="BLET2" year="2010"/>

  <!-- Manual (titled, no authors/dates) -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="ATL Transformation Handbook"/>
  <entries xsi:type="BibTeX:Manual" id="MAN2" title="Model Validation Guide"/>

  <!-- TechReport (titled, dated, authored) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2011" title="Industrial Case Studies in MDE">
    <authors author="Alice Smith"/>
    <authors author="Michael Scott"/>
  </entries>
  <!-- Second TechReport with same title as TR1 (to exercise TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2012" title="Industrial Case Studies in MDE">
    <authors author="Nina Howard"/>
  </entries>

  <!-- Unpublished (titled, authored, note) -->
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Early Results on Model Fuzzing" note="Draft version">
    <authors author="Bob Johnson"/>
    <authors author="Olivia Perez"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="UP2" title="Replicated Experiment on Fuzzing" note="Internal report">
    <authors author="Peter Quinn"/>
  </entries>

  <!-- Book (titled, dated, authored, publisher) -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="2013" title="Comprehensive Guide to ATL" publisher="ModelTech Press">
    <authors author="Grace Lee"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- Second Book with title equal to MAN2 (to create a duplicate title across different types) -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="2014" title="Model Validation Guide" publisher="Rigorous Systems Publishing">
    <authors author="Robert Long"/>
  </entries>

  <!-- InBook (child of Book, titled, dated, authored, publisher, chapter) -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2015" title="Chapter on Traceability" publisher="ModelTech Press" chapter="5">
    <authors author="Alice Smith"/>
    <authors author="Steve Young"/>
  </entries>

  <!-- Proceedings (titled, dated) -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2016" title="MDE Conference 2016"/>
  <!-- Second Proceedings with same title (duplicate title, to hit TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2017" title="MDE Conference 2016"/>

  <!-- InProceedings (titled, dated, authored, booktitle; also Proceedings & Authored & BookTitled) -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2018" title="Testing Model Transformations" booktitle="MDE Conference 2018">
    <authors author="Kevin Brown"/>
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2019" title="Mutation Analysis for ATL" booktitle="MDE Conference 2019">
    <authors author="Laura King"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- InCollection (Book & BookTitledEntry child: titled, dated, authored, publisher, booktitle) -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2020" title="Chapter on Model Coverage" publisher="Rigorous Systems Publishing" booktitle="Advances in MDE Testing">
    <authors author="Nina Howard"/>
    <authors author="Ivan Petrov"/>
  </entries>

  <!-- PhDThesis and MasterThesis (ThesisEntry children) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2010" title="Scalable Model Transformation Testing" school="University of Metropolis">
    <authors author="Julia Clark"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MSC1" year="2009" title="Empirical Studies on Model Coverage" school="Tech University">
    <authors author="Henry Adams"/>
    <authors author="Grace Lee"/>
  </entries>
</BibTeX:BibTeXFile>