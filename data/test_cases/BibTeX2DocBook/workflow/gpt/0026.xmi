<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise all four Article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Model Driven Testing in Practice" journal="Journal of Software Architecture">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <!-- A2 & A3: same title, different journals -> one in titled set, the other out
       A2: chosen for title set, journal unique         -> Article_Title_Journal
       A3: not in title set,   journal unique          -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Reusable Transformation Patterns" journal="Empirical Software Engineering Reports">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Reusable Transformation Patterns" journal="Software Metrics Journal">
    <authors author="Dave Brown"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- A4 & A5: same journal, different titles ->
       A4: in title set, journal not unique            -> Article_Title_NoJournal
       A5: not in title set, journal not unique       -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="ATL Performance Evaluation" journal="Model Transformations Today">
    <authors author="Eve Davis"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Testing ATL Transformations" journal="Model Transformations Today">
    <authors author="Frank Green"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Misc & Booklet -> UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2010"/>

  <!-- Titled entries (non-Article) to exercise TitledEntry_Title_NoArticle and TitledEntry_NoTitle_NoArticle
       Titles all distinct so they all are in the distinct-title set and use TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL User Guide">
  </entries>

  <!-- Two Books: distinct titles, both in titled-entry set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" year="1999" title="Foundations of Model Transformations" publisher="TechPress">
    <authors author="Alice Smith"/>
    <authors author="Ian Gray"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book2" year="2007" title="Advanced Topics in Model Engineering" publisher="SoftScience">
    <authors author="Bob Johnson"/>
  </entries>

  <!-- InBook with its own title, distinct -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2012" title="Case Studies in ATL" publisher="TechPress" chapter="3">
    <authors author="Carol White"/>
    <authors author="John Black"/>
  </entries>

  <!-- InCollection, distinct title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="incol1" year="2015" title="Refactoring Model Transformations" booktitle="Proceedings of the MDE Symposium" publisher="ConferencePub">
    <authors author="Dave Brown"/>
  </entries>

  <!-- InProceedings, distinct title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2018" title="Mutation Analysis for ATL" booktitle="International Conference on Model Transformation" >
    <authors author="Eve Davis"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- Proceedings (base type, not InProceedings), distinct title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2020" title="Proceedings of the MDE Symposium">
  </entries>

  <!-- TechReport, distinct title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2011" title="Industrial Experiences with ATL">
    <authors author="John Black"/>
  </entries>

  <!-- Thesis entries: PhDThesis and MasterThesis, distinct titles ->
       both in titled-entry set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2013" title="Scalability of Model Transformations" school="University of Metropolis">
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="2014" title="Testing Strategies for MDE" school="Institute of Software Studies">
    <authors author="Ian Gray"/>
    <authors author="Carol White"/>
  </entries>
</BibTeX:BibTeXFile>