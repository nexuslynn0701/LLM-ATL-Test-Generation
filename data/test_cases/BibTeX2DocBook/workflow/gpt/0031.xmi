<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article A: unique title, unique journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Title A1" journal="Journal A1">
    <authors author="Author One"/>
    <authors author="Author Two"/>
  </entries>

  <!-- Article B and C: same title, different journals -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title T1" journal="Journal B1">
    <authors author="Author Three"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Title T1" journal="Journal B2">
    <authors author="Author Four"/>
    <authors author="Author Five"/>
  </entries>

  <!-- Article D and E: different titles, same journal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Title C1" journal="Journal C">
    <authors author="Author One"/>
    <authors author="Author Six"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Title C2" journal="Journal C">
    <authors author="Author Seven"/>
  </entries>

  <!-- Article F and G: same title and same journal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Shared Title T2" journal="Journal D">
    <authors author="Author Eight"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Shared Title T2" journal="Journal D">
    <authors author="Author Nine"/>
    <authors author="Author Two"/>
  </entries>

  <!-- Booklet (untitled entry) -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1999"/>

  <!-- Misc (untitled entry) -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- Manual (titled, no authors, no date) -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="Manual Title 1"/>

  <!-- TechReport: unique title -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="TechReport Title 1">
    <authors author="Author Ten"/>
  </entries>

  <!-- TechReport: same title as TR1 (to exercise NoTitle rule) -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2011" title="TechReport Title 1">
    <authors author="Author Eleven"/>
    <authors author="Author One"/>
  </entries>

  <!-- Proceedings P1 and P2: same title (one in title set, one out) -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2015" title="Proceedings Title X"/>
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2016" title="Proceedings Title X"/>

  <!-- Proceedings P3: unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="P3" year="2017" title="Proceedings Title Y"/>

  <!-- Book: unique title -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="2008" title="Book Title 1" publisher="Publisher One">
    <authors author="Author Twelve"/>
    <authors author="Author Three"/>
  </entries>

  <!-- Book: same title as BK1 (to exercise NoTitle rule for Book) -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="2009" title="Book Title 1" publisher="Publisher Two">
    <authors author="Author Four"/>
  </entries>

  <!-- InBook: unique title -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2012" title="InBook Title 1" publisher="Publisher Three" chapter="1">
    <authors author="Author Five"/>
    <authors author="Author Six"/>
  </entries>

  <!-- InCollection: unique title -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2013" title="InCollection Title 1" publisher="Publisher Four" booktitle="BookTitle IC">
    <authors author="Author Seven"/>
    <authors author="Author Eight"/>
  </entries>

  <!-- InCollection: same title as IC1 (to exercise NoTitle rule for InCollection) -->
  <entries xsi:type="BibTeX:InCollection" id="IC2" year="2014" title="InCollection Title 1" publisher="Publisher Five" booktitle="BookTitle IC 2">
    <authors author="Author Nine"/>
  </entries>

  <!-- InProceedings: unique title -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2018" title="InProceedings Title 1" booktitle="Conf One">
    <authors author="Author Ten"/>
    <authors author="Author Eleven"/>
  </entries>

  <!-- InProceedings: same title (to exercise NoTitle rule for InProceedings) -->
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2019" title="InProceedings Title 1" booktitle="Conf Two">
    <authors author="Author Twelve"/>
  </entries>

  <!-- PhDThesis: unique title -->
  <entries xsi:type="BibTeX:PhDThesis" id="PH1" year="2020" title="PhD Thesis Title 1" school="School One">
    <authors author="Author One"/>
    <authors author="Author Three"/>
  </entries>

  <!-- PhDThesis: same title as PH1 (to exercise NoTitle rule for PhDThesis) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PH2" year="2021" title="PhD Thesis Title 1" school="School Two">
    <authors author="Author Two"/>
  </entries>

  <!-- MasterThesis: unique title -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2022" title="Master Thesis Title 1" school="School Three">
    <authors author="Author Four"/>
    <authors author="Author Five"/>
  </entries>

  <!-- MasterThesis: same title as MT1 (to exercise NoTitle rule for MasterThesis) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT2" year="2023" title="Master Thesis Title 1" school="School Four">
    <authors author="Author Six"/>
  </entries>

  <!-- Unpublished: unique title -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Unpublished Title 1" note="Note U1">
    <authors author="Author Seven"/>
    <authors author="Author Eight"/>
  </entries>

  <!-- Unpublished: same title as U1 (to exercise NoTitle rule for Unpublished) -->
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Unpublished Title 1" note="Note U2">
    <authors author="Author Nine"/>
  </entries>

</BibTeX:BibTeXFile>