<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: design to exercise Article_* variants -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model-Driven Engineering Foundations" journal="Software Modeling Journal">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A2: same title as A1, new journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Model-Driven Engineering Foundations" journal="Journal of Advanced Transformations">
    <authors author="Carol White"/>
  </entries>

  <!-- A3: unique title, same journal as A1 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Testing Model Transformations" journal="Software Modeling Journal">
    <authors author="Alice Smith"/>
    <authors author="David Brown"/>
  </entries>

  <!-- A4: same title as A3, same journal as A1/A3 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Testing Model Transformations" journal="Software Modeling Journal">
    <authors author="Eve Black"/>
  </entries>

  <!-- A5: another unique article to enrich authors/journals -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Scalable Transformation Chains" journal="Enterprise Systems Quarterly">
    <authors author="Frank Green"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport (TitledEntry, non-Article) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="1999" title="Industrial Experience with ATL" >
    <authors author="George Miller"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Manuals (TitledEntry, non-Article) -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="ATL User Guide"/>
  <entries xsi:type="BibTeX:Manual" id="M2" title="EMF Core Reference"/>

  <!-- Books and InBook, InCollection to exercise Book, InBook, InCollection -->
  <entries xsi:type="BibTeX:Book" id="B1" year="2010" title="Model Transformation Patterns" publisher="TechBooks Publishing">
    <authors author="Helen Gray"/>
    <authors author="Ian Clark"/>
  </entries>

  <!-- InBook shares the book nature but distinct title -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2011" title="Chapter on ATL Optimization" publisher="TechBooks Publishing" chapter="7">
    <authors author="Ian Clark"/>
    <authors author="Jane Adams"/>
  </entries>

  <!-- InCollection: child of Book & BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2012" title="Case Studies in Model-Driven Engineering" publisher="Global Science Press" booktitle="Proceedings of MDE Case Studies">
    <authors author="Karl Novak"/>
    <authors author="Laura King"/>
  </entries>

  <!-- Proceedings and InProceedings to exercise both and BookTitledEntry -->
  <!-- P1: standalone Proceedings -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2015" title="International Conference on Model Engineering"/>
  <!-- P2: another Proceedings with different title -->
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2016" title="Workshop on Transformation Testing"/>
  <!-- IP1: InProceedings with unique title and booktitle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2015" title="Mutation Analysis for ATL" booktitle="International Conference on Model Engineering">
    <authors author="Michael Rose"/>
    <authors author="Nina Hall"/>
  </entries>

  <!-- Unpublished entries (AuthoredEntry + TitledEntry, no year) -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Early Draft on Model Synchronization" note="Submitted to journal, under review">
    <authors author="Oscar Page"/>
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Notes on Bidirectional Transformations" note="Internal technical report">
    <authors author="Paul Reed"/>
  </entries>

  <!-- MasterThesis and PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2013" title="Validation of Model Transformations" school="University of Metropolis">
    <authors author="Quentin Young"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2018" title="Scalable Model-Driven Analytics" school="Technical University of Gotham">
    <authors author="Rachel Lee"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Booklets (DatedEntry, not TitledEntry) -> UntitledEntry rule -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="2007"/>
  <entries xsi:type="BibTeX:Booklet" id="BL2" year="2008"/>

  <!-- Misc entries (no title) -> UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc" id="MSC1"/>
  <entries xsi:type="BibTeX:Misc" id="MSC2"/>

</BibTeX:BibTeXFile>