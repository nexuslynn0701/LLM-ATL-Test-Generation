<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise all Article* rules -->
  <!-- Unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Article Title" journal="Unique Journal One">
    <authors author="Author Alpha"/>
    <authors author="Author Beta"/>
  </entries>
  <!-- Duplicate title with same journal (pair with A4) -> both Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title Same Journal" journal="Repeated Journal">
    <authors author="Author Gamma"/>
  </entries>
  <!-- Duplicate title but different journal (pair with A6) ->
       first in title-set & first in journal-set -> Article_Title_Journal,
       second not in title-set & not in journal-set -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Title Diff Journal" journal="Journal X">
    <authors author="Author Delta"/>
    <authors author="Author Epsilon"/>
  </entries>
  <!-- Second of "Shared Title Same Journal" and same journal -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Shared Title Same Journal" journal="Repeated Journal">
    <authors author="Author Zeta"/>
    <authors author="Author Eta"/>
  </entries>
  <!-- Unique title but journal appears twice (pair with A7) ->
       this first in both sets -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Other Unique Article" journal="Twin Journal">
    <authors author="Author Theta"/>
  </entries>
  <!-- Second of "Shared Title Diff Journal" and new journal ->
       not in title-set & new journal (so first for its journal) -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Shared Title Diff Journal" journal="Journal Y">
    <authors author="Author Iota"/>
  </entries>
  <!-- Second in "Twin Journal" but title unique ->
       in title-set but not in journal-set -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Single Title Same Journal" journal="Twin Journal">
    <authors author="Author Kappa"/>
    <authors author="Author Lambda"/>
  </entries>

  <!-- Misc to exercise UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Misc" id="M2"/>

  <!-- Booklets (DatedEntry but not TitledEntry) -> UntitledEntry rule -->
  <entries xsi:type="BibTeX:Booklet" id="BKT1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="BKT2" year="2010"/>

  <!-- Manual (TitledEntry, no authors, no year) ->
       appears in distinct-title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="Manual Unique Title One"/>
  <!-- Another Manual with same title ->
       not in distinct-title set -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MAN2" title="Manual Unique Title One"/>

  <!-- TechReport (Authored, Dated, Titled) -->
  <!-- Title appears once -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2011" title="TechReport Exclusive Title">
    <authors author="Author Alpha"/>
  </entries>
  <!-- Title appears twice (pair with TR3);
       TR2 is first in distinct-title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2012" title="Shared TechReport Title">
    <authors author="Author Beta"/>
    <authors author="Author Gamma"/>
  </entries>
  <!-- Second with same title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR3" year="2013" title="Shared TechReport Title">
    <authors author="Author Delta"/>
  </entries>

  <!-- PhDThesis (ThesisEntry: Authored, Dated, Titled) -->
  <!-- Unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2014" title="PhD Unique Title" school="PhD School One">
    <authors author="Author Eta"/>
    <authors author="Author Theta"/>
  </entries>
  <!-- MasterThesis (ThesisEntry) unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MSC1" year="2015" title="Master Unique Title" school="Master School One">
    <authors author="Author Iota"/>
  </entries>

  <!-- Book (Authored, Dated, Titled, has publisher) -->
  <!-- Unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="1995" title="Distinct Book Title" publisher="Publisher One">
    <authors author="Author Kappa"/>
    <authors author="Author Lambda"/>
  </entries>
  <!-- Book used as superclass for InCollection & InBook cases -->
  <!-- This Book itself also gets transformed (distinct title) -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="1998" title="Base Book Title" publisher="Publisher Two">
    <authors author="Author Mu"/>
  </entries>

  <!-- InBook (Book subclass, Authored, Dated, Titled, has publisher & chapter) -->
  <!-- Unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="INB1" year="2000" title="InBook Chapter Title" publisher="Publisher Two" chapter="3">
    <authors author="Author Mu"/>
    <authors author="Author Nu"/>
  </entries>

  <!-- Proceedings (Dated, Titled) -->
  <!-- First Proceedings with shared title -> in distinct-title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2008" title="Proceedings Shared Title"/>
  <!-- Second with same title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2009" title="Proceedings Shared Title"/>

  <!-- InProceedings (Proceedings, Authored, Dated, BookTitledEntry) -->
  <!-- Unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2016" title="InProceedings Unique Title" booktitle="Conf A">
    <authors author="Author Alpha"/>
    <authors author="Author Omicron"/>
  </entries>
  <!-- Another InProceedings with same title ->
       not in distinct-title set -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2017" title="InProceedings Unique Title" booktitle="Conf B">
    <authors author="Author Beta"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry, Authored, Dated, Titled) -->
  <!-- Unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2018" title="InCollection Exclusive Title" booktitle="Collected Works" publisher="Publisher Two">
    <authors author="Author Nu"/>
    <authors author="Author Xi"/>
  </entries>

  <!-- Unpublished (Authored, Titled) -->
  <!-- Unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Unpublished Solo Title" note="Note One">
    <authors author="Author Omicron"/>
    <authors author="Author Pi"/>
  </entries>
  <!-- Two Unpublished with same title to trigger both title rules -->
  <!-- First in distinct-title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="UP2" title="Unpublished Shared Title" note="First Note">
    <authors author="Author Rho"/>
  </entries>
  <!-- Second with same title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="UP3" title="Unpublished Shared Title" note="Second Note">
    <authors author="Author Sigma"/>
    <authors author="Author Tau"/>
  </entries>
</BibTeX:BibTeXFile>