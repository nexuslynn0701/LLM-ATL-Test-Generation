<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: exercise all four article-related rules with duplicates in titles and journals -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Model Transformations in Practice" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A2: duplicate title with A1, unique journal -> Article_NoTitle_Journal (no title para, yes journal para) -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Model Transformations in Practice" journal="Transactions on Software Modeling">
    <authors author="Carol White"/>
  </entries>

  <!-- A3: unique title, journal J1 shared with A4 -> Article_Title_NoJournal (no journal para) -->
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Testing Model Transformations" journal="International Journal of Software Tools">
    <authors author="David Brown"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- A4: duplicate title with A3 and same journal -> Article_NoTitle_NoJournal (no title or journal para) -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Testing Model Transformations" journal="International Journal of Software Tools">
    <authors author="Eve Black"/>
  </entries>

  <!-- A5: another unique article for extra authors/journals coverage -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="ATL Transformation Case Studies" journal="Journal of Model Engineering">
    <authors author="Frank Green"/>
  </entries>

  <!-- Manual: titled, no authors/date -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL User Manual"/>

  <!-- Manual with same title as man1: -> TitledEntry_NoTitle_NoArticle (no title para) -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="ATL User Manual"/>

  <!-- TechReport: titled, dated, authored -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2010" title="Industrial Evaluation of ATL" >
    <authors author="Grace Hopper"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with same title as tr1: -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2011" title="Industrial Evaluation of ATL" >
    <authors author="Henry King"/>
  </entries>

  <!-- Unpublished: titled, authored, note -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="unp1" title="Unreleased MDE Tutorial" note="Draft version">
    <authors author="Isabel Lee"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Booklet: dated only (no title) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1999"/>

  <!-- Misc: completely minimal -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Book: titled, authored, dated, publisher -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" year="2000" title="Foundations of Model-Driven Engineering" publisher="ModelPress">
    <authors author="John Doe"/>
    <authors author="Carol White"/>
  </entries>

  <!-- InBook: Book subclass with chapter -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2006" title="Chapter on ATL" publisher="TechBooks" chapter="3">
    <authors author="Kevin Miller"/>
    <authors author="John Doe"/>
  </entries>

  <!-- InCollection: Book+BookTitledEntry -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" year="2007" title="Reusable Transformation Patterns" publisher="ModelPress">
    <authors author="Laura Scott"/>
    <authors author="Frank Green"/>
    <authors author="Bob Johnson"/>
    <!-- booktitle from BookTitledEntry -->
    <booktitle>Proceedings of the MDE Workshop</booktitle>
  </entries>

  <!-- Proceedings: titled, dated -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2008" title="Proceedings of the MDE Workshop"/>

  <!-- InProceedings: Proceedings+Authored+BookTitledEntry -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2008" title="Experience with Mutation Testing of ATL" booktitle="Proceedings of the MDE Workshop">
    <authors author="Mike Turner"/>
    <authors author="Grace Hopper"/>
  </entries>

  <!-- PhDThesis: ThesisEntry subtype -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2012" title="Analysis of Model Transformation Languages" school="University of Metropolis">
    <authors author="Nina Rose"/>
  </entries>

  <!-- MasterThesis: ThesisEntry subtype -> TitledEntry_Title_NoArticle (OCL7 in comments only) -->
  <entries xsi:type="BibTeX:MasterThesis" id="msc1" year="2013" title="Testing Strategies for Model Transformations" school="Tech University">
    <authors author="Oscar Perez"/>
    <authors author="Isabel Lee"/>
  </entries>

</BibTeX:BibTeXFile>