<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise all 4 Article rules -->
  <!-- A1: unique title, unique journal => Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Title A1" journal="Journal X">
    <authors author="Author One"/>
    <authors author="Author Two"/>
  </entries>

  <!-- A2 & A3: same title "Title A2A3", distinct journals => Article_Title_Journal for A2, Article_NoTitle_Journal for A3 -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Title A2A3" journal="Journal Y">
    <authors author="Author Three"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Title A2A3" journal="Journal Z">
    <authors author="Author Four"/>
    <authors author="Author One"/>
  </entries>

  <!-- A4 & A5: same journal "Journal W", distinct titles => Article_Title_Journal for A4, Article_Title_NoJournal for A5 -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Title A4" journal="Journal W">
    <authors author="Author Five"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Title A5" journal="Journal W">
    <authors author="Author Six"/>
    <authors author="Author Two"/>
  </entries>

  <!-- A6 & A7: same title and same journal => Article_Title_Journal for A6, Article_NoTitle_NoJournal for A7 -->
  <entries xsi:type="BibTeX:Article" id="art6" year="2006" title="Title A6A7" journal="Journal V">
    <authors author="Author Seven"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art7" year="2007" title="Title A6A7" journal="Journal V">
    <authors author="Author Eight"/>
    <authors author="Author One"/>
  </entries>

  <!-- Untitled entries for rule UntitledEntry (Booklet + Misc) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1999"/>
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Titled non-Article entries to exercise TitledEntry rules -->
  <!-- B1 & B2: Books with same title => one in Title set, one out -->
  <entries xsi:type="BibTeX:Book" id="book1" year="2010" title="Shared Book Title" publisher="Publisher P1">
    <authors author="Author Nine"/>
    <authors author="Author Two"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book2" year="2011" title="Shared Book Title" publisher="Publisher P2">
    <authors author="Author Ten"/>
  </entries>

  <!-- IB1 & IB2: InBooks with same title -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2012" title="Shared InBook Title" publisher="Publisher Q1" chapter="1">
    <authors author="Author Eleven"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="inbook2" year="2013" title="Shared InBook Title" publisher="Publisher Q2" chapter="2">
    <authors author="Author Three"/>
    <authors author="Author Nine"/>
  </entries>

  <!-- IC1 & IC2: InCollections with same title -->
  <entries xsi:type="BibTeX:InCollection" id="incol1" year="2014" title="Shared InCollection Title" publisher="Publisher R1" booktitle="Booktitle R">
    <authors author="Author Twelve"/>
    <authors author="Author Four"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="incol2" year="2015" title="Shared InCollection Title" publisher="Publisher R2" booktitle="Booktitle R">
    <authors author="Author Six"/>
  </entries>

  <!-- IP1 & IP2: InProceedings with same title -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2016" title="Shared InProceedings Title" booktitle="Conf A">
    <authors author="Author Five"/>
    <authors author="Author Eight"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" year="2017" title="Shared InProceedings Title" booktitle="Conf B">
    <authors author="Author Eleven"/>
  </entries>

  <!-- P1 & P2: Proceedings with same title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2018" title="Shared Proceedings Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2019" title="Shared Proceedings Title"/>

  <!-- M1 & M2: Manuals with same title -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Shared Manual Title"/>
  <entries xsi:type="BibTeX:Manual" id="man2" title="Shared Manual Title"/>

  <!-- U1 & U2: Unpublished with same title -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Shared Unpublished Title" note="Note U1">
    <authors author="Author Ten"/>
    <authors author="Author Three"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Shared Unpublished Title" note="Note U2">
    <authors author="Author Seven"/>
  </entries>

  <!-- T1 & T2: TechReports with same title -->
  <entries xsi:type="BibTeX:TechReport" id="tech1" year="1990" title="Shared TechReport Title">
    <authors author="Author Twelve"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tech2" year="1991" title="Shared TechReport Title">
    <authors author="Author Nine"/>
    <authors author="Author Five"/>
  </entries>

  <!-- Theses (PhD and Master) with distinct titles -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2000" title="PhD Thesis Title One" school="School S1">
    <authors author="Author Thirteen"/>
    <authors author="Author Two"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="2002" title="Master Thesis Title One" school="School S2">
    <authors author="Author Fourteen"/>
  </entries>

</BibTeX:BibTeXFile>