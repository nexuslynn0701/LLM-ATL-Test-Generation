<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Two Articles with same title and same journal (to trigger Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Shared Title 1" journal="Journal X">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title 1" journal="Journal X">
    <authors author="Carol White"/>
  </entries>

  <!-- Two Articles with different titles, same journal (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Unique Title 2" journal="Journal Y">
    <authors author="David Brown"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Unique Title 3" journal="Journal Y">
    <authors author="Eve Black"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Two Articles with same title, different journals (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Shared Title 2" journal="Journal Z">
    <authors author="Frank Green"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Shared Title 2" journal="Journal W">
    <authors author="Grace King"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- One Article with unique title and unique journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Completely Unique Article" journal="Very Special Journal">
    <authors author="Henry Lee"/>
  </entries>

  <!-- Booklets (UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1990"/>
  <entries xsi:type="BibTeX:Booklet" id="B2" year="1991"/>

  <!-- Misc (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Misc" id="M2"/>

  <!-- Manual (TitledEntry_NoArticle). Two manuals share the same title -->
  <entries xsi:type="BibTeX:Manual" id="MN1" title="Manual Shared Title">
  </entries>
  <entries xsi:type="BibTeX:Manual" id="MN2" title="Manual Shared Title">
  </entries>
  <entries xsi:type="BibTeX:Manual" id="MN3" title="Manual Unique Title">
  </entries>

  <!-- TechReport (TitledEntry_NoArticle), unique title -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="TechReport Unique Title">
    <authors author="Isabel Moore"/>
  </entries>

  <!-- Proceedings (TitledEntry_NoArticle) with duplicate and unique titles -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2011" title="Proceedings Shared Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2012" title="Proceedings Shared Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="P3" year="2013" title="Proceedings Unique Title"/>

  <!-- InProceedings (TitledEntry_NoArticle) with unique titles and various authors -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2014" title="InProc Title 1" booktitle="Conf A">
    <authors author="John Doe"/>
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2015" title="InProc Title 2" booktitle="Conf B">
    <authors author="Karen Young"/>
  </entries>

  <!-- Book and InBook with same title so that only Book keeps the title in Titles List -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="1995" title="Shared Book Title" publisher="Publisher One">
    <authors author="Leo Martin"/>
    <authors author="John Doe"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="IB1" year="1996" title="Shared Book Title" publisher="Publisher One" chapter="3">
    <authors author="Mary Scott"/>
  </entries>

  <!-- Another Book with unique title -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="1997" title="Completely Unique Book" publisher="Publisher Two">
    <authors author="Nina Adams"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- InCollection (TitledEntry_NoArticle) -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="1998" title="InCollection Title" publisher="Publisher Three" booktitle="Edited Volume 1">
    <authors author="Oscar Perez"/>
  </entries>

  <!-- PhDThesis (TitledEntry_NoArticle) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2000" title="PhD Thesis Title" school="Famous University">
    <authors author="Paul Quinn"/>
  </entries>

  <!-- MasterThesis (TitledEntry_NoArticle) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2001" title="Master Thesis Title" school="Technical Institute">
    <authors author="Rachel Stone"/>
  </entries>

  <!-- Unpublished (TitledEntry_NoArticle), three different titles -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Unpublished Title 1" note="Note for unpublished 1">
    <authors author="Sam Turner"/>
    <authors author="John Doe"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Unpublished Title 2" note="Note for unpublished 2">
    <authors author="Tina Evans"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U3" title="Unpublished Title 3" note="Note for unpublished 3">
    <authors author="Uma Vargas"/>
    <authors author="Victor Hall"/>
  </entries>

</BibTeX:BibTeXFile>