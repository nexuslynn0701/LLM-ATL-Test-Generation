<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise all four article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="T1" journal="J1">
    <authors author="Alice A."/>
    <authors author="Bob B."/>
  </entries>

  <!-- A2: duplicate title T2, unique journal J2 -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="T2" journal="J2">
    <authors author="Carol C."/>
  </entries>

  <!-- A3: same title T2 as A2, unique journal J3 -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="T2" journal="J3">
    <authors author="Dave D."/>
    <authors author="Eve E."/>
  </entries>

  <!-- A4: unique title T3, duplicate journal J4 (with A5) -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="T3" journal="J4">
    <authors author="Frank F."/>
  </entries>

  <!-- A5: same journal J4 as A4, unique title T4 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="T4" journal="J4">
    <authors author="Grace G."/>
    <authors author="Bob B."/>
  </entries>

  <!-- A6: unique title T5, duplicate journal J5 (with A7) -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="T5" journal="J5">
    <authors author="Heidi H."/>
  </entries>

  <!-- A7: same journal J5 as A6, duplicate title T6 (with A8) -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="T6" journal="J5">
    <authors author="Ivan I."/>
  </entries>

  <!-- A8: same title T6 as A7, unique journal J6 -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A8" year="2008" title="T6" journal="J6">
    <authors author="Judy J."/>
    <authors author="Carol C."/>
  </entries>

  <!-- A9: duplicate title T3 (with A4), duplicate journal J6 (with A8) -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A9" year="2009" title="T3" journal="J6">
    <authors author="Mallory M."/>
  </entries>

  <!-- Titled non-Article entries to exercise TitledEntry rules -->

  <!-- B1: Book with unique title T7 -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B1" year="2010" title="T7" publisher="Pub1">
    <authors author="Alice A."/>
    <authors author="Carol C."/>
  </entries>

  <!-- B2: Book with duplicate title T8 (with MT1) -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="B2" year="2011" title="T8" publisher="Pub2">
    <authors author="Niaj N."/>
  </entries>

  <!-- IB1: InBook with unique title T9 -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2012" title="T9" publisher="Pub3" chapter="1">
    <authors author="Oscar O."/>
    <authors author="Peggy P."/>
  </entries>

  <!-- IC1: InCollection with unique title T10 -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2013" title="T10" publisher="Pub4" booktitle="BT1">
    <authors author="Quentin Q."/>
  </entries>

  <!-- IP1: InProceedings with unique title T11 -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2014" title="T11" booktitle="BT2">
    <authors author="Rupert R."/>
    <authors author="Grace G."/>
  </entries>

  <!-- P1: Proceedings with unique title T12 -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2015" title="T12"/>

  <!-- P2: Proceedings with duplicate title T13 (with P3) -> TitledEntry_Title_NoArticle (first for this title) -->
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2016" title="T13"/>

  <!-- P3: Proceedings with same title T13 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="P3" year="2017" title="T13"/>

  <!-- M1: Manual with unique title T14 -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="T14"/>

  <!-- U1: Unpublished with unique title T15 -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="T15" note="Note for T15">
    <authors author="Trent T."/>
  </entries>

  <!-- U2: Unpublished with duplicate title T16 (with U3) -> TitledEntry_Title_NoArticle (first for this title) -->
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="T16" note="Note for first T16">
    <authors author="Uma U."/>
    <authors author="Victor V."/>
  </entries>

  <!-- U3: Unpublished with same title T16 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U3" title="T16" note="Note for second T16">
    <authors author="Walter W."/>
  </entries>

  <!-- TR1: TechReport with unique title T17 -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2018" title="T17">
    <authors author="Xavier X."/>
  </entries>

  <!-- MT1: MasterThesis with duplicate title T8 (with B2) -> TitledEntry_Title_NoArticle (first for this title) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2019" title="T8" school="School1">
    <authors author="Yvonne Y."/>
    <authors author="Zack Z."/>
  </entries>

  <!-- MT2: MasterThesis with unique title T18 -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT2" year="2020" title="T18" school="School2">
    <authors author="Alice A."/>
  </entries>

  <!-- PT1: PhDThesis with unique title T19 -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PT1" year="2021" title="T19" school="School3">
    <authors author="Bob B."/>
    <authors author="Carol C."/>
  </entries>

  <!-- Untitled entries (no title) to exercise UntitledEntry rule -->

  <!-- BL1: Booklet BL1 -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="1990"/>

  <!-- BL2: Booklet BL2 -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="BL2" year="1991"/>

  <!-- MSC1: Misc MSC1 -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MSC1"/>

  <!-- MSC2: Misc MSC2 -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="MSC2"/>

</BibTeX:BibTeXFile>