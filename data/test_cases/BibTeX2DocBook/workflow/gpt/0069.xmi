<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise all Article rules and journals list -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Model Transformations in Practice" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- A2: same title as A3, unique journal for that title -> Article_Title_Journal, no journal duplication -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Testing ATL Transformations" journal="Software Verification Journal">
    <authors author="Carol White"/>
  </entries>

  <!-- A3: same title as A2 but different journal -> Article_NoTitle_Journal (duplicate title, unique journal) -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Testing ATL Transformations" journal="Empirical Software Engineering Letters">
    <authors author="Dave Brown"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- A4 & A5: share same journal but have distinct titles -->
  <!-- A4: first title for that journal and first for that journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Metamodel Coverage Criteria" journal="Journal of Experimental Software Models">
    <authors author="Eve Black"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- A5: same journal as A4, different title -> Article_Title_NoJournal (unique title, duplicate journal) -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Automated Test Case Generation" journal="Journal of Experimental Software Models">
    <authors author="Grace Hall"/>
  </entries>

  <!-- A6 & A7: duplicate title and duplicate journal -> Article_NoTitle_NoJournal for the second -->
  <!-- A6: first combination title+journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Mutation Testing for Models" journal="International Journal of Model Quality">
    <authors author="Ian King"/>
    <authors author="Helen Lee"/>
  </entries>

  <!-- A7: same title and journal as A6 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Mutation Testing for Models" journal="International Journal of Model Quality">
    <authors author="John Doe"/>
  </entries>

  <!-- Manual (TitledEntry, no authors/date) -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="ATL User Guide"/>

  <!-- Second Manual with same title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M2" title="ATL User Guide"/>

  <!-- Booklet (DatedEntry, not titled) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="Blet1" year="1999"/>

  <!-- Misc (neither titled nor dated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="Misc1"/>

  <!-- TechReport: Titled, Dated, Authored -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="Survey of Model Transformation Languages">
    <authors author="Alice Smith"/>
    <authors author="Carol White"/>
  </entries>

  <!-- Second TechReport with same title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2011" title="Survey of Model Transformation Languages">
    <authors author="Bob Jones"/>
  </entries>

  <!-- Book: Titled, Authored, Dated, Publisher -> TitledEntry_Title_NoArticle, counted as SrcBook -->
  <entries xsi:type="BibTeX:Book" id="Book1" year="2008" title="Model-Driven Engineering Fundamentals" publisher="MDE Press">
    <authors author="Dave Brown"/>
    <authors author="Grace Hall"/>
  </entries>

  <!-- InBook: subclass of Book, extra chapter -> TitledEntry_Title_NoArticle and SrcInBook -->
  <entries xsi:type="BibTeX:InBook" id="InBook1" year="2009" title="Advanced Topics in MDE" publisher="Tech Books Publishing" chapter="3">
    <authors author="Helen Lee"/>
  </entries>

  <!-- Second InBook with same title to trigger TitledEntry_NoTitle_NoArticle for this one -->
  <entries xsi:type="BibTeX:InBook" id="InBook2" year="2012" title="Advanced Topics in MDE" publisher="Tech Books Publishing" chapter="7">
    <authors author="Ian King"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Proceedings: Titled, Dated (no authors) -> TitledEntry_Title_NoArticle, counted as SrcProceedings -->
  <entries xsi:type="BibTeX:Proceedings" id="Proc1" year="2013" title="Proceedings of the MDE Conference"/>

  <!-- Second Proceedings with same title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="Proc2" year="2014" title="Proceedings of the MDE Conference"/>

  <!-- InProceedings: Proceedings + Authored + BookTitledEntry -> TitledEntry_Title_NoArticle and SrcInProceedings -->
  <entries xsi:type="BibTeX:InProceedings" id="InProc1" year="2015" title="Refactoring Model Transformations" booktitle="Proceedings of the MDE Conference">
    <authors author="John Doe"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Second InProceedings with same title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="InProc2" year="2016" title="Refactoring Model Transformations" booktitle="Proceedings of the MDE Conference">
    <authors author="Frank Green"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -> TitledEntry_Title_NoArticle and SrcInCollection -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2017" title="Case Studies in MDE" booktitle="Handbook of Model-Driven Engineering" publisher="Software Science Press">
    <authors author="Carol White"/>
    <authors author="Megan Fox"/>
  </entries>

  <!-- Second InCollection with same title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC2" year="2018" title="Case Studies in MDE" booktitle="Handbook of Model-Driven Engineering" publisher="Software Science Press">
    <authors author="Bob Jones"/>
  </entries>

  <!-- PhDThesis: Titled, Authored, Dated, ThesisEntry (school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PhD1" year="2019" title="Scalable Model Transformations" school="University of Model Engineering">
    <authors author="Megan Fox"/>
    <authors author="John Doe"/>
  </entries>

  <!-- Second PhDThesis with same title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PhD2" year="2020" title="Scalable Model Transformations" school="Institute of Software Systems">
    <authors author="Grace Hall"/>
  </entries>

</BibTeX:BibTeXFile>