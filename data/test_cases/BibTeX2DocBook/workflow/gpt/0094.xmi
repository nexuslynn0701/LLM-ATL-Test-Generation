<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise all Article_* rules with distinct/different journals -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="TitleSameA" journal="JournalUnique1">
    <authors author="Author One"/>
    <authors author="Author Two"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="TitleSameA" journal="JournalUnique2">
    <authors author="Author Three"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="TitleC" journal="JournalSame">
    <authors author="Author Four"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="TitleD" journal="JournalSame">
    <authors author="Author Five"/>
    <authors author="Author Six"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="TitleSameB" journal="JournalSameTitleAndJournal">
    <authors author="Author Seven"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="TitleSameB" journal="JournalSameTitleAndJournal">
    <authors author="Author Eight"/>
    <authors author="Author Nine"/>
  </entries>

  <!-- Booklets (UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1990"/>
  <entries xsi:type="BibTeX:Booklet" id="B2" year="1991"/>

  <!-- Misc (UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Misc" id="M2"/>

  <!-- Manuals (titled, no authors, no dates; TitledEntry_* rules and Titles List) -->
  <entries xsi:type="BibTeX:Manual" id="MN1" title="ManualTitle1"/>
  <entries xsi:type="BibTeX:Manual" id="MN2" title="ManualTitleShared"/>
  <entries xsi:type="BibTeX:Manual" id="MN3" title="ManualTitleShared"/>

  <!-- TechReports (titled, authored, dated; TitledEntry_* rules) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="TechTitle1">
    <authors author="Author Ten"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2011" title="TechTitleShared">
    <authors author="Author Eleven"/>
    <authors author="Author Twelve"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR3" year="2012" title="TechTitleShared">
    <authors author="Author Thirteen"/>
  </entries>

  <!-- Proceedings (titled, dated; some with shared titles) -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2015" title="ProcTitleUnique"/>
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2016" title="ProcTitleShared"/>
  <entries xsi:type="BibTeX:Proceedings" id="P3" year="2017" title="ProcTitleShared"/>

  <!-- Books (titled, authored, dated, publisher) -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="1999" title="BookTitleUnique" publisher="PublisherOne">
    <authors author="Author Fourteen"/>
    <authors author="Author Fifteen"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="BK2" year="2000" title="BookTitleShared" publisher="PublisherTwo">
    <authors author="Author Sixteen"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="BK3" year="2001" title="BookTitleShared" publisher="PublisherThree">
    <authors author="Author Seventeen"/>
    <authors author="Author Eighteen"/>
  </entries>

  <!-- InBook (subclass of Book, has chapter) -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2002" title="InBookTitle" publisher="PublisherFour" chapter="3">
    <authors author="Author Nineteen"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2003" title="InCollectionTitle" publisher="PublisherFive" booktitle="BookTitleForCollection">
    <authors author="Author Twenty"/>
    <authors author="Author Twenty One"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="IC2" year="2004" title="InCollectionTitleShared" publisher="PublisherSix" booktitle="BookTitleForCollectionShared">
    <authors author="Author Twenty Two"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="IC3" year="2005" title="InCollectionTitleShared" publisher="PublisherSeven" booktitle="BookTitleForCollectionShared">
    <authors author="Author Twenty Three"/>
    <authors author="Author Twenty Four"/>
  </entries>

  <!-- InProceedings (Proceedings + AuthoredEntry + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2018" title="InProceedingsTitle" booktitle="InProcBookTitle">
    <authors author="Author Twenty Five"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2019" title="InProceedingsTitleShared" booktitle="InProcBookTitleShared">
    <authors author="Author Twenty Six"/>
    <authors author="Author Twenty Seven"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP3" year="2020" title="InProceedingsTitleShared" booktitle="InProcBookTitleShared">
    <authors author="Author Twenty Eight"/>
  </entries>

  <!-- Unpublished (titled, authored, note) -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="UnpubTitleUnique" note="Note one">
    <authors author="Author Twenty Nine"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="UnpubTitleShared" note="Note two">
    <authors author="Author Thirty"/>
    <authors author="Author Thirty One"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U3" title="UnpubTitleShared" note="Note three">
    <authors author="Author Thirty Two"/>
  </entries>

  <!-- PhDThesis (ThesisEntry: titled, authored, dated, school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2013" title="PhDTitleUnique" school="SchoolOne">
    <authors author="Author Thirty Three"/>
    <authors author="Author Thirty Four"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PHD2" year="2014" title="PhDTitleShared" school="SchoolTwo">
    <authors author="Author Thirty Five"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PHD3" year="2015" title="PhDTitleShared" school="SchoolThree">
    <authors author="Author Thirty Six"/>
    <authors author="Author Thirty Seven"/>
  </entries>

  <!-- MasterThesis (ThesisEntry; rule in OCL but ATL uses generic TitledEntry processing) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2016" title="MasterTitleUnique" school="SchoolFour">
    <authors author="Author Thirty Eight"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT2" year="2017" title="MasterTitleShared" school="SchoolFive">
    <authors author="Author Thirty Nine"/>
    <authors author="Author Forty"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT3" year="2018" title="MasterTitleShared" school="SchoolSix">
    <authors author="Author Forty One"/>
  </entries>
</BibTeX:BibTeXFile>