<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: combinations for all Article* rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Unique Article One" journal="Journal A">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- A2 + A3: same title, different journals -->
  <!-- A2: in title set, journal unique -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Shared Title TJ" journal="Journal B">
    <authors author="Carol Scribe"/>
  </entries>

  <!-- A3: same title, another journal; not in title set, journal unique -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Shared Title TJ" journal="Journal C">
    <authors author="Dave Researcher"/>
    <authors author="Alice Author"/>
  </entries>

  <!-- A4 + A5: different titles, same journal -->
  <!-- A4: in title set, journal not unique -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Title T1 JX" journal="Journal X">
    <authors author="Eve Scientist"/>
  </entries>

  <!-- A5: not in title set, same journal as A4 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Title T2 JX" journal="Journal X">
    <authors author="Frank Analyst"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- A6 + A7: same title and same journal -->
  <!-- A6: first with (Title TJ2, Journal Y) -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art6" year="2006" title="Title TJ2" journal="Journal Y">
    <authors author="Grace Engineer"/>
  </entries>

  <!-- A7: duplicate title and journal -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art7" year="2007" title="Title TJ2" journal="Journal Y">
    <authors author="Heidi Developer"/>
  </entries>

  <!-- Titled non-Article entries exercising TitledEntry rules -->

  <!-- B1: Book, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" year="1999" title="Unique Book Title" publisher="Publisher One">
    <authors author="Ian Author"/>
    <authors author="Jane Scholar"/>
  </entries>

  <!-- B2 + IB1: Book and InBook share the same title -->
  <!-- B2: Book with title in distinct-title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book2" year="1998" title="Shared Book Title" publisher="Publisher Two">
    <authors author="Kevin Writer"/>
  </entries>

  <!-- IB1: InBook with duplicate title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2000" title="Shared Book Title" publisher="Publisher Two" chapter="3">
    <authors author="Laura Editor"/>
    <authors author="Kevin Writer"/>
  </entries>

  <!-- IC1: InCollection, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="incol1" year="2005" title="InCollection Title" publisher="Publisher Three" booktitle="Collected Works Vol. 1">
    <authors author="Mike Contributor"/>
  </entries>

  <!-- IP1 + IP2: InProceedings with same title, different booktitles -->
  <!-- IP1: in distinct-title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2010" title="Conference Paper Title" booktitle="Proceedings P1">
    <authors author="Nina Speaker"/>
    <authors author="Oscar Presenter"/>
  </entries>

  <!-- IP2: duplicate title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" year="2011" title="Conference Paper Title" booktitle="Proceedings P2">
    <authors author="Paul Chair"/>
  </entries>

  <!-- MT1: MasterThesis, unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" year="2012" title="Master Thesis Title" school="Tech University">
    <authors author="Quinn Student"/>
  </entries>

  <!-- PhD1 + PhD2: same title -->
  <!-- PhD1: in distinct-title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2013" title="Thesis Shared Title" school="Science University">
    <authors author="Rita Researcher"/>
  </entries>

  <!-- PhD2: duplicate title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd2" year="2014" title="Thesis Shared Title" school="Another University">
    <authors author="Sam Scholar"/>
  </entries>

  <!-- TR1 + TR2: TechReports with same title -->
  <!-- TR1: in distinct-title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2015" title="TechReport Title Shared">
    <authors author="Tom Technician"/>
  </entries>

  <!-- TR2: duplicate title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2016" title="TechReport Title Shared">
    <authors author="Uma Engineer"/>
  </entries>

  <!-- PR1 + PR2: Proceedings, not authored -->
  <!-- PR1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2017" title="Unique Proceedings Title"/>
  <!-- PR2: duplicated title will use NoTitle rule -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2018" title="Duplicate Proceedings Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc3" year="2019" title="Duplicate Proceedings Title"/>

  <!-- M1 + M2: Manual, same title -->
  <!-- M1 in distinct-title set, M2 duplicate -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Manual Title Shared"/>
  <entries xsi:type="BibTeX:Manual" id="man2" title="Manual Title Shared"/>

  <!-- U1 + U2: Unpublished with same title -->
  <entries xsi:type="BibTeX:Unpublished" id="unp1" title="Unpublished Shared Title" note="First note">
    <authors author="Victor Author"/>
    <authors author="Wendy Writer"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unp2" title="Unpublished Shared Title" note="Second note">
    <authors author="Xavier Researcher"/>
  </entries>

  <!-- U3: Unpublished with unique title -->
  <entries xsi:type="BibTeX:Unpublished" id="unp3" title="Unique Unpublished Title" note="Unique note">
    <authors author="Yvonne Scientist"/>
  </entries>

  <!-- Untitled entries: Booklet and Misc, using UntitledEntry rule -->

  <!-- Booklets -->
  <entries xsi:type="BibTeX:Booklet" id="bkt1" year="1990"/>
  <entries xsi:type="BibTeX:Booklet" id="bkt2" year="1991"/>

  <!-- Misc entries -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Misc" id="misc2"/>

</BibTeX:BibTeXFile>