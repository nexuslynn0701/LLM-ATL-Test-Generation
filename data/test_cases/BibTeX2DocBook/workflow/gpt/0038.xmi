<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles: exercise all four Article rules depending on (title, journal) uniqueness -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="Unique Title One" journal="Unique Journal One">
    <authors author="Author A"/>
    <authors author="Author B"/>
  </entries>
  <!-- A2 & A3: same title, different journals.
       A2 chosen for title & journal sets -> Article_Title_Journal
       A3 -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Shared Title TJ" journal="Journal TJ1">
    <authors author="Author C"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Shared Title TJ" journal="Journal TJ2">
    <authors author="Author D"/>
    <authors author="Author E"/>
  </entries>
  <!-- A4 & A5: different titles, same journal.
       A4 chosen for journal set and for title set -> Article_Title_Journal
       A5 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="Title JN1" journal="Shared Journal Only">
    <authors author="Author F"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="Title JN2" journal="Shared Journal Only">
    <authors author="Author G"/>
    <authors author="Author H"/>
  </entries>
  <!-- A6 & A7: same title and same journal.
       A6 chosen for both sets -> Article_Title_Journal
       A7 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art6" year="2006" title="Shared Title Journal" journal="Duplicate Journal">
    <authors author="Author I"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art7" year="2007" title="Shared Title Journal" journal="Duplicate Journal">
    <authors author="Author J"/>
    <authors author="Author K"/>
  </entries>

  <!-- Booklets (DatedEntry only, no title): UntitledEntry rule -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet2" year="2010"/>

  <!-- Misc entries (completely untitled): UntitledEntry rule -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Misc" id="misc2"/>

  <!-- Manual (TitledEntry, no authors/year): TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Manual Title X"/>

  <!-- TechReport: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2011" title="TechReport Unique Title">
    <authors author="Author L"/>
  </entries>

  <!-- TechReport: duplicated title with tr1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2012" title="TechReport Unique Title">
    <authors author="Author M"/>
    <authors author="Author A"/>
  </entries>

  <!-- Manual: duplicate title with man1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="Manual Title X"/>

  <!-- Unpublished entries: one unique, one duplicate title to exercise both rules -->
  <!-- UP1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="up1" title="Draft Paper Alpha" note="Note Alpha">
    <authors author="Author N"/>
    <authors author="Author O"/>
  </entries>
  <!-- UP2: duplicate title with UP1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="up2" title="Draft Paper Alpha" note="Note Beta">
    <authors author="Author P"/>
  </entries>

  <!-- Book (Authored, Dated, Titled): unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" year="1995" title="Unique Book Title" publisher="Publisher One">
    <authors author="Author Q"/>
    <authors author="Author R"/>
  </entries>

  <!-- Book: duplicate title with book1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book2" year="1996" title="Unique Book Title" publisher="Publisher Two">
    <authors author="Author S"/>
  </entries>

  <!-- InBook: child of Book with chapter (also TitledEntry) -->
  <!-- inbook1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2008" title="Chapter Based Work" publisher="Pub InBook" chapter="3">
    <authors author="Author T"/>
  </entries>
  <!-- inbook2: duplicate title with inbook1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="inbook2" year="2009" title="Chapter Based Work" publisher="Pub InBook 2" chapter="5">
    <authors author="Author U"/>
    <authors author="Author V"/>
  </entries>

  <!-- Proceedings (Dated, Titled) -->
  <!-- proc1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2015" title="Symposium One"/>
  <!-- proc2: duplicate title with proc1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2016" title="Symposium One"/>

  <!-- InProceedings (Proceedings + Authored + BookTitledEntry, also TitledEntry via Proceedings supertype) -->
  <!-- inproc1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2017" title="Paper In Symposium" booktitle="Symposium One Book">
    <authors author="Author W"/>
    <authors author="Author X"/>
  </entries>
  <!-- inproc2: duplicate title with inproc1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" year="2018" title="Paper In Symposium" booktitle="Symposium One Book 2">
    <authors author="Author Y"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <!-- incol1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="incol1" year="2019" title="Collected Chapter" publisher="Publisher Coll" booktitle="Collection One">
    <authors author="Author Z"/>
    <authors author="Author AA"/>
  </entries>
  <!-- incol2: duplicate title with incol1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="incol2" year="2020" title="Collected Chapter" publisher="Publisher Coll 2" booktitle="Collection Two">
    <authors author="Author BB"/>
  </entries>

  <!-- PhDThesis (ThesisEntry) -->
  <!-- phd1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2013" title="PhD Thesis Title" school="Tech University">
    <authors author="Author CC"/>
  </entries>
  <!-- phd2: duplicate title with phd1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd2" year="2014" title="PhD Thesis Title" school="Science University">
    <authors author="Author DD"/>
    <authors author="Author EE"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) -->
  <!-- msc1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="msc1" year="2011" title="Master Thesis Title" school="Engineering School">
    <authors author="Author FF"/>
  </entries>
  <!-- msc2: duplicate title with msc1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="msc2" year="2012" title="Master Thesis Title" school="Engineering School 2">
    <authors author="Author GG"/>
    <authors author="Author HH"/>
  </entries>
</BibTeX:BibTeXFile>