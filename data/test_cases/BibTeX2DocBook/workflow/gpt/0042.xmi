<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles: cover all 4 article rules via title/journal combinations -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" year="2001" title="MDE for Embedded Systems" journal="Journal of Embedded Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- A2: duplicate title with A3, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="art2" year="2002" title="Testing Model Transformations" journal="Software Validation Journal">
    <authors author="Carol White"/>
  </entries>

  <!-- A3: same title as A2, different journal -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art3" year="2003" title="Testing Model Transformations" journal="International Journal of Model Engineering">
    <authors author="David Black"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- A4: same title as A5 and same journal -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art4" year="2004" title="ATL Transformation Patterns" journal="Model Driven Software Journal">
    <authors author="Eve Brown"/>
  </entries>

  <!-- A5: same title and journal as A4 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art5" year="2005" title="ATL Transformation Patterns" journal="Model Driven Software Journal">
    <authors author="Frank Green"/>
    <authors author="Carol White"/>
  </entries>

  <!-- TechReport: titled, non-article -> TitledEntry_*_NoArticle -->
  <!-- TR1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" year="2010" title="Incremental Model Synchronization">
    <authors author="George King"/>
  </entries>

  <!-- TR2: duplicate title with TR3 -> one Title, one NoTitle -->
  <!-- TR2 chosen in titled set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" year="2011" title="Search-Based Testing of Transformations">
    <authors author="Helen Clark"/>
    <authors author="Ian Gray"/>
  </entries>

  <!-- TR3: same title as TR2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr3" year="2012" title="Search-Based Testing of Transformations">
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Manual: titled, non-article; unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="User Guide for MDE Toolchain"/>

  <!-- Proceedings: titled, non-article -->
  <!-- P1: unique title -> TitledEntry_Title_NoArticle; also counted in SrcProceedings -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" year="2015" title="International Conference on Model Engineering"/>
  <!-- P2: duplicate title with P3 -> one Title, one NoTitle -->
  <!-- P2 chosen in titled set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" year="2016" title="Workshop on Transformation Testing"/>
  <!-- P3: same title as P2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="proc3" year="2017" title="Workshop on Transformation Testing"/>

  <!-- InProceedings: titled, authored, dated, booktitled; non-article -->
  <!-- IP1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" year="2018" title="Mutation Analysis for ATL" booktitle="Proc. ICME 2018">
    <authors author="Jack Lee"/>
    <authors author="Alice Smith"/>
  </entries>
  <!-- IP2: duplicate title with IP3 -> one Title, one NoTitle -->
  <!-- IP2 chosen in titled set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" year="2019" title="Coverage Criteria for Transformations" booktitle="Proc. WTST 2019">
    <authors author="Karen Miller"/>
  </entries>
  <!-- IP3: same title as IP2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc3" year="2020" title="Coverage Criteria for Transformations" booktitle="Proc. WTST 2020">
    <authors author="David Black"/>
  </entries>

  <!-- Book: titled, authored, dated, publisher -->
  <!-- B1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" year="2000" title="Foundations of Model-Driven Engineering" publisher="TechBooks Publishing">
    <authors author="Laura Scott"/>
    <authors author="Mike Adams"/>
  </entries>

  <!-- InBook: titled, authored, dated, publisher, chapter -->
  <!-- IB1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" year="2006" title="Chapter on Model Transformations" publisher="Springer Studies" chapter="3">
    <authors author="Nina Perez"/>
    <authors author="Oscar Quinn"/>
  </entries>

  <!-- InCollection: inherits from Book + BookTitledEntry: titled, authored, dated, publisher, booktitle -->
  <!-- IC1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" year="2007" title="Reusable Transformation Patterns" publisher="Academic Press" booktitle="Handbook of Software Engineering">
    <authors author="Paul Rogers"/>
  </entries>

  <!-- Unpublished: titled, authored, note -->
  <!-- U1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft on Bidirectional Transformations" note="to appear">
    <authors author="Quinn Stone"/>
    <authors author="Rachel Turner"/>
  </entries>
  <!-- U2: duplicate title with U3 -> one Title, one NoTitle -->
  <!-- U2 chosen in titled set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Early Results on Traceability" note="internal report">
    <authors author="Steve Walker"/>
  </entries>
  <!-- U3: same title as U2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub3" title="Early Results on Traceability" note="revised version">
    <authors author="Tina Young"/>
    <authors author="George King"/>
  </entries>

  <!-- PhDThesis: titled, authored, dated, thesisentry (school) -->
  <!-- PHD1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" year="2013" title="Analysis of Model Transformation Quality" school="University of Metropolis">
    <authors author="Uma Zhao"/>
  </entries>
  <!-- PHD2: duplicate title with PHD3 -> one Title, one NoTitle -->
  <!-- PHD2 chosen in titled set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd2" year="2014" title="Verification of Model Transformations" school="Tech University">
    <authors author="Victor Young"/>
  </entries>
  <!-- PHD3: same title as PHD2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd3" year="2015" title="Verification of Model Transformations" school="City University">
    <authors author="Wendy Zhang"/>
    <authors author="Mike Adams"/>
  </entries>

  <!-- MasterThesis: titled, authored, dated, thesisentry (school) -->
  <!-- MT1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" year="2016" title="Tool Support for Model Testing" school="Institute of Software">
    <authors author="Yvonne Carter"/>
  </entries>

  <!-- Booklet: dated only; untitled -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1999"/>

  <!-- Misc: completely untitled, unauthored, undated -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

</BibTeX:BibTeXFile>