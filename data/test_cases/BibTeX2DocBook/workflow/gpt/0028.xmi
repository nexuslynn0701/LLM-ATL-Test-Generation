<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles to exercise all Article_* rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Title 1" journal="Journal U1">
    <authors author="Author Alpha"/>
    <authors author="Common Author 1"/>
  </entries>
  <!-- A2: same title as A1, different journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Unique Title 1" journal="Journal U2">
    <authors author="Author Beta"/>
  </entries>
  <!-- A3: different title, same journal as A3/A4 set; first in journal -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Cluster Title" journal="Cluster Journal">
    <authors author="Common Author 1"/>
    <authors author="Author Gamma"/>
  </entries>
  <!-- A4: same journal as A3 and A5, different title and journal not in first-journal set -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Another Cluster Title" journal="Cluster Journal">
    <authors author="Author Delta"/>
  </entries>
  <!-- A5: same title and journal as A3, not in title/journal representative sets -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Cluster Title" journal="Cluster Journal">
    <authors author="Common Author 2"/>
  </entries>

  <!-- Untitled entries (no TitledEntry) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1999"/>

  <!-- Titled entries (non-Article) to exercise TitledEntry_* rules -->
  <!-- Book with distinct title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="2010" title="Distinct Book Title" publisher="Publisher One">
    <authors author="Author Book 1"/>
    <authors author="Common Author 2"/>
  </entries>
  <!-- Book with shared title (first occurrence) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK2" year="2011" title="Repeated Title" publisher="Publisher Two">
    <authors author="Author Book 2"/>
  </entries>
  <!-- Book with same title as BK2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK3" year="2012" title="Repeated Title" publisher="Publisher Three">
    <authors author="Author Book 3"/>
    <authors author="Author Alpha"/>
  </entries>

  <!-- InBook with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2013" title="InBook Unique Title" publisher="Publisher Four" chapter="7">
    <authors author="Author InBook 1"/>
  </entries>

  <!-- InCollection sharing title with a Proceedings to test title dedup across types -->
  <!-- First with that title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2014" title="Cross-Type Shared Title" publisher="Publisher Five">
    <authors author="Author Collection 1"/>
  </entries>
  <!-- Second with that title (Proceedings) -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2015" title="Cross-Type Shared Title"/>

  <!-- Proceedings with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2016" title="Unique Proceedings Title"/>

  <!-- Manual with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MN1" title="Manual Unique Title"/>

  <!-- TechReport with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2017" title="TechReport Unique Title">
    <authors author="Author Tech 1"/>
  </entries>

  <!-- Unpublished with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Unpublished Unique Title" note="Some note here">
    <authors author="Author Unpub 1"/>
    <authors author="Author Unpub 2"/>
  </entries>

  <!-- PhDThesis with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2018" title="PhD Thesis Unique Title" school="Tech University">
    <authors author="Author PhD 1"/>
    <authors author="Common Author 1"/>
  </entries>

  <!-- MasterThesis with title shared with no one else -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2019" title="Master Thesis Unique Title" school="Science University">
    <authors author="Author Master 1"/>
  </entries>
</BibTeX:BibTeXFile>