<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to trigger all four Article* rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Title One" journal="Unique Journal One">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- A2 & A3: same title, different journals.
       A2 is first with that title and unique journal -> Article_Title_Journal
       A3 gets Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Article Title" journal="Distinct Journal X">
    <authors author="Carol Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Article Title" journal="Distinct Journal Y">
    <authors author="Dave Scientist"/>
    <authors author="Alice Author"/>
  </entries>

  <!-- A4 & A5: same journal, different titles.
       A4 first with that journal and unique title -> Article_Title_Journal
       A5 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Article In Popular Journal 1" journal="Popular Journal">
    <authors author="Eve Engineer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Article In Popular Journal 2" journal="Popular Journal">
    <authors author="Frank Developer"/>
    <authors author="George Analyst"/>
  </entries>

  <!-- A6 & A7: same title and same journal.
       A6 first -> Article_Title_Journal
       A7 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Duplicate Everything" journal="Cloned Journal">
    <authors author="Helen Architect"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Duplicate Everything" journal="Cloned Journal">
    <authors author="Ian Designer"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- Untitled entries (Booklet + Misc) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="1999"/>
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- Titled non-article entries to hit TitledEntry_* rules -->

  <!-- Manual with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="Manual Unique Title">
  </entries>

  <!-- TechReport with duplicated title:
       TR1 chosen in distinct-title set -> TitledEntry_Title_NoArticle
       TR2 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="Duplicated TechReport Title">
    <authors author="Jack Tester"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2011" title="Duplicated TechReport Title">
    <authors author="Karen Reviewer"/>
    <authors author="Laura Author"/>
  </entries>

  <!-- Book with unique title and two authors -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="BK1" year="1995" title="Book Unique Title" publisher="Fictional Press">
    <authors author="Michael Writer"/>
    <authors author="Nina Coauthor"/>
  </entries>

  <!-- InBook with shared title with an InCollection to force TitledEntry_NoTitle_NoArticle on one of them -->

  <!-- InBook first with that title -> included in distinct-title set -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="1998" title="Shared Chapter Title" publisher="Science House" chapter="3">
    <authors author="Oscar Scholar"/>
  </entries>

  <!-- InCollection second with same title -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="1999" title="Shared Chapter Title" booktitle="Collected Works on Sharing" publisher="Collection Publishers">
    <authors author="Paula Contributor"/>
    <authors author="Nina Coauthor"/>
  </entries>

  <!-- Proceedings entries:
       PR1 with unique title -> TitledEntry_Title_NoArticle
       PR2 & PR3 share title; PR2 gets Title, PR3 NoTitle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2015" title="Unique Proceedings Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2016" title="Shared Proceedings Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="PR3" year="2017" title="Shared Proceedings Title"/>

  <!-- InProceedings entries:
       IP1 unique title -> TitledEntry_Title_NoArticle
       IP2 & IP3 share title; IP2 Title, IP3 NoTitle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2012" title="Single InProceedings Title" booktitle="Conference Alpha">
    <authors author="Quentin Speaker"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2013" title="Repeated InProceedings Title" booktitle="Conference Beta">
    <authors author="Rachel Presenter"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP3" year="2014" title="Repeated InProceedings Title" booktitle="Conference Gamma">
    <authors author="Sam Researcher"/>
    <authors author="George Analyst"/>
  </entries>

  <!-- Thesis entries (PhD and Master) to hit thesis-specific TitledEntry rules -->
  <!-- PhDThesis with unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2008" title="Doctoral Thesis on Testing" school="Tech University">
    <authors author="Tom Doctoral"/>
    <authors author="Uma Advisor"/>
  </entries>

  <!-- MasterThesis titles duplicated:
       MT1 first -> TitledEntry_Title_NoArticle, MT2 -> NoTitle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2009" title="Master Thesis On Models" school="Engineering School">
    <authors author="Victor Student"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT2" year="2010" title="Master Thesis On Models" school="Science Institute">
    <authors author="Wendy Graduate"/>
  </entries>

  <!-- Additional Unpublished entries, one unique and a duplicate pair -->
  <!-- UN1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="UN1" title="Unpublished Unique Work" note="Draft version only">
    <authors author="Xavier Unpublished"/>
  </entries>

  <!-- UN2 & UN3 share title; UN2 Title, UN3 NoTitle -->
  <entries xsi:type="BibTeX:Unpublished" id="UN2" title="Unpublished Shared Work" note="First draft">
    <authors author="Yvonne Author"/>
    <authors author="Zack Coauthor"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="UN3" title="Unpublished Shared Work" note="Second draft">
    <authors author="Alice Author"/>
  </entries>

</BibTeX:BibTeXFile>