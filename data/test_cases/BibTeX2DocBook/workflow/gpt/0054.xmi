<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles designed to trigger all four Article rules -->

  <!-- A1: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Title One" journal="Exclusive Journal One">
    <authors author="Alice A."/>
    <authors author="Bob B."/>
  </entries>

  <!-- A2 & A3: same title, different journals
       - A2 chosen in title-set, A3 not
       Both journals unique -> Article_Title_Journal for A2, Article_NoTitle_Journal for A3 -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title Alpha" journal="Alpha Journal">
    <authors author="Carol C."/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Title Alpha" journal="Beta Journal">
    <authors author="Dave D."/>
  </entries>

  <!-- A4 & A5: different titles, same journal
       - A4 chosen in journal-set, A5 not
       Both titles unique -> Article_Title_Journal for A4, Article_Title_NoJournal for A5 -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Journal Shared First" journal="Common Journal">
    <authors author="Eve E."/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Journal Shared Second" journal="Common Journal">
    <authors author="Frank F."/>
  </entries>

  <!-- A6: duplicate of (title, journal) pair with A5
       A5 is selected for both title-set and journal-set, A6 is not -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Journal Shared Second" journal="Common Journal">
    <authors author="Grace G."/>
  </entries>

  <!-- Titled non-Article entries to hit TitledEntry rules -->

  <!-- B1 & B2: Books with same title
       - B1 in title-set, B2 not -> Title_NoArticle for B1, NoTitle_NoArticle for B2 -->
  <entries xsi:type="BibTeX:Book" id="B1" year="2010" title="Duplicated Book Title" publisher="Pub House One">
    <authors author="Helen H."/>
  </entries>

  <entries xsi:type="BibTeX:Book" id="B2" year="2011" title="Duplicated Book Title" publisher="Pub House Two">
    <authors author="Ian I."/>
  </entries>

  <!-- IB1: InBook with unique title -> Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2012" title="InBook Special Title" publisher="InBook Publisher" chapter="3">
    <authors author="Jack J."/>
    <authors author="Karen K."/>
  </entries>

  <!-- IC1: InCollection with unique title -> Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2013" title="Collected Works Title" booktitle="Collection Volume 1" publisher="Collection Publisher">
    <authors author="Laura L."/>
  </entries>

  <!-- IP1 & IP2: InProceedings with same title
       - IP1 in title-set, IP2 not -> Title_NoArticle for IP1, NoTitle_NoArticle for IP2 -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2014" title="Conference Paper Title" booktitle="Conf 2020" >
    <authors author="Mike M."/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2015" title="Conference Paper Title" booktitle="Conf 2021">
    <authors author="Nina N."/>
  </entries>

  <!-- PR1 & PR2: Proceedings with same title
       - PR1 in title-set, PR2 not -> Title_NoArticle for PR1, NoTitle_NoArticle for PR2 -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" year="2016" title="Annual Meeting Proceedings"/>
  <entries xsi:type="BibTeX:Proceedings" id="PR2" year="2017" title="Annual Meeting Proceedings"/>

  <!-- MT1: MasterThesis -> Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2018" title="Master Thesis Title" school="Tech University">
    <authors author="Olivia O."/>
  </entries>

  <!-- PHD1: PhDThesis (solo title) -> Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" year="2019" title="PhD Thesis Unique" school="Science Institute">
    <authors author="Peter P."/>
    <authors author="Quinn Q."/>
  </entries>

  <!-- PHD2: PhDThesis sharing title with Unpublished UP1 to test cross-type title dedup
       One of them will be in title-set, the other not -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD2" year="2020" title="Shared Thesis &amp; Unpublished Title" school="Global University">
    <authors author="Rachel R."/>
  </entries>

  <!-- UP1: Unpublished sharing its title with PHD2 -->
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Shared Thesis &amp; Unpublished Title" note="Under review">
    <authors author="Rachel R."/>
    <authors author="Sam S."/>
  </entries>

  <!-- UP2: Unpublished with unique title -->
  <entries xsi:type="BibTeX:Unpublished" id="UP2" title="Solo Unpublished Title" note="Draft version">
    <authors author="Tom T."/>
  </entries>

  <!-- TR1 & TR2: TechReports with same title
       - TR1 in title-set, TR2 not -> Title_NoArticle for TR1, NoTitle_NoArticle for TR2 -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2021" title="Tech Report Repeated Title">
    <authors author="Uma U."/>
  </entries>

  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2022" title="Tech Report Repeated Title">
    <authors author="Victor V."/>
  </entries>

  <!-- M1: Manual with unique title -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="Manual of Unique Tools"/>

  <!-- Untitled entries (no title) to trigger UntitledEntry: Booklet and Misc -->

  <!-- BL1 & BL2: Booklets (DatedEntry but not TitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="1999"/>
  <entries xsi:type="BibTeX:Booklet" id="BL2" year="2000"/>

  <!-- MSC1: Misc (neither titled nor dated) -->
  <entries xsi:type="BibTeX:Misc" id="MSC1"/>

</BibTeX:BibTeXFile>