<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Articles to exercise all four Article rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="Unique Article One" journal="Journal A">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- A2, A3: same title, distinct journals -> one in title set, both in journal set
       A2 will be Article_Title_Journal, A3 Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="Shared Title Alpha" journal="Journal B">
    <authors author="Carol Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="Shared Title Alpha" journal="Journal C">
    <authors author="Dave Scientist"/>
    <authors author="Alice Author"/>
  </entries>

  <!-- A4, A5: distinct titles, same journal -> journal set gets only A4
       A4 Article_Title_Journal, A5 Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="Journal Shared One" journal="Journal D">
    <authors author="Eve Engineer"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="Journal Shared Two" journal="Journal D">
    <authors author="Frank Developer"/>
  </entries>

  <!-- A6, A7: same title and same journal -> one in each set
       A6 Article_Title_Journal, A7 Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A6" year="2006" title="Fully Shared Article" journal="Journal E">
    <authors author="Grace Analyst"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A7" year="2007" title="Fully Shared Article" journal="Journal E">
    <authors author="Heidi Designer"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- Unpublished entries (titled, no date) -->
  <!-- U1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Unique Unpublished" note="unpub-note-1">
    <authors author="Ivan Architect"/>
    <authors author="Judy Coder"/>
  </entries>

  <!-- U2, U3: same title -> one gets title paragraph, other only reference -->
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Repeated Unpublished" note="unpub-note-2">
    <authors author="Karl Tester"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="U3" title="Repeated Unpublished" note="unpub-note-3">
    <authors author="Laura Manager"/>
    <authors author="Alice Author"/>
  </entries>

  <!-- TechReport entries (titled, dated) -->
  <!-- T1: unique title -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="T1" year="2010" title="Unique TechReport">
    <authors author="Mallory Reviewer"/>
  </entries>

  <!-- T2, T3: same title -> NoTitle/Title split -->
  <entries xsi:type="BibTeX:TechReport" id="T2" year="2011" title="Repeated TechReport">
    <authors author="Niaj Analyst"/>
    <authors author="Oscar Designer"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="T3" year="2012" title="Repeated TechReport">
    <authors author="Peggy Engineer"/>
  </entries>

  <!-- Manual entries (titled, no authors/date) -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="First Manual Title"/>
  <entries xsi:type="BibTeX:Manual" id="M2" title="Second Manual Title"/>

  <!-- Book entries (titled, authored, dated, publisher) -->
  <!-- B1: unique title -->
  <entries xsi:type="BibTeX:Book" id="B1" year="1999" title="Unique Book Title" publisher="Publisher One">
    <authors author="Quentin Author"/>
  </entries>

  <!-- B2, B3: same title -->
  <entries xsi:type="BibTeX:Book" id="B2" year="2000" title="Shared Book Title" publisher="Publisher Two">
    <authors author="Rachel Writer"/>
    <authors author="Steve Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="B3" year="2001" title="Shared Book Title" publisher="Publisher Three">
    <authors author="Trent Scientist"/>
  </entries>

  <!-- InBook entries (subclass of Book, chapter set) -->
  <!-- IB1: unique title -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2002" title="InBook Unique Title" publisher="Publisher Four" chapter="1">
    <authors author="Uma Developer"/>
  </entries>

  <!-- IB2, IB3: same title -->
  <entries xsi:type="BibTeX:InBook" id="IB2" year="2003" title="InBook Shared Title" publisher="Publisher Five" chapter="2">
    <authors author="Victor Manager"/>
    <authors author="Wendy Tester"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="IB3" year="2004" title="InBook Shared Title" publisher="Publisher Six" chapter="3">
    <authors author="Xavier Analyst"/>
  </entries>

  <!-- Proceedings entries (titled, dated) -->
  <!-- P1: unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2015" title="Unique Proceedings Title"/>
  <!-- P2, P3: same title -->
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2016" title="Repeated Proceedings"/>
  <entries xsi:type="BibTeX:Proceedings" id="P3" year="2017" title="Repeated Proceedings"/>

  <!-- InProceedings entries (titled, authored, dated, booktitle, proceedings subclass) -->
  <!-- IP1: unique title -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2018" title="Unique InProceedings" booktitle="Conf A">
    <authors author="Yvonne Architect"/>
  </entries>

  <!-- IP2, IP3: same title -->
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2019" title="Repeated InProceedings" booktitle="Conf B">
    <authors author="Zack Coder"/>
    <authors author="Alice Author"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP3" year="2020" title="Repeated InProceedings" booktitle="Conf C">
    <authors author="Bob Writer"/>
  </entries>

  <!-- InCollection entries (Book + BookTitledEntry) -->
  <!-- IC1: unique title -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2011" title="Unique InCollection" publisher="Publisher Seven" booktitle="Collection A">
    <authors author="Carol Researcher"/>
  </entries>

  <!-- IC2, IC3: same title -->
  <entries xsi:type="BibTeX:InCollection" id="IC2" year="2012" title="Repeated InCollection" publisher="Publisher Eight" booktitle="Collection B">
    <authors author="Dave Scientist"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="IC3" year="2013" title="Repeated InCollection" publisher="Publisher Nine" booktitle="Collection C">
    <authors author="Eve Engineer"/>
    <authors author="Frank Developer"/>
  </entries>

  <!-- Thesis entries (PhDThesis and MasterThesis) -->
  <!-- PH1: PhDThesis unique title -->
  <entries xsi:type="BibTeX:PhDThesis" id="PH1" year="2008" title="Unique PhD Thesis" school="Tech University">
    <authors author="Grace Analyst"/>
  </entries>
  <!-- PH2, PH3: PhDThesis same title -->
  <entries xsi:type="BibTeX:PhDThesis" id="PH2" year="2009" title="Repeated PhD Thesis" school="Science Institute">
    <authors author="Heidi Designer"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="PH3" year="2010" title="Repeated PhD Thesis" school="Science Institute">
    <authors author="Ivan Architect"/>
  </entries>

  <!-- MT1: MasterThesis unique title -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2011" title="Unique Master Thesis" school="Engineering School">
    <authors author="Judy Coder"/>
  </entries>
  <!-- MT2, MT3: MasterThesis same title -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT2" year="2012" title="Repeated Master Thesis" school="Engineering School">
    <authors author="Karl Tester"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="MT3" year="2013" title="Repeated Master Thesis" school="Engineering School">
    <authors author="Laura Manager"/>
  </entries>

  <!-- Untitled entries: Booklet and Misc -> UntitledEntry rule -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="1990"/>
  <entries xsi:type="BibTeX:Booklet" id="BL2" year="1991"/>
  <entries xsi:type="BibTeX:Misc" id="MS1"/>
  <entries xsi:type="BibTeX:Misc" id="MS2"/>

</BibTeX:BibTeXFile>