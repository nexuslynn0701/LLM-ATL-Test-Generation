<?xml version="1.0" encoding="ASCII"?>
<BibTeX:BibTeXFile xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BibTeX="http://BibTeX/1.0">
  <!-- Articles designed to trigger different Article_* rules -->
  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" year="2001" title="T1 Unique Article" journal="J1 Unique Journal">
    <authors author="Author A"/>
    <authors author="Author B"/>
  </entries>
  <!-- A2: duplicate title with A1, own journal -> Article_NoTitle_Journal (no title para for A2) -->
  <entries xsi:type="BibTeX:Article" id="A2" year="2002" title="T1 Unique Article" journal="J2 Second Journal">
    <authors author="Author C"/>
  </entries>
  <!-- A3: own title, journal duplicated with A4 & A5 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A3" year="2003" title="T2 Shared Journal Article One" journal="J3 Shared Journal">
    <authors author="Author D"/>
    <authors author="Author A"/>
  </entries>
  <!-- A4: title duplicated with A5, journal duplicated with A3 & A5 -> Article_NoTitle_NoJournal (no title/journal paras) -->
  <entries xsi:type="BibTeX:Article" id="A4" year="2004" title="T3 Reused Title" journal="J3 Shared Journal">
    <authors author="Author E"/>
  </entries>
  <!-- A5: same title and journal as A4 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="A5" year="2005" title="T3 Reused Title" journal="J3 Shared Journal">
    <authors author="Author F"/>
    <authors author="Author B"/>
  </entries>

  <!-- Manual: TitledEntry, no authors/year -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="T4 Manual Title"/>

  <!-- Two TechReports with same title T5 Tech Report Title:
       TR1 gets title paragraph, TR2 only entry paragraph -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" year="2010" title="T5 Tech Report Title">
    <authors author="Author C"/>
    <authors author="Author G"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR2" year="2011" title="T5 Tech Report Title">
    <authors author="Author H"/>
  </entries>

  <!-- Proceedings: P1 has unique title T6 -> title para; P2/P3 share T7 -> only P2 title para -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" year="2012" title="T6 Single Proceedings"/>
  <entries xsi:type="BibTeX:Proceedings" id="P2" year="2013" title="T7 Reused Proceedings Title"/>
  <entries xsi:type="BibTeX:Proceedings" id="P3" year="2014" title="T7 Reused Proceedings Title"/>

  <!-- Book: B1 has unique title T8 -> title para -->
  <entries xsi:type="BibTeX:Book" id="B1" year="2015" title="T8 Main Book Title" publisher="Pub1 Publisher">
    <authors author="Author D"/>
  </entries>

  <!-- InBook: IB1 with unique title T9 and chapter -> title para -->
  <entries xsi:type="BibTeX:InBook" id="IB1" year="2016" title="T9 InBook Title" publisher="Pub2 Publisher" chapter="7">
    <authors author="Author A"/>
    <authors author="Author H"/>
  </entries>

  <!-- InCollection: IC1 with unique title T10 -> title para -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" year="2017" title="T10 Collection Chapter" publisher="Pub1 Publisher" booktitle="BT1 Booktitle One">
    <authors author="Author G"/>
  </entries>

  <!-- InProceedings: two entries sharing title T11, different years/booktitles
       IP1 chosen for distinct-title set -> title para; IP2 only entry para -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" year="2018" title="T11 Conference Paper Title" booktitle="BT2 Conf Book A">
    <authors author="Author F"/>
    <authors author="Author E"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="IP2" year="2019" title="T11 Conference Paper Title" booktitle="BT3 Conf Book B">
    <authors author="Author B"/>
  </entries>

  <!-- PhDThesis: PT1, unique title T12 -> title para -->
  <entries xsi:type="BibTeX:PhDThesis" id="PT1" year="2020" title="T12 Doctoral Thesis" school="School1 University">
    <authors author="Author G"/>
    <authors author="Author A"/>
  </entries>

  <!-- MasterThesis: MT1, unique title T13 -> title para -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" year="2021" title="T13 Master Thesis" school="School2 Institute">
    <authors author="Author H"/>
  </entries>

  <!-- Unpublished: U1 has unique title T14 and note -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="T14 Unpublished Work" note="Note for unpublished">
    <authors author="Author D"/>
    <authors author="Author C"/>
  </entries>

  <!-- Untitled entries: Booklet and Misc trigger UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="1999"/>
  <entries xsi:type="BibTeX:Misc" id="MS1"/>
</BibTeX:BibTeXFile>