<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Booklet (untitled entry) - triggers R3 (UntitledEntry) -->
    <entries xsi:type="BibTeX:Booklet" id="BL001" year="2020"/>
    
    <!-- Misc (untitled entry) - triggers R3 (UntitledEntry) -->
    <entries xsi:type="BibTeX:Misc" id="MC001"/>
    
    <!-- Manual (titled entry, no authors, no date) - triggers R4 (TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:Manual" id="MN001" title="Software Documentation Guide"/>
    
    <!-- Proceedings (titled, dated, no authors) - triggers R4 (TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:Proceedings" id="PR001" title="International Conference on Software Engineering" year="2023"/>
    
    <!-- Article with unique title and unique journal - triggers R6 (Article_Title_Journal) -->
    <entries xsi:type="BibTeX:Article" id="AR001" title="Model-Driven Engineering Approaches" year="2021" journal="Software Engineering Journal">
        <authors author="Jane Smith"/>
        <authors author="John Doe"/>
    </entries>
    
    <!-- Article with unique title, but same journal as previous (NoJournal case) - triggers R8 (Article_Title_NoJournal) -->
    <entries xsi:type="BibTeX:Article" id="AR002" title="Code Generation Techniques" year="2022" journal="Software Engineering Journal">
        <authors author="Jane Smith"/>
    </entries>
    
    <!-- Article with same title as previous article (AR001) but unique journal - triggers R7 (Article_NoTitle_Journal) -->
    <entries xsi:type="BibTeX:Article" id="AR003" title="Model-Driven Engineering Approaches" year="2023" journal="Journal of Software Technology">
        <authors author="Bob Wilson"/>
    </entries>
    
    <!-- Article with same title as AR002 and same journal as AR001-AR002 - triggers R9 (Article_NoTitle_NoJournal) -->
    <entries xsi:type="BibTeX:Article" id="AR004" title="Code Generation Techniques" year="2022" journal="Software Engineering Journal">
        <authors author="Alice Brown"/>
    </entries>
    
    <!-- TechReport (titled, authored, dated) - triggers R4 (TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:TechReport" id="TR001" title="Advances in Automated Testing" year="2022">
        <authors author="Charlie Davis"/>
    </entries>
    
    <!-- Unpublished (titled, authored) - triggers R4 (TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:Unpublished" id="UP001" title="Emerging Trends in MDE" note="Draft paper under review">
        <authors author="Diana Evans"/>
    </entries>
    
    <!-- Book (titled, authored, dated) - triggers R4 (TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:Book" id="BK001" title="Foundations of Software Engineering" year="2020" publisher="Springer">
        <authors author="John Doe"/>
    </entries>
    
    <!-- InBook (extends Book) - triggers R4 (TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:InBook" id="IB001" title="Chapter on Model Transformations" year="2021" publisher="Springer" chapter="3">
        <authors author="John Doe"/>
    </entries>
    
    <!-- InCollection (extends Book + BookTitledEntry) - triggers R4 (TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:InCollection" id="IC001" title="Collection on MDE Methods" year="2022" publisher="MIT Press" booktitle="Advanced MDE Topics">
        <authors author="Eve Foster"/>
    </entries>
    
    <!-- InProceedings (extends Proceedings + AuthoredEntry + BookTitledEntry) - triggers R4 (TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:InProceedings" id="IP001" title="New Perspectives on MDE" year="2023" booktitle="ICSE 2023 Proceedings">
        <authors author="Grace Hill"/>
    </entries>
    
    <!-- PhDThesis (extends ThesisEntry) - triggers R4 (TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:PhDThesis" id="PT001" title="Automated Model Transformation Testing" year="2022" school="University of Technology">
        <authors author="Henry Lee"/>
    </entries>
    
    <!-- MasterThesis (extends ThesisEntry) - triggers R4 (TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:MasterThesis" id="MT001" title="Model-Based Development of IoT Systems" year="2023" school="Tech Institute">
        <authors author="Ivy Wang"/>
    </entries>
    
    <!-- Duplicate title to trigger R5 (TitledEntry_NoTitle_NoArticle) -->
    <entries xsi:type="BibTeX:Manual" id="MN002" title="Software Documentation Guide"/>
    
    <!-- Book with same title as BK001 to trigger R5 (TitledEntry_NoTitle_NoArticle) -->
    <entries xsi:type="BibTeX:Book" id="BK002" title="Foundations of Software Engineering" year="2021" publisher="Wiley">
        <authors author="Frank Green"/>
    </entries>
    
</BibTeX:BibTeXFile>