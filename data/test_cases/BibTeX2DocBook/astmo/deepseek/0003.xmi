<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Article with unique title and unique journal (R6: Article_Title_Journal) -->
    <entries xsi:type="BibTeX:Article" id="Art1" title="Model Transformation" year="2023" journal="IEEE Software">
        <authors author="Daniel Varro"/>
        <authors author="Javier Troya"/>
    </entries>
    
    <!-- Article with same title as Art1 but different journal (R7: Article_NoTitle_Journal) -->
    <entries xsi:type="BibTeX:Article" id="Art2" title="Model Transformation" year="2024" journal="JSS">
        <authors author="Daniel Varro"/>
    </entries>
    
    <!-- Article with unique title but same journal as Art1 (R8: Article_Title_NoJournal) -->
    <entries xsi:type="BibTeX:Article" id="Art3" title="Graph Transformation" year="2022" journal="IEEE Software">
        <authors author="Gabriele Taentzer"/>
    </entries>
    
    <!-- Article with same title as Art3 and same journal as Art1 (R9: Article_NoTitle_NoJournal) -->
    <entries xsi:type="BibTeX:Article" id="Art4" title="Graph Transformation" year="2021" journal="IEEE Software">
        <authors author="Gabriele Taentzer"/>
    </entries>
    
    <!-- Booklet (untitled entry, triggers R3: UntitledEntry) -->
    <entries xsi:type="BibTeX:Booklet" id="Bklt1" year="2020"/>
    
    <!-- Misc (untitled entry, triggers R3: UntitledEntry) -->
    <entries xsi:type="BibTeX:Misc" id="Msc1"/>
    
    <!-- Book with unique title (triggers R4: TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:Book" id="Bk1" title="Software Engineering" year="2019" publisher="Addison-Wesley">
        <authors author="Ian Sommerville"/>
    </entries>
    
    <!-- Book with same title as Bk1 (triggers R5: TitledEntry_NoTitle_NoArticle) -->
    <entries xsi:type="BibTeX:Book" id="Bk2" title="Software Engineering" year="2018" publisher="Pearson">
        <authors author="Ian Sommerville"/>
    </entries>
    
    <!-- InBook with unique title (triggers R4: TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:InBook" id="InBk1" title="Design Patterns" year="2000" publisher="Addison-Wesley" chapter="2">
        <authors author="Erich Gamma"/>
        <authors author="Richard Helm"/>
    </entries>
    
    <!-- InCollection with unique title (triggers R4: TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:InCollection" id="Inc1" title="Database Systems" year="2015" publisher="Morgan Kaufmann" booktitle="AdvDB">
        <authors author="Michael Stonebraker"/>
    </entries>
    
    <!-- TechReport with unique title (triggers R4: TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:TechReport" id="TR1" title="Technical Report" year="2021">
        <authors author="John Doe"/>
    </entries>
    
    <!-- Manual (triggers R4: TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:Manual" id="Man1" title="User Manual"/>
    
    <!-- Proceedings (triggers R4: TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:Proceedings" id="Proc1" title="Conference Proceedings" year="2023"/>
    
    <!-- InProceedings with unique title (triggers R4: TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:InProceedings" id="Inp1" title="Model Checking" year="2022" booktitle="CAV">
        <authors author="Edmund Clarke"/>
    </entries>
    
    <!-- Unpublished (triggers R4: TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:Unpublished" id="Unp1" title="Draft Paper" note="Unfinished work">
        <authors author="Jane Smith"/>
    </entries>
    
    <!-- PhDThesis (triggers R4: TitledEntry_Title_NoArticle) -->
    <entries xsi:type="BibTeX:PhDThesis" id="PhD1" title="PhD Research" year="2020" school="MIT">
        <authors author="Alan Turing"/>
    </entries>
    
    <!-- MasterThesis with same title as PhD1 (triggers R5: TitledEntry_NoTitle_NoArticle) -->
    <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="PhD Research" year="2021" school="Stanford">
        <authors author="Charles Babbage"/>
    </entries>
    
    <!-- Additional Author to ensure multiple authors exercise R2: Author -->
    <entries xsi:type="BibTeX:Article" id="Art5" title="Reliable Systems" year="2020" journal="ACM Surveys">
        <authors author="Daniel Varro"/>
        <authors author="Gabriele Taentzer"/>
    </entries>
    
</BibTeX:BibTeXFile>