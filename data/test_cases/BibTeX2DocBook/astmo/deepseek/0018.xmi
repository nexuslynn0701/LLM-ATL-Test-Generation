<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">
    
    <!-- Misc - triggers UntitledEntry rule (R3) -->
    <entries xsi:type="BibTeX:Misc" id="misc001"/>
    
    <!-- Booklet - triggers UntitledEntry rule (R3) -->
    <entries xsi:type="BibTeX:Booklet" id="booklet001" year="2020"/>
    
    <!-- Manual - triggers TitledEntry_Title_NoArticle (R4) with unique title -->
    <entries xsi:type="BibTeX:Manual" id="man001" title="Software Manual"/>
    
    <!-- Proceedings - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Proceedings" id="proc001" title="Conference Proceedings" year="2021"/>
    
    <!-- TechReport - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:TechReport" id="tr001" title="Technical Report Alpha" year="2022">
        <authors author="Alice Smith"/>
        <authors author="Bob Jones"/>
    </entries>
    
    <!-- Unpublished - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub001" title="Draft Paper" note="Unpublished work in progress">
        <authors author="Charlie Brown"/>
    </entries>
    
    <!-- MasterThesis - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:MasterThesis" id="mt001" title="Master Thesis Research" year="2023" school="University A">
        <authors author="Diana Prince"/>
    </entries>
    
    <!-- PhDThesis - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:PhDThesis" id="phd001" title="PhD Dissertation" year="2024" school="University B">
        <authors author="Eve Adams"/>
    </entries>
    
    <!-- Book - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:Book" id="book001" title="Software Engineering" year="2019" publisher="Academic Press">
        <authors author="Frank Miller"/>
    </entries>
    
    <!-- InBook - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:InBook" id="ib001" title="Chapter on Testing" year="2020" publisher="Tech Publisher" chapter="5">
        <authors author="Grace Hopper"/>
    </entries>
    
    <!-- InCollection - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:InCollection" id="ic001" title="Collection Article" year="2021" booktitle="Advances in Computing" publisher="Springer">
        <authors author="Henry Lee"/>
    </entries>
    
    <!-- InProceedings - triggers TitledEntry_Title_NoArticle (R4) -->
    <entries xsi:type="BibTeX:InProceedings" id="ip001" title="Conference Paper" year="2022" booktitle="International Conference">
        <authors author="Iris Wang"/>
    </entries>
    
    <!-- Article - first article with unique title and unique journal triggers Article_Title_Journal (R6) -->
    <entries xsi:type="BibTeX:Article" id="art001" title="Innovative Methods" year="2023" journal="Journal of Computing">
        <authors author="Jack Black"/>
    </entries>
    
    <!-- Article - second article with same title as art001 but different journal triggers Article_NoTitle_Journal (R7) -->
    <entries xsi:type="BibTeX:Article" id="art002" title="Innovative Methods" year="2023" journal="Software Engineering Journal">
        <authors author="Karen White"/>
    </entries>
    
    <!-- Article - third article with unique title but same journal as art001 triggers Article_Title_NoJournal (R8) -->
    <entries xsi:type="BibTeX:Article" id="art003" title="Novel Approaches" year="2024" journal="Journal of Computing">
        <authors author="Leo Gray"/>
    </entries>
    
    <!-- Article - fourth article with same title as art003 and same journal as art003 triggers Article_NoTitle_NoJournal (R9) -->
    <entries xsi:type="BibTeX:Article" id="art004" title="Novel Approaches" year="2024" journal="Journal of Computing">
        <authors author="Mona Lisa"/>
    </entries>
    
    <!-- Second Manual - same title as first manual triggers TitledEntry_NoTitle_NoArticle (R5) -->
    <entries xsi:type="BibTeX:Manual" id="man002" title="Software Manual"/>
    
    <!-- Second Unpublished - same title as first unpublished triggers TitledEntry_NoTitle_NoArticle (R5) -->
    <entries xsi:type="BibTeX:Unpublished" id="unpub002" title="Draft Paper" note="Another version">
        <authors author="Nina Simone"/>
    </entries>
    
</BibTeX:BibTeXFile>