<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Booklet (UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="bklt1" year="2010"/>

  <!-- Misc (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Manual (TitledEntry, no authors/year) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="User Guide for Tool X"/>

  <!-- Manual with same title (triggers TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="User Guide for Tool X"/>

  <!-- Unpublished (TitledEntry + AuthoredEntry, no year) -->
  <entries xsi:type="BibTeX:Unpublished" id="unp1" title="Early Results on MDE" note="Draft version">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- TechReport (TitledEntry + AuthoredEntry + DatedEntry) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Model Transformation Testing" year="2015">
    <authors author="Alice Smith"/>
  </entries>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Topics in MDE" year="2012" school="University A">
    <authors author="Carol White"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) with same title as PhDThesis (forces NoTitle for one of them) -->
  <entries xsi:type="BibTeX:MasterThesis" id="msc1" title="Advanced Topics in MDE" year="2013" school="University B">
    <authors author="David Black"/>
  </entries>

  <!-- Book (base Book, unique title) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Foundations of Model-Driven Engineering" year="2008" publisher="TechPress">
    <authors author="Alice Smith"/>
    <authors author="Eve Gray"/>
  </entries>

  <!-- InBook (child of Book, unique title) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Testing Transformations Chapter" year="2009" publisher="TechPress" chapter="5">
    <authors author="Bob Jones"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry, unique title, unique booktitle) -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="MDE in Practice" year="2011" publisher="Springer" booktitle="Proceedings of MDE Symposium">
    <authors author="Carol White"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Proceedings (base Proceedings, unique title) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="International Conference on MDE" year="2014"/>

  <!-- InProceedings 1 (unique title, journal-like booktitle) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Testing ATL Transformations" year="2016" booktitle="ICMT 2016">
    <authors author="Bob Jones"/>
    <authors author="David Black"/>
  </entries>

  <!-- InProceedings 2 with same title (triggers TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" title="Testing ATL Transformations" year="2017" booktitle="ICMT 2017">
    <authors author="Eve Gray"/>
  </entries>

  <!-- Article A1: unique title, unique journal -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Model Testing Techniques" year="2018" journal="Journal of Software Testing">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article A2: same title as A1, unique journal (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Model Testing Techniques" year="2019" journal="International Journal of MDE">
    <authors author="Carol White"/>
  </entries>

  <!-- Article A3: unique title, same journal as A3/A4 set will share journal -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Traceability in Transformations" year="2020" journal="Journal of MDE Research">
    <authors author="David Black"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article A4: same journal as A3, different title (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Scalability of Model Transformations" year="2021" journal="Journal of MDE Research">
    <authors author="Eve Gray"/>
  </entries>

  <!-- Article A5: same title and same journal as A4 (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art5" title="Scalability of Model Transformations" year="2022" journal="Journal of MDE Research">
    <authors author="Bob Jones"/>
    <authors author="Carol White"/>
  </entries>

</BibTeX:BibTeXFile>