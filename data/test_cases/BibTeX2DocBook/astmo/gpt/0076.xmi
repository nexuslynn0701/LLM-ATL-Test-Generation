<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc (untitled, non-authored, undated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>

  <!-- Booklet (dated, not titled) -> UntitledEntry, OCL5 -->
  <entries xsi:type="BibTeX:Booklet" id="bkt1" year="2005"/>

  <!-- Manual (titled, no authors, no year) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Model Engineering Manual"/>

  <!-- TechReport (titled, authored, dated) with two authors,
       unique title -> TitledEntry_Title_NoArticle, Authors/Title sets -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Verification Techniques" year="2012">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Unpublished (titled, authored, note) -> TitledEntry_Title_NoArticle, OCL6 -->
  <entries xsi:type="BibTeX:Unpublished" id="u1" title="Draft Transformation Paper" note="To appear">
    <authors author="Carol White"/>
  </entries>

  <!-- MasterThesis (titled, authored, dated, school) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Testing Model Transformations" year="2015" school="Tech University">
    <authors author="Dave Brown"/>
  </entries>

  <!-- PhDThesis (titled, authored, dated, school) -> TitledEntry_Title_NoArticle, OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Scalable Model Transformations" year="2018" school="Science Institute">
    <authors author="Eve Black"/>
  </entries>

  <!-- Book (titled, authored, dated, publisher) with two authors,
       title unique among non-articles -> TitledEntry_Title_NoArticle, OCL9 -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="Advanced MDE" year="2010" publisher="Springer">
    <authors author="Frank Green"/>
    <authors author="Helen Gray"/>
  </entries>

  <!-- InBook (child of Book; titled, authored, dated, publisher, chapter)
       unique title -> TitledEntry_Title_NoArticle, OCL10 -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Transformation Chapter" year="2011" publisher="IEEE Press" chapter="3">
    <authors author="Ian Orange"/>
  </entries>

  <!-- Proceedings (titled, dated) -> TitledEntry_Title_NoArticle, OCL13 -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="MDE Conference" year="2013"/>

  <!-- InProceedings (titled, authored, dated, booktitle) -> TitledEntry_Title_NoArticle, OCL14 -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Model Transformation Case Study" year="2014" booktitle="MDE Conference 2014">
    <authors author="John Red"/>
  </entries>

  <!-- InCollection (titled, authored, dated, booktitle, publisher) -> TitledEntry_Title_NoArticle, OCL15 -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Chapter on Testing" year="2016" booktitle="Handbook of MDE" publisher="ACM Press">
    <authors author="Karen Blue"/>
  </entries>

  <!-- Article with unique title and journal -> Article_Title_Journal, OCL16,19 -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Model Transformations in Practice" year="2017" journal="Journal of MDE">
    <authors author="Laura Violet"/>
  </entries>

  <!-- Article sharing title with a1 but with a different journal:
       title duplicate, journal unique -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Model Transformations in Practice" year="2018" journal="Software Engineering Notes">
    <authors author="Mike Yellow"/>
  </entries>

  <!-- Article sharing journal with a2 but with a new title:
       journal duplicate, title unique -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a3" title="Empirical Study of ATL" year="2019" journal="Software Engineering Notes">
    <authors author="Nina Cyan"/>
  </entries>

</BibTeX:BibTeXFile>