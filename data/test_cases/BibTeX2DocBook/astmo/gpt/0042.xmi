<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc (untitled, non‑authored, non‑dated) -> R3 UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="miscA"/>

  <!-- Booklet (untitled, dated) -> R3 UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="bookletA" year="1999"/>

  <!-- Unpublished (titled, authored, no date) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Shared Title Alpha" note="internal note A">
    <authors author="Alice One"/>
    <authors author="Bob Two"/>
  </entries>

  <!-- Manual (titled only) -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="Manual Title X"/>

  <!-- TechReport (titled, authored, dated) -->
  <entries xsi:type="BibTeX:TechReport" id="tech1" title="Tech Report Title" year="2010">
    <authors author="Charlie Three"/>
  </entries>

  <!-- Proceedings (titled, dated) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proceedings Title" year="2011"/>

  <!-- InProceedings (titled, authored, dated, booktitle) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="InProc Title" year="2012" booktitle="Booktitle A">
    <authors author="Alice One"/>
  </entries>

  <!-- Book (titled, authored, dated, publisher) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Book Title One" year="2005" publisher="Publisher A">
    <authors author="Bob Two"/>
    <authors author="Diana Four"/>
  </entries>

  <!-- PhDThesis (titled, authored, dated, school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="PhD Title A" year="2008" school="University A">
    <authors author="Eve Five"/>
  </entries>

  <!-- InBook (titled, authored, dated, publisher, chapter) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="InBook Title" year="2006" publisher="Publisher B" chapter="3">
    <authors author="Charlie Three"/>
  </entries>

  <!-- InCollection (titled, authored, dated, booktitle, publisher) -->
  <entries xsi:type="BibTeX:InCollection" id="incol1" title="Collection Chapter" year="2007" booktitle="Collected Works" publisher="Publisher C">
    <authors author="Diana Four"/>
    <authors author="Alice One"/>
  </entries>

  <!-- Article 1: unique title, unique journal -> R6 Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Unique Article" year="2015" journal="Journal Alpha">
    <authors author="Alice One"/>
    <authors author="Frank Six"/>
  </entries>

  <!-- Article 2: same title as art3, unique journal -> R7 Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Duplicated Article Title" year="2016" journal="Journal Beta">
    <authors author="Bob Two"/>
  </entries>

  <!-- Article 3: same title as art2, unique journal -> R6 Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Duplicated Article Title" year="2017" journal="Journal Gamma">
    <authors author="Charlie Three"/>
  </entries>

  <!-- Article 4: unique title, journal shared with art5 -> R8 Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Shared Journal Article One" year="2018" journal="Journal Delta">
    <authors author="Diana Four"/>
  </entries>

  <!-- Article 5: different title, same journal as art4 -> R9 Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art5" title="Shared Journal Article Two" year="2019" journal="Journal Delta">
    <authors author="Eve Five"/>
    <authors author="Frank Six"/>
  </entries>

</BibTeX:BibTeXFile>