<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry (will trigger R3: Misc through UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="e01"/>

  <!-- Booklet (untitled entry but DatedEntry; still R3) -->
  <entries xsi:type="BibTeX:Booklet" id="e02" year="2001"/>

  <!-- Manual (TitledEntry only, no authors/year; R4) -->
  <entries xsi:type="BibTeX:Manual" id="e03" title="M1 Manual"/>

  <!-- TechReport (Authored, Dated, Titled; R4) -->
  <entries xsi:type="BibTeX:TechReport" id="e04" title="TR1 Report" year="2002">
    <authors author="Alice Unique"/>
  </entries>

  <!-- Unpublished (Authored, Titled; R4) -->
  <entries xsi:type="BibTeX:Unpublished" id="e05" title="Working Draft" note="To appear">
    <authors author="Bob Smith"/>
    <authors author="Carol Jones"/>
  </entries>

  <!-- PhDThesis (ThesisEntry: Authored, Dated, Titled; R4) -->
  <entries xsi:type="BibTeX:PhDThesis" id="e06" title="Advanced Topics" year="2003" school="Uni A">
    <authors author="Derek Lee"/>
  </entries>

  <!-- MasterThesis (ThesisEntry: Authored, Dated, Titled; R4) -->
  <entries xsi:type="BibTeX:MasterThesis" id="e07" title="Introductory Study" year="2004" school="Uni B">
    <authors author="Eva Green"/>
  </entries>

  <!-- Book (Authored, Dated, Titled; R4) -->
  <entries xsi:type="BibTeX:Book" id="e08" title="Model Engineering" year="2005" publisher="TechPress">
    <authors author="Frank Miller"/>
    <authors author="Grace Hall"/>
  </entries>

  <!-- InBook (Book + chapter; R4) -->
  <entries xsi:type="BibTeX:InBook" id="e09" title="Chapter on Testing" year="2006" publisher="TechPress" chapter="10">
    <authors author="Helen King"/>
  </entries>

  <!-- Proceedings (Dated, Titled; R4) -->
  <entries xsi:type="BibTeX:Proceedings" id="e10" title="MDE Conference" year="2007"/>

  <!-- InProceedings (Proceedings + Authored + BookTitledEntry; R4) -->
  <entries xsi:type="BibTeX:InProceedings" id="e11" title="Paper A" year="2008" booktitle="MDE Conference 2008">
    <authors author="Ian Brown"/>
    <authors author="Jack White"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry; R4) -->
  <entries xsi:type="BibTeX:InCollection" id="e12" title="Collected Work" year="2009" publisher="CollectivePub" booktitle="Collected Volume 1">
    <authors author="Kelly Black"/>
  </entries>

  <!-- Article 1: unique title and unique journal; will use R6 (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="e13" title="Unique Article" year="2010" journal="Journal X">
    <authors author="Liam One"/>
  </entries>

  <!-- Article 2 & 3: same journal "Shared Journal", different titles; one goes to articleSet, one not.
       e14 will satisfy both unique-title and unique-journal sets -> R6.
       e15 will have non-unique journal -> R8 (Article_Title_NoJournal). -->

  <!-- Article 2: goes into articleSet (first with journal "Shared Journal") -> R6 -->
  <entries xsi:type="BibTeX:Article" id="e14" title="First Shared Journal Article" year="2011" journal="Shared Journal">
    <authors author="Maria Author"/>
    <authors author="Nina Author"/>
  </entries>

  <!-- Article 3: same journal "Shared Journal" (non-unique), different title; stays out of articleSet -> R8 -->
  <entries xsi:type="BibTeX:Article" id="e15" title="Second Shared Journal Article" year="2012" journal="Shared Journal">
    <authors author="Oscar Writer"/>
  </entries>

  <!-- Article 4 & 5: same title, different journals; one will be in titledEntrySet and articleSet -> R6,
       the other will not be in titledEntrySet but will be in articleSet -> R7 (Article_NoTitle_Journal). -->

  <!-- Article 4: first with title "Repeated Title", journal "Journal Y" -> R6 -->
  <entries xsi:type="BibTeX:Article" id="e16" title="Repeated Title" year="2013" journal="Journal Y">
    <authors author="Paul Author"/>
  </entries>

  <!-- Article 5: second with same title "Repeated Title", journal "Journal Z" -> R7 -->
  <entries xsi:type="BibTeX:Article" id="e17" title="Repeated Title" year="2014" journal="Journal Z">
    <authors author="Quinn Author"/>
  </entries>

</BibTeX:BibTeXFile>