<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (trigger R3: Misc, Booklet) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2018"/>

  <!-- Unpublished (titled, authored, note; triggers R4) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Unique Unpublished Work" note="draft note">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- Manual (titled only; triggers R4) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="DocBook Manual"/>

  <!-- Proceedings (titled + dated, base class only; triggers R4 and OCL13) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="MDE Conference" year="2019"/>

  <!-- InProceedings (titled, authored, dated, booktitle; triggers R4 and OCL14) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="InProceedings Title One" year="2020" booktitle="MDE Conference">
    <authors author="Alice Alpha"/>
  </entries>

  <!-- Book (titled, authored, dated, publisher; triggers R4 and OCL9) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Unique Book Title" year="2015" publisher="TechPress">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- InCollection (titled, authored, dated, booktitle, publisher; triggers R4 and OCL15) -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Collection Chapter" year="2016" publisher="TechPress" booktitle="Collected Advances in MDE">
    <authors author="Dave Delta"/>
  </entries>

  <!-- InBook (titled, authored, dated, publisher, chapter; triggers R4 and OCL10) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Embedded InBook Chapter" year="2017" publisher="TechPress" chapter="1">
    <authors author="Carol Gamma"/>
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- TechReport (titled, authored, dated; triggers R4 and OCL11) -->
  <entries xsi:type="BibTeX:TechReport" id="tech1" title="Technical Report on MDE" year="2014">
    <authors author="Frank Phi"/>
  </entries>

  <!-- MasterThesis (titled, authored, dated, school; triggers R4 via ThesisEntry) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="MDE Master Thesis" year="2013" school="University of Sevilla">
    <authors author="Grace Gamma"/>
  </entries>

  <!-- PhDThesis (titled, authored, dated, school; triggers R4 and OCL8) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced MDE PhD Thesis" year="2012" school="University of Sevilla">
    <authors author="Henry Eta"/>
    <authors author="Alice Alpha"/>
  </entries>

  <!-- Articles for different Article rules -->
  <!-- Article 1: unique title and unique journal (triggers R6) -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Unique Article Title" year="2010" journal="Journal A">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- Article 2 & 3: same title, different journals (exercise Article_NoTitle_* and *_Title_*) -->
  <!-- art2: first occurrence of title "Shared Article Title" and journal "Journal B" (triggers R6) -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Shared Article Title" year="2011" journal="Journal B">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- art3: same title "Shared Article Title", journal "Journal C" -->
  <!-- title already used -> not in title set; journal first for "Journal C" -> in journal set (triggers R7) -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Shared Article Title" year="2012" journal="Journal C">
    <authors author="Dave Delta"/>
  </entries>

  <!-- Article 4 & 5: different titles, same journal (exercise *_NoJournal rules) -->
  <!-- art4: first occurrence of journal "Journal D" and title "Journal D Article One" (triggers R6) -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Journal D Article One" year="2013" journal="Journal D">
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- art5: new title "Journal D Article Two", same journal "Journal D" -->
  <!-- title new -> in title set; journal already used -> not in journal set (triggers R8) -->
  <entries xsi:type="BibTeX:Article" id="art5" title="Journal D Article Two" year="2014" journal="Journal D">
    <authors author="Frank Phi"/>
  </entries>

</BibTeX:BibTeXFile>