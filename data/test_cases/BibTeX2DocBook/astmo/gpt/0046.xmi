<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc (untitled, non-authored, non-dated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="E01"/>

  <!-- Booklet (dated, untitled) -> UntitledEntry, OCL5 -->
  <entries xsi:type="BibTeX:Booklet" id="E02" year="1999"/>

  <!-- Manual (titled, non-authored, non-dated) -> TitledEntry_Title_NoArticle, OCL12 -->
  <entries xsi:type="BibTeX:Manual" id="E03" title="DocBook Guidelines"/>

  <!-- TechReport (titled, authored, dated) -> TitledEntry_Title_NoArticle, OCL11 -->
  <entries xsi:type="BibTeX:TechReport" id="E04" title="ATL Verification" year="2010">
    <authors author="Bob Brown"/>
  </entries>

  <!-- Unpublished (titled, authored, note) -> TitledEntry_Title_NoArticle, OCL6 -->
  <entries xsi:type="BibTeX:Unpublished" id="E05" title="Future Work on MDE" note="To appear soon">
    <authors author="Carol Clark"/>
    <authors author="David Doe"/>
  </entries>

  <!-- MasterThesis (titled, authored, dated, school) -> TitledEntry_Title_NoArticle, OCL7 (commented in OCL but transformation still supports pattern) -->
  <entries xsi:type="BibTeX:MasterThesis" id="E06" title="Model Transformations in Practice" year="2015" school="Tech University">
    <authors author="Eve Evans"/>
  </entries>

  <!-- PhDThesis (titled, authored, dated, school) -> TitledEntry_Title_NoArticle, OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis" id="E07" title="Scalable MDE" year="2018" school="Science University">
    <authors author="Frank Foster"/>
  </entries>

  <!-- Book (titled, authored, dated, publisher) -> TitledEntry_Title_NoArticle, OCL9 -->
  <entries xsi:type="BibTeX:Book" id="E08" title="Advanced ATL" year="2012" publisher="MDE Press">
    <authors author="Grace Green"/>
    <authors author="Henry Hall"/>
  </entries>

  <!-- InBook (Book + chapter) -> TitledEntry_Title_NoArticle, OCL10 -->
  <entries xsi:type="BibTeX:InBook" id="E09" title="Chapter on Testing" year="2013" publisher="MDE Press" chapter="3">
    <authors author="Ian Indigo"/>
  </entries>

  <!-- InCollection (Book + booktitle) -> TitledEntry_Title_NoArticle, OCL15 -->
  <entries xsi:type="BibTeX:InCollection" id="E10" title="Reusable Transformations" year="2014" publisher="Springer" booktitle="Proceedings of MDE 2014">
    <authors author="Jane Johnson"/>
    <authors author="Kevin King"/>
  </entries>

  <!-- Proceedings (titled, dated) -> TitledEntry_Title_NoArticle, OCL13 -->
  <entries xsi:type="BibTeX:Proceedings" id="E11" title="MDE Conference 2016" year="2016"/>

  <!-- InProceedings (titled, authored, dated, booktitle) -> TitledEntry_Title_NoArticle, OCL14 -->
  <entries xsi:type="BibTeX:InProceedings" id="E12" title="Traceability in ATL" year="2016" booktitle="MDE Conference 2016">
    <authors author="Laura Lane"/>
    <authors author="Mike Miller"/>
  </entries>

  <!-- Article A1: unique title & journal -> Article_Title_Journal, OCL16 -->
  <entries xsi:type="BibTeX:Article" id="E13" title="Testing ATL Transformations" year="2017" journal="Journal of MDE">
    <authors author="Alice Smith"/>
    <authors author="Bob Brown"/>
  </entries>

  <!-- Article A2 & A3: same title, same journal -> Article_NoTitle_NoJournal (for the non-representative one),
       and Article_Title_Journal for the representative in title and journal sets -->
  <entries xsi:type="BibTeX:Article" id="E14" title="Duplicate Title Study" year="2019" journal="Software Engineering Notes">
    <authors author="Carol Clark"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="E15" title="Duplicate Title Study" year="2020" journal="Software Engineering Notes">
    <authors author="David Doe"/>
  </entries>

  <!-- Article B1 & B2: different titles, same journal -> Article_Title_NoJournal for one of them
       and Article_Title_Journal or Article_NoTitle_Journal depending on set membership -->
  <entries xsi:type="BibTeX:Article" id="E16" title="First in Shared Journal" year="2018" journal="Shared Journal of MDE">
    <authors author="Eve Evans"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="E17" title="Second in Shared Journal" year="2019" journal="Shared Journal of MDE">
    <authors author="Frank Foster"/>
  </entries>

</BibTeX:BibTeXFile>