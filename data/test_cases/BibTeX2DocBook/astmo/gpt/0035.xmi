<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- UntitledEntry via Misc -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>

  <!-- Booklet (untitled, dated) -->
  <entries xsi:type="BibTeX:Booklet" id="bkt1" year="2001"/>

  <!-- Manual (titled only, appears twice with same title) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Doc Tool"/>
  <entries xsi:type="BibTeX:Manual" id="man2" title="Doc Tool"/>

  <!-- Unpublished (titled, authored, note) -->
  <entries xsi:type="BibTeX:Unpublished" id="up1" title="Early Draft" note="to appear">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- MasterThesis (titled, authored, dated, thesis) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Model Transformations" year="2015" school="Uni A">
    <authors author="Carol White"/>
  </entries>

  <!-- PhDThesis (titled, authored, dated, thesis) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Scalable MDE" year="2018" school="Uni B">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book (titled, authored, dated, publisher). Two books share same title -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="MDE Handbook" year="2010" publisher="TechPress">
    <authors author="Bob Johnson"/>
    <authors author="Carol White"/>
  </entries>

  <entries xsi:type="BibTeX:Book" id="bk2" title="MDE Handbook" year="2012" publisher="NextGenPress">
    <authors author="David Green"/>
  </entries>

  <!-- InBook (titled, authored, dated, publisher, chapter) -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Chapter One" year="2011" publisher="TechPress" chapter="1">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Proceedings (titled, dated) and InProceedings (titled, authored, dated, booktitle) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="MODELS Conference" year="2019"/>

  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="MDE in Practice" year="2019" booktitle="MODELS Conference">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- InCollection (titled, authored, dated, booktitle, publisher) -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Transformation Testing" year="2016" publisher="TechPress" booktitle="MDE Handbook">
    <authors author="David Green"/>
  </entries>

  <!-- TechReport (titled, authored, dated) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="MDE Survey" year="2013">
    <authors author="Carol White"/>
  </entries>

  <!-- Articles to cover different Article_* rules -->

  <!-- a1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a1" title="ATL Basics" year="2014" journal="SoftEng Journal">
    <authors author="Alice Smith"/>
  </entries>

  <!-- a2, a3: same title, different journals -->
  <!-- a2: first for title, first for its journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Advanced ATL" year="2015" journal="MDE Journal">
    <authors author="Bob Johnson"/>
  </entries>

  <!-- a3: same title as a2 (duplicate title), journal different and unique overall -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="a3" title="Advanced ATL" year="2016" journal="Software Systems">
    <authors author="Carol White"/>
  </entries>

  <!-- a4, a5: same journal, different titles -->
  <!-- a4: first for title, first for journal "Transformation Journal" -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a4" title="Testing Transformations" year="2017" journal="Transformation Journal">
    <authors author="David Green"/>
  </entries>

  <!-- a5: new title, same journal as a4 (duplicate journal) -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a5" title="Analyzing Transformations" year="2018" journal="Transformation Journal">
    <authors author="Alice Smith"/>
  </entries>

</BibTeX:BibTeXFile>