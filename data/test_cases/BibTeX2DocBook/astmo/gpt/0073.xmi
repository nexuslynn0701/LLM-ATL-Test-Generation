<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger R3 (UntitledEntry): Booklet -->
  <entries xsi:type="BibTeX:Booklet"
           id="bkt1"
           year="2010"/>

  <!-- Misc also triggers R3 (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc1"/>

  <!-- Unpublished to trigger R4 (TitledEntry_Title_NoArticle) with unique title -->
  <entries xsi:type="BibTeX:Unpublished"
           id="up1"
           title="On Unreleased Work"
           note="draft note">
    <authors author="Alice Unique"/>
    <authors author="Bob Shared"/>
  </entries>

  <!-- MasterThesis to trigger R4 -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mt1"
           title="Mastering MDE"
           year="2011"
           school="Tech University">
    <authors author="Carol Thesis"/>
  </entries>

  <!-- PhDThesis to trigger R4, shares author Bob Shared -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd1"
           title="Advanced Transformations"
           year="2012"
           school="Research Institute">
    <authors author="Bob Shared"/>
  </entries>

  <!-- Book (base Book) to trigger R4 and OCL9 -->
  <entries xsi:type="BibTeX:Book"
           id="book1"
           title="Foundations of Modeling"
           year="2013"
           publisher="Modeling Press">
    <authors author="Dana Book"/>
    <authors author="Bob Shared"/>
  </entries>

  <!-- InBook to trigger R4 and OCL10 -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook1"
           title="Chapter on Testing"
           year="2014"
           publisher="Modeling Press"
           chapter="5">
    <authors author="Evan Chapter"/>
  </entries>

  <!-- Proceedings (base) to trigger R4 and OCL13 -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc1"
           title="Conference on MDE"
           year="2015"/>

  <!-- InProceedings to trigger R4 and OCL14 -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc1"
           title="Testing Model Transformations"
           year="2016"
           booktitle="Conference on MDE">
    <authors author="Frank InProc"/>
    <authors author="Bob Shared"/>
  </entries>

  <!-- InCollection to trigger R4 and OCL15 -->
  <entries xsi:type="BibTeX:InCollection"
           id="incoll1"
           title="A Chapter in MDE"
           year="2017"
           publisher="Modeling Press"
           booktitle="Collected Advances in MDE">
    <authors author="Grace Collection"/>
  </entries>

  <!-- Manual to trigger R4 and OCL12 -->
  <entries xsi:type="BibTeX:Manual"
           id="man1"
           title="ATL User Guide"/>

  <!-- TechReport to trigger R4 and OCL11 -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr1"
           title="Report on MDE Tools"
           year="2018">
    <authors author="Henry Report"/>
  </entries>

  <!-- Articles to trigger R6, R7, R8, R9 and OCL16/19 -->
  <!-- a1: unique title and journal -> R6 -->
  <entries xsi:type="BibTeX:Article"
           id="a1"
           title="Unique Article"
           year="2019"
           journal="Journal A">
    <authors author="Ivy Article"/>
  </entries>

  <!-- a2 & a3: same title, different journals -->
  <!-- a2: first with title "Repeated Title" and journal "Journal B" -> in title set and journal set -> R6 -->
  <entries xsi:type="BibTeX:Article"
           id="a2"
           title="Repeated Title"
           year="2020"
           journal="Journal B">
    <authors author="John Article"/>
  </entries>

  <!-- a3: same title "Repeated Title", new journal "Journal C" -->
  <!-- not in title-set, in journal-set -> R7 -->
  <entries xsi:type="BibTeX:Article"
           id="a3"
           title="Repeated Title"
           year="2021"
           journal="Journal C">
    <authors author="Kate Article"/>
  </entries>

  <!-- a4 & a5: same journal, different titles -->
  <!-- a4: first using "Journal D" -> in title-set and journal-set -> R6 -->
  <entries xsi:type="BibTeX:Article"
           id="a4"
           title="Journal D First"
           year="2022"
           journal="Journal D">
    <authors author="Leo Article"/>
  </entries>

  <!-- a5: new title, same "Journal D" -->
  <!-- in title-set, not in journal-set -> R8 -->
  <entries xsi:type="BibTeX:Article"
           id="a5"
           title="Journal D Second"
           year="2023"
           journal="Journal D">
    <authors author="Mia Article"/>
  </entries>

  <!-- a6 & a7: same title and journal -->
  <!-- a6: first with title "Same Both" and journal "Journal E" -> in both sets -> R6 -->
  <entries xsi:type="BibTeX:Article"
           id="a6"
           title="Same Both"
           year="2024"
           journal="Journal E">
    <authors author="Nina Article"/>
  </entries>

  <!-- a7: same title "Same Both" and same journal "Journal E" -->
  <!-- not in title-set, not in journal-set -> R9 -->
  <entries xsi:type="BibTeX:Article"
           id="a7"
           title="Same Both"
           year="2025"
           journal="Journal E">
    <authors author="Oscar Article"/>
  </entries>

</BibTeX:BibTeXFile>