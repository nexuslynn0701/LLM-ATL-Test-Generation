<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries to trigger UntitledEntry (R3) -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Booklet" id="BKL1" year="2015"/>

  <!-- Unpublished entries (TitledEntry, no Article) with same title to trigger R4 and R5 -->
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Shared Insights" note="preprint">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="UP2" title="Shared Insights" note="extended version">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- Manual (unique title) to trigger TitledEntry_Title_NoArticle (R4) -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="Tool Guide"/>

  <!-- TechReport (unique title) to trigger TitledEntry_Title_NoArticle (R4) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Testing Transformations" year="2019">
    <authors author="Alice Alpha"/>
  </entries>

  <!-- Book (unique title) to trigger TitledEntry_Title_NoArticle (R4) -->
  <entries xsi:type="BibTeX:Book" id="BK1" title="MDE Foundations" year="2010" publisher="ModelPress">
    <authors author="Bob Beta"/>
    <authors author="Carol Gamma"/>
  </entries>

  <!-- InBook (unique title) to trigger TitledEntry_Title_NoArticle (R4) -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chapter on ATL" year="2011" publisher="ModelPress" chapter="3">
    <authors author="Dave Delta"/>
  </entries>

  <!-- Proceeding as base for InProceedings and as pure Proceedings -->
  <!-- Pure Proceedings (no children) to trigger TitledEntry_Title_NoArticle (R4) and OCL13 -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" title="MDE Conference" year="2018"/>

  <!-- InProceedings (unique title) to trigger TitledEntry_Title_NoArticle (R4) -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="ATL in Practice" year="2018" booktitle="MDE Conference">
    <authors author="Alice Alpha"/>
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- Book-based subclasses to increase coverage -->
  <!-- InCollection (unique title) to trigger TitledEntry_Title_NoArticle (R4) and OCL15 -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Model Transformations" year="2012" publisher="ModelPress" booktitle="MDE Foundations">
    <authors author="Frank Phi"/>
  </entries>

  <!-- Thesis entries to trigger TitledEntry_Title_NoArticle (R4) and OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Advanced MDE" year="2014" school="Tech University">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- Articles to exercise all article rules (R6–R9) and journal/title uniqueness handling -->
  <!-- A1 & A2 share title but different journals => one in Article_Title_Journal (R6), one in Article_NoTitle_Journal (R7) -->
  <entries xsi:type="BibTeX:Article" id="A1" title="On ATL" year="2020" journal="Journal A">
    <authors author="Alice Alpha"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A2" title="On ATL" year="2021" journal="Journal B">
    <authors author="Bob Beta"/>
  </entries>

  <!-- A3 & A4 share journal but different titles => one in Article_Title_Journal (R6), one in Article_Title_NoJournal (R8) -->
  <entries xsi:type="BibTeX:Article" id="A3" title="ATL Optimization" year="2019" journal="Journal C">
    <authors author="Carol Gamma"/>
    <authors author="Dave Delta"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A4" title="ATL Case Studies" year="2022" journal="Journal C">
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- A5 & A6 share title and journal => one in Article_Title_Journal (R6), one in Article_NoTitle_NoJournal (R9) -->
  <entries xsi:type="BibTeX:Article" id="A5" title="ATL Patterns" year="2018" journal="Journal D">
    <authors author="Frank Phi"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A6" title="ATL Patterns" year="2019" journal="Journal D">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

</BibTeX:BibTeXFile>