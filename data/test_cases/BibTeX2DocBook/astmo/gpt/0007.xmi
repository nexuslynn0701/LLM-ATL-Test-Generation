<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for rule UntitledEntry): Booklet, Misc -->
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2001"/>
  <entries xsi:type="BibTeX:Misc" id="msc1"/>

  <!-- Titled, non-article entries (for TitledEntry_*_NoArticle) -->
  <!-- Book with unique title -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="Model Engineering Basics" year="2010" publisher="TechPress">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Book with duplicate title (same as bk3) -->
  <entries xsi:type="BibTeX:Book" id="bk2" title="Shared Title Publication" year="2012" publisher="AlphaPub">
    <authors author="Carol Lee"/>
  </entries>

  <!-- Book with duplicate title (same as bk2) -->
  <entries xsi:type="BibTeX:Book" id="bk3" title="Shared Title Publication" year="2015" publisher="BetaPub">
    <authors author="David King"/>
  </entries>

  <!-- Manual with unique title -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL Reference Manual"/>

  <!-- TechReport with title that will be shared with an Article (same title as art3) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Experimental Study of Transformations" year="2017">
    <authors author="Eve Miller"/>
  </entries>

  <!-- Unpublished with unique title, note attribute -->
  <entries xsi:type="BibTeX:Unpublished" id="unp1" title="Unreleased Draft on MDE" note="Submitted for review">
    <authors author="Frank Nelson"/>
  </entries>

  <!-- PhDThesis with unique title -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Model Transformations" year="2018" school="University of Example">
    <authors author="Grace O&apos;Brien"/>
  </entries>

  <!-- MasterThesis with title duplicated with InBook (same title as inb1) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" title="Case Studies in MDE" year="2019" school="Institute of Technology">
    <authors author="Heidi Clark"/>
  </entries>

  <!-- Proceedings with unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proceedings of the MDE Conference" year="2020"/>

  <!-- InProceedings with unique title, booktitle, authored and dated -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Transformations in Practice" year="2020" booktitle="Proceedings of the MDE Conference">
    <authors author="Alice Smith"/>
    <authors author="Ivan Perez"/>
  </entries>

  <!-- InCollection with unique title, shares publisher with bk1 to reuse a string value -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Chapter on Model-Driven Testing" year="2016" booktitle="Handbook of Software Engineering" publisher="TechPress">
    <authors author="Bob Johnson"/>
  </entries>

  <!-- InBook with same title as mst1 (duplicate) and same publisher as bk2 -->
  <entries xsi:type="BibTeX:InBook" id="inb1" title="Case Studies in MDE" year="2014" publisher="AlphaPub" chapter="3">
    <authors author="Carol Lee"/>
    <authors author="John Doe"/>
  </entries>

  <!-- Article group 1: distinct title and distinct journal (for Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art1" title="MDE in Industrial Settings" year="2013" journal="Journal of MDE Practice">
    <authors author="Alice Smith"/>
    <authors author="John Doe"/>
  </entries>

  <!-- Article group 2: same title, same journal (for Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Cloning in Model Repositories" year="2011" journal="Software Modeling Journal">
    <authors author="Bob Johnson"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art3" title="Cloning in Model Repositories" year="2014" journal="Software Modeling Journal">
    <authors author="Carol Lee"/>
  </entries>

  <!-- Article group 3: same title, different journals (for Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Benchmarking ATL Transformations" year="2015" journal="Journal A">
    <authors author="David King"/>
    <authors author="John Doe"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art5" title="Benchmarking ATL Transformations" year="2016" journal="Journal B">
    <authors author="Eve Miller"/>
  </entries>

  <!-- Article group 4: distinct title, same journal (for Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art6" title="Survey of Model Transformation Tools" year="2017" journal="Transformation Surveys">
    <authors author="Frank Nelson"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art7" title="Experimental Study of Transformations" year="2018" journal="Transformation Surveys">
    <authors author="Grace O&apos;Brien"/>
  </entries>

</BibTeX:BibTeXFile>