<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for rule UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="bklt1" year="2010"/>
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Titled, non-Article entries (for TitledEntry_* rules) -->
  <!-- Two Manuals with the same title to trigger Title/NoTitle split -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Shared Manual Title"/>
  <entries xsi:type="BibTeX:Manual" id="man2" title="Shared Manual Title"/>

  <!-- Book (base type, not subclasses) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Model Engineering Handbook" year="2015" publisher="Springer">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- InBook (subclass of Book, with chapter) -->
  <entries xsi:type="BibTeX:InBook" id="inb1" title="Chapter on ATL" year="2016" publisher="ACM Press" chapter="3">
    <authors author="Alice Smith"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="MDE Patterns" year="2018" publisher="IEEE Press" booktitle="Proceedings of MDE 2018">
    <authors author="Carol White"/>
  </entries>

  <!-- Proceedings (base type, not InProceedings) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proceedings of MDE 2019" year="2019"/>

  <!-- InProceedings -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Testing Model Transformations" year="2019" booktitle="Proceedings of MDE 2019">
    <authors author="Bob Johnson"/>
    <authors author="David Brown"/>
  </entries>

  <!-- TechReport -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="ATL Transformation Testing" year="2014">
    <authors author="Eve Black"/>
  </entries>

  <!-- Unpublished -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft on Model Testing" note="To appear">
    <authors author="Carol White"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Model-Driven Testing" year="2013" school="Tech University">
    <authors author="George King"/>
  </entries>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced MDE Techniques" year="2012" school="Science University">
    <authors author="Helen Scott"/>
  </entries>

  <!-- Articles to exercise all four Article_* rules -->
  <!-- at1: unique title & unique journal => Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="at1" title="ATL for Beginners" year="2011" journal="Journal of MDE">
    <authors author="Alice Smith"/>
  </entries>

  <!-- at2 & at3: same title, different journals -->
  <!-- at2: first with title "Duplicated Article Title" & unique journal "Software Engineering Today"
           => Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="at2" title="Duplicated Article Title" year="2012" journal="Software Engineering Today">
    <authors author="Bob Johnson"/>
  </entries>

  <!-- at3: second with same title "Duplicated Article Title" & unique journal "MDE Journal"
           => Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="at3" title="Duplicated Article Title" year="2013" journal="MDE Journal">
    <authors author="Carol White"/>
  </entries>

  <!-- at4 & at5: different titles, same journal => MDE Letters -->
  <!-- at4: first in journal "MDE Letters" & unique title "First MDE Letter"
           => Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="at4" title="First MDE Letter" year="2014" journal="MDE Letters">
    <authors author="David Brown"/>
  </entries>

  <!-- at5: second in journal "MDE Letters" & unique title "Second MDE Letter"
           => Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="at5" title="Second MDE Letter" year="2015" journal="MDE Letters">
    <authors author="Eve Black"/>
  </entries>

</BibTeX:BibTeXFile>