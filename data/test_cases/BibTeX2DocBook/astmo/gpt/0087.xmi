<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- UntitledEntry via Misc -->
  <entries xsi:type="BibTeX:Misc" id="e01"/>

  <!-- Booklet (untitled, dated) -->
  <entries xsi:type="BibTeX:Booklet" id="e02" year="2001"/>

  <!-- Manual (titled, no authors, no year) -->
  <entries xsi:type="BibTeX:Manual" id="e03" title="DocBook Manual"/>

  <!-- Proceedings (titled, dated) -->
  <entries xsi:type="BibTeX:Proceedings" id="e04" title="MDE Conference" year="2010"/>

  <!-- InProceedings (authored, dated, booktitled) -->
  <entries xsi:type="BibTeX:InProceedings" id="e05" title="Model Transformations" year="2011" booktitle="MDE Conference">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Book (authored, dated, titled, publisher) -->
  <entries xsi:type="BibTeX:Book" id="e06" title="MDE Foundations" year="2012" publisher="Springer">
    <authors author="Alice Smith"/>
  </entries>

  <!-- InBook (authored, dated, titled, publisher, chapter) -->
  <entries xsi:type="BibTeX:InBook" id="e07" title="MDE Chapter" year="2013" publisher="Springer" chapter="5">
    <authors author="Carol White"/>
  </entries>

  <!-- InCollection (authored, dated, titled, booktitled, publisher) -->
  <entries xsi:type="BibTeX:InCollection" id="e08" title="MDE in Practice" year="2014" booktitle="MDE Foundations" publisher="ACM">
    <authors author="Bob Johnson"/>
  </entries>

  <!-- MasterThesis (authored, dated, titled, school) -->
  <entries xsi:type="BibTeX:MasterThesis" id="e09" title="MDE for Engineers" year="2015" school="Tech University">
    <authors author="Carol White"/>
  </entries>

  <!-- PhDThesis (authored, dated, titled, school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="e10" title="Advanced MDE" year="2016" school="Science University">
    <authors author="David Brown"/>
  </entries>

  <!-- TechReport (authored, dated, titled) -->
  <entries xsi:type="BibTeX:TechReport" id="e11" title="MDE Report" year="2017">
    <authors author="Eve Black"/>
  </entries>

  <!-- Unpublished (authored, titled, note) -->
  <entries xsi:type="BibTeX:Unpublished" id="e12" title="Draft on MDE" note="To appear">
    <authors author="Frank Green"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article with unique title and journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="e13" title="MDE Overview" year="2018" journal="Journal of MDE">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article sharing journal but unique title (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="e14" title="MDE Case Study" year="2019" journal="Journal of MDE">
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article sharing title but unique journal (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="e15" title="MDE Overview" year="2020" journal="Software Engineering Today">
    <authors author="Carol White"/>
  </entries>

  <!-- Article sharing both title and journal with e14 (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="e16" title="MDE Case Study" year="2021" journal="Journal of MDE">
    <authors author="David Brown"/>
  </entries>

</BibTeX:BibTeXFile>