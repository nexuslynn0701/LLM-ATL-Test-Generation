<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger R3 (UntitledEntry) and OCL5 -->
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2010"/>

  <!-- Misc also triggers R3 (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="msc1"/>

  <!-- Manual (titled, no authors/date) to trigger R4 (TitledEntry_Title_NoArticle) and OCL12 -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Manual Alpha"/>

  <!-- TechReport (titled, authored, dated) to trigger R4 and OCL11 -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="TR One" year="2015">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Unpublished (titled, authored, with note) to trigger R4 and OCL6 -->
  <entries xsi:type="BibTeX:Unpublished" id="up1" title="Unpub Study" note="Submitted for review">
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- Proceedings (base type) to trigger R4 and OCL13 -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conf Proc 2020" year="2020"/>

  <!-- InProceedings to trigger R4 and OCL14 -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Paper A" year="2020" booktitle="Conf Proc 2020">
    <authors author="Alice Smith"/>
    <authors author="Derek Lee"/>
  </entries>

  <!-- Book (base type) to trigger R4 and OCL9 -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Book One" year="2005" publisher="Springer">
    <authors author="Eve Clark"/>
  </entries>

  <!-- InBook to trigger R4 and OCL10 -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Chapter One" year="2006" publisher="Springer" chapter="1">
    <authors author="Eve Clark"/>
    <authors author="Frank Miller"/>
  </entries>

  <!-- InCollection to trigger R4 and OCL15 -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Collected Work" year="2012" publisher="ACM" booktitle="Book One">
    <authors author="George White"/>
  </entries>

  <!-- MasterThesis to trigger R4 (OCL7 is commented out but structurally covered) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Master Thesis Title" year="2018" school="Tech University">
    <authors author="Helen King"/>
  </entries>

  <!-- PhDThesis to trigger R4 and OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="PhD Thesis Title" year="2019" school="Science University">
    <authors author="Ian Brown"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article 1: unique title and journal, triggers R6 and OCL16/19 -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Article One" year="2011" journal="Journal A">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article 2: same title as art1, same journal as art3, triggers R7 (no title, journal unique set) -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Article One" year="2012" journal="Journal B">
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- Article 3: distinct title, same journal as art2, triggers R8 (title kept, no journal para) -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Article Three" year="2013" journal="Journal B">
    <authors author="Derek Lee"/>
    <authors author="Eve Clark"/>
  </entries>

</BibTeX:BibTeXFile>