<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (Rule R3: UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bklt1"
           year="2001"/>
  <entries xsi:type="BibTeX:Misc"
           id="misc1"/>

  <!-- Unpublished (R4, uses note but no year) -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unp1"
           title="Shared Title 1"
           note="Preprint note">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- TechReport (R4, dated, authored) -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr1"
           title="Unique TechReport Title"
           year="2015">
    <authors author="Alice Alpha"/>
  </entries>

  <!-- Manual (R4, titled only) -->
  <entries xsi:type="BibTeX:Manual"
           id="man1"
           title="User Manual Title"/>

  <!-- Proceedings (R4, dated, titled; base type, no children) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc1"
           title="Conference Proceedings X"
           year="2018"/>

  <!-- InProceedings (R4; authored, dated, booktitled, titled) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc1"
           title="InProceedings Title A"
           year="2019"
           booktitle="Proc of Conference Y">
    <authors author="Bob Beta"/>
    <authors author="Carol Gamma"/>
  </entries>

  <!-- Book (R4; authored, dated, titled, publisher) -->
  <entries xsi:type="BibTeX:Book"
           id="book1"
           title="Unique Book Title"
           year="2010"
           publisher="Famous Publisher">
    <authors author="Dan Delta"/>
    <authors author="Alice Alpha"/>
  </entries>

  <!-- InCollection (R4; authored, dated, titled, booktitle, publisher) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incoll1"
           title="Collected Chapter Title"
           year="2012"
           publisher="Famous Publisher"
           booktitle="Edited Volume One">
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- InBook (R4; authored, dated, titled, publisher, chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook1"
           title="InBook Title"
           year="2011"
           publisher="Tech Books Press"
           chapter="3">
    <authors author="Frank Phi"/>
  </entries>

  <!-- PhDThesis (R4; authored, dated, titled, school) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd1"
           title="PhD Thesis Title"
           year="2020"
           school="Tech University">
    <authors author="Grace Gama"/>
  </entries>

  <!-- MasterThesis (R4; authored, dated, titled, school) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc1"
           title="Master Thesis Title"
           year="2019"
           school="Science University">
    <authors author="Heidi Eta"/>
  </entries>

  <!-- Articles to exercise R6, R7, R8, R9 and journal/title uniqueness logic -->

  <!-- a1: unique title and journal (R6) -->
  <entries xsi:type="BibTeX:Article"
           id="a1"
           title="Article Title One"
           year="2017"
           journal="Journal A">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- a2 & a3: same title, different journals; one journal repeated later -->
  <!-- a2: chosen for both title set and journal set (R6) -->
  <entries xsi:type="BibTeX:Article"
           id="a2"
           title="Shared Title 2"
           year="2016"
           journal="Journal B">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- a3: same title as a2, journal appears three times total -> not in journal set, not in title set (R9) -->
  <entries xsi:type="BibTeX:Article"
           id="a3"
           title="Shared Title 2"
           year="2018"
           journal="Journal B">
    <authors author="Dan Delta"/>
  </entries>

  <!-- a4 & a5: distinct titles, same journal "Journal C" -->
  <!-- a4: selected for title set and journal set (R6) -->
  <entries xsi:type="BibTeX:Article"
           id="a4"
           title="Article C1"
           year="2015"
           journal="Journal C">
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- a5: same journal as a4, so not in journal set, but unique title (R8) -->
  <entries xsi:type="BibTeX:Article"
           id="a5"
           title="Article C2"
           year="2016"
           journal="Journal C">
    <authors author="Frank Phi"/>
  </entries>

  <!-- a6 & a7: same title and same journal "Journal D" -->
  <!-- a6: in title set and journal set (R6) -->
  <entries xsi:type="BibTeX:Article"
           id="a6"
           title="Shared Title 3"
           year="2021"
           journal="Journal D">
    <authors author="Grace Gama"/>
  </entries>

  <!-- a7: not in title set, not in journal set (R9) -->
  <entries xsi:type="BibTeX:Article"
           id="a7"
           title="Shared Title 3"
           year="2022"
           journal="Journal D">
    <authors author="Heidi Eta"/>
  </entries>

  <!-- a8 & a9: same title "Shared Title 4", journal "Journal B" (already used by a2/a3) -->
  <!-- a8: in title set, but journal appears multiple times (not in journal set) -> R8 -->
  <entries xsi:type="BibTeX:Article"
           id="a8"
           title="Shared Title 4"
           year="2019"
           journal="Journal B">
    <authors author="Alice Alpha"/>
  </entries>

  <!-- a9: neither in title set nor in journal set -> R9 -->
  <entries xsi:type="BibTeX:Article"
           id="a9"
           title="Shared Title 4"
           year="2020"
           journal="Journal B">
    <authors author="Bob Beta"/>
  </entries>

</BibTeX:BibTeXFile>