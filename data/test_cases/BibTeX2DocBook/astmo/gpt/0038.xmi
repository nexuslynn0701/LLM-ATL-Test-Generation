<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry: Booklet -->
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2015"/>

  <!-- Untitled entry: Misc -->
  <entries xsi:type="BibTeX:Misc" id="msc1"/>

  <!-- Manual (titled, no authors, no year) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="User Guide for Tool X"/>

  <!-- Proceedings (base type, dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proceedings of the First Conference" year="2010"/>

  <!-- InProceedings (child of Proceedings, authored, dated, booktitled) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="A Novel Approach"
           year="2010" booktitle="Proceedings of the First Conference">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Book (base type, authored, dated, titled, with publisher) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Foundations of MDE"
           year="2012" publisher="Academic Press">
    <authors author="Carol White"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- InBook (child of Book, authored, dated, titled, with publisher, chapter) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Model Transformation Chapter"
           year="2012" publisher="Academic Press" chapter="5">
    <authors author="David Brown"/>
  </entries>

  <!-- InCollection (child of Book, authored, dated, titled, booktitled, publisher) -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Case Studies in MDE"
           year="2013" booktitle="Advances in Software Engineering" publisher="Springer">
    <authors author="Alice Smith"/>
  </entries>

  <!-- TechReport (authored, dated, titled) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="MDE in Industry"
           year="2014">
    <authors author="Bob Jones"/>
    <authors author="Eve Black"/>
  </entries>

  <!-- MasterThesis (authored, dated, titled, thesis with school) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Model-Driven Testing"
           year="2016" school="University A">
    <authors author="Frank Green"/>
  </entries>

  <!-- PhDThesis (authored, dated, titled, thesis with school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Model Transformations"
           year="2018" school="University B">
    <authors author="Alice Smith"/>
    <authors author="Henry Gray"/>
  </entries>

  <!-- Unpublished (authored and titled, with note) -->
  <entries xsi:type="BibTeX:Unpublished" id="unp1" title="Draft on MDE Quality"
           note="To appear">
    <authors author="Carol White"/>
    <authors author="David Brown"/>
  </entries>

  <!-- Article 1 (unique title and journal) -->
  <entries xsi:type="BibTeX:Article" id="art1"
           title="Transformations in Practice" year="2011" journal="Journal of MDE">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article 2 (same title as art1, different journal) -->
  <entries xsi:type="BibTeX:Article" id="art2"
           title="Transformations in Practice" year="2012" journal="Software Engineering Today">
    <authors author="Carol White"/>
  </entries>

  <!-- Article 3 (different title, same journal as art3/4 pair) -->
  <entries xsi:type="BibTeX:Article" id="art3"
           title="Empirical Studies on MDE" year="2013" journal="International Journal of SE">
    <authors author="David Brown"/>
  </entries>

  <!-- Article 4 (different title, same journal as art3) -->
  <entries xsi:type="BibTeX:Article" id="art4"
           title="Tool Support for MDE" year="2014" journal="International Journal of SE">
    <authors author="Eve Black"/>
    <authors author="Frank Green"/>
  </entries>

</BibTeX:BibTeXFile>