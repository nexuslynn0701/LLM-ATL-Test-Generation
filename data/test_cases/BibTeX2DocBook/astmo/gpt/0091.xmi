<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc (untitled, unauthored, undated) -->
  <entries xsi:type="BibTeX:Misc" id="miscA"/>

  <!-- Booklet (untitled, dated) -->
  <entries xsi:type="BibTeX:Booklet" id="bookletA" year="2005"/>

  <!-- Manual (titled, no authors, no year) -->
  <entries xsi:type="BibTeX:Manual" id="manualA" title="MDE Manual"/>

  <!-- TechReport (titled, authored, dated) -->
  <entries xsi:type="BibTeX:TechReport" id="techrepA" title="Report on MDE" year="2010">
    <authors author="Alice Smith"/>
    <authors author="Bob Lee"/>
  </entries>

  <!-- Proceedings (base type, titled, dated) -->
  <entries xsi:type="BibTeX:Proceedings" id="procA" title="MDEConf 2012" year="2012"/>

  <!-- InProceedings (derived from Proceedings, Authored, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings" id="inprocA" title="Proceedings Paper One" year="2012" booktitle="MDEConf 2012">
    <authors author="Alice Smith"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry, titled, authored, dated, publisher, booktitle) -->
  <entries xsi:type="BibTeX:InCollection" id="incolA" title="Chapter on Transformations" year="2014" publisher="ACM Press" booktitle="Advances in MDE">
    <authors author="Charlie Doe"/>
  </entries>

  <!-- Book (plain Book, not InBook/InCollection) -->
  <entries xsi:type="BibTeX:Book" id="bookA" title="Model-Driven Engineering Book" year="2015" publisher="Springer">
    <authors author="Alice Smith"/>
    <authors author="Charlie Doe"/>
  </entries>

  <!-- InBook (derived from Book, titled, authored, dated, publisher, chapter) -->
  <entries xsi:type="BibTeX:InBook" id="inbookA" title="InBook Chapter" year="2016" publisher="IEEE Press" chapter="3">
    <authors author="Bob Lee"/>
  </entries>

  <!-- MasterThesis (ThesisEntry, titled, authored, dated, school) -->
  <entries xsi:type="BibTeX:MasterThesis" id="msthesisA" title="MDE in Practice" year="2017" school="Tech University">
    <authors author="Diana Prince"/>
  </entries>

  <!-- PhDThesis (ThesisEntry, titled, authored, dated, school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phdthesisA" title="Advanced MDE" year="2018" school="Global University">
    <authors author="Evan Stone"/>
  </entries>

  <!-- Unpublished (titled, authored, note; no year) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpubA" title="Unreleased MDE Study" note="to appear">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article 1: unique title and unique journal -->
  <entries xsi:type="BibTeX:Article" id="artA" title="MDE for Beginners" year="2011" journal="Journal of MDE">
    <authors author="Alice Smith"/>
    <authors author="Bob Lee"/>
  </entries>

  <!-- Article 2 and 3: same title, different journals (title-duplicate, journal-unique) -->
  <entries xsi:type="BibTeX:Article" id="artB" title="Shared Title Article" year="2012" journal="Journal A">
    <authors author="Charlie Doe"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artC" title="Shared Title Article" year="2013" journal="Journal B">
    <authors author="Diana Prince"/>
  </entries>

  <!-- Article 4 and 5: different titles, same journal (journal-duplicate, title-unique) -->
  <entries xsi:type="BibTeX:Article" id="artD" title="First Journal Duplicate" year="2014" journal="Common Journal">
    <authors author="Evan Stone"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="artE" title="Second Journal Duplicate" year="2015" journal="Common Journal">
    <authors author="Bob Lee"/>
  </entries>

</BibTeX:BibTeXFile>