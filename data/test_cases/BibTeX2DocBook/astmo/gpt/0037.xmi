<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article 1: unique title & journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Unique Article A"
           year="2010"
           journal="Distinct Journal 1">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- Article 2 & 3: same title, same journal -> Article_Title_Journal for first, Article_NoTitle_NoJournal for second -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Duplicate TJ Article"
           year="2011"
           journal="Shared Journal TJ">
    <authors author="Carol Gamma"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Duplicate TJ Article"
           year="2012"
           journal="Shared Journal TJ">
    <authors author="Dave Delta"/>
  </entries>

  <!-- Article 4 & 5: same title, different journals -> Article_Title_Journal for first, Article_NoTitle_Journal for second -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Same Title Diff Journal"
           year="2013"
           journal="Journal Group A">
    <authors author="Eve Epsilon"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A5"
           title="Same Title Diff Journal"
           year="2014"
           journal="Journal Group B">
    <authors author="Frank Phi"/>
  </entries>

  <!-- Article 6 & 7: different titles, same journal -> Article_Title_Journal for first, Article_Title_NoJournal for second -->
  <entries xsi:type="BibTeX:Article"
           id="A6"
           title="Article One Shared Journal"
           year="2015"
           journal="Journal Shared">
    <authors author="Grace Gamma"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="A7"
           title="Article Two Shared Journal"
           year="2016"
           journal="Journal Shared">
    <authors author="Heidi Eta"/>
  </entries>

  <!-- Booklet (untitled, dated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet"
           id="BKT1"
           year="2009"/>

  <!-- Misc (untitled, undated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="MSC1"/>

  <!-- Manual (titled, not authored, not dated) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual"
           id="MAN1"
           title="Manual Title 1"/>

  <!-- Manual with same title as MAN1 -> TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Manual"
           id="MAN2"
           title="Manual Title 1"/>

  <!-- TechReport (titled, authored, dated) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="TechReport Title 1"
           year="2017">
    <authors author="Ivan Iota"/>
  </entries>

  <!-- Unpublished (titled, authored, note) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished"
           id="UP1"
           title="Unpublished Work 1"
           note="To appear soon">
    <authors author="John Jota"/>
    <authors author="Alice Alpha"/>
  </entries>

  <!-- MasterThesis (titled, authored, dated, school) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Master Thesis Title"
           year="2018"
           school="Tech University">
    <authors author="Karl Kappa"/>
  </entries>

  <!-- PhDThesis (titled, authored, dated, school) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Doctoral Thesis Title"
           year="2019"
           school="Science Institute">
    <authors author="Laura Lambda"/>
  </entries>

  <!-- Book (titled, authored, dated, publisher) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book"
           id="BK1"
           title="Standalone Book Title"
           year="2005"
           publisher="Books Publisher Ltd.">
    <authors author="Mike Mu"/>
    <authors author="Nina Nu"/>
  </entries>

  <!-- InBook (Book child, chapter) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="InBook Chapter Title"
           year="2006"
           publisher="Books Publisher Ltd."
           chapter="3">
    <authors author="Oscar Omicron"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="InCollection Title"
           year="2007"
           publisher="Collection House"
           booktitle="Collected Works 2007">
    <authors author="Peggy Pi"/>
  </entries>

  <!-- Proceedings (titled, dated) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings"
           id="PR1"
           title="Conference Proceedings 1"
           year="2011"/>

  <!-- InProceedings (Proceedings child, authored, booktitle) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Conference Paper Title"
           year="2011"
           booktitle="Conference Proceedings 1">
    <authors author="Quentin Qop"/>
    <authors author="Rachel Rho"/>
  </entries>

</BibTeX:BibTeXFile>