<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry (for UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Booklet" id="bkt1" year="2001"/>

  <!-- Unpublished (titled, no authors) -->
  <entries xsi:type="BibTeX:Unpublished" id="unp1" title="Shared Title A" note="To appear."/>

  <!-- MasterThesis (titled, authored, dated, thesis) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Shared Title B" year="2015" school="Engineering School">
    <authors author="Diana Doe"/>
  </entries>

  <!-- PhDThesis (titled, authored, dated, thesis) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Doctoral Research" year="2018" school="Tech University">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book (base Book, not subtype) -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="Distributed Systems" year="2012" publisher="Global Press">
    <authors author="Bob Brown"/>
  </entries>

  <!-- InBook (Book subtype, chapter) -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Chapter on Testing" year="2013" publisher="Global Press" chapter="5">
    <authors author="Charlie Clark"/>
  </entries>

  <!-- Proceedings (base Proceedings, dated + titled) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conference on Modeling" year="2019"/>

  <!-- InProceedings (subtype of Proceedings, authored, booktitle) -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Model Transformations in Practice" year="2019" booktitle="Conference on Modeling">
    <authors author="Alice Smith"/>
    <authors author="Eve Evans"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry subtype) -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="MDE in Industry" year="2016" publisher="Tech Books" booktitle="Advances in Software Engineering">
    <authors author="Frank Foster"/>
  </entries>

  <!-- Manual (titled only) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Tool User Guide"/>

  <!-- TechReport (titled, authored, dated) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Testing Framework" year="2017">
    <authors author="George Green"/>
  </entries>

  <!-- Article 1: distinct title and journal -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Unique Article Title" year="2020" journal="Journal A">
    <authors author="Alice Smith"/>
    <authors author="Bob Brown"/>
  </entries>

  <!-- Article 2: same title as art3, unique journal -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Shared Title A" year="2021" journal="Journal B">
    <authors author="Charlie Clark"/>
  </entries>

  <!-- Article 3: same title as art2, new journal (duplicate title case) -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Shared Title A" year="2022" journal="Journal C">
    <authors author="Diana Doe"/>
  </entries>

  <!-- Article 4: unique title, shared journal with art5 -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Journal C Study" year="2023" journal="Journal C">
    <authors author="Eve Evans"/>
  </entries>

  <!-- Article 5: unique title, shared journal with art4 (duplicate journal case) -->
  <entries xsi:type="BibTeX:Article" id="art5" title="Another C Paper" year="2024" journal="Journal C">
    <authors author="Frank Foster"/>
  </entries>

</BibTeX:BibTeXFile>