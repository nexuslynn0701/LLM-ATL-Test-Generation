<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger UntitledEntry (Misc) -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- Booklet (untitled entry, DatedEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="BLET1" year="2001"/>

  <!-- Manual (TitledEntry, no authors, no year) -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="MDE User Guide"/>

  <!-- TechReport (TitledEntry + Authored + Dated) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Transformation Testing" year="2012">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Unpublished (TitledEntry + Authored, note only, no year) -->
  <entries xsi:type="BibTeX:Unpublished" id="UNP1" title="Draft on ATL" note="To appear">
    <authors author="Charlie Brown"/>
  </entries>

  <!-- Proceedings (TitledEntry + Dated) -->
  <entries xsi:type="BibTeX:Proceedings" id="PROC1" title="MDE Symposium" year="2015"/>

  <!-- InProceedings (Authored + BookTitledEntry + Dated + Titled) -->
  <entries xsi:type="BibTeX:InProceedings" id="INP1" title="Model Transformations in Practice" year="2016" booktitle="Proceedings of MDE Symposium">
    <authors author="Alice Smith"/>
    <authors author="David Clark"/>
  </entries>

  <!-- Book (Authored + Dated + Titled + publisher) -->
  <entries xsi:type="BibTeX:Book" id="BOOK1" title="Fundamentals of MDE" year="2010" publisher="TechPress">
    <authors author="Bob Jones"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook" id="INB1" title="Chapter on Testing" year="2011" publisher="TechPress" chapter="3">
    <authors author="Bob Jones"/>
    <authors author="Eve Adams"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection" id="INC1" title="Testing Transformations" year="2013" publisher="TechPress" booktitle="Advances in MDE">
    <authors author="Alice Smith"/>
  </entries>

  <!-- MasterThesis (ThesisEntry, commented rule in OCL but still valid source) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Testing in MDE" year="2014" school="University of Testing">
    <authors author="Frank Moore"/>
  </entries>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Advanced Testing in MDE" year="2018" school="University of Testing">
    <authors author="Alice Smith"/>
    <authors author="George King"/>
  </entries>

  <!-- Article 1: unique title, unique journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="ATL Transformation Testing" year="2020" journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article 2: shares title with A3, unique journal -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Duplicate Title Case" year="2021" journal="Software Practice Journal">
    <authors author="Charlie Brown"/>
  </entries>

  <!-- Article 3: same title as A2, unique journal -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Duplicate Title Case" year="2022" journal="Modeling Letters">
    <authors author="David Clark"/>
  </entries>

  <!-- Article 4: unique title, shares journal with A5 -->
  <entries xsi:type="BibTeX:Article" id="A4" title="Shared Journal First" year="2019" journal="Shared Journal of MDE">
    <authors author="Eve Adams"/>
  </entries>

  <!-- Article 5: unique title, same journal as A4 -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Shared Journal Second" year="2023" journal="Shared Journal of MDE">
    <authors author="Frank Moore"/>
  </entries>

</BibTeX:BibTeXFile>