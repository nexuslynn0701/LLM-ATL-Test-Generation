<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (trigger UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2018"/>

  <!-- Unpublished entries with same / different titles (TitledEntry_* rules) -->
  <entries xsi:type="BibTeX:Unpublished" id="u1" title="Early Draft on MDE" note="Internal review only">
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="u2" title="Early Draft on MDE" note="Extended version">
    <authors author="Bob Johnson"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="u3" title="Late Draft on Testing" note="Submitted to conference">
    <authors author="Alice Smith"/>
    <authors author="Carol White"/>
  </entries>

  <!-- Manual with unique title -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="User Guide for Transformation Tool"/>

  <!-- TechReport with duplicate title (same as Book) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="MDE Best Practices" year="2019">
    <authors author="David Brown"/>
  </entries>

  <!-- Master and PhD theses -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Model Transformation Testing" year="2017" school="Tech University">
    <authors author="Eve Black"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Scalable MDE Solutions" year="2020" school="Engineering Institute">
    <authors author="Frank Green"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book and InBook (same title for title-duplication case) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="MDE Best Practices" year="2015" publisher="Springer">
    <authors author="George King"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Advanced Transformation Cases" year="2016" publisher="Springer" chapter="3">
    <authors author="Helen Lee"/>
  </entries>

  <!-- Proceedings and InProceedings -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="ICMT 2019" year="2019"/>
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Testing Model Transformations" year="2019" booktitle="ICMT 2019">
    <authors author="Alice Smith"/>
    <authors author="David Brown"/>
  </entries>

  <!-- InCollection sharing title with nothing else -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Reusable Transformation Patterns" year="2014" booktitle="Patterns in Software Engineering" publisher="ACM">
    <authors author="Carol White"/>
  </entries>

  <!-- Articles for all four Article_* rules -->
  <!-- Unique title and unique journal: Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Traceability in MDE" year="2012" journal="Software Journal A">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Same title as a1, unique journal: Article_NoTitle_Journal (title duplicate, journal unique) -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Traceability in MDE" year="2013" journal="Software Journal B">
    <authors author="Carol White"/>
  </entries>

  <!-- Unique title, same journal as a3: Article_Title_NoJournal (title unique, journal duplicate) -->
  <entries xsi:type="BibTeX:Article" id="a3" title="Metamodel Evolution Study" year="2014" journal="Modeling Journal C">
    <authors author="David Brown"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a4" title="Empirical Evaluation of M2M" year="2015" journal="Modeling Journal C">
    <authors author="Eve Black"/>
  </entries>

  <!-- Same title and same journal: Article_NoTitle_NoJournal (both duplicates) -->
  <entries xsi:type="BibTeX:Article" id="a5" title="Reusable Transformation Patterns" year="2016" journal="Journal of Transformations">
    <authors author="Frank Green"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a6" title="Reusable Transformation Patterns" year="2017" journal="Journal of Transformations">
    <authors author="George King"/>
  </entries>

</BibTeX:BibTeXFile>