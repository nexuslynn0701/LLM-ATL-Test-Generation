<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger UntitledEntry (Booklet) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bkl1"
           year="2018"/>

  <!-- Misc also triggers UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="msc1"/>

  <!-- Manual (titled, no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="man1"
           title="DocBook Reference Manual"/>

  <!-- Unpublished with two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unp1"
           title="Early Results in Model Transformation"
           note="Submitted for publication">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mst1"
           title="Model Checking of Transformations"
           year="2017"
           school="University of Metropolis">
    <authors author="Carol White"/>
  </entries>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd1"
           title="Scalable Model-Driven Engineering"
           year="2016"
           school="Institute of Advanced Studies">
    <authors author="David Brown"/>
  </entries>

  <!-- Book (base Book type, not subclasses) -->
  <entries xsi:type="BibTeX:Book"
           id="bok1"
           title="Foundations of MDE"
           year="2015"
           publisher="TechPress">
    <authors author="Eve Black"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- InBook -->
  <entries xsi:type="BibTeX:InBook"
           id="ib1"
           title="Chapter on Transformations"
           year="2019"
           publisher="Springer"
           chapter="3">
    <authors author="George Martin"/>
  </entries>

  <!-- Proceedings (base type, not children) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc1"
           title="MDE Conference 2020"
           year="2020"/>

  <!-- InProceedings -->
  <entries xsi:type="BibTeX:InProceedings"
           id="ip1"
           title="A Study on ATL Transformations"
           year="2020"
           booktitle="MDE Conference 2020">
    <authors author="Alice Smith"/>
    <authors author="Henry King"/>
  </entries>

  <!-- Book that will be parent of InCollection (base Book type) -->
  <entries xsi:type="BibTeX:InCollection"
           id="ic1"
           title="Testing Model Transformations"
           year="2021"
           booktitle="Advances in Software Engineering"
           publisher="SE Publishers">
    <authors author="Ian Lee"/>
    <authors author="Jane Doe"/>
  </entries>

  <!-- TechReport -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr1"
           title="Report on Model Transformation Testing"
           year="2014">
    <authors author="Karen Young"/>
  </entries>

  <!-- Article with unique title and journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article"
           id="art1"
           title="Model Transformation By Example"
           year="2013"
           journal="Journal of Model Engineering">
    <authors author="Laura Scott"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article with same title as art3 but different journal (Article_Title_Journal and Article_Title_NoJournal combos) -->
  <entries xsi:type="BibTeX:Article"
           id="art2"
           title="Empirical Studies in MDE"
           year="2012"
           journal="Software Practice Journal">
    <authors author="Michael Clark"/>
  </entries>

  <!-- Second Article sharing title with art2 (to exercise Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article"
           id="art3"
           title="Empirical Studies in MDE"
           year="2014"
           journal="International Journal of MDE">
    <authors author="Nina Roberts"/>
  </entries>

  <!-- Second Article sharing journal with art4 (to exercise Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article"
           id="art4"
           title="Quality Assurance in Transformations"
           year="2011"
           journal="Transformation Journal">
    <authors author="Oscar Perez"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="art5"
           title="Advanced Debugging of ATL"
           year="2018"
           journal="Transformation Journal">
    <authors author="Peter Quinn"/>
  </entries>

  <!-- Two Articles sharing both title and journal (to exercise Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article"
           id="art6"
           title="Reusable Transformation Patterns"
           year="2010"
           journal="Patterns in Software">
    <authors author="Quentin Ray"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="art7"
           title="Reusable Transformation Patterns"
           year="2011"
           journal="Patterns in Software">
    <authors author="Rachel Stone"/>
  </entries>

</BibTeX:BibTeXFile>