<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- UntitledEntry via Misc -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- UntitledEntry via Booklet -->
  <entries xsi:type="BibTeX:Booklet" id="BKL1" year="2005"/>

  <!-- TitledEntry_Title_NoArticle: Unpublished -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Unpub Title One" note="Preprint note">
    <authors author="Alice Unique"/>
  </entries>

  <!-- TitledEntry_NoTitle_NoArticle: second Unpublished with same title -->
  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Unpub Title One" note="Extended version note">
    <authors author="Bob DuplicateTitle"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle: Manual -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="Manual of Testing"/>

  <!-- TitledEntry_Title_NoArticle: Proceedings (base type, no children) -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" title="Proc of MDE" year="2018"/>

  <!-- TitledEntry_Title_NoArticle: Book (base type, not children) -->
  <entries xsi:type="BibTeX:Book" id="BK1" title="Fundamentals of Transformation" year="2010" publisher="Springer">
    <authors author="Charlie BookAuthor"/>
    <authors author="Dana CoAuthor"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle: InBook -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chapter on Testing" year="2011" publisher="Elsevier" chapter="3">
    <authors author="Eve InBookAuthor"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle: InCollection -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Collected Insights" year="2012" publisher="ACM">
    <authors author="Frank CollectionAuthor"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle: InProceedings -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Proceedings Paper" year="2019" booktitle="MDE Symposium 2019">
    <authors author="Grace InProcAuthor"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle: MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Mastering Model Transformations" year="2015" school="Tech University">
    <authors author="Henry Master"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle: PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Advanced Transformation Testing" year="2016" school="Science Institute">
    <authors author="Ivy Doctor"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle: TechReport -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Testing Report" year="2013">
    <authors author="Jack Reporter"/>
  </entries>

  <!-- Article_Title_Journal: unique title and unique journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Unique Article Title" year="2020" journal="Unique Journal A">
    <authors author="Kate ArticleAuthor"/>
    <authors author="Leo CoAuthor"/>
  </entries>

  <!-- Article_NoTitle_Journal: same journal as A2 but unique title -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Third Article Title" year="2022" journal="Shared Journal">
    <authors author="Mia ThirdAuthor"/>
  </entries>

  <!-- Article_NoTitle_NoJournal: same title and same journal as A4 -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Duplicate Article Title" year="2023" journal="Duplicate Journal">
    <authors author="Nina Duplicate"/>
  </entries>

  <!-- Additional authored entry to reuse some authors without being titled -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" title="Secondary Report" year="2014">
    <authors author="Alice Unique"/>
    <authors author="Charlie BookAuthor"/>
  </entries>

  <!-- Extra Booklet to add more dated but untitled entries -->
  <entries xsi:type="BibTeX:Booklet" id="BKL2" year="2007"/>

  <!-- Extra Misc entry -->
  <entries xsi:type="BibTeX:Misc" id="M2"/>

  <!-- Additional Article to create duplicates on title and journal sets -->

  <!-- Article_Title_NoJournal: same journal as A3 but unique in journalSet due to ordering, title unique in titledEntrySet -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Second Article Title" year="2021" journal="Shared Journal">
    <authors author="Oscar SecondAuthor"/>
  </entries>

  <!-- Article_Title_Journal: unique title and unique journal; placed later so journalSet choice differs -->
  <entries xsi:type="BibTeX:Article" id="A4" title="Fourth Unique Article" year="2024" journal="Another Unique Journal">
    <authors author="Paul FourthAuthor"/>
  </entries>

</BibTeX:BibTeXFile>