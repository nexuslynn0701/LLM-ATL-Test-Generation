<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- UntitledEntry via Misc -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Booklet (untitled entry, DatedEntry only) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="1995"/>

  <!-- Manual (TitledEntry only, unique title) -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="User Guide for X"/>

  <!-- TechReport (Authored, Dated, Titled, unique title) -->
  <entries xsi:type="BibTeX:TechReport" id="tech1" title="Analysis of Systems" year="2001">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Unpublished (Authored, Titled, unique title) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Preliminary Results" note="To appear">
    <authors author="Alice Smith"/>
  </entries>

  <!-- PhDThesis (ThesisEntry, unique title) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Research" year="2010" school="Tech University">
    <authors author="Carol White"/>
  </entries>

  <!-- MasterThesis (ThesisEntry, unique title) -->
  <entries xsi:type="BibTeX:MasterThesis" id="master1" title="Introductory Study" year="2012" school="City College">
    <authors author="David Brown"/>
  </entries>

  <!-- Book (Book, unique title) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Software Engineering" year="2005" publisher="Global Press">
    <authors author="Eve Black"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- InBook (Book child, same publisher style) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Software Engineering" year="2006" publisher="Global Press" chapter="3">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Proceedings (Dated & Titled only, no children, unique title) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conference on Systems" year="2015"/>

  <!-- InProceedings (Authored, Dated, Titled, BookTitledEntry, unique title) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Scalable Architectures" year="2015" booktitle="Conference on Systems">
    <authors author="George Hill"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- InCollection (Book child + BookTitledEntry, unique title) -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Patterns in Design" year="2007" booktitle="Software Engineering" publisher="Global Press">
    <authors author="Helen King"/>
  </entries>

  <!-- Article A: unique title, unique journal -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Model Transformations" year="2018" journal="Journal of Software">
    <authors author="Alice Smith"/>
    <authors author="Ian Clark"/>
  </entries>

  <!-- Article B: same title as art3, unique journal -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Case Studies in MDE" year="2019" journal="Software Practice">
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article C: same title as art2, unique journal -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Case Studies in MDE" year="2020" journal="Engineering Reports">
    <authors author="Carol White"/>
  </entries>

  <!-- Article D: unique title, journal J1 with another article (art5) -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Testing Transformations" year="2017" journal="Journal of Modeling">
    <authors author="David Brown"/>
    <authors author="Eve Black"/>
  </entries>

  <!-- Article E: unique title, same journal as art4 (J1) -->
  <entries xsi:type="BibTeX:Article" id="art5" title="Empirical Studies" year="2016" journal="Journal of Modeling">
    <authors author="Frank Green"/>
  </entries>

</BibTeX:BibTeXFile>