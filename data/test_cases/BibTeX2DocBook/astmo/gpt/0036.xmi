<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (R3: Misc, Booklet) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Booklet" id="bkt1" year="2015"/>

  <!-- Articles to exercise R6, R7, R8, R9 and journal/title uniqueness logic -->
  <!-- a1: unique title and unique journal -> Article_Title_Journal (R6) -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Unique Article Title" year="2020" journal="Solo Journal">
    <authors author="Alice Author"/>
  </entries>

  <!-- a2/a3: same title, different journals -> one in title set, both in journal set -->
  <!-- The first (a2) is selected for both title and journal sets -> R6 -->
  <!-- The second (a3) not in title set, but in journal set -> R7 -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Repeated Article Title" year="2021" journal="Journal A">
    <authors author="Bob Writer"/>
    <authors author="Carol Researcher"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a3" title="Repeated Article Title" year="2022" journal="Journal B">
    <authors author="Dave Scholar"/>
  </entries>

  <!-- a4/a5: same journal, different titles. Only a4 will be in the articleSet -->
  <!-- a4: first with journal 'Shared Journal' and unique title -> R8 (Title, no Journal) -->
  <!-- a5: later same journal, not in journal set, but in title set -> R8 as well -->
  <entries xsi:type="BibTeX:Article" id="a4" title="First Shared Journal Article" year="2018" journal="Shared Journal">
    <authors author="Eve Expert"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a5" title="Second Shared Journal Article" year="2019" journal="Shared Journal">
    <authors author="Frank Fellow"/>
  </entries>

  <!-- a6/a7: same title and same journal. Only a6 will be in both sets -> R6 -->
  <!-- a7: not in title set nor journal set -> R9 (NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="a6" title="Twin Article" year="2016" journal="Twin Journal">
    <authors author="Grace Author"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a7" title="Twin Article" year="2017" journal="Twin Journal">
    <authors author="Heidi Author"/>
  </entries>

  <!-- Non-article titled entries to exercise R4 and R5,
       and various subclasses: Book, InBook, InCollection, InProceedings,
       Proceedings, Manual, Unpublished, TechReport, PhDThesis, MasterThesis -->

  <!-- Book with a unique title -> in titledEntrySet -> R4 -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="Unique Book Title" year="2010" publisher="Famous Publisher">
    <authors author="Ian Writer"/>
  </entries>

  <!-- Two Books with the same title: first in titledEntrySet (R4), second out (R5) -->
  <entries xsi:type="BibTeX:Book" id="bk2" title="Repeated Book Title" year="2011" publisher="Press One">
    <authors author="Jack Author"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="bk3" title="Repeated Book Title" year="2012" publisher="Press Two">
    <authors author="Karen Author"/>
  </entries>

  <!-- InBook with unique title -> R4 -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Chaptered Book" year="2013" publisher="Chapter Press" chapter="3">
    <authors author="Laura Chapter"/>
    <authors author="Mike Coauthor"/>
  </entries>

  <!-- InCollection with unique title -> R4 -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Collected Work" year="2014" publisher="Collection House" booktitle="Collection Proceedings">
    <authors author="Nina Researcher"/>
  </entries>

  <!-- InProceedings with unique title -> R4 -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Conference Paper" year="2016" booktitle="Big Conference">
    <authors author="Oscar Presenter"/>
  </entries>

  <!-- Proceedings with duplicated title to force R4/R5 split -->
  <entries xsi:type="BibTeX:Proceedings" id="pr1" title="Annual Symposium" year="2009"/>
  <entries xsi:type="BibTeX:Proceedings" id="pr2" title="Annual Symposium" year="2010"/>

  <!-- Manual with unique title -> R4 -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="User Manual v1"/>
  <!-- Manual sharing title with a TechReport -> will still participate in title uniqueness set -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="Shared Title Publication"/>

  <!-- Unpublished with unique title -> R4 -->
  <entries xsi:type="BibTeX:Unpublished" id="up1" title="Unreleased Study" note="To appear soon">
    <authors author="Paul Unpublished"/>
  </entries>

  <!-- Two TechReports with same title: first in set (R4), second out (R5) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Shared Title Publication" year="2011">
    <authors author="Quinn Tech"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="Shared Title Publication" year="2012">
    <authors author="Rachel Tech"/>
  </entries>

  <!-- PhDThesis with unique title -> R4 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Doctoral Research" year="2008" school="Tech University">
    <authors author="Sam Doctoral"/>
  </entries>

  <!-- MasterThesis with unique title -> R4 -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" title="Master Research" year="2007" school="Science Institute">
    <authors author="Tina Master"/>
  </entries>

</BibTeX:BibTeXFile>