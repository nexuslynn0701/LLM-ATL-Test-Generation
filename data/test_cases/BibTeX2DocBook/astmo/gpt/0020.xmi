<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="2009"/>
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- Unpublished (titled, no article) -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Common Research Title" note="under revision">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Manual (titled, no article) -->
  <entries xsi:type="BibTeX:Manual" id="Man1" title="Tool User Guide"/>

  <!-- TechReport (titled, no article) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Technical Report on Systems" year="2017">
    <authors author="Carol White"/>
  </entries>

  <!-- MasterThesis (titled, no article) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Mastering Modeling" year="2015" school="Tech University">
    <authors author="Dave Brown"/>
  </entries>

  <!-- PhDThesis (titled, no article) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Advanced Model Transformations" year="2018" school="Tech University">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book (titled, no article, base Book) -->
  <entries xsi:type="BibTeX:Book" id="BK1" title="Model Engineering Basics" year="2012" publisher="ModelPress">
    <authors author="Bob Johnson"/>
    <authors author="Eve Black"/>
  </entries>

  <!-- InBook (titled, no article, Book child) -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chapter on Testing" year="2013" publisher="ModelPress" chapter="3">
    <authors author="Carol White"/>
  </entries>

  <!-- Proceedings (titled, no article, base Proceedings) -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" title="Proceedings of MDE Conference" year="2019"/>

  <!-- InProceedings (titled, no article, Proceedings child) -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Common Research Title" year="2019" booktitle="Proceedings of MDE Conference">
    <authors author="Dave Brown"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- InCollection (titled, no article, Book child) -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Collected Chapter on Models" year="2014" publisher="ModelPress" booktitle="Collected Works in MDE">
    <authors author="Eve Black"/>
  </entries>

  <!-- Articles to trigger different Article-* rules and journal/title dedup -->
  <!-- A1: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Unique Article A" year="2020" journal="Journal A">
    <authors author="Alice Smith"/>
    <authors author="Carol White"/>
  </entries>

  <!-- A2 & A3: same title, different journals -> Article_NoTitle_Journal for A2, Article_Title_Journal for A3 -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Shared Title" year="2021" journal="Journal B">
    <authors author="Bob Johnson"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A3" title="Shared Title" year="2022" journal="Journal C">
    <authors author="Dave Brown"/>
  </entries>

  <!-- A4 & A5: different titles, same journal -> Article_Title_NoJournal for A4, Article_Title_Journal for A5 -->
  <entries xsi:type="BibTeX:Article" id="A4" title="Journal D First" year="2019" journal="Journal D">
    <authors author="Frank Green"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="A5" title="Journal D Second" year="2020" journal="Journal D">
    <authors author="Eve Black"/>
  </entries>

</BibTeX:BibTeXFile>