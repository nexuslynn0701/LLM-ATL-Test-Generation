<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry: Misc (triggers R3 UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>

  <!-- Untitled entry: Booklet (triggers R3 UntitledEntry and OCL5) -->
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2015"/>

  <!-- Unpublished with unique title (R4 Title_NoArticle, OCL6) -->
  <entries xsi:type="BibTeX:Unpublished" id="up1" title="Unpub Unique Title" note="Note UP1">
    <authors author="Alice Unique"/>
  </entries>

  <!-- Unpublished pair with same title (R4 + R5 combination, OCL6) -->
  <entries xsi:type="BibTeX:Unpublished" id="up2" title="Shared Unpub Title" note="First version note">
    <authors author="Bob Shared"/>
    <authors author="Carol Shared"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished" id="up3" title="Shared Unpub Title" note="Second version note">
    <authors author="Dave Shared"/>
  </entries>

  <!-- Manual (TitledEntry, no authors, R4, OCL12) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Tool Manual A"/>

  <!-- Proceedings: one standalone (R4, OCL13) and one parent of InProceedings/Booklet (still type Proceedings) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conf Proc Standalone" year="2017"/>

  <entries xsi:type="BibTeX:Proceedings" id="proc2" title="Main Conference 2020" year="2020"/>

  <!-- InProceedings with unique title and booktitle (R4, OCL14) -->
  <entries xsi:type="BibTeX:InProceedings" id="inp1" title="InProc Paper One" year="2020" booktitle="Main Conference 2020">
    <authors author="Eve Author"/>
    <authors author="Frank Author"/>
  </entries>

  <!-- Book, unique title (R4, OCL9) -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="Unique Book Title" year="2012" publisher="Unique Publisher Ltd.">
    <authors author="George Writer"/>
  </entries>

  <!-- InCollection with unique title (R4, OCL15) -->
  <entries xsi:type="BibTeX:InCollection" id="inc1" title="Collected Chapter One" year="2013" booktitle="Collected Works Vol. 1" publisher="Collections Press">
    <authors author="Helen Chapter"/>
  </entries>

  <!-- InBook with unique title (R4, OCL10) -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="InBook Chapter Alpha" year="2010" publisher="BookHouse" chapter="3">
    <authors author="Ian Chapter"/>
    <authors author="Jane Chapter"/>
  </entries>

  <!-- TechReport, unique title (R4, OCL11) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="TechReport Unique" year="2011">
    <authors author="Kevin Reporter"/>
  </entries>

  <!-- PhDThesis, unique title (R4, OCL8) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="PhD Thesis Alpha" year="2014" school="Tech University">
    <authors author="Laura PhD"/>
  </entries>

  <!-- MasterThesis, unique title (R4, commented OCL7) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" title="Master Thesis Beta" year="2016" school="Science College">
    <authors author="Mike MSc"/>
  </entries>

  <!-- Articles to exercise all 4 Article rules (R6–R9), OCL16,19,27 -->

  <!-- A1: unique title, unique journal (R6 Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Article One Unique" year="2001" journal="Journal A">
    <authors author="Neil A1"/>
  </entries>

  <!-- A2 & A3: same title, same journal (R6 + R9) -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Duplicate Title Journal X" year="2002" journal="Journal X">
    <authors author="Olivia A2"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art3" title="Duplicate Title Journal X" year="2003" journal="Journal X">
    <authors author="Peter A3"/>
  </entries>

  <!-- A4 & A5: same title, different journals (R6 + R7) -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Same Title Diff Journals" year="2004" journal="Journal Y">
    <authors author="Quinn A4"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art5" title="Same Title Diff Journals" year="2005" journal="Journal Z">
    <authors author="Rachel A5"/>
  </entries>

  <!-- A6 & A7: different titles, same journal (R6 + R8) -->
  <entries xsi:type="BibTeX:Article" id="art6" title="Title Alpha Same Journal" year="2006" journal="Journal Common">
    <authors author="Steve A6"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art7" title="Title Beta Same Journal" year="2007" journal="Journal Common">
    <authors author="Trudy A7"/>
  </entries>

</BibTeX:BibTeXFile>