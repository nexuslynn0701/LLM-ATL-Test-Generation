<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (R3: Misc, Booklet) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2015"/>

  <!-- Unpublished entries (R4 / R5; one unique title, one duplicate title) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Unpublished Work A" note="Note A">
    <authors author="Alice Unique"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Shared Title 1" note="Note B">
    <authors author="Bob Shared"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unpub3" title="Shared Title 1" note="Note C">
    <authors author="Carol Shared"/>
  </entries>

  <!-- Manual entries (R4 / R5; one unique title, one duplicate title) -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="Manual Title 1"/>
  <entries xsi:type="BibTeX:Manual" id="manual2" title="Shared Title 2"/>

  <!-- TechReport entries (R4 / R5; one unique title, one duplicate title) -->
  <entries xsi:type="BibTeX:TechReport" id="techrep1" title="TechReport A" year="2019">
    <authors author="Dave Report"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="techrep2" title="Shared Title 2" year="2020">
    <authors author="Eve Report"/>
  </entries>

  <!-- MasterThesis entries (R4 only – master constraints commented in OCL) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" title="Master Thesis 1" year="2017" school="Tech University">
    <authors author="Frank Master"/>
  </entries>
  <entries xsi:type="BibTeX:MasterThesis" id="mst2" title="Master Thesis 2" year="2018" school="Science Institute">
    <authors author="Grace Master"/>
  </entries>

  <!-- PhDThesis entries (R4) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="PhD Thesis Unique" year="2014" school="Research Lab X">
    <authors author="Henry PhD"/>
  </entries>

  <!-- Book entries (R4 / R5; one unique title, one duplicate title) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Book Title 1" year="2010" publisher="PubHouse A">
    <authors author="Ivy Author"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book2" title="Shared Title 3" year="2011" publisher="PubHouse B">
    <authors author="Jack Author"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="book3" title="Shared Title 3" year="2012" publisher="PubHouse C">
    <authors author="Karen Author"/>
  </entries>

  <!-- InBook entries (R4 / R5; one unique title, one duplicate title) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="InBook Unique" year="2013" publisher="InPub A" chapter="1">
    <authors author="Liam InBook"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="inbook2" title="Shared Title 4" year="2014" publisher="InPub B" chapter="2">
    <authors author="Mia InBook"/>
  </entries>
  <entries xsi:type="BibTeX:InBook" id="inbook3" title="Shared Title 4" year="2015" publisher="InPub C" chapter="3">
    <authors author="Noah InBook"/>
  </entries>

  <!-- InCollection entries (R4 / R5; one unique title, one duplicate title) -->
  <entries xsi:type="BibTeX:InCollection" id="incol1" title="InCollection Unique" year="2016" publisher="CollPub A" booktitle="Collection A">
    <authors author="Olivia InCollection"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="incol2" title="Shared Title 5" year="2017" publisher="CollPub B" booktitle="Collection B">
    <authors author="Peter InCollection"/>
  </entries>
  <entries xsi:type="BibTeX:InCollection" id="incol3" title="Shared Title 5" year="2018" publisher="CollPub C" booktitle="Collection C">
    <authors author="Quinn InCollection"/>
  </entries>

  <!-- Proceedings entries (R4 / R5; one unique title, one duplicate title) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proceedings Unique" year="2011"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc2" title="Shared Title 6" year="2012"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc3" title="Shared Title 6" year="2013"/>

  <!-- InProceedings entries (R4 / R5; one unique title, one duplicate title) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="InProc Unique" year="2019" booktitle="Conf A">
    <authors author="Rachel InProc"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" title="Shared Title 7" year="2020" booktitle="Conf B">
    <authors author="Sam InProc"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="inproc3" title="Shared Title 7" year="2021" booktitle="Conf C">
    <authors author="Tina InProc"/>
  </entries>

  <!-- Article entries to cover all four article rules (R6–R9) -->

  <!-- R6: unique title, unique journal -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Article Unique 1" year="2001" journal="Journal A">
    <authors author="Uma Article"/>
  </entries>

  <!-- R7: duplicate title, unique journal -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Article Shared Title 1" year="2002" journal="Journal B">
    <authors author="Victor Article"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art3" title="Article Shared Title 1" year="2003" journal="Journal C">
    <authors author="Wendy Article"/>
  </entries>

  <!-- R8: unique title, duplicate journal -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Article Unique 2" year="2004" journal="Journal Shared 1">
    <authors author="Xavier Article"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art5" title="Article Unique 3" year="2005" journal="Journal Shared 1">
    <authors author="Yara Article"/>
  </entries>

  <!-- R9: duplicate title, duplicate journal -->
  <entries xsi:type="BibTeX:Article" id="art6" title="Article Shared Title 2" year="2006" journal="Journal Shared 2">
    <authors author="Zane Article"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art7" title="Article Shared Title 2" year="2007" journal="Journal Shared 2">
    <authors author="Ana Article"/>
  </entries>

</BibTeX:BibTeXFile>