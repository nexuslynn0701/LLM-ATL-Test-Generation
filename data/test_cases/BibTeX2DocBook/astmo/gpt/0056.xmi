<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger R3 (UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="2001"/>

  <!-- Unpublished to trigger R4 (TitledEntry_Title_NoArticle) and OCL6 -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Early Draft" note="preliminary version">
    <authors author="Alice Unique"/>
  </entries>

  <!-- MasterThesis with unique title to trigger R4 and OCL7-like behaviour -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Mastering Models" year="2010" school="Tech University">
    <authors author="Charlie Graduate"/>
  </entries>

  <!-- PhDThesis with unique title to trigger R4 and OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Advanced Transformations" year="2015" school="Science Institute">
    <authors author="Dave Doctor"/>
  </entries>

  <!-- Book with unique title to trigger R4 and OCL9 -->
  <entries xsi:type="BibTeX:Book" id="BK1" title="Model Engineering Handbook" year="2012" publisher="ModelPub">
    <authors author="Alice Unique"/>
  </entries>

  <!-- InBook with unique title to trigger R4 and OCL10 -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chapter on Testing" year="2013" publisher="ModelPub" chapter="3">
    <authors author="Bob Common"/>
  </entries>

  <!-- Manual with unique title to trigger R4 and OCL12 -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="Tool User Guide"/>

  <!-- Proceedings with unique title to trigger R4 and OCL13 (base type only) -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" title="MDE Conference" year="2018"/>

  <!-- InProceedings with unique title to trigger R4 and OCL14 -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Testing Transformations" year="2019" booktitle="MDE Conference">
    <authors author="Bob Common"/>
    <authors author="Eve Expert"/>
  </entries>

  <!-- InCollection with unique title to trigger R4 and OCL15 -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Chapter in Collection" year="2016" publisher="CollectionsPress" booktitle="Collected Papers">
    <authors author="Frank Author"/>
  </entries>

  <!-- TechReport with unique title to trigger R4 and OCL11 -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Transformation Report" year="2011">
    <authors author="Grace Researcher"/>
  </entries>

  <!-- Article with unique title and journal to trigger R6 and OCL16,19 -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Model Testing Approaches" year="2020" journal="Journal of MDE">
    <authors author="Alice Unique"/>
    <authors author="Bob Common"/>
  </entries>

  <!-- Second Article with different title and journal to also trigger R6 -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Traceability in Transformations" year="2021" journal="Software Engineering Journal">
    <authors author="Helen Scientist"/>
  </entries>

</BibTeX:BibTeXFile>