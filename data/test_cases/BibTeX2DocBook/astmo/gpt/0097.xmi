<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry (Booklet) -->
  <entries xsi:type="BibTeX:Booklet" id="b1" year="2019"/>

  <!-- Misc entry (also untitled, exercises UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>

  <!-- Manual (titled, no authors, exercises TitledEntry_* rules) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="DocBook User Manual"/>

  <!-- Proceedings (base type: titled, dated; no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="MDE Conference 2023" year="2023"/>

  <!-- InProceedings (child of Proceedings, titled, authored, dated, booktitled) -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Model Transformation Testing" year="2023" booktitle="MDE Conference 2023">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Book (titled, authored, dated, publisher) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Advanced MDE" year="2020" publisher="TechPress">
    <authors author="Alice Smith"/>
    <authors author="Carol White"/>
  </entries>

  <!-- InBook (child of Book, titled, authored, dated, publisher, chapter) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Chapter on ATL" year="2021" publisher="TechPress" chapter="5">
    <authors author="Dave Brown"/>
  </entries>

  <!-- InCollection (child of Book, titled, authored, dated, booktitled, publisher) -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Reusable Transformations" year="2022" booktitle="Advanced MDE" publisher="TechPress">
    <authors author="Eve Black"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- MasterThesis (titled, authored, dated, school) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Testing MDE Tools" year="2018" school="University of Example">
    <authors author="Carol White"/>
  </entries>

  <!-- PhDThesis (titled, authored, dated, school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Scalable Model Transformations" year="2017" school="Institute of Computing">
    <authors author="Frank Green"/>
  </entries>

  <!-- TechReport (titled, authored, dated) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="ATL Optimization Techniques" year="2016">
    <authors author="Alice Smith"/>
    <authors author="Dave Brown"/>
  </entries>

  <!-- Unpublished (titled, authored, note) -->
  <entries xsi:type="BibTeX:Unpublished" id="up1" title="Draft on Transformation Patterns" note="Under review">
    <authors author="Eve Black"/>
  </entries>

  <!-- Article with unique title and unique journal (triggers Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="a1" title="ATL in Practice" year="2015" journal="Journal of MDE">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article sharing title but different journal (triggers Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="a2" title="ATL in Practice" year="2016" journal="Software Engineering Letters">
    <authors author="Carol White"/>
  </entries>

  <!-- Article sharing journal but different title (triggers Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="a3" title="Evaluating ATL Transformations" year="2017" journal="Journal of MDE">
    <authors author="Dave Brown"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- Article sharing both title and journal (triggers Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="a4" title="Reusable Transformations" year="2018" journal="Software Engineering Letters">
    <authors author="Eve Black"/>
  </entries>

</BibTeX:BibTeXFile>