<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger R3 (UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2018"/>

  <!-- Manual (TitledEntry, no authors, no date) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="MDE User Guide"/>

  <!-- TechReport (Authored, Dated, Titled) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="ATL Testing Framework" year="2020">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Unpublished (Authored, Titled, with note) -->
  <entries xsi:type="BibTeX:Unpublished" id="unp1" title="Draft on Model Transformations" note="To appear">
    <authors author="Carol White"/>
  </entries>

  <!-- MasterThesis (ThesisEntry, Authored, Dated, Titled, School) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Testing Model Transformations" year="2019" school="Tech University">
    <authors author="David Green"/>
  </entries>

  <!-- PhDThesis (ThesisEntry, Authored, Dated, Titled, School) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced ATL Analysis" year="2017" school="Science University">
    <authors author="Emma Brown"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book (Authored, Dated, Titled, Publisher) -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="Model-Driven Engineering Intro" year="2015" publisher="Springer">
    <authors author="Frank Black"/>
  </entries>

  <!-- InBook (subclass of Book, adds chapter) -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Chapter on ATL" year="2016" publisher="Springer" chapter="3">
    <authors author="Frank Black"/>
    <authors author="Carol White"/>
  </entries>

  <!-- Proceedings (Dated, Titled) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="ICMT Proceedings" year="2014"/>

  <!-- InProceedings (Proceedings + Authored + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Testing ATL Transformations" year="2014" booktitle="ICMT Proceedings">
    <authors author="George King"/>
    <authors author="Helen Lee"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Verification of MDE Tools" year="2013" publisher="Elsevier" booktitle="Software Engineering Advances">
    <authors author="Ian Gray"/>
    <authors author="David Green"/>
  </entries>

  <!-- Article 1: unique title, unique journal (R6) -->
  <entries xsi:type="BibTeX:Article" id="art1" title="A Survey on ATL" year="2012" journal="Journal of MDE">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article 2: same title as art3 but unique journal (R8) -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Case Studies in ATL" year="2011" journal="Software Practice">
    <authors author="Carol White"/>
  </entries>

  <!-- Article 3: same title as art2, unique journal (R7) -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Case Studies in ATL" year="2010" journal="Empirical SE Journal">
    <authors author="David Green"/>
    <authors author="Emma Brown"/>
  </entries>

  <!-- Article 4: unique title, journal J2 used again by art5 (R8) -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Transformations in Practice" year="2013" journal="MDE Letters">
    <authors author="Frank Black"/>
  </entries>

  <!-- Article 5: different title, same journal as art4 (R9) -->
  <entries xsi:type="BibTeX:Article" id="art5" title="Patterns for Model Transformations" year="2014" journal="MDE Letters">
    <authors author="George King"/>
  </entries>

</BibTeX:BibTeXFile>