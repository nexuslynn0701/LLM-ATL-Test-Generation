<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry (triggers R3: UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2005"/>

  <!-- Manual (titled, no authors, no date) -->
  <!-- Triggers R4: TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="User Guide"/>

  <!-- Unpublished; 2 authors, no year; unique title -->
  <!-- Triggers R4 -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Early Draft" note="To appear">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- TechReport; 1 author; unique title -->
  <!-- Triggers R4 -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="TR on Testing" year="2018">
    <authors author="Charlie Researcher"/>
  </entries>

  <!-- MasterThesis; 1 author; unique title -->
  <!-- Triggers R4 -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="MDE in Practice" year="2017" school="Uni A">
    <authors author="Dana Student"/>
  </entries>

  <!-- PhDThesis; 1 author; unique title -->
  <!-- Triggers R4 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced MDE" year="2016" school="Uni B">
    <authors author="Evan Doctor"/>
  </entries>

  <!-- Book; 2 authors; unique title -->
  <!-- Triggers R4 -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Model Engineering Book" year="2014" publisher="TechPress">
    <authors author="Alice Author"/>
    <authors author="Frank Writer"/>
  </entries>

  <!-- InBook; 1 author; unique title -->
  <!-- Triggers R4 -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Chapter on MDE" year="2014" publisher="TechPress" chapter="3">
    <authors author="George Scholar"/>
  </entries>

  <!-- InCollection; 2 authors; unique title -->
  <!-- Triggers R4 -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Collected MDE Studies" year="2019" publisher="CollPub" booktitle="MDE Collection">
    <authors author="Helen Researcher"/>
    <authors author="Ian Engineer"/>
  </entries>

  <!-- Proceedings; unique title -->
  <!-- Triggers R4 -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="MDE Conference 2020" year="2020"/>

  <!-- InProceedings; 2 authors; unique title/journal (booktitle) -->
  <!-- Triggers R4 -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Paper on MDE" year="2020" booktitle="MDE Conference 2020">
    <authors author="Jane Scientist"/>
    <authors author="Karl Developer"/>
  </entries>

  <!-- Articles with shared title but distinct journals -->
  <!-- art1: unique journal, title duplicated later -> Article_Title_Journal (R6) -->
  <entries xsi:type="BibTeX:Article" id="art1" title="MDE Overview" year="2015" journal="Journal A">
    <authors author="Alice Author"/>
    <authors author="Leo Analyst"/>
  </entries>

  <!-- art2: same title as art1, unique journal -> Article_NoTitle_Journal (R7) -->
  <entries xsi:type="BibTeX:Article" id="art2" title="MDE Overview" year="2016" journal="Journal B">
    <authors author="Bob Writer"/>
  </entries>

  <!-- Articles with shared journal but distinct titles -->
  <!-- art3: unique title, journal duplicated later -> Article_Title_NoJournal (R8) -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Testing Transformations" year="2017" journal="Shared Journal">
    <authors author="Charlie Researcher"/>
  </entries>

  <!-- art4: title duplicated later and journal duplicated -> Article_NoTitle_NoJournal (R9) -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Repeated Study" year="2018" journal="Shared Journal">
    <authors author="Dana Student"/>
  </entries>

  <!-- art5: same title as art4, different journal -> causes art4 title to be non-unique -->
  <!-- With shared journal from art3/art4 & shared title with art4 -> also satisfies Article_NoTitle_NoJournal conditions -->
  <entries xsi:type="BibTeX:Article" id="art5" title="Repeated Study" year="2019" journal="Shared Journal">
    <authors author="Evan Doctor"/>
  </entries>

  <!-- Misc entry (also untitled, covered by R3) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
</BibTeX:BibTeXFile>