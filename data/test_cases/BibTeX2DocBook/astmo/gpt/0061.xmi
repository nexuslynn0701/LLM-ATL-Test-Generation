<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger R3 (UntitledEntry): Booklet -->
  <entries xsi:type="BibTeX:Booklet" id="bklt1" year="2001"/>

  <!-- Misc also triggers R3 (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Manual (TitledEntry, no authors, no year) triggers R4 -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="M Title"/>

  <!-- Manual with duplicate title to trigger R5 (NoTitle case) -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="M Title"/>

  <!-- TechReport single title to trigger R4 -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="TR Title" year="2010">
    <authors author="Alice"/>
  </entries>

  <!-- TechReport with duplicate title to trigger R5 -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="TR Title" year="2011">
    <authors author="Bob"/>
  </entries>

  <!-- Book with unique title to trigger R4 -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Unique Book" year="2005" publisher="PubA">
    <authors author="Carol"/>
    <authors author="Dan"/>
  </entries>

  <!-- InBook with duplicate title with itself (same title, different id) to exercise title set behavior:
       first in title-set -> R4, second -> R5 -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Shared Chapter" year="2006" publisher="PubA" chapter="1">
    <authors author="Eve"/>
  </entries>

  <entries xsi:type="BibTeX:InBook" id="inbook2" title="Shared Chapter" year="2007" publisher="PubB" chapter="2">
    <authors author="Frank"/>
  </entries>

  <!-- Proceedings, no children, unique title -> R4 -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conf A" year="2015"/>

  <!-- InProceedings with unique title and booktitle -> R4 -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Paper One" year="2015" booktitle="Conf A">
    <authors author="Alice"/>
    <authors author="Gary"/>
  </entries>

  <!-- InProceedings sharing title with previous InProceedings to trigger R5 for second one -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" title="Paper One" year="2016" booktitle="Conf B">
    <authors author="Helen"/>
  </entries>

  <!-- InCollection unique title -> R4 -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Chapter IC" year="2012" publisher="PubC" booktitle="Book IC">
    <authors author="Ian"/>
  </entries>

  <!-- PhDThesis unique title -> R4 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="PhD Thesis Title" year="2013" school="UniX">
    <authors author="Jack"/>
  </entries>

  <!-- Another PhDThesis with same title to trigger R5 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd2" title="PhD Thesis Title" year="2014" school="UniY">
    <authors author="Kate"/>
  </entries>

  <!-- Unpublished unique title -> R4 -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Working Draft" note="To appear">
    <authors author="Liam"/>
  </entries>

  <!-- Unpublished duplicate title -> R5 -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Working Draft" note="Superseded">
    <authors author="Mia"/>
  </entries>

  <!-- TechReport with unique different title to still be in title-set (R4) -->
  <entries xsi:type="BibTeX:TechReport" id="tr3" title="Another TR" year="2012">
    <authors author="Nina"/>
  </entries>

  <!-- Articles to cover R6, R7, R8, R9 -->

  <!-- Article A1: unique title and unique journal -> R6 -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Art One" year="2020" journal="J1">
    <authors author="Alice"/>
    <authors author="Oscar"/>
  </entries>

  <!-- Article A2: same title as art1, different journal -> title duplicate, journal unique -> R7 -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Art One" year="2021" journal="J2">
    <authors author="Peter"/>
  </entries>

  <!-- Article A3: different title, journal J3 appears twice (with art4) -> title unique, journal duplicate -> R8 -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Art Three" year="2022" journal="J3">
    <authors author="Quinn"/>
  </entries>

  <!-- Article A4: same title as art3 and same journal J3 -> both title and journal duplicate -> R9 -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Art Three" year="2023" journal="J3">
    <authors author="Rachel"/>
  </entries>

</BibTeX:BibTeXFile>