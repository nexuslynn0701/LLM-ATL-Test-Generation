<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Booklet (UntitledEntry, DatedEntry only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="B1"
           year="2001"/>

  <!-- Misc (UntitledEntry, no extra fields) -->
  <entries xsi:type="BibTeX:Misc"
           id="M1"/>

  <!-- Manual (TitledEntry only, no authors/year) -->
  <entries xsi:type="BibTeX:Manual"
           id="MAN1"
           title="Manual Title A"/>

  <!-- Unpublished (AuthoredEntry + TitledEntry, no year) -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Unpublished Work X"
           note="To appear">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- MasterThesis (ThesisEntry = Authored + Dated + Titled) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="Thesis Title 1"
           year="2010"
           school="Uni A">
    <authors author="Charlie Gamma"/>
  </entries>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Thesis Title 2"
           year="2012"
           school="Uni B">
    <authors author="Alice Alpha"/>
  </entries>

  <!-- Book (Authored + Dated + Titled) -->
  <entries xsi:type="BibTeX:Book"
           id="BK1"
           title="Book Title Unique"
           year="2005"
           publisher="PubHouse1">
    <authors author="Bob Beta"/>
    <authors author="Dana Delta"/>
  </entries>

  <!-- InBook (Book + extra chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="InBook Title"
           year="2006"
           publisher="PubHouse2"
           chapter="7">
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- Proceedings (Dated + Titled, base type) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="PR1"
           title="Proc Title Unique"
           year="2015"/>

  <!-- InProceedings (Proceedings + Authored + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="InProc Unique Title"
           year="2015"
           booktitle="Proc Title Unique">
    <authors author="Frank Phi"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="InCollection Title"
           year="2007"
           publisher="PubHouse3"
           booktitle="Collection Book Title">
    <authors author="Grace Gamma"/>
  </entries>

  <!-- Article A1: triggers Article_Title_Journal (unique title & journal) -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Article Title A"
           year="2020"
           journal="Journal Alpha">
    <authors author="Harry Eta"/>
    <authors author="Alice Alpha"/>
  </entries>

  <!-- Article A2: same title as A1, different journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Article Title A"
           year="2021"
           journal="Journal Beta">
    <authors author="Bob Beta"/>
  </entries>

  <!-- Article A3: different title, same journal as A2 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Article Title B"
           year="2022"
           journal="Journal Beta">
    <authors author="Charlie Gamma"/>
  </entries>

</BibTeX:BibTeXFile>