<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry (triggers R3 UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="bklet1" year="2001"/>

  <!-- Misc also untitled (R3 UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Unpublished (R4 TitledEntry_Title_NoArticle; also TitledEntry, AuthoredEntry) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Shared Title X" note="Preprint note">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- Manual (R4 TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="DocBook Manual"/>

  <!-- TechReport (R4 TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport" id="tech1" title="Tech Report Alpha" year="2010">
    <authors author="Alice Author"/>
  </entries>

  <!-- Proceedings (base type only, no children) (R4 TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conf A Proceedings" year="2015"/>

  <!-- MasterThesis (ThesisEntry) (R4 TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" title="Mastering MDE" year="2012" school="Uni A">
    <authors author="Charlie Student"/>
  </entries>

  <!-- PhDThesis (ThesisEntry) (R4 TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Transformations" year="2018" school="Uni B">
    <authors author="Dana Researcher"/>
  </entries>

  <!-- Book (base Book, not subtype) (R4 TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Model Engineering 101" year="2005" publisher="Springer">
    <authors author="Bob Writer"/>
  </entries>

  <!-- InBook (Book subclass) (R4 TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Chapter on ATL" year="2006" publisher="Springer" chapter="3">
    <authors author="Alice Author"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) (R4 TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="MDE in Practice" year="2007" publisher="Elsevier" booktitle="Collected MDE Papers">
    <authors author="Evan Engineer"/>
  </entries>

  <!-- InProceedings (Proceedings + AuthoredEntry + BookTitledEntry) (R4 TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Transformation Testing" year="2016" booktitle="Conf A Proceedings">
    <authors author="Dana Researcher"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- Article with unique title and unique journal (R6 Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Unique Article" year="2020" journal="Journal Unique">
    <authors author="Alice Author"/>
    <authors author="Charlie Student"/>
  </entries>

  <!-- Article sharing title with Unpublished (R8 Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Shared Title X" year="2019" journal="Journal Alpha">
    <authors author="Bob Writer"/>
  </entries>

  <!-- Article sharing journal with art2 (R8 Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Different Title Y" year="2021" journal="Journal Alpha">
    <authors author="Evan Engineer"/>
  </entries>

  <!-- Article sharing title with art3 AND journal with art2 & art3 (duplicate title & journal) (R9 Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Different Title Y" year="2022" journal="Journal Alpha">
    <authors author="Frank Researcher"/>
  </entries>

</BibTeX:BibTeXFile>