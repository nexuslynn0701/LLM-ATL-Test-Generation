<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc (untitled, non-authored, non-dated) -->
  <entries xsi:type="BibTeX:Misc" id="miscA"/>

  <!-- Booklet (untitled, dated) -->
  <entries xsi:type="BibTeX:Booklet" id="bookletA" year="2001"/>

  <!-- Manual (titled only) -->
  <entries xsi:type="BibTeX:Manual" id="manualA" title="Manual Alpha"/>

  <!-- TechReport (titled, authored, dated) -->
  <entries xsi:type="BibTeX:TechReport" id="trA" title="Report Alpha" year="2002">
    <authors author="Alice Brown"/>
    <authors author="Bob Clark"/>
  </entries>

  <!-- Unpublished (titled, authored, note) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpubA" title="Draft Gamma" note="Draft note">
    <authors author="Alice Brown"/>
  </entries>

  <!-- Proceedings (titled, dated) -->
  <entries xsi:type="BibTeX:Proceedings" id="procA" title="Proc Alpha" year="2010"/>

  <!-- MasterThesis (titled, authored, dated, school) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mtA" title="Thesis Alpha" year="2011" school="Tech University">
    <authors author="Carol Davis"/>
  </entries>

  <!-- PhDThesis (titled, authored, dated, school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phdA" title="Thesis Beta" year="2012" school="Science Institute">
    <authors author="David Evans"/>
  </entries>

  <!-- Book (titled, authored, dated, publisher) -->
  <entries xsi:type="BibTeX:Book" id="bookA" title="Book Alpha" year="2013" publisher="Publisher One">
    <authors author="Alice Brown"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- InBook (Book child, unique title, authored, dated, publisher, chapter) -->
  <entries xsi:type="BibTeX:InBook" id="inbookA" title="Chapter Alpha" year="2014" publisher="Publisher One" chapter="1">
    <authors author="Helen King"/>
  </entries>

  <!-- InCollection (Book child, unique title, authored, dated, booktitle, publisher) -->
  <entries xsi:type="BibTeX:InCollection" id="incollA" title="Collection Alpha" year="2015" booktitle="Book Alpha" publisher="Publisher One">
    <authors author="Ian Lewis"/>
  </entries>

  <!-- InProceedings 1 (titled, authored, dated, booktitle, Proceedings child) -->
  <entries xsi:type="BibTeX:InProceedings" id="inprocA" title="Paper Alpha" year="2016" booktitle="Proc Alpha">
    <authors author="Carol Davis"/>
  </entries>

  <!-- InProceedings 2 with same title, different year -> triggers NoTitle rule -->
  <entries xsi:type="BibTeX:InProceedings" id="inprocB" title="Paper Alpha" year="2017" booktitle="Proc Alpha">
    <authors author="David Evans"/>
  </entries>

  <!-- Article 1: unique title and journal (triggers Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="artA" title="Article Alpha" year="2020" journal="Journal One">
    <authors author="Frank Green"/>
    <authors author="Ian Lewis"/>
  </entries>

  <!-- Article 2: same journal as artA, different title (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="artB" title="Article Beta" year="2021" journal="Journal One">
    <authors author="Alice Brown"/>
  </entries>

  <!-- Article 3: same title as artB, unique journal (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="artC" title="Article Beta" year="2022" journal="Journal Two">
    <authors author="Bob Clark"/>
  </entries>

  <!-- Article 4: same title and journal as artC (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="artD" title="Article Beta" year="2023" journal="Journal Two">
    <authors author="Helen King"/>
  </entries>

</BibTeX:BibTeXFile>