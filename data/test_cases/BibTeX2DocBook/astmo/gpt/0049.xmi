<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (Misc, Booklet) -> R3 -->
  <entries xsi:type="BibTeX:Misc" id="miscA"/>
  <entries xsi:type="BibTeX:Booklet" id="bookletA" year="2012"/>

  <!-- Unpublished with unique title -> R4 -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Shared Title One" note="To appear soon">
    <authors author="Alice Alpha"/>
  </entries>

  <!-- Unpublished sharing title with above -> R5 -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Shared Title One" note="Preliminary version">
    <authors author="Bob Beta"/>
    <authors author="Alice Alpha"/>
  </entries>

  <!-- Manual with unique title -> R4 -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="DocBook Manual Reference"/>

  <!-- TechReport with unique title -> R4 -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Technical Report X" year="2015">
    <authors author="Charlie Gamma"/>
  </entries>

  <!-- Proceedings (base type) with duplicate title group -> R4 (first), R5 (second) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="ConfProc A" year="2018"/>
  <entries xsi:type="BibTeX:Proceedings" id="proc2" title="ConfProc A" year="2019"/>

  <!-- InProceedings with unique title and unique journal-like booktitle -> R4 -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Unique InProc Paper" year="2020" booktitle="Proceedings of MDE 2020">
    <authors author="Diana Delta"/>
    <authors author="Evan Epsilon"/>
  </entries>

  <!-- Book base type with unique title -> R4 -->
  <entries xsi:type="BibTeX:Book" id="book1" title="MDE Foundations" year="2010" publisher="Springer">
    <authors author="Frank Phi"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- InBook (child of Book) with unique title and chapter -> R4 -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Chapter on ATL" year="2011" publisher="ACM Press" chapter="7">
    <authors author="Alice Alpha"/>
  </entries>

  <!-- InCollection with unique title -> R4 -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Model Transformations Survey" year="2013" publisher="Elsevier" booktitle="Handbook of Software Engineering">
    <authors author="Charlie Gamma"/>
    <authors author="Ivy Iota"/>
  </entries>

  <!-- MasterThesis with unique title -> R4 -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Model-Driven Testing MSc" year="2014" school="Uni Beta">
    <authors author="George Giga"/>
  </entries>

  <!-- PhDThesis group to exercise both R4 and R5 (duplicate title) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Model-Driven Engineering PhD" year="2016" school="Uni Alpha">
    <authors author="Henry Hecto"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd2" title="Model-Driven Engineering PhD" year="2017" school="Uni Alpha">
    <authors author="Henry Hecto"/>
    <authors author="Diana Delta"/>
  </entries>

  <!-- Articles to cover all four article rules R6–R9 -->

  <!-- A1 & A2: same journal "Journal A", distinct titles -> both R8 -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Article Title A1" year="2009" journal="Journal A">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art2" title="Article Title A2" year="2010" journal="Journal A">
    <authors author="Charlie Gamma"/>
  </entries>

  <!-- A3: unique title, unique journal -> R6 -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Solo Article B" year="2011" journal="Journal B">
    <authors author="Diana Delta"/>
  </entries>

  <!-- A4 & A5: same title and same journal -> R9 for A4, R8 for A5 -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Duplicated Title C" year="2012" journal="Journal C">
    <authors author="Evan Epsilon"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art5" title="Duplicated Title C" year="2013" journal="Journal C">
    <authors author="Frank Phi"/>
    <authors author="George Giga"/>
  </entries>

  <!-- A6 & A7: same title, different journals -> R7 and R6 -->
  <entries xsi:type="BibTeX:Article" id="art6" title="Shared Article D" year="2014" journal="Journal D1">
    <authors author="Henry Hecto"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art7" title="Shared Article D" year="2015" journal="Journal D2">
    <authors author="Ivy Iota"/>
  </entries>

</BibTeX:BibTeXFile>