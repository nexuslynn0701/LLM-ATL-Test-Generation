<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc: untitled, non-authored, non-dated (R3 only) -->
  <entries xsi:type="BibTeX:Misc" id="e01"/>

  <!-- Booklet: dated but untitled/authored (R3) -->
  <entries xsi:type="BibTeX:Booklet" id="e02" year="2001"/>

  <!-- Manual: titled only (R4 + title set) -->
  <entries xsi:type="BibTeX:Manual" id="e03" title="Manual of Testing"/>

  <!-- TechReport: titled + authored + dated (R4, Authors) -->
  <entries xsi:type="BibTeX:TechReport" id="e04" title="Model Checking Basics" year="2005">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Book: titled + authored + dated + publisher (R4, Authors) -->
  <entries xsi:type="BibTeX:Book" id="e05" title="Advanced MDE" year="2010" publisher="Springer">
    <authors author="Carol White"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- InBook pair with same title: one will be in title set (R4), other not (R5) -->
  <entries xsi:type="BibTeX:InBook" id="e06" title="Chapter on Transformations" year="2012" publisher="TechPress" chapter="1">
    <authors author="David Brown"/>
  </entries>

  <entries xsi:type="BibTeX:InBook" id="e07" title="Chapter on Transformations" year="2013" publisher="TechPress" chapter="2">
    <authors author="Eve Black"/>
  </entries>

  <!-- Proceedings pair with same title: one in title set (R4), other not (R5) -->
  <entries xsi:type="BibTeX:Proceedings" id="e08" title="ICMT Proceedings" year="2015"/>
  <entries xsi:type="BibTeX:Proceedings" id="e09" title="ICMT Proceedings" year="2016"/>

  <!-- InCollection: title, authors, year, booktitle, publisher (R4, Authors) -->
  <entries xsi:type="BibTeX:InCollection" id="e10" title="Transformations in Practice" year="2014" publisher="Elsevier">
    <authors author="Frank Green"/>
  </entries>

  <!-- InProceedings pair with same title: one in title set (R4), other not (R5) -->
  <entries xsi:type="BibTeX:InProceedings" id="e11" title="Testing ATL" year="2017" booktitle="MTiP">
    <authors author="Gina Gray"/>
    <authors author="Bob Johnson"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings" id="e12" title="Testing ATL" year="2018" booktitle="ICMT">
    <authors author="Helen King"/>
  </entries>

  <!-- MasterThesis: not required by OCL but exercises R4 -->
  <entries xsi:type="BibTeX:MasterThesis" id="e13" title="MDE in Industry" year="2011" school="Univ. of Example">
    <authors author="Ian Lee"/>
  </entries>

  <!-- PhDThesis: required by OCL8 (R4, Authors) -->
  <entries xsi:type="BibTeX:PhDThesis" id="e14" title="Scalable Model Transformations" year="2019" school="Tech University">
    <authors author="Jane Doe"/>
  </entries>

  <!-- Articles in distinct journals and titles (R6, Authors) -->
  <entries xsi:type="BibTeX:Article" id="e15" title="ATL in Practice" year="2020" journal="Software &amp; Systems">
    <authors author="Alice Smith"/>
    <authors author="Jane Doe"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="e16" title="Model Transformation Testing" year="2021" journal="Journal of MDE">
    <authors author="Kevin Clark"/>
  </entries>

  <!-- Two articles with same title, different journals (one R6, one R7) -->
  <entries xsi:type="BibTeX:Article" id="e17" title="Duplicate Title Article" year="2022" journal="First Journal">
    <authors author="Laura Hill"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="e18" title="Duplicate Title Article" year="2023" journal="Second Journal">
    <authors author="Mike Stone"/>
  </entries>

  <!-- Two articles with same journal, different titles (one R6, one R8) -->
  <entries xsi:type="BibTeX:Article" id="e19" title="Shared Journal A" year="2020" journal="Shared Journal">
    <authors author="Nina Rose"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="e20" title="Shared Journal B" year="2021" journal="Shared Journal">
    <authors author="Oscar Young"/>
  </entries>

</BibTeX:BibTeXFile>