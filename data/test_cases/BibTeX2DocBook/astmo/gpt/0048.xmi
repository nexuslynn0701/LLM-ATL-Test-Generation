<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (trigger R3 UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Booklet" id="bkt1" year="2010"/>

  <!-- Manual (titled, no authors/date) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="User Guide"/>

  <!-- Proceedings (titled & dated, no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conf A Proceedings" year="2012"/>

  <!-- InProceedings (authored, dated, booktitled, titled) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Talk A" year="2013" booktitle="Conf A Proceedings">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book (authored, dated, titled, publisher) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="MDE Basics" year="2015" publisher="TechPress">
    <authors author="Bob Johnson"/>
    <authors author="Carol White"/>
  </entries>

  <!-- InCollection (inherits Book + BookTitledEntry, uses new title to avoid duplicates) -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Chapter on MDE" year="2016" publisher="TechPress" booktitle="Handbook of Software Eng">
    <authors author="Alice Smith"/>
  </entries>

  <!-- InBook (same book as book1, but different id and specific chapter) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Advanced MDE" year="2015" publisher="TechPress" chapter="3">
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport (authored, dated, titled) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="MDE Report" year="2014">
    <authors author="Carol White"/>
  </entries>

  <!-- Unpublished (authored, titled, with note) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft on MDE" note="under review">
    <authors author="Alice Smith"/>
    <authors author="David Green"/>
  </entries>

  <!-- MasterThesis (authored, dated, titled, school) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" title="MDE in Practice" year="2011" school="Uni X">
    <authors author="Eve Black"/>
  </entries>

  <!-- PhDThesis (authored, dated, titled, school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Topics in MDE" year="2018" school="Uni Y">
    <authors author="Frank Brown"/>
  </entries>

  <!-- Articles (authored, dated, titled, journal) -->
  <entries xsi:type="BibTeX:Article" id="art1" title="MDE Overview" year="2017" journal="Journal of MDE">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Second article with same journal but different title (to exercise Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art2" title="MDE Case Studies" year="2019" journal="Journal of MDE">
    <authors author="Carol White"/>
  </entries>

</BibTeX:BibTeXFile>