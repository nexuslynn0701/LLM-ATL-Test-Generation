<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc (untitled, non-dated) -->
  <entries xsi:type="BibTeX:Misc" id="e01"/>

  <!-- Booklet (untitled, dated) -->
  <entries xsi:type="BibTeX:Booklet" id="e02" year="2005"/>

  <!-- Manual (titled only) -->
  <entries xsi:type="BibTeX:Manual" id="e03" title="User Guide for Tool X"/>

  <!-- Proceedings (titled + dated; no children) -->
  <entries xsi:type="BibTeX:Proceedings" id="e04" title="ConfProc 2020" year="2020"/>

  <!-- InProceedings (titled, dated, authored, booktitled) -->
  <entries xsi:type="BibTeX:InProceedings" id="e05" title="InProc Paper A" year="2019" booktitle="ConfProc 2019">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Unpublished (titled + authored + note) -->
  <entries xsi:type="BibTeX:Unpublished" id="e06" title="Draft Result Y" note="to appear">
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport (titled + authored + dated) -->
  <entries xsi:type="BibTeX:TechReport" id="e07" title="Tech Report on Z" year="2018">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book (titled + authored + dated + publisher) -->
  <entries xsi:type="BibTeX:Book" id="e08" title="Advanced MDE" year="2017" publisher="Springer">
    <authors author="Bob Jones"/>
    <authors author="Diana Prince"/>
  </entries>

  <!-- InBook (titled + authored + dated + publisher + chapter) -->
  <entries xsi:type="BibTeX:InBook" id="e09" title="MDE Chapter" year="2017" publisher="Springer" chapter="3">
    <authors author="Alice Smith"/>
  </entries>

  <!-- InCollection (titled + authored + dated + booktitle + publisher) -->
  <entries xsi:type="BibTeX:InCollection" id="e10" title="Collected Work on MDE" year="2016" booktitle="Collected MDE Papers" publisher="IEEE">
    <authors author="Carlos Diaz"/>
    <authors author="Eve Adams"/>
  </entries>

  <!-- MasterThesis (titled + authored + dated + school) -->
  <entries xsi:type="BibTeX:MasterThesis" id="e11" title="MSc on Transformation Testing" year="2015" school="Uni A">
    <authors author="Frank Miller"/>
  </entries>

  <!-- PhDThesis (titled + authored + dated + school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="e12" title="PhD on Transformation Analysis" year="2014" school="Uni B">
    <authors author="Alice Smith"/>
    <authors author="George Clark"/>
  </entries>

  <!-- Article 1 (unique title, unique journal) -->
  <entries xsi:type="BibTeX:Article" id="e13" title="Unique Article Title" year="2013" journal="Journal Alpha">
    <authors author="Henry Johnson"/>
  </entries>

  <!-- Article 2 (duplicate title with Article 3, unique journal) -->
  <entries xsi:type="BibTeX:Article" id="e14" title="Shared Title Article" year="2012" journal="Journal Beta">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article 3 (duplicate title with Article 2, unique journal) -->
  <entries xsi:type="BibTeX:Article" id="e15" title="Shared Title Article" year="2011" journal="Journal Gamma">
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article 4 (duplicate journal with Article 5, unique title) -->
  <entries xsi:type="BibTeX:Article" id="e16" title="Journal Delta Study One" year="2010" journal="Journal Delta">
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- Article 5 (duplicate journal with Article 4, unique title) -->
  <entries xsi:type="BibTeX:Article" id="e17" title="Journal Delta Study Two" year="2009" journal="Journal Delta">
    <authors author="Eve Adams"/>
  </entries>

  <!-- Article 6 (duplicate title and journal with Article 7) -->
  <entries xsi:type="BibTeX:Article" id="e18" title="Twin Article" year="2008" journal="Journal Epsilon">
    <authors author="Frank Miller"/>
  </entries>

  <!-- Article 7 (duplicate title and journal with Article 6) -->
  <entries xsi:type="BibTeX:Article" id="e19" title="Twin Article" year="2007" journal="Journal Epsilon">
    <authors author="George Clark"/>
  </entries>

</BibTeX:BibTeXFile>