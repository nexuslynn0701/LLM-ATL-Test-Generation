<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2019"/>

  <!-- Unpublished (TitledEntry, no date) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Temporal Logics Overview" note="Draft version">
    <authors author="Alice Smith"/>
    <authors author="Bob Brown"/>
  </entries>

  <!-- TechReport (TitledEntry, Dated, Authored) -->
  <entries xsi:type="BibTeX:TechReport" id="tech1" title="Model Checking Report" year="2017">
    <authors author="Carol White"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Manual (TitledEntry only) -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="ATL User Guide"/>

  <!-- Proceedings (Dated + Titled, not child) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="FDL Workshop" year="2016"/>

  <!-- InProceedings (Proceedings + Authored + BookTitled) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="MDE for Embedded Systems" year="2016" booktitle="FDL Workshop">
    <authors author="Dave Green"/>
    <authors author="Bob Brown"/>
  </entries>

  <!-- Book (Titled + Dated + Authored) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Advanced MDE" year="2015" publisher="Springer">
    <authors author="Alice Smith"/>
    <authors author="Eve Black"/>
  </entries>

  <!-- InCollection (Book + BookTitled) -->
  <entries xsi:type="BibTeX:InCollection" id="incol1" title="Chapter on Transformations" year="2015" publisher="Springer" booktitle="Advanced MDE">
    <authors author="Bob Brown"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Case Study: Automotive" year="2015" publisher="Springer" chapter="3">
    <authors author="Carol White"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mthesis1" title="Testing Model Transformations" year="2018" school="Tech University">
    <authors author="Frank Gray"/>
  </entries>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Scalable Model Transformations" year="2020" school="Science University">
    <authors author="Alice Smith"/>
    <authors author="Henry King"/>
  </entries>

  <!-- Articles to exercise different article rules -->

  <!-- Article 1: unique title & unique journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art1" title="MDE Survey" year="2014" journal="Journal of Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Brown"/>
  </entries>

  <!-- Article 2 & 3: same title, different journals -->
  <!-- art2: first occurrence of title "MDE Practice" and first of its journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art2" title="MDE Practice" year="2015" journal="Software Practice Journal">
    <authors author="Carol White"/>
  </entries>

  <!-- art3: same title "MDE Practice", different journal (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="art3" title="MDE Practice" year="2016" journal="Engineering Letters">
    <authors author="Dave Green"/>
  </entries>

  <!-- Article 4 & 5: different titles, same journal -->
  <!-- art4: first with journal "Systems Journal" (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art4" title="System Integration" year="2013" journal="Systems Journal">
    <authors author="Eve Black"/>
  </entries>

  <!-- art5: second with journal "Systems Journal", different title (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art5" title="Formal Methods in Systems" year="2012" journal="Systems Journal">
    <authors author="Frank Gray"/>
  </entries>

</BibTeX:BibTeXFile>