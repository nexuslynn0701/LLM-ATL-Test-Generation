<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger R3 (UntitledEntry: Misc) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>

  <!-- Booklet (untitled entry, dated) to trigger R3 and OCL5 -->
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2010"/>

  <!-- Manual (titled, no authors, no date) to trigger R4 and title-related OCLs -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="User Guide"/>

  <!-- Proceedings (titled & dated; first with this title) to trigger R4 and OCL13 -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conference 2020" year="2020"/>

  <!-- Proceedings with same title as proc1 to trigger R5 (no-title case) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" title="Conference 2020" year="2021"/>

  <!-- TechReport (titled, authored, dated) to trigger R4 and OCL11 -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Tech Report Alpha" year="2015">
    <authors author="Alice Alpha"/>
  </entries>

  <!-- Unpublished (titled, authored, with note) to trigger R4, OCL6 -->
  <entries xsi:type="BibTeX:Unpublished" id="up1" title="Working Draft" note="To appear">
    <authors author="Bob Beta"/>
  </entries>

  <!-- Book (titled, authored, dated, publisher) to trigger R4, OCL9 -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="Big Data Book" year="2018" publisher="DataPress">
    <authors author="Carol Gamma"/>
    <authors author="Dan Delta"/>
  </entries>

  <!-- InBook (child of Book, titled, authored, dated, publisher, chapter) to trigger R4, OCL10 -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Chapter on Streams" year="2019" publisher="DataPress" chapter="3">
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- InCollection (child of Book, titled, authored, dated, booktitle, publisher) to trigger R4, OCL15 -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="MapReduce Revisited" year="2017" booktitle="Advances in Data" publisher="DataPress">
    <authors author="Frank Phi"/>
    <authors author="Grace Gamma"/>
  </entries>

  <!-- InProceedings (child of Proceedings, titled, authored, dated, booktitle) to trigger R4, OCL14 -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Efficient Parsing" year="2016" booktitle="Conf on Parsing">
    <authors author="Helen Eta"/>
  </entries>

  <!-- MasterThesis (ThesisEntry, titled, authored, dated, school) to trigger R4 and (commented) OCL7 -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Mastering Models" year="2014" school="Tech University">
    <authors author="Ian Iota"/>
  </entries>

  <!-- PhDThesis (ThesisEntry, titled, authored, dated, school) to trigger R4 and OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Scalable Transformations" year="2013" school="Science Institute">
    <authors author="Alice Alpha"/>
    <authors author="Jack Kappa"/>
  </entries>

  <!-- Article A1 (unique title & journal) to trigger R6 and OCL16/19 -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Model Checking Basics" year="2011" journal="Journal of Models">
    <authors author="Lee Lambda"/>
    <authors author="Mary Mu"/>
  </entries>

  <!-- Article A2 (same title as A3, unique journal) to trigger R7 (no-title) -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Advanced Modeling" year="2012" journal="Modeling Today">
    <authors author="Nick Nu"/>
  </entries>

  <!-- Article A3 (same title as A2, same journal as A4) to trigger R9 (no-title, no-journal) -->
  <entries xsi:type="BibTeX:Article" id="a3" title="Advanced Modeling" year="2013" journal="International Journal of Engineering">
    <authors author="Olivia Omicron"/>
  </entries>

  <!-- Article A4 (unique title, same journal as A3) to trigger R8 (title, no-journal) -->
  <entries xsi:type="BibTeX:Article" id="a4" title="Engineering Models" year="2014" journal="International Journal of Engineering">
    <authors author="Paul Pi"/>
    <authors author="Queen Q"/>
  </entries>

</BibTeX:BibTeXFile>