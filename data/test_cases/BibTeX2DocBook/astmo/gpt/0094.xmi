<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Misc" id="miscA"/>
  <entries xsi:type="BibTeX:Booklet" id="bookletA" year="2018"/>

  <!-- Articles: configure to hit different article rules and duplicate titles/journals -->
  <!-- a1: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="a1"
           title="Unique Article One"
           year="2020"
           journal="Distinct Journal A">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- a2: shares title with a3 but unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="a2"
           title="Shared Title Alpha"
           year="2021"
           journal="Unique Journal B">
    <authors author="Carol White"/>
  </entries>

  <!-- a3: representative for title 'Shared Title Alpha' and for journal 'Common Journal C'
           -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="a3"
           title="Shared Title Alpha"
           year="2022"
           journal="Common Journal C">
    <authors author="David Brown"/>
    <authors author="Eve Black"/>
  </entries>

  <!-- a4: same journal as a3 but unique title -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="a4"
           title="Another Article Beta"
           year="2023"
           journal="Common Journal C">
    <authors author="Frank Green"/>
  </entries>

  <!-- a5: same title as a6, same journal as a6 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="a5"
           title="Duplicated Gamma"
           year="2019"
           journal="Repeated Journal D">
    <authors author="Helen Gray"/>
  </entries>

  <!-- a6: representative of title & journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="a6"
           title="Duplicated Gamma"
           year="2019"
           journal="Repeated Journal D">
    <authors author="Ian Silver"/>
  </entries>

  <!-- TechReport: unique title for TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr1"
           title="Tech Report Unique"
           year="2017">
    <authors author="John Copper"/>
    <authors author="Karen Gold"/>
  </entries>

  <!-- TechReports with same title: tr2 in distinct-title set, tr3 excluded -> Title_NoTitle pair -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr2"
           title="Repeated Report"
           year="2016">
    <authors author="Laura Stone"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport"
           id="tr3"
           title="Repeated Report"
           year="2015">
    <authors author="Michael Lake"/>
  </entries>

  <!-- Manual: unique title -->
  <entries xsi:type="BibTeX:Manual"
           id="man1"
           title="Manual Reference Guide"/>

  <!-- Proceedings: unique title, dated -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc1"
           title="Conference Proceedings X"
           year="2014"/>

  <!-- Standalone Book (not child type) -->
  <entries xsi:type="BibTeX:Book"
           id="book1"
           title="Fundamentals of MDE"
           year="2013"
           publisher="Publishing House One">
    <authors author="Nina Indigo"/>
    <authors author="Oscar Violet"/>
  </entries>

  <!-- InBook (subclass of Book) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook1"
           title="MDE Chapter Insights"
           year="2013"
           publisher="Publishing House One"
           chapter="5">
    <authors author="Nina Indigo"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incoll1"
           title="Model Transformation Patterns"
           year="2012"
           publisher="Tech Press"
           booktitle="Advances in Software Engineering">
    <authors author="Paul Orange"/>
    <authors author="Queen Crimson"/>
  </entries>

  <!-- InProceedings (Proceedings + AuthoredEntry + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc1"
           title="A Study on ATL Testing"
           year="2011"
           booktitle="Proc. of Testing Conf 2011">
    <authors author="Robert Cyan"/>
  </entries>

  <!-- Booklet already above (bookletA) exercises DatedEntry but not TitledEntry -->

  <!-- Unpublished with unique title -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub1"
           title="Draft on Model Validation"
           note="To appear">
    <authors author="Sara Azure"/>
    <authors author="Tom Magenta"/>
  </entries>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd1"
           title="PhD Thesis on Model Transformation"
           year="2010"
           school="University of Example">
    <authors author="Uma Navy"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mst1"
           title="Master Thesis on DSLs"
           year="2009"
           school="Institute of Computing">
    <authors author="Victor Amber"/>
  </entries>

  <!-- Booklet (already present), Booklet must be DatedEntry only - covered above -->

  <!-- Additional Booklet to increase coverage without new titles/authors -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletB"
           year="2012"/>

</BibTeX:BibTeXFile>