<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry: Booklet (triggers R3 UntitledEntry, OCL5) -->
  <entries xsi:type="BibTeX:Booklet" id="bkt1" year="2019"/>

  <!-- Misc entry (also R3 UntitledEntry, not referenced by OCLs) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Manual (R4 TitledEntry_Title_NoArticle, OCL12) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="User Guide 1"/>

  <!-- TechReport (R4, OCL11; distinct title) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="TR on Testing" year="2020">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- MasterThesis (R4, OCL7; distinct title) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="MT Title A" year="2018" school="Uni A">
    <authors author="Carol White"/>
  </entries>

  <!-- PhDThesis pair with same title (first -> R4, second -> R5; OCL8) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Shared Thesis Title" year="2015" school="Uni B">
    <authors author="Dan Brown"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd2" title="Shared Thesis Title" year="2016" school="Uni C">
    <authors author="Eve Black"/>
  </entries>

  <!-- Book (base Book, R4, OCL9; distinct title) -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="Fundamentals of MDE" year="2012" publisher="TechPress">
    <authors author="Alice Smith"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- InBook (R4, OCL10; distinct title) -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Chapter on Transformations" year="2013" publisher="TechPress" chapter="3">
    <authors author="Bob Jones"/>
  </entries>

  <!-- InCollection (R4, OCL15; distinct title) -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="A Collected Paper" year="2014" publisher="CollPub" booktitle="Collected Works on MDE">
    <authors author="Carol White"/>
  </entries>

  <!-- Proceedings (base Proceedings, R4, OCL13; distinct title) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="MDE Conference 2020" year="2020"/>

  <!-- InProceedings pair with same title (first -> R4, second -> R5; OCL14) -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Same IP Title" year="2020" booktitle="MDE Conference 2020">
    <authors author="Dan Brown"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="ip2" title="Same IP Title" year="2021" booktitle="MDE Conference 2021">
    <authors author="George King"/>
  </entries>

  <!-- Unpublished pair with same title (first -> R4, second -> R5; OCL6) -->
  <entries xsi:type="BibTeX:Unpublished" id="unp1" title="Working Draft Title" note="Draft version A">
    <authors author="Eve Black"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="unp2" title="Working Draft Title" note="Draft version B">
    <authors author="Helen Clark"/>
  </entries>

  <!-- Articles to exercise all variants of article rules -->

  <!-- Article A: unique title and unique journal (R6 Article_Title_Journal, OCL16) -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Unique Article A" year="2017" journal="Journal A">
    <authors author="Frank Green"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Articles B1 and B2: same title, different journals (B1 -> R6, B2 -> R7, OCL16, duplicates for title) -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Duplicated Title" year="2018" journal="Journal B">
    <authors author="Bob Jones"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art3" title="Duplicated Title" year="2019" journal="Journal C">
    <authors author="Carol White"/>
  </entries>

  <!-- Articles C1 and C2: different titles, same journal (C1 -> R6, C2 -> R8; duplicates for journal) -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Title C1" year="2020" journal="Journal D">
    <authors author="Dan Brown"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art5" title="Title C2" year="2021" journal="Journal D">
    <authors author="Eve Black"/>
  </entries>

  <!-- Articles D1 and D2: same title and same journal (D1 -> R6, D2 -> R9; duplicates for both) -->
  <entries xsi:type="BibTeX:Article" id="art6" title="Shared AD Title" year="2016" journal="Journal E">
    <authors author="George King"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="art7" title="Shared AD Title" year="2017" journal="Journal E">
    <authors author="Helen Clark"/>
  </entries>

</BibTeX:BibTeXFile>