<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Booklet (untitled, dated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="b1" year="2001"/>

  <!-- Misc (untitled, undated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>

  <!-- Manual (titled, no authors, no date) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Guide to BibTeX"/>

  <!-- Proceedings (titled, dated) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conference on Modeling" year="2010"/>

  <!-- Book (titled, authored, dated, publisher) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="book1" title="MDE Basics" year="2012" publisher="TechPress">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- InBook (titled, authored, dated, publisher, chapter) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Advanced MDE" year="2013" publisher="TechPress" chapter="3">
    <authors author="Carol White"/>
  </entries>

  <!-- MasterThesis (titled, authored, dated, school) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Model Transformations Study" year="2014" school="Uni A">
    <authors author="Dave Brown"/>
  </entries>

  <!-- PhDThesis (titled, authored, dated, school) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Scalable MDE" year="2015" school="Uni B">
    <authors author="Eve Black"/>
  </entries>

  <!-- TechReport (titled, authored, dated) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="MDE Report" year="2016">
    <authors author="Frank Green"/>
  </entries>

  <!-- Unpublished (titled, authored, note) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft on MDE" note="Submitted for publication">
    <authors author="Grace Lee"/>
  </entries>

  <!-- InProceedings (titled, authored, dated, booktitle) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InProceedings" id="inp1" title="MDE in Practice" year="2011" booktitle="ICMT">
    <authors author="Henry King"/>
  </entries>

  <!-- InCollection (titled, authored, dated, booktitle, publisher) -> TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:InCollection" id="inc1" title="MDE Chapter" year="2017" booktitle="Handbook of Software Engineering" publisher="SE Press">
    <authors author="Isabel Moore"/>
  </entries>

  <!-- Article 1 (unique title, unique journal) -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Model-Driven Testing" year="2018" journal="Journal of MDE">
    <authors author="Alice Smith"/>
    <authors author="John Doe"/>
  </entries>

  <!-- Article 2 (shares title with a1, unique journal) -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Model-Driven Testing" year="2019" journal="Software Practice Journal">
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article 3 (unique title, shares journal with a2) -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a3" title="MDE Case Studies" year="2020" journal="Software Practice Journal">
    <authors author="Carol White"/>
  </entries>

  <!-- Article 4 (shares title and journal with a3) -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="a4" title="MDE Case Studies" year="2021" journal="Software Practice Journal">
    <authors author="Dave Brown"/>
  </entries>

</BibTeX:BibTeXFile>