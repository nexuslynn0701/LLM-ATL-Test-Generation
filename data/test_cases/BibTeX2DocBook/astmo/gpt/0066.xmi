<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Misc" id="E01"/>
  <entries xsi:type="BibTeX:Booklet" id="E02" year="2001"/>

  <!-- Unpublished (titled, no date) -->
  <entries xsi:type="BibTeX:Unpublished" id="E03" title="Unpub Title A" note="Draft version">
    <authors author="Alice Unique"/>
  </entries>

  <!-- Manual (titled, no authors, no date) -->
  <entries xsi:type="BibTeX:Manual" id="E04" title="Manual Title A"/>

  <!-- TechReport (titled, authored, dated) -->
  <entries xsi:type="BibTeX:TechReport" id="E05" title="Tech Title A" year="2002">
    <authors author="Bob Unique"/>
  </entries>

  <!-- Proceedings (titled, dated) -->
  <entries xsi:type="BibTeX:Proceedings" id="E06" title="Proceedings Title A" year="2003"/>

  <!-- Book (titled, authored, dated, publisher) -->
  <entries xsi:type="BibTeX:Book" id="E07" title="Book Title A" year="2004" publisher="Pub House A">
    <authors author="Carol Unique"/>
  </entries>

  <!-- InBook (titled, authored, dated, publisher, chapter) -->
  <entries xsi:type="BibTeX:InBook" id="E08" title="InBook Title A" year="2005" publisher="Pub House B" chapter="3">
    <authors author="Dave Unique"/>
  </entries>

  <!-- InCollection (titled, authored, dated, booktitle, publisher) -->
  <entries xsi:type="BibTeX:InCollection" id="E09" title="InCollection Title A" year="2006" booktitle="Booktitle A" publisher="Pub House C">
    <authors author="Eve Unique"/>
  </entries>

  <!-- InProceedings (titled, authored, dated, booktitle) -->
  <entries xsi:type="BibTeX:InProceedings" id="E10" title="InProceedings Title A" year="2007" booktitle="Conference A">
    <authors author="Frank Unique"/>
  </entries>

  <!-- PhDThesis (titled, authored, dated, school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="E11" title="PhD Title A" year="2008" school="Uni A">
    <authors author="Grace Unique"/>
  </entries>

  <!-- MasterThesis (titled, authored, dated, school) -->
  <entries xsi:type="BibTeX:MasterThesis" id="E12" title="Master Title A" year="2009" school="Uni B">
    <authors author="Heidi Unique"/>
  </entries>

  <!-- Article with unique title and unique journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="E13" title="Article Title A" year="2010" journal="Journal Alpha">
    <authors author="Ivy Unique"/>
  </entries>

  <!-- Two Articles sharing the same title but different journals -->
  <!-- First participates in title-set and each journal-set -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="E14" title="Article SharedTitle" year="2011" journal="Journal Beta">
    <authors author="Jack Unique"/>
  </entries>
  <!-- Second excluded from title-set but its journal unique -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="E15" title="Article SharedTitle" year="2012" journal="Journal Gamma">
    <authors author="Karl Unique"/>
  </entries>

  <!-- Two Articles in the same journal but different titles -->
  <!-- First in title-set and journal-set -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="E16" title="Article Title C" year="2013" journal="Journal Delta">
    <authors author="Liam Unique"/>
  </entries>
  <!-- Second in title-set but excluded from journal-set -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="E17" title="Article Title D" year="2014" journal="Journal Delta">
    <authors author="Mallory Unique"/>
  </entries>

</BibTeX:BibTeXFile>