<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc (untitled, non-dated, non-authored) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet" id="bkt1" year="2010"/>

  <!-- Manual (titled only) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Manual A"/>

  <!-- Manual with duplicate title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="Manual A"/>

  <!-- TechReport (authored, dated, titled) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Tech Report One" year="2015">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Unpublished (authored, titled, with note) -->
  <entries xsi:type="BibTeX:Unpublished" id="up1" title="Unpub Work" note="To appear soon">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book (authored, dated, titled, publisher) -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="Model Engineering Basics" year="2012" publisher="TechPress">
    <authors author="Bob Johnson"/>
    <authors author="Carlos Ruiz"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry, same title as bk1 to create duplicate title) -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Model Engineering Basics" year="2014" publisher="TechPress" booktitle="Advances in MDE">
    <authors author="Diana Clark"/>
  </entries>

  <!-- InBook (Book + chapter, unique title) -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Chapter on Testing" year="2013" publisher="Springer" chapter="7">
    <authors author="Alice Smith"/>
    <authors author="Evan Lee"/>
  </entries>

  <!-- Proceedings (dated + titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="pr1" title="ICMT Proceedings" year="2018"/>

  <!-- InProceedings (Proceedings + Authored + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="MDE Transformation Testing" year="2018" booktitle="ICMT Proceedings">
    <authors author="Carlos Ruiz"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- PhDThesis (authored, dated, titled, school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Model Transformations" year="2016" school="University of Seville">
    <authors author="Diana Clark"/>
  </entries>

  <!-- MasterThesis (authored, dated, titled, school) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" title="Model Transformation Testing" year="2017" school="Tech University">
    <authors author="Evan Lee"/>
  </entries>

  <!-- Article 1: unique title, unique journal -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Testing ATL Transformations" year="2019" journal="JSS">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article 2: same title as a1, different journal -> duplicate title, distinct journal -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Testing ATL Transformations" year="2020" journal="SCP">
    <authors author="Carlos Ruiz"/>
  </entries>

  <!-- Article 3: unique title, same journal as a2 -> duplicate journal, distinct title -->
  <entries xsi:type="BibTeX:Article" id="a3" title="Traceability in MDE" year="2021" journal="SCP">
    <authors author="Diana Clark"/>
    <authors author="Evan Lee"/>
  </entries>

</BibTeX:BibTeXFile>