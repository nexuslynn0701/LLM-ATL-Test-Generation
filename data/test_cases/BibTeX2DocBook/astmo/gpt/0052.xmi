<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc (untitled, non-dated, non-authored) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Booklet (untitled, dated) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2015"/>

  <!-- Unpublished (authored, titled, no date) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Hidden Work" note="In preparation">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Manual (titled only) -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="Tool Manual"/>

  <!-- Proceedings (titled, dated) - base type only -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conf Proc" year="2020"/>

  <!-- Book (authored, dated, titled, publisher) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="MDE Basics" year="2010" publisher="TechPress">
    <authors author="Alice Smith"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="MDE Basics" year="2012" publisher="TechPress" chapter="3">
    <authors author="Bob Jones"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection" id="incollection1" title="Advanced MDE" year="2011" publisher="AcademyPub" booktitle="Collected Advances">
    <authors author="Charlie Brown"/>
  </entries>

  <!-- InProceedings (Proceedings + Authored + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Model Testing" year="2020" booktitle="Conf Proc">
    <authors author="Alice Smith"/>
    <authors author="Charlie Brown"/>
  </entries>

  <!-- TechReport (authored, dated, titled) -->
  <entries xsi:type="BibTeX:TechReport" id="tech1" title="MDE Report" year="2018">
    <authors author="Bob Jones"/>
  </entries>

  <!-- MasterThesis (authored, dated, titled, school) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Thesis A" year="2019" school="Uni A">
    <authors author="Charlie Brown"/>
  </entries>

  <!-- PhDThesis (authored, dated, titled, school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Thesis B" year="2017" school="Uni B">
    <authors author="Alice Smith"/>
    <authors author="Dana White"/>
  </entries>

  <!-- Article 1: unique title & journal -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Unique Article" year="2014" journal="Journal X">
    <authors author="Eve Black"/>
  </entries>

  <!-- Article 2: shares title with Article 3, unique journal -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Shared Title" year="2015" journal="Journal Y">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article 3: shares title with Article 2 and journal with Article 4 (same journal as art4) -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Shared Title" year="2016" journal="Journal Z">
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article 4: unique title, shares journal with Article 3 -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Another Title" year="2017" journal="Journal Z">
    <authors author="Dana White"/>
  </entries>

</BibTeX:BibTeXFile>