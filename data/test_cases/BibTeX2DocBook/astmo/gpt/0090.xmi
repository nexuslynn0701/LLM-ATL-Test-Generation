<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc entry (untitled, unauthored, undated) -->
  <entries xsi:type="BibTeX:Misc" id="miscA"/>

  <!-- Booklet (DatedEntry only, untitled, unauthored) -->
  <entries xsi:type="BibTeX:Booklet" id="bookletA" year="2001"/>

  <!-- Manual (TitledEntry only) -->
  <entries xsi:type="BibTeX:Manual" id="manualA" title="Manual Title Unique"/>

  <!-- TechReport (AuthoredEntry + DatedEntry + TitledEntry) -->
  <entries xsi:type="BibTeX:TechReport" id="techrepA" title="TechReport Title Unique" year="2005">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- Unpublished (AuthoredEntry + TitledEntry) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpubA" title="Unpublished Title Unique" note="Preprint note.">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- Book (AuthoredEntry + DatedEntry + TitledEntry) -->
  <entries xsi:type="BibTeX:Book" id="bookA" title="Book Title Unique" year="1999" publisher="Great Publisher">
    <authors author="Alice Alpha"/>
  </entries>

  <!-- InBook (Book + chapter) shares title with bookA to trigger duplicate-title logic -->
  <entries xsi:type="BibTeX:InBook" id="inbookA" title="Book Title Unique" year="2000" publisher="Great Publisher" chapter="3">
    <authors author="David Delta"/>
  </entries>

  <!-- Proceedings (DatedEntry + TitledEntry) -->
  <entries xsi:type="BibTeX:Proceedings" id="procA" title="Proceedings Title Unique" year="2010"/>

  <!-- InProceedings (Proceedings + AuthoredEntry + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings" id="inprocA" title="InProceedings Title Unique" year="2011" booktitle="Conference Book Title">
    <authors author="Bob Beta"/>
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection" id="incolA" title="InCollection Title Unique" year="2008" publisher="Another Publisher" booktitle="Collection Book Title">
    <authors author="Frank Phi"/>
  </entries>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phdA" title="PhD Thesis Title Unique" year="2015" school="Famous University">
    <authors author="Grace Gamma"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mscA" title="Master Thesis Title Unique" year="2016" school="Tech University">
    <authors author="Henry Eta"/>
  </entries>

  <!-- Articles to hit all Article_* rules -->

  <!-- Article 1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Article Title 1" year="2020" journal="Journal Alpha">
    <authors author="Alice Alpha"/>
  </entries>

  <!-- Article 2: same title as art1, different journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Article Title 1" year="2021" journal="Journal Beta">
    <authors author="Bob Beta"/>
  </entries>

  <!-- Article 3: different title, journal shared with art2 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Article Title 2" year="2022" journal="Journal Beta">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- Article 4: same title and same journal as art3 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Article Title 2" year="2023" journal="Journal Beta">
    <authors author="David Delta"/>
  </entries>

</BibTeX:BibTeXFile>