<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc: untitled, exercises R3 (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc1"/>

  <!-- Booklet: DatedEntry but not TitledEntry, exercises R3 and OCL5 -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet1"
           year="2001"/>

  <!-- Manual: TitledEntry, no authors/date, unique title -> R4 -->
  <entries xsi:type="BibTeX:Manual"
           id="manual1"
           title="User Manual for System X"/>

  <!-- TechReport: Authored + Dated + Titled, unique title -> R4, authors repeated -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep1"
           title="Performance Evaluation of Y"
           year="2005">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Unpublished: Authored + Titled, unique title -> R4, exercises OCL6 -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub1"
           title="Preliminary Results on Z"
           note="To appear">
    <authors author="Alice Smith"/>
  </entries>

  <!-- MasterThesis: ThesisEntry (Authored + Dated + Titled), unique title -> R4 -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mthesis1"
           title="Mastering Model Transformations"
           year="2010"
           school="Tech University">
    <authors author="Carol White"/>
  </entries>

  <!-- PhDThesis: ThesisEntry, unique title -> R4, exercises OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd1"
           title="Advanced Topics in MDE"
           year="2012"
           school="Science Institute">
    <authors author="David Brown"/>
  </entries>

  <!-- Book: Authored + Dated + Titled, unique title -> R4, exercises OCL9 -->
  <entries xsi:type="BibTeX:Book"
           id="book1"
           title="Foundations of Transformation"
           year="2015"
           publisher="Springer">
    <authors author="Alice Smith"/>
    <authors author="Eve Black"/>
  </entries>

  <!-- InBook: Book child, Authored + Dated + Titled, unique title -> R4, exercises OCL10 -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook1"
           title="Chapter on Testing"
           year="2016"
           publisher="Springer"
           chapter="3">
    <authors author="Bob Jones"/>
  </entries>

  <!-- Proceedings: Dated + Titled, unique title -> R4, exercises OCL13 (base type only one) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc1"
           title="Proceedings of MDE Conference"
           year="2018"/>

  <!-- InProceedings: Proceedings + Authored + BookTitled + Dated + Titled, unique title -> R4, OCL14 -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc1"
           title="A Paper on ATL"
           year="2018"
           booktitle="Proceedings of MDE Conference">
    <authors author="Carol White"/>
    <authors author="David Brown"/>
  </entries>

  <!-- Book child: InCollection: Book + BookTitled, unique title -> R4, OCL15 -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol1"
           title="Transformation Case Studies"
           year="2017"
           publisher="Elsevier"
           booktitle="Collected Works on MDE">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Articles group 1: same title, different journals -->
  <!-- a1: chosen for title & journal sets -> R6 -->
  <entries xsi:type="BibTeX:Article"
           id="a1"
           title="On Model Transformations"
           year="2020"
           journal="Journal A">
    <authors author="Alice Smith"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- a2: same title as a1, unique journal -> R7 (no title, has journal) -->
  <entries xsi:type="BibTeX:Article"
           id="a2"
           title="On Model Transformations"
           year="2021"
           journal="Journal B">
    <authors author="Bob Jones"/>
  </entries>

  <!-- Articles group 2: same journal, different titles -->
  <!-- a3: chosen for title & journal sets -> R6 -->
  <entries xsi:type="BibTeX:Article"
           id="a3"
           title="Testing Model Transformations"
           year="2019"
           journal="Journal C">
    <authors author="Carol White"/>
  </entries>

  <!-- a4: different title, same journal as a3 -> R8 (has title, no journal in set) -->
  <entries xsi:type="BibTeX:Article"
           id="a4"
           title="Evaluation of ATL Transformations"
           year="2022"
           journal="Journal C">
    <authors author="David Brown"/>
    <authors author="Eve Black"/>
  </entries>

  <!-- Articles group 3: same title and same journal -->
  <!-- a5: chosen for title & journal sets -> R6 -->
  <entries xsi:type="BibTeX:Article"
           id="a5"
           title="Duplicate Study"
           year="2018"
           journal="Journal D">
    <authors author="Frank Green"/>
  </entries>

  <!-- a6: same title and journal as a5 -> R9 (no title, no journal) -->
  <entries xsi:type="BibTeX:Article"
           id="a6"
           title="Duplicate Study"
           year="2021"
           journal="Journal D">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

</BibTeX:BibTeXFile>