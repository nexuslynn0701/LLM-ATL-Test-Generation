<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry (for UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>

  <!-- Booklet (also UntitledEntry, DatedEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2001"/>

  <!-- Manual (titled, no authors, no date) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Manual of Transformation Testing"/>

  <!-- TechReport (titled, authored, dated) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Testing Model Transformations" year="2010">
    <authors author="Alice Tester"/>
    <authors author="Bob Modeler"/>
  </entries>

  <!-- Proceedings (titled, dated, no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proceedings of MDE 2020" year="2020"/>

  <!-- InProceedings: triggers titled no-article rule; booktitle present -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Proceedings Paper One" year="2020" booktitle="Proceedings of MDE 2020">
    <authors author="Carol Researcher"/>
  </entries>

  <!-- Book (titled, authored, dated, publisher) -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="Model Transformations in Practice" year="2015" publisher="Springer">
    <authors author="Alice Tester"/>
    <authors author="David Engineer"/>
  </entries>

  <!-- InCollection (child of Book, shares title with duplicated-book; booktitle and publisher used) -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Chapter on ATL" year="2015" publisher="Springer" booktitle="Model Transformations in Practice">
    <authors author="Eve Author"/>
  </entries>

  <!-- InBook (chaptered book; same publisher as bk1) -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Case Studies in ATL" year="2016" publisher="Springer" chapter="3">
    <authors author="Frank Developer"/>
    <authors author="Bob Modeler"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Testing ATL Transformations" year="2018" school="University of Testing">
    <authors author="Grace Student"/>
  </entries>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Topics in Model Transformations" year="2019" school="Tech University">
    <authors author="Henry Researcher"/>
  </entries>

  <!-- Unpublished (titled, authored, note) -->
  <entries xsi:type="BibTeX:Unpublished" id="up1" title="Unpublished Transformation Results" note="Submitted for publication">
    <authors author="Ian Scientist"/>
    <authors author="Carol Researcher"/>
  </entries>

  <!-- Article 1: unique title, journal j1 -->
  <entries xsi:type="BibTeX:Article" id="a1" title="First Article on MDE" year="2011" journal="Journal of MDE">
    <authors author="Alice Tester"/>
    <authors author="Carol Researcher"/>
  </entries>

  <!-- Article 2: same title as a1, different journal j2 (duplicate title, distinct journal) -->
  <entries xsi:type="BibTeX:Article" id="a2" title="First Article on MDE" year="2012" journal="Software Engineering Letters">
    <authors author="Bob Modeler"/>
  </entries>

  <!-- Article 3: unique title, same journal as a1 (duplicate journal, distinct title) -->
  <entries xsi:type="BibTeX:Article" id="a3" title="Second Study on MDE" year="2013" journal="Journal of MDE">
    <authors author="David Engineer"/>
    <authors author="Eve Author"/>
  </entries>

  <!-- Article 4: unique title, unique journal j3 (used to ensure at least one Article in title+journal set) -->
  <entries xsi:type="BibTeX:Article" id="a4" title="Independent Article on Testing" year="2014" journal="International Journal of Testing">
    <authors author="Frank Developer"/>
    <authors author="Grace Student"/>
  </entries>

</BibTeX:BibTeXFile>