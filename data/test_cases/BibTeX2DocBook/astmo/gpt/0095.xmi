<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- 1: Misc (untitled, unauthored, undated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="misc01"/>

  <!-- 2: Booklet (dated only) -> UntitledEntry + OCL5 -->
  <entries xsi:type="BibTeX:Booklet" id="booklet01" year="2001"/>

  <!-- 3: Manual (titled only, distinct title) -> TitledEntry_Title_NoArticle + OCL12 -->
  <entries xsi:type="BibTeX:Manual" id="manual01" title="Using the BibTeX2DocBook Tool"/>

  <!-- 4: TechReport (authored, dated, titled, distinct title) -> TitledEntry_Title_NoArticle + OCL11 -->
  <entries xsi:type="BibTeX:TechReport" id="techrep01" title="TechReport on MDE Testing" year="2015">
    <authors author="Carol White"/>
    <authors author="Dave Brown"/>
  </entries>

  <!-- 5: Proceedings (dated, titled, distinct title) -> TitledEntry_Title_NoArticle + OCL13 (select(oclIsTypeOf)) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc01" title="Proceedings of MDE 2010" year="2010"/>

  <!-- 6: InProceedings (authored, dated, booktitled, titled, distinct title & journal-like booktitle) 
         -> TitledEntry_Title_NoArticle + OCL14 -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc01" title="InProceedings on Model Transformations"
           year="2011" booktitle="MDE Journal Special Issue">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- 7: Book (authored, dated, titled, distinct title) -> TitledEntry_Title_NoArticle + OCL9 -->
  <entries xsi:type="BibTeX:Book" id="book01" title="Foundations of Model-Driven Engineering"
           year="2005" publisher="Springer">
    <authors author="John Doe"/>
    <authors author="Jane Roe"/>
  </entries>

  <!-- 8: InBook (subclass of Book, extra chapter) -> TitledEntry_Title_NoArticle + OCL10 -->
  <entries xsi:type="BibTeX:InBook" id="inbook01" title="Chapter on ATL Transformations"
           year="2008" publisher="ACM Press" chapter="3">
    <authors author="John Doe"/>
  </entries>

  <!-- 9: InCollection (book + booktitle, distinct title) -> TitledEntry_Title_NoArticle + OCL15 -->
  <entries xsi:type="BibTeX:InCollection" id="incoll01"
           title="Case Studies in Model Transformation Testing"
           year="2012" publisher="IEEE Press" booktitle="Advances in MDE">
    <authors author="Jane Roe"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- 10: PhDThesis (authored, dated, titled, distinct title, school) -> TitledEntry_Title_NoArticle + OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd01"
           title="Model Transformation Testing Techniques"
           year="2013" school="University of Example">
    <authors author="Eve Black"/>
  </entries>

  <!-- 11: Unpublished (authored, titled, distinct title, note) -> TitledEntry_Title_NoArticle + OCL6 -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub01"
           title="Unpublished Notes on ATL Semantics"
           note="Draft version">
    <authors author="Frank Green"/>
    <authors author="Carol White"/>
  </entries>

  <!-- 12: Article A (authored, dated, titled, journal) 
         Unique title & unique journal -> Article_Title_Journal + OCL16 -->
  <entries xsi:type="BibTeX:Article" id="art01"
           title="Testing Model Transformations"
           year="2014" journal="Software Testing Journal">
    <authors author="Alice Smith"/>
    <authors author="John Doe"/>
  </entries>

  <!-- 13: Article B (same title as art01, different journal) 
         Title duplicate set: only art01 in title-set; art02 excluded from title-set.
         Journal of art02 unique -> Article_NoTitle_Journal + OCL16 -->
  <entries xsi:type="BibTeX:Article" id="art02"
           title="Testing Model Transformations"
           year="2016" journal="Journal of MDE Research">
    <authors author="Bob Jones"/>
  </entries>

  <!-- 14: Article C (different title, same journal as art02)
         Title unique -> in title-set.
         Journal duplicate (with art02) -> art02 in journal-set, art03 excluded -> Article_Title_NoJournal + OCL16 -->
  <entries xsi:type="BibTeX:Article" id="art03"
           title="Advanced Topics in Transformation Testing"
           year="2017" journal="Journal of MDE Research">
    <authors author="Carol White"/>
    <authors author="Dave Brown"/>
  </entries>

</BibTeX:BibTeXFile>