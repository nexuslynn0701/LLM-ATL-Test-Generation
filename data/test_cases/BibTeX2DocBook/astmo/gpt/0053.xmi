<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- UntitledEntry: Booklet -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="2019"/>

  <!-- UntitledEntry: Misc -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- Unpublished (TitledEntry, AuthoredEntry, not DatedEntry) -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Shared Title" note="Submitted for publication">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- Manual (TitledEntry only) -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="Manual One"/>

  <!-- TechReport (TitledEntry, AuthoredEntry, DatedEntry) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="TechReport Title" year="2018">
    <authors author="Carol Gamma"/>
    <authors author="Dave Delta"/>
  </entries>

  <!-- Proceedings (TitledEntry, DatedEntry) -->
  <entries xsi:type="BibTeX:Proceedings" id="P2" title="Conference B" year="2020"/>

  <!-- InProceedings (AuthoredEntry, DatedEntry, TitledEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Shared Title" year="2021" booktitle="Conference A">
    <authors author="Alice Alpha"/>
  </entries>

  <!-- Book (AuthoredEntry, DatedEntry, TitledEntry) -->
  <entries xsi:type="BibTeX:Book" id="BK1" title="Book Title One" year="2017" publisher="Publisher P">
    <authors author="Bob Beta"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Shared Title" year="2016" publisher="Publisher Q" booktitle="Edited Volume">
    <authors author="Carol Gamma"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- InBook (Book + extra chapter) -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="InBook Title" year="2015" publisher="Publisher R" chapter="3">
    <authors author="Dave Delta"/>
  </entries>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Shared Title" year="2014" school="Tech University">
    <authors author="Alice Alpha"/>
    <authors author="Carol Gamma"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Master Thesis Title" year="2013" school="Science College">
    <authors author="Bob Beta"/>
  </entries>

  <!-- Articles with distinct (title, journal) so R6 applies for each -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Article One" year="2022" journal="Journal Alpha">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="A2" title="Article Two" year="2021" journal="Journal Beta">
    <authors author="Carol Gamma"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="A3" title="Article Three" year="2020" journal="Journal Gamma">
    <authors author="Dave Delta"/>
    <authors author="Alice Alpha"/>
  </entries>

</BibTeX:BibTeXFile>