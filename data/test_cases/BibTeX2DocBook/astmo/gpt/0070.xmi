<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry (Misc) -> R3 UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="E01"/>

  <!-- Booklet (untitled, dated) -> R3 UntitledEntry + OCL5 -->
  <entries xsi:type="BibTeX:Booklet" id="E02" year="2001"/>

  <!-- Manual (titled, no authors/year) -> R4 TitledEntry_Title_NoArticle + OCL12 -->
  <entries xsi:type="BibTeX:Manual" id="E03" title="DocBook Manual"/>

  <!-- TechReport (titled, authored, dated) -> R4 + OCL11 -->
  <entries xsi:type="BibTeX:TechReport" id="E04" title="Tech Report on MDE" year="2010">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Unpublished (titled, authored, with note) -> R4 + OCL6 -->
  <entries xsi:type="BibTeX:Unpublished" id="E05" title="Unreleased Study" note="To appear">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book (titled, authored, dated, publisher) -> R4 + OCL9 -->
  <entries xsi:type="BibTeX:Book" id="E06" title="MDE Fundamentals" year="2015" publisher="Modeling Press">
    <authors author="Carol White"/>
    <authors author="Dave Brown"/>
  </entries>

  <!-- InBook (child of Book, chapter) -> R4 + OCL10 -->
  <entries xsi:type="BibTeX:InBook" id="E07" title="Chapter on ATL" year="2016" publisher="Modeling Press" chapter="3">
    <authors author="Dave Brown"/>
  </entries>

  <!-- Proceedings (titled, dated) -> R4 + OCL13 -->
  <entries xsi:type="BibTeX:Proceedings" id="E08" title="MDE Conference 2018" year="2018"/>

  <!-- InProceedings (titled, authored, booktitled, dated) -> R4 + OCL14 -->
  <entries xsi:type="BibTeX:InProceedings" id="E09" title="ATL in Practice" year="2018" booktitle="MDE Conference 2018">
    <authors author="Alice Smith"/>
    <authors author="Carol White"/>
  </entries>

  <!-- InCollection (titled, authored, dated, booktitle, publisher) -> R4 + OCL15 -->
  <entries xsi:type="BibTeX:InCollection" id="E10" title="Model Transformations" year="2017" booktitle="Handbook of MDE" publisher="Springer">
    <authors author="Bob Jones"/>
  </entries>

  <!-- MasterThesis (titled, authored, dated, school) -> R4 (OCL7 commented) -->
  <entries xsi:type="BibTeX:MasterThesis" id="E11" title="Model Transformation Testing" year="2013" school="University A">
    <authors author="Eve Green"/>
  </entries>

  <!-- PhDThesis (titled, authored, dated, school) -> R4 + OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis" id="E12" title="Advanced MDE" year="2014" school="University B">
    <authors author="Frank Black"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article A1 (unique title, unique journal) -> R6 Article_Title_Journal + OCL16 -->
  <entries xsi:type="BibTeX:Article" id="E13" title="ATL Patterns" year="2011" journal="Journal of MDE">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article A2 (same journal as A1, different title) -> R8 Article_Title_NoJournal + OCL16 -->
  <entries xsi:type="BibTeX:Article" id="E14" title="EMF Techniques" year="2012" journal="Journal of MDE">
    <authors author="Carol White"/>
  </entries>

  <!-- Article A3 (same title as A2, different journal) -> R7 Article_NoTitle_Journal + OCL16 -->
  <entries xsi:type="BibTeX:Article" id="E15" title="EMF Techniques" year="2013" journal="Software Engineering Notes">
    <authors author="Dave Brown"/>
  </entries>

  <!-- Article A4 (same title and journal as A1) -> R9 Article_NoTitle_NoJournal + OCL16 -->
  <entries xsi:type="BibTeX:Article" id="E16" title="ATL Patterns" year="2014" journal="Journal of MDE">
    <authors author="Eve Green"/>
  </entries>

  <!-- Article A5 (unique title, same journal as A3) -> R8 Article_Title_NoJournal + OCL16 -->
  <entries xsi:type="BibTeX:Article" id="E17" title="Model Reuse" year="2015" journal="Software Engineering Notes">
    <authors author="Frank Black"/>
  </entries>

</BibTeX:BibTeXFile>