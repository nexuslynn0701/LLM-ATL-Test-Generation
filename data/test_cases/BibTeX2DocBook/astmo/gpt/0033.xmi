<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger R3 (UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="2018"/>

  <!-- Articles to trigger R6, R7, R8, R9 with various title/journal combinations -->
  <!-- A1: unique title + unique journal => Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Unique Article Title" year="2010" journal="Journal One">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- A2 & A3: same title, different journals => one Article_NoTitle_Journal (A2) and one Article_Title_Journal (A3) -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Shared Title A" year="2011" journal="Journal Two">
    <authors author="Charlie Researcher"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="A3" title="Shared Title A" year="2012" journal="Journal Three">
    <authors author="Dana Scientist"/>
  </entries>

  <!-- A4 & A5: different titles, same journal => one Article_Title_NoJournal (A4) and one Article_Title_Journal (A5) -->
  <entries xsi:type="BibTeX:Article" id="A4" title="Article In Common Journal 1" year="2013" journal="Journal Common">
    <authors author="Evan Theorist"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="A5" title="Article In Common Journal 2" year="2014" journal="Journal Common">
    <authors author="Fiona Analyst"/>
  </entries>

  <!-- A6 & A7: same title and same journal => one Article_NoTitle_NoJournal (A6) and one Article_Title_Journal (A7) -->
  <entries xsi:type="BibTeX:Article" id="A6" title="Duplicate Full" year="2015" journal="Journal Duplicate">
    <authors author="George Scholar"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="A7" title="Duplicate Full" year="2016" journal="Journal Duplicate">
    <authors author="Hannah Expert"/>
  </entries>

  <!-- Titled non-article entries to trigger R4/R5 -->
  <!-- P1 & P2: same title PhDThesis to trigger TitledEntry_Title_NoArticle and TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:PhDThesis" id="P1" title="Thesis Shared Title" year="2009" school="Tech University">
    <authors author="Ian Doctoral"/>
  </entries>

  <entries xsi:type="BibTeX:PhDThesis" id="P2" title="Thesis Shared Title" year="2010" school="Science University">
    <authors author="Jane Doctoral"/>
  </entries>

  <!-- M1: MasterThesis with unique title -->
  <entries xsi:type="BibTeX:MasterThesis" id="M1" title="Unique Master Thesis" year="2011" school="Engineering Institute">
    <authors author="Kevin Graduate"/>
  </entries>

  <!-- IB1 & IB2: InBook, one with unique title, one sharing title with a Book -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Unique InBook Title" year="2012" publisher="Global Press" chapter="3">
    <authors author="Laura Inbook"/>
  </entries>

  <!-- B2: Book with unique title -->
  <entries xsi:type="BibTeX:Book" id="B2" title="Standalone Book" year="2005" publisher="Academic Press">
    <authors author="Michael Author"/>
  </entries>

  <!-- B3 & IC1: Book and InCollection sharing same title to exercise duplicate title among different types -->
  <entries xsi:type="BibTeX:Book" id="B3" title="Shared Collection Title" year="2006" publisher="Scholarly House">
    <authors author="Nora Editor"/>
  </entries>

  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Shared Collection Title" year="2007" publisher="Scholarly House" booktitle="Collected Works">
    <authors author="Oliver Contributor"/>
  </entries>

  <!-- IP1 & IP2: InProceedings with shared and unique titles -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Conference Paper Alpha" year="2013" booktitle="Conf Proceedings 2013">
    <authors author="Paula Presenter"/>
  </entries>

  <entries xsi:type="BibTeX:InProceedings" id="IP2" title="Conference Paper Beta" year="2014" booktitle="Conf Proceedings 2014">
    <authors author="Quentin Speaker"/>
  </entries>

  <!-- PR1 & PR2: Proceedings with same title to trigger TitledEntry_Title_NoArticle / NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" title="Annual Symposium" year="2015"/>
  <entries xsi:type="BibTeX:Proceedings" id="PR2" title="Annual Symposium" year="2016"/>

  <!-- MAN1 & MAN2: Manuals, unique titles -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="User Manual System X"/>
  <entries xsi:type="BibTeX:Manual" id="MAN2" title="Developer Guide System Y"/>

  <!-- U1 & U2: Unpublished, with distinct titles; U2 shares title with TechReport T2 -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Early Draft" note="Work in progress">
    <authors author="Rachel Researcher"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished" id="U2" title="Joint Working Note" note="Internal review">
    <authors author="Sam Collaborator"/>
  </entries>

  <!-- T1 & T2: TechReports, one unique, one sharing title with U2 -->
  <entries xsi:type="BibTeX:TechReport" id="T1" title="Technical Report One" year="2008">
    <authors author="Tim Technologist"/>
  </entries>

  <entries xsi:type="BibTeX:TechReport" id="T2" title="Joint Working Note" year="2009">
    <authors author="Uma Engineer"/>
  </entries>

</BibTeX:BibTeXFile>