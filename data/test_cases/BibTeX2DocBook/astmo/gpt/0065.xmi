<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (Misc, Booklet) -> Rule R3 -->
  <entries xsi:type="BibTeX:Misc" id="miscA"/>
  <entries xsi:type="BibTeX:Booklet" id="bookletA" year="2018"/>

  <!-- Articles (to exercise all 4 article rules) -->
  <!-- Unique title & unique journal -> R6 -->
  <entries xsi:type="BibTeX:Article"
           id="art1"
           title="Alpha Study"
           year="2019"
           journal="Computing Journal">
    <authors author="Author One"/>
    <authors author="Author Two"/>
  </entries>

  <!-- Same title as art3, different journal -> R7 (no title in set, unique journal) -->
  <entries xsi:type="BibTeX:Article"
           id="art2"
           title="Beta Analysis"
           year="2020"
           journal="Science Journal">
    <authors author="Author Three"/>
    <authors author="Author Four"/>
  </entries>

  <!-- Same title as art2, different journal -> R6 (title in set, journal in set) -->
  <entries xsi:type="BibTeX:Article"
           id="art3"
           title="Beta Analysis"
           year="2021"
           journal="Engineering Journal">
    <authors author="Author One"/>
  </entries>

  <!-- Unique title, same journal as art5 -> R8 (title in set, journal not in set) -->
  <entries xsi:type="BibTeX:Article"
           id="art4"
           title="Gamma Evaluation"
           year="2022"
           journal="Shared Journal">
    <authors author="Author Two"/>
  </entries>

  <!-- Same journal as art4, different title -> R9 (title not in set, journal not in set) -->
  <entries xsi:type="BibTeX:Article"
           id="art5"
           title="Delta Exploration"
           year="2023"
           journal="Shared Journal">
    <authors author="Author Five"/>
  </entries>

  <!-- Non-article titled entries to exercise R4 and R5 -->

  <!-- Book with unique title -> R4 -->
  <entries xsi:type="BibTeX:Book"
           id="book1"
           title="Unique Book Title"
           year="2015"
           publisher="Book Publisher A">
    <authors author="Author Six"/>
    <authors author="Author One"/>
  </entries>

  <!-- Books sharing same title -> one R4 (book2) + one R5 (book3) -->
  <entries xsi:type="BibTeX:Book"
           id="book2"
           title="Shared Book Title"
           year="2016"
           publisher="Book Publisher B">
    <authors author="Author Two"/>
  </entries>

  <entries xsi:type="BibTeX:Book"
           id="book3"
           title="Shared Book Title"
           year="2017"
           publisher="Book Publisher C">
    <authors author="Author Three"/>
  </entries>

  <!-- Manual unique title -> R4 -->
  <entries xsi:type="BibTeX:Manual"
           id="man1"
           title="User Guide Manual"/>
  
  <!-- Manual sharing title with man1 -> R5 -->
  <entries xsi:type="BibTeX:Manual"
           id="man2"
           title="User Guide Manual"/>

  <!-- Proceedings (root type, not child) with unique title -> R4 -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc1"
           title="ConfProc 2020"
           year="2020"/>

  <!-- InProceedings (child of Proceedings) unique title -> R4 -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc1"
           title="Paper in Conference"
           year="2020"
           booktitle="ConfProc 2020">
    <authors author="Author Four"/>
  </entries>

  <!-- InCollection with unique title -> R4 -->
  <entries xsi:type="BibTeX:InCollection"
           id="incoll1"
           title="Chapter in Collection"
           year="2014"
           booktitle="Collection Volume 1"
           publisher="Collection Publisher">
    <authors author="Author Five"/>
    <authors author="Author Six"/>
  </entries>

  <!-- InBook with unique title -> R4 -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook1"
           title="InBook Chapter Title"
           year="2013"
           publisher="InBook Publisher"
           chapter="7">
    <authors author="Author Three"/>
  </entries>

  <!-- TechReport with unique title -> R4 -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech1"
           title="TechReport Title One"
           year="2012">
    <authors author="Author Two"/>
    <authors author="Author Five"/>
  </entries>

  <!-- Unpublished with unique title -> R4 -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub1"
           title="Unpublished Work"
           note="To appear soon">
    <authors author="Author Seven"/>
  </entries>

  <!-- PhDThesis unique title -> R4 -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd1"
           title="Doctoral Dissertation"
           year="2011"
           school="Tech University">
    <authors author="Author Six"/>
  </entries>

  <!-- MasterThesis sharing title with phd2 to exercise R4/R5 for theses -->
  <!-- First occurrence -> R4 -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mst1"
           title="Thesis Shared Title"
           year="2010"
           school="Science University">
    <authors author="Author Four"/>
  </entries>

  <!-- PhDThesis with same title as mst1 -> R5 -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd2"
           title="Thesis Shared Title"
           year="2009"
           school="Science University">
    <authors author="Author One"/>
  </entries>

</BibTeX:BibTeXFile>