<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc (untitled, no authors, no date) -->
  <entries xsi:type="BibTeX:Misc" id="E01"/>

  <!-- Booklet (DatedEntry only) -->
  <entries xsi:type="BibTeX:Booklet" id="E02" year="2005"/>

  <!-- Manual (TitledEntry only) -->
  <entries xsi:type="BibTeX:Manual" id="E03" title="The Unique Manual"/>

  <!-- Unpublished (Authored + Titled) with unique title -->
  <entries xsi:type="BibTeX:Unpublished" id="E04" title="Unpublished Ideas" note="draft version">
    <authors author="Alice U."/>
  </entries>

  <!-- PhDThesis (ThesisEntry) with unique title -->
  <entries xsi:type="BibTeX:PhDThesis" id="E05" title="Deep Learning PhD" year="2018" school="Tech University">
    <authors author="Bob P."/>
    <authors author="Charlie D."/>
  </entries>

  <!-- Book (unique title) -->
  <entries xsi:type="BibTeX:Book" id="E06" title="Model Engineering Book" year="2016" publisher="Springer">
    <authors author="Alice U."/>
  </entries>

  <!-- InBook (unique title) -->
  <entries xsi:type="BibTeX:InBook" id="E07" title="Chapter on Testing" year="2017" publisher="Elsevier" chapter="3">
    <authors author="David I."/>
  </entries>

  <!-- InCollection (unique title) -->
  <entries xsi:type="BibTeX:InCollection" id="E08" title="Collected Transformations" year="2019" publisher="ACM">
    <authors author="Eve C."/>
  </entries>

  <!-- Proceedings (unique title) -->
  <entries xsi:type="BibTeX:Proceedings" id="E09" title="MDE Conference 2020" year="2020"/>

  <!-- InProceedings (unique title, journal-like booktitle) -->
  <entries xsi:type="BibTeX:InProceedings" id="E10" title="MDE Testing Paper" year="2020" booktitle="MDE Conference 2020">
    <authors author="Frank T."/>
    <authors author="Alice U."/>
  </entries>

  <!-- TechReport (unique title) -->
  <entries xsi:type="BibTeX:TechReport" id="E11" title="Testing Report" year="2015">
    <authors author="Grace R."/>
  </entries>

  <!-- Article A1 (unique title, unique journal) -->
  <entries xsi:type="BibTeX:Article" id="E12" title="Unique Article" year="2010" journal="Journal A">
    <authors author="Henry J."/>
  </entries>

  <!-- Article A2 and A3 share title, but have distinct journals:
       A2: title "Shared Title", journal "Journal B"
       A3: title "Shared Title", journal "Journal C"
       -> one gets Title_NoJournal (in titleSet & in journalSet),
          the other gets NoTitle_NoJournal (not in either set). -->
  <entries xsi:type="BibTeX:Article" id="E13" title="Shared Title" year="2011" journal="Journal B">
    <authors author="Ivy K."/>
    <authors author="Alice U."/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="E14" title="Shared Title" year="2012" journal="Journal C">
    <authors author="Jack L."/>
  </entries>

</BibTeX:BibTeXFile>