<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry (triggers UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="2009"/>

  <!-- Unpublished (TitledEntry, AuthoredEntry, no date) -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Draft Transformation Report" note="Internal review only">
    <authors author="Alice Unique"/>
  </entries>

  <!-- TechReport (TitledEntry, AuthoredEntry, DatedEntry) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Testing Model Transformations" year="2010">
    <authors author="Bob Tester"/>
  </entries>

  <!-- Manual (TitledEntry only) -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="ATL Reference Manual"/>

  <!-- Proceedings (TitledEntry, DatedEntry; base type only) -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" title="Proceedings of MDE Quality" year="2011"/>

  <!-- InProceedings (TitledEntry, DatedEntry, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Coverage of Transformation Rules" year="2011" booktitle="Proceedings of MDE Quality">
    <authors author="Carol Coverage"/>
    <authors author="Dan Depth"/>
  </entries>

  <!-- Book (base Book, not subtype) -->
  <entries xsi:type="BibTeX:Book" id="BK1" title="Model-Driven Engineering Essentials" year="2012" publisher="TechPress">
    <authors author="Eve Engineer"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Testing in MDE" year="2012" publisher="TechPress" booktitle="Model-Driven Engineering Essentials">
    <authors author="Frank Framework"/>
  </entries>

  <!-- InBook (Book subtype, has chapter) -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="ATL in Practice" year="2012" publisher="TechPress" chapter="3">
    <authors author="Grace Generator"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Model Transformation Testing" year="2013" school="University of Sevilla">
    <authors author="Henry Human"/>
  </entries>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Advanced Model Transformations" year="2014" school="University of Sevilla">
    <authors author="Ivy Investigator"/>
  </entries>

  <!-- Article 1: unique title and journal -->
  <entries xsi:type="BibTeX:Article" id="A1" title="ATL Testing Strategies" year="2015" journal="Journal of Model Engineering">
    <authors author="John Journal"/>
  </entries>

  <!-- Article 2: same title as A3, different journal (triggers Article_NoTitle_Journal on one of them) -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Duplicate Title Study" year="2016" journal="Software Quality Notes">
    <authors author="Kate Knowledge"/>
  </entries>

  <!-- Article 3: same title as A2, different journal -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Duplicate Title Study" year="2017" journal="International Journal of Experiments">
    <authors author="Leo Logic"/>
  </entries>

  <!-- Article 4: unique title, journal shared with A5 (triggers Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A4" title="Shared Journal Analysis" year="2018" journal="Transformation Science">
    <authors author="Mia Modeler"/>
  </entries>

  <!-- Article 5: different title, same journal as A4 -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Another Study on Shared Journals" year="2019" journal="Transformation Science">
    <authors author="Ned Notation"/>
  </entries>

</BibTeX:BibTeXFile>