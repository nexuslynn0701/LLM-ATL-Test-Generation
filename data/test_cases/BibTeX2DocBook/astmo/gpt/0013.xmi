<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc (untitled, non-authored, non-dated) -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- Booklet (dated, non-titled) -->
  <entries xsi:type="BibTeX:Booklet" id="BKL1" year="2008"/>

  <!-- Manual (titled, no authors, no year) -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="Tool Manual"/>

  <!-- Proceedings (titled, dated, no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="PROC1" title="ConfA Proceedings" year="2010"/>

  <!-- InProceedings (titled, dated, authored, booktitled) -->
  <entries xsi:type="BibTeX:InProceedings" id="INPROC1" title="InProc Paper" year="2011" booktitle="ConfA Proceedings">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- Book (titled, dated, authored, publisher) -->
  <entries xsi:type="BibTeX:Book" id="BOOK1" title="Advanced Topics" year="2012" publisher="TechPress">
    <authors author="Carol Scholar"/>
  </entries>

  <!-- InCollection (titled, dated, authored, booktitle, publisher) -->
  <entries xsi:type="BibTeX:InCollection" id="INC1" title="Advanced Topics" year="2013" booktitle="Collected Works" publisher="TechPress">
    <authors author="Dave Researcher"/>
    <authors author="Eve Analyst"/>
  </entries>

  <!-- InBook (titled via Book, dated, authored, publisher, chapter) -->
  <entries xsi:type="BibTeX:InBook" id="INB1" title="Deep Dive" year="2014" publisher="TechPress" chapter="5">
    <authors author="Frank Expert"/>
  </entries>

  <!-- MasterThesis (ThesisEntry: titled, dated, authored, school) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Model Transformations" year="2015" school="Univ A">
    <authors author="Grace Student"/>
  </entries>

  <!-- PhDThesis (ThesisEntry: titled, dated, authored, school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Scalable Transformations" year="2016" school="Univ B">
    <authors author="Heidi Doctor"/>
  </entries>

  <!-- Unpublished (titled, authored, note; no year) -->
  <entries xsi:type="BibTeX:Unpublished" id="UNP1" title="Draft Paper" note="Under review">
    <authors author="Ivan Author"/>
    <authors author="Judy Collaborator"/>
  </entries>

  <!-- TechReport (titled, dated, authored) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Tech Report A" year="2017">
    <authors author="Carol Scholar"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- Article A1 (titled, dated, authored, journal) -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Metamodeling Basics" year="2018" journal="Journal X">
    <authors author="Alice Author"/>
    <authors author="Carol Scholar"/>
  </entries>

  <!-- Article A2: same journal as A1, different title (to trigger Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Advanced Metamodeling" year="2019" journal="Journal X">
    <authors author="Bob Writer"/>
    <authors author="Dave Researcher"/>
  </entries>

  <!-- Article A3: same title as A1, different journal (to trigger Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Metamodeling Basics" year="2020" journal="Journal Y">
    <authors author="Eve Analyst"/>
    <authors author="Frank Expert"/>
  </entries>

</BibTeX:BibTeXFile>