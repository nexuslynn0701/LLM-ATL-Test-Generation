<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article A1: unique title and unique journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article"
           id="A1"
           title="Unique Research on MDE"
           year="2018"
           journal="Journal of Unique Software Engineering">
    <authors author="Alice Unique"/>
    <authors author="Bob Shared"/>
  </entries>

  <!-- Article A2: same title as A3 but unique journal (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article"
           id="A2"
           title="Duplicate Title Study"
           year="2019"
           journal="Exclusive Journal">
    <authors author="Charlie Duplicate"/>
    <authors author="Bob Shared"/>
  </entries>

  <!-- Article A3: same title as A2 and journal shared with A4 (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article"
           id="A3"
           title="Duplicate Title Study"
           year="2020"
           journal="Shared Journal of Modeling">
    <authors author="Eve SharedJournal"/>
  </entries>

  <!-- Article A4: different title but same journal as A3 (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article"
           id="A4"
           title="Another View on Models"
           year="2021"
           journal="Shared Journal of Modeling">
    <authors author="Frank Another"/>
  </entries>

  <!-- Book B1: unique title (TitledEntry_Title_NoArticle), authored, dated, publisher -->
  <entries xsi:type="BibTeX:Book"
           id="B1"
           title="Model-Driven Book One"
           year="2015"
           publisher="TechBooks Publishing">
    <authors author="George BookAuthor"/>
    <authors author="Helen SharedName"/>
  </entries>

  <!-- Book B2: same title as B3 (TitledEntry_NoTitle_NoArticle), authored, dated, publisher -->
  <entries xsi:type="BibTeX:Book"
           id="B2"
           title="Repeated Book Title"
           year="2016"
           publisher="Duplicated Titles Press">
    <authors author="Ian Repeated"/>
  </entries>

  <!-- Book B3: same title as B2 (TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:Book"
           id="B3"
           title="Repeated Book Title"
           year="2017"
           publisher="Duplicated Titles Press">
    <authors author="Jane Repeated"/>
  </entries>

  <!-- InBook IB1: unique title (TitledEntry_Title_NoArticle), triggers chapter and publisher -->
  <entries xsi:type="BibTeX:InBook"
           id="IB1"
           title="Chaptered Insights"
           year="2014"
           publisher="Chapter House"
           chapter="3">
    <authors author="Kevin InBookAuthor"/>
  </entries>

  <!-- InCollection IC1: unique title (TitledEntry_Title_NoArticle), uses booktitle + publisher -->
  <entries xsi:type="BibTeX:InCollection"
           id="IC1"
           title="Collected Works in MDE"
           year="2013"
           publisher="Collections Publishing"
           booktitle="Proceedings of MDE Collections">
    <authors author="Laura Collection"/>
    <authors author="Bob Shared"/>
  </entries>

  <!-- Manual M1: unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Manual"
           id="M1"
           title="MDE Tool Manual v1.0">
  </entries>

  <!-- TechReport TR1: unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport"
           id="TR1"
           title="Technical Report on Transformations"
           year="2012">
    <authors author="Mike Reporter"/>
  </entries>

  <!-- Unpublished U1: unique title (TitledEntry_Title_NoArticle), note included -->
  <entries xsi:type="BibTeX:Unpublished"
           id="U1"
           title="Unpublished Findings in MDE"
           note="To appear soon">
    <authors author="Nina Unpub"/>
  </entries>

  <!-- MasterThesis MT1: unique title (TitledEntry_Title_NoArticle), thesis with school -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="MT1"
           title="MDE in Master Studies"
           year="2011"
           school="University of Modeling">
    <authors author="Oscar Master"/>
  </entries>

  <!-- PhDThesis PHD1: unique title (TitledEntry_Title_NoArticle), thesis with school -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="PHD1"
           title="Advanced MDE Techniques"
           year="2010"
           school="Institute of Advanced Modeling">
    <authors author="Patricia PhD"/>
  </entries>

  <!-- Proceedings PR1: unique title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="PR1"
           title="Proceedings of the MDE Conference"
           year="2009">
  </entries>

  <!-- InProceedings IP1: unique title (TitledEntry_Title_NoArticle), booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="IP1"
           title="Paper in MDE Proceedings"
           year="2008"
           booktitle="Proceedings of the MDE Conference">
    <authors author="Quentin InProc"/>
    <authors author="Helen SharedName"/>
  </entries>

  <!-- Booklet BL1: dated, non-titled entry (UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet"
           id="BL1"
           year="2007">
  </entries>

  <!-- Misc MS1: non-titled, non-dated entry (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc"
           id="MS1">
  </entries>

</BibTeX:BibTeXFile>