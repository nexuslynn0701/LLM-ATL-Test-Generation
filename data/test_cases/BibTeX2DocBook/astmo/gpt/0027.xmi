<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (R3: Misc, Booklet) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2010"/>

  <!-- Articles to exercise all Article rules R6–R9 and journal/title uniqueness logic -->
  <!-- a1: unique title and journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Unique Article A" year="2001" journal="Journal X">
    <authors author="Alice Alpha"/>
  </entries>

  <!-- a2 & a3: same title, different journals -> one in Article_NoTitle_Journal, one in Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Shared Title 1" year="2002" journal="Journal Y">
    <authors author="Bob Beta"/>
    <authors author="Carol Gamma"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a3" title="Shared Title 1" year="2003" journal="Journal Z">
    <authors author="Alice Alpha"/>
  </entries>

  <!-- a4 & a5: same journal, different titles -> one in Article_Title_NoJournal, one in Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a4" title="Article JQ 1" year="2004" journal="Journal Q">
    <authors author="Dave Delta"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a5" title="Article JQ 2" year="2005" journal="Journal Q">
    <authors author="Eve Epsilon"/>
    <authors author="Frank Phi"/>
  </entries>

  <!-- a6 & a7: same title and same journal -> one in Article_NoTitle_NoJournal, one in Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="a6" title="Repeated TJ" year="2006" journal="Journal R">
    <authors author="George Gamma"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a7" title="Repeated TJ" year="2007" journal="Journal R">
    <authors author="Helen Eta"/>
  </entries>

  <!-- Non-article titled entries exercising R4 and R5, plus distinct-title logic -->
  <!-- Unique titles (go through TitledEntry_Title_NoArticle and contribute to Titles List) -->

  <!-- Manual with unique title -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Tool Manual 1"/>

  <!-- TechReport with unique title -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Tech Report Alpha" year="2011">
    <authors author="Ivan Iota"/>
  </entries>

  <!-- Proceedings with unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proceedings P1" year="2012"/>

  <!-- InProceedings with unique title and own booktitle -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="InProc Unique" year="2013" booktitle="Booktitle IP1">
    <authors author="Jackappa"/>
    <authors author="Kelly Kappa"/>
  </entries>

  <!-- Book with unique title -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Unique Book" year="2000" publisher="Pub House A">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>

  <!-- InBook with unique title -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="InBook Unique" year="1999" publisher="Pub House B" chapter="3">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- PhDThesis with unique title -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="PhD Thesis One" year="2014" school="Uni A">
    <authors author="Dave Delta"/>
  </entries>

  <!-- MasterThesis with unique title -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" title="Master Thesis One" year="2015" school="Uni B">
    <authors author="Eve Epsilon"/>
  </entries>

  <!-- Unpublished with unique title -->
  <entries xsi:type="BibTeX:Unpublished" id="un1" title="Unpublished Unique" note="Internal note U1">
    <authors author="Frank Phi"/>
  </entries>

  <!-- InCollection with unique title -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="InCollection Unique" year="2016" booktitle="Booktitle IC1" publisher="Pub House C">
    <authors author="George Gamma"/>
  </entries>

  <!-- Duplicate-title scenarios for non-article titled entries to exercise TitledEntry_NoTitle_NoArticle (R5) -->

  <!-- Two Manuals with same title "Shared Manual Title": first will be in distinct-title set, second only R5 -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="Shared Manual Title"/>
  <entries xsi:type="BibTeX:Manual" id="man3" title="Shared Manual Title"/>

  <!-- Two TechReports with same title "Shared TR Title": first in distinct-title set, second only R5 -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="Shared TR Title" year="2017">
    <authors author="Helen Eta"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="tr3" title="Shared TR Title" year="2018">
    <authors author="Ivan Iota"/>
  </entries>

  <!-- Unpublished pair with same title "Shared Unpublished Title" -->
  <entries xsi:type="BibTeX:Unpublished" id="un2" title="Shared Unpublished Title" note="Note U2">
    <authors author="Jackappa"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="un3" title="Shared Unpublished Title" note="Note U3">
    <authors author="Kelly Kappa"/>
  </entries>

</BibTeX:BibTeXFile>