<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- UntitledEntry: Booklet (no title) -->
  <entries xsi:type="BibTeX:Booklet" id="bklt1" year="2005"/>

  <!-- UntitledEntry: Misc (no title) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- TitledEntry_NoArticle: Manual -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="M_Title_1"/>

  <!-- TitledEntry_NoArticle + duplicate title (no separate title para for this one): TechReport -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="T_Title_Dup" year="2010">
    <authors author="Alice A."/>
    <authors author="Bob B."/>
  </entries>

  <!-- TitledEntry_Title_NoArticle + first occurrence of duplicate title: Unpublished -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="U_Title_1" note="Pending review">
    <authors author="Carol C."/>
  </entries>

  <!-- TitledEntry_NoTitle_NoArticle (second with same title as tr2) -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="T_Title_Dup" year="2012">
    <authors author="Dave D."/>
  </entries>

  <!-- TitledEntry_Title_NoArticle: Book -->
  <entries xsi:type="BibTeX:Book" id="book1" title="B_Title_1" year="2001" publisher="PubHouse A">
    <authors author="Alice A."/>
    <authors author="Eve E."/>
  </entries>

  <!-- TitledEntry_Title_NoArticle: InBook -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="IB_Title_1" year="2002" publisher="PubHouse B" chapter="3">
    <authors author="Frank F."/>
  </entries>

  <!-- TitledEntry_Title_NoArticle: InCollection -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="IC_Title_1" year="2003" publisher="PubHouse C" booktitle="Collected Works Vol. 1">
    <authors author="Grace G."/>
    <authors author="Bob B."/>
  </entries>

  <!-- TitledEntry_NoTitle_NoArticle (duplicate title of incoll1): InCollection -->
  <entries xsi:type="BibTeX:InCollection" id="incoll2" title="IC_Title_1" year="2004" publisher="PubHouse D" booktitle="Collected Works Vol. 2">
    <authors author="Heidi H."/>
  </entries>

  <!-- TitledEntry_Title_NoArticle + Proceedings (base) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="P_Title_1" year="2011"/>

  <!-- TitledEntry_Title_NoArticle + InProceedings -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="IP_Title_1" year="2013" booktitle="P_Title_1">
    <authors author="Ivan I."/>
    <authors author="Carol C."/>
  </entries>

  <!-- TitledEntry_Title_NoArticle: PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Thesis_Title_1" year="2014" school="Tech University">
    <authors author="John J."/>
  </entries>

  <!-- TitledEntry_Title_NoArticle: MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" title="Thesis_Title_2" year="2015" school="Science Institute">
    <authors author="Karen K."/>
  </entries>

  <!-- Article_Title_Journal: unique title, unique journal -->
  <entries xsi:type="BibTeX:Article" id="art1" title="A_Title_1" year="2016" journal="Journal Alpha">
    <authors author="Alice A."/>
    <authors author="Laura L."/>
  </entries>

  <!-- Article_NoTitle_Journal: second article with same title, different journal -->
  <entries xsi:type="BibTeX:Article" id="art2" title="A_Title_1" year="2017" journal="Journal Beta">
    <authors author="Mike M."/>
  </entries>

  <!-- Article_Title_NoJournal: two articles sharing same journal, different titles -->
  <entries xsi:type="BibTeX:Article" id="art3" title="A_Title_2" year="2018" journal="Journal Gamma">
    <authors author="Nina N."/>
    <authors author="Bob B."/>
  </entries>

  <!-- Article_NoTitle_NoJournal: same title and same journal as art3 -->
  <entries xsi:type="BibTeX:Article" id="art4" title="A_Title_2" year="2019" journal="Journal Gamma">
    <authors author="Oscar O."/>
  </entries>

</BibTeX:BibTeXFile>