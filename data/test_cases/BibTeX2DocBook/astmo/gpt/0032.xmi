<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry (Booklet) to trigger UntitledEntry and OCL5 -->
  <entries xsi:type="BibTeX:Booklet" id="bkt1" year="2010"/>

  <!-- Misc also triggers UntitledEntry but has no extra attributes -->
  <entries xsi:type="BibTeX:Misc" id="msc1"/>

  <!-- Unpublished entries: two with same title to exercise TitledEntry_Title_NoArticle / NoTitle_NoArticle and OCL6 -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Shared Title" note="Preprint version">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Shared Title" note="Extended abstract">
    <authors author="Alice Smith"/>
  </entries>

  <!-- MasterThesis: unique title, to use TitledEntry_Title_NoArticle (OCL7 variant, though commented) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" title="Static Analysis of Models" year="2015" school="Tech University">
    <authors author="Carol White"/>
  </entries>

  <!-- PhDThesis: unique title, to use TitledEntry_Title_NoArticle and OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Model Transformations" year="2018" school="Global University">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book (base): unique title, to use TitledEntry_Title_NoArticle and OCL9 -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Model Engineering Basics" year="2012" publisher="Springer">
    <authors author="David King"/>
    <authors author="Eve Brown"/>
  </entries>

  <!-- InBook: triggers TitledEntry_Title_NoArticle and OCL10 -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Transformation Testing" year="2013" publisher="Springer" chapter="5">
    <authors author="Frank Green"/>
  </entries>

  <!-- Proceedings (base) with unique title, for TitledEntry_Title_NoArticle and OCL13 -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="MDE Conference 2020" year="2020"/>

  <!-- Another Proceedings with same title to trigger TitledEntry_NoTitle_NoArticle and OCL13 multiplicity pattern -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" title="MDE Conference 2020" year="2021"/>

  <!-- InProceedings: will use TitledEntry_Title_NoArticle and OCL14 -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Testing Transformations" year="2020" booktitle="MDE Conference 2020">
    <authors author="George Hall"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Book used as container type for InCollection, but InCollection has its own id/title/year/publisher- booktitle attribute used via BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Chapter on MDE" year="2014" publisher="Elsevier" booktitle="Handbook of Software Engineering">
    <authors author="Helen Clark"/>
  </entries>

  <!-- TechReport: unique title, triggers TitledEntry_Title_NoArticle and OCL11 -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="MDE Tools Survey" year="2016">
    <authors author="Ian Lee"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Manual: unique title, triggers TitledEntry_Title_NoArticle and OCL12 -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL User Guide"/>

  <!-- Articles to cover Article_* rules and OCL16/19/27 -->

  <!-- Article 1: unique title and unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art1" title="ATL in Practice" year="2011" journal="Journal of MDE">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article 2: same title as art1, different journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="art2" title="ATL in Practice" year="2012" journal="Software Engineering Letters">
    <authors author="Carol White"/>
  </entries>

  <!-- Article 3: different title, same journal as art2 -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Model Transformations Overview" year="2013" journal="Software Engineering Letters">
    <authors author="David King"/>
  </entries>

  <!-- Article 4: same title and same journal as art3 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Model Transformations Overview" year="2014" journal="Software Engineering Letters">
    <authors author="Eve Brown"/>
    <authors author="Frank Green"/>
  </entries>

</BibTeX:BibTeXFile>