<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- UntitledEntry via Misc -->
  <entries xsi:type="BibTeX:Misc" id="miscA"/>

  <!-- Booklet (DatedEntry but not TitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2010"/>

  <!-- Manual (TitledEntry, no authors/year) -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="MDE Handbook"/>

  <!-- Proceedings P1 -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="ECMFA 2014" year="2014"/>

  <!-- Proceedings P2 with the same title as P1 (triggers TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" title="ECMFA 2014" year="2015"/>

  <!-- TechReport (Authored, Dated, Titled) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Model Transformation Testing" year="2012">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Unpublished (Authored, Titled, note) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Draft on ATL Semantics" note="Under review">
    <authors author="Charlie Brown"/>
  </entries>

  <!-- Book B1 - Authored, Dated, Titled -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Foundations of MDE" year="2011" publisher="Springer">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book B2 with same title as B1 (TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:Book" id="book2" title="Foundations of MDE" year="2013" publisher="Elsevier">
    <authors author="David Clark"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="MDE in Practice" year="2015" publisher="ACM Press" chapter="3">
    <authors author="Eve Adams"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Reusable Transformations" year="2016" publisher="IEEE" booktitle="Proceedings of MDEWS">
    <authors author="Charlie Brown"/>
  </entries>

  <!-- InProceedings IP1 -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Testing ATL Transformations" year="2018" booktitle="ECMFA 2018">
    <authors author="Alice Smith"/>
    <authors author="Frank Miller"/>
  </entries>

  <!-- InProceedings IP2 with same title as IP1 (TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" title="Testing ATL Transformations" year="2019" booktitle="MoDELS 2019">
    <authors author="George King"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Model-Driven Testing" year="2017" school="University of Seville">
    <authors author="Helen Moore"/>
  </entries>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Topics in MDE" year="2020" school="Technical University">
    <authors author="Ian Walker"/>
  </entries>

  <!-- Article A1 (unique title and journal) -->
  <entries xsi:type="BibTeX:Article" id="a1" title="ATL in Industry" year="2013" journal="SoSyM">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article A2 (same title as A1, different journal) -->
  <entries xsi:type="BibTeX:Article" id="a2" title="ATL in Industry" year="2014" journal="JOT">
    <authors author="David Clark"/>
  </entries>

  <!-- Article A3 (different title, same journal as A2 and A4) -->
  <entries xsi:type="BibTeX:Article" id="a3" title="ATL Case Studies" year="2015" journal="JOT">
    <authors author="Charlie Brown"/>
    <authors author="Eve Adams"/>
  </entries>

  <!-- Article A4 (third article in journal JOT, different title) -->
  <entries xsi:type="BibTeX:Article" id="a4" title="Model Transformation Benchmarks" year="2016" journal="JOT">
    <authors author="Frank Miller"/>
  </entries>

</BibTeX:BibTeXFile>