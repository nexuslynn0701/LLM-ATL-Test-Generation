    <authors author="Alice Smith"/>
  </entries>

  <!-- Article sharing title with art3 but unique journal: R7 (Article_NoTitle_Journal) for art2 -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Shared Title A" year="2019" journal="Journal A">
    <authors author="Bob Brown"/>
  </entries>

  <!-- Article sharing title with art2, but unique journal: R6 (Article_Title_Journal) for art3 -->
