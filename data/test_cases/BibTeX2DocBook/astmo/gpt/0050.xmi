  <!-- InCollection (subclass of Book) with unique title: R4 (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Collected Works" year="2012" publisher="Publisher Four" booktitle="Collection Volume 1">
