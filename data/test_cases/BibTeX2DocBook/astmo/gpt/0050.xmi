  </entries>

  <!-- Manual with title duplicated in book2: R4 for this manual, R5 for book2 -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Shared Resource Manual"/>
  
  <!-- Book with unique title: R4 (TitledEntry_Title_NoArticle) and pure Book for OCL9 -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Standalone Book" year="2015" publisher="Publisher One">
    <authors author="Carol Clark"/>
