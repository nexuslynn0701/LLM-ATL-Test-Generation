    <authors author="Bob Brown"/>
  </entries>

  <!-- Article sharing title with art5 but unique journal: R7 (Article_NoTitle_Journal) for art6 -->
  <entries xsi:type="BibTeX:Article" id="art6" title="Repeated Title C" year="2023" journal="Journal D">
    <authors author="Carol Clark"/>
  </entries>

