<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger UntitledEntry (Booklet) -->
  <entries xsi:type="BibTeX:Booklet" id="bklt1" year="2020"/>

  <!-- Misc also triggers UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Unpublished (titled, no authors) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Shared Title One" note="draft note 1">
    <authors author="Dana Author"/>
  </entries>

  <!-- Unpublished with same title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub2" title="Shared Title One" note="draft note 2">
    <authors author="Evan Writer"/>
  </entries>

  <!-- Manual, unique title -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Tool Reference Manual"/>

  <!-- TechReport, unique title -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Performance Study" year="2018">
    <authors author="Frank Researcher"/>
  </entries>

  <!-- Proceedings (base type, not child), unique title -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conf A Proceedings" year="2019"/>

  <!-- InProceedings with same title as another entry to exercise duplication logic -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Deep Analysis" year="2021" booktitle="Conf A 2021">
    <authors author="Alice Author"/>
    <authors author="Bob Researcher"/>
  </entries>

  <!-- InProceedings sharing the same title to trigger TitledEntry_NoTitle_NoArticle on one of them -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc2" title="Deep Analysis" year="2022" booktitle="Conf B 2022">
    <authors author="Chris Scientist"/>
  </entries>

  <!-- Book (base type), unique title -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Model Engineering Handbook" year="2015" publisher="TechPress">
    <authors author="George Modeler"/>
    <authors author="Helen Engineer"/>
  </entries>

  <!-- InBook (child of Book) with unique title -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Chapter on Transformations" year="2016" publisher="TechPress" chapter="3">
    <authors author="Ian Developer"/>
  </entries>

  <!-- InCollection (child of Book) with unique title -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Case Studies in MDE" year="2017" publisher="SoftPub" booktitle="Advances in MDE">
    <authors author="Jane Analyst"/>
  </entries>

  <!-- PhDThesis, unique title -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Scalable Model Transformations" year="2014" school="University X">
    <authors author="Kevin Doctoral"/>
  </entries>

  <!-- MasterThesis, unique title -->
  <entries xsi:type="BibTeX:MasterThesis" id="msc1" title="Testing of Model Transformations" year="2013" school="University Y">
    <authors author="Laura Master"/>
  </entries>

  <!-- Article A: unique title, journal J1 -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Incremental Transformations" year="2011" journal="Journal of MDE">
    <authors author="Alice Author"/>
    <authors author="Bob Researcher"/>
  </entries>

  <!-- Article B: same title as art1, same journal J1 -> Article_NoTitle_NoJournal for one of them -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Incremental Transformations" year="2012" journal="Journal of MDE">
    <authors author="Chris Scientist"/>
  </entries>

  <!-- Article C: unique title, new journal J2; another article shares that journal -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Model Synchronization" year="2010" journal="Software Systems Journal">
    <authors author="Dana Author"/>
  </entries>

  <!-- Article D: different title, same journal J2 -> Article_Title_NoJournal for one of (art3, art4) -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Bidirectional Transformations" year="2009" journal="Software Systems Journal">
    <authors author="Evan Writer"/>
  </entries>

  <!-- Article E: unique title, unique journal J3 -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="art5" title="Traceability in MDE" year="2013" journal="Engineering Reports">
    <authors author="Frank Researcher"/>
  </entries>

</BibTeX:BibTeXFile>