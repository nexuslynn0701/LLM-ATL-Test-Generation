<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- UntitledEntry via Misc -->
  <entries xsi:type="BibTeX:Misc" id="E01"/>

  <!-- Booklet (no title, no authors, dated) -> UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="E02" year="2001"/>

  <!-- Manual (titled, no authors, no date) -->
  <entries xsi:type="BibTeX:Manual" id="E03" title="User Guide"/>

  <!-- Manual with duplicate title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Manual" id="E04" title="User Guide"/>

  <!-- Proceedings (titled, dated) -->
  <entries xsi:type="BibTeX:Proceedings" id="E05" title="Conference 2020" year="2020"/>

  <!-- Proceedings with duplicate title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="E06" title="Conference 2020" year="2021"/>

  <!-- Book (titled, authored, dated, publisher) -->
  <entries xsi:type="BibTeX:Book" id="E07" title="MDE Basics" year="2015" publisher="TechPress">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Book with same title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Book" id="E08" title="MDE Basics" year="2016" publisher="TechPress"/>
  
  <!-- InBook (Book subclass, titled, authored, dated, publisher, chapter) -->
  <entries xsi:type="BibTeX:InBook" id="E09" title="MDE Advanced" year="2018" publisher="SciPub" chapter="3">
    <authors author="Carol White"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry, titled, authored, dated, publisher, booktitle) -->
  <entries xsi:type="BibTeX:InCollection" id="E10" title="Models Everywhere" year="2019" publisher="SciPub" booktitle="Handbook of Modeling">
    <authors author="Alice Smith"/>
  </entries>

  <!-- InProceedings (Proceedings + Authored + BookTitledEntry, titled, authored, dated, booktitle) -->
  <entries xsi:type="BibTeX:InProceedings" id="E11" title="Testing Transformations" year="2020" booktitle="ICMT 2020">
    <authors author="Bob Jones"/>
    <authors author="Dana King"/>
  </entries>

  <!-- TechReport (titled, authored, dated) -->
  <entries xsi:type="BibTeX:TechReport" id="E12" title="Report on MDE" year="2014">
    <authors author="Eve Black"/>
  </entries>

  <!-- Unpublished (titled, authored, note) -->
  <entries xsi:type="BibTeX:Unpublished" id="E13" title="Unreleased Study" note="To appear">
    <authors author="Frank Green"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- PhDThesis (ThesisEntry: titled, authored, dated, school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="E14" title="Model Transformations" year="2013" school="Uni A">
    <authors author="Carol White"/>
  </entries>

  <!-- MasterThesis (ThesisEntry: titled, authored, dated, school) -->
  <entries xsi:type="BibTeX:MasterThesis" id="E15" title="Model Validation" year="2012" school="Uni B">
    <authors author="Dana King"/>
  </entries>

  <!-- Article A1: unique title & unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="E16" title="Article One" year="2010" journal="Journal A">
    <authors author="Alice Smith"/>
    <authors author="George Hill"/>
  </entries>

  <!-- Article A2: same title as A3, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="E17" title="Shared Title" year="2011" journal="Journal B">
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article A3: same title as A2, unique journal -> Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="E18" title="Shared Title" year="2012" journal="Journal C">
    <authors author="Carol White"/>
  </entries>

  <!-- Article A4: unique title, journal J-Common (shared with A5) -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="E19" title="Unique in Common Journal" year="2013" journal="Journal Common">
    <authors author="Dana King"/>
  </entries>

  <!-- Article A5: different title, same journal J-Common -> Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="E20" title="Another in Common Journal" year="2014" journal="Journal Common">
    <authors author="Eve Black"/>
  </entries>

  <!-- Article A6: same title and same journal as A7 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="E21" title="Duplicate Full" year="2015" journal="Journal D">
    <authors author="Frank Green"/>
  </entries>

  <!-- Article A7: same title and same journal as A6 -> Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="E22" title="Duplicate Full" year="2016" journal="Journal D">
    <authors author="George Hill"/>
  </entries>

</BibTeX:BibTeXFile>