<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with unique title and journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Graph Transformations in Practice" year="2018" journal="Journal of Model Engineering">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- Article sharing title with A3 but unique journal (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="A2" title="Model Transformations Survey" year="2019" journal="Software Systems Journal">
    <authors author="Clara Researcher"/>
  </entries>

  <!-- Article sharing title with A2 and journal with A4 (Article_Title_NoJournal: in title set but not in journal set) -->
  <entries xsi:type="BibTeX:Article" id="A3" title="Model Transformations Survey" year="2020" journal="Advanced Computing Journal">
    <authors author="Dave Scientist"/>
  </entries>

  <!-- Article with unique title but sharing journal with A3 (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A4" title="Incremental Model Synchronization" year="2021" journal="Advanced Computing Journal">
    <authors author="Alice Author"/>
  </entries>

  <!-- Article sharing both title and journal with A6 (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A5" title="Parallel ATL Execution" year="2017" journal="Journal of Model Engineering">
    <authors author="Eve Developer"/>
  </entries>

  <!-- Second article with same title and journal as A5 (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="A6" title="Parallel ATL Execution" year="2016" journal="Journal of Model Engineering">
    <authors author="Frank Engineer"/>
  </entries>

  <!-- TechReport with duplicated title (first occurrence, gets title paragraph) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Experimental Evaluation of Transformations" year="2015">
    <authors author="George Analyst"/>
  </entries>

  <!-- TechReport with same title as TR1 (no extra title paragraph) -->
  <entries xsi:type="BibTeX:TechReport" id="TR2" title="Experimental Evaluation of Transformations" year="2016">
    <authors author="Helen Scientist"/>
  </entries>

  <!-- Manual with unique title -->
  <entries xsi:type="BibTeX:Manual" id="M1" title="ATL User Guide"/>
  
  <!-- Proceedings with unique title (base Proceedings, not child) -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" title="Proceedings of MDE 2020" year="2020"/>

  <!-- InProceedings with unique title and booktitle -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Testing Model Transformations" year="2020" booktitle="Proceedings of MDE 2020">
    <authors author="Alice Author"/>
    <authors author="Clara Researcher"/>
  </entries>

  <!-- Book with unique title -->
  <entries xsi:type="BibTeX:Book" id="B1" title="Foundations of Model-Driven Engineering" year="2014" publisher="TechBooks Publishing">
    <authors author="Bob Writer"/>
  </entries>

  <!-- InBook with unique title and chapter -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chapter on ATL Semantics" year="2014" publisher="TechBooks Publishing" chapter="5">
    <authors author="Alice Author"/>
  </entries>

  <!-- InCollection with unique title and booktitle -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Case Studies in MDE" year="2013" booktitle="Handbook of Software Engineering" publisher="SpringerPress">
    <authors author="George Analyst"/>
  </entries>

  <!-- Unpublished with unique title and note -->
  <entries xsi:type="BibTeX:Unpublished" id="U1" title="Unreleased ATL Optimization Techniques" note="Manuscript in preparation">
    <authors author="Frank Engineer"/>
    <authors author="Helen Scientist"/>
  </entries>

  <!-- Booklet (dated but untitled entry – exercises UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="BL1" year="2012"/>

  <!-- Misc (completely untitled, exercises UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="MS1"/>

  <!-- PhDThesis with unique title and school -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Scalable Model Transformation Frameworks" year="2011" school="University of Model Engineering">
    <authors author="Clara Researcher"/>
  </entries>

  <!-- MasterThesis with duplicated title (with MT2) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Empirical Studies of ATL" year="2010" school="Tech University">
    <authors author="Dave Scientist"/>
  </entries>

  <!-- Second MasterThesis sharing same title as MT1 -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT2" title="Empirical Studies of ATL" year="2012" school="Innovation Institute">
    <authors author="Eve Developer"/>
  </entries>

</BibTeX:BibTeXFile>