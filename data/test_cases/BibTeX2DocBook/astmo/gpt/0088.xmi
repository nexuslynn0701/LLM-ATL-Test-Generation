  </entries>

  <!-- Proceedings (base Proceedings, no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Conference on Software Engineering" year="2018"/>

  <!-- Book (base Book, authored, dated, publisher) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Foundations of Model Transformations" year="2010" publisher="Springer">
