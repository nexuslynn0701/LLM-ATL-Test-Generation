  <!-- Misc entry: another untitled entry (also R3) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Manual (titled, no authors, no year) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Practical Modeling Guide"/>

