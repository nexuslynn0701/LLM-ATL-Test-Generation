    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Booklet" id="B1" year="2010"/>
  <entries xsi:type="BibTeX:Misc" id="M1"/>

  <!-- Manual (Titled, no authors, no date; TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Manual" id="MN1" title="DocBook Manual"/>

  <!-- Proceedings (dated, titled; TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Proceedings" id="P1" title="Proceedings of MDE" year="2012"/>

  <!-- InProceedings (Authored, Dated, BookTitled; TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="MDE in Practice" year="2012" booktitle="Proceedings of MDE">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Book (Authored, Dated, Titled; TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Book" id="BK1" title="Model Engineering" year="2015" publisher="Springer">
    <authors author="Carol White"/>
  </entries>

  <!-- InBook (Book + chapter; TitledEntry_Title_NoArticle) -->
