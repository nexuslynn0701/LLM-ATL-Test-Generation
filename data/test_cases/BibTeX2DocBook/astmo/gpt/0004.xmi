    <authors author="Carol White"/>
    <authors author="David Black"/>
  </entries>

  <!-- InCollection (Book + BookTitled; TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="MDE Case Studies" year="2016" publisher="Elsevier" booktitle="Advances in MDE">
    <authors author="Eve Green"/>
  </entries>

  <!-- MasterThesis (ThesisEntry; TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Testing Model Transformations" year="2018" school="University of Testing">
    <authors author="Frank Brown"/>
  </entries>

  <!-- PhDThesis (ThesisEntry; TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Advanced Model Transformation Testing" year="2019" school="Tech University">
    <authors author="Grace Hall"/>
  </entries>

  <!-- TechReport (Authored, Dated, Titled; TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="ATL Performance Report" year="2020">
    <authors author="Henry King"/>
  </entries>

  <!-- Unpublished (Authored, Titled, note; TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Draft on Model Testing" note="to appear">
