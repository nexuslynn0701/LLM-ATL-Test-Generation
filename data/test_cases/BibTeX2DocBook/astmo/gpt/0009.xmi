<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger R3 (UntitledEntry): Misc -->
  <entries xsi:type="BibTeX:Misc" id="E01"/>

  <!-- Booklet (also untitled, triggers R3) -->
  <entries xsi:type="BibTeX:Booklet" id="E02" year="2001"/>

  <!-- Manual (titled, no authors/dates -> R4) -->
  <entries xsi:type="BibTeX:Manual" id="E03" title="DocBook User Guide"/>

  <!-- Unpublished (titled, authored -> R4) -->
  <entries xsi:type="BibTeX:Unpublished" id="E04" title="Early Draft on MDE" note="to appear soon">
    <authors author="Alice Smith"/>
  </entries>

  <!-- TechReport (titled, authored, dated -> R4) -->
  <entries xsi:type="BibTeX:TechReport" id="E05" title="MDE Survey Report" year="2010">
    <authors author="Bob Johnson"/>
    <authors author="Carol King"/>
  </entries>

  <!-- Proceedings (titled, dated; base instance, not child -> R4) -->
  <entries xsi:type="BibTeX:Proceedings" id="E06" title="ICMT Proceedings" year="2012"/>

  <!-- InProceedings #1 (titled, authored, booktitle, year -> R4) -->
  <entries xsi:type="BibTeX:InProceedings" id="E07" title="Model Transformations in Practice" year="2012" booktitle="ICMT">
    <authors author="Alice Smith"/>
    <authors author="David Lee"/>
  </entries>

  <!-- InCollection (titled, authored, year, booktitle, publisher -> R4) -->
  <entries xsi:type="BibTeX:InCollection" id="E08" title="Chapter on ATL" year="2013" booktitle="Advanced MDE" publisher="TechBooks">
    <authors author="Eve Adams"/>
    <authors author="Frank Moore"/>
  </entries>

  <!-- Book (base Book, not child; titled, authored, year, publisher -> R4) -->
  <entries xsi:type="BibTeX:Book" id="E09" title="Foundations of MDE" year="2008" publisher="Springer">
    <authors author="Alice Smith"/>
    <authors author="George Brown"/>
  </entries>

  <!-- InBook (child of Book; titled, authored, year, publisher, chapter -> R4) -->
  <entries xsi:type="BibTeX:InBook" id="E10" title="Chapter 5: Transformations" year="2008" publisher="Springer" chapter="5">
    <authors author="George Brown"/>
  </entries>

  <!-- MasterThesis (titled, authored, year, school -> R4) -->
  <entries xsi:type="BibTeX:MasterThesis" id="E11" title="Model-Driven Development of Tools" year="2014" school="University A">
    <authors author="Helen Clark"/>
  </entries>

  <!-- PhDThesis (titled, authored, year, school -> R4) -->
  <entries xsi:type="BibTeX:PhDThesis" id="E12" title="Scalable Model Transformations" year="2016" school="University B">
    <authors author="Ian Wright"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article A1: unique title, unique journal -> R6 -->
  <entries xsi:type="BibTeX:Article" id="E13" title="ATL in Industry" year="2015" journal="Software Engineering Journal">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article A2: same title as A3, unique journal -> R7 (no title para, has journal para) -->
  <entries xsi:type="BibTeX:Article" id="E14" title="Testing Model Transformations" year="2017" journal="Journal of MDE">
    <authors author="Carol King"/>
  </entries>

  <!-- Article A3: same title as A2, unique journal -> R7 (no title para, has journal para) -->
  <entries xsi:type="BibTeX:Article" id="E15" title="Testing Model Transformations" year="2018" journal="Journal of Software Quality">
    <authors author="David Lee"/>
  </entries>

  <!-- Article A4: unique title, journal shared with A5 -> R8 (title para, no journal para) -->
  <entries xsi:type="BibTeX:Article" id="E16" title="Incremental Transformations" year="2019" journal="Modeling Journal">
    <authors author="Eve Adams"/>
    <authors author="Frank Moore"/>
  </entries>

  <!-- Article A5: another unique title, same journal as A4 -> R8 (title para, no journal para) -->
  <entries xsi:type="BibTeX:Article" id="E17" title="Efficient Trace Management" year="2020" journal="Modeling Journal">
    <authors author="George Brown"/>
  </entries>

  <!-- Article A6: same title and journal as A7 -> R9 (no title/journal paras) -->
  <entries xsi:type="BibTeX:Article" id="E18" title="Reusable Model Transformations" year="2021" journal="Patterns in MDE">
    <authors author="Helen Clark"/>
  </entries>

  <!-- Article A7: same title and journal as A6 -> R9 (no title/journal paras) -->
  <entries xsi:type="BibTeX:Article" id="E19" title="Reusable Model Transformations" year="2022" journal="Patterns in MDE">
    <authors author="Ian Wright"/>
  </entries>

</BibTeX:BibTeXFile>