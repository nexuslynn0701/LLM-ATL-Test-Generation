<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger R3 (UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>

  <!-- Booklet (untitled, dated) also through R3 -->
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2009"/>

  <!-- Manual (titled, no authors/year) -> R4 -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Modeling Toolkit"/>

  <!-- TechReport with its own title -> R4 -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Verification Report" year="2010">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- TechReport sharing title "Shared Title" with a Book -> R5 for both -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="Shared Title" year="2011">
    <authors author="Carol White"/>
  </entries>

  <!-- Book (base Book, not subclass) with same title "Shared Title" as tr2 -> R5 -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Shared Title" year="2012" publisher="Springer">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book (base) with unique title -> R4 -->
  <entries xsi:type="BibTeX:Book" id="book2" title="Unique Book" year="2013" publisher="MIT Press">
    <authors author="Dan Brown"/>
    <authors author="Eve Black"/>
  </entries>

  <!-- InBook (unique title) -> R4, plus chapter -->
  <entries xsi:type="BibTeX:InBook" id="inb1" title="Chaptered Work" year="2014" publisher="Elsevier" chapter="7">
    <authors author="Frank Green"/>
  </entries>

  <!-- Proceedings (base, unique title) -> R4 and also selected in OCL as base Proceedings -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proc Conference A" year="2015"/>

  <!-- PhDThesis with unique title -> R4 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="PhD on Modeling" year="2016" school="Uni A">
    <authors author="Grace Hall"/>
  </entries>

  <!-- MasterThesis with unique title -> R4 (OCL7 is commented, but rule still exercised) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mst1" title="Mastering Transformations" year="2017" school="Uni B">
    <authors author="Ian King"/>
  </entries>

  <!-- InCollection with unique title -> R4 -->
  <entries xsi:type="BibTeX:InCollection" id="inc1" title="Collected Chapter" year="2018" publisher="OUP" booktitle="Collected Vol. 1">
    <authors author="Alice Smith"/>
  </entries>

  <!-- InProceedings with unique title and booktitle -> R4 -->
  <entries xsi:type="BibTeX:InProceedings" id="inp1" title="Conference Paper One" year="2019" booktitle="Conf A 2019">
    <authors author="Bob Jones"/>
    <authors author="Carol White"/>
  </entries>

  <!-- Unpublished with unique title and note -> R4 -->
  <entries xsi:type="BibTeX:Unpublished" id="unp1" title="Draft Work" note="To appear soon">
    <authors author="Dan Brown"/>
  </entries>

  <!-- Article A: triggers Article_Title_Journal (R6) with unique title and journal -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Article One" year="2020" journal="Journal X">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article B: same journal as art1 but different title -> Article_Title_NoJournal (R8) -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Article Two" year="2021" journal="Journal X">
    <authors author="Carol White"/>
  </entries>

  <!-- Article C: same title as art2 but different journal -> Article_NoTitle_Journal (R7) -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Article Two" year="2022" journal="Journal Y">
    <authors author="Dan Brown"/>
  </entries>

  <!-- Article D: same title and journal as art1 -> Article_NoTitle_NoJournal (R9) -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Article One" year="2023" journal="Journal X">
    <authors author="Eve Black"/>
  </entries>

</BibTeX:BibTeXFile>