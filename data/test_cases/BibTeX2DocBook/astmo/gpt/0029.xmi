<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger R3 (UntitledEntry): Misc -->
  <entries xsi:type="BibTeX:Misc" id="miscA"/>

  <!-- Untitled, dated entry to trigger R3 with year: Booklet -->
  <entries xsi:type="BibTeX:Booklet" id="bookletA" year="1999"/>

  <!-- Unpublished with unique title to trigger R4 -->
  <entries xsi:type="BibTeX:Unpublished" id="unpubA" title="A Unique Unpublished Work" note="work in progress">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- MasterThesis with unique title to trigger R4 -->
  <entries xsi:type="BibTeX:MasterThesis" id="mstA" title="Mastering Model Transformation" year="2010" school="Tech University">
    <authors author="Carol Researcher"/>
  </entries>

  <!-- PhDThesis with unique title to trigger R4 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phdA" title="Advanced Topics in MDE" year="2015" school="Science Institute">
    <authors author="Dave Scholar"/>
    <authors author="Eve Scientist"/>
  </entries>

  <!-- Book with unique title to trigger R4 -->
  <entries xsi:type="BibTeX:Book" id="bookA" title="Foundations of Modeling" year="2005" publisher="Modeling Press">
    <authors author="Frank Author"/>
  </entries>

  <!-- InBook with unique title to trigger R4 -->
  <entries xsi:type="BibTeX:InBook" id="inbookA" title="Chapter on Transformations" year="2006" publisher="Modeling Press" chapter="3">
    <authors author="Grace Writer"/>
  </entries>

  <!-- Manual with unique title to trigger R4 -->
  <entries xsi:type="BibTeX:Manual" id="manualA" title="Tool User Guide"/>
  
  <!-- Proceedings with unique title to trigger R4 -->
  <entries xsi:type="BibTeX:Proceedings" id="procA" title="MDE Conference Proceedings" year="2018"/>

  <!-- InProceedings with unique title and booktitle to trigger R4 -->
  <entries xsi:type="BibTeX:InProceedings" id="inprocA" title="A Paper on Transformations" year="2018" booktitle="MDE Conference Proceedings">
    <authors author="Helen Developer"/>
  </entries>

  <!-- InCollection with unique title and book publisher to trigger R4 -->
  <entries xsi:type="BibTeX:InCollection" id="incolA" title="A Collected Chapter" year="2012" booktitle="Collected Works on MDE" publisher="Scholarly Books">
    <authors author="Ian Contributor"/>
  </entries>

  <!-- TechReport with unique title to trigger R4 -->
  <entries xsi:type="BibTeX:TechReport" id="techA" title="Technical Report on MDE" year="2011">
    <authors author="Jane Engineer"/>
  </entries>

  <!-- Article 1: unique title and journal to trigger R6 -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Model Transformation Basics" year="2020" journal="Journal of MDE">
    <authors author="Alice Author"/>
    <authors author="Frank Author"/>
  </entries>

  <!-- Article 2: same title as art1, different journal to trigger R7 (no title, distinct journals) -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Model Transformation Basics" year="2021" journal="Software Engineering Today">
    <authors author="Bob Writer"/>
  </entries>

  <!-- Article 3: different title, same journal as art1 to trigger R8 (title, no journal) -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Advanced Transformation Patterns" year="2022" journal="Journal of MDE">
    <authors author="Carol Researcher"/>
    <authors author="Dave Scholar"/>
  </entries>

  <!-- Article 4: same title as art3 and same journal as art3 to trigger R9 (no title, no journal) -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Advanced Transformation Patterns" year="2023" journal="Journal of MDE">
    <authors author="Eve Scientist"/>
  </entries>

</BibTeX:BibTeXFile>