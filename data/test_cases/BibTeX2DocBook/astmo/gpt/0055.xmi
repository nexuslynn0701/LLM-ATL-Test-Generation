<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc (untitled, no authors, no date) -->
  <entries xsi:type="BibTeX:Misc" id="E01"/>

  <!-- Booklet (dated, no title, no authors) -->
  <entries xsi:type="BibTeX:Booklet" id="E02" year="2001"/>

  <!-- Manual (titled, no authors, no date) -->
  <entries xsi:type="BibTeX:Manual" id="E03" title="MTitle1"/>

  <!-- Proceedings (titled, dated, no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="E04" title="PTitle1" year="2002"/>

  <!-- InProceedings (titled, dated, authored, booktitle; child of Proceedings) -->
  <entries xsi:type="BibTeX:InProceedings" id="E05" title="IPTitle1" year="2003" booktitle="ConfBook1">
    <authors author="AuthorA"/>
    <authors author="AuthorB"/>
  </entries>

  <!-- Book (titled, dated, authored, publisher) -->
  <entries xsi:type="BibTeX:Book" id="E06" title="BTitle1" year="2004" publisher="PubHouse1">
    <authors author="AuthorC"/>
  </entries>

  <!-- InBook (titled, dated, authored, publisher, chapter; child of Book) -->
  <entries xsi:type="BibTeX:InBook" id="E07" title="IBTitle1" year="2005" publisher="PubHouse2" chapter="7">
    <authors author="AuthorD"/>
    <authors author="AuthorA"/>
  </entries>

  <!-- InCollection (titled, dated, authored, booktitle, publisher; child of Book & BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection" id="E08" title="ICTitle1" year="2006" booktitle="CollBook1" publisher="PubHouse3">
    <authors author="AuthorE"/>
  </entries>

  <!-- MasterThesis (titled, dated, authored, school) -->
  <entries xsi:type="BibTeX:MasterThesis" id="E09" title="ThesisTitle1" year="2007" school="Uni1">
    <authors author="AuthorF"/>
  </entries>

  <!-- PhDThesis (titled, dated, authored, school) -->
  <entries xsi:type="BibTeX:PhDThesis" id="E10" title="ThesisTitle2" year="2008" school="Uni2">
    <authors author="AuthorG"/>
    <authors author="AuthorH"/>
  </entries>

  <!-- TechReport (titled, dated, authored) -->
  <entries xsi:type="BibTeX:TechReport" id="E11" title="TRTitle1" year="2009">
    <authors author="AuthorI"/>
  </entries>

  <!-- Unpublished (titled, authored, note) -->
  <entries xsi:type="BibTeX:Unpublished" id="E12" title="UPTitle1" note="Draft version">
    <authors author="AuthorJ"/>
    <authors author="AuthorK"/>
  </entries>

  <!-- Article 1 (unique title & journal) -->
  <entries xsi:type="BibTeX:Article" id="E13" title="ATitle1" year="2010" journal="JournalX">
    <authors author="AuthorL"/>
  </entries>

  <!-- Article 2 (same title as Article 3, unique journal) -->
  <entries xsi:type="BibTeX:Article" id="E14" title="ATitle2" year="2011" journal="JournalY">
    <authors author="AuthorM"/>
    <authors author="AuthorN"/>
  </entries>

  <!-- Article 3 (same title as Article 2, unique journal) -->
  <entries xsi:type="BibTeX:Article" id="E15" title="ATitle2" year="2012" journal="JournalZ">
    <authors author="AuthorO"/>
  </entries>

</BibTeX:BibTeXFile>