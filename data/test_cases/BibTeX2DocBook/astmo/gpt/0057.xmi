<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc: untitled entry (R3) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>

  <!-- Booklet: dated but untitled (R3, OCL5) -->
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="1999"/>

  <!-- Manual: titled, no authors/date (R4, OCL12) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="DocBook Manual"/>

  <!-- Unpublished: authored & titled, note (R4, OCL6) -->
  <entries xsi:type="BibTeX:Unpublished" id="up1" title="Draft Transformation" note="to appear">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Book: authored, dated, titled, publisher (R4, OCL9) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Model Transformations" year="2015" publisher="Springer">
    <authors author="Alice Smith"/>
    <authors author="Carlos Ruiz"/>
  </entries>

  <!-- InBook: subclass of Book, has chapter (R4, OCL10) -->
  <entries xsi:type="BibTeX:InBook" id="inb1" title="Model Transformations" year="2016" publisher="Springer" chapter="3">
    <authors author="Diana King"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry (R4, OCL15) -->
  <entries xsi:type="BibTeX:InCollection" id="inc1" title="Advanced MDE" year="2018" publisher="ACM" booktitle="Proceedings of MDEConf">
    <authors author="Ethan Moore"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Proceedings: dated & titled, no authors (R4, OCL13; base type Proceedings) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proceedings of MDEConf" year="2017"/>

  <!-- InProceedings: Proceedings + Authored + BookTitledEntry (R4, OCL14; also base type Proceedings) -->
  <entries xsi:type="BibTeX:InProceedings" id="inp1" title="Scalable Transformations" year="2017" booktitle="Proceedings of MDEConf">
    <authors author="Bob Jones"/>
    <authors author="Fiona Lee"/>
  </entries>

  <!-- TechReport: authored, dated, titled (R4, OCL11) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Testing Model Transformations" year="2014">
    <authors author="Carlos Ruiz"/>
  </entries>

  <!-- PhDThesis: authored, dated, titled, school (R4, OCL8) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Formal Verification of ATL" year="2013" school="University of Seville">
    <authors author="Alice Smith"/>
  </entries>

  <!-- MasterThesis: authored, dated, titled, school (R4; OCL7 commented but structure preserved) -->
  <entries xsi:type="BibTeX:MasterThesis" id="ms1" title="Empirical Studies in MDE" year="2012" school="Technical University">
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article A1: unique title, unique journal (R6, OCL16; journal seen once) -->
  <entries xsi:type="BibTeX:Article" id="art1" title="ATL Optimization" year="2010" journal="Journal of MDE">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article A2: same title as A3, unique journal (R6, OCL16; title duplicated across art2/art3; journal unique) -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Model Testing Framework" year="2011" journal="Software Engineering Letters">
    <authors author="Carlos Ruiz"/>
  </entries>

  <!-- Article A3: same title as A2, journal duplicated with A4 (R8, OCL16; title & journal both duplicated) -->
  <entries xsi:type="BibTeX:Article" id="art3" title="Model Testing Framework" year="2012" journal="Empirical Software Journal">
    <authors author="Diana King"/>
    <authors author="Ethan Moore"/>
  </entries>

  <!-- Article A4: different title, same journal as A3 (R8, OCL16; journal duplicated) -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Traceability in Transformations" year="2013" journal="Empirical Software Journal">
    <authors author="Fiona Lee"/>
  </entries>

</BibTeX:BibTeXFile>