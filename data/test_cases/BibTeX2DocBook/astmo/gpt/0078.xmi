<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger R3 (UntitledEntry), also counted in OCL5 -->
  <entries xsi:type="BibTeX:Booklet" id="bklt1" year="2015"/>

  <!-- Unpublished (titled, no date) to trigger R4 and OCL6 -->
  <entries xsi:type="BibTeX:Unpublished" id="unp1" title="Unpublished Insights" note="Draft version">
    <authors author="Carol Clark"/>
  </entries>

  <!-- Book (titled, dated, authored, publisher) to trigger R4 and OCL9 -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Model Engineering" year="2012" publisher="TechPress">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- InBook (titled, dated, authored, publisher, chapter) to trigger R4 and OCL10 -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Chapter on Testing" year="2013" publisher="TechPress" chapter="7">
    <authors author="Dave Miller"/>
  </entries>

  <!-- TechReport (titled, dated, authored) to trigger R4 and OCL11 -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Testing Transformations" year="2011">
    <authors author="Eve Adams"/>
  </entries>

  <!-- Manual (titled only) to trigger R4 and OCL12 -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL User Guide"/>

  <!-- Proceedings (titled, dated) base type to trigger R4 and OCL13 (select by oclIsTypeOf) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="MDE Conference" year="2010"/>

  <!-- InProceedings (titled, dated, authored, booktitle) to trigger R4 and OCL14 -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Transformation Testing" year="2010" booktitle="MDE Conference">
    <authors author="Bob Jones"/>
    <authors author="Frank Lee"/>
  </entries>

  <!-- InCollection (titled, dated, authored, booktitle, publisher) to trigger R4 and OCL15 -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Model Transformations" year="2014" booktitle="Advances in MDE" publisher="Springer">
    <authors author="Alice Smith"/>
  </entries>

  <!-- PhDThesis (titled, dated, authored, school) to trigger R4 and OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Scalable Model Transformations" year="2016" school="Univ of Seville">
    <authors author="Carol Clark"/>
  </entries>

  <!-- MasterThesis (titled, dated, authored, school) to satisfy OCL7 realistically, even if rule for theses is commented in OCL text -->
  <entries xsi:type="BibTeX:MasterThesis" id="msc1" title="Testing ATL Transformations" year="2017" school="Tech University">
    <authors author="Dave Miller"/>
  </entries>

  <!-- Article with unique title and unique journal to trigger R6 and OCL16,19 -->
  <entries xsi:type="BibTeX:Article" id="art1" title="Model Transformation Testing" year="2018" journal="Journal of MDE">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Second Article sharing same journal but different title to trigger R8 and distinguish journal-set behavior -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Incremental Transformation Testing" year="2019" journal="Journal of MDE">
    <authors author="Frank Lee"/>
  </entries>

</BibTeX:BibTeXFile>