<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2019"/>

  <!-- Unpublished (TitledEntry, Authored, no date) -->
  <entries xsi:type="BibTeX:Unpublished" id="u1" title="On Model Transformations" note="submitted">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- Manual (TitledEntry only) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="ATL Reference Manual"/>

  <!-- Proceedings (Dated & Titled, no authors; also has child InProceedings) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="MDE Conference" year="2021"/>

  <!-- InProceedings (Authored, Dated, BookTitled, Titled) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="Transformations in Practice" year="2021" booktitle="MDE Conference">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book (Authored, Dated, Titled) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Foundations of MDE" year="2018" publisher="Springer">
    <authors author="Carol White"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- InBook (Book + chapter) with SAME title as book1 to trigger NoTitle variant -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="Foundations of MDE" year="2019" publisher="Springer" chapter="3">
    <authors author="Carol White"/>
  </entries>

  <!-- InCollection (Book + BookTitled) -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Model Testing Techniques" year="2020" publisher="IEEE" booktitle="Advances in Software Engineering">
    <authors author="David Brown"/>
  </entries>

  <!-- TechReport (Authored, Dated, Titled) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Model Transformation Benchmarks" year="2017">
    <authors author="Emily Green"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Testing Model Transformations" year="2016" school="University of Seville">
    <authors author="Frank Black"/>
  </entries>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Scalable Model Transformations" year="2015" school="Technical University">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Articles for different Article_* rules -->

  <!-- Article a1: unique title, unique journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="a1" title="ATL in Practice" year="2014" journal="Journal of MDE">
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article a2: same title as a1, different journal (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="a2" title="ATL in Practice" year="2015" journal="Software Engineering Notes">
    <authors author="Carol White"/>
  </entries>

  <!-- Article a3: different title, same journal as a2 (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="a3" title="Advanced ATL Usage" year="2016" journal="Software Engineering Notes">
    <authors author="David Brown"/>
  </entries>

  <!-- Article a4: same title & journal as a3 (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="a4" title="Advanced ATL Usage" year="2017" journal="Software Engineering Notes">
    <authors author="Emily Green"/>
  </entries>

</BibTeX:BibTeXFile>