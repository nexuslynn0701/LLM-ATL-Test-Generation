<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger UntitledEntry (Booklet) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bkt1"
           year="2018"/>

  <!-- Misc also triggers UntitledEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="msc1"/>

  <!-- Unpublished to trigger TitledEntry_Title_NoArticle (unique title) -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub1"
           title="Explorations in MDE"
           note="submitted for publication">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Manual to trigger TitledEntry_Title_NoArticle -->
  <entries xsi:type="BibTeX:Manual"
           id="man1"
           title="ATL User Guide"/>

  <!-- Proceedings (base type, not subclass) to trigger TitledEntry_Title_NoArticle and OCL13 -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procBase1"
           title="Proceedings of the First MDE Conference"
           year="2015"/>

  <!-- Book (base type) to trigger TitledEntry_Title_NoArticle and OCL9 -->
  <entries xsi:type="BibTeX:Book"
           id="bookBase1"
           title="Model-Driven Engineering Fundamentals"
           year="2012"
           publisher="TechPress">
    <authors author="Carol White"/>
    <authors author="Dave Brown"/>
  </entries>

  <!-- InBook to trigger TitledEntry_Title_NoArticle and OCL10 -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook1"
           title="Advanced MDE Techniques"
           year="2014"
           publisher="TechPress"
           chapter="7">
    <authors author="Eve Black"/>
  </entries>

  <!-- MasterThesis to trigger TitledEntry_Title_NoArticle and OCL7 (commented there but rule still applies) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mt1"
           title="Model Transformation Testing"
           year="2019"
           school="University of Sevilla">
    <authors author="Frank Green"/>
  </entries>

  <!-- PhDThesis to trigger TitledEntry_Title_NoArticle and OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd1"
           title="Scalable Model Transformations"
           year="2020"
           school="University of Sevilla">
    <authors author="Grace Hall"/>
  </entries>

  <!-- InCollection to trigger TitledEntry_Title_NoArticle and OCL15 -->
  <entries xsi:type="BibTeX:InCollection"
           id="incoll1"
           title="Testing in Model-Driven Engineering"
           year="2016"
           publisher="TechPress"
           booktitle="Handbook of Software Engineering">
    <authors author="Alice Smith"/>
  </entries>

  <!-- InProceedings to trigger TitledEntry_Title_NoArticle and OCL14 -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc1"
           title="Experiments in ATL Testing"
           year="2017"
           booktitle="Proceedings of the First MDE Conference">
    <authors author="Bob Johnson"/>
    <authors author="Ian Clark"/>
  </entries>

  <!-- TechReport to trigger TitledEntry_Title_NoArticle and OCL11 -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr1"
           title="Industrial Experiences with MDE"
           year="2013">
    <authors author="Carol White"/>
  </entries>

  <!-- Articles to trigger Article_* rules and OCL16,19,27 -->

  <!-- Article with unique title and journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article"
           id="art1"
           title="A Survey on MDE"
           year="2011"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Dave Brown"/>
  </entries>

  <!-- Two articles sharing the same title but different journals
       -> one in titled set, both in journal set
       -> Article_Title_Journal (first), Article_NoTitle_Journal (second) -->
  <entries xsi:type="BibTeX:Article"
           id="art2"
           title="Comparative Study of ATL and QVT"
           year="2010"
           journal="Software Transformation Journal">
    <authors author="Frank Green"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="art3"
           title="Comparative Study of ATL and QVT"
           year="2012"
           journal="International Journal of MDE">
    <authors author="Grace Hall"/>
  </entries>

  <!-- Two articles sharing the same journal but different titles
       -> first in both title and journal sets: Article_Title_Journal
       -> second: in title set but not journal set: Article_Title_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="art4"
           title="Optimizing ATL Transformations"
           year="2013"
           journal="Model Transformations Today">
    <authors author="Ian Clark"/>
    <authors author="Bob Johnson"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="art5"
           title="Debugging Model Transformations"
           year="2014"
           journal="Model Transformations Today">
    <authors author="Eve Black"/>
  </entries>

  <!-- Two articles sharing both title and journal
       -> first in title and journal sets: Article_Title_Journal
       -> second in neither: Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article"
           id="art6"
           title="Testing ATL Transformations"
           year="2015"
           journal="Journal of Model Engineering">
    <authors author="Carol White"/>
  </entries>

  <entries xsi:type="BibTeX:Article"
           id="art7"
           title="Testing ATL Transformations"
           year="2016"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
  </entries>

</BibTeX:BibTeXFile>