<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for R3: UntitledEntry; OCL5 via Booklet) -->
  <entries xsi:type="BibTeX:Misc" id="M1"/>
  <entries xsi:type="BibTeX:Booklet" id="BKT1" year="2010"/>

  <!-- Manual (TitledEntry, no authors, no date) -->
  <entries xsi:type="BibTeX:Manual" id="MAN1" title="Quick Reference Guide"/>

  <!-- TechReports (two with same title to trigger R4 + R5 pattern) -->
  <entries xsi:type="BibTeX:TechReport" id="TR1" title="Model Transformations in Practice" year="2015">
    <authors author="Eve Evans"/>
    <authors author="Frank Foster"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="TR2" title="Model Transformations in Practice" year="2016">
    <authors author="George Green"/>
  </entries>

  <!-- MasterThesis (for OCL7, R4) -->
  <entries xsi:type="BibTeX:MasterThesis" id="MT1" title="Metamodel Evolution" year="2013" school="Tech University">
    <authors author="Alice Smith"/>
  </entries>

  <!-- PhDThesis (for OCL8, R4) -->
  <entries xsi:type="BibTeX:PhDThesis" id="PHD1" title="Advanced Model Transformations" year="2012" school="Science Institute">
    <authors author="Bob Johnson"/>
    <authors author="Carol King"/>
  </entries>

  <!-- Book (base Book, for OCL9, R4) -->
  <entries xsi:type="BibTeX:Book" id="BK1" title="Foundations of MDE" year="2009" publisher="Springer">
    <authors author="David Lee"/>
  </entries>

  <!-- InBook (for OCL10, R4) -->
  <entries xsi:type="BibTeX:InBook" id="IB1" title="Chapter on ATL" year="2011" publisher="Springer" chapter="5">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Proceedings (base Proceedings, for OCL13, R4) -->
  <entries xsi:type="BibTeX:Proceedings" id="PR1" title="MDE Conference 2014" year="2014"/>

  <!-- InProceedings (for OCL14, R4) -->
  <entries xsi:type="BibTeX:InProceedings" id="IP1" title="Testing Model Transformations" year="2014" booktitle="MDE Conference 2014">
    <authors author="Carol King"/>
    <authors author="David Lee"/>
  </entries>

  <!-- BookTitled entry via InCollection (for OCL15, R4) -->
  <entries xsi:type="BibTeX:InCollection" id="IC1" title="Reusable Transformation Patterns" year="2010" publisher="TechPress" booktitle="Handbook of MDE">
    <authors author="Eve Evans"/>
  </entries>

  <!-- Unpublished (for OCL6, R4) -->
  <entries xsi:type="BibTeX:Unpublished" id="UP1" title="Draft on Bidirectional Transformations" note="To appear.">
    <authors author="Frank Foster"/>
    <authors author="George Green"/>
  </entries>

  <!-- Articles: 
       A1: unique title & journal (R6, fulfills OCL16,19)
       A2,A3: same title diff journals (R6 + R7)
       A4,A5: diff titles same journal (R6 + R8)
       A6,A7: same title & same journal (R6 + R9) -->
  <entries xsi:type="BibTeX:Article" id="A1" title="Integrating MDE and Testing" year="2018" journal="Journal of Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

