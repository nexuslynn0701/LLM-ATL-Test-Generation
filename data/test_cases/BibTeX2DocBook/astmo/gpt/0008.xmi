<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Misc" id="E01"/>
  <entries xsi:type="BibTeX:Booklet" id="E02" year="2008"/>

  <!-- Unpublished entries (TitledEntry_* rules; distinct titles) -->
  <entries xsi:type="BibTeX:Unpublished" id="E03" title="Draft Workflow Patterns" note="internal report">
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="E04" title="Concurrent Systems Overview" note="to appear">
    <authors author="Bob Johnson"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- Manual entries (TitledEntry_* rules; duplicate titles) -->
  <entries xsi:type="BibTeX:Manual" id="E05" title="Tool User Guide"/>
  <entries xsi:type="BibTeX:Manual" id="E06" title="Tool User Guide"/>

  <!-- TechReport entries (TitledEntry_* rules; distinct titles) -->
  <entries xsi:type="BibTeX:TechReport" id="E07" title="MDE Survey 2020" year="2020">
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:TechReport" id="E08" title="Formal Verification Notes" year="2019">
    <authors author="David Brown"/>
  </entries>

  <!-- MasterThesis and PhDThesis (ThesisEntry subset) -->
  <entries xsi:type="BibTeX:MasterThesis" id="E09" title="Model Transformations in Practice" year="2017" school="Tech University">
    <authors author="Emily Clark"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="E10" title="Scalable Model Transformations" year="2015" school="Global Institute of Technology">
    <authors author="Frank Green"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Proceedings (one stand-alone, one parent of InProceedings) -->
  <entries xsi:type="BibTeX:Proceedings" id="E11" title="Proceedings of the 1st MDE Conference" year="2012"/>
  <entries xsi:type="BibTeX:Proceedings" id="E12" title="Proceedings of the 2nd MDE Conference" year="2013"/>

  <!-- InProceedings entries (share booktitles with proceedings; distinct titles) -->
  <entries xsi:type="BibTeX:InProceedings" id="E13" title="Model Matching Techniques" year="2012" booktitle="Proceedings of the 1st MDE Conference">
    <authors author="Bob Johnson"/>
    <authors author="Helen King"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="E14" title="Traceability in Transformations" year="2013" booktitle="Proceedings of the 2nd MDE Conference">
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- Book entries (one plain Book, one parent of InBook and InCollection) -->
  <entries xsi:type="BibTeX:Book" id="E15" title="Foundations of Model-Driven Engineering" year="2010" publisher="Springer">
    <authors author="Ian Lee"/>
    <authors author="Alice Smith"/>
  </entries>
  <entries xsi:type="BibTeX:Book" id="E16" title="Advanced Topics in MDE" year="2011" publisher="Academic Press">
    <authors author="John Miller"/>
  </entries>

  <!-- InBook (child of Book E16) -->
  <entries xsi:type="BibTeX:InBook" id="E17" title="Chapter on Transformation Testing" year="2011" publisher="Academic Press" chapter="5">
    <authors author="John Miller"/>
    <authors author="Emily Clark"/>
  </entries>

  <!-- InCollection (child of Book E16; same booktitle/publisher) -->
  <entries xsi:type="BibTeX:InCollection" id="E18" title="Refinement of Transformation Chains" year="2011" booktitle="Advanced Topics in MDE" publisher="Academic Press">
    <authors author="Frank Green"/>
  </entries>

  <!-- Articles: arranged to exercise Article_* variants -->

  <!-- A1: unique title, unique journal -> Article_Title_Journal -->
  <entries xsi:type="BibTeX:Article" id="E19" title="Domain-Specific Languages for MDE" year="2014" journal="Journal of MDE Practice">
    <authors author="Alice Smith"/>
    <authors author="David Brown"/>
  </entries>

  <!-- A2 & A3: same title, different journals -> A2: Article_Title_Journal, A3: Article_NoTitle_Journal -->
  <entries xsi:type="BibTeX:Article" id="E20" title="Consistency Checking Techniques" year="2013" journal="Software Engineering Letters">
    <authors author="Carlos Diaz"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="E21" title="Consistency Checking Techniques" year="2016" journal="International Journal of Model Engineering">
    <authors author="Helen King"/>
    <authors author="Ian Lee"/>
  </entries>

  <!-- A4 & A5: different titles, same journal -> A4: Article_Title_NoJournal, A5: Article_NoTitle_NoJournal -->
  <entries xsi:type="BibTeX:Article" id="E22" title="Testing Transformations with OCL" year="2018" journal="MDE Transactions">
    <authors author="John Miller"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="E23" title="Coverage Criteria for Model Transformations" year="2019" journal="MDE Transactions">
    <authors author="Emily Clark"/>
    <authors author="Frank Green"/>
  </entries>

</BibTeX:BibTeXFile>