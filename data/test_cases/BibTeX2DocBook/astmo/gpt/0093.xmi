<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger R3 (UntitledEntry): Booklet -->
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2018"/>

  <!-- Misc as another untitled entry (also R3) -->
  <entries xsi:type="BibTeX:Misc" id="msc1"/>

  <!-- Manual (titled, no authors/year): unique title => R4 -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="MDE Tool Manual"/>

  <!-- TechReport with authors and year: title duplicated -> first in title-set => R4, second => R5 -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Shared Report" year="2017">
    <authors author="Alice Doe"/>
    <authors author="Bob Roe"/>
  </entries>

  <!-- Second TechReport with same title "Shared Report": triggers R5 (NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:TechReport" id="tr2" title="Shared Report" year="2019">
    <authors author="Charlie Poe"/>
  </entries>

  <!-- MasterThesis: unique title => R4 -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Mastering MDE" year="2016" school="Tech University">
    <authors author="Diana Lane"/>
  </entries>

  <!-- PhDThesis: unique title => R4 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced MDE" year="2015" school="Science Institute">
    <authors author="Alice Doe"/>
  </entries>

  <!-- Book (plain Book, not subclass): unique title => R4 -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="Model Transformations" year="2014" publisher="Springer">
    <authors author="Bob Roe"/>
    <authors author="Eve Ray"/>
  </entries>

  <!-- InBook (subclass of Book): unique title => R4 -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Chapter on ATL" year="2019" publisher="TechPress" chapter="3">
    <authors author="Frank Cole"/>
  </entries>

  <!-- Proceedings (plain Proceedings, not InProceedings child): unique title => R4 -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="MDE Conference 2020" year="2020"/>

  <!-- InProceedings: unique title and booktitle => R4 -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="ATL in Practice" year="2020" booktitle="MDE Conference 2020">
    <authors author="Gina Hale"/>
    <authors author="Henry Ives"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry): unique title => R4 -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Reusable Transformations" year="2013" publisher="Springer" booktitle="Software Engineering Collections">
    <authors author="Diana Lane"/>
  </entries>

  <!-- Unpublished: unique title => R4 -->
  <entries xsi:type="BibTeX:Unpublished" id="up1" title="Draft on MDE Testing" note="Work in progress">
    <authors author="Charlie Poe"/>
  </entries>

  <!-- Article group to exercise article rules and OCL journal/title constraints -->
  <!-- Article a1: unique title, unique journal => R6 (Title + Journal) -->
  <entries xsi:type="BibTeX:Article" id="a1" title="MDE Overview" year="2010" journal="Journal of MDE">
    <authors author="Alice Doe"/>
  </entries>

  <!-- Article a2: same title as a3, journal j2 appears twice (a2 & a4) ->
       not in title-set, in journal-set => R7 (NoTitle + Journal) -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Transformation Testing" year="2011" journal="Software Testing Journal">
    <authors author="Bob Roe"/>
    <authors author="Frank Cole"/>
  </entries>

  <!-- Article a3: another with title "Transformation Testing" but journal unique j3 ->
       not in title-set, in journal-set (journal unique but still in minimal set) => R7 -->
  <entries xsi:type="BibTeX:Article" id="a3" title="Transformation Testing" year="2012" journal="Testing Advances">
    <authors author="Eve Ray"/>
  </entries>

  <!-- Article a4: unique title, journal j2 repeated from a2 ->
       in title-set, not in journal-set => R8 (Title + NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="a4" title="ATL Performance" year="2013" journal="Software Testing Journal">
    <authors author="Gina Hale"/>
  </entries>

</BibTeX:BibTeXFile>