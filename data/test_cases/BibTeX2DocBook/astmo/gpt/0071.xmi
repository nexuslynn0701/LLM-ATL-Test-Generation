<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- UntitledEntry rule via Booklet -->
  <entries xsi:type="BibTeX:Booklet"
           id="bklet1"
           year="2001"/>

  <!-- UntitledEntry rule via Misc -->
  <entries xsi:type="BibTeX:Misc"
           id="misc1"/>

  <!-- TitledEntry_Title_NoArticle via Unpublished -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub1"
           title="Unique Unpublished Work"
           note="Unpublished note about the work">
    <authors author="Alice Author"/>
    <authors author="Bob Writer"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle via Manual -->
  <entries xsi:type="BibTeX:Manual"
           id="man1"
           title="Tool Manual v1"/>

  <!-- TitledEntry_Title_NoArticle via TechReport -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr1"
           title="Tech Report Alpha"
           year="2010">
    <authors author="Carol Researcher"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle via Proceedings (base type, no children) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc1"
           title="Conference on Modeling"
           year="2015"/>

  <!-- TitledEntry_Title_NoArticle via Book (base Book, not child) -->
  <entries xsi:type="BibTeX:Book"
           id="book1"
           title="Model-Driven Book"
           year="2012"
           publisher="MD Publishers">
    <authors author="Alice Author"/>
    <authors author="David Developer"/>
  </entries>

  <!-- TitledEntry_NoTitle_NoArticle via Book sharing title with book1 -->
  <entries xsi:type="BibTeX:Book"
           id="book2"
           title="Model-Driven Book"
           year="2013"
           publisher="Another Publisher">
    <authors author="Eve Engineer"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle via InBook with unique title and chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook1"
           title="Chapter on Transformations"
           year="2014"
           publisher="MD Publishers"
           chapter="3">
    <authors author="Bob Writer"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle via InCollection -->
  <entries xsi:type="BibTeX:InCollection"
           id="incoll1"
           title="InCollection Paper"
           year="2011"
           publisher="Collection House"
           booktitle="Collected MDE Papers">
    <authors author="Carol Researcher"/>
    <authors author="Frank Scientist"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle via MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mt1"
           title="MDE in Practice"
           year="2016"
           school="Tech University">
    <authors author="Grace Student"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle via PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd1"
           title="Advanced MDE"
           year="2018"
           school="Science University">
    <authors author="Henry Candidate"/>
  </entries>

  <!-- TitledEntry_Title_NoArticle via InProceedings -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc1"
           title="InProc Paper"
           year="2017"
           booktitle="Proceedings of MDEConf 2017">
    <authors author="Alice Author"/>
  </entries>

  <!-- Article_Title_Journal: unique title, unique journal -->
  <entries xsi:type="BibTeX:Article"
           id="art1"
           title="Unique Article One"
           year="2005"
           journal="Journal A">
    <authors author="Bob Writer"/>
    <authors author="Carol Researcher"/>
  </entries>

  <!-- Article_Title_NoJournal: unique title, journal duplicated with art3 -->
  <entries xsi:type="BibTeX:Article"
           id="art2"
           title="Different Article Same Journal"
           year="2006"
           journal="Journal B">
    <authors author="David Developer"/>
  </entries>

  <!-- Article_NoTitle_Journal: duplicate title with art4, unique journal -->
  <entries xsi:type="BibTeX:Article"
           id="art3"
           title="Repeated Title Article"
           year="2007"
           journal="Journal B">
    <authors author="Eve Engineer"/>
  </entries>

  <!-- Article_NoTitle_NoJournal: duplicate title with art3 and duplicate journal with art5 -->
  <entries xsi:type="BibTeX:Article"
           id="art4"
           title="Repeated Title Article"
           year="2008"
           journal="Journal C">
    <authors author="Frank Scientist"/>
  </entries>

  <!-- Article_Title_NoJournal: unique title, journal duplicated with art4 -->
  <entries xsi:type="BibTeX:Article"
           id="art5"
           title="Another Article in Journal C"
           year="2009"
           journal="Journal C">
    <authors author="Grace Student"/>
  </entries>

</BibTeX:BibTeXFile>