  </entries>

  <!-- Article A4 & A5: same title, different journals (Article_NoTitle_Journal and Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="e16" title="Shared Title" year="2022" journal="Journal B">
    <authors author="Laura Cyan"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="e17" title="Shared Title" year="2023" journal="Journal C">
