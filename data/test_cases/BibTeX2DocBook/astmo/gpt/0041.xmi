    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc (untitled, non-authored, non-dated) -->
  <entries xsi:type="BibTeX:Misc" id="e01"/>

  <!-- Booklet (untitled, dated entry) -->
  <entries xsi:type="BibTeX:Booklet" id="e02" year="2010"/>

  <!-- Manual (titled, no authors, no year) -->
  <entries xsi:type="BibTeX:Manual" id="e03" title="DocBook Manual"/>

  <!-- TechReport (titled, authored, dated) -->
  <entries xsi:type="BibTeX:TechReport" id="e04" title="Tech Evaluation" year="2011">
