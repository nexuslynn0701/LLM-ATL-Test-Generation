  <!-- Article A1 (unique title and unique journal) -->
  <entries xsi:type="BibTeX:Article" id="e13" title="Unique Article" year="2019" journal="Journal A">
    <authors author="Ian Orange"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article A2 & A3: same title, same journal (exercise Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="e14" title="Duplicated Study" year="2020" journal="Common Journal">
    <authors author="Jack Blue"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="e15" title="Duplicated Study" year="2021" journal="Common Journal">
