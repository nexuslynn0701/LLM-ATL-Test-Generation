  <!-- Article A6 & A7: different titles, same journal (Article_Title_NoJournal and Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="e18" title="Journal Group One" year="2024" journal="Grouped Journal">
    <authors author="Nancy Silver"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="e19" title="Journal Group Two" year="2025" journal="Grouped Journal">
