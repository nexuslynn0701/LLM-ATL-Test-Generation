  </entries>

  <!-- Unpublished (titled, authored, note) -->
  <entries xsi:type="BibTeX:Unpublished" id="e05" title="Draft Report" note="to appear">
    <authors author="Bob Jones"/>
    <authors author="Alice Smith"/>
  </entries>

