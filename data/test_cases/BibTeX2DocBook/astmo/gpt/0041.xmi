  <!-- InCollection (titled, authored, dated, publisher, booktitle) -->
  <entries xsi:type="BibTeX:InCollection" id="e12" title="Model Analysis" year="2018" publisher="Elsevier" booktitle="Modeling Collection">
    <authors author="Helen Gray"/>
