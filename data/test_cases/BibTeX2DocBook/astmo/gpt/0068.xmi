<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (for UntitledEntry rule) -->
  <entries xsi:type="BibTeX:Misc" id="E01"/>
  <entries xsi:type="BibTeX:Booklet" id="E02" year="2010"/>

  <!-- Unpublished entries with distinct titles (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Unpublished" id="E03" title="Hidden Patterns" note="draft version">
    <authors author="Alice Alpha"/>
    <authors author="Bob Beta"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="E04" title="Transient Structures" note="internal report">
    <authors author="Carol Gamma"/>
  </entries>

  <!-- Unpublished entries sharing the same title (to trigger TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:Unpublished" id="E05" title="Duplicate Title Case" note="first instance">
    <authors author="Alice Alpha"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="E06" title="Duplicate Title Case" note="second instance">
    <authors author="David Delta"/>
  </entries>

  <!-- MasterThesis and PhDThesis (ThesisEntry subclasses, no duplicate titles) -->
  <entries xsi:type="BibTeX:MasterThesis" id="E07" title="Model Transformations in Practice" year="2015" school="Tech University">
    <authors author="Eve Epsilon"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="E08" title="Advanced MDE Techniques" year="2018" school="Science Institute">
    <authors author="Frank Phi"/>
  </entries>

  <!-- Book (base Book only, no children; distinct title) -->
  <entries xsi:type="BibTeX:Book" id="E09" title="Foundations of Modelling" year="2012" publisher="ModelPress">
    <authors author="George Gamma"/>
    <authors author="Helen Eta"/>
  </entries>

  <!-- InBook (Book child, own chapter; distinct title) -->
  <entries xsi:type="BibTeX:InBook" id="E10" title="Chapter on DSLs" year="2013" publisher="ModelPress" chapter="3">
    <authors author="Helen Eta"/>
  </entries>

  <!-- Proceedings (base Proceedings only, no children; distinct title) -->
  <entries xsi:type="BibTeX:Proceedings" id="E11" title="MDE Conference 2020" year="2020"/>

  <!-- InProceedings with distinct title (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:InProceedings" id="E12" title="Transformations at Scale" year="2020" booktitle="MDE Conference 2020">
    <authors author="Ian Iota"/>
    <authors author="Jack Kappa"/>
  </entries>

  <!-- InProceedings sharing the same title (TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:InProceedings" id="E13" title="Repeated InProc Title" year="2021" booktitle="Automation Symposium">
    <authors author="Bob Beta"/>
  </entries>
  <entries xsi:type="BibTeX:InProceedings" id="E14" title="Repeated InProc Title" year="2022" booktitle="Automation Symposium">
    <authors author="Laura Lambda"/>
  </entries>

  <!-- InCollection (Book child + BookTitledEntry; distinct title) -->
  <entries xsi:type="BibTeX:InCollection" id="E15" title="Collected Chapter" year="2014" publisher="Collection House" booktitle="Collected Works on MDE">
    <authors author="Carol Gamma"/>
    <authors author="Mike Mu"/>
  </entries>

  <!-- Manual (TitledEntry only; distinct title) -->
  <entries xsi:type="BibTeX:Manual" id="E16" title="Tooling Guide"/>

  <!-- TechReport (AuthoredEntry + DatedEntry + TitledEntry; distinct title) -->
  <entries xsi:type="BibTeX:TechReport" id="E17" title="Verification Report" year="2016">
    <authors author="Nina Nu"/>
    <authors author="Oscar Omicron"/>
  </entries>

  <!-- Articles covering Article rules -->
  <!-- A1: unique title, unique journal (Article_Title_Journal) -->
  <entries xsi:type="BibTeX:Article" id="E18" title="Single Article Case" year="2011" journal="Journal One">
    <authors author="Peter Pi"/>
  </entries>

  <!-- A2, A3: same title, different journals (Article_NoTitle_Journal) -->
  <entries xsi:type="BibTeX:Article" id="E19" title="Shared Title Article" year="2012" journal="Journal Alpha">
    <authors author="Quentin Q"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="E20" title="Shared Title Article" year="2013" journal="Journal Beta">
    <authors author="Rachel Rho"/>
  </entries>

  <!-- A4, A5: different titles, same journal (Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="E21" title="First Same Journal" year="2014" journal="Journal Shared">
    <authors author="Steve Sigma"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="E22" title="Second Same Journal" year="2015" journal="Journal Shared">
    <authors author="Tina Tau"/>
  </entries>

  <!-- A6, A7: same title and same journal (Article_NoTitle_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="E23" title="Fully Duplicated Article" year="2016" journal="Journal Duplicate">
    <authors author="Uma Upsilon"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="E24" title="Fully Duplicated Article" year="2017" journal="Journal Duplicate">
    <authors author="Victor V"/>
  </entries>

</BibTeX:BibTeXFile>