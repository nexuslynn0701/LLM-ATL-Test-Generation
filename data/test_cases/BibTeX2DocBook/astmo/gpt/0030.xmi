<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Booklet: UntitledEntry (no title) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bklt1"
           year="2009"/>

  <!-- Misc: UntitledEntry (no title, minimal) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc1"/>

  <!-- Unpublished: TitledEntry, no authors, distinct title -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unp1"
           title="Early Draft on MDE"
           note="to appear"/>

  <!-- Manual: TitledEntry only -->
  <entries xsi:type="BibTeX:Manual"
           id="man1"
           title="User Guide for Transformation Tool"/>

  <!-- Proceedings: base Proceedings with unique title (no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc1"
           title="Proceedings of the First MDE Workshop"
           year="2010"/>

  <!-- TechReport: TitledEntry + Authored + Dated -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr1"
           title="Report on Model Transformations"
           year="2011">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- MasterThesis: TitledEntry + Authored + Dated + ThesisEntry -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mst1"
           title="MDE in Practice"
           year="2012"
           school="Tech University"/>

  <!-- PhDThesis: TitledEntry + Authored + Dated + ThesisEntry -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd1"
           title="Advanced Topics in Model Transformations"
           year="2013"
           school="Science Institute">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Book: base Book with unique title -->
  <entries xsi:type="BibTeX:Book"
           id="book1"
           title="Foundations of Model Engineering"
           year="2014"
           publisher="Modeling Press">
    <authors author="Carol White"/>
  </entries>

  <!-- InBook: child of Book, unique title -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook1"
           title="Chapter on ATL Transformations"
           year="2015"
           publisher="Modeling Press"
           chapter="3">
    <authors author="David Green"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incoll1"
           title="Model Transformations Survey"
           year="2016"
           publisher="Academic Publishing"
           booktitle="Collected Papers on MDE">
    <authors author="Eve Black"/>
    <authors author="Frank Brown"/>
  </entries>

  <!-- InProceedings: Proceedings + Authored + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc1"
           title="Testing Model Transformations"
           year="2017"
           booktitle="Proceedings of the Second MDE Workshop">
    <authors author="George King"/>
  </entries>

  <!-- Article A1: unique title, unique journal -->
  <entries xsi:type="BibTeX:Article"
           id="art1"
           title="ATL Transformation Testing"
           year="2018"
           journal="Journal of MDE Research">
    <authors author="Alice Smith"/>
    <authors author="Henry Lee"/>
  </entries>

  <!-- Article A2: duplicate title with A1, same journal -->
  <entries xsi:type="BibTeX:Article"
           id="art2"
           title="ATL Transformation Testing"
           year="2019"
           journal="Journal of MDE Research">
    <authors author="Bob Johnson"/>
  </entries>

  <!-- Article A3: unique title, journal duplicated with A1/A2 -->
  <entries xsi:type="BibTeX:Article"
           id="art3"
           title="Traceability in Model Transformations"
           year="2020"
           journal="Journal of MDE Research">
    <authors author="Carol White"/>
    <authors author="David Green"/>
  </entries>

  <!-- Article A4: unique title, distinct journal -->
  <entries xsi:type="BibTeX:Article"
           id="art4"
           title="Model-Driven Testing Frameworks"
           year="2021"
           journal="Software Engineering Letters">
    <authors author="Eve Black"/>
  </entries>

  <!-- Article A5: duplicate title with A4, distinct journal -->
  <entries xsi:type="BibTeX:Article"
           id="art5"
           title="Model-Driven Testing Frameworks"
           year="2022"
           journal="International Journal of Testing">
    <authors author="Frank Brown"/>
    <authors author="George King"/>
  </entries>

</BibTeX:BibTeXFile>