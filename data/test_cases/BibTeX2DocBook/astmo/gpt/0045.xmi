<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entries (R3: Misc, Booklet) -->
  <entries xsi:type="BibTeX:Misc" id="m1"/>
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2015"/>

  <!-- Unpublished entries with same title (R4 + R5) -->
  <entries xsi:type="BibTeX:Unpublished" id="u1" title="Shared Study" note="Internal note A">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>
  <entries xsi:type="BibTeX:Unpublished" id="u2" title="Shared Study" note="Internal note B">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Manual (R4) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="Tool Guide"/>

  <!-- Proceedings: one root (R4), one child via InProceedings (to exercise Proceedings subtype but not R4) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Symposium A" year="2018"/>
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Paper A1" year="2018" booktitle="Symposium A">
    <authors author="Carol White"/>
  </entries>

  <!-- Book and its children (R4 for one Book, R5 for duplicate-titled Book, R4 for InBook, R4/R5 for InCollection depending on title uniqueness) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Advanced Topics" year="2019" publisher="TechPress">
    <authors author="David Brown"/>
    <authors author="Eve Green"/>
  </entries>
  <!-- Same title as book1: goes to R5 (no title para) -->
  <entries xsi:type="BibTeX:Book" id="book2" title="Advanced Topics" year="2020" publisher="NextGenPress">
    <authors author="Frank Black"/>
  </entries>

  <!-- InBook with unique title (R4) -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="In-Depth Chapter" year="2019" publisher="TechPress" chapter="3">
    <authors author="Eve Green"/>
  </entries>

  <!-- InCollection sharing title with ib1 (R5) -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="In-Depth Chapter" year="2021" booktitle="Collected Works" publisher="ScholarlyPub">
    <authors author="George King"/>
  </entries>

  <!-- Thesis entries (R4: MasterThesis, PhDThesis) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Model Transformations" year="2017" school="State University">
    <authors author="Hannah Lee"/>
  </entries>
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Scalable MDE" year="2016" school="Tech University">
    <authors author="Ian Clark"/>
  </entries>

  <!-- TechReport with duplicate title with mt1 (R5) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Model Transformations" year="2018">
    <authors author="Hannah Lee"/>
    <authors author="Jack Miller"/>
  </entries>

  <!-- Articles to cover R6, R7, R8, R9 and journal/title uniqueness combinations -->
  <!-- a1: unique title, unique journal (R6) -->
  <entries xsi:type="BibTeX:Article" id="a1" title="Metamodeling Basics" year="2014" journal="Journal A">
    <authors author="Alice Smith"/>
    <authors author="David Brown"/>
  </entries>

  <!-- a2 & a3: same title, different journals (R7 for a2, R6 for a3) -->
  <entries xsi:type="BibTeX:Article" id="a2" title="Common Title" year="2015" journal="Journal B">
    <authors author="Carol White"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a3" title="Common Title" year="2016" journal="Journal C">
    <authors author="Frank Black"/>
    <authors author="George King"/>
  </entries>

  <!-- a4 & a5: different titles, same journal (R8 for a4 and a5) -->
  <entries xsi:type="BibTeX:Article" id="a4" title="First in Journal D" year="2017" journal="Journal D">
    <authors author="Ian Clark"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a5" title="Second in Journal D" year="2018" journal="Journal D">
    <authors author="Jack Miller"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- a6 & a7: same title, same journal (R9 for a7, R6/R7/R8 excluded by construction) -->
  <entries xsi:type="BibTeX:Article" id="a6" title="Duplicate Both" year="2019" journal="Journal E">
    <authors author="Hannah Lee"/>
  </entries>
  <entries xsi:type="BibTeX:Article" id="a7" title="Duplicate Both" year="2020" journal="Journal E">
    <authors author="Eve Green"/>
    <authors author="Carol White"/>
  </entries>

</BibTeX:BibTeXFile>