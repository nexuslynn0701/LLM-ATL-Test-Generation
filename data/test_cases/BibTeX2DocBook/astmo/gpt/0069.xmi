<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry to trigger UntitledEntry (Misc) -->
  <entries xsi:type="BibTeX:Misc" id="E01"/>

  <!-- Booklet (untitled, dated) also via UntitledEntry -->
  <entries xsi:type="BibTeX:Booklet" id="E02" year="1999"/>

  <!-- Manual (titled, no authors, R4 / R5 set member) -->
  <entries xsi:type="BibTeX:Manual" id="E03" title="DocBook Guide"/>

  <!-- Proceedings (titled, dated, unique title, R4) -->
  <entries xsi:type="BibTeX:Proceedings" id="E04" title="MDE Symposium" year="2010"/>

  <!-- Proceedings with duplicated title (titled, dated, R5, no title_para) -->
  <entries xsi:type="BibTeX:Proceedings" id="E05" title="MDE Symposium" year="2011"/>

  <!-- Unpublished (titled, authored, note, R4) -->
  <entries xsi:type="BibTeX:Unpublished" id="E06" title="Draft on Transformations" note="To appear">
    <authors author="Alice A."/>
  </entries>

  <!-- TechReport (titled, authored, dated, R4) -->
  <entries xsi:type="BibTeX:TechReport" id="E07" title="MDE Report" year="2012">
    <authors author="Bob B."/>
  </entries>

  <!-- MasterThesis (titled, authored, dated, school, R4) -->
