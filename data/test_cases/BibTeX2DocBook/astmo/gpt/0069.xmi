  </entries>

  <!-- Book (titled, authored, dated, publisher, unique title, R4) -->
  <entries xsi:type="BibTeX:Book" id="E10" title="MDE Book" year="2015" publisher="Pub One">
    <authors author="Eve E."/>
  </entries>

  <!-- Book with duplicated title (titled, authored, dated, publisher, R5) -->
  <entries xsi:type="BibTeX:Book" id="E11" title="MDE Book" year="2016" publisher="Pub Two">
    <authors author="Frank F."/>
  </entries>

