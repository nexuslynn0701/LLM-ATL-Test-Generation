  <entries xsi:type="BibTeX:InBook" id="E12" title="Chapter on Testing" year="2017" publisher="TechPress" chapter="3">
    <authors author="Grace G."/>
  </entries>

  <!-- InCollection (titled, authored, dated via Book, booktitle, publisher, R4) -->
