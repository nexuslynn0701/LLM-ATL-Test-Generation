  <entries xsi:type="BibTeX:InProceedings" id="E14" title="Conference Paper One" year="2019" booktitle="CONF 2019">
    <authors author="Ivan I."/>
  </entries>

  <!-- Article A1 (unique title and journal, R6) -->
