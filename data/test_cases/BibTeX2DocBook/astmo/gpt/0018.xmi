<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Misc: untitled, non-authored, non-dated (tests UntitledEntry) -->
  <entries xsi:type="BibTeX:Misc" id="misc1"/>

  <!-- Booklet: dated only, no title (tests UntitledEntry + OCL5) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet1" year="2001"/>

  <!-- Manual: titled only (tests TitledEntry_Title_NoArticle + OCL12) -->
  <entries xsi:type="BibTeX:Manual" id="manual1" title="Manual Alpha"/>

  <!-- Proceedings: dated + titled, type-level only (tests TitledEntry_Title_NoArticle + OCL13) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="Proc One" year="2010"/>

  <!-- Proceedings with duplicate title to trigger TitledEntry_NoTitle_NoArticle -->
  <entries xsi:type="BibTeX:Proceedings" id="proc2" title="Proc One" year="2011"/>

  <!-- Unpublished: authored + titled, no year (tests TitledEntry_Title_NoArticle + OCL6) -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub1" title="Unpub Study" note="Draft note">
    <authors author="Alice Smith"/>
  </entries>

  <!-- TechReport: authored + dated + titled (tests TitledEntry_Title_NoArticle + OCL11) -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Tech Report One" year="2015">
    <authors author="Bob Brown"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- MasterThesis: authored + dated + titled + school (tests TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="MT Title" year="2016" school="Uni A">
    <authors author="Carol Clark"/>
  </entries>

  <!-- PhDThesis: authored + dated + titled + school (tests TitledEntry_Title_NoArticle + OCL8) -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="PHD Title" year="2018" school="Uni B">
    <authors author="Dave Davis"/>
    <authors author="Eve Evans"/>
  </entries>

  <!-- Book: authored + dated + titled + publisher (tests TitledEntry_Title_NoArticle + OCL9) -->
  <entries xsi:type="BibTeX:Book" id="book1" title="Book Title One" year="2005" publisher="PubX">
    <authors author="Frank Frost"/>
  </entries>

  <!-- InBook: subclass of Book with chapter (tests TitledEntry_Title_NoArticle + OCL10) -->
  <entries xsi:type="BibTeX:InBook" id="inbook1" title="InBook Chapter" year="2006" publisher="PubY" chapter="3">
    <authors author="Grace Green"/>
    <authors author="Bob Brown"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry (uses booktitle) (tests TitledEntry_Title_NoArticle + OCL15) -->
  <entries xsi:type="BibTeX:InCollection" id="incoll1" title="Collection Piece" year="2007" publisher="PubZ" booktitle="CollBook A">
    <authors author="Heidi Hall"/>
  </entries>

  <!-- InProceedings: Proceedings + Authored + BookTitledEntry (tests TitledEntry_Title_NoArticle + OCL14) -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc1" title="InProc Paper" year="2012" booktitle="Conf A">
    <authors author="Ian Ivy"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article 1: unique title & journal (tests Article_Title_Journal + OCL16,19,6,18,20,27) -->
  <entries xsi:type="BibTeX:Article" id="art1" title="A1 Title" year="2020" journal="Journal One">
    <authors author="John Doe"/>
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article 2 & 3: same title, different journals (trigger Article_Title_Journal for one, Article_NoTitle_Journal for the other) -->
  <entries xsi:type="BibTeX:Article" id="art2" title="Shared Title" year="2021" journal="Journal Two">
    <authors author="John Doe"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art3" title="Shared Title" year="2022" journal="Journal Three">
    <authors author="Kate King"/>
  </entries>

  <!-- Article 4 & 5: different titles, same journal (trigger Article_Title_Journal and Article_Title_NoJournal) -->
  <entries xsi:type="BibTeX:Article" id="art4" title="Unique Title 1" year="2019" journal="Journal Shared">
    <authors author="Luke Long"/>
  </entries>

  <entries xsi:type="BibTeX:Article" id="art5" title="Unique Title 2" year="2019" journal="Journal Shared">
    <authors author="Mary Moore"/>
  </entries>

</BibTeX:BibTeXFile>