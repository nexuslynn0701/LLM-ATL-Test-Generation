<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Untitled entry: Booklet (triggers R3 UntitledEntry) -->
  <entries xsi:type="BibTeX:Booklet" id="bkl1" year="2001"/>

  <!-- Misc entry: also untitled, triggers R3 UntitledEntry -->
  <entries xsi:type="BibTeX:Misc" id="msc1"/>

  <!-- Manual: titled, no authors/date, triggers R4 (TitledEntry_Title_NoArticle) -->
  <entries xsi:type="BibTeX:Manual" id="man1" title="User Guide"/>

  <!-- Manual with same title: triggers R5 (TitledEntry_NoTitle_NoArticle) -->
  <entries xsi:type="BibTeX:Manual" id="man2" title="User Guide"/>

  <!-- Unpublished: titled, authored, note, triggers R4 -->
  <entries xsi:type="BibTeX:Unpublished" id="unp1" title="Early Draft" note="To appear soon">
    <authors author="Alice Smith"/>
    <authors author="Bob Jones"/>
  </entries>

  <!-- TechReport: titled, authored, dated, triggers R4 -->
  <entries xsi:type="BibTeX:TechReport" id="tr1" title="Technical Overview" year="2015">
    <authors author="Carol White"/>
  </entries>

  <!-- MasterThesis: titled, authored, dated, school, triggers R4 -->
  <entries xsi:type="BibTeX:MasterThesis" id="mt1" title="Mastering Testing" year="2012" school="Tech University">
    <authors author="David Brown"/>
  </entries>

  <!-- PhDThesis: titled, authored, dated, school, triggers R4 and OCL8 -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd1" title="Advanced Transformations" year="2018" school="Science Institute">
    <authors author="Eve Black"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- Book: titled, authored, dated, publisher, triggers R4 and OCL9 -->
  <entries xsi:type="BibTeX:Book" id="bk1" title="Model Engineering" year="2010" publisher="Model Press">
    <authors author="Alice Smith"/>
    <authors author="Carol White"/>
  </entries>

  <!-- InBook: same publisher, adds chapter, triggers R4 and OCL10 -->
  <entries xsi:type="BibTeX:InBook" id="ib1" title="Model Engineering" year="2011" publisher="Model Press" chapter="3">
    <authors author="Bob Jones"/>
  </entries>

  <!-- Proceedings (base type only): titled, dated, triggers R4 and OCL13 -->
  <entries xsi:type="BibTeX:Proceedings" id="proc1" title="MDE Conference" year="2014"/>

  <!-- InProceedings: child of Proceedings, authored, dated, booktitle, triggers R4 and OCL14 -->
  <entries xsi:type="BibTeX:InProceedings" id="ip1" title="Testing Transformations" year="2014" booktitle="MDE Conference">
    <authors author="George King"/>
    <authors author="Helen Lee"/>
  </entries>

  <!-- InCollection: child of Book, authored, dated, booktitle+publisher, triggers R4 and OCL15 -->
  <entries xsi:type="BibTeX:InCollection" id="ic1" title="Case Studies in MDE" year="2013" booktitle="Collected MDE Papers" publisher="Model Press">
    <authors author="Ian Clark"/>
  </entries>

  <!-- Article a1: unique title and journal, triggers R6 and OCL16 -->
  <entries xsi:type="BibTeX:Article" id="a1" title="MDE Basics" year="2009" journal="Journal of MDE">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Article a2: same title as a1, different journal, triggers R7 (same title) and OCL16 -->
  <entries xsi:type="BibTeX:Article" id="a2" title="MDE Basics" year="2010" journal="Software Practice Journal">
    <authors author="Bob Jones"/>
  </entries>

  <!-- Article a3: different title, same journal as a1, triggers R8 (same journal) and OCL16 -->
  <entries xsi:type="BibTeX:Article" id="a3" title="Advanced MDE" year="2011" journal="Journal of MDE">
    <authors author="Carol White"/>
    <authors author="David Brown"/>
  </entries>

  <!-- Article a4: same title and same journal as a3, triggers R9 (same title & same journal) and OCL16 -->
  <entries xsi:type="BibTeX:Article" id="a4" title="Advanced MDE" year="2012" journal="Journal of MDE">
    <authors author="Eve Black"/>
  </entries>

</BibTeX:BibTeXFile>