<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-key-001"
           title="A Survey on Model-Driven Testing"
           year="2019"
           journal="Journal of Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr-key-002"
           title="Model Transformation Performance Evaluation"
           year="2020">
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-key-003"
           title="Preliminary Results on Incremental ATL Testing"
           note="Draft version, not for distribution">
    <authors author="Diana Evans"/>
    <authors author="Evan Taylor"/>
  </entries>

  <!-- Manual (title only, no authors/year) -->
  <entries xsi:type="BibTeX:Manual"
           id="man-key-004"
           title="ATL Transformation Language Reference Manual"/>
           
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-key-005"
           title="Proceedings of the International Conference on Model Transformation"
           year="2021"/>

  <!-- InProceedings (inherits Proceedings + AuthoredEntry + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-key-006"
           title="Test Data Generation for ATL Transformations"
           year="2021"
           booktitle="ICMT 2021: International Conference on Model Transformation">
    <authors author="Fiona Green"/>
    <authors author="Henry Clark"/>
  </entries>

  <!-- Booklet (only year required) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-key-007"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book-key-008"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Isabel Lopez"/>
    <authors author="Jack Miller"/>
  </entries>

  <!-- InCollection (extends Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol-key-009"
           title="Coverage Criteria for Model Transformations"
           year="2017"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Isabel Lopez"/>
  </entries>

  <!-- InBook with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-key-010"
           title="Advanced Topics in ATL Testing"
           year="2017"
           publisher="Springer"
           chapter="7">
    <authors author="Jack Miller"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-key-011"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd-key-012"
           title="Automated Testing of Model Transformations"
           year="2016"
           school="Technical University of Metropolis">
    <authors author="Karen Nguyen"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc-key-013"
           title="Tool Support for ATL Regression Testing"
           year="2015"
           school="Faculty of Computer Science, City University">
    <authors author="Liam O&apos;Connor"/>
  </entries>

</BibTeX:BibTeXFile>