<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplexMDE2021"
           year="2021"
           title="Advanced Model-Driven Engineering: A Comprehensive Survey"
           journal="Journal of Software Modelling">
    <authors author="Alice A. Architect"/>
    <authors author="Bob B. Builder"/>
    <authors author="Carol C. Curator"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="trTestingATL2020"
           year="2020"
           title="Testing ATL Transformations: Challenges and Techniques">
    <authors author="David D. Debugger"/>
  </entries>

  <!-- Unpublished with two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubIncrementalMDE"
           title="Incremental Model Transformations in Practice"
           note="Manuscript under preparation">
    <authors author="Eva E. Engineer"/>
    <authors author="Frank F. Fuser"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualToolchain"
           title="Toolchain User Guide, Version 3.5"/>

  <!-- Proceedings with year and title, but no authors -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procMDEConf2019"
           year="2019"
           title="Proceedings of the 7th International Conference on Model Engineering"/>

  <!-- InProceedings that extends Proceedings, AuthoredEntry, and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocTraceability"
           year="2019"
           title="Model Traceability in Large-Scale Transformations"
           booktitle="Proceedings of the 7th International Conference on Model Engineering">
    <authors author="Grace G. Generator"/>
    <authors author="Henry H. Harmonizer"/>
  </entries>

  <!-- Booklet (only year) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletQuickRef"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="bookPatterns"
           year="2017"
           title="Reusable Patterns for Model Transformation"
           publisher="MetaModel Press">
    <authors author="Irene I. Integrator"/>
    <authors author="John J. Joiner"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollectionRefactoring"
           year="2017"
           title="Refactoring of Model Transformations"
           publisher="MetaModel Press"
           booktitle="Reusable Patterns for Model Transformation">
    <authors author="Karen K. Keeper"/>
  </entries>

  <!-- InBook with chapter and all inherited fields -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookChapter4"
           year="2017"
           title="Testing Strategies for Rule-Based Transformations"
           publisher="MetaModel Press"
           chapter="4">
    <authors author="Louis L. Linker"/>
    <authors author="Maria M. Mapper"/>
  </entries>

  <!-- Misc entry with only an id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscOnlineResource"/>

  <!-- PhDThesis with required school -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdSemanticDiff"
           year="2016"
           title="Semantic Differencing of Model Transformations"
           school="University of Model Engineering">
    <authors author="Nathan N. Normalizer"/>
  </entries>

  <!-- MasterThesis with required school -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterModelCoverage"
           year="2015"
           title="Coverage Criteria for Model Transformation Testing"
           school="Institute of Software Quality">
    <authors author="Olivia O. Observer"/>
  </entries>

</BibTeX:BibTeXFile>