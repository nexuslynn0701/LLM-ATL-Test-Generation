<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
      id="artMultiAuth2020"
      title="Model-Driven Engineering in Heterogeneous Systems"
      year="2020"
      journal="Journal of Advanced Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
      id="techRepFormalVerif2019"
      title="Formal Verification Techniques for Model Transformations"
      year="2019">
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
      id="unpubDSLDesign2023"
      title="Domain-Specific Languages for Cyber-Physical Systems"
      note="Under submission to the International Journal on Software Tools">
    <authors author="Diana Evans"/>
    <authors author="Eric Foster"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
      id="manualATLTooling"
      title="ATL Transformation Developer Guide, Version 3.1"/>
      
  <!-- Proceedings (dated + titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
      id="procMDEConf2018"
      title="Proceedings of the 10th Conference on Model-Driven Engineering"
      year="2018"/>

  <!-- InProceedings (inherits Proceedings + AuthoredEntry + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
      id="inProcTraceTesting2018"
      title="Automated Testing of Model Transformations via Traces"
      year="2018"
      booktitle="Proceedings of the 10th Conference on Model-Driven Engineering">
    <authors author="Frank Green"/>
    <authors author="Helen Irwin"/>
  </entries>

  <!-- Booklet (only dated entry) -->
  <entries xsi:type="BibTeX:Booklet"
      id="bookletIntroMDE2017"
      year="2017"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
      id="bookMDEPatterns2015"
      title="Patterns and Best Practices in Model-Driven Engineering"
      year="2015"
      publisher="Springer">
    <authors author="Ian Jackson"/>
    <authors author="Julia King"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
      id="inCollTestingChapter2015"
      title="Testing and Debugging of Model Transformations"
      year="2015"
      publisher="Springer"
      booktitle="Patterns and Best Practices in Model-Driven Engineering">
    <authors author="Ian Jackson"/>
    <authors author="Laura Martin"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook"
      id="inBookAdvancedTrace2021"
      title="Advanced Traceability Techniques"
      year="2021"
      publisher="Morgan &amp; Claypool"
      chapter="7">
    <authors author="Michael Nelson"/>
  </entries>

  <!-- Misc (minimal, only id) -->
  <entries xsi:type="BibTeX:Misc"
      id="miscMDEWebsiteRef"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
      id="phdThesisModelTesting2016"
      title="Model-Based Testing of Transformation Systems"
      year="2016"
      school="Technical University of Metropolis">
    <authors author="Nancy Owens"/>
  </entries>

  <!-- MasterThesis with two authors to diversify -->
  <entries xsi:type="BibTeX:MasterThesis"
      id="masterThesisMetamodelEvo2019"
      title="Metamodel Evolution and Co-Evolution of Transformations"
      year="2019"
      school="Institute of Software Technology">
    <authors author="Oliver Perez"/>
    <authors author="Paula Quinn"/>
  </entries>

</BibTeX:BibTeXFile>