<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art001"
           title="A Comprehensive Survey on Model Transformations"
           year="2018"
           journal="Journal of Software Engineering Research and Development">
    <authors author="Alice Example"/>
    <authors author="Bob Researcher"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr001"
           title="Industrial Experiences with ATL"
           year="2016">
    <authors author="Carol Practitioner"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unp001"
           title="Emerging Trends in Model-Driven Analytics"
           note="To appear, internal draft.">
    <authors author="Daniel Analyst"/>
    <authors author="Eve Scientist"/>
  </entries>

  <!-- Manual without authors -->
  <entries xsi:type="BibTeX:Manual"
           id="man001"
           title="ATL Transformation Language Reference Manual 3.0"/>
           
  <!-- Proceedings (acts as a conference) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc001"
           title="Proceedings of the 15th International Conference on Model-Driven Engineering"
           year="2020"/>

  <!-- InProceedings referencing the proceedings via inheritance fields -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc001"
           title="Testing Strategies for Model Transformations"
           year="2020"
           booktitle="Proceedings of the 15th International Conference on Model-Driven Engineering">
    <authors author="Frank Tester"/>
    <authors author="Grace Verifier"/>
  </entries>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book001"
           title="Foundations of Model-Driven Engineering"
           year="2014"
           publisher="TechBooks Publishing">
    <authors author="Henry Architect"/>
    <authors author="Ivy Designer"/>
  </entries>

  <!-- InCollection: chapter in an edited book -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol001"
           title="Quality Assurance Techniques for Model Transformations"
           year="2014"
           publisher="TechBooks Publishing"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Jack Quality"/>
  </entries>

  <!-- InBook: specific chapter in a book -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook001"
           title="Formal Semantics of Transformation Languages"
           year="2014"
           publisher="TechBooks Publishing"
           chapter="7">
    <authors author="Ivy Designer"/>
  </entries>

  <!-- Booklet: dated but without title/author in this metamodel -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet001"
           year="2012"/>

  <!-- Misc entry with only mandatory id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc001"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd001"
           title="Scalable Testing of Model Transformations"
           year="2019"
           school="University of Advanced Studies">
    <authors author="Laura Doctoral"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc001"
           title="Automated Generation of Transformation Test Suites"
           year="2017"
           school="Technical University of Innovation">
    <authors author="Mike Graduate"/>
  </entries>

</BibTeX:BibTeXFile>