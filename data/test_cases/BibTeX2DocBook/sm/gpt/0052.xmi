<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_authors_2020"
           title="Scalable Model Transformations in Practice"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="Alice Example"/>
    <authors author="Bob Sample"/>
  </entries>

  <!-- TechReport with three authors -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_case_study_2019"
           title="A Case Study on Testing ATL Transformations"
           year="2019">
    <authors author="Carlos Tester"/>
    <authors author="Dana Analyst"/>
    <authors author="Evan Reviewer"/>
  </entries>

  <!-- Unpublished with one author and a note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_experimental_idea"
           title="Preliminary Ideas on Incremental Model Testing"
           note="Draft manuscript, not for distribution">
    <authors author="Frank Researcher"/>
  </entries>

  <!-- Manual without authors (allowed: Manual only requires title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_guide_v3"
           title="User Guide for the MDE Testing Toolkit v3.0"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_symposium_2021"
           title="Proceedings of the 2021 Symposium on Model Engineering"
           year="2021"/>

  <!-- InProceedings inherits Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_coverage_strategies"
           title="High-Coverage Strategies for Model Transformation Testing"
           year="2021"
           booktitle="Proceedings of the 2021 Symposium on Model Engineering">
    <authors author="Grace Quality"/>
    <authors author="Henry Coverage"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_short_intro"
           year="2018"/>

  <!-- Book with two authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_fundamentals"
           title="Fundamentals of Model-Driven Engineering"
           year="2017"
           publisher="Academic Press">
    <authors author="Irene Architect"/>
    <authors author="James Designer"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_testing"
           title="Testing Techniques for Model Transformations"
           year="2017"
           publisher="Academic Press"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Karen Tester"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_5_examples"
           title="Model-Driven Engineering: Concepts and Examples"
           year="2016"
           publisher="Tech Publishers"
           chapter="5">
    <authors author="Liam Example"/>
    <authors author="Mia Pattern"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry (only id required) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_dataset_reference"/>
  
  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_model_testing"
           title="Systematic Testing of Model Transformations"
           year="2015"
           school="University of Model Engineering">
    <authors author="Nora Doctoral"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_trace_analysis"
           title="Traceability Analysis in Model Transformations"
           year="2014"
           school="Institute of Software Systems">
    <authors author="Oscar Student"/>
  </entries>

</BibTeX:BibTeXFile>