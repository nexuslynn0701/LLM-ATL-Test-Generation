<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2022deep"
           title="Deep Learning for Model Transformations"
           year="2022"
           journal="Journal of Model-Driven Engineering">
    <authors author="John Smith"/>
    <authors author="Alice Brown"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="nguyen2020testing"
           title="Systematic Testing of Model Transformations"
           year="2020">
    <authors author="Minh Nguyen"/>
  </entries>

  <!-- Unpublished with multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="kumar2025draft"
           title="Draft Guidelines for ATL Refactoring"
           note="Preliminary version, not yet submitted.">
    <authors author="Ravi Kumar"/>
    <authors author="Sofia Martinez"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="atluserguide"
           title="ATL User Guide 4.0"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmt2023"
           title="Proceedings of the 16th International Conference on Model Transformation"
           year="2023"/>

  <!-- InProceedings with inheritance from Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="lee2023incremental"
           title="Incremental Execution of ATL Transformations"
           year="2023"
           booktitle="Proceedings of the 16th International Conference on Model Transformation">
    <authors author="Grace Lee"/>
    <authors author="Thomas Fischer"/>
  </entries>

  <!-- Booklet with only year -->
  <entries xsi:type="BibTeX:Booklet"
           id="mdeoverview2019"
           year="2019"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="brown2021mde"
           title="Foundations of Model-Driven Engineering"
           year="2021"
           publisher="Springer">
    <authors author="Alice Brown"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- InCollection based on Book with additional booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="diaz2021chapter"
           title="Testing Strategies for Model Transformations"
           year="2021"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- InBook (chapter in a book) -->
  <entries xsi:type="BibTeX:InBook"
           id="smith2021chapter"
           title="Performance Analysis of Model Transformations"
           year="2021"
           publisher="Springer"
           chapter="7">
    <authors author="John Smith"/>
  </entries>

  <!-- Misc with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="mdewebsite"/>

  <!-- PhD thesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="martinez2024phd"
           title="Automated Testing Frameworks for ATL Transformations"
           year="2024"
           school="Technical University of Madrid">
    <authors author="Sofia Martinez"/>
  </entries>

  <!-- Master thesis with multiple authors (co-authored thesis case) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="cohen2023msc"
           title="Traceability in Model Transformation Testing"
           year="2023"
           school="University of Edinburgh">
    <authors author="Daniel Cohen"/>
    <authors author="Emma Lopez"/>
  </entries>

</BibTeX:BibTeXFile>