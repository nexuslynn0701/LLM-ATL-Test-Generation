<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020deep"
           title="Deep Learning Techniques for Model Transformations"
           year="2020"
           journal="Journal of Model-Driven Engineering">
    <authors author="John Smith"/>
    <authors author="Alice Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="lee2019report"
           title="Formal Analysis of ATL Transformations"
           year="2019">
    <authors author="Michael Lee"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="miller2021draft"
           title="Testing Strategies for Model Transformations"
           note="Under revision for conference submission">
    <authors author="Karen Miller"/>
    <authors author="Diego Alvarez"/>
  </entries>

  <!-- Manual (no authors, no year, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="atlUserGuide"
           title="ATL User Guide Version 4.0"/>
           
  <!-- Proceedings (dated and titled, no authors, no booktitle) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmt2022proc"
           title="Proceedings of the 15th International Conference on Model Transformation"
           year="2022"/>

  <!-- InProceedings inherits Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="garcia2022coverage"
           title="Coverage Criteria for Testing Model Transformations"
           year="2022"
           booktitle="Proceedings of the 15th International Conference on Model Transformation">
    <authors author="Laura Garcia"/>
    <authors author="Tom Becker"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="toolingBooklet"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="brown2017mde"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Peter Brown"/>
    <authors author="Sophie Martin"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="lopez2018chapter"
           title="Model Transformation Testing in Practice"
           year="2018"
           publisher="ACM Press"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Carlos Lopez"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="nguyen2016inbook"
           title="Case Studies in Transformation Testing"
           year="2016"
           publisher="IEEE Computer Society"
           chapter="7">
    <authors author="Lan Nguyen"/>
    <authors author="Robert King"/>
  </entries>

  <!-- Misc with only id (no additional attributes required) -->
  <entries xsi:type="BibTeX:Misc"
           id="dataset2023"/>
           
  <!-- PhDThesis: ThesisEntry with school -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="andersen2015phd"
           title="Scalable Testing of Model Transformations"
           year="2015"
           school="Technical University of Denmark">
    <authors author="Mette Andersen"/>
  </entries>

  <!-- MasterThesis: ThesisEntry with school and two authors -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="zhou2019msc"
           title="Mutation-Based Testing for ATL Transformations"
           year="2019"
           school="University of Edinburgh">
    <authors author="Wei Zhou"/>
    <authors author="Emily Clark"/>
  </entries>

</BibTeX:BibTeXFile>