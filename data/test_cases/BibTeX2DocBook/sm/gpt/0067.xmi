<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-multi-001"
           title="Scalable Model Transformations in Practice"
           year="2022"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Modeler"/>
    <authors author="Bob Transformer"/>
    <authors author="Charlie Tester"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr-async-002"
           title="Asynchronous Evaluation of Transformation Chains"
           year="2021">
    <authors author="Dana Pipeline"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-spec-003"
           title="Preliminary Specification of Incremental ATL Testing"
           note="Draft version, not for distribution">
    <authors author="Evan Incremental"/>
    <authors author="Fiona Regression"/>
  </entries>

  <!-- Manual (no authors, no year, requires title only) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual-tool-004"
           title="ATL Transformation Debugger User Guide"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-conf-005"
           title="Proceedings of the International Conference on Model Testing"
           year="2020"/>

  <!-- InProceedings with its own title/year (from Proceedings) and a booktitle, plus authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-paper-006"
           title="Coverage Criteria for Model Transformation Testing"
           year="2020"
           booktitle="ICMT 2020: International Conference on Model Transformation">
    <authors author="Grace Coverage"/>
    <authors author="Henry Oracle"/>
  </entries>

  <!-- Booklet (only year is mandatory) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-quickref-007"
           year="2019"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book-mde-008"
           title="Foundations of Model-Driven Engineering"
           year="2018"
           publisher="Modeling Press">
    <authors author="Ivy Architect"/>
    <authors author="Jack Designer"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry:
       inherits title/year/publisher from Book and adds booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection-chapter-009"
           title="Testing Strategies for Complex Transformations"
           year="2018"
           publisher="Modeling Press"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Ivy Architect"/>
    <authors author="Karen Verifier"/>
  </entries>

  <!-- InBook with chapter number, reusing author/publisher/year pattern -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-section-010"
           title="Advanced Traceability Techniques"
           year="2018"
           publisher="Modeling Press"
           chapter="7">
    <authors author="Laura Tracer"/>
  </entries>

  <!-- Misc with only id required -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-dataset-011"/>

  <!-- PhDThesis (ThesisEntry subclass) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd-migration-012"
           title="Automated Migration of Legacy Transformations"
           year="2017"
           school="Institute of Software Evolution">
    <authors author="Mark Migrator"/>
  </entries>

  <!-- MasterThesis (ThesisEntry subclass) with two authors to stress AuthoredEntry -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc-benchmark-013"
           title="Benchmarking Framework for ATL Transformations"
           year="2019"
           school="University of Model Testing">
    <authors author="Nina Benchmark"/>
    <authors author="Oscar Metrics"/>
  </entries>

</BibTeX:BibTeXFile>