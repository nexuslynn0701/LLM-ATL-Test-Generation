<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art:distributed-systems"
           title="A Survey of Modern Distributed Systems"
           year="2018"
           journal="Journal of Systems Research">
    <authors author="Alice T. Brown"/>
    <authors author="Michael Green"/>
    <authors author="Sara de la Cruz"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr:model-transformation-testing"
           title="Techniques for Testing Model Transformations"
           year="2020">
    <authors author="David R. Johnson"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub:mde-industry-experience"
           title="Industrial Experiences with Model-Driven Engineering"
           note="Manuscript submitted for publication; under revision.">
    <authors author="Elena Smith"/>
    <authors author="Jonas K. Müller"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="man:tool-user-guide"
           title="User Guide for the MetaTransform Tool 3.0"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc:mde-conf-2021"
           title="Proceedings of the 2021 International Conference on Model-Driven Engineering"
           year="2021"/>

  <!-- InProceedings inheriting from Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc:traceability"
           title="Fine-Grained Traceability for Model Transformations"
           year="2021"
           booktitle="Proceedings of the 2021 International Conference on Model-Driven Engineering">
    <authors author="Rui Zhang"/>
    <authors author="Patricia O&apos;Connor"/>
  </entries>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book:mde-fundamentals"
           title="Fundamentals of Model-Driven Engineering"
           year="2015"
           publisher="Springer">
    <authors author="Nikos Papadopoulos"/>
    <authors author="Laura Fernández"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol:atl-chapter"
           title="ATL in Practice"
           year="2015"
           publisher="Springer"
           booktitle="Fundamentals of Model-Driven Engineering">
    <authors author="Laura Fernández"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook:testing-chapter"
           title="Testing Transformations"
           year="2015"
           publisher="Springer"
           chapter="7">
    <authors author="Nikos Papadopoulos"/>
  </entries>

  <!-- Booklet (dated but no title) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet:tutorial-handout"
           year="2019"/>

  <!-- Misc with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc:project-website"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd:mde-evolution"
           title="Evolution of Model-Driven Engineering Practices"
           year="2017"
           school="Technical University of Munich">
    <authors author="Gregor Weiss"/>
  </entries>

  <!-- MasterThesis with multiple authors (group thesis) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc:model-testing-framework"
           title="A Framework for Automated Testing of Model Transformations"
           year="2019"
           school="University of Edinburgh">
    <authors author="Hannah Lee"/>
    <authors author="Tomáš Novák"/>
  </entries>

</BibTeX:BibTeXFile>