<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artSmith2020"
           title="Model-Driven Analysis of Cyber-Physical Systems"
           year="2020"
           journal="International Journal of Software and Systems Modeling">
    <authors author="John Smith"/>
    <authors author="Maria Garcia"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="trMDE2019"
           title="A Survey on Scalable Model Transformations"
           year="2019">
    <authors author="Laura Brown"/>
  </entries>

  <!-- Unpublished with note and several authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDSL2023"
           title="Domain-Specific Languages for Robotic Swarms"
           note="Draft under major revision">
    <authors author="Kevin Lee"/>
    <authors author="Alice Wong"/>
    <authors author="Patrick O&apos;Neil"/>
  </entries>

  <!-- Manual, title only -->
  <entries xsi:type="BibTeX:Manual"
           id="manualToolX"
           title="ToolX User and Developer Manual v3.2"/>
  
  <!-- Proceedings (dated, titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procMODELS2021"
           title="Proceedings of the 24th International Conference on Model Driven Engineering Languages and Systems"
           year="2021"/>

  <!-- InProceedings referencing a booktitle, inherits Proceedings, AuthoredEntry, and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocVariance2021"
           title="Testing Variability-Intensive Model Transformations"
           year="2021"
           booktitle="MODELS 2021: Proceedings of the 24th International Conference on Model Driven Engineering Languages and Systems">
    <authors author="Emma Johansson"/>
    <authors author="Thomas Müller"/>
  </entries>

  <!-- Booklet, only year (no title in metamodel) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletTutorial2018"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="bookFoundationsMDE"
           title="Foundations of Model-Driven Engineering"
           year="2015"
           publisher="Springer">
    <authors author="Sofia Rossi"/>
    <authors author="David Green"/>
  </entries>

  <!-- InCollection, extends Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollectionChapterM2M"
           title="Advanced Model-to-Model Transformation Techniques"
           year="2016"
           publisher="CRC Press"
           booktitle="Handbook of Model-Driven Software Engineering">
    <authors author="Michael Nguyen"/>
    <authors author="Isabella Clark"/>
  </entries>

  <!-- InBook with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookChapterTesting"
           title="Testing and Debugging Model Transformations"
           year="2017"
           publisher="Elsevier"
           chapter="7">
    <authors author="Oliver Davis"/>
  </entries>

  <!-- Misc, minimal (only id required) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscToolWebsite"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdTraceability2022"
           title="Traceability Techniques for Large-Scale Model Transformations"
           year="2022"
           school="Technical University of Munich">
    <authors author="Hannah Schneider"/>
  </entries>

  <!-- MasterThesis with two authors is allowed by metamodel (AuthoredEntry) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterCoEvolution2020"
           title="Co-Evolution of Models and Transformations in Practice"
           year="2020"
           school="Politecnico di Milano">
    <authors author="Ricardo Almeida"/>
    <authors author="Elena Petrova"/>
  </entries>

</BibTeX:BibTeXFile>