<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020deep"
           title="Deep Learning for Model Transformations"
           year="2020"
           journal="Journal of Model-Driven Engineering">
    <authors author="John Smith"/>
    <authors author="Alice Johnson"/>
  </entries>

  <!-- TechReport with three authors -->
  <entries xsi:type="BibTeX:TechReport"
           id="lee2018survey"
           title="A Survey on Testing Model Transformations"
           year="2018">
    <authors author="Kevin Lee"/>
    <authors author="Maria Garcia"/>
    <authors author="Peter Müller"/>
  </entries>

  <!-- Unpublished with a note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="doe2025draft"
           title="Draft Standard for ATL Testing"
           note="Internal draft, not yet submitted.">
    <authors author="Jane Doe"/>
  </entries>

  <!-- Manual (no authors or year, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="atluserguide"
           title="ATL User Guide 3.0"/>
  
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="models2022"
           title="Proceedings of the 2022 International Conference on Model Driven Engineering"
           year="2022"/>

  <!-- InProceedings inheriting Proceeding attributes and adding booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="nguyen2022trace"
           title="Traceability Techniques for ATL Transformations"
           year="2022"
           booktitle="Proceedings of the 2022 International Conference on Model Driven Engineering">
    <authors author="Lan Nguyen"/>
    <authors author="Robert Brown"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="mdeintro2017"
           year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="meyer2019mdebook"
           title="Foundations of Model-Driven Engineering"
           year="2019"
           publisher="Springer">
    <authors author="Thomas Meyer"/>
    <authors author="Emily Clark"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry, contained in an edited volume -->
  <entries xsi:type="BibTeX:InCollection"
           id="rossi2021chapter"
           title="Testing Strategies for Model Transformations"
           year="2021"
           publisher="Elsevier"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Francesca Rossi"/>
  </entries>

  <!-- InBook: specific chapter in a book -->
  <entries xsi:type="BibTeX:InBook"
           id="khan2023chapter5"
           title="Case Studies in ATL Verification"
           year="2023"
           publisher="Morgan &amp; Claypool"
           chapter="5">
    <authors author="Imran Khan"/>
    <authors author="Laura White"/>
  </entries>

  <!-- Misc entry: minimal, only required id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscRefOnlyId"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="garcia2016phd"
           title="Automated Testing of Model Transformations"
           year="2016"
           school="Technical University of Madrid">
    <authors author="Sergio Garcia"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="li2019master"
           title="Coverage Criteria for ATL Transformations"
           year="2019"
           school="University of Tokyo">
    <authors author="Wei Li"/>
  </entries>

</BibTeX:BibTeXFile>