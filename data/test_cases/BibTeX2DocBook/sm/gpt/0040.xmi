<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art2022-mde-validation"
           title="Validation Strategies for Model-Driven Engineering"
           year="2022"
           journal="Journal of Software Engineering Research and Development">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carla Gomez"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr2020-atl-testing"
           title="Systematic Testing of ATL Model Transformations"
           year="2020">
    <authors author="Daniel Lee"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub2023-temporal-constraints"
           title="Temporal Constraints in Model Transformations"
           note="Draft manuscript under revision">
    <authors author="Emily Zhang"/>
    <authors author="Frank Müller"/>
  </entries>

  <!-- Manual without date or authors -->
  <entries xsi:type="BibTeX:Manual"
           id="manual-toolchain-5.1"
           title="MDE Toolchain 5.1 User Guide"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc2021-mde-symposium"
           title="Proceedings of the 2021 Symposium on Model Engineering"
           year="2021"/>

  <!-- InProceedings inside dated proceedings, with booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc2021-traceability"
           title="Fine-Grained Traceability for Incremental Transformations"
           year="2021"
           booktitle="Proceedings of the 2021 Symposium on Model Engineering">
    <authors author="Grace Hopper"/>
    <authors author="Henrietta Lacks"/>
  </entries>

  <!-- Booklet (only year) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet2019-mde-overview"
           year="2019"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book2018-mde-fundamentals"
           title="Fundamentals of Model-Driven Engineering"
           year="2018"
           publisher="TechPress International">
    <authors author="Ian Turner"/>
    <authors author="Julia Novak"/>
  </entries>

  <!-- InCollection in a book, with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection2018-chapter7"
           title="Testing and Quality Assurance in MDE"
           year="2018"
           publisher="TechPress International"
           booktitle="Fundamentals of Model-Driven Engineering">
    <authors author="Julia Novak"/>
  </entries>

  <!-- InBook in the same book, with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook2018-chapter3"
           title="Metamodeling Techniques"
           year="2018"
           publisher="TechPress International"
           chapter="3">
    <authors author="Ian Turner"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc2024-website-mde-catalog"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis2017-transformations"
           title="Correctness of Model Transformations in Practice"
           year="2017"
           school="Institute of Advanced Software Engineering">
    <authors author="Karen O'Neil"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis2022-coverage"
           title="Coverage Criteria for Model Transformation Testing"
           year="2022"
           school="Department of Computer Science, Metro University">
    <authors author="Liam Brown"/>
    <authors author="Naomi Clark"/>
  </entries>

</BibTeX:BibTeXFile>