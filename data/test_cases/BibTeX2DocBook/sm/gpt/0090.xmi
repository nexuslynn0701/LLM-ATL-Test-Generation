<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplexMDE2020"
           title="Advanced Model-Driven Engineering Workflows"
           year="2020"
           journal="Journal of Software Modeling">
    <authors author="Alice Modeler"/>
    <authors author="Bob Transformer"/>
    <authors author="Carol Tester"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="trATLTesting2019"
           title="Systematic Testing of ATL Transformations"
           year="2019">
    <authors author="David Verifier"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubBidirectional"
           title="Bidirectional Transformations: Unfinished Survey"
           note="Draft version circulated for internal review">
    <authors author="Erin Rewriter"/>
    <authors author="Frank Synchronizer"/>
  </entries>

  <!-- Manual (no authors or year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manToolUserGuide"
           title="User Guide for the MetaTool Suite"/>
           
  <!-- Proceedings (dated & titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procMDEConf2021"
           title="Proceedings of the 5th Conference on Model Engineering"
           year="2021"/>

  <!-- InProceedings: inherits from Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocTraceability"
           title="Proceedings Placeholder Title"
           year="2021"
           booktitle="Proceedings of the 5th Conference on Model Engineering">
    <authors author="Grace Tracer"/>
    <authors author="Henry Analyzer"/>
  </entries>

  <!-- Booklet: only dated -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletQuickRef"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDEPatterns"
           title="Patterns for Model Transformations"
           year="2017"
           publisher="MetaPub Press">
    <authors author="Irene Pattern"/>
    <authors author="Jack Architect"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollectionValidation"
           title="Patterns for Model Transformations"
           year="2017"
           publisher="MetaPub Press"
           booktitle="Collected Studies on Transformation Validation">
    <authors author="Kate Validator"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookChapterDebug"
           title="Patterns for Model Transformations"
           year="2017"
           publisher="MetaPub Press"
           chapter="7">
    <authors author="Leo Debugger"/>
    <authors author="Mia Logger"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry, only id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscInternalNote"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdTransformationTesting"
           title="Testing and Verification of Model Transformations"
           year="2016"
           school="University of Model Engineering">
    <authors author="Nina Researcher"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterIncrementalMDE"
           title="Incremental Techniques in Model-Driven Engineering"
           year="2015"
           school="Institute of Software Models">
    <authors author="Oscar Student"/>
  </entries>

</BibTeX:BibTeXFile>