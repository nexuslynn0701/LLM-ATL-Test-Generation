<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020microservices"
           title="Migrating Legacy Systems to Microservices: An Industrial Study"
           year="2020"
           journal="Journal of Software Modernization">
    <authors author="Alice B. Smith"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="lee2019techreport"
           title="Runtime Monitoring of Safety-Critical Systems"
           year="2019">
    <authors author="Daniel Lee"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="garcia2024draft"
           title="Incremental Model Transformations in Distributed Environments"
           note="Draft manuscript, under submission">
    <authors author="Elena Garcia"/>
    <authors author="Michael Turner"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="toolchainManualV3"
           title="Toolchain Configuration and Deployment Guide, Version 3.0"/>
           
  <!-- Proceedings (dated, titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmde2023"
           title="Proceedings of the 5th International Conference on Model-Driven Engineering"
           year="2023"/>

  <!-- InProceedings: inherits Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="novak2023testing"
           title="Systematic Testing of Model Transformations with Metamorphic Relations"
           year="2023"
           booktitle="ICMDE 2023: Proceedings of the 5th International Conference on Model-Driven Engineering">
    <authors author="Petra Novak"/>
    <authors author="Rahul Singh"/>
  </entries>

  <!-- Booklet (only year, no title or authors) -->
  <entries xsi:type="BibTeX:Booklet"
           id="modelingPatternsBooklet"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="williams2017mdebook"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="TechPress International">
    <authors author="Sarah Williams"/>
    <authors author="Tom Becker"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="khan2017chapter"
           title="Traceability in Large-Scale Model Transformations"
           year="2017"
           publisher="TechPress International"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Imran Khan"/>
  </entries>

  <!-- InBook: specialized Book with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="williams2017ch5"
           title="Chapter 5: Testing and Validation in MDE"
           year="2017"
           publisher="TechPress International"
           chapter="5">
    <authors author="Sarah Williams"/>
  </entries>

  <!-- Misc with minimal information (only id required) -->
  <entries xsi:type="BibTeX:Misc"
           id="adHocReference2022"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="martin2021phd"
           title="Scalable Techniques for Testing Model Transformations"
           year="2021"
           school="University of Central Computing">
    <authors author="Julia Martin"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="chen2022msc"
           title="Empirical Evaluation of ATL Transformation Quality"
           year="2022"
           school="Institute of Software Engineering">
    <authors author="Wei Chen"/>
  </entries>

</BibTeX:BibTeXFile>