<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artKey2026"
           title="Model-Driven Engineering for Heterogeneous Systems"
           year="2026"
           journal="Journal of Advanced Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="trMDETesting"
           title="Systematic Testing of Model Transformations"
           year="2025">
    <authors author="Carla Mendes"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraft"
           title="Draft on Incremental Model Synchronization"
           note="Internal draft, not for distribution">
    <authors author="David Lee"/>
    <authors author="Eva Müller"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="toolManual"
           title="User Manual for the HypeMDE Toolchain"/>
  
  <!-- Proceedings with date and title, no authors -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procMDEConf"
           title="Proceedings of the International Conference on Model Engineering"
           year="2024"/>

  <!-- InProceedings: inherits from Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocKeynote"
           title="Keynote on Scalable Model-Driven Architectures"
           year="2024"
           booktitle="MDE Conference 2024">
    <authors author="Frank O&apos;Connor"/>
  </entries>

  <!-- Booklet with only year -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletGuide"
           year="2023"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="bookRefModels"
           title="Reference Models in Software Engineering"
           year="2022"
           publisher="TechPress Publishing">
    <authors author="Grace Hopper"/>
    <authors author="Henry Ford"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="inCollectionChapter"
           title="Chapter on Model Transformation Verification"
           year="2022"
           publisher="TechPress Publishing"
           booktitle="Reference Models in Software Engineering">
    <authors author="Isabel García"/>
    <authors author="John Doe"/>
  </entries>

  <!-- InBook: specialization of Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookCaseStudy"
           title="Case Studies in Industrial MDE"
           year="2021"
           publisher="IndustryPress"
           chapter="7">
    <authors author="Karen Nguyen"/>
  </entries>

  <!-- Misc entry, only id required -->
  <entries xsi:type="BibTeX:Misc"
           id="miscAnnouncement"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisMDE"
           title="Formal Foundations of Model Transformation Testing"
           year="2020"
           school="University of Metropolis">
    <authors author="Luis Fernández"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisDSL"
           title="Domain-Specific Languages for Testing Transformations"
           year="2019"
           school="Tech University of Gotham">
    <authors author="Maria Rossi"/>
    <authors author="Nikos Papadopoulos"/>
  </entries>

</BibTeX:BibTeXFile>