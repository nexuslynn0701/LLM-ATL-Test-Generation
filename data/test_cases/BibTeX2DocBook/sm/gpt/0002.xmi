<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplex2021"
           title="Advanced Topics in Model-Driven Engineering"
           year="2021"
           journal="Journal of Software Modeling">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techRepTooling2020"
           title="Tool Support for Large-Scale Model Transformations"
           year="2020">
    <authors author="Carlos Martinez"/>
  </entries>

  <!-- Unpublished with note and several authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraftMDE"
           title="A Draft on Incremental Model Synchronization"
           note="To appear, extended version under review.">
    <authors author="Dana Lee"/>
    <authors author="Evan Brown"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualATLSpec"
           title="ATL Language Specification Version 4.0"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procMDEConf2019"
           title="Proceedings of the 2019 Conference on Model-Driven Engineering"
           year="2019"/>

  <!-- InProceedings: proceedings + authored + booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocCaseStudy2019"
           title="A Case Study on Testing Model Transformations"
           year="2019"
           booktitle="Proceedings of the 2019 Conference on Model-Driven Engineering">
    <authors author="Frank Green"/>
    <authors author="Grace Huang"/>
  </entries>

  <!-- Booklet: only dated -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletIntroMDE2018"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="bookFoundationsMDE"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Henry Clark"/>
    <authors author="Irene Novak"/>
  </entries>

  <!-- InCollection: like Book + booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollectionChapterVerification"
           title="Verification Techniques for Model Transformations"
           year="2017"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Henry Clark"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookChapterTesting"
           title="Testing Strategies for Model Transformations"
           year="2017"
           publisher="Springer"
           chapter="5">
    <authors author="Irene Novak"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscDatasetMDEBenchmarks"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisIncremental"
           title="Incremental Model Transformations: Theory and Practice"
           year="2016"
           school="Technical University of Metropolis">
    <authors author="Julia Adams"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisTraceability"
           title="Traceability Techniques for Model Transformations"
           year="2015"
           school="Institute of Software Engineering">
    <authors author="Kevin Young"/>
  </entries>

</BibTeX:BibTeXFile>