<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplexML"
           title="A Comprehensive Survey on Model-Driven Engineering"
           year="2020"
           journal="Journal of Software Engineering Research and Development">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techRepValidation"
           title="Validation Strategies for Model Transformations"
           year="2019">
    <authors author="Diana Evans"/>
  </entries>

  <!-- Unpublished with note and three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubGraph"
           title="Graph Transformations for Bidirectional Synchronization"
           note="Draft version, not submitted yet">
    <authors author="Frank Martin"/>
    <authors author="Grace Lee"/>
    <authors author="Henry Clark"/>
  </entries>

  <!-- Manual (only title required) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualATLGuide"
           title="ATL Transformation Language Reference Manual"/>
           
  <!-- Proceedings (dated and titled entry) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procMDEConf"
           title="Proceedings of the International Conference on Model-Driven Engineering"
           year="2021"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocTestingATL"
           title="Testing ATL Transformations with Metamodel Mutations"
           year="2021"
           booktitle="International Conference on Model-Driven Engineering">
    <authors author="Isabel Nguyen"/>
    <authors author="John Carter"/>
  </entries>

  <!-- Booklet: only dated entry -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletIntroMDE"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDEPatterns"
           title="Patterns and Best Practices in Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Karen White"/>
    <authors author="Liam Brown"/>
  </entries>

  <!-- InCollection: extends Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="inCollectionTraceability"
           title="Traceability in Model Transformations"
           year="2017"
           publisher="Springer"
           booktitle="Patterns and Best Practices in Model-Driven Engineering">
    <authors author="Karen White"/>
  </entries>

  <!-- InBook: extends Book and adds chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookChapterMetrics"
           title="Metrics for Evaluating Model Transformations"
           year="2017"
           publisher="Springer"
           chapter="5">
    <authors author="Liam Brown"/>
  </entries>

  <!-- Misc: only requires id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscMDEPortal"/>

  <!-- PhDThesis: ThesisEntry subtype -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisTesting"
           title="Testing and Analysis of Model Transformations"
           year="2016"
           school="Technical University of Metropolis">
    <authors author="Michael Scott"/>
  </entries>

  <!-- MasterThesis: ThesisEntry subtype -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisEvolution"
           title="Evolution of Metamodels in Long-Lived Software Systems"
           year="2015"
           school="Metropolis Institute of Technology">
    <authors author="Nina Patel"/>
  </entries>

</BibTeX:BibTeXFile>