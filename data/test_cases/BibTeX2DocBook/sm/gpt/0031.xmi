<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_2020"
           title="A Comprehensive Survey on Model Transformations"
           year="2020"
           journal="Journal of Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Mendes"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_2018_mde"
           title="Industrial Adoption of Model-Driven Engineering"
           year="2018">
    <authors author="Diana Fischer"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_2019_dsl"
           title="Domain-Specific Languages in Practice"
           note="Draft version, not submitted">
    <authors author="Emily Clark"/>
    <authors author="Frank Li"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_1"
           title="ToolX User Manual v3.1"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_icmt_2021"
           title="Proceedings of the International Conference on Model Transformation"
           year="2021"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_refactoring_2021"
           title="Refactoring of Model Transformations: A Case Study"
           year="2021"
           booktitle="Proceedings of the International Conference on Model Transformation">
    <authors author="George Brown"/>
    <authors author="Hannah Nguyen"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_2017_metamodel"
           year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_fundamentals"
           title="Fundamentals of Model-Driven Engineering"
           year="2015"
           publisher="TechPress Publishing">
    <authors author="Ian Thomas"/>
    <authors author="Julia Roberts"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_mdd"
           title="Model-Driven Development in Large-Scale Systems"
           year="2016"
           publisher="Global Science Publishers"
           booktitle="Advances in Software Engineering: Modern Practices">
    <authors author="Kevin Turner"/>
    <authors author="Laura Diaz"/>
  </entries>

  <!-- InBook: specialized Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_validation"
           title="Validation and Verification of Model Transformations"
           year="2019"
           publisher="Engineering Insights Press"
           chapter="7">
    <authors author="Michael Green"/>
  </entries>

  <!-- Misc entry (only id, no additional attributes mandatory) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource_1"/>

  <!-- PhDThesis: ThesisEntry specialization -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_2014_models"
           title="Formal Foundations for Model Transformations"
           year="2014"
           school="University of Technology">
    <authors author="Natalie O&apos;Connor"/>
  </entries>

  <!-- MasterThesis: ThesisEntry specialization with two authors (rare but structurally allowed) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_2022_tooling"
           title="Tool Support for Testing Model Transformations"
           year="2022"
           school="Institute of Computer Science">
    <authors author="Oliver King"/>
    <authors author="Paula Wright"/>
  </entries>

</BibTeX:BibTeXFile>