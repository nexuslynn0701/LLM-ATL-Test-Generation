<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplex2026"
           title="Advanced Model-Driven Engineering Techniques"
           year="2026"
           journal="Journal of Software Modeling">
    <authors author="Alice Example"/>
    <authors author="Bob Sample"/>
    <authors author="Carol Researcher"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techReportMDE"
           title="Evaluation of Model Transformation Testing Strategies"
           year="2025">
    <authors author="David Tester"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraft"
           title="Preliminary Results on Incremental ATL Transformations"
           note="Manuscript in preparation, not yet submitted.">
    <authors author="Eve Engineer"/>
    <authors author="Frank Analyst"/>
  </entries>

  <!-- Manual (no authors, only a title) -->
  <entries xsi:type="BibTeX:Manual"
           id="toolManual"
           title="User Guide for the ATL Transformation Suite 3.0"/>
           
  <!-- Proceedings (dated + titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procConf2024"
           title="Proceedings of the International Conference on Model Transformations"
           year="2024"/>

  <!-- InProceedings (inherits Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocPaperKeynote"
           title="Scalable Testing of Bidirectional Transformations"
           year="2024"
           booktitle="ICMT 2024: International Conference on Model Transformations">
    <authors author="Grace Architect"/>
    <authors author="Henry Developer"/>
  </entries>

  <!-- Booklet (only DatedEntry) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletFlyer"
           year="2023"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="bookReferenceMDE"
           title="Handbook of Model-Driven Engineering"
           year="2022"
           publisher="Springer">
    <authors author="Isabel Modeler"/>
    <authors author="Jack Designer"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="inCollectionChapter"
           title="Test Data Generation for ATL Transformations"
           year="2021"
           publisher="Elsevier"
           booktitle="Advances in Software and Systems Modeling">
    <authors author="Karen Quality"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookChapterDetails"
           title="Formal Foundations of Model Transformations"
           year="2020"
           publisher="Morgan &amp; Claypool"
           chapter="5">
    <authors author="Liam Theorist"/>
    <authors author="Mia Logician"/>
  </entries>

  <!-- Misc entry (minimal BibTeXEntry) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscWebResource"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisTesting"
           title="Testing and Verification of Model Transformations"
           year="2019"
           school="Technical University of Metamodeling">
    <authors author="Noah Scholar"/>
  </entries>

  <!-- MasterThesis with two authors (edge case) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisCaseStudy"
           title="A Case Study in Model Transformation Traceability"
           year="2018"
           school="Institute of Software Systems">
    <authors author="Olivia Graduate"/>
