<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art:multi-authors"
           title="Comprehensive Study of Model Transformations"
           year="2018"
           journal="Journal of Software Engineering Research">
    <authors author="Alice Example"/>
    <authors author="Bob Sample"/>
    <authors author="Carlos Testcase"/>
  </entries>

  <!-- TechReport (authored, dated, titled) -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr:mde-survey"
           title="Survey on Model-Driven Engineering in Practice"
           year="2017">
    <authors author="Dana Engineer"/>
  </entries>

  <!-- Unpublished (authored, titled, note, no year) -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub:atl-extensions"
           title="Planned Extensions to ATL for Incremental Transformations"
           note="Draft manuscript, not yet submitted">
    <authors author="Erin Researcher"/>
    <authors author="Frank Developer"/>
  </entries>

  <!-- Manual (titled only) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual:tool-guide"
           title="User Guide for the Transformation Testing Framework"/>
           
  <!-- Proceedings (dated and titled, but no authors or booktitle) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc:mde-2020"
           title="Proceedings of the 10th International Conference on Model-Driven Engineering"
           year="2020"/>

  <!-- InProceedings (inherits from Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc:test-oracles"
           title="Automated Test Oracles for Model Transformations"
           year="2020"
           booktitle="Proceedings of the 10th International Conference on Model-Driven Engineering">
    <authors author="Grace Validator"/>
    <authors author="Henry Checker"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet:mde-tutorial"
           year="2016"/>

  <!-- Book (authored, dated, titled, publisher) -->
  <entries xsi:type="BibTeX:Book"
           id="book:mde-foundations"
           title="Foundations of Model-Driven Engineering"
           year="2015"
           publisher="Academic Press">
    <authors author="Ivy Architect"/>
    <authors author="Jack Modeler"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection:traceability"
           title="Traceability in Model Transformations"
           year="2015"
           publisher="Academic Press"
           booktitle="Foundations of Model-Driven Engineering: Selected Chapters">
    <authors author="Karen Tracer"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook:test-chapter"
           title="Testing Techniques for Model Transformations"
           year="2015"
           publisher="Academic Press"
           chapter="7">
    <authors author="Laura Tester"/>
    <authors author="Mark Analyst"/>
  </entries>

  <!-- Misc (minimal BibTeXEntry with only id) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc:website-reference"/>

  <!-- PhDThesis (ThesisEntry: authored, dated, titled, school) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd:metamodel-evolution"
           title="Managing Metamodel Evolution in Large-Scale MDE Projects"
           year="2019"
           school="University of Model Engineering">
    <authors author="Nina Scholar"/>
  </entries>

  <!-- MasterThesis (ThesisEntry: authored, dated, titled, school) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master:atl-testing"
           title="Systematic Testing Strategies for ATL Transformations"
           year="2014"
           school="Institute of Software Technology">
    <authors author="Oscar Graduate"/>
  </entries>

</BibTeX:BibTeXFile>