<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art001"
           title="Model Transformations in Practice"
           year="2018"
           journal="Software Engineering Journal">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr001"
           title="A Survey on ATL Transformations"
           year="2019">
    <authors author="Charlie Brown"/>
  </entries>

  <!-- Unpublished with note and three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub001"
           title="Unreleased Results on MDE Testing"
           note="Draft version, not for distribution">
    <authors author="Diana Prince"/>
    <authors author="Edward Nigma"/>
    <authors author="Fiona Clark"/>
  </entries>

  <!-- Manual (only title required) -->
  <entries xsi:type="BibTeX:Manual"
           id="man001"
           title="ATL Transformation User Guide"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc001"
           title="Proceedings of the International Conference on Model Engineering"
           year="2020"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc001"
           title="Testing Model Transformations: Techniques and Tools"
           year="2020"
           booktitle="Proceedings of the International Conference on Model Engineering">
    <authors author="George Martin"/>
    <authors author="Hannah Lee"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet001"
           year="2015"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book001"
           title="Foundations of Model-Driven Engineering"
           year="2014"
           publisher="TechPress">
    <authors author="Ian Thomas"/>
    <authors author="Jane Doe"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol001"
           title="Chapter on ATL Semantics"
           year="2014"
           publisher="TechPress"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Jane Doe"/>
  </entries>

  <!-- InBook: Book + specific chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook001"
           title="Advanced Topics in Model Transformations"
           year="2016"
           publisher="ScienceWorld"
           chapter="7">
    <authors author="Kevin Miller"/>
    <authors author="Laura King"/>
  </entries>

  <!-- Misc (only id required) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc001"/>

  <!-- PhDThesis: ThesisEntry subtype -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd001"
           title="Automated Testing of Model Transformations"
           year="2017"
           school="University of Metropolis">
    <authors author="Michael Turner"/>
  </entries>

  <!-- MasterThesis: ThesisEntry subtype -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc001"
           title="Performance Evaluation of ATL Transformations"
           year="2015"
           school="Institute of Software Technology">
    <authors author="Nina Patel"/>
  </entries>

</BibTeX:BibTeXFile>