<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-MDE-survey-2020"
           title="A Comprehensive Survey on Model-Driven Engineering"
           year="2020"
           journal="Journal of Software Engineering Research and Development">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carol Davis"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr-ATL-verification-2019"
           title="Verification Techniques for ATL Transformations"
           year="2019">
    <authors author="David Miller"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-emf-patterns-2018"
           title="Patterns for Scalable EMF-Based Tooling"
           note="Draft version, submitted for review">
    <authors author="Eve Thompson"/>
    <authors author="Frank Brown"/>
  </entries>

  <!-- Manual (no authors, no year, only title as per metamodel) -->
  <entries xsi:type="BibTeX:Manual"
           id="man-ATL-user-guide"
           title="ATL Transformation Language User Guide"/>
  
  <!-- Proceedings (titled and dated, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-MODELS-2021"
           title="Proceedings of the 24th International Conference on Model Driven Engineering Languages and Systems"
           year="2021"/>

  <!-- InProceedings with booktitle, inherited title/year, and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-runtime-monitoring-2021"
           title="Runtime Monitoring of Model Transformations"
           year="2021"
           booktitle="Proceedings of the 24th International Conference on Model Driven Engineering Languages and Systems">
    <authors author="Grace Lee"/>
    <authors author="Henry Walker"/>
  </entries>

  <!-- Booklet (only year required) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-MDE-tutorial-2017"
           year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book-MDE-principles-2015"
           title="Principles and Practices of Model-Driven Engineering"
           year="2015"
           publisher="TechPress Publishing">
    <authors author="Iris Clark"/>
    <authors author="Jack Wilson"/>
  </entries>

  <!-- InCollection: is-a Book and BookTitledEntry (booktitle + inherited attributes) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection-graph-transformations-2016"
           title="Graph Transformations in Model-Driven Engineering"
           year="2016"
           publisher="Advanced Computing Press"
           booktitle="Handbook of Model Transformation Techniques">
    <authors author="Karen Martinez"/>
    <authors author="Liam Taylor"/>
  </entries>

  <!-- InBook: specialized Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-testing-MT-2018"
           title="Testing Techniques for Model Transformations"
           year="2018"
           publisher="Software Engineering Texts"
           chapter="7">
    <authors author="Maria Rodriguez"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry, only id required -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-tools-collection"/>

  <!-- PhDThesis as a ThesisEntry -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd-model-evolution-2014"
           title="Model Evolution and Co-Evolution in Practice"
           year="2014"
           school="University of Metropolis">
    <authors author="Nathan Young"/>
  </entries>

  <!-- MasterThesis as a ThesisEntry with two authors (edge case though uncommon) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc-ATL-optimizations-2020"
           title="Optimization Strategies for ATL Model Transformations"
           year="2020"
           school="Institute of Advanced Software Engineering">
    <authors author="Olivia King"/>
    <authors author="Peter Green"/>
  </entries>

</BibTeX:BibTeXFile>