<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth_2020"
           title="Multi-Paradigm Modeling in Practice"
           year="2020"
           journal="Journal of Software Engineering Methods">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_2018_mde_survey"
           title="A Comprehensive Survey on Model-Driven Engineering"
           year="2018">
    <authors author="Caroline Nguyen"/>
  </entries>

  <!-- Unpublished entry with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_2023_mdelab"
           title="Towards Reproducible Experiments in MDE"
           note="Draft version, submitted for review">
    <authors author="David Martinez"/>
    <authors author="Emily Clark"/>
  </entries>

  <!-- Manual (no author/year, only title required) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_5_1"
           title="User Guide for Model Transformation Tool 5.1"/>
           
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_staf_2019"
           title="Proceedings of the STAF 2019 Conference"
           year="2019"/>

  <!-- InProceedings (inherits from Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_2019_testing"
           title="Systematic Testing of Model Transformations"
           year="2019"
           booktitle="STAF 2019: Software Technologies">
    <authors author="Frank Zimmer"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Booklet (only year required) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_intro_2017"
           year="2017"/>

  <!-- Book (authored, dated, titled, with publisher) -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns_2015"
           title="Patterns for Model-Driven Engineering"
           year="2015"
           publisher="TechPress Publishing">
    <authors author="Helen Baker"/>
    <authors author="Ian Wright"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_4"
           title="Model Transformation Testing Strategies"
           year="2015"
           publisher="TechPress Publishing"
           booktitle="Patterns for Model-Driven Engineering">
    <authors author="Helen Baker"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_2"
           title="Foundations of Model Transformations"
           year="2015"
           publisher="TechPress Publishing"
           chapter="2">
    <authors author="Ian Wright"/>
    <authors author="Julia Perez"/>
  </entries>

  <!-- Misc (only id required) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource_1"/>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_2021_transformation"
           title="Advanced Techniques for Optimizing Model Transformations"
           year="2021"
           school="University of Metamodeling">
    <authors author="Kevin Howard"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_2020_testing"
           title="Automated Testing Approaches for ATL Transformations"
           year="2020"
           school="Institute of Software Systems">
    <authors author="Laura Chen"/>
  </entries>

</BibTeX:BibTeXFile>