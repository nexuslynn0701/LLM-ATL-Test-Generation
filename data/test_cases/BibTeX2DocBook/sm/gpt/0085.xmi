<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
      id="art_MDEOverview"
      title="A Comprehensive Overview of Model-Driven Engineering"
      year="2018"
      journal="Software Engineering Review">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
      id="tr_MTTesting"
      title="Testing Model Transformations in Practice"
      year="2020">
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- Unpublished with three authors and a note -->
  <entries xsi:type="BibTeX:Unpublished"
      id="unpub_DSLDebug"
      title="Interactive Debugging for Domain-Specific Languages"
      note="Manuscript in preparation">
    <authors author="Diana Evans"/>
    <authors author="Ethan Brown"/>
    <authors author="Fiona Green"/>
  </entries>

  <!-- Manual (no authors, but titled) -->
  <entries xsi:type="BibTeX:Manual"
      id="manual_ToolUserGuide"
      title="User Guide for the MetaTrans Tool Suite"/>
      
  <!-- Proceedings with date and title -->
  <entries xsi:type="BibTeX:Proceedings"
      id="proc_MDEConf2019"
      title="Proceedings of the 2019 Conference on Model-Driven Engineering"
      year="2019"/>

  <!-- InProceedings that is also a Proceedings (inherits title/year) plus authors and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
      id="inproc_ATLPatterns"
      title="Reusable Transformation Patterns in ATL"
      year="2019"
      booktitle="MDE Conference 2019 Workshop on Transformations">
    <authors author="George Hill"/>
    <authors author="Helen Ito"/>
  </entries>

  <!-- Booklet with year only -->
  <entries xsi:type="BibTeX:Booklet"
      id="booklet_MetamodelCheatsheet"
      year="2017"/>

  <!-- Book with two authors and publisher -->
  <entries xsi:type="BibTeX:Book"
      id="book_MTFoundations"
      title="Foundations of Model Transformation"
      year="2015"
      publisher="Academic Press">
    <authors author="Ian King"/>
    <authors author="Julia Lee"/>
  </entries>

  <!-- InCollection: extends Book and BookTitledEntry, requires booktitle and inherits publisher/title/year/authors -->
  <entries xsi:type="BibTeX:InCollection"
      id="incol_QoSTransforms"
      title="Quality of Service in Model Transformations"
      year="2016"
      publisher="Tech Books"
      booktitle="Advances in Model-Driven Engineering">
    <authors author="Kevin Martin"/>
    <authors author="Laura Nelson"/>
  </entries>

  <!-- InBook: a Book with chapter attribute -->
  <entries xsi:type="BibTeX:InBook"
      id="inbook_SecChapter"
      title="Security Concerns in Model Transformation Pipelines"
      year="2014"
      publisher="SecureSoft Publishing"
      chapter="7">
    <authors author="Michael Owens"/>
  </entries>

  <!-- Misc: only mandatory id -->
  <entries xsi:type="BibTeX:Misc"
      id="misc_ToolWebsite"/>

  <!-- PhDThesis with multiple authors is unusual but allowed by meta-model (authors list) -->
  <entries xsi:type="BibTeX:PhDThesis"
      id="phd_ModelRefactor"
      title="Automated Refactoring of Model Transformations"
      year="2013"
      school="University of Metropolis">
    <authors author="Nina Patel"/>
  </entries>

  <!-- MasterThesis with single author -->
  <entries xsi:type="BibTeX:MasterThesis"
      id="msc_ModelTesting"
      title="Automation Techniques for Testing Model Transformations"
      year="2021"
      school="Tech University">
    <authors author="Oliver Quinn"/>
  </entries>

</BibTeX:BibTeXFile>