<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020deep"
           title="Deep Learning for Model Transformations"
           year="2020"
           journal="Journal of Model-Driven Engineering">
    <authors author="John Smith"/>
    <authors author="Emily Johnson"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="lee2019report"
           title="Testing Strategies for ATL Transformations"
           year="2019">
    <authors author="Kevin Lee"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="garcia2021draft"
           title="Draft Guidelines for Model Transformation Benchmarks"
           note="Manuscript in preparation">
    <authors author="Maria Garcia"/>
    <authors author="Lars Petersen"/>
    <authors author="Anne Dupont"/>
  </entries>

  <!-- Manual (no authors, not dated) -->
  <entries xsi:type="BibTeX:Manual"
           id="atltoolingmanual"
           title="ATL Tooling User Manual"/>
           
  <!-- Proceedings (dated and titled, but no authors or booktitle) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="mdeconf2022"
           title="Proceedings of the 2022 Conference on Model-Driven Engineering"
           year="2022"/>

  <!-- InProceedings inheriting from Proceedings, with authors and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="brown2022case"
           title="A Case Study on Incremental Model Transformation"
           year="2022"
           booktitle="Proceedings of the 2022 Conference on Model-Driven Engineering">
    <authors author="Thomas Brown"/>
    <authors author="Sara Müller"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="flyer2023"
           year="2023"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="mdehandbook"
           title="Handbook of Model-Driven Engineering"
           year="2018"
           publisher="Springer">
    <authors author="Alice Martin"/>
    <authors author="David Clark"/>
  </entries>

  <!-- InCollection: book chapter in an edited book with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="nguyen2018chapter"
           title="Testing and Debugging Model Transformations"
           year="2018"
           publisher="Springer"
           booktitle="Handbook of Model-Driven Engineering">
    <authors author="Trang Nguyen"/>
  </entries>

  <!-- InBook: chapter in a book with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="rodriguez2018chapter7"
           title="Advanced Topics in ATL"
           year="2018"
           publisher="Springer"
           chapter="7">
    <authors author="Carlos Rodriguez"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscResource01"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="kim2017phd"
           title="Automated Testing of Model Transformations"
           year="2017"
           school="Technical University of Berlin">
    <authors author="Min-Soo Kim"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="fernandez2019msc"
           title="Traceability in ATL Model Transformations"
           year="2019"
           school="University of Seville">
    <authors author="Laura Fernandez"/>
  </entries>

</BibTeX:BibTeXFile>