<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artKey2024"
           title="Model Transformations in Practice"
           year="2024"
           journal="Journal of Model Engineering">
    <authors author="Alice Example"/>
    <authors author="Bob Sample"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techRep01"
           title="Verification of ATL Transformations"
           year="2023">
    <authors author="Carol Researcher"/>
  </entries>

  <!-- Unpublished with note and three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraft"
           title="A Draft on Bidirectional Transformations"
           note="To appear, under revision">
    <authors author="David Draft"/>
    <authors author="Eve Editor"/>
    <authors author="Frank Reviewer"/>
  </entries>

  <!-- Manual, no authors, only title -->
  <entries xsi:type="BibTeX:Manual"
           id="toolManual01"
           title="ATL Tooling Reference Manual 2.0"/>
           
  <!-- Proceedings entry -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procConf2022"
           title="Proceedings of the International Conference on Model Engineering"
           year="2022"/>

  <!-- InProceedings inheriting from Proceedings and others -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inProcPaper01"
           title="Testing Strategies for Model Transformations"
           year="2022"
           booktitle="International Conference on Model Engineering">
    <authors author="Grace Tester"/>
    <authors author="Henry Engineer"/>
  </entries>

  <!-- Booklet -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletIntro"
           year="2021"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="mdeBook01"
           title="Foundations of Model-Driven Engineering"
           year="2020"
           publisher="TechPress Publishing">
    <authors author="Ivy Architect"/>
    <authors author="Jack Designer"/>
  </entries>

  <!-- InCollection based on Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="chapterInCollection1"
           title="Chapter on Transformation Languages"
           year="2020"
           publisher="TechPress Publishing"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Karen Contributor"/>
  </entries>

  <!-- InBook with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookChap2"
           title="Advanced Topics in Model Transformations"
           year="2020"
           publisher="TechPress Publishing"
           chapter="2">
    <authors author="Liam Specialist"/>
    <authors author="Mia Analyst"/>
  </entries>

  <!-- Misc entry without additional attributes -->
  <entries xsi:type="BibTeX:Misc"
           id="miscNote01"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesis01"
           title="Scalable Testing of Model Transformations"
           year="2019"
           school="University of Model Science">
    <authors author="Noah Doctoral"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesis01"
           title="Evaluation of BibTeX to DocBook Transformations"
           year="2018"
           school="Institute of Software Modeling">
    <authors author="Olivia Student"/>
  </entries>

</BibTeX:BibTeXFile>