<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_authors"
           title="A Comparative Study of Model Transformation Languages"
           year="2019"
           journal="Journal of Software Engineering Research and Development">
    <authors author="Alice Modeler"/>
    <authors author="Bob Transformer"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_single_author"
           title="Verification Strategies for ATL Transformations"
           year="2020">
    <authors author="Carla Verifier"/>
  </entries>

  <!-- Unpublished without date but with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft_paper"
           title="Draft Guidelines for Model Transformation Testing"
           note="Internal draft, not for distribution.">
    <authors author="Derek Tester"/>
    <authors author="Eva Analyst"/>
  </entries>

  <!-- Manual, only title required -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_guide"
           title="User Guide for the Metamodel Explorer Tool"/>
           
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_symposium_2021"
           title="Proceedings of the 2021 Symposium on Model-Driven Engineering"
           year="2021"/>

  <!-- InProceedings inside a proceedings-like entry, with authors and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study"
           title="A Case Study on Incremental Model Synchronization"
           year="2021"
           booktitle="Proceedings of the 2021 Symposium on Model-Driven Engineering">
    <authors author="Frank Synchronizer"/>
    <authors author="Grace Incremental"/>
  </entries>

  <!-- Booklet with year only -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_tutorial_notes"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_principles"
           title="Principles of Model-Driven Engineering"
           year="2016"
           publisher="Modeling Press">
    <authors author="Helen Architect"/>
    <authors author="Ian Designer"/>
  </entries>

  <!-- InCollection: book + booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_metamodels"
           title="Advanced Metamodeling Techniques"
           year="2016"
           publisher="Modeling Press"
           booktitle="Principles of Model-Driven Engineering">
    <authors author="Helen Architect"/>
    <authors author="Jake Metamodeler"/>
  </entries>

  <!-- InBook with chapter, inherits book properties -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_testing"
           title="Testing and Debugging Model Transformations"
           year="2016"
           publisher="Modeling Press"
           chapter="7">
    <authors author="Ian Designer"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource"/>

  <!-- PhD Thesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_transformation_testing"
           title="Systematic Testing of Model Transformations"
           year="2017"
           school="Technical University of Modeling">
    <authors author="Karen Researcher"/>
  </entries>

  <!-- Master Thesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_traceability"
           title="Traceability Techniques for Model Transformations"
           year="2015"
           school="Institute of Software Models">
    <authors author="Leo Student"/>
  </entries>

</BibTeX:BibTeXFile>