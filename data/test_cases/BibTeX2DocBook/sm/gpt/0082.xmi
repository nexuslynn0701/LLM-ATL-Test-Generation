<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020deep"
           title="Deep Learning Approaches for Model Transformations"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="John Smith"/>
    <authors author="Alice Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="lee2018report"
           title="A Comprehensive Survey on ATL Transformations"
           year="2018">
    <authors author="Michael Lee"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="garcia2021draft"
           title="Draft Specification of a Next-Gen MDE Toolchain"
           note="Submitted for internal review, not yet public.">
    <authors author="Laura Garcia"/>
    <authors author="Peter Novak"/>
  </entries>

  <!-- Manual (only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="toolkitManualV3"
           title="User Manual for the MDE Toolkit Version 3.0"/>
           
  <!-- Proceedings with date and title -->
  <entries xsi:type="BibTeX:Proceedings"
           id="models2022proc"
           title="Proceedings of the 2022 Conference on Model-Driven Engineering"
           year="2022"/>

  <!-- InProceedings, inheriting from Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="wang2022trace"
           title="Traceability-Driven Testing of Model Transformations"
           year="2022"
           booktitle="Proceedings of the 2022 Conference on Model-Driven Engineering">
    <authors author="Hao Wang"/>
    <authors author="Sophie Martin"/>
  </entries>

  <!-- Booklet (only year, from DatedEntry) -->
  <entries xsi:type="BibTeX:Booklet"
           id="shortGuideMDE"
           year="2019"/>

  <!-- Book with authors, year, title, publisher -->
  <entries xsi:type="BibTeX:Book"
           id="brown2017book"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="Academic Press">
    <authors author="Kevin Brown"/>
    <authors author="Emma Davis"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="davis2017chapter"
           title="Testing and Validation in Model Transformations"
           year="2017"
           publisher="Academic Press"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Emma Davis"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="brown2017inbook"
           title="Case Studies in Transformation Testing"
           year="2017"
           publisher="Academic Press"
           chapter="5">
    <authors author="Kevin Brown"/>
  </entries>

  <!-- Misc entry with only mandatory id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscLocalNote"/>

  <!-- PhDThesis: ThesisEntry specialization -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="rossi2019phd"
           title="Scalable Techniques for Testing Model Transformations"
           year="2019"
           school="Polytechnic Institute of Software Systems">
    <authors author="Marco Rossi"/>
  </entries>

  <!-- MasterThesis: ThesisEntry specialization -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="kim2020master"
           title="Automated Generation of Test Models for ATL"
           year="2020"
           school="University of Model Engineering">
    <authors author="Yuna Kim"/>
  </entries>

</BibTeX:BibTeXFile>