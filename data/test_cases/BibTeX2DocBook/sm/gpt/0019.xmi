<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020complex"
           title="Complexity-Aware Model Transformations"
           year="2020"
           journal="Journal of Model-Driven Engineering">
    <authors author="John Smith"/>
    <authors author="Alice Johnson"/>
  </entries>

  <!-- TechReport single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="doe2019report"
           title="Industrial Experiences with ATL Transformations"
           year="2019">
    <authors author="Michael Doe"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="miller2021draft"
           title="Draft Semantics for Incremental Model Transformations"
           note="Submitted for review, not yet accepted.">
    <authors author="Carla Miller"/>
    <authors author="Tim Baker"/>
  </entries>

  <!-- Manual (no author, no year, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="atluserguide"
           title="ATL Transformation Language User Guide"/>

  <!-- Proceedings (dated and titled, but no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmt2022proc"
           title="Proceedings of the 15th International Conference on Model Transformations"
           year="2022"/>

  <!-- InProceedings: authored, dated (via Proceedings), booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="garcia2022trace"
           title="Traceability Patterns in Bidirectional Transformations"
           year="2022"
           booktitle="ICMT 2022: International Conference on Model Transformations">
    <authors author="Laura Garcia"/>
    <authors author="Pedro Castillo"/>
  </entries>

  <!-- Booklet: only dated -->
  <entries xsi:type="BibTeX:Booklet"
           id="summerSchool2018"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="guerra2017mde"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Esther Guerra"/>
    <authors author="Jesús de Lara"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="wimmer2017chapter"
           title="Testing Model Transformations"
           year="2017"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering: Selected Chapters">
    <authors author="Manuel Wimmer"/>
  </entries>

  <!-- InBook: specialization of Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="bergmann2016chapter5"
           title="Incremental Model Synchronization"
           year="2016"
           publisher="Morgan Kaufmann"
           chapter="5">
    <authors author="Gunnar Bergmann"/>
  </entries>

  <!-- Misc: bare BibTeXEntry -->
  <entries xsi:type="BibTeX:Misc"
           id="anonymousToolDemo"/>
  
  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="lee2015phd"
           title="Scalable Techniques for Model Transformation Testing"
           year="2015"
           school="Technical University of Metropolis">
    <authors author="Daniel Lee"/>
  </entries>

  <!-- MasterThesis with multiple authors (edge case) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="nguyen2020msc"
           title="Model-Based Testing of Transformation Chains"
           year="2020"
           school="Metropolis Institute of Technology">
    <authors author="Lan Nguyen"/>
    <authors author="Chris Parker"/>
  </entries>

</BibTeX:BibTeXFile>