<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020deep"
           title="Deep Learning for Model Transformations"
           year="2020"
           journal="Journal of Model-Driven Engineering">
    <authors author="John Smith"/>
    <authors author="Alice Doe"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="jones2018survey"
           title="A Survey on ATL Transformations"
           year="2018">
    <authors author="Robert Jones"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="brownDraftMDE"
           title="Draft: Testing Model Transformations"
           note="Manuscript in preparation">
    <authors author="Maria Brown"/>
    <authors author="Lukas Meier"/>
  </entries>

  <!-- Manual (title only, no authors/year required) -->
  <entries xsi:type="BibTeX:Manual"
           id="atlUserGuide"
           title="ATL User Guide 3.0"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="models2021proc"
           title="Proceedings of the ACM/IEEE 2021 Conference on Model Driven Engineering"
           year="2021"/>

  <!-- InProceedings (inherits Proceeding, plus authors and booktitle) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="lee2021testing"
           title="Systematic Testing of ATL Transformations"
           year="2021"
           booktitle="Proceedings of the ACM/IEEE 2021 Conference on Model Driven Engineering">
    <authors author="Kevin Lee"/>
    <authors author="Sophie Martin"/>
  </entries>

  <!-- Booklet (only dated, no title required by metamodel) -->
  <entries xsi:type="BibTeX:Booklet"
           id="toolFlyer2022"
           year="2022"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="green2023mdebook"
           title="Foundations of Model-Driven Engineering"
           year="2023"
           publisher="Springer">
    <authors author="Thomas Green"/>
    <authors author="Elena Rossi"/>
  </entries>

  <!-- InCollection: a chapter in an edited book with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="rossi2023chap"
           title="Testing Techniques for Model Transformations"
           year="2023"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Elena Rossi"/>
  </entries>

  <!-- InBook: chapter number, inherits Book properties -->
  <entries xsi:type="BibTeX:InBook"
           id="green2023chap2"
           title="Advanced Topics in Model-Driven Engineering"
           year="2023"
           publisher="Springer"
           chapter="2">
    <authors author="Thomas Green"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscRef001"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="nguyenPhD2020"
           title="Quality Assurance for Model Transformations"
           year="2020"
           school="University of Technology">
    <authors author="Minh Nguyen"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="garciaMSc2019"
           title="Tool Support for Testing ATL Rules"
           year="2019"
           school="Technical University of Madrid">
    <authors author="Carlos Garcia"/>
  </entries>

</BibTeX:BibTeXFile>