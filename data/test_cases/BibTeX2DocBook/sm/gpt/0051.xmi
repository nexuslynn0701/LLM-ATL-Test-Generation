<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-mde-survey"
           title="A Comprehensive Survey on Model-Driven Engineering"
           year="2018"
           journal="Journal of Software Engineering Research">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Gomez"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr-transformation-testing"
           title="Techniques for Testing Model Transformations"
           year="2020">
    <authors author="Dana Lee"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-dsml-evolution"
           title="On the Evolution of Domain-Specific Modeling Languages"
           note="Preprint, under revision for conference submission">
    <authors author="Ethan Brown"/>
    <authors author="Fiona White"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual-atl-tooling"
           title="ATL Transformation Language User Guide"/>
           
  <!-- Proceedings entry (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-mbt-workshop-2022"
           title="Proceedings of the 10th Workshop on Model-Based Testing"
           year="2022"/>

  <!-- InProceedings: authored, dated, titled, and with booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-coverage-criteria"
           title="Coverage Criteria for Testing Model Transformations"
           year="2022"
           booktitle="Proceedings of the 10th Workshop on Model-Based Testing">
    <authors author="George King"/>
    <authors author="Helen Clark"/>
  </entries>

  <!-- Booklet (only year, no title or authors) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-emf-cheatsheet"
           year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book-mde-principles"
           title="Principles of Model-Driven Engineering"
           year="2015"
           publisher="Engineering Press">
    <authors author="Ivan Petrov"/>
    <authors author="Julia Müller"/>
  </entries>

  <!-- InCollection: extends Book and BookTitledEntry (adds booktitle) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection-traceability"
           title="Traceability in Model Transformations"
           year="2016"
           publisher="Tech Books Publishing"
           booktitle="Handbook of Model-Driven Software Engineering">
    <authors author="Karen Davis"/>
  </entries>

  <!-- InBook: specific chapter of a book -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-testing-chapter"
           title="Testing Transformations"
           year="2019"
           publisher="Academic House"
           chapter="7">
    <authors author="Liam O&apos;Connor"/>
    <authors author="Maria Rossi"/>
  </entries>

  <!-- Misc: minimally populated, only required id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-website-mde-resources"/>

  <!-- PhDThesis with full data -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd-model-evolution"
           title="Model Evolution and Consistency Management"
           year="2014"
           school="University of Technology">
    <authors author="Nathan Green"/>
  </entries>

  <!-- MasterThesis with different data -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc-atl-optimization"
           title="Optimization Techniques for ATL Transformations"
           year="2021"
           school="Institute of Computer Science">
    <authors author="Olivia Novak"/>
  </entries>

</BibTeX:BibTeXFile>