<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020deep"
           title="Deep Learning for Model Transformations"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="John Smith"/>
    <authors author="Alice Johnson"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="doe2018report"
           title="Testing Strategies for ATL Transformations"
           year="2018">
    <authors author="Jane Doe"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="brown2025draft"
           title="Draft Specification of Next-Generation MDE Tools"
           note="Manuscript in preparation">
    <authors author="Michael Brown"/>
    <authors author="Laura Green"/>
    <authors author="Pedro Alvarez"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="atlUserGuideV3"
           title="ATL User Guide Version 3.0"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmt2019"
           title="Proceedings of the 12th International Conference on Model Transformations"
           year="2019"/>

  <!-- InProceedings: inherits Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="lee2019composition"
           title="Composing Model Transformations in Practice"
           booktitle="Proceedings of the 12th International Conference on Model Transformations"
           year="2019">
    <authors author="Kevin Lee"/>
    <authors author="Sara Müller"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="flyer2021mde"
           year="2021"/>

  <!-- Book with two authors -->
  <entries xsi:type="BibTeX:Book"
           id="white2022mdebook"
           title="Foundations of Model-Driven Engineering"
           year="2022"
           publisher="Springer">
    <authors author="Emma White"/>
    <authors author="Paul Clarke"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="garcia2023chapter"
           title="Testing and Debugging of Model Transformations"
           year="2023"
           publisher="CRC Press"
           booktitle="Advanced Topics in Model-Driven Engineering">
    <authors author="Carlos Garcia"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="nguyen2024chapter5"
           title="Case Studies in Industrial MDE"
           year="2024"
           publisher="Elsevier"
           chapter="5">
    <authors author="Linh Nguyen"/>
    <authors author="Oliver Stone"/>
  </entries>

  <!-- Misc with only mandatory id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscResource01"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="rodriguez2017phd"
           title="Quality Assurance for Model Transformations"
           year="2017"
           school="Technical University of Madrid">
    <authors author="Ana Rodriguez"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="kim2016master"
           title="Automated Testing of Model Transformations"
           year="2016"
           school="Seoul National University">
    <authors author="David Kim"/>
  </entries>

</BibTeX:BibTeXFile>