<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-MDE-survey"
           title="A Comprehensive Survey on Model-Driven Engineering"
           year="2019"
           journal="Journal of Software Engineering Research">
    <authors author="Alice Modeler"/>
    <authors author="Bob Transformer"/>
    <authors author="Carol Metamodel"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr-testing-transformations"
           title="Testing Strategies for Model Transformations"
           year="2018">
    <authors author="Daniel Tester"/>
  </entries>

  <!-- Unpublished with note and three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-dsl-evolution"
           title="On the Evolution of Domain-Specific Languages"
           note="To appear, under major revision">
    <authors author="Eva Evolution"/>
    <authors author="Frank Refactor"/>
    <authors author="Grace Language"/>
  </entries>

  <!-- Manual without authors -->
  <entries xsi:type="BibTeX:Manual"
           id="man-atl-tooling"
           title="ATL Transformation Tooling User Guide"/>
  
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-moDE2020"
           title="Proceedings of the International Conference on Model Engineering 2020"
           year="2020"/>

  <!-- InProceedings, inheriting date/title from Proceedings and having booktitle + authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-orchestrating-tests"
           title="Orchestrating Test Suites for Model Transformations"
           year="2020"
           booktitle="Proceedings of the International Conference on Model Engineering 2020">
    <authors author="Helen Orchestrator"/>
    <authors author="Ian Integration"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-mde-intro"
           year="2016"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book-mde-principles"
           title="Principles of Model-Driven Development"
           year="2015"
           publisher="Metamodel Press">
    <authors author="Jack Architect"/>
    <authors author="Karen Designer"/>
  </entries>

  <!-- InCollection based on a Book, also with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol-testing-chapter"
           title="Testing and Debugging in Model-Driven Engineering"
           year="2015"
           publisher="Metamodel Press"
           booktitle="Principles of Model-Driven Development">
    <authors author="Laura Debugger"/>
    <authors author="Mark Analyzer"/>
  </entries>

  <!-- InBook, a specific chapter in a Book -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-case-studies"
           title="Case Studies in Model Transformation Testing"
           year="2015"
           publisher="Metamodel Press"
           chapter="7">
    <authors author="Nina CaseStudy"/>
  </entries>

  <!-- Misc entry with only id (no additional attributes required) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-tool-website"/>

  <!-- PhDThesis with school and authors -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd-metamodel-quality"
           title="Quality Assurance in Metamodeling"
           year="2017"
           school="Technical University of Modeling">
    <authors author="Oscar Researcher"/>
  </entries>

  <!-- MasterThesis with school and multiple authors (co-authored thesis) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc-atl-testing"
           title="Automated Testing of ATL Transformations"
           year="2021"
           school="Institute of Software Technology">
    <authors author="Paula Student"/>
    <authors author="Quentin Collaborator"/>
  </entries>

</BibTeX:BibTeXFile>