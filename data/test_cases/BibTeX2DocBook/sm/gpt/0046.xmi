<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_key_0046"
           title="A Comprehensive Survey on Model-Driven Testing"
           year="2018"
           journal="Journal of Software Engineering and Applications">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_key_0046"
           title="Industrial Adoption of ATL Transformations"
           year="2019">
    <authors author="Clara Martinez"/>
  </entries>

  <!-- Unpublished entry exercising note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_key_0046"
           title="Draft Guidelines for Transforming Legacy Systems"
           note="Under revision, not yet submitted.">
    <authors author="Daniel Evans"/>
    <authors author="Eva Peterson"/>
  </entries>

  <!-- Manual without authors (allowed: Manual extends only TitledEntry) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_key_0046"
           title="ATL Transformation Language Reference Manual v1.5"/>
  
  <!-- Proceedings, used as a pure proceedings entry -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_key_0046"
           title="Proceedings of the International Conference on Model Transformation"
           year="2020"/>

  <!-- InProceedings combining Proceedings, AuthoredEntry, and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_key_0046"
           title="Scalable Testing of Model Transformations"
           year="2020"
           booktitle="ICMT 2020: International Conference on Model Transformation">
    <authors author="Frank Liu"/>
    <authors author="Grace Thompson"/>
  </entries>

  <!-- Booklet (dated only, no title/authors) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_key_0046"
           year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_key_0046"
           title="Foundations of Model-Driven Engineering"
           year="2015"
           publisher="TechPress Publishing">
    <authors author="Hannah Weiss"/>
    <authors author="Ian Clark"/>
  </entries>

  <!-- InCollection: Book plus BookTitledEntry (chapter in edited book) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_key_0046"
           title="Testing Strategies for Model Transformations"
           year="2016"
           publisher="Springfield Computer Society"
           booktitle="Handbook of Model-Driven Software Engineering">
    <authors author="Julia Adams"/>
  </entries>

  <!-- InBook: specialized Book with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_key_0046"
           title="Advanced Topics in Model Transformations"
           year="2014"
           publisher="Global Tech Books"
           chapter="7">
    <authors author="Kevin Rogers"/>
    <authors author="Laura Bennett"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry subtype -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_key_0046"/>

  <!-- PhDThesis: ThesisEntry subtype -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_key_0046"
           title="Formal Verification of Model Transformations"
           year="2013"
           school="University of Metamodeling">
    <authors author="Michael Nguyen"/>
  </entries>

  <!-- MasterThesis: another ThesisEntry subtype -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_key_0046"
           title="Automated Test Generation for ATL Transformations"
           year="2012"
           school="Institute of Software Technology">
    <authors author="Nina Fischer"/>
  </entries>

</BibTeX:BibTeXFile>