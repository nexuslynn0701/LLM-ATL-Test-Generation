<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artMultiAuth2020"
           title="Scalable Model Transformations in Practice"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carol Nguyen"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techRepMDE2019"
           title="Industrial Adoption of Model-Driven Engineering"
           year="2019">
    <authors author="Daniel Perez"/>
  </entries>

  <!-- Unpublished with note and several authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDSL2021"
           title="A Unified Approach to Domain-Specific Languages"
           note="Manuscript in preparation">
    <authors author="Emily Zhang"/>
    <authors author="Frank Müller"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="toolManual1"
           title="MDE Tool Suite 3.2 User Guide"/>
           
  <!-- Proceedings (dated + titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procMODELS2018"
           title="Proceedings of the 21st International Conference on Model Driven Engineering Languages and Systems"
           year="2018"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inProcTrace2018"
           title="Traceability Techniques for Model Transformations"
           year="2018"
           booktitle="MODELS 2018 Companion Proceedings">
    <authors author="Grace Lee"/>
    <authors author="Henry Thompson"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletFlyer2022"
           year="2022"/>

  <!-- Book with several authors -->
  <entries xsi:type="BibTeX:Book"
           id="bookIntroMDE2017"
           title="Introduction to Model-Driven Engineering"
           year="2017"
           publisher="TechPress">
    <authors author="Ivan Petrov"/>
    <authors author="Julia Rossi"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="inCollectionChap5"
           title="Verification of Model Transformations"
           year="2017"
           publisher="TechPress"
           booktitle="Introduction to Model-Driven Engineering, Second Edition">
    <authors author="Karl Schmidt"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookChap3"
           title="Metamodeling Foundations"
           year="2016"
           publisher="Academic House"
           chapter="3">
    <authors author="Laura Garcia"/>
    <authors author="Michael Brown"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry subtype -->
  <entries xsi:type="BibTeX:Misc"
           id="miscOnlineRef01"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisRefactoring2015"
           title="Refactoring Techniques for Model Transformations"
           year="2015"
           school="University of Software Engineering">
    <authors author="Natalie Cooper"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisTesting2019"
           title="Testing Frameworks for ATL Transformations"
           year="2019"
           school="Institute of Computer Science">
    <authors author="Oliver Davis"/>
  </entries>

</BibTeX:BibTeXFile>