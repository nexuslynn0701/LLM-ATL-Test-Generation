<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_mde_survey"
           title="A Comprehensive Survey on Model-Driven Engineering Practices"
           year="2018"
           journal="Journal of Software Engineering Methods">
    <authors author="Alice Modeler"/>
    <authors author="Bob Transformer"/>
    <authors author="Charlie Tester"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_testing_m2m"
           title="Strategies for Testing Model-to-Model Transformations"
           year="2016">
    <authors author="Dana Verifier"/>
  </entries>

  <!-- Unpublished with note and three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_incremental_atl"
           title="Incremental Execution of ATL Transformations"
           note="Draft manuscript under internal review">
    <authors author="Eve Incremental"/>
    <authors author="Frank Optimizer"/>
    <authors author="Grace Analyzer"/>
  </entries>

  <!-- Manual without authors -->
  <entries xsi:type="BibTeX:Manual"
           id="man_atl_tooling"
           title="ATL Tooling User Manual, Version 3.2"/>

  <!-- Proceedings only (no authors, no booktitle) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_symp_2020"
           title="Proceedings of the 2020 Symposium on Model-Driven Engineering"
           year="2020"/>

  <!-- InProceedings: inherits year/title from Proceedings, has booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_tracing_rules"
           title="Traceability Techniques for Complex Transformation Chains"
           year="2020"
           booktitle="Symposium on Model-Driven Engineering 2020">
    <authors author="Hank Tracer"/>
    <authors author="Ivy Integrator"/>
  </entries>

  <!-- Book with publisher and multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_model_transformations"
           title="Fundamentals of Model Transformations"
           year="2014"
           publisher="MDE Press">
    <authors author="John Architect"/>
    <authors author="Karen Refiner"/>
  </entries>

  <!-- InCollection, based on Book, adds booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol_qvt_vs_atl"
           title="Comparing QVT and ATL in Industrial Case Studies"
           year="2015"
           publisher="MDE Press"
           booktitle="Advances in Model Transformation Technologies">
    <authors author="Laura Comparator"/>
    <authors author="Mark Evaluator"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_model_debug"
           title="Debugging Model Transformations"
           year="2014"
           publisher="MDE Press"
           chapter="7">
    <authors author="Nina Debugger"/>
  </entries>

  <!-- Booklet (dated only, no title, no authors) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_flyer"
           year="2019"/>

  <!-- Misc minimal entry -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_tool_website"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_model_validation"
           title="Formal Validation of Model Transformations"
           year="2013"
           school="Technical University of Metamodeling">
    <authors author="Olivia Researcher"/>
  </entries>

  <!-- MasterThesis with multiple authors (synthetic but allowed by metamodel) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_atl_testing"
           title="Systematic Testing of ATL Transformations"
           year="2017"
           school="Institute for Software Quality">
    <authors author="Paul Student"/>
    <authors author="Quinn Collaborator"/>
  </entries>

</BibTeX:BibTeXFile>