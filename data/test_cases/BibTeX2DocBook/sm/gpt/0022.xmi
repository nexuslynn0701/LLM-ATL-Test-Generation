<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_complex_2021"
           title="A Comprehensive Survey on Model-Driven Testing"
           year="2021"
           journal="Journal of Software Engineering Studies">
    <authors author="Alice Modeler"/>
    <authors author="Bob Transformer"/>
    <authors author="Carol Tester"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_formal_2020"
           title="Formal Analysis of ATL Transformations"
           year="2020">
    <authors author="David Analyzer"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_mde_ideas"
           title="Unpublished Ideas on Incremental Model Transformations"
           note="Manuscript in preparation, circulated among project partners only.">
    <authors author="Eve Researcher"/>
    <authors author="Frank Collaborator"/>
  </entries>

  <!-- Manual without authors (only TitledEntry) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_guide"
           title="User Guide for the MegaModel Explorer Toolset"/>
           
  <!-- Proceedings (dated + titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mdeconf_2019"
           title="Proceedings of the 12th International Conference on Model-Driven Engineering"
           year="2019"/>

  <!-- InProceedings inheriting from Proceedings, AuthoredEntry, and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_trace_2019"
           title="Tracing Requirements Across Model Transformations"
           year="2019"
           booktitle="Proceedings of the 12th International Conference on Model-Driven Engineering">
    <authors author="Grace Trace"/>
    <authors author="Henry Link"/>
  </entries>

  <!-- Booklet (only DatedEntry) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_intro"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns"
           title="Patterns for Model Transformation Design"
           year="2017"
           publisher="ModelWorld Press">
    <authors author="Iris Architect"/>
    <authors author="John Pattern"/>
  </entries>

  <!-- InCollection extending Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_refactoring"
           title="Refactoring Large Transformation Chains"
           year="2017"
           publisher="ModelWorld Press"
           booktitle="Patterns for Model Transformation Design">
    <authors author="Kate Refactor"/>
    <authors author="Leo Pipeline"/>
  </entries>

  <!-- InBook extending Book and adding chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter15"
           title="Testing Strategies for ATL Transformations"
           year="2017"
           publisher="ModelWorld Press"
           chapter="15">
    <authors author="Mia Tester"/>
  </entries>

  <!-- Misc with only required id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource"/>

  <!-- PhDThesis extending ThesisEntry -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_model_validation"
           title="Validation Techniques for Model Transformations"
           year="2016"
           school="Technical University of Metamodeling">
    <authors author="Noah Doctoral"/>
  </entries>

  <!-- MasterThesis extending ThesisEntry -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_bidirectional"
           title="Bidirectional Synchronization of UML and Code"
           year="2015"
           school="Institute of Software Systems">
    <authors author="Olivia Student"/>
    <authors author="Paul Supervisor"/>
  </entries>

</BibTeX:BibTeXFile>