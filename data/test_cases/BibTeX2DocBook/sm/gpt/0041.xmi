<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="artMultiAuthor2021"
           title="Composable Model Transformations in Practice"
           year="2021"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Example"/>
    <authors author="Bob Sample"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="trMDETools2020"
           title="A Survey of Tool Support for Model Transformations"
           year="2020">
    <authors author="Clara Researcher"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubATLTesting"
           title="Testing Strategies for ATL Transformations"
           note="Under review for internal publication">
    <authors author="David Tester"/>
    <authors author="Eva Engineer"/>
    <authors author="Frank Analyst"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualATLGuide"
           title="ATL Language Reference Manual v1.2"/>
           
  <!-- Proceedings (dated, titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procMDEConf2019"
           title="Proceedings of the 2019 Conference on Model-Driven Engineering"
           year="2019"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocTraceability"
           title="Proceedings Placeholder Title (ignored)"
           year="2019"
           booktitle="Proceedings of the 2019 Conference on Model-Driven Engineering">
    <authors author="Grace Trace"/>
    <authors author="Henry Link"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletTutorial"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDESystems"
           title="Model-Driven Engineering of Complex Systems"
           year="2017"
           publisher="TechPress Publishing">
    <authors author="Irene Architect"/>
    <authors author="John Designer"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incolRefactoring"
           title="Model Refactoring Techniques"
           year="2017"
           publisher="TechPress Publishing"
           booktitle="Model-Driven Engineering of Complex Systems">
    <authors author="Karen Refactor"/>
  </entries>

  <!-- InBook: Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookCaseStudy"
           title="Industrial Case Studies in MDE"
           year="2016"
           publisher="Software Engineering Institute"
           chapter="5">
    <authors author="Liam Practitioner"/>
    <authors author="Mia Consultant"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry subtype without extra fields -->
  <entries xsi:type="BibTeX:Misc"
           id="miscInternalNote"/>
           
  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdModelTesting"
           title="Systematic Testing of Model Transformations"
           year="2015"
           school="University of Metamodeling">
    <authors author="Nina Doctoral"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mscCodeGen"
           title="Code Generation from Platform-Independent Models"
           year="2014"
           school="Institute of Software Systems">
    <authors author="Oscar Graduate"/>
  </entries>

</BibTeX:BibTeXFile>