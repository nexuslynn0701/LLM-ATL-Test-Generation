<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-mde-survey-2021"
           title="A Comprehensive Survey on Model-Driven Engineering"
           year="2021"
           journal="Journal of Software Engineering Research and Development">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carol White"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr-testing-mt-2020"
           title="Testing Strategies for Model Transformations"
           year="2020">
    <authors author="Daniel Brown"/>
  </entries>

  <!-- Unpublished with multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-atl-optim-2022"
           title="Optimization Techniques for ATL Transformations"
           note="Manuscript under revision">
    <authors author="Eva Green"/>
    <authors author="Frank Miller"/>
  </entries>

  <!-- Manual (no author, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="man-atl-tooling-2019"
           title="ATL Tooling User Guide"/>
           
  <!-- Proceedings (conference volume) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-mde-conf-2019"
           title="Proceedings of the International Conference on Model-Driven Engineering"
           year="2019"/>

  <!-- InProceedings with authors and booktitle, inheriting year/title from Proceedings -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-traceability-2019"
           title="Traceability in Large-Scale MDE Projects"
           year="2019"
           booktitle="International Conference on Model-Driven Engineering">
    <authors author="Grace Lee"/>
    <authors author="Henry Clark"/>
  </entries>

  <!-- Booklet (dated but untitled/unauthored in this metamodel) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-mde-tutorial-2018"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book-mde-principles-2017"
           title="Principles of Model-Driven Engineering"
           year="2017"
           publisher="TechPress Publishing">
    <authors author="Ian King"/>
    <authors author="Julia Adams"/>
  </entries>

  <!-- InCollection: chapter in an edited book, with its own booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection-mt-testing-chapter-2017"
           title="Model Transformation Testing in Practice"
           year="2017"
           publisher="TechPress Publishing"
           booktitle="Principles of Model-Driven Engineering">
    <authors author="Laura Scott"/>
    <authors author="Michael Turner"/>
  </entries>

  <!-- InBook: chapter with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-case-study-2017"
           title="Case Study: Industrial Adoption of MDE"
           year="2017"
           publisher="TechPress Publishing"
           chapter="7">
    <authors author="Nina Rogers"/>
  </entries>

  <!-- Misc: minimal entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-online-resource-mde"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd-model-transformation-2016"
           title="Quality Assurance for Model Transformations"
           year="2016"
           school="University of Metropolis">
    <authors author="Oliver Perez"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master-atl-profiling-2018"
           title="Profiling and Performance Analysis of ATL Transformations"
           year="2018"
           school="Institute of Software Technology">
    <authors author="Patricia Young"/>
  </entries>

</BibTeX:BibTeXFile>