<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_authors_2021"
           title="A Survey on Model Transformation Testing"
           year="2021"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carol White"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_single_author_2020"
           title="Industrial Experiences with ATL Transformations"
           year="2020">
    <authors author="David Brown"/>
  </entries>

  <!-- Unpublished entry with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft_mde"
           title="Draft: Formal Semantics of ATL"
           note="Under revision for submission to a major conference">
    <authors author="Eva Green"/>
    <authors author="Frank Black"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_reference"
           title="ATL Transformation Tool Reference Manual"/>
           
  <!-- Proceedings (no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_symposium_2019"
           title="Proceedings of the 2019 Symposium on Model-Driven Engineering"
           year="2019"/>

  <!-- InProceedings extending Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study_2019"
           title="Case Study: Testing Large-Scale Model Transformations"
           year="2019"
           booktitle="Proceedings of the 2019 Symposium on Model-Driven Engineering">
    <authors author="Grace Hopper"/>
    <authors author="Henry Ford"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_tutorial_2018"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_principles"
           title="Principles of Model-Driven Engineering"
           year="2017"
           publisher="TechPress Publishing">
    <authors author="Ian Gray"/>
    <authors author="Jane Miller"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry (chapter in edited book-like collection) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_transformation_patterns"
           title="Model Transformation Patterns in Practice"
           year="2017"
           publisher="TechPress Publishing"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Karen Davis"/>
    <authors author="Luke Wilson"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_testing"
           title="Testing Techniques for Model Transformations"
           year="2017"
           publisher="TechPress Publishing"
           chapter="5">
    <authors author="Michael Scott"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_website_atl_homepage"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_dissertation_mde_testing"
           title="Automated Testing of Model Transformations"
           year="2016"
           school="University of Model Engineering">
    <authors author="Natalie Reed"/>
  </entries>

  <!-- MasterThesis with two authors (edge but allowed) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_dual_authorship"
           title="Empirical Study of ATL Transformation Quality"
           year="2015"
           school="Institute of Software Technology">
    <authors author="Oliver Stone"/>
    <authors author="Paula Young"/>
  </entries>

</BibTeX:BibTeXFile>