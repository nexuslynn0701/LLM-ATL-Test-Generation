<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artMultiAuthors"
           title="A Comprehensive Survey on Model Transformation Testing"
           year="2021"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Modeler"/>
    <authors author="Bob Transformer"/>
    <authors author="Carol Tester"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techRepSingle"
           title="Industrial Experiences with ATL Transformations"
           year="2019">
    <authors author="David Engineer"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraft"
           title="Preliminary Results on Incremental Model Transformations"
           note="Draft version, not for distribution">
    <authors author="Eve Researcher"/>
    <authors author="Frank Collaborator"/>
  </entries>

  <!-- Manual (no author, no date, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="atlManual"
           title="ATL Language Reference Guide v4.0"/>
           
  <!-- Proceedings (dated + titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="mdeConf2020"
           title="Proceedings of the 15th International Conference on Model-Driven Engineering"
           year="2020"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inProcKeynote"
           title="Keynote on the Future of Model Transformations"
           year="2020"
           booktitle="Proceedings of the 15th International Conference on Model-Driven Engineering">
    <authors author="Grace Architect"/>
  </entries>

  <!-- Booklet (only dated, no title) -->
  <entries xsi:type="BibTeX:Booklet"
           id="toolBrochure"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="mdeTextbook"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="Academic Press">
    <authors author="Henry Scholar"/>
    <authors author="Irene Educator"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="chapterCaseStudies"
           title="Case Studies in Model Transformation Testing"
           year="2017"
           publisher="Academic Press"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="John Analyst"/>
  </entries>

  <!-- InBook: Book + extra chapter attribute -->
  <entries xsi:type="BibTeX:InBook"
           id="chapterATL"
           title="Advanced ATL Techniques"
           year="2017"
           publisher="Academic Press"
           chapter="7">
    <authors author="Karen Developer"/>
    <authors author="Leo Maintainer"/>
  </entries>

  <!-- Misc entry (minimal, only id) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscResource"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisModels"
           title="Scalable Testing Strategies for Model Transformations"
           year="2016"
           school="Technical University of Metropolis">
    <authors author="Maria Doctoral"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisATL"
           title="Improving ATL Transformation Quality via Systematic Testing"
           year="2015"
           school="Institute of Software Engineering">
    <authors author="Nina Graduate"/>
  </entries>

</BibTeX:BibTeXFile>