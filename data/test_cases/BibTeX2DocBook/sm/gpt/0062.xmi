<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth"
           title="Model-Driven Transformation Testing"
           year="2018"
           journal="Journal of Software Engineering">
    <authors author="Alice Tester"/>
    <authors author="Bob Verifier"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech_rep_single"
           title="An Empirical Study on ATL Transformations"
           year="2019">
    <authors author="Carol Researcher"/>
  </entries>

  <!-- Unpublished with required note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft"
           title="Draft Specification of BibTeX2DocBook"
           note="Draft internal report, not yet released">
    <authors author="Daniel Architect"/>
    <authors author="Eva Reviewer"/>
  </entries>

  <!-- Manual without authors (allowed) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool"
           title="User Guide for the Transformation Testing Toolkit"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_conf"
           title="Proceedings of the International Conference on Model Transformations"
           year="2020"/>

  <!-- InProceedings: authored, dated, booktitled -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_paper"
           title="Coverage Criteria for Model Transformation Testing"
           year="2020"
           booktitle="Proceedings of the International Conference on Model Transformations">
    <authors author="Frank Analyst"/>
    <authors author="Grace Quality"/>
  </entries>

  <!-- Booklet: only year required -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_overview"
           year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde"
           title="Foundations of Model-Driven Engineering"
           year="2015"
           publisher="Springer">
    <authors author="Henry Modeler"/>
    <authors author="Irene Designer"/>
  </entries>

  <!-- InCollection: specialization of Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter"
           title="Testing Strategies for ATL Transformations"
           year="2016"
           publisher="Elsevier"
           booktitle="Advances in Model Transformation Research">
    <authors author="Jack Tester"/>
    <authors author="Karen Engineer"/>
  </entries>

  <!-- InBook: specialization of Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_case_study"
           title="Case Studies in Model Transformation Testing"
           year="2014"
           publisher="Morgan Kaufmann"
           chapter="7">
    <authors author="Laura Practitioner"/>
  </entries>

  <!-- Misc: minimal, only id required -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_resource"/>

  <!-- PhDThesis: ThesisEntry subtype -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_thesis"
           title="Automated Testing of Model Transformations"
           year="2013"
           school="Technical University of Atlantis">
    <authors author="Michael Doctoral"/>
  </entries>

  <!-- MasterThesis: ThesisEntry subtype with different school -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_thesis"
           title="Tool Support for Transformation Test Generation"
           year="2012"
           school="Institute of Software Studies">
    <authors author="Nina Graduate"/>
  </entries>

</BibTeX:BibTeXFile>