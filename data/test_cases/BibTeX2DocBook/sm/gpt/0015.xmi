<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art01"
           title="A Comprehensive Survey on Model Transformation Testing"
           year="2021"
           journal="Journal of Software Engineering Research and Development">
    <authors author="Alice Modeler"/>
    <authors author="Bob Transformer"/>
    <authors author="Carol Tester"/>
  </entries>

  <!-- TechReport with two authors -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr01"
           title="Industrial Experiences with ATL Transformations"
           year="2019">
    <authors author="Daniel Engineer"/>
    <authors author="Eva Architect"/>
  </entries>

  <!-- Unpublished with three authors and note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub01"
           title="Towards Automated Oracle Generation for MDE"
           note="Submitted for review to the International Conference on Software Engineering">
    <authors author="Frank Reviewer"/>
    <authors author="Grace Researcher"/>
    <authors author="Henry Analyst"/>
  </entries>

  <!-- Manual (no authors, just title) -->
  <entries xsi:type="BibTeX:Manual"
           id="man01"
           title="ATL Transformation Developer Guide, Version 3.0"/>
           
  <!-- Proceedings -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc01"
           title="Proceedings of the 15th Conference on Model-Driven Engineering"
           year="2020"/>

  <!-- InProceedings with booktitle, authors, and inherited proceedings info -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc01"
           title="Coverage Criteria for Testing Model Transformations"
           year="2020"
           booktitle="Proceedings of the 15th Conference on Model-Driven Engineering">
    <authors author="Irene Coverage"/>
    <authors author="Jack Quality"/>
  </entries>

  <!-- Booklet (dated but untitled in this metamodel) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet01"
           year="2018"/>

  <!-- Book with authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book01"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="TechPress International">
    <authors author="Karen Designer"/>
    <authors author="Larry Modeler"/>
  </entries>

  <!-- InCollection: chapter in an edited book with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol01"
           title="Regression Testing of ATL Transformations"
           year="2017"
           publisher="TechPress International"
           booktitle="Advances in Software Testing for MDE">
    <authors author="Maria Regression"/>
    <authors author="Nick Automation"/>
  </entries>

  <!-- InBook: specific chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook01"
           title="Practical Aspects of Transformation Development"
           year="2017"
           publisher="TechPress International"
           chapter="5">
    <authors author="Olivia Practitioner"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc01"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd01"
           title="Scalable Techniques for Testing Model Transformations"
           year="2016"
           school="University of Model Engineering">
    <authors author="Paul Doctoral"/>
  </entries>

  <!-- MasterThesis with two authors -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc01"
           title="Mutation-Based Testing for ATL"
           year="2015"
           school="Institute of Software Technology">
    <authors author="Quentin Student"/>
    <authors author="Rachel CoAuthor"/>
  </entries>

</BibTeX:BibTeXFile>