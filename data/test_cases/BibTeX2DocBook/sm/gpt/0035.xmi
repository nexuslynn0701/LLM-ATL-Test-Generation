<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth_2021"
           title="A Comparative Study of Model Transformation Testing Techniques"
           year="2021"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Martinez"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_static_2020"
           title="Static Analysis of ATL Transformations"
           year="2020">
    <authors author="Diana Clarke"/>
  </entries>

  <!-- Unpublished with two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_bidirectional_idea"
           title="Ideas for Bidirectional BibTeX to DocBook Synchronization"
           note="Draft manuscript, not yet submitted.">
    <authors author="Ethan Brown"/>
    <authors author="Fiona Green"/>
  </entries>

  <!-- Manual (no authors, not dated) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_3_0"
           title="User Manual for the MetaTrans 3.0 Framework"/>
           
  <!-- Proceedings (conference volume, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_conf_2019"
           title="Proceedings of the 2019 International Conference on Model-Driven Engineering"
           year="2019"/>

  <!-- InProceedings extending Proceedings & AuthoredEntry & BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_traceability_2019"
           title="Traceability in Large-Scale Model Transformations"
           year="2019"
           booktitle="Proceedings of the 2019 International Conference on Model-Driven Engineering">
    <authors author="George King"/>
    <authors author="Hannah Lee"/>
  </entries>

  <!-- Booklet (dated but no title/authors) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_tutorial"
           year="2018"/>

  <!-- Book with three authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns_2017"
           title="Patterns and Best Practices in Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Isabel Flores"/>
    <authors author="James Walker"/>
    <authors author="Karen Young"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_testing_chapter"
           title="Testing of Model Transformations"
           year="2017"
           publisher="Springer"
           booktitle="Patterns and Best Practices in Model-Driven Engineering">
    <authors author="Laura Perez"/>
    <authors author="Michael Hughes"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_case_studies"
           title="Industrial Case Studies in Model-Driven Engineering"
           year="2016"
           publisher="Morgan &amp; Claypool"
           chapter="5">
    <authors author="Natalie Owens"/>
  </entries>

  <!-- Misc entry (minimal, only mandatory id) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_website_mde_resources"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_scalable_mde_2015"
           title="Scalable Techniques for Model-Driven Engineering"
           year="2015"
           school="Technical University of Metropolis">
    <authors author="Oliver Quinn"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_testing_atl_2018"
           title="Testing Strategies for ATL Model Transformations"
           year="2018"
           school="Institute of Software Technology">
    <authors author="Paula Rivera"/>
    <authors author="Quentin Doyle"/>
  </entries>

</BibTeX:BibTeXFile>