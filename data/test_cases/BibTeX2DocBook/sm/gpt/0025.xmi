<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth_01"
           title="A Survey on Model-Driven Engineering Practices"
           year="2021"
           journal="Journal of Software Engineering Research and Development">
    <authors author="Alice Johnson"/>
    <authors author="Bob Martínez"/>
  </entries>

  <!-- TechReport with three authors -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_case_study_01"
           title="Industrial Adoption of ATL Transformations"
           year="2020">
    <authors author="Carla Rossi"/>
    <authors author="David Lee"/>
    <authors author="Erik van den Berg"/>
  </entries>

  <!-- Unpublished with single author -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_mde_notes_01"
           title="Notes on Incremental Model Transformations"
           note="Draft manuscript, not yet submitted.">
    <authors author="Fiona Müller"/>
  </entries>

  <!-- Manual without authors (allowed, since Manual only extends TitledEntry) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_usage_01"
           title="ATL Transformation Toolkit User Guide"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_conf_2022"
           title="Proceedings of the 18th International Conference on Model-Driven Engineering"
           year="2022"/>

  <!-- InProceedings: authored, has booktitle and inherits year/title from Proceedings -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_traceability_01"
           title="Traceability in Large-Scale Transformation Chains"
           year="2022"
           booktitle="Proc. 18th Int. Conf. on Model-Driven Engineering">
    <authors author="George Smith"/>
    <authors author="Hanna de Vries"/>
  </entries>

  <!-- Book with two authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_textbook_01"
           title="Foundations of Model-Driven Engineering"
           year="2019"
           publisher="Academic Press">
    <authors author="Ian Thompson"/>
    <authors author="Julia Chen"/>
  </entries>

  <!-- InCollection: inherits from Book and BookTitledEntry, adds booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_analytics_01"
           title="Model Analytics for Transformation Quality"
           year="2019"
           publisher="Academic Press"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Julia Chen"/>
  </entries>

  <!-- InBook: concrete subclass of Book, with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_testing_01"
           title="Testing Model Transformations"
           year="2019"
           publisher="Academic Press"
           chapter="7">
    <authors author="Ian Thompson"/>
    <authors author="Karim O&apos;Neill"/>
  </entries>

  <!-- Booklet: only year required -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_flyer_01"
           year="2018"/>

  <!-- Misc: only id required -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_website_01"/>

  <!-- PhDThesis: ThesisEntry subclass -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_model_evolution_01"
           title="Model Evolution in Long-Lived Software Systems"
           year="2017"
           school="Technical University of Metropolis">
    <authors author="Laura García"/>
  </entries>

  <!-- MasterThesis: ThesisEntry subclass with multiple authors (unusual but allowed by metamodel) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_bidirectional_01"
           title="Bidirectional Transformations for Collaborative Modeling"
           year="2016"
           school="Institute of Technology Studies">
    <authors author="Michael Brown"/>
    <authors author="Nina Kowalski"/>
  </entries>

</BibTeX:BibTeXFile>