<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artKey2020"
           title="Empirical Evaluation of Model Transformations"
           year="2020"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="trMDE2019"
           title="Survey on Testing of Model Transformations"
           year="2019">
    <authors author="Carol White"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraftMDE"
           title="Draft Guidelines for ATL Transformation Design"
           note="Manuscript in preparation">
    <authors author="David Brown"/>
    <authors author="Eva Green"/>
  </entries>

  <!-- Manual (no author, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="atlUserGuide"
           title="ATL User Guide Version 4.0"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmt2021Proc"
           title="Proceedings of the 14th International Conference on Model Transformation"
           year="2021"/>

  <!-- InProceedings combining proceedings, authors, and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="icmt2021Paper01"
           title="Advanced Techniques for Testing ATL Transformations"
           year="2021"
           booktitle="Proceedings of the 14th International Conference on Model Transformation">
    <authors author="Frank Miller"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletIntroMDE"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="mdeTextbook2022"
           title="Foundations of Model-Driven Engineering"
           year="2022"
           publisher="TechScience Press">
    <authors author="Helen Clark"/>
    <authors author="Ian Thomas"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="chapterOnATL"
           title="Foundations of Model-Driven Engineering"
           year="2022"
           publisher="TechScience Press"
           booktitle="Advanced Topics in Model Transformations">
    <authors author="Helen Clark"/>
    <authors author="Jack Wilson"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="mdeChapterTesting"
           title="Foundations of Model-Driven Engineering"
           year="2022"
           publisher="TechScience Press"
           chapter="7">
    <authors author="Ian Thomas"/>
  </entries>

  <!-- Misc (only id required) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscNoteXYZ"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisMDE2023"
           title="Scalable Testing Techniques for Model Transformations"
           year="2023"
           school="University of Software Engineering">
    <authors author="Karen Davis"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisATL2020"
           title="Quality Assurance for ATL-Based Model Transformations"
           year="2020"
           school="Institute of Computer Science">
    <authors author="Liam Martin"/>
  </entries>

</BibTeX:BibTeXFile>