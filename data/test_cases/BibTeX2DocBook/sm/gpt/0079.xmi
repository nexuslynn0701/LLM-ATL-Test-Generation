<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art:complex-systems-2021"
           title="Complex Systems in Model-Driven Engineering"
           year="2021"
           journal="Journal of Software Modeling">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech:mt-testing-2020"
           title="Systematic Testing of Model Transformations"
           year="2020">
    <authors author="Diana Peters"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub:incremental-atl"
           title="Incremental ATL Transformations in Practice"
           note="Draft manuscript under review">
    <authors author="Eve Laurent"/>
    <authors author="Frank Müller"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual:atl-reference"
           title="ATL Language Reference Guide"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc:models-2019"
           title="Proceedings of the 2019 International Conference on Model-Driven Engineering"
           year="2019"/>

  <!-- InProceedings inheriting Proceedings + Authored + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc:model-coverage-2019"
           title="Coverage Criteria for Model Transformation Testing"
           year="2019"
           booktitle="Proceedings of the 2019 International Conference on Model-Driven Engineering">
    <authors author="Grace Lee"/>
    <authors author="Henry Turner"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet:mds-short-intro"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book:mde-foundations"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Isabel Novak"/>
    <authors author="John Carter"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol:traceability-chapter"
           title="Traceability Techniques in Model Transformations"
           year="2017"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Karen O&apos;Brien"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook:testing-chapter"
           title="Testing of Model Transformations"
           year="2017"
           publisher="Springer"
           chapter="7">
    <authors author="John Carter"/>
  </entries>

  <!-- Misc with only id (minimal BibTeXEntry) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc:tool-website"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd:model-evolution-2016"
           title="Model Evolution and Co-Evolution in Practice"
           year="2016"
           school="Technical University of Metropolis">
    <authors author="Laura King"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc:atl-optimization-2015"
           title="Optimization Techniques for ATL Transformations"
           year="2015"
           school="Institute of Software Engineering">
    <authors author="Michael Brown"/>
  </entries>

</BibTeX:BibTeXFile>