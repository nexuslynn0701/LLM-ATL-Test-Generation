<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_smt_2020"
           title="Scalable Model Transformations"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_mde_2019"
           title="Advances in Model-Driven Engineering"
           year="2019">
    <authors author="Carla Gomez"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_mtest_2023"
           title="Testing Strategies for Model Transformations"
           note="Draft under review.">
    <authors author="David Lee"/>
    <authors author="Eva Müller"/>
    <authors author="Frank O&apos;Connor"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="man_tool_guide"
           title="User Guide for the Transformation Workbench"/>
  
  <!-- Proceedings (has year and title, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mdeconf_2021"
           title="Proceedings of the International Conference on MDE"
           year="2021"/>

  <!-- InProceedings combining proceedings, authors, and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study"
           title="A Case Study on Bidirectional Transformations"
           year="2021"
           booktitle="Proceedings of the International Conference on MDE">
    <authors author="Grace Hopper"/>
    <authors author="Henrik Schmidt"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_intro_mde"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_textbook"
           title="Model-Driven Engineering: Concepts and Practice"
           year="2017"
           publisher="TechPress">
    <authors author="Isabella Rossi"/>
    <authors author="James Brown"/>
  </entries>

  <!-- InCollection extends Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_validation"
           title="Model Transformation Validation Techniques"
           year="2017"
           publisher="TechPress"
           booktitle="Model-Driven Engineering: Concepts and Practice">
    <authors author="James Brown"/>
    <authors author="Karen White"/>
  </entries>

  <!-- InBook with chapter information -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_tools"
           title="Tools for Model Transformation Testing"
           year="2017"
           publisher="TechPress"
           chapter="5">
    <authors author="Isabella Rossi"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource"/>
  
  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_robust_mde"
           title="Robustness in Model-Driven Engineering Workflows"
           year="2016"
           school="University of Metamodeling">
    <authors author="Liam Davis"/>
  </entries>

  <!-- MasterThesis with two authors (co-supervised work) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_testing_mde"
           title="Automated Testing of Model Transformations"
           year="2018"
           school="Institute of Software Systems">
    <authors author="Maria Lopez"/>
    <authors author="Nikolai Petrov"/>
  </entries>

</BibTeX:BibTeXFile>