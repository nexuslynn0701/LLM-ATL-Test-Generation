<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-key-2021"
           title="Model-Driven Engineering in Practice"
           year="2021"
           journal="Journal of Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with three authors -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep-ml-2020"
           title="Scalable Model Transformations for Large Systems"
           year="2020">
    <authors author="Carol Davis"/>
    <authors author="David Lee"/>
    <authors author="Eve Martinez"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-mde-ideas"
           title="Unreleased Ideas on Model Synchronization"
           note="Manuscript in preparation">
    <authors author="Frank Nguyen"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="tool-manual-3.0"
           title="MDE Transformation Tool 3.0 User Guide"/>
           
  <!-- Proceedings with date and title but no authors -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-mdeconf-2019"
           title="Proceedings of the 2019 Conference on Model Engineering"
           year="2019"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-trace-2019"
           title="Testing Model Transformations with Traces"
           year="2019"
           booktitle="Proceedings of the 2019 Conference on Model Engineering">
    <authors author="Grace O&apos;Connor"/>
    <authors author="Henry Patel"/>
  </entries>

  <!-- Booklet: only dated entry -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-mde-overview"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book-mde-survey"
           title="Comprehensive Survey of Model-Driven Engineering"
           year="2017"
           publisher="TechPress">
    <authors author="Ian Walker"/>
    <authors author="Julia King"/>
  </entries>

  <!-- InCollection: extends Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection-chapter-constraints"
           title="OCL Constraints in Practice"
           year="2017"
           publisher="TechPress"
           booktitle="Comprehensive Survey of Model-Driven Engineering">
    <authors author="Ian Walker"/>
  </entries>

  <!-- InBook: Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-chapter-testing"
           title="Testing of Model Transformations"
           year="2016"
           publisher="Academic Publishing"
           chapter="7">
    <authors author="Karen Lopez"/>
    <authors author="Liam Brown"/>
  </entries>

  <!-- Misc: only id required -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-web-resource-001"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis-mde-2015"
           title="Advanced Techniques for Model Transformation Testing"
           year="2015"
           school="Institute of Software Technology">
    <authors author="Maria Rossi"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis-mde-2018"
           title="Evaluating Test Criteria for ATL Transformations"
           year="2018"
           school="Faculty of Computer Science">
    <authors author="Niels Andersen"/>
  </entries>

</BibTeX:BibTeXFile>