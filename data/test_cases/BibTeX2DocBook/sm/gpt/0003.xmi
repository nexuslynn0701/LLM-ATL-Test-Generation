<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-conf-2025"
           title="A Comprehensive Survey on Model Transformation Testing"
           year="2025"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Example"/>
    <authors author="Bob Sample"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep-mde-tools"
           title="Tool Support for Scalable Model Transformations"
           year="2023">
    <authors author="Charlie Researcher"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-dsl-design"
           title="Designing Domain-Specific Languages for Testing"
           note="Draft manuscript under review">
    <authors author="Dana Author"/>
    <authors author="Erik Contributor"/>
  </entries>

  <!-- Manual without authors (allowed, since Manual is only TitledEntry) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual-atl-user-guide"
           title="ATL User Guide, Version 4.0"/>
           
  <!-- Proceedings entry (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-mde-symposium-2024"
           title="Proceedings of the 10th Symposium on Model-Driven Engineering"
           year="2024"/>

  <!-- InProceedings using same booktitle as another proceedings-like entry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-test-coverage"
           title="Ensuring High Coverage in Model Transformation Testing"
           year="2024"
           booktitle="Proceedings of the 10th Symposium on Model-Driven Engineering">
    <authors author="Frank Tester"/>
    <authors author="Grace Engineer"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-mde-tutorial"
           year="2022"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book-mde-foundations"
           title="Foundations of Model-Driven Engineering"
           year="2021"
           publisher="Academic Press">
    <authors author="Helen Models"/>
    <authors author="Ian Architect"/>
  </entries>

  <!-- InCollection, extends Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection-validation"
           title="Validation Techniques for Model Transformations"
           year="2021"
           publisher="Academic Press"
           booktitle="Foundations of Model-Driven Engineering: Extended Edition">
    <authors author="Jack Validator"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-chapter3"
           title="Chapter 3: Testing ATL Transformations"
           year="2021"
           publisher="Academic Press"
           chapter="3">
    <authors author="Helen Models"/>
  </entries>

  <!-- Misc entry (no required attributes other than id) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-website-atl-resources"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis-mde-testing"
           title="Advanced Techniques for Testing Model Transformations"
           year="2020"
           school="University of Model Engineering">
    <authors author="Laura Doctoral"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis-traceability"
           title="Traceability Approaches in Model-Driven Development"
           year="2019"
           school="Institute of Software Systems">
    <authors author="Mike Student"/>
  </entries>

</BibTeX:BibTeXFile>