<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art001"
           title="Model-Driven Engineering for Complex Systems"
           year="2018"
           journal="International Journal of Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr001"
           title="A Formal Approach to Model Transformation Testing"
           year="2019">
    <authors author="Charlie Brown"/>
  </entries>

  <!-- Unpublished with multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub001"
           title="Preliminary Results on Bidirectional Transformations"
           note="Draft version, not yet submitted">
    <authors author="Dana White"/>
    <authors author="Evan Green"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="man001"
           title="ATL Transformation Language Reference Manual"/>
           
  <!-- Proceedings (dated, titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc001"
           title="Proceedings of the Model-Driven Engineering Conference"
           year="2020"/>

  <!-- InProceedings (inherits date/title from Proceedings plus authors and booktitle) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc001"
           title="Testing Strategies for Model Transformations"
           year="2020"
           booktitle="Proceedings of the Model-Driven Engineering Conference">
    <authors author="Frank Harris"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet001"
           year="2015"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book001"
           title="Foundations of Model Transformation"
           year="2014"
           publisher="TechBooks Publishing">
    <authors author="Helen King"/>
    <authors author="Ian Moore"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incoll001"
           title="A Survey of Model Synchronization Techniques"
           year="2014"
           publisher="TechBooks Publishing"
           booktitle="Foundations of Model Transformation">
    <authors author="Helen King"/>
    <authors author="Jack Nelson"/>
  </entries>

  <!-- InBook (Book with chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook001"
           title="Case Studies in Model Transformation"
           year="2016"
           publisher="Springer"
           chapter="7">
    <authors author="Laura Perez"/>
  </entries>

  <!-- Misc entry (no extra mandatory attributes) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc001"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd001"
           title="Scalable Techniques for Model Transformation Testing"
           year="2017"
           school="University of Technology">
    <authors author="Michael Quinn"/>
  </entries>

  <!-- MasterThesis with two authors (unusual but allowed structurally) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master001"
           title="Tool Support for Transformation-Based Testing"
           year="2021"
           school="Institute of Computer Science">
    <authors author="Nina Roberts"/>
    <authors author="Oscar Thomas"/>
  </entries>

</BibTeX:BibTeXFile>