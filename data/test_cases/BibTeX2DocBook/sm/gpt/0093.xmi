<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artSmithAI2020"
           title="Advances in Artificial Intelligence"
           year="2020"
           journal="International Journal of AI Research">
    <authors author="John Smith"/>
    <authors author="Alice Johnson"/>
  </entries>

  <!-- TechReport with three authors -->
  <entries xsi:type="BibTeX:TechReport"
           id="trDoeVerification2019"
           title="Formal Verification of Model Transformations"
           year="2019">
    <authors author="Jane Doe"/>
    <authors author="Carlos Perez"/>
    <authors author="Mei Lin"/>
  </entries>

  <!-- Unpublished with single author -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubLeeDraft2023"
           title="Draft Survey on Model-Driven Engineering"
           note="To appear, still under review.">
    <authors author="Kevin Lee"/>
  </entries>

  <!-- Manual without authors (allowed by metamodel) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualATLUserGuide"
           title="ATL Transformation Language User Guide"/>
           
  <!-- Proceedings (no authors, has title and year) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procECMFA2021"
           title="Proceedings of the European Conference on Modelling Foundations and Applications"
           year="2021"/>
           
  <!-- InProceedings: inherits Proceedings, AuthoredEntry and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocGarciaTestingM2M2021"
           title="Testing of Model-to-Model Transformations"
           year="2021"
           booktitle="ECMFA 2021">
    <authors author="Maria Garcia"/>
    <authors author="Thomas Brown"/>
  </entries>

  <!-- Booklet (only year needed) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletIntroMDE2018"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="bookModelDrivenEngineering2015"
           title="Model-Driven Engineering Foundations"
           year="2015"
           publisher="TechPress Publishing">
    <authors author="Laura Martin"/>
    <authors author="Patrick O&apos;Neil"/>
  </entries>

  <!-- InCollection: a chapter in a book, plus booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incolSchmidtDSLs2015"
           title="Domain-Specific Languages in Practice"
           year="2015"
           publisher="TechPress Publishing"
           booktitle="Model-Driven Engineering Foundations">
    <authors author="Michael Schmidt"/>
  </entries>

  <!-- InBook: chapter in a book, with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookRossiTestingChapter2015"
           title="Testing Techniques for Transformations"
           year="2015"
           publisher="TechPress Publishing"
           chapter="7">
    <authors author="Silvia Rossi"/>
    <authors author="Daniel Kim"/>
  </entries>

  <!-- Misc: minimal entry with just an id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscPersonalCommunication2022"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdLopezTransformations2017"
           title="Quality Assurance of Model Transformations"
           year="2017"
           school="University of Metropolis">
    <authors author="Andrea Lopez"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mscNguyenATLDebugging2018"
           title="Debugging ATL Transformations"
           year="2018"
           school="Institute of Software Engineering">
    <authors author="Minh Nguyen"/>
  </entries>

</BibTeX:BibTeXFile>