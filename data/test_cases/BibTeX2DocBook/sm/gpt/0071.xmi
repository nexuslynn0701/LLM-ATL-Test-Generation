<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth"
           title="Model-Driven Engineering in Practice"
           year="2019"
           journal="Journal of Software Engineering Methods">
    <authors author="Alice Modeler"/>
    <authors author="Bob Transformer"/>
    <authors author="Carol Tester"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_validation_framework"
           title="A Framework for Testing Model Transformations"
           year="2020">
    <authors author="David Verifier"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_mde_experiment"
           title="Preliminary Results on Incremental MDE Workflows"
           note="Submitted manuscript, under revision.">
    <authors author="Eve Analyst"/>
    <authors author="Frank Integrator"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_guide"
           title="User Guide for the ATL Transformation Toolset"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_symposium"
           title="Proceedings of the International Symposium on Model-Driven Engineering"
           year="2018"/>

  <!-- InProceedings: authored, dated via Proceedings, and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study"
           title="Industrial Case Study on Large-Scale Model Transformation"
           year="2018"
           booktitle="Proceedings of the International Symposium on Model-Driven Engineering">
    <authors author="Grace Architect"/>
    <authors author="Henry Engineer"/>
  </entries>

  <!-- Booklet (only year) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_intro"
           year="2017"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns"
           title="Patterns for Model Transformations"
           year="2016"
           publisher="Springer">
    <authors author="Irene Pattern"/>
    <authors author="John Template"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry (chapter in edited book) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_testing_chapter"
           title="Testing Techniques for Model Transformations"
           year="2016"
           publisher="Springer"
           booktitle="Patterns for Model Transformations">
    <authors author="Karen Quality"/>
    <authors author="Luke Coverage"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_specific_chapter"
           title="Traceability in Transformation Chains"
           year="2016"
           publisher="Springer"
           chapter="7">
    <authors author="Michael Tracer"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_tool_website"/>
           
  <!-- PhDThesis: ThesisEntry specialization -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_mde_testing"
           title="Systematic Testing of Model Transformations"
           year="2015"
           school="Technical University of Metropolis">
    <authors author="Nina Researcher"/>
  </entries>

  <!-- MasterThesis: ThesisEntry specialization with two authors (unusual but allowed by metamodel) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_bibtex_case"
           title="A Case Study on BibTeX to DocBook Transformation"
           year="2014"
           school="Institute of Software Structures">
    <authors author="Oscar Student"/>
    <authors author="Pat Supervisor"/>
  </entries>

</BibTeX:BibTeXFile>