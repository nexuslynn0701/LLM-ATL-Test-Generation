<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplex2021"
           title="A Comprehensive Study of Model Transformations"
           year="2021"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techRep2020"
           title="Industrial Experiences with ATL Transformations"
           year="2020">
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraft2019"
           title="Draft Guidelines for Model Transformation Testing"
           note="Manuscript in preparation">
    <authors author="Diana Clark"/>
    <authors author="Evan Torres"/>
    <authors author="Fiona Lee"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="atlManual3rd"
           title="ATL Language Reference Manual, Third Edition"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="mdeSymp2022"
           title="Proceedings of the 2022 Symposium on Model-Driven Engineering"
           year="2022"/>

  <!-- InProceedings (inherits Proceedings + AuthoredEntry + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocKeynote2022"
           title="Keynote on Scalable Model Transformations"
           year="2022"
           booktitle="Proceedings of the 2022 Symposium on Model-Driven Engineering">
    <authors author="George King"/>
  </entries>

  <!-- Book with two authors -->
  <entries xsi:type="BibTeX:Book"
           id="mdeBook2018"
           title="Foundations of Model-Driven Engineering"
           year="2018"
           publisher="TechPress Publishing">
    <authors author="Helen Brown"/>
    <authors author="Ian Walker"/>
  </entries>

  <!-- InCollection inside a book context (uses Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="chapterMDETesting"
           title="Testing Techniques for Model Transformations"
           year="2018"
           publisher="TechPress Publishing"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Helen Brown"/>
    <authors author="Julia Nguyen"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookChap5"
           title="Advanced Topics in ATL Semantics"
           year="2019"
           publisher="Academic World">
    <authors author="Kevin O&apos;Brien"/>
    <authors author="Laura Chen"/>
  </entries>
  <entries xsi:type="BibTeX:InBook"
           id="inBookChap5Part2"
           title="Advanced Topics in ATL Semantics, Part II"
           year="2019"
           publisher="Academic World"
           chapter="5">
    <authors author="Kevin O&apos;Brien"/>
  </entries>

  <!-- Booklet (only year) -->
  <entries xsi:type="BibTeX:Booklet"
           id="toolBrochure2023"
           year="2023"/>

  <!-- Misc (only id) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscNote1"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesis2017"
           title="Quality Assurance for Model Transformations"
           year="2017"
           school="University of Metamodeling">
    <authors author="Michael Green"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesis2020"
           title="Incremental Testing of ATL Transformations"
           year="2020"
           school="Institute of Software Systems">
    <authors author="Nora Patel"/>
  </entries>

</BibTeX:BibTeXFile>