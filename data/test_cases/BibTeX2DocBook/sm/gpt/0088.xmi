<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplex2020"
           title="Comprehensive Survey on Model Transformation Testing"
           year="2020"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Researcher"/>
    <authors author="Bob Engineer"/>
    <authors author="Carol Tester"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="trMDETools2019"
           title="Tool Support for Advanced Model Transformations"
           year="2019">
    <authors author="David Toolsmith"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraftMDE"
           title="Draft: Towards Industrial-Scale MDE Evaluation"
           note="Under revision for submission to SoSyM">
    <authors author="Eve Architect"/>
    <authors author="Frank Reviewer"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualATLGuide"
           title="ATL Transformation Language Reference Manual"/>
  
  <!-- Proceedings with date and title (no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procICMT2021"
           title="Proceedings of the 14th International Conference on Model Transformation"
           year="2021"/>

  <!-- InProceedings extending Proceedings, AuthoredEntry and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocTestingATL"
           title="Testing Strategies for ATL Transformations"
           year="2021"
           booktitle="ICMT 2021: International Conference on Model Transformation">
    <authors author="Grace Tester"/>
    <authors author="Heidi Analyst"/>
  </entries>

  <!-- Booklet with date only -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletIntroMDE"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDEPractice"
           title="Model-Driven Engineering in Practice"
           year="2017"
           publisher="TechPress Publishing">
    <authors author="Ian Practitioner"/>
    <authors author="Jane Consultant"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollectionChapTesting"
           title="Chapter on Testing in Model-Driven Engineering"
           year="2017"
           publisher="TechPress Publishing"
           booktitle="Model-Driven Engineering in Practice">
    <authors author="Ian Practitioner"/>
    <authors author="Lucy Quality"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookChapCoverage"
           title="Coverage Criteria for Model Transformations"
           year="2017"
           publisher="TechPress Publishing"
           chapter="5">
    <authors author="Jane Consultant"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscOnlineResource"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisTesting"
           title="Systematic Testing of Model Transformations"
           year="2016"
           school="University of Software Engineering">
    <authors author="Mark Doctoral"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisATL"
           title="Validation of ATL Transformations in Practice"
           year="2015"
           school="Institute of Applied Informatics">
    <authors author="Nina Graduate"/>
  </entries>

</BibTeX:BibTeXFile>