<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
      id="art001"
      title="Model-Driven Engineering in Practice"
      year="2018"
      journal="Journal of Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
      id="tr001"
      title="Verification of Model Transformations"
      year="2019">
    <authors author="Carla Mendes"/>
  </entries>

  <!-- Unpublished with note and three authors -->
  <entries xsi:type="BibTeX:Unpublished"
      id="unpub001"
      title="Towards Automated Testing of ATL Transformations"
      note="Manuscript in preparation">
    <authors author="David Lee"/>
    <authors author="Emma Clark"/>
    <authors author="Frank Martin"/>
  </entries>

  <!-- Manual without authors (allowed: Manual only extends TitledEntry) -->
  <entries xsi:type="BibTeX:Manual"
      id="man001"
      title="ATL Transformation Language Reference Manual"/>
      
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
      id="proc001"
      title="Proceedings of the 10th MDE Conference"
      year="2020"/>

  <!-- InProceedings inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
      id="inproc001"
      title="A Case Study on BibTeX to DocBook Transformation"
      year="2020"
      booktitle="Proceedings of the 10th MDE Conference">
    <authors author="Grace Howard"/>
    <authors author="Ian Turner"/>
  </entries>

  <!-- Booklet (only DatedEntry) -->
  <entries xsi:type="BibTeX:Booklet"
      id="booklet001"
      year="2017"/>

  <!-- Book with two authors and publisher -->
  <entries xsi:type="BibTeX:Book"
      id="book001"
      title="Foundations of Model-Driven Development"
      year="2015"
      publisher="TechPress">
    <authors author="Helen Zhou"/>
    <authors author="James Walker"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
      id="incoll001"
      title="Testing Strategies for Model Transformations"
      year="2016"
      publisher="Springer"
      booktitle="Advances in Model-Driven Engineering">
    <authors author="Kevin Brown"/>
  </entries>

  <!-- InBook: specialized Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
      id="inbook001"
      title="Model Transformation Testing Techniques"
      year="2014"
      publisher="Academic Press"
      chapter="7">
    <authors author="Laura Green"/>
    <authors author="Michael Scott"/>
  </entries>

  <!-- Misc entry with only id -->
  <entries xsi:type="BibTeX:Misc"
      id="misc001"/>

  <!-- PhDThesis: ThesisEntry (Authored, Dated, Titled, with school) -->
  <entries xsi:type="BibTeX:PhDThesis"
      id="phd001"
      title="Scalable Testing of Model Transformations"
      year="2021"
      school="University of Metamodeling">
    <authors author="Natalie Perez"/>
  </entries>

  <!-- MasterThesis: ThesisEntry (Authored, Dated, Titled, with school) -->
  <entries xsi:type="BibTeX:MasterThesis"
      id="msc001"
      title="Quality Assurance for ATL Transformations"
      year="2022"
      school="Institute of Software Systems">
    <authors author="Oliver King"/>
    <authors author="Patricia Young"/>
  </entries>

</BibTeX:BibTeXFile>