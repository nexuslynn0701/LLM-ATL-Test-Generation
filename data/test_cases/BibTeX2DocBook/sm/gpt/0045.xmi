<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_smt_scheduling_2019"
           title="SMT-based Scheduling for Real-Time Systems"
           year="2019"
           journal="Journal of Real-Time Systems">
    <authors author="Alice T. Johnson"/>
    <authors author="Bruno K. Meyer"/>
    <authors author="Carlos R. Santos"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_mde_eval_2018"
           title="Evaluation of Model-Driven Engineering in Industry"
           year="2018">
    <authors author="Diana P. Laurent"/>
  </entries>

  <!-- Unpublished with note and several authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_dsl_refactoring_2020"
           title="Refactoring Techniques for Domain-Specific Languages"
           note="Manuscript submitted for publication">
    <authors author="Erik Q. Novak"/>
    <authors author="Fiona L. Cooper"/>
  </entries>

  <!-- Manual without authors (allowed: Manual only requires title) -->
  <entries xsi:type="BibTeX:Manual"
           id="man_toolchain_guide_2021"
           title="Toolchain Configuration Guide for Embedded Platforms"/>

  <!-- Proceedings -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_symposium_2017"
           title="Proceedings of the 5th Symposium on Model-Driven Engineering"
           year="2017"/>

  <!-- InProceedings with own title, booktitle from proceedings, and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_transformation_testing_2017"
           title="Systematic Testing of Model Transformations"
           year="2017"
           booktitle="Proceedings of the 5th Symposium on Model-Driven Engineering">
    <authors author="Giulia M. Rossi"/>
    <authors author="Harold Y. Tan"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_intro_metamodeling_2016"
           year="2016"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_adv_mde_2015"
           title="Advanced Topics in Model-Driven Engineering"
           year="2015"
           publisher="Springer International Publishing">
    <authors author="Isabel V. Schmidt"/>
    <authors author="Jonas F. Becker"/>
  </entries>

  <!-- InCollection: chapter in an edited book, with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol_variability_2015"
           title="Managing Variability in Large-Scale Model Repositories"
           year="2015"
           publisher="Springer International Publishing"
           booktitle="Advanced Topics in Model-Driven Engineering">
    <authors author="Karen D. Ortega"/>
    <authors author="Liam U. Fraser"/>
  </entries>

  <!-- InBook: specific chapter in the same book -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_verification_2015"
           title="Formal Verification of Model Transformations"
           year="2015"
           publisher="Springer International Publishing"
           chapter="7">
    <authors author="Michael C. Young"/>
  </entries>

  <!-- Misc entry (minimal, only id) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_project_website_2022"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_model_debugging_2014"
           title="Debugging Techniques for Model Transformations"
           year="2014"
           school="Technical University of Munich">
    <authors author="Nora W. Klein"/>
  </entries>

  <!-- MasterThesis with multiple authors (unusual in reality, but allowed by metamodel) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="ms_mde_toolchain_2013"
           title="Integrating Model-Driven Toolchains in Heterogeneous Environments"
           year="2013"
           school="University of Edinburgh">
    <authors author="Olivier G. Bernard"/>
    <authors author="Paula X. Ramos"/>
  </entries>

</BibTeX:BibTeXFile>