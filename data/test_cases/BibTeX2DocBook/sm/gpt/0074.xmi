<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-key-001"
           title="Model-Driven Testing of Transformation Chains"
           year="2019"
           journal="Journal of Software Engineering Research">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr-key-002"
           title="Testing Strategies for ATL Transformations"
           year="2020">
    <authors author="Carol White"/>
  </entries>

  <!-- Unpublished with multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-key-003"
           title="Preliminary Results on Bidirectional Transformations"
           note="Manuscript in preparation">
    <authors author="David Brown"/>
    <authors author="Eva Green"/>
  </entries>

  <!-- Manual (no author, no year required) -->
  <entries xsi:type="BibTeX:Manual"
           id="man-key-004"
           title="ATL User Guide Version 3.0"/>
           
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-key-005"
           title="Proceedings of the International Conference on Model Transformation"
           year="2021"/>
           
  <!-- InProceedings inheriting Proceeding features plus authors and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-key-006"
           title="Coverage Criteria for Model Transformations"
           year="2021"
           booktitle="ICMT 2021">
    <authors author="Frank Miller"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Booklet: only year required -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-key-007"
           year="2018"/>

  <!-- Book with two authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book-key-008"
           title="Foundations of Model-Driven Engineering"
           year="2015"
           publisher="TechPress">
    <authors author="Henry Clark"/>
    <authors author="Ivy Turner"/>
  </entries>

  <!-- InCollection: specialized Book with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol-key-009"
           title="Testing Transformations in Practice"
           year="2016"
           publisher="Springer"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Jack Wilson"/>
  </entries>

  <!-- InBook: specialized Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-key-010"
           title="Reusable Transformation Patterns"
           year="2014"
           publisher="Academic Press"
           chapter="7">
    <authors author="Karen Young"/>
    <authors author="Leo Harris"/>
  </entries>

  <!-- Misc: minimal entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-key-011"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd-key-012"
           title="Automatic Testing of Model Transformations"
           year="2017"
           school="University of Metropolis">
    <authors author="Maria Scott"/>
  </entries>

  <!-- MasterThesis with multiple authors (unusual but allowed by metamodel) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc-key-013"
           title="Tool Support for Transformation Test Generation"
           year="2018"
           school="Institute of Software Technology">
    <authors author="Nathan Adams"/>
    <authors author="Olivia Perez"/>
  </entries>

</BibTeX:BibTeXFile>