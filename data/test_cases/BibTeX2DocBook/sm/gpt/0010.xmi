<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020deepmodels"
           title="Deep Models for Large-Scale Systems"
           year="2020"
           journal="Journal of Advanced Software Engineering">
    <authors author="John Smith"/>
    <authors author="Emily Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="brown2018mde"
           title="Model-Driven Engineering in Practice"
           year="2018">
    <authors author="Michael Brown"/>
  </entries>

  <!-- Unpublished with multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="lee2025draft"
           title="A Draft on Incremental Model Transformations"
           note="Under revision, not submitted yet">
    <authors author="Sophia Lee"/>
    <authors author="Carlos Mendoza"/>
  </entries>

  <!-- Manual (only title required) -->
  <entries xsi:type="BibTeX:Manual"
           id="toolmanual2022"
           title="User Guide for the MegaTransform Toolset"/>
  
  <!-- Proceedings (dated + titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmt2021proc"
           title="Proceedings of the International Conference on Model Transformation"
           year="2021"/>

  <!-- InProceedings: inherits Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="garcia2021trace"
           title="Fine-Grained Traceability for Model Transformations"
           year="2021"
           booktitle="ICMT 2021: International Conference on Model Transformation">
    <authors author="Laura Garcia"/>
    <authors author="Tom Müller"/>
  </entries>

  <!-- Booklet (only year required) -->
  <entries xsi:type="BibTeX:Booklet"
           id="promo2019"
           year="2019"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="khan2022atlas"
           title="The Atlas of Model Transformations"
           year="2022"
           publisher="Springer">
    <authors author="Aisha Khan"/>
    <authors author="Robert Taylor"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry, reuses all book features plus booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="nguyen2023chapter"
           title="Testing Model Transformations"
           year="2023"
           publisher="Elsevier"
           booktitle="Handbook of Model-Driven Engineering">
    <authors author="Minh Nguyen"/>
  </entries>

  <!-- InBook: specialized Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="owen2020chapter5"
           title="Case Studies in Transformation Testing"
           year="2020"
           publisher="Morgan &amp; Claypool"
           chapter="5">
    <authors author="Sarah Owen"/>
    <authors author="Daniel Rossi"/>
  </entries>

  <!-- Misc with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="internalNoteX"/>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="zhang2019phd"
           title="Scalable Verification of Model Transformations"
           year="2019"
           school="Technical University of Munich">
    <authors author="Wei Zhang"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="patel2020msc"
           title="Automated Test Generation for ATL Transformations"
           year="2020"
           school="University of Edinburgh">
    <authors author="Priya Patel"/>
  </entries>

</BibTeX:BibTeXFile>