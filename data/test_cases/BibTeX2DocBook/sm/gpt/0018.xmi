<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art:multi-author-2020"
           title="A Survey on Model-Driven Engineering for Cyber-Physical Systems"
           year="2020"
           journal="Journal of Systems and Software">
    <authors author="Alice Modeler"/>
    <authors author="Bob Transformer"/>
    <authors author="Charlie Verifier"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tech:report-logging-2019"
           title="Logging and Tracing in Large-Scale Model Transformations"
           year="2019">
    <authors author="Dana Analyzer"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub:delta-debugging-2023"
           title="Delta Debugging Strategies for ATL Transformations"
           note="Manuscript in preparation">
    <authors author="Evan Tester"/>
    <authors author="Fiona Debugger"/>
  </entries>

  <!-- Manual without authors (allowed, since Manual only extends TitledEntry) -->
  <entries xsi:type="BibTeX:Manual"
           id="man:atl-tooling-1.5"
           title="ATL Tooling Reference Guide 1.5"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc:mde-conf-2022"
           title="Proceedings of the International Conference on Model-Driven Engineering 2022"
           year="2022"/>

  <!-- InProceedings reusing booktitle different from proceedings title -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc:coverage-2022"
           title="Achieving High Coverage in Model Transformation Testing"
           year="2022"
           booktitle="ICMDE 2022: Proceedings of the International Conference on Model-Driven Engineering">
    <authors author="Grace Coverage"/>
    <authors author="Henry Mutation"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet:atl-cheatsheet-2018"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book:mde-patterns-2016"
           title="Patterns and Best Practices in Model Transformations"
           year="2016"
           publisher="Modeling Press">
    <authors author="Iris Architect"/>
    <authors author="Jack Refactor"/>
  </entries>

  <!-- InCollection within a book (has booktitle and inherits book attributes) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol:traceability-chapter-2016"
           title="Traceability in Model-Driven Engineering"
           year="2016"
           publisher="Modeling Press"
           booktitle="Patterns and Best Practices in Model Transformations">
    <authors author="Iris Architect"/>
    <authors author="Laura Trace"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook:testing-chapter-2016"
           title="Testing and Debugging of Model Transformations"
           year="2016"
           publisher="Modeling Press"
           chapter="7">
    <authors author="Jack Refactor"/>
    <authors author="Mike Tester"/>
  </entries>

  <!-- Misc entry (minimal, only id required) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc:tool-website-2021"/>

  <!-- PhD thesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd:scalability-2021"
           title="Scalability Techniques for Model Transformations"
           year="2021"
           school="University of Metamodeling">
    <authors author="Nina Scalability"/>
  </entries>

  <!-- Master thesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master:co-evolution-2020"
           title="Co-evolution of Metamodels and Model Transformations"
           year="2020"
           school="Institute of Software Engineering">
    <authors author="Oscar Coevolution"/>
  </entries>

</BibTeX:BibTeXFile>