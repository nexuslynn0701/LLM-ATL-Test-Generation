<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-vision-2015"
           title="A Comprehensive Survey on Computer Vision"
           year="2015"
           journal="International Journal of Vision Research">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carla Nguyen"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr-ml-2018"
           title="Recent Advances in Machine Learning"
           year="2018">
    <authors author="David Martínez"/>
  </entries>

  <!-- Unpublished entry (no year, but has title and note) -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-deep-arch"
           title="Deep Architectures for Sequential Data"
           note="Draft manuscript, not yet submitted.">
    <authors author="Eve Laurent"/>
    <authors author="Frank Zhou"/>
  </entries>

  <!-- Manual (only title required) -->
  <entries xsi:type="BibTeX:Manual"
           id="man-tool-3.2"
           title="User Guide for the MetaModeler 3.2 Toolset"/>

  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-mde-2020"
           title="Proceedings of the 12th International Conference on Model-Driven Engineering"
           year="2020"/>

  <!-- InProceedings: inherits year/title from Proceedings, plus authors and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-mde-testing"
           title="Testing Model Transformations: A Systematic Approach"
           year="2020"
           booktitle="Proceedings of the 12th International Conference on Model-Driven Engineering">
    <authors author="Grace Kim"/>
    <authors author="Henry O'Connor"/>
  </entries>

  <!-- Booklet: only year required -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-domain-2012"
           year="2012"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book-mde-foundations"
           title="Foundations of Model-Driven Engineering"
           year="2013"
           publisher="TechPress Publishing">
    <authors author="Irene Becker"/>
    <authors author="John Peters"/>
  </entries>

  <!-- InCollection: chapter in an edited book, uses booktitle from BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incoll-metamodel-evolution"
           title="Metamodel Evolution and Co-evolution"
           year="2013"
           publisher="TechPress Publishing"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Karen Li"/>
  </entries>

  <!-- InBook: specific chapter in a book -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-chap5-validation"
           title="Validation Techniques for Models"
           year="2013"
           publisher="TechPress Publishing"
           chapter="5">
    <authors author="John Peters"/>
  </entries>

  <!-- Misc: only id required, no other attributes -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-untyped-reference"/>

  <!-- PhD Thesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd-model-testing-2017"
           title="Model Transformation Testing: Theory and Practice"
           year="2017"
           school="University of Software Engineering">
    <authors author="Laura Rossi"/>
  </entries>

  <!-- Master Thesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master-metamodel-2019"
           title="Managing Metamodel Variants in Large-Scale Systems"
           year="2019"
           school="Institute of Information Technology">
    <authors author="Michael Brown"/>
  </entries>

</BibTeX:BibTeXFile>