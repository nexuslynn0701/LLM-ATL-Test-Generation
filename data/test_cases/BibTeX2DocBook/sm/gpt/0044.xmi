<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-key-001"
           title="Model-Driven Engineering: A Comprehensive Survey"
           year="2018"
           journal="Journal of Software Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr-key-002"
           title="Scalable Model Transformation Testing"
           year="2020">
    <authors author="Carlos Mendes"/>
  </entries>

  <!-- Unpublished with note and three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-key-003"
           title="Towards Automated Co-evolution of Metamodels"
           note="Draft version under internal review">
    <authors author="Diana Torres"/>
    <authors author="Eva Müller"/>
    <authors author="Frank O&amp;apos;Brien"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="man-key-004"
           title="ATL Transformation Developer Guide v3.1"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-key-005"
           title="Proceedings of the International Conference on Model Transformations"
           year="2019"/>

  <!-- InProceedings with inherited title/year from Proceedings and own booktitle, plus authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-key-006"
           title="Coverage Criteria for Model Transformation Testing"
           year="2019"
           booktitle="ICMT 2019">
    <authors author="George Lee"/>
    <authors author="Hannah Kim"/>
  </entries>

  <!-- Booklet (dated only) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-key-007"
           year="2015"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book-key-008"
           title="Foundations of Model-Driven Architecture"
           year="2014"
           publisher="Springer">
    <authors author="Ian Brown"/>
    <authors author="Julia Rossi"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry (inherits title/year/publisher + has booktitle) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol-key-009"
           title="Chapter on Graph Transformations in MDE"
           year="2014"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Architecture">
    <authors author="Ian Brown"/>
    <authors author="Martin Keller"/>
  </entries>

  <!-- InBook extending Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-key-010"
           title="Advanced Topics in Model Transformation Testing"
           year="2021"
           publisher="TechPress"
           chapter="7">
    <authors author="Nina Patel"/>
  </entries>

  <!-- Misc entry (minimal, only id) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-key-011"/>

  <!-- PhDThesis with school -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd-key-012"
           title="Automated Test Generation for Model Transformations"
           year="2017"
           school="University of Metropolis">
    <authors author="Oliver Zhang"/>
  </entries>

  <!-- MasterThesis with different school -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc-key-013"
           title="Incremental Testing Techniques for ATL Transformations"
           year="2016"
           school="Institute of Software Technology">
    <authors author="Paula Rivera"/>
  </entries>

</BibTeX:BibTeXFile>