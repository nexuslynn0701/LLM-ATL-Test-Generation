<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art:empirical-mde-2020"
           title="An Empirical Study on Model-Driven Engineering in Practice"
           year="2020"
           journal="Journal of Software Engineering Research and Development">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr:model-transformation-testing-2018"
           title="On the Systematic Testing of Model Transformations"
           year="2018">
    <authors author="Carol White"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub:atl-optimizations-draft"
           title="Optimization Techniques for ATL Transformations"
           note="Draft version under review">
    <authors author="David Brown"/>
    <authors author="Emily Green"/>
  </entries>

  <!-- Manual without authors (allowed, Manual is only TitledEntry) -->
  <entries xsi:type="BibTeX:Manual"
           id="man:atl-user-guide"
           title="ATL User Guide 4.0"/>
           
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc:models-2022"
           title="Proceedings of the 25th International Conference on Model Driven Engineering Languages and Systems"
           year="2022"/>

  <!-- InProceedings (inherits date & title from Proceedings, adds booktitle, has authors) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc:traceability-atl-2022"
           title="Traceability Techniques for ATL Transformations"
           year="2022"
           booktitle="Proceedings of the 25th International Conference on Model Driven Engineering Languages and Systems">
    <authors author="Frank Martin"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet:mde-tutorial-2019"
           year="2019"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book:model-driven-software-architecture-2017"
           title="Model-Driven Software Architecture"
           year="2017"
           publisher="TechBooks Publishing">
    <authors author="Helen Clark"/>
    <authors author="Ian Thompson"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol:mde-chapter-5"
           title="Testing and Validation in Model-Driven Engineering"
           year="2017"
           publisher="TechBooks Publishing"
           booktitle="Model-Driven Software Architecture">
    <authors author="Helen Clark"/>
    <authors author="Jack Robinson"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook:atl-chapter-7"
           title="ATL in Large-Scale Industrial Projects"
           year="2017"
           publisher="TechBooks Publishing"
           chapter="7">
    <authors author="Ian Thompson"/>
  </entries>

  <!-- Misc (no additional mandatory attributes) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc:anonymous-survey-2021"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd:mde-evolution-2016"
           title="Evolution and Co-evolution in Model-Driven Engineering"
           year="2016"
           school="University of Software Technology">
    <authors author="Karen Young"/>
  </entries>

  <!-- MasterThesis with two authors (unusual but structurally allowed) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="ms:atl-refactoring-2019"
           title="Refactoring Techniques for ATL Transformations"
           year="2019"
           school="Institute of Computer Science">
    <authors author="Laura Perez"/>
    <authors author="Michael Scott"/>
  </entries>

</BibTeX:BibTeXFile>