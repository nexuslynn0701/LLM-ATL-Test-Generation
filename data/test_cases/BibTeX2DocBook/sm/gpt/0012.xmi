<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_complex_systems_2020"
           title="Complex Systems in Software Engineering"
           year="2020"
           journal="Journal of Software Systems">
    <authors author="Alice Example"/>
    <authors author="Bob Researcher"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_model_validation_2019"
           title="Model Validation Techniques for MDE"
           year="2019">
    <authors author="Carlos Validator"/>
  </entries>

  <!-- Unpublished entry with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_mde_survey_draft"
           title="A Draft Survey on Model Transformations"
           note="Draft version, not for citation">
    <authors author="Dana DraftAuthor"/>
    <authors author="Evan Collaborator"/>
  </entries>

  <!-- Manual without authors (allowed, since Manual only extends TitledEntry) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_guide_3_1"
           title="User Guide for the Transformation Tool 3.1"/>
  
  <!-- Proceedings (Dated + Titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_conf_2021"
           title="Proceedings of the International Conference on Model-Driven Engineering 2021"
           year="2021"/>

  <!-- InProceedings: authored, dated (via Proceedings), with booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_testing_atl_rules"
           title="Testing ATL Transformations with Systematic Models"
           year="2021"
           booktitle="Proceedings of the International Conference on Model-Driven Engineering 2021">
    <authors author="Frank Tester"/>
    <authors author="Grace Analyst"/>
  </entries>

  <!-- Booklet (only DatedEntry) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_tutorial_series"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_practices"
           title="Practical Model-Driven Engineering"
           year="2017"
           publisher="Academic Publishing House">
    <authors author="Helen Architect"/>
    <authors author="Ian Designer"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_metamodels"
           title="Introduction to Metamodeling"
           year="2017"
           publisher="Academic Publishing House"
           booktitle="Practical Model-Driven Engineering">
    <authors author="Helen Architect"/>
  </entries>

  <!-- InBook: Book + specific chapter (EInt) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_transformation_testing"
           title="Model Transformation Testing Strategies"
           year="2017"
           publisher="Academic Publishing House"
           chapter="5">
    <authors author="Ian Designer"/>
    <authors author="Julia Quality"/>
  </entries>

  <!-- Misc entry (no additional required attributes) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_online_resource_mde"/>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_scalable_mde"
           title="Scalable Techniques for Model-Driven Engineering"
           year="2016"
           school="University of Advanced Studies">
    <authors author="Kevin Doctoral"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_atl_case_studies"
           title="Case Studies in ATL Model Transformations"
           year="2015"
           school="Institute of Software Technology">
    <authors author="Laura Graduate"/>
  </entries>

</BibTeX:BibTeXFile>