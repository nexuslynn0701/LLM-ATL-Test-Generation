<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2022deep"
           title="Deep Learning for Model Transformations"
           year="2022"
           journal="Journal of Model-Driven Engineering">
    <authors author="John Smith"/>
    <authors author="Emily Zhang"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="doe2020mde"
           title="Industrial Applications of Model-Driven Engineering"
           year="2020">
    <authors author="Alice Doe"/>
  </entries>

  <!-- Unpublished entry with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="miller2019draft"
           title="Preliminary Results on ATL Optimization"
           note="To appear; internal technical draft.">
    <authors author="Robert Miller"/>
    <authors author="Sara Klein"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="atltool2023"
           title="ATL Transformation Toolkit User Guide v3.1"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmt2021proc"
           title="Proceedings of the 14th International Conference on Model Transformation"
           year="2021"/>

  <!-- InProceedings, inherits title/year from Proceedings, plus booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="garcia2021testing"
           title="Systematic Testing of Model Transformations"
           year="2021"
           booktitle="Proceedings of the 14th International Conference on Model Transformation">
    <authors author="Lucia Garcia"/>
    <authors author="Thomas Brown"/>
  </entries>

  <!-- Booklet (only year, no title) -->
  <entries xsi:type="BibTeX:Booklet"
           id="flyer2024"
           year="2024"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="white2018mdd"
           title="Foundations of Model-Driven Development"
           year="2018"
           publisher="Springer">
    <authors author="Michael White"/>
    <authors author="Nina Petrova"/>
  </entries>

  <!-- InCollection: a chapter in an edited book, has booktitle via BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="lee2019chapter"
           title="Testing Techniques for ATL Transformations"
           year="2019"
           publisher="Morgan &amp; Claypool"
           booktitle="Advances in Model Transformation Research">
    <authors author="Daniel Lee"/>
    <authors author="Olivia Rossi"/>
  </entries>

  <!-- InBook: specific chapter in a book -->
  <entries xsi:type="BibTeX:InBook"
           id="kim2020chapter"
           title="Case Studies in Bidirectional Transformations"
           year="2020"
           publisher="Elsevier"
           chapter="7">
    <authors author="Hyejin Kim"/>
  </entries>

  <!-- Misc entry with only id (no other attributes required) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscResource001"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="rodriguez2017phd"
           title="Quality Assurance in Model Transformation Chains"
           year="2017"
           school="University of Seville">
    <authors author="Carlos Rodriguez"/>
  </entries>

  <!-- MasterThesis with multiple authors (unusual, but allowed by metamodel) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="joint2022msc"
           title="Collaborative Approaches to Metamodel Evolution"
           year="2022"
           school="Technical University of Munich">
    <authors author="Julia Novak"/>
    <authors author="Markus Hahn"/>
  </entries>

</BibTeX:BibTeXFile>