<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020complex"
           year="2020"
           title="Complex Systems in Software Engineering"
           journal="Journal of Advanced Software Studies">
    <authors author="John Smith"/>
    <authors author="Alice Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="lee2018report"
           year="2018"
           title="A Comprehensive Report on Model Transformations">
    <authors author="Michael Lee"/>
  </entries>

  <!-- Unpublished with multiple authors and a note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="garcia2025draft"
           title="Draft on Future Directions in MDE"
           note="Preliminary version, not for distribution">
    <authors author="Laura Garcia"/>
    <authors author="Tom Baker"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="toolmanualV3"
           title="User Manual for MetaTool Version 3.0"/>
  
  <!-- Proceedings -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmt2022proc"
           year="2022"
           title="Proceedings of the 15th International Conference on Model Transformations"/>

  <!-- InProceedings inheriting from Proceedings, with authors and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="dupont2022trace"
           year="2022"
           title="Traceability Techniques in Model Transformations"
           booktitle="Proceedings of the 15th International Conference on Model Transformations">
    <authors author="Emma Dupont"/>
    <authors author="Carlos Mendes"/>
  </entries>

  <!-- Booklet -->
  <entries xsi:type="BibTeX:Booklet"
           id="introMDEbooklet"
           year="2017"/>

  <!-- Book with authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="brown2015mdebook"
           year="2015"
           title="Model-Driven Engineering: Principles and Practice"
           publisher="TechPress Publishing">
    <authors author="Sarah Brown"/>
    <authors author="David Wilson"/>
  </entries>

  <!-- InCollection based on Book plus booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="nielsen2019chapter"
           year="2019"
           title="Testing of Model Transformations"
           publisher="Global Science Publishers"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Robert Nielsen"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="kim2016chapter5"
           year="2016"
           title="Case Studies in Model Transformation Testing"
           publisher="Academic Digital Press"
           chapter="5">
    <authors author="Hyejin Kim"/>
    <authors author="Oliver Grant"/>
  </entries>

  <!-- Misc with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="anonymousResource"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="olson2014phd"
           year="2014"
           title="Automated Analysis of Model Transformations"
           school="Institute of Software Technology">
    <authors author="Mark Olson"/>
  </entries>

  <!-- MasterThesis with multiple authors (group work) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="team2021master"
           year="2021"
           title="Empirical Evaluation of Transformation Testing Strategies"
           school="Faculty of Computer Science, City University">
    <authors author="Anna Meyer"/>
    <authors author="Luca Rossi"/>
  </entries>

</BibTeX:BibTeXFile>