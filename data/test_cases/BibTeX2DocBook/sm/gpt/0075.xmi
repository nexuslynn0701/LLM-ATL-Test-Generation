<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth"
           title="Model Transformation Testing: A Systematic Review"
           year="2019"
           journal="Journal of Software Engineering Research">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_single"
           title="Regression Testing Strategies for ATL Transformations"
           year="2020">
    <authors author="Diana King"/>
  </entries>

  <!-- Unpublished with note and several authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft"
           title="Unpublished Insights on Bidirectional MDE"
           note="Draft under internal review">
    <authors author="Eva Müller"/>
    <authors author="Frank O&apos;Reilly"/>
  </entries>

  <!-- Manual (no author, no year, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool"
           title="User Guide for the MetaTrans Toolset"/>
           
  <!-- Proceedings (dated & titled, but no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_conf"
           title="Proceedings of the International Conference on Model Transformations"
           year="2018"/>

  <!-- InProceedings (inherits Proceedings+Dated+Titled+Authored+BookTitled) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study"
           title="Case Studies in Testing Complex Model Transformations"
           year="2018"
           booktitle="Proceedings of the International Conference on Model Transformations">
    <authors author="George Lee"/>
    <authors author="Hannah Patel"/>
  </entries>

  <!-- Booklet (only year) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_intro"
           year="2017"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_intro"
           title="Foundations of Model-Driven Engineering"
           year="2015"
           publisher="Springer">
    <authors author="Ian Thompson"/>
    <authors author="Julia Chen"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter"
           title="Testing Patterns for Model Transformations"
           year="2016"
           publisher="Elsevier"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Kevin Roberts"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_section"
           title="Practical Techniques for ATL Testing"
           year="2021"
           publisher="Morgan &amp; Claypool"
           chapter="7">
    <authors author="Laura Nguyen"/>
    <authors author="Markus Vogel"/>
  </entries>

  <!-- Misc (minimal: only id required) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_web_resource"/>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_thesis_example"
           title="Automated Testing Frameworks for Model Transformations"
           year="2014"
           school="Technical University of Metropolis">
    <authors author="Nina Perez"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_thesis_example"
           title="Coverage Criteria for ATL Model Transformations"
           year="2013"
           school="Institute of Software Systems">
    <authors author="Oscar Ramos"/>
  </entries>

</BibTeX:BibTeXFile>