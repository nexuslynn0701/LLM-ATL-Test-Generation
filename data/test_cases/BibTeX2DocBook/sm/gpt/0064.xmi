<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="art:deep-learning-vision"
           title="Deep Learning for Vision Systems"
           year="2018"
           journal="International Journal of Computer Vision">
    <authors author="Jane Smith"/>
    <authors author="Robert Johnson"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr:model-transformation-testing"
           title="Systematic Testing of Model Transformations"
           year="2019">
    <authors author="Elena Martinez"/>
  </entries>

  <!-- Unpublished with note and three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub:mde-survey"
           title="A Comprehensive Survey on Model-Driven Engineering"
           note="Manuscript under revision">
    <authors author="Thomas Lee"/>
    <authors author="Anna Petrova"/>
    <authors author="Michael Brown"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual:tool-user-guide"
           title="User Guide for the Omega Modeling Tool"/>
           
  <!-- Proceedings with date and title -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc:icmt-2020"
           title="Proceedings of the 13th International Conference on Model Transformation"
           year="2020"/>
           
  <!-- InProceedings inheriting date/title from Proceedings, plus booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc:atl-optimization"
           title="Optimization Techniques for ATL Transformations"
           year="2020"
           booktitle="ICMT 2020: Model Transformation Track">
    <authors author="Carlos Garcia"/>
    <authors author="Nina Hoffmann"/>
  </entries>

  <!-- Booklet with only year -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet:intro-to-mdd"
           year="2015"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book:mde-foundations"
           title="Foundations of Model-Driven Engineering"
           year="2014"
           publisher="Springer">
    <authors author="Lucas Meyer"/>
    <authors author="Patricia Rossi"/>
  </entries>

  <!-- InCollection that is also a BookTitledEntry via inheritance -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection:testing-chapter"
           title="Testing in Model-Driven Engineering"
           year="2014"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering: Advanced Topics">
    <authors author="Patricia Rossi"/>
  </entries>

  <!-- InBook with chapter attribute -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook:atl-chapter"
           title="ATL Transformations in Practice"
           year="2014"
           publisher="Springer"
           chapter="7">
    <authors author="Lucas Meyer"/>
  </entries>

  <!-- Misc entry with only mandatory id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc:project-website"/>
           
  <!-- PhDThesis with one author -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd:graph-transformations"
           title="Graph Transformations for Model Synchronization"
           year="2016"
           school="Technical University of Berlin">
    <authors author="Oliver Klein"/>
  </entries>

  <!-- MasterThesis with two authors -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master:incremental-mt"
           title="Incremental Model Transformation for Large-Scale Systems"
           year="2017"
           school="University of Lisbon">
    <authors author="Sara Costa"/>
    <authors author="Joao Pereira"/>
  </entries>

</BibTeX:BibTeXFile>