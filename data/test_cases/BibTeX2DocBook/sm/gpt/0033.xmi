<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020deep"
           title="Deep Learning in Practice"
           year="2020"
           journal="International Journal of AI Research">
    <authors author="John Smith"/>
    <authors author="Emily Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="lee2018report"
           title="A Comprehensive Study of Model Transformations"
           year="2018">
    <authors author="Michael Lee"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="miller2025draft"
           title="Towards Next-Generation Model-Driven Engineering"
           note="Manuscript submitted for publication">
    <authors author="Alice Miller"/>
    <authors author="Robert King"/>
  </entries>

  <!-- Manual (no authors, no year, just title) -->
  <entries xsi:type="BibTeX:Manual"
           id="tool2023manual"
           title="User Guide for the MetaTransform Tool Suite"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmt2022proc"
           title="Proceedings of the 15th International Conference on Model Transformation"
           year="2022"/>

  <!-- InProceedings inherits Proceedings+Dated+Authored+BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="garcia2022trace"
           title="Traceability Techniques for Model Transformation Testing"
           year="2022"
           booktitle="Proceedings of the 15th International Conference on Model Transformation">
    <authors author="Luis Garcia"/>
    <authors author="Sophie Martin"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="promo2019brochure"
           year="2019"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="brown2017mdebook"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="TechPress">
    <authors author="Karen Brown"/>
    <authors author="Daniel White"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="white2017chapter"
           title="Testing Model Transformations"
           year="2017"
           publisher="TechPress"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Daniel White"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="brown2017inbook"
           title="Model Transformation Languages"
           year="2017"
           publisher="TechPress"
           chapter="5">
    <authors author="Karen Brown"/>
  </entries>

  <!-- Misc with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscUniqueRef"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="nguyen2021phd"
           title="Automated Testing of Model Transformations"
           year="2021"
           school="University of Metropolis">
    <authors author="Trang Nguyen"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="clark2019msc"
           title="A Framework for Evaluating Model Transformation Quality"
           year="2019"
           school="Tech University">
    <authors author="James Clark"/>
  </entries>

</BibTeX:BibTeXFile>