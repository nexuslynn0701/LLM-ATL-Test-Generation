<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2022-mde-survey"
           title="A Comprehensive Survey on Model-Driven Engineering"
           year="2022"
           journal="Journal of Software Engineering">
    <authors author="John Smith"/>
    <authors author="Alice Johnson"/>
    <authors author="Wei Liu"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="garcia2020-report"
           title="Industrial Adoption of ATL Transformations"
           year="2020">
    <authors author="Maria Garcia"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="nguyen2025-draft"
           title="Testing Strategies for Model Transformations"
           note="Draft version, under submission">
    <authors author="Linh Nguyen"/>
    <authors author="Peter Clark"/>
  </entries>

  <!-- Manual (only titled) -->
  <entries xsi:type="BibTeX:Manual"
           id="atl-manual-1.0"
           title="ATL Language Reference Manual 1.0"/>
           
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="models2023-proc"
           title="Proceedings of the 2023 ACM/IEEE International Conference on Model Driven Engineering Languages and Systems"
           year="2023"/>

  <!-- InProceedings (inherits Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="brown2023-tracing"
           title="Traceability Techniques in Model Transformations"
           year="2023"
           booktitle="MODELS 2023: Proceedings of the ACM/IEEE 26th International Conference on Model Driven Engineering Languages and Systems">
    <authors author="Kevin Brown"/>
    <authors author="Sara Lee"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="intro-mde-booklet"
           year="2019"/>

  <!-- Book (authored, dated, titled, with publisher) -->
  <entries xsi:type="BibTeX:Book"
           id="osterweil2018-book"
           title="Foundations of Software Modeling"
           year="2018"
           publisher="Springer">
    <authors author="H. Osterweil"/>
    <authors author="Clara Mendes"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="lopez2019-chapter"
           title="Reusable Model Transformation Patterns"
           year="2019"
           publisher="Elsevier"
           booktitle="Patterns and Practices in Model-Driven Engineering">
    <authors author="Carlos Lopez"/>
    <authors author="Emily Davis"/>
  </entries>

  <!-- InBook (Book + extra chapter attribute) -->
  <entries xsi:type="BibTeX:InBook"
           id="martin2021-chapter5"
           title="Verification of ATL Transformations"
           year="2021"
           publisher="CRC Press"
           chapter="5">
    <authors author="George Martin"/>
  </entries>

  <!-- Misc (minimal BibTeXEntry) -->
  <entries xsi:type="BibTeX:Misc"
           id="random-resource-001"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="schneider2022-phd"
           title="Scalable Techniques for Testing Model Transformations"
           year="2022"
           school="Technical University of Munich">
    <authors author="Laura Schneider"/>
  </entries>

  <!-- MasterThesis with multiple authors (unusual but allowed structurally) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="coauthored-master-2020"
           title="Empirical Evaluation of Model Transformation Tools"
           year="2020"
           school="University of Oslo">
    <authors author="Thomas Eriksen"/>
    <authors author="Ingrid Nilsen"/>
  </entries>

</BibTeX:BibTeXFile>