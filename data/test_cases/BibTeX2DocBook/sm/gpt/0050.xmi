<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-neural-graphs-2021"
           title="Neural Graph Transformations for Heterogeneous Models"
           year="2021"
           journal="Journal of Model Engineering">
    <authors author="Alice Johnson"/>
    <authors author="Bob Smith"/>
    <authors author="Carlos Martinez"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr-mde-benchmarks-2019"
           title="Benchmarks for Large-Scale Model Transformations"
           year="2019">
    <authors author="Diana Peters"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-dsl-quality-2022"
           title="Quality Assessment for Domain-Specific Languages"
           note="Under revision for SoSyM">
    <authors author="Erik Johansson"/>
    <authors author="Fiona Lee"/>
  </entries>

  <!-- Manual (no author, no date, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual-atl-tooling"
           title="ATL Transformation Toolkit User Guide"/>
           
  <!-- Proceedings (dated & titled, but no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-models-2020"
           title="Proceedings of the 23rd International Conference on Model-Driven Engineering"
           year="2020"/>

  <!-- InProceedings with its own booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-coverage-testing-2020"
           title="Coverage Criteria for Testing Model Transformations"
           year="2020"
           booktitle="Proceedings of the 23rd International Conference on Model-Driven Engineering">
    <authors author="George Brown"/>
    <authors author="Hannah Kim"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-mde-intro-2018"
           year="2018"/>

  <!-- Book with authors, date, title, publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book-mde-patterns-2017"
           title="Patterns in Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Ian Thomas"/>
    <authors author="Julia Roberts"/>
  </entries>

  <!-- InCollection (extends Book & BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection-refactoring-2017"
           title="Refactoring Techniques for ATL Transformations"
           year="2017"
           publisher="Springer"
           booktitle="Patterns in Model-Driven Engineering">
    <authors author="Ian Thomas"/>
    <authors author="Karen White"/>
  </entries>

  <!-- InBook (extends Book with chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-verification-2016"
           title="Verification of Model Transformations"
           year="2016"
           publisher="Morgan Kaufmann"
           chapter="5">
    <authors author="Liam O&apos;Connor"/>
  </entries>

  <!-- Misc (only an id, no other fields) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-transformation-tool-list"/>

  <!-- PhDThesis (ThesisEntry) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd-model-evolution-2015"
           title="Model Evolution in Large-Scale Industrial Ecosystems"
           year="2015"
           school="Technical University of Metropolis">
    <authors author="Maria Gonzalez"/>
  </entries>

  <!-- MasterThesis (ThesisEntry) with multiple authors (group work) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc-mt-testing-2022"
           title="Automated Testing Strategies for ATL Transformations"
           year="2022"
           school="Institute of Software Technology">
    <authors author="Nina Schmidt"/>
    <authors author="Oliver King"/>
  </entries>

</BibTeX:BibTeXFile>