<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020hyper"
           title="Hyper-Scalable Model Transformations"
           year="2020"
           journal="Journal of Model Engineering">
    <authors author="John Smith"/>
    <authors author="Alice Johnson"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="lee2019report"
           title="Evaluation of ATL Transformations in Industry"
           year="2019">
    <authors author="Michael Lee"/>
  </entries>

  <!-- Unpublished with two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="garcia2022draft"
           title="Draft: Incremental Verification of Model Transformations"
           note="Manuscript in preparation">
    <authors author="Maria Garcia"/>
    <authors author="Thomas Brown"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="atltool2021manual"
           title="ATL Tooling Reference Manual 3.1"/>
  
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmte2021proc"
           title="Proceedings of the International Conference on Model Transformation Engineering"
           year="2021"/>

  <!-- InProceedings: inherits Proceedings + AuthoredEntry + BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="kovacs2021session"
           title="Testing Strategies for Heterogeneous Model Transformations"
           year="2021"
           booktitle="Proceedings of the International Conference on Model Transformation Engineering">
    <authors author="Daniel Kovacs"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="promo2018booklet"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="green2017book"
           title="Foundations of Model-Driven Testing"
           year="2017"
           publisher="Springer">
    <authors author="Emma Green"/>
    <authors author="Oliver White"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="yang2018chapter"
           title="Coverage Criteria for ATL Transformations"
           year="2018"
           publisher="Elsevier"
           booktitle="Advances in Model Transformation Research">
    <authors author="Liang Yang"/>
  </entries>

  <!-- InBook: Book + chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="patel2016chapter5"
           title="Practical Approaches to Model Transformation Testing"
           year="2016"
           publisher="Morgan Kaufmann"
           chapter="5">
    <authors author="Sanjay Patel"/>
  </entries>

  <!-- Misc entry with only required id -->
  <entries xsi:type="BibTeX:Misc"
           id="toolMiscRef"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="roberts2015phd"
           title="Automated Analysis of Model Transformations"
           year="2015"
           school="University of Metropolis">
    <authors author="Laura Roberts"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="nguyen2019master"
           title="Test Data Generation for ATL Transformations"
           year="2019"
           school="Tech University of Gotham">
    <authors author="Huy Nguyen"/>
  </entries>

</BibTeX:BibTeXFile>