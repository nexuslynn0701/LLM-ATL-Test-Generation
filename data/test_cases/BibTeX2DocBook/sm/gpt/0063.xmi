<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-ml-robustness"
           title="Robustness Guarantees for Machine Learning Systems"
           year="2019"
           journal="Journal of Reliable AI">
    <authors author="Dana Smith"/>
    <authors author="Alex Turner"/>
    <authors author="Priya Nair"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr-formal-verification"
           title="Formal Verification of Model Transformations"
           year="2018">
    <authors author="Carla Mendes"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-mde-tutorial"
           title="A Gentle Introduction to Model-Driven Engineering"
           note="Draft prepared for internal review, not yet submitted.">
    <authors author="Lars König"/>
    <authors author="Maria Rossi"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual-modeling-tool"
           title="User Guide for the Metamodeling Workbench v3.2"/>
  
  <!-- Proceedings with title and year (no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-emf-symposium-2020"
           title="Proceedings of the EMF Symposium 2020"
           year="2020"/>

  <!-- InProceedings: inherits authors, booktitle, title, year from supertypes -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-test-automation"
           title="Automated Testing of Model Transformations"
           year="2020"
           booktitle="Proceedings of the EMF Symposium 2020">
    <authors author="Nicolas Dupont"/>
    <authors author="Elena Garcia"/>
  </entries>

  <!-- Booklet (only year required) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-domain-specific"
           year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book-mde-principles"
           title="Principles and Practice of Model-Driven Engineering"
           year="2016"
           publisher="TechPress International">
    <authors author="Oliver Brown"/>
    <authors author="Cheng Li"/>
  </entries>

  <!-- InCollection: chapter in an edited book with booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection-tggs"
           title="Triple Graph Grammars for Bidirectional Transformations"
           year="2016"
           publisher="TechPress International"
           booktitle="Advances in Model Transformation">
    <authors author="Cheng Li"/>
    <authors author="Hanna Müller"/>
  </entries>

  <!-- InBook: chapter with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-case-study"
           title="Industrial Case Studies in Model-Driven Engineering"
           year="2016"
           publisher="TechPress International"
           chapter="5">
    <authors author="Oliver Brown"/>
  </entries>

  <!-- Misc with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-website-repo"/>
  
  <!-- PhDThesis with full info -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd-model-transformation-testing"
           title="Systematic Testing Strategies for Model Transformations"
           year="2015"
           school="University of Metropolis">
    <authors author="Isabella Novak"/>
  </entries>

  <!-- MasterThesis with two authors is allowed? No, AuthoredEntry requires authors, but multiplicity is 1..* so multiple ok -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc-bidirectional-sync"
           title="Bidirectional Synchronization of Engineering Models"
           year="2014"
           school="Institute of Software Technology">
    <authors author="Tom Álvarez"/>
    <authors author="Sophie Martin"/>
  </entries>

</BibTeX:BibTeXFile>