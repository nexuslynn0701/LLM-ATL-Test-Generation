<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
      id="art:graph-matching-2020"
      title="Advanced Graph Matching Techniques"
      year="2020"
      journal="Journal of Graph Algorithms and Applications">
    <authors author="Alice Johnson"/>
    <authors author="Bob Smith"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
      id="tr:model-transform-2019"
      title="Survey on Model Transformation Testing"
      year="2019">
    <authors author="Carlos Mendes"/>
  </entries>

  <!-- Unpublished with two authors -->
  <entries xsi:type="BibTeX:Unpublished"
      id="unpub:mde-guidelines"
      title="Guidelines for Industrial Model-Driven Engineering"
      note="Draft internal report, under review.">
    <authors author="Diana Lee"/>
    <authors author="Evan Brown"/>
  </entries>

  <!-- Manual (no authors, no year, only title) -->
  <entries xsi:type="BibTeX:Manual"
      id="manual:atl-tooling"
      title="ATL Transformation Developer Guide"/>

  <!-- Proceedings (dated + titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
      id="proc:models-2021"
      title="Proceedings of the 24th International Conference on Model Driven Engineering Languages and Systems"
      year="2021"/>

  <!-- InProceedings (inherits Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
      id="inproc:test-generation-2021"
      title="Automated Test Generation for Model Transformations"
      year="2021"
      booktitle="Proceedings of the 24th International Conference on Model Driven Engineering Languages and Systems">
    <authors author="Frank O&apos;Connor"/>
    <authors author="Grace Müller"/>
  </entries>

  <!-- Booklet (only year) -->
  <entries xsi:type="BibTeX:Booklet"
      id="booklet:short-intro-mde"
      year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
      id="book:mde-fundamentals-2017"
      title="Fundamentals of Model-Driven Engineering"
      year="2017"
      publisher="TechPress Publishing">
    <authors author="Hannah White"/>
    <authors author="Ian Black"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
      id="incollection:case-studies-mde"
      title="Industrial Case Studies in Model-Driven Engineering"
      year="2017"
      publisher="TechPress Publishing"
      booktitle="Fundamentals of Model-Driven Engineering">
    <authors author="Julia Rossi"/>
  </entries>

  <!-- InBook (Book + extra chapter attribute) -->
  <entries xsi:type="BibTeX:InBook"
      id="inbook:testing-chapter"
      title="Testing and Validation of Model Transformations"
      year="2017"
      publisher="TechPress Publishing"
      chapter="7">
    <authors author="Kevin Zhang"/>
    <authors author="Laura Fernández"/>
  </entries>

  <!-- Misc minimal entry (only required id) -->
  <entries xsi:type="BibTeX:Misc"
      id="misc:web-resource-uml2"/>

  <!-- PhDThesis (ThesisEntry specialization) -->
  <entries xsi:type="BibTeX:PhDThesis"
      id="phd:mdd-verification-2016"
      title="Verification Techniques for Model-Driven Development"
      year="2016"
      school="University of Metropolis">
    <authors author="Michael Green"/>
  </entries>

  <!-- MasterThesis (ThesisEntry specialization) with multiple authors (unusual, but allowed by metamodel) -->
  <entries xsi:type="BibTeX:MasterThesis"
      id="msc:model-evolution-2020"
      title="Managing Evolution in Model-Driven Engineering Projects"
      year="2020"
      school="Tech University of Central City">
    <authors author="Nina Petrova"/>
    <authors author="Oliver King"/>
  </entries>

</BibTeX:BibTeXFile>