<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_authors"
           title="Comprehensive Survey on Model-Driven Engineering"
           year="2019"
           journal="Journal of Software Engineering Research">
    <authors author="Alice Example"/>
    <authors author="Bob Sample"/>
    <authors author="Carlos Testerson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_single_author"
           title="Industrial Experiences with ATL Transformations"
           year="2018">
    <authors author="Diana Engineer"/>
  </entries>

  <!-- Unpublished with note and three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft_paper"
           title="Draft Guidelines for Testing Model Transformations"
           note="Work in progress manuscript, not submitted">
    <authors author="Eve Researcher"/>
    <authors author="Frank Analyst"/>
    <authors author="Grace Developer"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool_guide"
           title="ATL Transformation Debugger User Manual"/>
           
  <!-- Proceedings (dated and titled, but no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_symposium"
           title="Proceedings of the 10th Symposium on Model Engineering"
           year="2021"/>

  <!-- InProceedings extends Proceedings, AuthoredEntry, and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_case_study"
           title="Case Studies in Bidirectional Transformations"
           year="2021"
           booktitle="Proceedings of the 10th Symposium on Model Engineering">
    <authors author="Hector Case"/>
    <authors author="Irene Example"/>
  </entries>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns"
           title="Patterns and Best Practices in Model-Driven Engineering"
           year="2016"
           publisher="TechPress Publishing">
    <authors author="John Architect"/>
    <authors author="Karen Designer"/>
  </entries>

  <!-- InCollection in a Book, with BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_testing_chapter"
           title="Testing of Model Transformations"
           year="2016"
           publisher="TechPress Publishing"
           booktitle="Patterns and Best Practices in Model-Driven Engineering">
    <authors author="Laura Tester"/>
    <authors author="Michael Quality"/>
  </entries>

  <!-- InBook, chapter attribute -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_chapter_formal"
           title="Formal Verification of Transformations"
           year="2016"
           publisher="TechPress Publishing"
           chapter="7">
    <authors author="Nathan Formal"/>
  </entries>

  <!-- Booklet, only year required -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_short_intro"
           year="2015"/>

  <!-- Misc, only id required -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_web_resource"/>

  <!-- PhDThesis with multiple authors (unusual but structurally allowed) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_dissertation_mde"
           title="Advanced Techniques for Model Transformation Testing"
           year="2020"
           school="University of Model Engineering">
    <authors author="Olivia Doctoral"/>
    <authors author="Paul Advisor"/>
  </entries>

  <!-- MasterThesis with single author -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_dissertation_tools"
           title="Tool Support for Automated ATL Test Generation"
           year="2017"
           school="Institute of Software Technology">
    <authors author="Quentin Student"/>
  </entries>

</BibTeX:BibTeXFile>