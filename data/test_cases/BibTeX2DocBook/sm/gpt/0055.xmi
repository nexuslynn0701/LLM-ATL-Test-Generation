<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth_2021"
           title="Model-Driven Testing of Transformation Chains"
           year="2021"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrep_mde_tools_2019"
           title="A Survey of MDE Tool Qualification"
           year="2019">
    <authors author="Diana King"/>
  </entries>

  <!-- Unpublished with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_mt_validation_2020"
           title="On the Validation of Model Transformations"
           note="Draft manuscript, not yet submitted.">
    <authors author="Erik Zhang"/>
    <authors author="Fatima Noor"/>
  </entries>

  <!-- Manual (only title required) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_atl_reference_2018"
           title="ATL Transformation Language Reference Guide"/>
           
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_conf_2022"
           title="Proceedings of the International Conference on Model Engineering"
           year="2022"/>

  <!-- InProceedings: authored, dated via Proceedings, and with booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_test_generation_2022"
           title="Automated Test Generation for ATL Transformations"
           year="2022"
           booktitle="Proceedings of the International Conference on Model Engineering">
    <authors author="Grace Lee"/>
    <authors author="Henry O&amp;apos;Connor"/>
  </entries>

  <!-- Booklet (only year required) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_intro_2017"
           year="2017"/>

  <!-- Book with authors, year, title, publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_fundamentals_2015"
           title="Fundamentals of Model-Driven Engineering"
           year="2015"
           publisher="Springer">
    <authors author="Isabel Romero"/>
    <authors author="John K. Miller"/>
  </entries>

  <!-- InCollection: extends Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_mt_verification_2016"
           title="Verification of Model Transformations"
           year="2016"
           publisher="Academic Press"
           booktitle="Advanced Topics in Model-Driven Engineering">
    <authors author="Karen Peters"/>
  </entries>

  <!-- InBook: extends Book and adds chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_case_studies_2014"
           title="Case Studies in Industrial MDE"
           year="2014"
           publisher="TechBooks"
           chapter="7">
    <authors author="Luca Rossi"/>
    <authors author="Maria Fernandez"/>
  </entries>

  <!-- Misc: only id required -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_tool_website_2023"/>

  <!-- PhDThesis: ThesisEntry subtype -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_model_transformation_testing_2013"
           title="Testing Strategies for Model Transformations"
           year="2013"
           school="University of Technology">
    <authors author="Nathan Clark"/>
  </entries>

  <!-- MasterThesis: ThesisEntry subtype -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master_mde_adoption_2012"
           title="Industrial Adoption of Model-Driven Engineering"
           year="2012"
           school="Institute of Software Engineering">
    <authors author="Olivia Wang"/>
  </entries>

</BibTeX:BibTeXFile>