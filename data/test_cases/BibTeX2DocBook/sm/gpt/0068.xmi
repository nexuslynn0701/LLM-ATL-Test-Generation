<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artMultiAuth2023"
           title="A Comprehensive Survey of Model Transformation Testing"
           year="2023"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Martinez"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techReportMDE001"
           title="Industrial Adoption of Model-Driven Engineering"
           year="2022">
    <authors author="Dana White"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraftMDE"
           title="Unreleased Notes on Incremental Transformations"
           note="Draft version, do not cite">
    <authors author="Eve Black"/>
    <authors author="Frank Green"/>
  </entries>

  <!-- Manual (no author, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="toolManualATL"
           title="ATL Transformation Language User Guide"/>
           
  <!-- Proceedings (dated and titled, but no explicit editors in this metamodel) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procICMT2021"
           title="Proceedings of the International Conference on Model Transformation"
           year="2021"/>

  <!-- InProceedings extending Proceedings, AuthoredEntry, and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inProcMutationTesting"
           title="Mutation-Based Testing of Model Transformations"
           year="2021"
           booktitle="Proceedings of the International Conference on Model Transformation">
    <authors author="Grace Lee"/>
    <authors author="Henry Clark"/>
  </entries>

  <!-- Booklet (only year is mandatory) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletFlyerMDE"
           year="2019"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="bookFoundationsMDE"
           title="Foundations of Model-Driven Engineering"
           year="2018"
           publisher="Springer">
    <authors author="Isabella Rossi"/>
    <authors author="John Doe"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="inCollectionChapterTesting"
           title="Testing Techniques for Model Transformations"
           year="2018"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering: Advanced Topics">
    <authors author="Karen Brown"/>
  </entries>

  <!-- InBook with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookChap7Validation"
           title="Validation of Transformations in Practice"
           year="2020"
           publisher="Elsevier"
           chapter="7">
    <authors author="Liam Nguyen"/>
    <authors author="Maria Garcia"/>
  </entries>

  <!-- Misc entry (minimal, only id) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscOnlineResource01"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisTraceability"
           title="Traceability Techniques for Model Transformations"
           year="2017"
           school="Technical University of Metropolis">
    <authors author="Nathan Owens"/>
  </entries>

  <!-- MasterThesis with multiple authors (unusual in reality but allowed by metamodel) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisTesting"
           title="Empirical Evaluation of Model Transformation Testing Strategies"
           year="2019"
           school="Institute of Software Engineering">
    <authors author="Olivia Perez"/>
    <authors author="Peter Quinn"/>
  </entries>

</BibTeX:BibTeXFile>