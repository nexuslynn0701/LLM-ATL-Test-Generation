           id="unp0095"
           title="Preliminary Results on Incremental ATL Testing"
           note="To appear, under revision">
    <authors author="Alice Smith"/>
  </entries>

  <!-- Manual without authors (allowed, only TitledEntry) -->
  <entries xsi:type="BibTeX:Manual"
           id="man0095"
           title="ATL Transformation Developer Guide v3.0"/>
           
  <!-- Proceedings (Dated + Titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc0095"
           title="Proceedings of the 15th International Conference on Model Transformations"
           year="2022"/>

  <!-- InProceedings (Proceedings + AuthoredEntry + BookTitledEntry) -->
