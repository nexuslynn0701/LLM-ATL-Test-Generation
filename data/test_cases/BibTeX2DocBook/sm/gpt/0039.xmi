<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplex2020"
           title="A Comprehensive Study of Model-Driven Testing"
           year="2020"
           journal="Journal of Software Engineering Research">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="trTooling2018"
           title="Tool Support for Large-Scale Model Transformations"
           year="2018">
    <authors author="Dana White"/>
  </entries>

  <!-- Unpublished with note and three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraft2021"
           title="Draft Specification of a Bidirectional Transformation Language"
           note="Work in progress, internal circulation only">
    <authors author="Eva Green"/>
    <authors author="Frank Miller"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Manual (no author, no year, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualMDETool"
           title="Model Transformation Framework User Guide"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procMDEConf2019"
           title="Proceedings of the 2019 Conference on Model-Driven Engineering"
           year="2019"/>

  <!-- InProceedings referencing booktitle and proceedings-specific data via inheritance -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocCaseStudy2019"
           title="Industrial Case Study on Automated Model Refactoring"
           year="2019"
           booktitle="Proceedings of the 2019 Conference on Model-Driven Engineering">
    <authors author="Henry King"/>
    <authors author="Isabelle Laurent"/>
  </entries>

  <!-- Booklet (only year required) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletTutorial2022"
           year="2022"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDEIntro2017"
           title="Introduction to Model-Driven Engineering"
           year="2017"
           publisher="TechPress Publishing">
    <authors author="John Martin"/>
    <authors author="Kate Brown"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry (chapter in edited book-like collection) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollectionChapter4"
           title="Testing Techniques for Model Transformations"
           year="2017"
           publisher="TechPress Publishing"
           booktitle="Introduction to Model-Driven Engineering">
    <authors author="Laura Chen"/>
    <authors author="Michael Scott"/>
  </entries>

  <!-- InBook: Book + chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookMetrics"
           title="Metrics for Model Transformation Quality"
           year="2017"
           publisher="TechPress Publishing"
           chapter="5">
    <authors author="Nina Roberts"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry with just id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscWebResource01"/>

  <!-- PhDThesis with all required features from ThesisEntry -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisMDE"
           title="Advanced Techniques in Model-Driven Engineering"
           year="2016"
           school="University of Innovation">
    <authors author="Oliver Perez"/>
  </entries>

  <!-- MasterThesis with different school and year -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisTesting"
           title="Model Transformation Testing Strategies"
           year="2015"
           school="Institute of Software Technology">
    <authors author="Patricia Young"/>
    <authors author="Quentin Ross"/>
  </entries>

</BibTeX:BibTeXFile>