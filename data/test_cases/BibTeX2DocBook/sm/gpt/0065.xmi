<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art-intro-mde"
           title="An Introduction to Model-Driven Engineering"
           year="2018"
           journal="Journal of Software Engineering Practice">
    <authors author="Alice Modeler"/>
    <authors author="Bob Transformer"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr-mt-testing"
           title="Systematic Testing of Model Transformations"
           year="2019">
    <authors author="Carol Tester"/>
  </entries>

  <!-- Unpublished with note and three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub-dsl-evolution"
           title="On the Evolution of Domain-Specific Languages"
           note="Draft manuscript under review">
    <authors author="David Language"/>
    <authors author="Eve Evolver"/>
    <authors author="Frank Refactor"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="man-atl-reference"
           title="ATL Language Reference Guide"/>
  
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc-models-2020"
           title="Proceedings of the MODELS 2020 Conference"
           year="2020"/>

  <!-- InProceedings using Proceedings, AuthoredEntry, and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc-metamodel-coverage"
           title="Covering Metamodel Variants in Transformation Testing"
           year="2020"
           booktitle="Proceedings of the MODELS 2020 Conference">
    <authors author="Grace Coverage"/>
    <authors author="Henry Variant"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet-mde-tutorial"
           year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book-mde-fundamentals"
           title="Fundamentals of Model-Driven Development"
           year="2016"
           publisher="Springer">
    <authors author="Ian Architect"/>
    <authors author="Jane Designer"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection-rtl"
           title="Rewriting-Based Transformation Languages"
           year="2016"
           publisher="Springer"
           booktitle="Fundamentals of Model-Driven Development">
    <authors author="Karen Rewriter"/>
  </entries>

  <!-- InBook: specialization of Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook-verification"
           title="Verification Techniques for Model Transformations"
           year="2016"
           publisher="Springer"
           chapter="7">
    <authors author="Leo Verifier"/>
    <authors author="Mia Analyzer"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc-internal-note"/>
  
  <!-- PhDThesis using ThesisEntry -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd-transformation-quality"
           title="Quality Assurance for Model Transformations"
           year="2015"
           school="Technical University of Metamodeling">
    <authors author="Nina Doctoral"/>
  </entries>

  <!-- MasterThesis using ThesisEntry -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc-metamodel-evolution"
           title="Handling Metamodel Evolution in Practice"
           year="2021"
           school="Institute of Software Systems">
    <authors author="Oscar Student"/>
  </entries>

</BibTeX:BibTeXFile>