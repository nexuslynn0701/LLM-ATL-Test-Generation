<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article" id="art_smith2020" title="A Comprehensive Survey on Model-Driven Engineering" year="2020" journal="Journal of Software Engineering">
    <authors author="John Smith"/>
    <authors author="Emily Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport" id="tr_brown2021" title="Industrial Experiences with ATL Transformations" year="2021">
    <authors author="Michael Brown"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub_lee2019" title="Preliminary Results on Incremental Model Transformations" note="Draft manuscript under review">
    <authors author="Sophia Lee"/>
    <authors author="Daniel Garcia"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual" id="man_toolguide" title="ATL Transformation Language Reference Manual"/>

  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc_mde2022" title="Proceedings of the International Conference on Model-Driven Engineering" year="2022"/>

  <!-- InProceedings inheriting from Proceedings, with booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc_clark2022" title="Optimizing Model Transformations for Large-Scale Systems" year="2022" booktitle="Proceedings of the International Conference on Model-Driven Engineering">
    <authors author="Peter Clark"/>
    <authors author="Laura Martinez"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet_tutorial2023" year="2023"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book" id="book_modeling2018" title="Advanced Model-Driven Architecture" year="2018" publisher="TechPress Publishing">
    <authors author="Alice Walker"/>
    <authors author="Robert King"/>
  </entries>

  <!-- InCollection in a Book with booktitle and authors -->
  <entries xsi:type="BibTeX:InCollection" id="incollection_owen2018" title="Testing Strategies for Model Transformations" year="2018" publisher="TechPress Publishing" booktitle="Advanced Model-Driven Architecture">
    <authors author="Karen Owen"/>
  </entries>

  <!-- InBook with chapter -->
  <entries xsi:type="BibTeX:InBook" id="inbook_chapter5" title="Case Studies in Transformation Testing" year="2018" publisher="TechPress Publishing" chapter="5">
    <authors author="Alice Walker"/>
  </entries>

  <!-- Misc bare entry -->
  <entries xsi:type="BibTeX:Misc" id="misc_dataset_mde"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd_green2020" title="Scalable Techniques for Testing Model Transformations" year="2020" school="University of Metamodeling">
    <authors author="David Green"/>
  </entries>

  <!-- MasterThesis with multiple authors (edge case) -->
  <entries xsi:type="BibTeX:MasterThesis" id="msc_collab2021" title="Collaborative Development of ATL Transformations" year="2021" school="Institute of Software Systems">
    <authors author="Helen Carter"/>
    <authors author="Ian Rogers"/>
  </entries>

</BibTeX:BibTeXFile>