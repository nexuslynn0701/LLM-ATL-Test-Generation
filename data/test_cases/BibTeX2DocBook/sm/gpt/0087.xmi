<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020deep"
           title="Deep Learning for Model Transformations"
           year="2020"
           journal="Journal of Model-Driven Engineering">
    <authors author="John Smith"/>
    <authors author="Anna Müller"/>
    <authors author="Wei Zhang"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="doe2019survey"
           title="A Survey on ATL Transformation Testing"
           year="2019">
    <authors author="Jane Doe"/>
  </entries>

  <!-- Unpublished note with multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="brown2021draft"
           title="Draft Specification of a Bidirectional Transformation Language"
           note="To be submitted to TSE.">
    <authors author="Michael Brown"/>
    <authors author="Laura García"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="atltooling2022"
           title="ATL Tooling Reference Manual v3.2"/>
  
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="icmt2023"
           title="Proceedings of the 16th International Conference on Model Transformation"
           year="2023"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="lee2023coverage"
           title="Coverage Criteria for Model Transformation Test Suites"
           year="2023"
           booktitle="Proceedings of the 16th International Conference on Model Transformation">
    <authors author="Sung Lee"/>
    <authors author="Emily Clark"/>
  </entries>

  <!-- Booklet: only dated -->
  <entries xsi:type="BibTeX:Booklet"
           id="guidelines2018"
           year="2018"/>

  <!-- Book with authors, year, title, publisher -->
  <entries xsi:type="BibTeX:Book"
           id="gamma1995patterns"
           title="Design Patterns: Elements of Reusable Object-Oriented Software"
           year="1995"
           publisher="Addison-Wesley">
    <authors author="Erich Gamma"/>
    <authors author="Richard Helm"/>
    <authors author="Ralph Johnson"/>
    <authors author="John Vlissides"/>
  </entries>

  <!-- InCollection: Book plus BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="martin2010chapter"
           title="Testing Model Transformations"
           year="2010"
           publisher="Springer"
           booktitle="Advanced Topics in Model-Driven Engineering">
    <authors author="Kelly Martin"/>
    <authors author="Tomáš Novák"/>
  </entries>

  <!-- InBook: Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="white2012inbook"
           title="A Practical Guide to MDE Tooling"
           year="2012"
           publisher="Morgan Kaufmann"
           chapter="5">
    <authors author="Peter White"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry, only id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscNote123"/>
  
  <!-- PhDThesis: ThesisEntry subtype -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="nguyen2017phd"
           title="Scalable Testing Techniques for Model Transformations"
           year="2017"
           school="University of Technology">
    <authors author="Lan Nguyen"/>
  </entries>

  <!-- MasterThesis: ThesisEntry subtype with multiple authors (unusual but allowed by metamodel) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="rodriguez2020master"
           title="Incremental Validation of Model Transformations"
           year="2020"
           school="Polytechnic Institute of Barcelona">
    <authors author="Carlos Rodríguez"/>
    <authors author="Sara López"/>
  </entries>

</BibTeX:BibTeXFile>