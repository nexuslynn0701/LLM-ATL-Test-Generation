<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplexLogic"
           title="A Comprehensive Study of Model Transformation Testing"
           year="2021"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Tester"/>
    <authors author="Bob Verifier"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techRepDelta"
           title="Regression Analysis of ATL Transformations"
           year="2019">
    <authors author="Charles Analyzer"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubGamma"
           title="Pending Results on Incremental Model Synchronization"
           note="Draft under internal review">
    <authors author="Diana Reviewer"/>
    <authors author="Edward Collaborator"/>
    <authors author="Fiona Researcher"/>
  </entries>

  <!-- Manual (no authors, just title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualToolUserGuide"
           title="User Guide for the MetaTrans Test Framework"/>
  
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procMDEConf2020"
           title="Proceedings of the 5th Conference on Model Transformation Quality"
           year="2020"/>

  <!-- InProceedings: inherits title and year via Proceedings, plus booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inProcKeynote"
           title="Keynote on Advanced Test Strategies for ATL"
           year="2020"
           booktitle="Proceedings of the 5th Conference on Model Transformation Quality">
    <authors author="Greg Keynoter"/>
  </entries>

  <!-- Booklet: dated only -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletShortIntro"
           year="2018"/>

  <!-- Book with two authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="bookTestingPatterns"
           title="Patterns for Testing Model Transformations"
           year="2017"
           publisher="ModelPress Publishing">
    <authors author="Helen Architect"/>
    <authors author="Ian Designer"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry (chapter in edited volume) -->
  <entries xsi:type="BibTeX:InCollection"
           id="inCollectionChapter"
           title="A Catalog of ATL Testing Anti-Patterns"
           year="2017"
           publisher="ModelPress Publishing"
           booktitle="Patterns for Testing Model Transformations">
    <authors author="Julia Reviewer"/>
    <authors author="Kevin Engineer"/>
  </entries>

  <!-- InBook: chapter in same book, sharing publisher and year, different authors -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookChapter"
           title="Case Studies in Bidirectional Transformation Testing"
           year="2017"
           publisher="ModelPress Publishing"
           chapter="7">
    <authors author="Laura Analyst"/>
  </entries>

  <!-- Misc: minimal BibTeXEntry (only id) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscPlaceholderEntry"/>

  <!-- PhDThesis: ThesisEntry with school -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisMetaTesting"
           title="Automated Testing Frameworks for Model Transformations"
           year="2016"
           school="University of Model Engineering">
    <authors author="Michael Doctoral"/>
  </entries>

  <!-- MasterThesis: ThesisEntry with different school -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisATL"
           title="Evaluation of Test Adequacy Criteria for ATL Transformations"
           year="2015"
           school="Institute of Software Systems">
    <authors author="Nina Graduate"/>
  </entries>

</BibTeX:BibTeXFile>