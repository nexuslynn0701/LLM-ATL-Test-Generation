<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article" id="art_multi_auth" title="Multi-Paradigm Modeling in Practice" year="2018" journal="Software &amp; Systems Modeling">
    <authors author="Alice Example"/>
    <authors author="Bob Sample"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport" id="tr_single_auth" title="A Survey on Model Transformation Testing" year="2020">
    <authors author="Carla Researcher"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished" id="unpub_draft" title="Experimental Results on Incremental Transformations" note="Under revision for journal submission">
    <authors author="Daniel Draft"/>
    <authors author="Eve Reviewer"/>
    <authors author="Frank Collaborator"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual" id="manual_tool_guide" title="User Guide for the MDE Analysis Toolkit"/>
  
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings" id="proc_conf_2021" title="Proceedings of the International Conference on Model Engineering" year="2021"/>

  <!-- InProceedings with own title, booktitle, authors, and inherited year/title from Proceedings -->
  <entries xsi:type="BibTeX:InProceedings" id="inproc_case_study" title="Case Studies in Bidirectional Transformations" year="2021" booktitle="International Conference on Model Engineering">
    <authors author="Grace CaseStudy"/>
    <authors author="Henry Analyst"/>
  </entries>

  <!-- Booklet (only year, no authors or title required by metamodel) -->
  <entries xsi:type="BibTeX:Booklet" id="booklet_overview" year="2015"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book" id="book_mde_intro" title="Introduction to Model-Driven Engineering" year="2014" publisher="Academic Press">
    <authors author="Irene Instructor"/>
    <authors author="John Lecturer"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection" id="incollection_chapter" title="Testing Transformations in Large-Scale Systems" year="2016" publisher="Springer" booktitle="Advances in Model-Driven Engineering">
    <authors author="Karen Tester"/>
    <authors author="Leo Architect"/>
  </entries>

  <!-- InBook: Book plus chapter number -->
  <entries xsi:type="BibTeX:InBook" id="inbook_specific_chapter" title="Model Synchronization Techniques" year="2013" publisher="Tech Publishing" chapter="7">
    <authors author="Maria Synchronizer"/>
  </entries>

  <!-- Misc: minimal entry with only mandatory id -->
  <entries xsi:type="BibTeX:Misc" id="misc_resource_note"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis" id="phd_thesis_model_trans" title="Formal Foundations for Model Transformation Testing" year="2012" school="University of Metamodeling">
    <authors author="Nathan Doctoral"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis" id="master_thesis_case_tool" title="Tool Support for Automated Test Generation in MDE" year="2019" school="Institute of Software Engineering">
    <authors author="Olivia Graduate"/>
  </entries>

</BibTeX:BibTeXFile>