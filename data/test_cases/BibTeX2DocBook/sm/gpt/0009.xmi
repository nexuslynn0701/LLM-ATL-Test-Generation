<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplex2021"
           title="Combining Model Transformations and Testing"
           year="2021"
           journal="Journal of Model Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techRepMDE2020"
           title="An Industrial Survey on ATL Transformations"
           year="2020">
    <authors author="Diana Miller"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraftMDD"
           title="Draft: Verification of Model Transformations"
           note="Preprint under review">
    <authors author="Eve Thompson"/>
    <authors author="Frank Lee"/>
    <authors author="Grace Kim"/>
  </entries>

  <!-- Manual (no authors, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="atlManual301"
           title="ATL Transformation Language Reference Manual 3.0.1"/>

  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procICMT2019"
           title="Proceedings of the International Conference on Model Transformation"
           year="2019"/>

  <!-- InProceedings (inherits Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inProcTestingATL"
           title="Systematic Testing of ATL Transformations"
           year="2019"
           booktitle="Proceedings of the International Conference on Model Transformation">
    <authors author="Henry Walker"/>
    <authors author="Irene Novak"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletIntroMDE"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="bookAdvancedMDE"
           title="Advanced Topics in Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Jack Brown"/>
    <authors author="Karen Wilson"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="inCollTraceability"
           title="Traceability in Model Transformation Chains"
           year="2017"
           publisher="Springer"
           booktitle="Advanced Topics in Model-Driven Engineering">
    <authors author="Laura Martinez"/>
  </entries>

  <!-- InBook (Book + chapter attribute) -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookChapterTesting"
           title="Testing Transformations"
           year="2017"
           publisher="Springer"
           chapter="5">
    <authors author="Jack Brown"/>
    <authors author="Michael Green"/>
  </entries>

  <!-- Misc (minimal, only id required) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscToolWebsite"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisMetamod"
           title="Metamodel-Based Testing of Model Transformations"
           year="2016"
           school="Technical University of Metropolis">
    <authors author="Nina Patel"/>
  </entries>

  <!-- MasterThesis with multiple authors (unusual but allowed by metamodel) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisCoauthors"
           title="Empirical Evaluation of ATL Test Strategies"
           year="2015"
           school="Institute of Software Systems">
    <authors author="Oscar Reed"/>
    <authors author="Paula Young"/>
  </entries>

</BibTeX:BibTeXFile>