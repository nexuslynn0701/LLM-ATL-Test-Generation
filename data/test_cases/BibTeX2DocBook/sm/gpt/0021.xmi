<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_authors_2022"
           title="Model-Driven Testing of Transformation Chains"
           year="2022"
           journal="International Journal of Software Engineering">
    <authors author="Alice M. Tester"/>
    <authors author="Bob Q. Analyzer"/>
    <authors author="Carol L. Verifier"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techreport_single_2020"
           title="A Survey on Bidirectional Model Transformations"
           year="2020">
    <authors author="David R. Researcher"/>
  </entries>

  <!-- Unpublished with note and two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpublished_draft_2019"
           title="Towards Automated Oracles for Model Transformations"
           note="Draft version, not for distribution">
    <authors author="Eva S. Specifier"/>
    <authors author="Frank U. Debugger"/>
  </entries>

  <!-- Manual (no author, no year, title only) -->
  <entries xsi:type="BibTeX:Manual"
           id="tool_manual_1_1"
           title="User Guide for the Metamodel Explorer Tool v1.1"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde_symp_2023"
           title="Proceedings of the 5th Symposium on Model-Driven Engineering"
           year="2023"/>

  <!-- InProceedings inheriting Proceeding fields + authors + booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_keynote_2023"
           title="Scaling Model Transformations in Industrial Contexts"
           year="2023"
           booktitle="Proceedings of the 5th Symposium on Model-Driven Engineering">
    <authors author="Grace K. Architect"/>
  </entries>

  <!-- Booklet (only year required) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_tutorial_2018"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns_2016"
           title="Patterns of Model-Driven Engineering"
           year="2016"
           publisher="Academic Press">
    <authors author="Henry P. Designer"/>
    <authors author="Isabel J. Modeler"/>
  </entries>

  <!-- InCollection based on Book plus booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter_2016"
           title="Testing Strategies for Model Transformations"
           year="2016"
           publisher="Academic Press"
           booktitle="Patterns of Model-Driven Engineering">
    <authors author="Julia F. Tester"/>
    <authors author="Kevin G. Engineer"/>
  </entries>

  <!-- InBook extending Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_case_study_2017"
           title="Industrial Case Studies in Transformation Testing"
           year="2017"
           publisher="Tech Publishing"
           chapter="7">
    <authors author="Laura D. Practitioner"/>
  </entries>

  <!-- Misc with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_website_ref_2024"/>

  <!-- PhDThesis with all required fields -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdthesis_mde_testing_2015"
           title="Automated Testing of Model Transformations"
           year="2015"
           school="University of Model Engineering">
    <authors author="Michael N. Doctoral"/>
  </entries>

  <!-- MasterThesis with minimal single author -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterthesis_traceability_2018"
           title="Traceability Techniques for Model Transformations"
           year="2018"
           school="Institute of Software Systems">
    <authors author="Nina O. Student"/>
  </entries>

</BibTeX:BibTeXFile>