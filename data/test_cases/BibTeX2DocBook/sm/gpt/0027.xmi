<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art2020-mde-overview"
           title="A Comprehensive Overview of Model-Driven Engineering"
           year="2020"
           journal="Journal of Software Engineering Research and Development">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr2018-testing-transformations"
           title="Testing Strategies for Model Transformations"
           year="2018">
    <authors author="Carol White"/>
  </entries>

  <!-- Unpublished entry with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub2023-atl-optimizations"
           title="Optimizations in ATL Transformations"
           note="Draft version, not yet submitted">
    <authors author="Daniel Brown"/>
    <authors author="Eva Green"/>
  </entries>

  <!-- Manual without authors, only title -->
  <entries xsi:type="BibTeX:Manual"
           id="man2021-atl-user-guide"
           title="ATL Transformation Language User Guide"/>
  
  <!-- Proceedings (no authors, just title and year) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc2019-mde-conf"
           title="Proceedings of the 2019 Conference on Model-Driven Engineering"
           year="2019"/>

  <!-- InProceedings, reusing Proceedings features plus authors and booktitle -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc2019-traceability"
           title="Traceability Techniques in MDE"
           year="2019"
           booktitle="Proceedings of the 2019 Conference on Model-Driven Engineering">
    <authors author="Frank Miller"/>
  </entries>

  <!-- Booklet, only dated -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet2017-mde-intro"
           year="2017"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book2016-mde-principles"
           title="Principles of Model-Driven Engineering"
           year="2016"
           publisher="TechPress International">
    <authors author="Grace Lee"/>
    <authors author="Henry Clark"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol2016-chapter-validation"
           title="Validation of Model Transformations"
           year="2016"
           publisher="TechPress International"
           booktitle="Handbook of Model-Driven Engineering">
    <authors author="Ian Walker"/>
  </entries>

  <!-- InBook extending Book with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook2016-chapter-testing"
           title="Testing of Model Transformations"
           year="2016"
           publisher="TechPress International"
           chapter="7">
    <authors author="Grace Lee"/>
    <authors author="Henry Clark"/>
  </entries>

  <!-- Misc with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc2022-tool-announcement"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd2015-model-transformation"
           title="Advanced Techniques for Model Transformation"
           year="2015"
           school="University of Metropolis">
    <authors author="Julia Adams"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master2021-mt-testing"
           title="Automated Testing of Model Transformations"
           year="2021"
           school="Technical University of Gotham">
    <authors author="Kevin Rogers"/>
  </entries>

</BibTeX:BibTeXFile>