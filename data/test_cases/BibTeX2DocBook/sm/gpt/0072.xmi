<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with two authors -->
  <entries xsi:type="BibTeX:Article"
           id="artMixedAuthoredDatedTitled"
           title="Model-Driven Testing of Transformation Chains"
           year="2019"
           journal="Journal of Software Engineering Methods">
    <authors author="Alice Example"/>
    <authors author="Bob Researcher"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techrepVerification"
           title="Verification Strategies for ATL Transformations"
           year="2018">
    <authors author="Clara Tester"/>
  </entries>

  <!-- Unpublished with two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraft"
           title="Draft Guidelines for Model Transformation Benchmarks"
           note="To appear in workshop on model transformation testing.">
    <authors author="Derek Benchmark"/>
    <authors author="Eva Analyst"/>
  </entries>

  <!-- Manual (title only) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualTool"
           title="ATL Transformation Debugger User Guide"/>
           
  <!-- Proceedings (dated and titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procSymposium"
           title="Proceedings of the Symposium on Model Engineering"
           year="2020"/>

  <!-- InProceedings (extends Proceedings, AuthoredEntry, BookTitledEntry) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocContext"
           title="Proceedings of the Symposium on Model Engineering"
           year="2020"
           booktitle="Symposium on Model Engineering 2020">
    <authors author="Frank Integrator"/>
    <authors author="Grace Modeler"/>
  </entries>

  <!-- Booklet (only dated) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletOverview"
           year="2015"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="bookFoundations"
           title="Foundations of Model Transformation"
           year="2016"
           publisher="Modelware Press">
    <authors author="Helen Architect"/>
    <authors author="Ian Developer"/>
  </entries>

  <!-- InCollection (extends Book and BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollectionChapter"
           title="Foundations of Model Transformation"
           year="2016"
           publisher="Modelware Press"
           booktitle="Handbook of Model-Driven Engineering">
    <authors author="Jack Contributor"/>
  </entries>

  <!-- InBook (Book plus chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookCaseStudy"
           title="Case Studies in Model Transformation"
           year="2021"
           publisher="Academic Modelling"
           chapter="7">
    <authors author="Karen Practitioner"/>
    <authors author="Leo Engineer"/>
  </entries>

  <!-- Misc (bare minimum: only id) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscUncategorized"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisMDE"
           title="Testing and Debugging of Model Transformations"
           year="2017"
           school="Institute of Model Engineering">
    <authors author="Mia Doctoral"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisAutomation"
           title="Automation of Regression Testing for ATL"
           year="2014"
           school="Faculty of Computer Science">
    <authors author="Noah Graduate"/>
  </entries>

</BibTeX:BibTeXFile>