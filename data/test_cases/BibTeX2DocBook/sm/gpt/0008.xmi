<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artMulti2021"
           title="Scalable Model Transformations in Practice"
           year="2021"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="trTooling2020"
           title="A Tooling Framework for Transformation Testing"
           year="2020">
    <authors author="Diana Roberts"/>
  </entries>

  <!-- Unpublished with note and three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDraftMDE"
           title="Draft Guidelines for MDE Benchmarks"
           note="Under revision for conference submission">
    <authors author="Emily Clark"/>
    <authors author="Frank Muller"/>
    <authors author="Grace Lee"/>
  </entries>

  <!-- Manual (no authors, just title) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualATLRef"
           title="ATL Language Reference Manual v3.0"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procICMT2023"
           title="Proceedings of the 16th International Conference on Model Transformation"
           year="2023"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocTesting2023"
           title="Coverage Criteria for Model Transformation Testing"
           year="2023"
           booktitle="Proceedings of the 16th International Conference on Model Transformation">
    <authors author="Hannah Nguyen"/>
    <authors author="Ian Thompson"/>
  </entries>

  <!-- Booklet: only dated -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletIntro"
           year="2019"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDEFoundations"
           title="Foundations of Model-Driven Engineering"
           year="2018"
           publisher="Modeling Press">
    <authors author="Jack Wilson"/>
    <authors author="Karen Young"/>
  </entries>

  <!-- InCollection: Book + BookTitledEntry (chapter in edited book) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incolChapterQuality"
           title="Quality Assurance for Model Transformations"
           year="2018"
           publisher="Modeling Press"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Laura Perez"/>
    <authors author="Michael Brown"/>
  </entries>

  <!-- InBook: Book with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookCh5Patterns"
           title="Transformation Patterns and Anti-Patterns"
           year="2017"
           publisher="Software Engineering Institute"
           chapter="5">
    <authors author="Natalie Green"/>
  </entries>

  <!-- Misc: minimal entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscInternalNote"/>
           
  <!-- PhDThesis: ThesisEntry specialization -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdMetaTesting"
           title="Meta-Testing Techniques for Model Transformations"
           year="2016"
           school="Technical University of Metamodeling">
    <authors author="Oliver King"/>
  </entries>

  <!-- MasterThesis: another ThesisEntry specialization -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="mscTraceability"
           title="Traceability Support for ATL Transformations"
           year="2015"
           school="Institute of Software Models">
    <authors author="Patricia Lopez"/>
  </entries>

</BibTeX:BibTeXFile>