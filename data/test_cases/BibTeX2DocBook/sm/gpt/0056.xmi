<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article -->
  <entries xsi:type="BibTeX:Article"
           id="art:mbt-coverage"
           title="Model-Based Testing of Model Transformations"
           year="2019"
           journal="Journal of Software Engineering Research and Development">
    <authors author="Alice Modeler"/>
    <authors author="Bob Tester"/>
  </entries>

  <!-- TechReport -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr:atl-evolution"
           title="Evolution of ATL Transformations in Industrial Contexts"
           year="2018">
    <authors author="Carol Refactor"/>
  </entries>

  <!-- Unpublished -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub:traceability"
           title="Fine-Grained Traceability for ATL Transformations"
           note="Manuscript under revision">
    <authors author="David Tracer"/>
    <authors author="Eve Analyst"/>
  </entries>

  <!-- Manual -->
  <entries xsi:type="BibTeX:Manual"
           id="man:tool-user-guide"
           title="User Guide for the Model Transformation Benchmark Suite"/>

  <!-- Proceedings (standalone, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc:icmt-2020"
           title="Proceedings of the 13th International Conference on Model Transformations"
           year="2020"/>

  <!-- InProceedings (inherits Proceeding + is authored + has booktitle) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc:testing-atl"
           title="Systematic Testing Strategies for ATL Transformations"
           year="2020"
           booktitle="Proceedings of the 13th International Conference on Model Transformations">
    <authors author="Frank Verifier"/>
  </entries>

  <!-- Booklet -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet:short-intro-mde"
           year="2017"/>

  <!-- Book -->
  <entries xsi:type="BibTeX:Book"
           id="book:mde-foundations"
           title="Foundations of Model-Driven Engineering"
           year="2015"
           publisher="Springer">
    <authors author="Grace Architect"/>
    <authors author="Henry Designer"/>
  </entries>

  <!-- InCollection (chapter in edited book, with its own booktitle) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol:case-studies"
           title="Case Studies in Model Transformation Testing"
           year="2016"
           publisher="Springer"
           booktitle="Advanced Topics in Model-Driven Engineering">
    <authors author="Ivy Practitioner"/>
  </entries>

  <!-- InBook -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook:ch-mutation"
           title="Mutation Analysis for ATL Transformations"
           year="2015"
           publisher="Springer"
           chapter="7">
    <authors author="Grace Architect"/>
  </entries>

  <!-- Misc (minimal BibTeXEntry with only id) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc:web-resource-mde"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd:scalable-testing"
           title="Scalable Testing Techniques for Model Transformations"
           year="2021"
           school="University of Software Modeling">
    <authors author="Jack Researcher"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="master:atl-debugging"
           title="Debugging Support for ATL Model Transformations"
           year="2019"
           school="Institute of Model Engineering">
    <authors author="Karen Student"/>
  </entries>

</BibTeX:BibTeXFile>