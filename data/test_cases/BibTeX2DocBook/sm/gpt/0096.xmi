<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="artComplex2020"
           title="Advanced Topics in Model-Driven Engineering"
           year="2020"
           journal="Journal of Software Engineering Research and Development">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="trMDE2021"
           title="Industrial Applications of Model Transformations"
           year="2021">
    <authors author="Diana Lewis"/>
  </entries>

  <!-- Unpublished entry -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpubDSL"
           title="A New Domain-Specific Language for Robotics"
           note="Manuscript in preparation">
    <authors author="Eric Wong"/>
    <authors author="Fiona Green"/>
  </entries>

  <!-- Manual (no authors, no year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manualToolX"
           title="ToolX User Guide Version 3.2"/>
  
  <!-- Proceedings with year and title, also used as supertype for InProceedings -->
  <entries xsi:type="BibTeX:Proceedings"
           id="procModels2019"
           title="Proceedings of the 12th International Conference on Model Transformation"
           year="2019"/>

  <!-- InProceedings, reusing conference style but as a standalone entry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inprocTrace2019"
           title="Traceability Support in Bidirectional Transformations"
           year="2019"
           booktitle="Proceedings of the 12th International Conference on Model Transformation">
    <authors author="George Keller"/>
    <authors author="Helen Brown"/>
  </entries>

  <!-- Booklet (only year, no title, no authors) -->
  <entries xsi:type="BibTeX:Booklet"
           id="bookletIntroMDE"
           year="2018"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="bookMDEFoundations"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="Springer">
    <authors author="Ivan Petrov"/>
    <authors author="Julia Novak"/>
  </entries>

  <!-- InCollection: chapter in an edited book, reusing Book plus BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollectionVerification"
           title="Verification Techniques for Model Transformations"
           year="2017"
           publisher="Springer"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Kevin Lee"/>
  </entries>

  <!-- InBook: specific chapter of a book -->
  <entries xsi:type="BibTeX:InBook"
           id="inbookChapter5"
           title="Case Studies in Model-Driven Development"
           year="2016"
           publisher="Morgan &amp; Claypool"
           chapter="5">
    <authors author="Laura Martinez"/>
    <authors author="Michael O&apos;Connor"/>
  </entries>

  <!-- Misc entry (minimal BibTeXEntry with only id) -->
  <entries xsi:type="BibTeX:Misc"
           id="miscWebResource01"/>

  <!-- PhD thesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesisTransform"
           title="Scalable Model Transformation Techniques"
           year="2015"
           school="Technical University of Metropolis">
    <authors author="Natalie Young"/>
  </entries>

  <!-- Master thesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="masterThesisRefactoring"
           title="Model Refactoring Approaches for Legacy Systems"
           year="2014"
           school="Institute of Software Technology">
    <authors author="Oliver King"/>
  </entries>

</BibTeX:BibTeXFile>