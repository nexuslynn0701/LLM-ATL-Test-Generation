<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="smith2020hybrid"
           title="A Hybrid Approach to Model-Driven Engineering"
           year="2020"
           journal="Journal of Software Engineering Research and Development">
    <authors author="John A. Smith"/>
    <authors author="Maria Garcia"/>
    <authors author="Liu Wei"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="nguyen2019report"
           title="Industrial Experiences with ATL Transformations"
           year="2019">
    <authors author="Thu Nguyen"/>
  </entries>

  <!-- Unpublished with two authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="rodriguez2024draft"
           title="Draft Specification of a Bidirectional Transformation Language"
           note="Under submission to the MDE 2025 conference">
    <authors author="Carlos Rodriguez"/>
    <authors author="Elena Petrova"/>
  </entries>

  <!-- Manual with only title -->
  <entries xsi:type="BibTeX:Manual"
           id="toolXmanual"
           title="ToolX Transformation Suite User Manual v3.1"/>
           
  <!-- Proceedings (dated + titled) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="models2021"
           title="Proceedings of the 17th International Conference on Model-Driven Engineering"
           year="2021"/>

  <!-- InProceedings: inherits Proceedings, AuthoredEntry, BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="khan2021incremental"
           title="Incremental Testing of Model Transformations"
           year="2021"
           booktitle="Proceedings of the 17th International Conference on Model-Driven Engineering">
    <authors author="Sara Khan"/>
    <authors author="Tom Becker"/>
  </entries>

  <!-- Booklet (only year mandatory) -->
  <entries xsi:type="BibTeX:Booklet"
           id="guide2022"
           year="2022"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="meyerMDEbook"
           title="Foundations of Model-Driven Engineering"
           year="2018"
           publisher="TechPress International">
    <authors author="Oliver Meyer"/>
    <authors author="Hanna Schultz"/>
  </entries>

  <!-- InCollection: extends Book + BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="brown2018chapter"
           title="Testing and Verification of Model Transformations"
           year="2018"
           publisher="TechPress International"
           booktitle="Foundations of Model-Driven Engineering">
    <authors author="Robert Brown"/>
  </entries>

  <!-- InBook: extends Book and adds chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="lee2018chapter5"
           title="Traceability in Large-Scale Transformation Chains"
           year="2018"
           publisher="TechPress International"
           chapter="5">
    <authors author="Jin Lee"/>
    <authors author="Emma Rossi"/>
  </entries>

  <!-- Misc: minimal entry with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscResource01"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="garcia2017phd"
           title="Scalable Analysis of Model Transformations"
           year="2017"
           school="University of Southern Metropolis">
    <authors author="Maria Garcia"/>
  </entries>

  <!-- MasterThesis with two authors (unusual but allowed by metamodel) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="joint2020msc"
           title="Collaborative Development of ATL Transformations"
           year="2020"
           school="Institute of Advanced Software Systems">
    <authors author="Luis Fernandez"/>
    <authors author="Anne Dupont"/>
  </entries>

</BibTeX:BibTeXFile>