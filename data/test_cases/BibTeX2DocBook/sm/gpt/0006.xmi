<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="articleComplex01"
           title="A Comprehensive Survey on Model Transformation Testing"
           year="2021"
           journal="Journal of Software Engineering Research and Development">
    <authors author="Alice Example"/>
    <authors author="Bob Researcher"/>
    <authors author="Charlie Tester"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="techReportEdge01"
           title="Boundary Cases in ATL Model Transformations"
           year="2019">
    <authors author="Dana Boundary"/>
  </entries>

  <!-- Unpublished entry without year, but with note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpublishedDraft01"
           title="Draft Specification of a Bidirectional Transformation Language"
           note="Working draft, not yet submitted">
    <authors author="Evan Specifier"/>
    <authors author="Fiona Architect"/>
  </entries>

  <!-- Manual (no authors, no year, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="toolManual01"
           title="User Guide for the MetaModel Analyzer 3.0"/>
           
  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="confProceedings2020"
           title="Proceedings of the 10th International Conference on Model Transformations"
           year="2020"/>

  <!-- InProceedings that reuses booktitle distinct from proceedings title -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inProcPaper01"
           title="Detecting Anomalies in Model-to-Model Transformations"
           year="2020"
           booktitle="ICMT 2020: International Conference on Model Transformations">
    <authors author="Grace Analyzer"/>
    <authors author="Henry Debugger"/>
  </entries>

  <!-- Booklet (only year, no authors, no title) -->
  <entries xsi:type="BibTeX:Booklet"
           id="promoBooklet01"
           year="2018"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="mdeTextbook01"
           title="Foundations of Model-Driven Engineering"
           year="2017"
           publisher="Academic Press">
    <authors author="Irene Modeller"/>
    <authors author="Jack Engineer"/>
  </entries>

  <!-- InCollection: chapter in an edited book with its own booktitle -->
  <entries xsi:type="BibTeX:InCollection"
           id="inCollectionChap01"
           title="Testing Strategies for Transformation Chains"
           year="2017"
           publisher="Academic Press"
           booktitle="Advances in Model-Driven Engineering">
    <authors author="Karen Chain"/>
  </entries>

  <!-- InBook: specific chapter with chapter number -->
  <entries xsi:type="BibTeX:InBook"
           id="inBookChap05"
           title="Case Studies in Industrial Model Transformations"
           year="2017"
           publisher="Academic Press"
           chapter="5">
    <authors author="Laura Practitioner"/>
    <authors author="Mark CaseStudy"/>
  </entries>

  <!-- Misc entry with only mandatory id -->
  <entries xsi:type="BibTeX:Misc"
           id="miscResource01"/>

  <!-- PhD thesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phdThesis01"
           title="Automated Testing of Model Transformations"
           year="2015"
           school="Technical University of Metropolis">
