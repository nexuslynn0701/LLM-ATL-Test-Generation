<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_smith2021_mde_survey"
           title="A Comprehensive Survey on Model-Driven Engineering"
           year="2021"
           journal="Journal of Software Engineering Research and Development">
    <authors author="John Smith"/>
    <authors author="Emily Clark"/>
    <authors author="Wei Zhang"/>
  </entries>

  <!-- TechReport with a single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_lee2020_validation"
           title="Validation Strategies for Model Transformations"
           year="2020">
    <authors author="Alice Lee"/>
  </entries>

  <!-- Unpublished with three authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unp_martin2023_tool"
           title="A Tool Demo for Interactive ATL Debugging"
           note="Manuscript under preparation">
    <authors author="Robert Martin"/>
    <authors author="Sara Novak"/>
    <authors author="Luis Fernandez"/>
  </entries>

  <!-- Manual (no authors, no year, only title) -->
  <entries xsi:type="BibTeX:Manual"
           id="man_atl_user_guide"
           title="ATL User Guide Version 4.0"/>

  <!-- Proceedings (dated and titled, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_models2022"
           title="Proceedings of the 25th International Conference on Model Driven Engineering Languages and Systems"
           year="2022"/>

  <!-- InProceedings: inherits title+year from Proceedings, plus booktitle and authors -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inp_brown2022_testing"
           title="Systematic Testing of Model Transformations in Practice"
           year="2022"
           booktitle="MODELS 2022: Proceedings of the 25th International Conference on Model Driven Engineering Languages and Systems">
    <authors author="Michael Brown"/>
    <authors author="Helen Green"/>
  </entries>

  <!-- Booklet (only dated, no title, no authors) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_mde_tutorial"
           year="2019"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_kiczales2024_mde"
           title="Foundations of Model-Driven Engineering"
           year="2024"
           publisher="Springer">
    <authors author="Gregor Kiczales"/>
    <authors author="Maria Rossi"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incoll_oliva2023_qvtr"
           title="Practical QVT-Relations for Industrial Transformations"
           year="2023"
           publisher="CRC Press"
           booktitle="Advances in Model Transformation Technologies">
    <authors author="Paulo Oliva"/>
    <authors author="Nina Schulz"/>
  </entries>

  <!-- InBook (Book + chapter) with single author -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_jones2020_chapter5"
           title="Testing Strategies for ATL Transformations"
           year="2020"
           publisher="Morgan Kaufmann"
           chapter="5">
    <authors author="David Jones"/>
  </entries>

  <!-- Misc (minimal, only required id) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_mde_website"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_anderson2018"
           title="Scalable Techniques for Testing Model Transformations"
           year="2018"
           school="University of Technology Munich">
    <authors author="Laura Anderson"/>
  </entries>

  <!-- MasterThesis with two authors (co-supervised work, but authors are the students) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_roberts_nguyen2019"
           title="Automated Oracle Generation for Model Transformation Testing"
           year="2019"
           school="Politecnico di Milano">
    <authors author="Peter Roberts"/>
    <authors author="Trang Nguyen"/>
  </entries>

</BibTeX:BibTeXFile>