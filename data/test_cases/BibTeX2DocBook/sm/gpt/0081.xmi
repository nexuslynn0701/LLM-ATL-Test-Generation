<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_multi_auth"
           title="Scalable Model Transformations in Practice"
           year="2018"
           journal="Journal of Model-Driven Engineering">
    <authors author="Alice Smith"/>
    <authors author="Bob Johnson"/>
    <authors author="Carlos Diaz"/>
  </entries>

  <!-- TechReport with single author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_single_auth"
           title="Verification Techniques for ATL Transformations"
           year="2020">
    <authors author="Diana Miller"/>
  </entries>

  <!-- Unpublished without date, but with authors and note -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_draft"
           title="Draft Semantics of Bidirectional Transformations"
           note="Submitted for internal review only.">
    <authors author="Eve Walker"/>
    <authors author="Frank Zhang"/>
  </entries>

  <!-- Manual (only title, no authors or year) -->
  <entries xsi:type="BibTeX:Manual"
           id="manual_tool"
           title="Atlas Transformations Toolkit User Guide v3.1"/>
  
  <!-- Proceedings (has title and year, no authors) -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_conf"
           title="Proceedings of the International Conference on Model Transformation"
           year="2019"/>

  <!-- InProceedings (inherits title/year from Proceedings and adds authors and booktitle) -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_keynote"
           title="Keynote on the Future of Model Engineering"
           year="2019"
           booktitle="ICMT 2019: International Conference on Model Transformation">
    <authors author="Grace Hopper"/>
  </entries>

  <!-- Booklet (only year; minimal non-abstract dated entry) -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_overview"
           year="2017"/>

  <!-- Book with multiple authors -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns"
           title="Patterns for Model-Driven Engineering"
           year="2015"
           publisher="Springer">
    <authors author="Henry Lewis"/>
    <authors author="Irene Novak"/>
  </entries>

  <!-- InCollection (Book + BookTitledEntry) -->
  <entries xsi:type="BibTeX:InCollection"
           id="incollection_chapter"
           title="Testing Model Transformations"
           year="2016"
           publisher="Morgan &amp; Claypool"
           booktitle="Advanced Topics in Model Engineering">
    <authors author="Jack O&apos;Neill"/>
    <authors author="Karen Wu"/>
  </entries>

  <!-- InBook (Book + chapter) -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_case_study"
           title="Case Study: Industrial Use of ATL"
           year="2014"
           publisher="Elsevier"
           chapter="7">
    <authors author="Liam Brown"/>
  </entries>

  <!-- Misc (only id; minimal BibTeXEntry) -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_resource"/>

  <!-- PhDThesis (ThesisEntry subtype) -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_mde"
           title="Automated Analysis of Model Transformations"
           year="2021"
           school="Technical University of Metropolis">
    <authors author="Maria Rossi"/>
  </entries>

  <!-- MasterThesis (ThesisEntry subtype) -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="msc_traceability"
           title="Traceability Support for Model Transformations"
           year="2013"
           school="Institute of Software Science">
    <authors author="Nina Patel"/>
  </entries>

</BibTeX:BibTeXFile>