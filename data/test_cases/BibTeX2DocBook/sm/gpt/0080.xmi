<BibTeX:BibTeXFile xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:BibTeX="http://BibTeX/1.0">

  <!-- Article with multiple authors -->
  <entries xsi:type="BibTeX:Article"
           id="art_smith_ai2020"
           title="Advances in Artificial Intelligence"
           year="2020"
           journal="Journal of Emerging Computing">
    <authors author="John Smith"/>
    <authors author="Alice Johnson"/>
  </entries>

  <!-- TechReport with one author -->
  <entries xsi:type="BibTeX:TechReport"
           id="tr_miller_formal2018"
           title="A Formal Approach to Model Transformations"
           year="2018">
    <authors author="Carol Miller"/>
  </entries>

  <!-- Unpublished with note and multiple authors -->
  <entries xsi:type="BibTeX:Unpublished"
           id="unpub_lee_models2023"
           title="Model Transformations in Practice"
           note="Draft version, not for distribution">
    <authors author="David Lee"/>
    <authors author="Emma Brown"/>
  </entries>

  <!-- Manual (title only) -->
  <entries xsi:type="BibTeX:Manual"
           id="man_tool_guide2021"
           title="User Guide for the Transformation Toolkit"/>
  
  <!-- Proceedings with date and title -->
  <entries xsi:type="BibTeX:Proceedings"
           id="proc_mde2022"
           title="Proceedings of the International Conference on Model-Driven Engineering"
           year="2022"/>

  <!-- InProceedings that inherits from Proceedings, AuthoredEntry, and BookTitledEntry -->
  <entries xsi:type="BibTeX:InProceedings"
           id="inproc_garcia_testing2022"
           title="Testing ATL Transformations: An Empirical Study"
           year="2022"
           booktitle="Proceedings of the International Conference on Model-Driven Engineering">
    <authors author="Luis Garcia"/>
    <authors author="Nina Patel"/>
  </entries>

  <!-- Booklet with only year -->
  <entries xsi:type="BibTeX:Booklet"
           id="booklet_short_intro2019"
           year="2019"/>

  <!-- Book with multiple authors and publisher -->
  <entries xsi:type="BibTeX:Book"
           id="book_mde_patterns2017"
           title="Patterns for Model-Driven Engineering"
           year="2017"
           publisher="TechPress Publishing">
    <authors author="Oliver King"/>
    <authors author="Paula Adams"/>
  </entries>

  <!-- InCollection extending Book and BookTitledEntry -->
  <entries xsi:type="BibTeX:InCollection"
           id="incol_wang_validation2017"
           title="Validation Techniques for Model Transformations"
           year="2017"
           publisher="TechPress Publishing"
           booktitle="Patterns for Model-Driven Engineering">
    <authors author="Qi Wang"/>
  </entries>

  <!-- InBook with chapter -->
  <entries xsi:type="BibTeX:InBook"
           id="inbook_santos_case2020"
           title="Case Study on Industrial Model Transformations"
           year="2020"
           publisher="Enterprise Systems Press"
           chapter="5">
    <authors author="Rita Santos"/>
    <authors author="Thomas Young"/>
  </entries>

  <!-- Misc with only id -->
  <entries xsi:type="BibTeX:Misc"
           id="misc_web_resource001"/>

  <!-- PhDThesis -->
  <entries xsi:type="BibTeX:PhDThesis"
           id="phd_khan_trace2016"
           title="Traceability in Model Transformation Chains"
           year="2016"
           school="University of Metropolis">
    <authors author="Sara Khan"/>
  </entries>

  <!-- MasterThesis -->
  <entries xsi:type="BibTeX:MasterThesis"
           id="ms_jones_optimization2021"
           title="Optimization Techniques for ATL Transformations"
           year="2021"
           school="Institute of Software Engineering">
    <authors author="Mark Jones"/>
  </entries>

</BibTeX:BibTeXFile>