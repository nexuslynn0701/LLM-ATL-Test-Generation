<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="ParallelBranchesWithMerge">
    <!-- Steps: two initial branches leading to a common mid step, then to a final step -->
    <elements xsi:type="Grafcet:Step" location="s001" name="InitA" isInitial="true" isActive="true" action="initializeA"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="InitB" isInitial="true" isActive="false" action="initializeB"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="ForkA" condition="startA"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="ForkB" condition="startB"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="Mid" isInitial="false" isActive="false" action="processMid"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="Merge" condition="bothDone"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Final" isInitial="false" isActive="false" action="finishAll"/>

    <!-- Connections: parallel branches to Mid, then Mid to Final -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="initAToForkA" from="/0/@elements.0" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="initBToForkB" from="/0/@elements.1" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="forkAToMid" from="/0/@elements.2" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c004" name="forkBToMid" from="/0/@elements.3" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="midToMerge" from="/0/@elements.4" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="mergeToFinal" from="/0/@elements.5" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>