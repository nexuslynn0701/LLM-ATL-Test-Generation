<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net100" name="ParallelBranchesWithMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA" isInitial="false" isActive="false" action="executeA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchB" isInitial="false" isActive="false" action="executeB"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Merge" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="End" isInitial="false" isActive="false" action="finalize"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="SplitToBranches" condition="startComplete"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="BranchAComplete" condition="branchADone"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="BranchBComplete" condition="branchBDone"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="AllBranchesMerged" condition="bothBranchesDone"/>
    <elements xsi:type="Grafcet:Transition" location="t005" name="FinishProcess" condition="mergeComplete"/>
    <!-- Connections: Start -> SplitToBranches -> BranchA & BranchB -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToSplit" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="splitToBranchA" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="splitToBranchB" from="/0/@elements.5" to="/0/@elements.2"/>
    <!-- Connections: BranchA -> BranchAComplete -> Merge -->
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="branchAToComplete" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c005" name="branchACompleteToMerge" from="/0/@elements.6" to="/0/@elements.3"/>
    <!-- Connections: BranchB -> BranchBComplete -> Merge -->
    <connections xsi:type="Grafcet:StepToTransition" location="c006" name="branchBToComplete" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="branchBCompleteToMerge" from="/0/@elements.7" to="/0/@elements.3"/>
    <!-- Connections: Merge -> AllBranchesMerged -> End -->
    <connections xsi:type="Grafcet:StepToTransition" location="c008" name="mergeToAllBranchesMerged" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="allBranchesMergedToEnd" from="/0/@elements.8" to="/0/@elements.4"/>
    <!-- Additional loop: End -> FinishProcess -> Start -->
    <connections xsi:type="Grafcet:StepToTransition" location="c010" name="endToFinishProcess" from="/0/@elements.4" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c011" name="finishProcessToStart" from="/0/@elements.9" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>