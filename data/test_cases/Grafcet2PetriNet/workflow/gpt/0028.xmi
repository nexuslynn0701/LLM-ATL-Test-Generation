<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchAndMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="PathA" isInitial="false" isActive="false" action="computeA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="PathB" isInitial="false" isActive="false" action="computeB"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Join" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="LoopStep" isInitial="false" isActive="false" action="retryCycle"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="Split" condition="startOk"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="AtoJoin" condition="aDone"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="BtoJoin" condition="bDone"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="JoinToLoop" condition="needRetry"/>
    <elements xsi:type="Grafcet:Transition" location="t005" name="LoopBack" condition="retry"/>

    <!-- Connections: branching, merging, and a loop -->
    <!-- Start -> Split -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToSplit" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- Split -> PathA -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="splitToPathA" from="/0/@elements.5" to="/0/@elements.1"/>
    <!-- Split -> PathB -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="splitToPathB" from="/0/@elements.5" to="/0/@elements.2"/>
    <!-- PathA -> AtoJoin -->
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="pathAToJoin" from="/0/@elements.1" to="/0/@elements.6"/>
    <!-- PathB -> BtoJoin -->
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="pathBToJoin" from="/0/@elements.2" to="/0/@elements.7"/>
    <!-- AtoJoin -> Join -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="AJoinToJoinStep" from="/0/@elements.6" to="/0/@elements.3"/>
    <!-- BtoJoin -> Join -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="BJoinToJoinStep" from="/0/@elements.7" to="/0/@elements.3"/>
    <!-- Join -> JoinToLoop -->
    <connections xsi:type="Grafcet:StepToTransition" location="c008" name="joinToLoopTransition" from="/0/@elements.3" to="/0/@elements.8"/>
    <!-- JoinToLoop -> LoopStep -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="joinToLoopStep" from="/0/@elements.8" to="/0/@elements.4"/>
    <!-- LoopStep -> LoopBack -->
    <connections xsi:type="Grafcet:StepToTransition" location="c010" name="loopStepToBack" from="/0/@elements.4" to="/0/@elements.9"/>
    <!-- LoopBack -> Start (cycle) -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c011" name="loopBackToStart" from="/0/@elements.9" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>