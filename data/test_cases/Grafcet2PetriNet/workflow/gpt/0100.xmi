<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net100" name="ParallelBranchesWithMerge">
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="init"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="Split" condition="readyToSplit"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA1" isInitial="false" isActive="false" action="runA1"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchA2" isInitial="false" isActive="false" action="runA2"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="BranchB1" isInitial="false" isActive="false" action="runB1"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="MergeA" condition="branchAComplete"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="MergeAB" condition="allBranchesComplete"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="End" isInitial="false" isActive="false" action="finish"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToSplit" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="splitToBranchA1" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="splitToBranchB1" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="branchA1ToMergeA" from="/0/@elements.2" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c005" name="mergeAToBranchA2" from="/0/@elements.5" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c006" name="branchA2ToMergeAB" from="/0/@elements.3" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c007" name="branchB1ToMergeAB" from="/0/@elements.4" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c008" name="mergeABToEnd" from="/0/@elements.6" to="/0/@elements.7"/>
  </Grafcet:Grafcet>
</xmi:XMI>