<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchAndMerge">
    <elements xsi:type="Grafcet:Step" location="s001" name="StartUp" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="ChoosePath" condition="pathSelected"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="PathA" isInitial="false" isActive="false" action="executeA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="PathB" isInitial="false" isActive="false" action="executeB"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="MergePaths" condition="bothDone"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="FinalStep" isInitial="false" isActive="false" action="finalize"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToChoose" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="chooseToPathA" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="chooseToPathB" from="/0/@elements.1" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="pathAToMerge" from="/0/@elements.2" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="pathBToMerge" from="/0/@elements.3" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="mergeToFinal" from="/0/@elements.4" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>