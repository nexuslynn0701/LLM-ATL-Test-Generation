<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchMergeParallel">
    <!-- Elements: 5 Steps, 3 Transitions, interleaved order -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="init"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA" isInitial="false" isActive="false" action="workA"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="Split" condition="startDone"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchB" isInitial="false" isActive="false" action="workB"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="Join" condition="bothDone"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="JoinStep" isInitial="false" isActive="false" action="merge"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="Finish" condition="joined"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="End" isInitial="false" isActive="false" action="stop"/>

    <!-- Connections: 4 StepToTransition, 4 TransitionToStep, including a self-loop and shared targets -->
    <!-- Start -> Split -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToSplit" from="/0/@elements.0" to="/0/@elements.2"/>
    <!-- Split -> BranchA -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="splitToA" from="/0/@elements.2" to="/0/@elements.1"/>
    <!-- Split -> BranchB -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="splitToB" from="/0/@elements.2" to="/0/@elements.3"/>
    <!-- BranchA -> Join -->
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="aToJoin" from="/0/@elements.1" to="/0/@elements.4"/>
    <!-- BranchB -> Join -->
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="bToJoin" from="/0/@elements.3" to="/0/@elements.4"/>
    <!-- Join -> JoinStep -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="joinToJoinStep" from="/0/@elements.4" to="/0/@elements.5"/>
    <!-- JoinStep -> Finish -->
    <connections xsi:type="Grafcet:StepToTransition" location="c007" name="joinStepToFinish" from="/0/@elements.5" to="/0/@elements.6"/>
    <!-- Finish -> End (self-loop on final step to vary structure) -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c008" name="finishToEnd" from="/0/@elements.6" to="/0/@elements.7"/>
  </Grafcet:Grafcet>
</xmi:XMI>