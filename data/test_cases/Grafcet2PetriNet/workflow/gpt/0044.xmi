<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchingMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="StartUp" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="ParallelA" isInitial="false" isActive="false" action="runA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="ParallelB" isInitial="false" isActive="false" action="runB"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Merge" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="Shutdown" isInitial="false" isActive="false" action="cleanup"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="StartToParallel" condition="started"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="ACompleted" condition="aDone"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="BCompleted" condition="bDone"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="Finish" condition="merged"/>

    <!-- Connections: from Step (indices 0..4) to Transition (indices 5..8) and back -->
    <!-- StartUp -> StartToParallel -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToParallel" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- StartToParallel -> ParallelA -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="parallelToA" from="/0/@elements.5" to="/0/@elements.1"/>
    <!-- StartToParallel -> ParallelB -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="parallelToB" from="/0/@elements.5" to="/0/@elements.2"/>
    <!-- ParallelA -> ACompleted -->
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="aToDone" from="/0/@elements.1" to="/0/@elements.6"/>
    <!-- ParallelB -> BCompleted -->
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="bToDone" from="/0/@elements.2" to="/0/@elements.7"/>
    <!-- ACompleted -> Merge -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="aDoneToMerge" from="/0/@elements.6" to="/0/@elements.3"/>
    <!-- BCompleted -> Merge -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="bDoneToMerge" from="/0/@elements.7" to="/0/@elements.3"/>
    <!-- Merge -> Finish -->
    <connections xsi:type="Grafcet:StepToTransition" location="c008" name="mergeToFinish" from="/0/@elements.3" to="/0/@elements.8"/>
    <!-- Finish -> Shutdown -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="finishToShutdown" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>