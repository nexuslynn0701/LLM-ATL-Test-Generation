<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net004" name="BranchAndMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="init"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchLeft" isInitial="false" isActive="false" action="leftAction"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchRight" isInitial="false" isActive="false" action="rightAction"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Join" isInitial="false" isActive="false" action="joinAction"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="Split" condition="triggerSplit"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="Sync" condition="bothDone"/>
    <!-- Connections -->
    <!-- From initial step to split transition -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToSplit" from="/0/@elements.0" to="/0/@elements.4"/>
    <!-- From split transition to two branch steps (branching fan-out) -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="splitToLeft" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="splitToRight" from="/0/@elements.4" to="/0/@elements.2"/>
    <!-- From each branch step to sync transition (fan-in) -->
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="leftToSync" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="rightToSync" from="/0/@elements.2" to="/0/@elements.5"/>
    <!-- From sync transition to join step -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="syncToJoin" from="/0/@elements.5" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>