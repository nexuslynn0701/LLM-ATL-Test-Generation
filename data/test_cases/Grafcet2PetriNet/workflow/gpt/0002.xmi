<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="ParallelBranchesWithMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="StartUp" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA" isInitial="false" isActive="false" action="runA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchB" isInitial="false" isActive="false" action="runB"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="MergePoint" isInitial="false" isActive="false" action="merge"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="Shutdown" isInitial="false" isActive="false" action="cleanup"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="Split" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="CompleteA" condition="branchAFinished"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="CompleteB" condition="branchBFinished"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="FinishAll" condition="allDone"/>
    <!-- Connections: StepToTransition and TransitionToStep forming parallel branches and a merge -->
    <!-- StartUp -> Split -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToSplit" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- Split -> BranchA -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="splitToBranchA" from="/0/@elements.5" to="/0/@elements.1"/>
    <!-- Split -> BranchB -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="splitToBranchB" from="/0/@elements.5" to="/0/@elements.2"/>
    <!-- BranchA -> CompleteA -->
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="branchAToCompleteA" from="/0/@elements.1" to="/0/@elements.6"/>
    <!-- BranchB -> CompleteB -->
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="branchBToCompleteB" from="/0/@elements.2" to="/0/@elements.7"/>
    <!-- CompleteA -> MergePoint -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="completeAToMerge" from="/0/@elements.6" to="/0/@elements.3"/>
    <!-- CompleteB -> MergePoint -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="completeBToMerge" from="/0/@elements.7" to="/0/@elements.3"/>
    <!-- MergePoint -> FinishAll -->
    <connections xsi:type="Grafcet:StepToTransition" location="c008" name="mergeToFinishAll" from="/0/@elements.3" to="/0/@elements.8"/>
    <!-- FinishAll -> Shutdown -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="finishAllToShutdown" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>