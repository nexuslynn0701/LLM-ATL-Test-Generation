<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="ParallelBranchesWithMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Init" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="Split" condition="startSignal"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA" isInitial="false" isActive="false" action="runA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchB" isInitial="false" isActive="false" action="runB"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="Join" condition="bothDone"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Final" isInitial="false" isActive="false" action="finish"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="LoopBack" condition="repeatRequested"/>
    <!-- Connections: sequence, parallel split, join, and loop -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="initToSplit" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="splitToBranchA" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="splitToBranchB" from="/0/@elements.1" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="branchAToJoin" from="/0/@elements.2" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="branchBToJoin" from="/0/@elements.3" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="joinToFinal" from="/0/@elements.4" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c007" name="finalToLoopBack" from="/0/@elements.5" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c008" name="loopBackToInit" from="/0/@elements.6" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>