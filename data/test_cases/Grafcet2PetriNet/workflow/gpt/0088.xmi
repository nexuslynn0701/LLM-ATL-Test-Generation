<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net004" name="ParallelBranchesWithMerge">
    <!-- Elements: 4 Steps (2 initial in parallel, 2 non-initial), 3 Transitions -->
    <elements xsi:type="Grafcet:Step" location="s001" name="InitA" isInitial="true" isActive="true" action="startA"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="InitB" isInitial="true" isActive="false" action="startB"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="SplitA" condition="condA"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="SplitB" condition="condB"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="Work1" isInitial="false" isActive="false" action="work1"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Work2" isInitial="false" isActive="false" action="work2"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="Join" condition="bothDone"/>

    <!-- Connections: 4 StepToTransition, 3 TransitionToStep -->
    <!-- Parallel start from two different initial steps -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="initAToSplitA" from="/0/@elements.0" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="initBToSplitB" from="/0/@elements.1" to="/0/@elements.3"/>
    <!-- Each branch continues to its working step -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="splitAToWork1" from="/0/@elements.2" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c004" name="splitBToWork2" from="/0/@elements.3" to="/0/@elements.5"/>
    <!-- Both working steps converge to a single join transition -->
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="work1ToJoin" from="/0/@elements.4" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c006" name="work2ToJoin" from="/0/@elements.5" to="/0/@elements.6"/>
    <!-- Join transition loops back to one of the initial steps -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="joinToInitA" from="/0/@elements.6" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>