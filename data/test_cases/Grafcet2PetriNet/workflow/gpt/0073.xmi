<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net004" name="BranchMergeParallel">
    <!-- Elements: 4 Steps, 3 Transitions -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="init"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="Branch" condition="ready"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA" isInitial="false" isActive="false" action="doA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchB" isInitial="false" isActive="false" action="doB"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="Merge" condition="bothDone"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="End" isInitial="false" isActive="false" action="finish"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="LoopBack" condition="repeatRequested"/>

    <!-- Connections: 4 StepToTransition, 3 TransitionToStep -->
    <!-- Start -> Branch -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToBranch" from="/0/@elements.0" to="/0/@elements.1"/>
    <!-- Branch -> BranchA -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="branchToA" from="/0/@elements.1" to="/0/@elements.2"/>
    <!-- Branch -> BranchB -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="branchToB" from="/0/@elements.1" to="/0/@elements.3"/>
    <!-- BranchA -> Merge -->
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="aToMerge" from="/0/@elements.2" to="/0/@elements.4"/>
    <!-- BranchB -> Merge -->
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="bToMerge" from="/0/@elements.3" to="/0/@elements.4"/>
    <!-- Merge -> End -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="mergeToEnd" from="/0/@elements.4" to="/0/@elements.5"/>
    <!-- End -> LoopBack (back to Start) -->
    <connections xsi:type="Grafcet:StepToTransition" location="c007" name="endToLoop" from="/0/@elements.5" to="/0/@elements.6"/>
    <!-- LoopBack -> Start -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c008" name="loopToStart" from="/0/@elements.6" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>