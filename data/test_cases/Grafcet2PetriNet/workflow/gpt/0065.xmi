<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchingAndJoin">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="init"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="PathA" isInitial="false" isActive="false" action="computeA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="PathB" isInitial="false" isActive="false" action="computeB"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Merge" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="End" isInitial="false" isActive="false" action="finalize"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="Split" condition="readyToBranch"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="AComplete" condition="aDone"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="BComplete" condition="bDone"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="Finish" condition="allMerged"/>
    <!-- Connections: StepToTransition (Step -> Transition) -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToSplit" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="pathAToAComplete" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c003" name="pathBToBComplete" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="mergeToFinish" from="/0/@elements.3" to="/0/@elements.8"/>
    <!-- Connections: TransitionToStep (Transition -> Step) -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c005" name="splitToPathA" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="splitToPathB" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="aCompleteToMerge" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c008" name="bCompleteToMerge" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="finishToEnd" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>