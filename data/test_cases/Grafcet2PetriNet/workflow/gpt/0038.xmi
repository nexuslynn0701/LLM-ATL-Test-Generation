<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchAndMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="StartUp" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="LoadConfig" isInitial="false" isActive="false" action="load"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="SelfTest" isInitial="false" isActive="false" action="test"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Operational" isInitial="false" isActive="false" action="run"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="ConfigReady" condition="configLoaded"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="TestReady" condition="testsCompleted"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="MergePaths" condition="bothReady"/>
    <!-- Connections: branching from StartUp to two parallel paths -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToConfigReady" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="startToTestReady" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- Config path -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="configReadyToLoad" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="loadToMerge" from="/0/@elements.1" to="/0/@elements.6"/>
    <!-- Test path -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c005" name="testReadyToSelfTest" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c006" name="selfTestToMerge" from="/0/@elements.2" to="/0/@elements.6"/>
    <!-- Merge to operational -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="mergeToOperational" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>