<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net004" name="ParallelBranches">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Init" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA1" isInitial="false" isActive="false" action="workA1"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchA2" isInitial="false" isActive="false" action="workA2"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="BranchB1" isInitial="false" isActive="false" action="workB1"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="BranchB2" isInitial="false" isActive="false" action="workB2"/>
    <elements xsi:type="Grafcet:Step" location="s006" name="Merge" isInitial="false" isActive="false" action="mergeActions"/>
    <elements xsi:type="Grafcet:Step" location="s007" name="Final" isInitial="false" isActive="false" action="finish"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="Split" condition="startParallel"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="A1toA2" condition="a1Done"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="B1toB2" condition="b1Done"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="Join" condition="bothBranchesDone"/>
    <elements xsi:type="Grafcet:Transition" location="t005" name="ToFinal" condition="mergeComplete"/>
    <!-- Connections: from Steps to Transitions -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="initToSplit" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="a1ToA1toA2" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c003" name="b1ToB1toB2" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="a2ToJoin" from="/0/@elements.2" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="b2ToJoin" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c006" name="mergeToToFinal" from="/0/@elements.5" to="/0/@elements.11"/>
    <!-- Connections: from Transitions to Steps -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="splitToA1" from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c008" name="splitToB1" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="a1toA2ToA2" from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c010" name="b1toB2ToB2" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c011" name="joinToMerge" from="/0/@elements.10" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c012" name="toFinalToFinal" from="/0/@elements.11" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>