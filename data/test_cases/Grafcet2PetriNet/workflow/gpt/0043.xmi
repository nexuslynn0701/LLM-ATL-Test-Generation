<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net004" name="ParallelBranchingWithMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Init" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA" isInitial="false" isActive="false" action="runA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchB" isInitial="false" isActive="false" action="runB"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Join" isInitial="false" isActive="false" action="synchronize"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="Final" isInitial="false" isActive="false" action="finish"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="Split" condition="startParallel"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="AComplete" condition="aDone"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="BComplete" condition="bDone"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="ToFinal" condition="readyToFinish"/>
    <!-- Connections: indices of elements above
         0: Init (Step)
         1: BranchA (Step)
         2: BranchB (Step)
         3: Join (Step)
         4: Final (Step)
         5: Split (Transition)
         6: AComplete (Transition)
         7: BComplete (Transition)
         8: ToFinal (Transition)
    -->
    <!-- Init -> Split (linear start) -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="initToSplit" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- Split -> BranchA -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="splitToBranchA" from="/0/@elements.5" to="/0/@elements.1"/>
    <!-- Split -> BranchB -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="splitToBranchB" from="/0/@elements.5" to="/0/@elements.2"/>
    <!-- BranchA -> AComplete -->
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="branchAToAComplete" from="/0/@elements.1" to="/0/@elements.6"/>
    <!-- BranchB -> BComplete -->
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="branchBToBComplete" from="/0/@elements.2" to="/0/@elements.7"/>
    <!-- AComplete -> Join -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="aCompleteToJoin" from="/0/@elements.6" to="/0/@elements.3"/>
    <!-- BComplete -> Join -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="bCompleteToJoin" from="/0/@elements.7" to="/0/@elements.3"/>
    <!-- Join -> ToFinal -->
    <connections xsi:type="Grafcet:StepToTransition" location="c008" name="joinToToFinal" from="/0/@elements.3" to="/0/@elements.8"/>
    <!-- ToFinal -> Final -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="toFinalToFinal" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>