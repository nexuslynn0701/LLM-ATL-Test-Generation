<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchAndMerge">
    <!-- Elements: 4 Steps, 3 Transitions -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Init" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="Fork" condition="startSequence"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="PathA" isInitial="false" isActive="false" action="doA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="PathB" isInitial="false" isActive="false" action="doB"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="JoinA" condition="aDone"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="JoinB" condition="bDone"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Final" isInitial="false" isActive="false" action="finish"/>

    <!-- Connections: 3 StepToTransition, 3 TransitionToStep -->
    <!-- Init -> Fork -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="initToFork" from="/0/@elements.0" to="/0/@elements.1"/>
    <!-- Fork -> PathA -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="forkToPathA" from="/0/@elements.1" to="/0/@elements.2"/>
    <!-- Fork -> PathB -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="forkToPathB" from="/0/@elements.1" to="/0/@elements.3"/>
    <!-- PathA -> JoinA -->
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="pathAToJoinA" from="/0/@elements.2" to="/0/@elements.4"/>
    <!-- PathB -> JoinB -->
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="pathBToJoinB" from="/0/@elements.3" to="/0/@elements.5"/>
    <!-- JoinA -> Final (one transition leading to final) -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="joinAToFinal" from="/0/@elements.4" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>