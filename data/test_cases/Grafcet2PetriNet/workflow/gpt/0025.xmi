<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchingAndMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s010" name="Init" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s011" name="PathA" isInitial="false" isActive="false" action="runA"/>
    <elements xsi:type="Grafcet:Step" location="s012" name="PathB" isInitial="false" isActive="false" action="runB"/>
    <elements xsi:type="Grafcet:Step" location="s013" name="Merge" isInitial="false" isActive="false" action="mergePaths"/>
    <elements xsi:type="Grafcet:Step" location="s014" name="Final" isInitial="false" isActive="false" action="finish"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t010" name="StartSplit" condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" location="t011" name="ToA" condition="chooseA"/>
    <elements xsi:type="Grafcet:Transition" location="t012" name="ToB" condition="chooseB"/>
    <elements xsi:type="Grafcet:Transition" location="t013" name="Join" condition="bothDone"/>
    <elements xsi:type="Grafcet:Transition" location="t014" name="Complete" condition="mergedDone"/>
    <!-- Connections: branching from Init to two paths and then merging -->
    <connections xsi:type="Grafcet:StepToTransition" location="c010" name="initToStartSplit" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c011" name="startSplitToPathA" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c012" name="startSplitToPathB" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c013" name="pathAToJoin" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c014" name="pathBToJoin" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c015" name="joinToMerge" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c016" name="mergeToComplete" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c017" name="completeToFinal" from="/0/@elements.9" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>