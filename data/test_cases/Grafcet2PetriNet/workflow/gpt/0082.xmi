<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net_complex01" name="ParallelAndMergeSequence">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="StartUp" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="LoadConfig" isInitial="false" isActive="false" action="load"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="CheckSensors" isInitial="false" isActive="false" action="check"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="RunCycle" isInitial="false" isActive="false" action="run"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="ErrorState" isInitial="false" isActive="false" action="signalError"/>
    <elements xsi:type="Grafcet:Step" location="s006" name="Shutdown" isInitial="false" isActive="false" action="shutdown"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="StartLoaded" condition="configLoaded"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="StartChecked" condition="sensorsOk"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="MergeReady" condition="bothReady"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="FailureDetected" condition="errorRaised"/>
    <elements xsi:type="Grafcet:Transition" location="t005" name="StopRequested" condition="stopCommand"/>
    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToLoaded" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="startToChecked" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c003" name="loadToMerge" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="checkToMerge" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="runToFailure" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c006" name="runToStop" from="/0/@elements.3" to="/0/@elements.10"/>
    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="loadedToLoad" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c008" name="checkedToCheck" from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="mergeToRun" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c010" name="failureToError" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c011" name="stopToShutdown" from="/0/@elements.10" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>