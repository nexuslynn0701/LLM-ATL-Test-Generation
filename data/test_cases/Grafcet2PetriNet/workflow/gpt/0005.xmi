<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchingMergeCycle">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="PathA" isInitial="false" isActive="false" action="executeA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="PathB" isInitial="false" isActive="false" action="executeB"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Join" isInitial="false" isActive="false" action="merge"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="Final" isInitial="false" isActive="false" action="complete"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="Split" condition="startEvent"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="ToA" condition="chooseA"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="ToB" condition="chooseB"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="Merge" condition="pathsDone"/>
    <elements xsi:type="Grafcet:Transition" location="t005" name="LoopBack" condition="retry"/>

    <!-- Connections: index mapping of elements
         0: Start (Step)
         1: PathA (Step)
         2: PathB (Step)
         3: Join  (Step)
         4: Final (Step)
         5: Split (Transition)
         6: ToA   (Transition)
         7: ToB   (Transition)
         8: Merge (Transition)
         9: LoopBack (Transition)
    -->

    <!-- Start -> Split (single entry to branching) -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToSplit" from="/0/@elements.0" to="/0/@elements.5"/>

    <!-- Split -> ToA and Split -> ToB (fan-out from one transition to two transitions via steps) -->
    <!-- PathA branch -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="splitToPathA" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c003" name="pathAToToA" from="/0/@elements.1" to="/0/@elements.6"/>

    <!-- PathB branch -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c004" name="splitToPathB" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="pathBToToB" from="/0/@elements.2" to="/0/@elements.7"/>

    <!-- Both branches converge on Join via Merge transition -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="toAToJoin" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="toBToJoin" from="/0/@elements.7" to="/0/@elements.3"/>

    <!-- Join -> Merge -> Final (sequential end) -->
    <connections xsi:type="Grafcet:StepToTransition" location="c008" name="joinToMerge" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="mergeToFinal" from="/0/@elements.8" to="/0/@elements.4"/>

    <!-- Loop from Final back to Start (cycle) -->
    <connections xsi:type="Grafcet:StepToTransition" location="c010" name="finalToLoopBack" from="/0/@elements.4" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c011" name="loopBackToStart" from="/0/@elements.9" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>