<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchingAndMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="StartUp" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="ParallelA" isInitial="false" isActive="false" action="taskA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="ParallelB" isInitial="false" isActive="false" action="taskB"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="MergePoint" isInitial="false" isActive="false" action="mergeTasks"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="Completion" isInitial="false" isActive="false" action="finalize"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="StartBranch" condition="readyToBranch"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="AtoMerge" condition="Afinished"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="BtoMerge" condition="Bfinished"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="FinishProcess" condition="mergeComplete"/>

    <!-- Connections: branching from StartUp to ParallelA and ParallelB -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToBranch" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="branchToA" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="branchToB" from="/0/@elements.5" to="/0/@elements.2"/>

    <!-- Connections: from parallel steps to merge point via separate transitions -->
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="AstepToMergeTransition" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c005" name="mergeTransitionFromA" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c006" name="BstepToMergeTransition" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="mergeTransitionFromB" from="/0/@elements.7" to="/0/@elements.3"/>

    <!-- Connections: from merge point to completion -->
    <connections xsi:type="Grafcet:StepToTransition" location="c008" name="mergeToFinishTransition" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="finishToCompletion" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>