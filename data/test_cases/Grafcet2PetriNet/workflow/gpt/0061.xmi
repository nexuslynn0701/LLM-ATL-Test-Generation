<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net004" name="BranchingMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Init" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA" isInitial="false" isActive="false" action="doA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchB" isInitial="false" isActive="false" action="doB"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Join" isInitial="false" isActive="false" action="joinBranches"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="Split" condition="splitCondition"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="ToBranchA" condition="chooseA"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="ToBranchB" condition="chooseB"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="Merge" condition="bothDone"/>
    <!-- Connections: StepToTransition (Step -> Transition) -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="initToSplit" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="splitToA" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c003" name="splitToB" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="branchAToMerge" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="branchBToMerge" from="/0/@elements.2" to="/0/@elements.7"/>
    <!-- Connections: TransitionToStep (Transition -> Step) -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="splitToBranchA" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="splitToBranchB" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c008" name="toBranchAExec" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="toBranchBExec" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c010" name="mergeToJoin" from="/0/@elements.7" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>