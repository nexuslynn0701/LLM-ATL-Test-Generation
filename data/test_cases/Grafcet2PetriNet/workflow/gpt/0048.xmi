<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchMergeParallel">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="init"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="Fork" condition="begin"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA" isInitial="false" isActive="false" action="workA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchB" isInitial="false" isActive="false" action="workB"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="Join" condition="bothDone"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="End" isInitial="false" isActive="false" action="finish"/>
    <!-- Connections: indices: 0..5 as above -->
    <!-- Start -> Fork -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToFork" from="/0/@elements.0" to="/0/@elements.1"/>
    <!-- Fork -> BranchA -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="forkToA" from="/0/@elements.1" to="/0/@elements.2"/>
    <!-- Fork -> BranchB -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="forkToB" from="/0/@elements.1" to="/0/@elements.3"/>
    <!-- BranchA -> Join -->
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="aToJoin" from="/0/@elements.2" to="/0/@elements.4"/>
    <!-- BranchB -> Join -->
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="bToJoin" from="/0/@elements.3" to="/0/@elements.4"/>
    <!-- Join -> End -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="joinToEnd" from="/0/@elements.4" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>