<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="ParallelBranchesWithMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="StartUp" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA" isInitial="false" isActive="false" action="computeA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchB" isInitial="false" isActive="false" action="computeB"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Merged" isInitial="false" isActive="false" action="aggregate"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="Finalized" isInitial="false" isActive="false" action="shutdown"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="Split" condition="readyForParallel"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="JoinA" condition="branchADone"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="JoinB" condition="branchBDone"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="FinishAll" condition="allDone"/>
    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startupToSplit" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="branchAToJoinA" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c003" name="branchBToJoinB" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="mergedToFinish" from="/0/@elements.3" to="/0/@elements.8"/>
    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c005" name="splitToBranchA" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="splitToBranchB" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="joinAToMerged" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c008" name="joinBToMerged" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="finishToFinalized" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>