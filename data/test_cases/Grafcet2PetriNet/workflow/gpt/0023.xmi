<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="ParallelBranchesWithMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="StartUp" isInitial="true" isActive="true" action="init"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA" isInitial="false" isActive="false" action="executeA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchB" isInitial="false" isActive="false" action="executeB"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="SyncPoint" isInitial="false" isActive="false" action="sync"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="Shutdown" isInitial="false" isActive="false" action="cleanup"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="Split" condition="readyToSplit"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="ToBranchA" condition="routeA"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="ToBranchB" condition="routeB"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="JoinA" condition="branchAComplete"/>
    <elements xsi:type="Grafcet:Transition" location="t005" name="JoinB" condition="branchBComplete"/>
    <elements xsi:type="Grafcet:Transition" location="t006" name="Finish" condition="allDone"/>
    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToSplit" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="splitToBranchA" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c003" name="splitToBranchB" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="branchAToJoinA" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="branchBToJoinB" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c006" name="syncToFinish" from="/0/@elements.3" to="/0/@elements.10"/>
    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="splitToBranchAStep" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c008" name="splitToBranchBStep" from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="joinAToSync" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c010" name="joinBToSync" from="/0/@elements.9" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c011" name="finishToShutdown" from="/0/@elements.10" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>