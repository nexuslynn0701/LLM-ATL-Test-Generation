<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchingMerge">
    <!-- Elements: 4 Steps (2 initial, 2 non-initial) and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" location="s001" name="InitA" isInitial="true" isActive="true" action="startA"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="InitB" isInitial="true" isActive="false" action="startB"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="ToMiddleFromA" condition="aReady"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="ToMiddleFromB" condition="bReady"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="Middle" isInitial="false" isActive="false" action="merge"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="ToFinal" condition="done"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Final" isInitial="false" isActive="false" action="finish"/>

    <!-- Connections: branching from two initials to a common middle, then to final -->
    <!-- InitA -> ToMiddleFromA -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="initA_to_t1" from="/0/@elements.0" to="/0/@elements.2"/>
    <!-- InitB -> ToMiddleFromB -->
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="initB_to_t2" from="/0/@elements.1" to="/0/@elements.3"/>
    <!-- ToMiddleFromA -> Middle -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="t1_to_middle" from="/0/@elements.2" to="/0/@elements.4"/>
    <!-- ToMiddleFromB -> Middle (second incoming transition to same step) -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c004" name="t2_to_middle" from="/0/@elements.3" to="/0/@elements.4"/>
    <!-- Middle -> ToFinal -->
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="middle_to_t3" from="/0/@elements.4" to="/0/@elements.5"/>
    <!-- ToFinal -> Final -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="t3_to_final" from="/0/@elements.5" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>