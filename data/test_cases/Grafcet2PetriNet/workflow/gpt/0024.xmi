<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchingAndMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Init" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="PathA" isInitial="false" isActive="false" action="executeA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="PathB" isInitial="false" isActive="false" action="executeB"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Merge" isInitial="false" isActive="false" action="mergePaths"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="Final" isInitial="false" isActive="false" action="finalize"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="Split" condition="readyToSplit"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="JoinA" condition="pathAComplete"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="JoinB" condition="pathBComplete"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="Finish" condition="mergeComplete"/>

    <!-- Connections: branching from Init to PathA and PathB -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="initToSplit" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="splitToPathA" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="splitToPathB" from="/0/@elements.5" to="/0/@elements.2"/>

    <!-- PathA to Merge via JoinA -->
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="pathAToJoinA" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c005" name="joinAToMerge" from="/0/@elements.6" to="/0/@elements.3"/>

    <!-- PathB to Merge via JoinB -->
    <connections xsi:type="Grafcet:StepToTransition" location="c006" name="pathBToJoinB" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="joinBToMerge" from="/0/@elements.7" to="/0/@elements.3"/>

    <!-- Merge to Final via Finish -->
    <connections xsi:type="Grafcet:StepToTransition" location="c008" name="mergeToFinish" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="finishToFinal" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>