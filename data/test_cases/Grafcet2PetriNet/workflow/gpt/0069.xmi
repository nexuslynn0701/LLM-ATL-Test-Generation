<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="ParallelBranchesWithMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="StartUp" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="LoadConfig" isInitial="false" isActive="false" action="load"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="CheckSensors" isInitial="false" isActive="false" action="check"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="RunSystem" isInitial="false" isActive="false" action="run"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="ConfigReady" condition="configOk"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="SensorsReady" condition="sensorsOk"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="StartRun" condition="bothReady"/>
    <!-- Connections: from Steps to Transitions -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startupToConfig" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="startupToSensors" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c003" name="configToStartRun" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="sensorsToStartRun" from="/0/@elements.2" to="/0/@elements.6"/>
    <!-- Connections: from Transitions to Steps -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c005" name="configReadyToLoad" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="sensorsReadyToCheck" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="startRunToRunSystem" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>