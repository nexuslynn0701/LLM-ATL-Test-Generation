<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net004" name="BranchAndMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="init"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA" isInitial="false" isActive="false" action="doA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchB" isInitial="false" isActive="false" action="doB"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Join" isInitial="false" isActive="false" action="joinActions"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="End" isInitial="false" isActive="false" action="finish"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="Fork" condition="readyToBranch"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="ToA" condition="chooseA"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="ToB" condition="chooseB"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="Merge" condition="bothDone"/>
    <elements xsi:type="Grafcet:Transition" location="t005" name="Finish" condition="joined"/>

    <!-- Connections: Start -> Fork -> BranchA/BranchB -> Merge -> Join -> Finish -> End -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToFork" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="forkToBranchA" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="forkToBranchB" from="/0/@elements.5" to="/0/@elements.2"/>

    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="branchAToMerge" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="branchBToMerge" from="/0/@elements.2" to="/0/@elements.8"/>

    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="mergeToJoin" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c007" name="joinToFinish" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c008" name="finishToEnd" from="/0/@elements.9" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>