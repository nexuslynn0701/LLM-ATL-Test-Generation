<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net100" name="ParallelBranchesWithMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s100" name="Init" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s101" name="BranchA" isInitial="false" isActive="false" action="executeA"/>
    <elements xsi:type="Grafcet:Step" location="s102" name="BranchB" isInitial="false" isActive="false" action="executeB"/>
    <elements xsi:type="Grafcet:Step" location="s103" name="Join" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" location="s104" name="Finalize" isInitial="false" isActive="false" action="cleanup"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t100" name="StartBranches" condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" location="t101" name="CompleteA" condition="aDone"/>
    <elements xsi:type="Grafcet:Transition" location="t102" name="CompleteB" condition="bDone"/>
    <elements xsi:type="Grafcet:Transition" location="t103" name="FinishAll" condition="readyToFinish"/>

    <!-- Connections: Init -> StartBranches -> BranchA / BranchB -> CompleteA / CompleteB -> Join -> FinishAll -> Finalize -->
    <connections xsi:type="Grafcet:StepToTransition" location="c100" name="initToStartBranches" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c101" name="startBranchesToA" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c102" name="startBranchesToB" from="/0/@elements.5" to="/0/@elements.2"/>

    <connections xsi:type="Grafcet:StepToTransition" location="c103" name="branchAToCompleteA" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c104" name="branchBToCompleteB" from="/0/@elements.2" to="/0/@elements.7"/>

    <connections xsi:type="Grafcet:TransitionToStep" location="c105" name="completeAToJoin" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c106" name="completeBToJoin" from="/0/@elements.7" to="/0/@elements.3"/>

    <connections xsi:type="Grafcet:StepToTransition" location="c107" name="joinToFinishAll" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c108" name="finishAllToFinalize" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>