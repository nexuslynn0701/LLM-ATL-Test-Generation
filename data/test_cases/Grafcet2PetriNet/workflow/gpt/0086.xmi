<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net004" name="ParallelBranchesAndMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="init"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="Fork" condition="begin"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA1" isInitial="false" isActive="false" action="doA1"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchA2" isInitial="false" isActive="false" action="doA2"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="BranchB1" isInitial="false" isActive="false" action="doB1"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="BranchB2" isInitial="false" isActive="false" action="doB2"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="JoinA" condition="aDone"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="JoinB" condition="bDone"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="FinalJoin" condition="allDone"/>
    <elements xsi:type="Grafcet:Step" location="s006" name="End" isInitial="false" isActive="false" action="finish"/>

    <!-- Connections: Start -> Fork -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToFork" from="/0/@elements.0" to="/0/@elements.1"/>

    <!-- Fork -> Branch A steps -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="forkToBranchA1" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="forkToBranchA2" from="/0/@elements.1" to="/0/@elements.3"/>

    <!-- Branch A steps -> JoinA -->
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="branchA1ToJoinA" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="branchA2ToJoinA" from="/0/@elements.3" to="/0/@elements.6"/>

    <!-- Fork -> Branch B steps -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="forkToBranchB1" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="forkToBranchB2" from="/0/@elements.1" to="/0/@elements.5"/>

    <!-- Branch B steps -> JoinB -->
    <connections xsi:type="Grafcet:StepToTransition" location="c008" name="branchB1ToJoinB" from="/0/@elements.4" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c009" name="branchB2ToJoinB" from="/0/@elements.5" to="/0/@elements.7"/>

    <!-- Joins -> FinalJoin -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c010" name="joinAToFinalJoin" from="/0/@elements.6" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c011" name="joinBToFinalJoin" from="/0/@elements.7" to="/0/@elements.8"/>

    <!-- FinalJoin -> End -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c012" name="finalJoinToEnd" from="/0/@elements.8" to="/0/@elements.9"/>
  </Grafcet:Grafcet>
</xmi:XMI>