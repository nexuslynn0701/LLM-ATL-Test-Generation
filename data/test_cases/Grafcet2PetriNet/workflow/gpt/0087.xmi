<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchingMergeWithLoop">
    <elements xsi:type="Grafcet:Step" location="s010" name="StartUp" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" location="t010" name="BeginProcessing" condition="beginSignal"/>
    <elements xsi:type="Grafcet:Step" location="s011" name="LoadData" isInitial="false" isActive="false" action="load"/>
    <elements xsi:type="Grafcet:Step" location="s012" name="CheckConfig" isInitial="false" isActive="false" action="verify"/>
    <elements xsi:type="Grafcet:Transition" location="t011" name="DataAndConfigReady" condition="ready"/>
    <elements xsi:type="Grafcet:Step" location="s013" name="ProcessData" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" location="t012" name="ProcessingFailed" condition="errorDetected"/>
    <elements xsi:type="Grafcet:Transition" location="t013" name="ProcessingCompleted" condition="done"/>
    <elements xsi:type="Grafcet:Step" location="s014" name="Shutdown" isInitial="false" isActive="false" action="cleanup"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c010" name="startupToBegin" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c011" name="beginToLoad" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c012" name="beginToCheck" from="/0/@elements.1" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c013" name="loadToReady" from="/0/@elements.2" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c014" name="checkToReady" from="/0/@elements.3" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c015" name="readyToProcess" from="/0/@elements.4" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c016" name="processToFailed" from="/0/@elements.5" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c017" name="processToCompleted" from="/0/@elements.5" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c018" name="failedToStartup" from="/0/@elements.6" to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c019" name="completedToShutdown" from="/0/@elements.7" to="/0/@elements.8"/>
  </Grafcet:Grafcet>
</xmi:XMI>