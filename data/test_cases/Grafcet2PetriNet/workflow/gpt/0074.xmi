<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchingMergeCycle">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="PathA" isInitial="false" isActive="false" action="executeA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="PathB" isInitial="false" isActive="false" action="executeB"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Join" isInitial="false" isActive="false" action="mergePaths"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="End" isInitial="false" isActive="false" action="finalize"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="Split" condition="readyToBranch"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="AtoJoin" condition="pathAComplete"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="BtoJoin" condition="pathBComplete"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="JoinToEnd" condition="allPathsDone"/>
    <elements xsi:type="Grafcet:Transition" location="t005" name="Restart" condition="restartRequested"/>
    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToSplit" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="pathAToAJoin" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c003" name="pathBToBJoin" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="joinToJoinEnd" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="endToRestart" from="/0/@elements.4" to="/0/@elements.9"/>
    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="splitToPathA" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="splitToPathB" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c008" name="aJoinToJoin" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="bJoinToJoin" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c010" name="joinEndToEnd" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c011" name="restartToStart" from="/0/@elements.9" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>