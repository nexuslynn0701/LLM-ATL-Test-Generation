<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchingAndMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="StartUp" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="LoadConfig" isInitial="false" isActive="false" action="loadConfig"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="SafetyCheck" isInitial="false" isActive="false" action="checkSafety"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="RunParallelA" isInitial="false" isActive="false" action="runA"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="RunParallelB" isInitial="false" isActive="false" action="runB"/>
    <elements xsi:type="Grafcet:Step" location="s006" name="MergeResults" isInitial="false" isActive="false" action="merge"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="StartupComplete" condition="startupDone"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="ConfigLoaded" condition="configReady"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="SafetyOk" condition="safetyPassed"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="BranchToA" condition="pathA"/>
    <elements xsi:type="Grafcet:Transition" location="t005" name="BranchToB" condition="pathB"/>
    <elements xsi:type="Grafcet:Transition" location="t006" name="AFinished" condition="doneA"/>
    <elements xsi:type="Grafcet:Transition" location="t007" name="BFinished" condition="doneB"/>
    <elements xsi:type="Grafcet:Transition" location="t008" name="AllMerged" condition="mergeDone"/>
    <!-- Connections: linear startup -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToStartupComplete" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="startupCompleteToLoadConfig" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c003" name="loadConfigToConfigLoaded" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c004" name="configLoadedToSafetyCheck" from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="safetyCheckToSafetyOk" from="/0/@elements.2" to="/0/@elements.8"/>
    <!-- Branching to parallel paths -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="safetyOkToRunParallelA" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="safetyOkToRunParallelB" from="/0/@elements.8" to="/0/@elements.4"/>
    <!-- Internal transitions within branches -->
    <connections xsi:type="Grafcet:StepToTransition" location="c008" name="runParallelAToAFinished" from="/0/@elements.3" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c009" name="runParallelBToBFinished" from="/0/@elements.4" to="/0/@elements.12"/>
    <!-- Merge from both branches -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c010" name="aFinishedToMergeResults" from="/0/@elements.11" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c011" name="bFinishedToMergeResults" from="/0/@elements.12" to="/0/@elements.5"/>
    <!-- Final transition after merge -->
    <connections xsi:type="Grafcet:StepToTransition" location="c012" name="mergeResultsToAllMerged" from="/0/@elements.5" to="/0/@elements.13"/>
    <!-- Loop back to StartUp to exercise cycle -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c013" name="allMergedToStartUp" from="/0/@elements.13" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>