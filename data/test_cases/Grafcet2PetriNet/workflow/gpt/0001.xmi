<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchingMergeScenario">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="StartUp" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="LoadConfig" isInitial="false" isActive="false" action="load"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="CheckSensors" isInitial="false" isActive="false" action="check"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="RunSystem" isInitial="false" isActive="false" action="run"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="Shutdown" isInitial="false" isActive="false" action="shutdown"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="ConfigLoaded" condition="configReady"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="SensorsOk" condition="sensorsReady"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="StartRun" condition="readyToRun"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="StopRun" condition="stopRequested"/>
    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startupToConfigLoaded" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="startupToSensorsOk" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c003" name="loadConfigToStartRun" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="checkSensorsToStartRun" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="runSystemToStopRun" from="/0/@elements.3" to="/0/@elements.8"/>
    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="configLoadedToLoadConfig" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="sensorsOkToCheckSensors" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c008" name="startRunToRunSystem" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="stopRunToShutdown" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>