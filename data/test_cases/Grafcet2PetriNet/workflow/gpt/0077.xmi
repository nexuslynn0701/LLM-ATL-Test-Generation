<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net004" name="ParallelBranches">
    <!-- Elements: 4 Steps (2 initial) and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" location="s001" name="InitA" isInitial="true" isActive="true" action="startA"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="InitB" isInitial="true" isActive="false" action="startB"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="Fork" condition="bothReady"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="Branch1" isInitial="false" isActive="false" action="runBranch1"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Branch2" isInitial="false" isActive="false" action="runBranch2"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="Join" condition="branchesDone"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="Reset" condition="resetSignal"/>

    <!-- Connections: mix of fan-in, fan-out, and a small cycle -->
    <!-- InitA -> Fork -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="initAToFork" from="/0/@elements.0" to="/0/@elements.2"/>
    <!-- InitB -> Fork -->
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="initBToFork" from="/0/@elements.1" to="/0/@elements.2"/>
    <!-- Fork -> Branch1 -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="forkToBranch1" from="/0/@elements.2" to="/0/@elements.3"/>
    <!-- Fork -> Branch2 -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c004" name="forkToBranch2" from="/0/@elements.2" to="/0/@elements.4"/>
    <!-- Branch1 -> Join -->
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="branch1ToJoin" from="/0/@elements.3" to="/0/@elements.5"/>
    <!-- Branch2 -> Join -->
    <connections xsi:type="Grafcet:StepToTransition" location="c006" name="branch2ToJoin" from="/0/@elements.4" to="/0/@elements.5"/>
    <!-- Join -> InitA (cycle back) -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="joinToInitA" from="/0/@elements.5" to="/0/@elements.0"/>
    <!-- InitA -> Reset (second outgoing from same step) -->
    <connections xsi:type="Grafcet:StepToTransition" location="c008" name="initAToReset" from="/0/@elements.0" to="/0/@elements.6"/>
    <!-- Reset -> InitB (alternative cycle) -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="resetToInitB" from="/0/@elements.6" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>