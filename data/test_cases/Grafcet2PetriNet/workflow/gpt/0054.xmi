<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="BranchingMergeCycle">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="init"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="PathA" isInitial="false" isActive="false" action="doA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="PathB" isInitial="false" isActive="false" action="doB"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Merge" isInitial="false" isActive="false" action="join"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="End" isInitial="false" isActive="false" action="finish"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="Split" condition="startEvent"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="AtoMerge" condition="aDone"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="BtoMerge" condition="bDone"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="MergeToEnd" condition="readyToFinish"/>
    <elements xsi:type="Grafcet:Transition" location="t005" name="Restart" condition="restartSignal"/>
    <!-- Connections: branching, merging, and cycle back to Start -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToSplit" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="splitToPathA" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="splitToPathB" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="pathAToMergeTransition" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="pathBToMergeTransition" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="AtransitionToMergeStep" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="BtransitionToMergeStep" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c008" name="mergeToEndTransition" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="endTransitionToEndStep" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c010" name="endToRestart" from="/0/@elements.4" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c011" name="restartToStart" from="/0/@elements.9" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>