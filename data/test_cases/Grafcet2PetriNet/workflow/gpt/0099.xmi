<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="ForkJoinWithLoop">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA" isInitial="false" isActive="false" action="taskA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchB" isInitial="false" isActive="false" action="taskB"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Join" isInitial="false" isActive="false" action="synchronize"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="LoopBody" isInitial="false" isActive="false" action="iterate"/>
    <elements xsi:type="Grafcet:Step" location="s006" name="End" isInitial="false" isActive="false" action="finalize"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t001" name="Fork" condition="startFork"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="AtoJoin" condition="aDone"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="BtoJoin" condition="bDone"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="JoinToLoop" condition="joined"/>
    <elements xsi:type="Grafcet:Transition" location="t005" name="LoopRepeat" condition="repeat"/>
    <elements xsi:type="Grafcet:Transition" location="t006" name="LoopExit" condition="exit"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToFork" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="branchAToJoin" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c003" name="branchBToJoin" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="joinToLoopTrans" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="loopBodyToRepeat" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c006" name="loopBodyToExit" from="/0/@elements.4" to="/0/@elements.11"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="forkToBranchA" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c008" name="forkToBranchB" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="aJoinToJoinStep" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c010" name="bJoinToJoinStep" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c011" name="joinToLoopBody" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c012" name="loopRepeatToLoopBody" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c013" name="loopExitToEnd" from="/0/@elements.11" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>