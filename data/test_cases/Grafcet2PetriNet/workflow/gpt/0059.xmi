<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net010" name="ParallelBranchesWithMerge">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" location="s100" name="Init" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" location="s101" name="BranchA" isInitial="false" isActive="false" action="computeA"/>
    <elements xsi:type="Grafcet:Step" location="s102" name="BranchB" isInitial="false" isActive="false" action="computeB"/>
    <elements xsi:type="Grafcet:Step" location="s103" name="Merge" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" location="s104" name="Final" isInitial="false" isActive="false" action="finalize"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" location="t100" name="Fork" condition="startParallel"/>
    <elements xsi:type="Grafcet:Transition" location="t101" name="JoinA" condition="aDone"/>
    <elements xsi:type="Grafcet:Transition" location="t102" name="JoinB" condition="bDone"/>
    <elements xsi:type="Grafcet:Transition" location="t103" name="Finish" condition="merged"/>

    <!-- Connections: StepToTransition -->
    <!-- Init -> Fork -->
    <connections xsi:type="Grafcet:StepToTransition" location="c200" name="initToFork" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- BranchA -> JoinA -->
    <connections xsi:type="Grafcet:StepToTransition" location="c201" name="branchAToJoinA" from="/0/@elements.1" to="/0/@elements.6"/>
    <!-- BranchB -> JoinB -->
    <connections xsi:type="Grafcet:StepToTransition" location="c202" name="branchBToJoinB" from="/0/@elements.2" to="/0/@elements.7"/>
    <!-- Merge -> Finish -->
    <connections xsi:type="Grafcet:StepToTransition" location="c203" name="mergeToFinish" from="/0/@elements.3" to="/0/@elements.8"/>

    <!-- Connections: TransitionToStep -->
    <!-- Fork -> BranchA -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c204" name="forkToBranchA" from="/0/@elements.5" to="/0/@elements.1"/>
    <!-- Fork -> BranchB -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c205" name="forkToBranchB" from="/0/@elements.5" to="/0/@elements.2"/>
    <!-- JoinA -> Merge -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c206" name="joinAToMerge" from="/0/@elements.6" to="/0/@elements.3"/>
    <!-- JoinB -> Merge -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c207" name="joinBToMerge" from="/0/@elements.7" to="/0/@elements.3"/>
    <!-- Finish -> Final -->
    <connections xsi:type="Grafcet:TransitionToStep" location="c208" name="finishToFinal" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>