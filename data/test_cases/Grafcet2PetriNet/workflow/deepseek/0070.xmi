<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net004" name="ParallelBranches">
    <elements xsi:type="Grafcet:Step" location="s001" name="Init" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="Start" condition="ready"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA" isInitial="false" isActive="false" action="processA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchB" isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="Join" condition="bothDone"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Final" isInitial="false" isActive="false" action="complete"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="initToStart" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="startToBranchA" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="startToBranchB" from="/0/@elements.1" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="branchAToJoin" from="/0/@elements.2" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="branchBToJoin" from="/0/@elements.3" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="joinToFinal" from="/0/@elements.4" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>