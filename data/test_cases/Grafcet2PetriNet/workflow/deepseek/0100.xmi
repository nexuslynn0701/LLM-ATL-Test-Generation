<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net004" name="BranchingConvergence">
    <elements xsi:type="Grafcet:Step" location="s001" name="Init" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="T1" condition="cond1"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA" isInitial="false" isActive="false" action="processA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchB" isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="T2" condition="cond2"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="T3" condition="cond3"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="Merge" isInitial="false" isActive="false" action="merge"/>
    <elements xsi:type="Grafcet:Transition" location="t004" name="T4" condition="cond4"/>
    <elements xsi:type="Grafcet:Step" location="s005" name="Final" isInitial="false" isActive="false" action="finish"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="initToT1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="t1ToBranchA" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="t1ToBranchB" from="/0/@elements.1" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="branchAToT2" from="/0/@elements.2" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="branchBToT3" from="/0/@elements.3" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c006" name="t2ToMerge" from="/0/@elements.4" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="t3ToMerge" from="/0/@elements.5" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c008" name="mergeToT4" from="/0/@elements.6" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c009" name="t4ToFinal" from="/0/@elements.7" to="/0/@elements.8"/>
  </Grafcet:Grafcet>
</xmi:XMI>