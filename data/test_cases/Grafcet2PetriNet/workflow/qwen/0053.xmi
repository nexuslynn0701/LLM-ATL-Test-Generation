<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net004" name="BranchingScenario">
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="init"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="CheckA" condition="condA"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="CheckB" condition="condB"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="PathA" isInitial="false" isActive="false" action="doA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="PathB" isInitial="false" isActive="false" action="doB"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="Merge" condition="true"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="End" isInitial="false" isActive="false" action="finish"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToCheckA" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="startToCheckB" from="/0/@elements.0" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="checkAToPathA" from="/0/@elements.1" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c004" name="checkBToPathB" from="/0/@elements.2" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="pathAToMerge" from="/0/@elements.3" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c006" name="pathBToMerge" from="/0/@elements.4" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="mergeToEnd" from="/0/@elements.5" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>