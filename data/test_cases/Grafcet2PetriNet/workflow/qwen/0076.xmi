<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net004" name="BranchingScenario">
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="init"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="Check" condition="validInput"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="Success" isInitial="false" isActive="false" action="proceed"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="Failure" isInitial="false" isActive="false" action="abort"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="Retry" condition="retryAllowed"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToCheck" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="checkToSuccess" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="checkToFailure" from="/0/@elements.1" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c004" name="failureToRetry" from="/0/@elements.3" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c005" name="retryToStart" from="/0/@elements.4" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>