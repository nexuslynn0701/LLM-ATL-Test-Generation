<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net004" name="BranchingAndMerging">
    <elements xsi:type="Grafcet:Step" location="s001" name="Start" isInitial="true" isActive="true" action="init"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="CondA" condition="condA"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="CondB" condition="condB"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="BranchA" isInitial="false" isActive="false" action="doA"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="BranchB" isInitial="false" isActive="false" action="doB"/>
    <elements xsi:type="Grafcet:Transition" location="t003" name="Sync" condition="syncReady"/>
    <elements xsi:type="Grafcet:Step" location="s004" name="End" isInitial="false" isActive="false" action="finish"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="startToCondA" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c002" name="startToCondB" from="/0/@elements.0" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c003" name="condAToBranchA" from="/0/@elements.1" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c004" name="condBToBranchB" from="/0/@elements.2" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c005" name="branchAToSync" from="/0/@elements.3" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c006" name="branchBToSync" from="/0/@elements.4" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c007" name="syncToEnd" from="/0/@elements.5" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>