<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="loc_net0" name="PetriNetFromGrafcet">
    <elements xsi:type="Grafcet:Step" location="loc_s0" name="InitialStep" isInitial="true" isActive="true" action="StartProcess"/>
    <elements xsi:type="Grafcet:Step" location="loc_s1" name="ProcessingStep" isInitial="false" isActive="false" action="ProcessData"/>
    <elements xsi:type="Grafcet:Step" location="loc_s2" name="FinalStep" isInitial="false" isActive="false" action="Complete"/>
    <elements xsi:type="Grafcet:Transition" location="loc_t0" name="T0" condition="Ready"/>
    <elements xsi:type="Grafcet:Transition" location="loc_t1" name="T1" condition="DataProcessed"/>
    <elements xsi:type="Grafcet:Transition" location="loc_t2" name="T2" condition="Finished"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc_stt0" name="STT0" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc_tts0" name="TTS0" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc_stt1" name="STT1" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc_tts1" name="TTS1" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc_stt2" name="STT2" from="/0/@elements.2" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc_tts2" name="TTS2" from="/0/@elements.5" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>