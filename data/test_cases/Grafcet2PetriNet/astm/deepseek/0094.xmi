<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="loc_G0" name="G0">
    <elements xsi:type="Grafcet:Step" location="loc_S1" name="S1" isInitial="true" isActive="true" action="StartProcess"/>
    <elements xsi:type="Grafcet:Step" location="loc_S2" name="S2" isInitial="false" isActive="false" action="ProcessData"/>
    <elements xsi:type="Grafcet:Step" location="loc_S3" name="S3" isInitial="false" isActive="false" action="EndProcess"/>
    <elements xsi:type="Grafcet:Transition" location="loc_T1" name="T1" condition="Sensor1_ON"/>
    <elements xsi:type="Grafcet:Transition" location="loc_T2" name="T2" condition="Sensor2_ON"/>
    <elements xsi:type="Grafcet:Transition" location="loc_T3" name="T3" condition="Timer_Done"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc_ST1" name="ST1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc_ST2" name="ST2" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc_ST3" name="ST3" from="/0/@elements.2" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc_TS1" name="TS1" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc_TS2" name="TS2" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc_TS3" name="TS3" from="/0/@elements.5" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>