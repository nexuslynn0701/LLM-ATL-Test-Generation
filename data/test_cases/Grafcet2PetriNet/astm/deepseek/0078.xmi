<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="loc0" name="TestGrafcet">
    <elements xsi:type="Grafcet:Step" location="loc1" name="InitialStep" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Step" location="loc2" name="Step1" isInitial="false" isActive="false" action="Process"/>
    <elements xsi:type="Grafcet:Step" location="loc3" name="Step2" isInitial="false" isActive="false" action="Finalize"/>
    <elements xsi:type="Grafcet:Transition" location="loc4" name="T1" condition="X1"/>
    <elements xsi:type="Grafcet:Transition" location="loc5" name="T2" condition="X2"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc6" name="C1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc7" name="C2" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc8" name="C3" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc9" name="C4" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>