<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0070" location="file://test_0070.gfc">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="file://test_0070.gfc#StartStep" isInitial="true" isActive="false" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="file://test_0070.gfc#T1" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="file://test_0070.gfc#MiddleStep" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="file://test_0070.gfc#T2" condition="y == true"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="file://test_0070.gfc#EndStep" isInitial="false" isActive="false" action="finalize"/>
    
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_Start_T1" location="file://test_0070.gfc#Conn_Start_T1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T1_Middle" location="file://test_0070.gfc#Conn_T1_Middle" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_Middle_T2" location="file://test_0070.gfc#Conn_Middle_T2" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T2_End" location="file://test_0070.gfc#Conn_T2_End" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>