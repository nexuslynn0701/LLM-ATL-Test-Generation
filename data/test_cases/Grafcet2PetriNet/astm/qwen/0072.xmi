<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet72" location="loc_main">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="loc_step1" isInitial="true" isActive="false" action="start_action"/>
    <elements xsi:type="Grafcet:Transition" name="Trans1" location="loc_trans1" condition="cond1"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="loc_step2" isInitial="false" isActive="true" action="middle_action"/>
    <elements xsi:type="Grafcet:Transition" name="Trans2" location="loc_trans2" condition="cond2"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="loc_step3" isInitial="false" isActive="false" action="end_action"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn1" location="loc_conn1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn2" location="loc_conn2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn3" location="loc_conn3" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn4" location="loc_conn4" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>