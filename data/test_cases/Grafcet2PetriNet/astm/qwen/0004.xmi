<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet4" location="file://test4.gfc">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="file://test4.gfc#start" isInitial="true" isActive="false" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="file://test4.gfc#t1" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="file://test4.gfc#middle" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="file://test4.gfc#t2" condition="y == 1"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="file://test4.gfc#end" isInitial="false" isActive="false" action="finalize"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="file://test4.gfc#c1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C2" location="file://test4.gfc#c2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C3" location="file://test4.gfc#c3" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C4" location="file://test4.gfc#c4" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>