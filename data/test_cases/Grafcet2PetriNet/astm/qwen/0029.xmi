<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0029" location="file://test0029.grafcet">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="file://test0029.grafcet#InitialStep" isInitial="true" isActive="false" action="start_process"/>
    <elements xsi:type="Grafcet:Transition" name="Trans1" location="file://test0029.grafcet#Trans1" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="file://test0029.grafcet#MiddleStep" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Transition" name="Trans2" location="file://test0029.grafcet#Trans2" condition="y == true"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="file://test0029.grafcet#FinalStep" isInitial="false" isActive="false" action="end_process"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn1" location="file://test0029.grafcet#Conn1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn2" location="file://test0029.grafcet#Conn2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn3" location="file://test0029.grafcet#Conn3" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn4" location="file://test0029.grafcet#Conn4" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>