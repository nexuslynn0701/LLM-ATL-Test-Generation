<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet61" location="file://test61.gf">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="file://test61.gf#start" isInitial="true" isActive="false" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="file://test61.gf#t1" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="file://test61.gf#middle" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="file://test61.gf#t2" condition="y == true"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="file://test61.gf#end" isInitial="false" isActive="false" action="finalize"/>
    
    <connections xsi:type="Grafcet:StepToTransition" name="Conn1" location="file://test61.gf#conn1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn2" location="file://test61.gf#conn2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn3" location="file://test61.gf#conn3" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn4" location="file://test61.gf#conn4" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>