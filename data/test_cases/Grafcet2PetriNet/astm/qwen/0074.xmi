<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="main.grafcet" name="TestGrafcet0074">
    <elements xsi:type="Grafcet:Step" location="step1.loc" name="InitialStep" isInitial="true" isActive="false" action="start"/>
    <elements xsi:type="Grafcet:Transition" location="trans1.loc" name="CondTrans" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" location="step2.loc" name="FinalStep" isInitial="false" isActive="false" action="finish"/>
    <connections xsi:type="Grafcet:StepToTransition" location="conn1.loc" name="Step1ToTrans1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="conn2.loc" name="Trans1ToStep2" from="/0/@elements.1" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>