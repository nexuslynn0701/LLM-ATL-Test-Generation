<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0100" location="file://test_0100.grafcet">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="file://test_0100.grafcet#StartStep" isInitial="true" isActive="false" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="file://test_0100.grafcet#T1" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="ProcessStep" location="file://test_0100.grafcet#ProcessStep" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="file://test_0100.grafcet#T2" condition="y == 1"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="file://test_0100.grafcet#EndStep" isInitial="false" isActive="false" action="finalize"/>
    
    <connections xsi:type="Grafcet:StepToTransition" name="StartToT1" location="file://test_0100.grafcet#StartToT1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T1ToProcess" location="file://test_0100.grafcet#T1ToProcess" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="ProcessToT2" location="file://test_0100.grafcet#ProcessToT2" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T2ToEnd" location="file://test_0100.grafcet#T2ToEnd" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>