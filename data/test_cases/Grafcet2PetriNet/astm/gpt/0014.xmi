<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file://grafcet/test14.gra#/" name="ProductionLine">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="file://grafcet/test14.gra#/s0" name="InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="file://grafcet/test14.gra#/s1" name="LoadStep" isInitial="false" isActive="false" action="load_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="file://grafcet/test14.gra#/s2" name="ProcessStep" isInitial="false" isActive="false" action="process_batch"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="file://grafcet/test14.gra#/s3" name="UnloadStep" isInitial="false" isActive="false" action="unload_material"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="file://grafcet/test14.gra#/t0" name="T_Init_Load" condition="start_button_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="file://grafcet/test14.gra#/t1" name="T_Load_Process" condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="file://grafcet/test14.gra#/t2" name="T_Process_Unload" condition="batch_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="file://grafcet/test14.gra#/t3" name="T_Unload_Init" condition="reset_cycle"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="file://grafcet/test14.gra#/c0" name="ST_Init_To_T0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" location="file://grafcet/test14.gra#/c1" name="TS_T0_To_Load" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="file://grafcet/test14.gra#/c2" name="ST_Load_To_T1" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" location="file://grafcet/test14.gra#/c3" name="TS_T1_To_Process" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" location="file://grafcet/test14.gra#/c4" name="ST_Process_To_T2" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="file://grafcet/test14.gra#/c5" name="TS_T2_To_Unload" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" location="file://grafcet/test14.gra#/c6" name="ST_Unload_To_T3" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="file://grafcet/test14.gra#/c7" name="TS_T3_To_Init" from="/0/@elements.7" to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" location="file://grafcet/test14.gra#/c8" name="ST_Init_To_T1_Alt" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" location="file://grafcet/test14.gra#/c9" name="TS_T1_To_Unload_Alt" from="/0/@elements.5" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
