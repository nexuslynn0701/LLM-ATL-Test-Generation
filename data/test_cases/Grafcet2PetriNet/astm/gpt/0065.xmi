<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="(0,0)">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="(10,10)" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ProcessingStep" location="(20,10)" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="FinalStep" location="(30,10)" isInitial="false" isActive="false" action="finalize"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToProc" location="(15,15)" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_ProcLoop" location="(25,15)" condition="loop_condition"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_ProcToFinal" location="(35,15)" condition="done"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_InitToT0" location="(12,12)" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="C_T0ToProc" location="(18,12)" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_ProcToT1" location="(22,12)" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="C_T1ToProc" location="(24,18)" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_ProcToT2" location="(28,12)" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_T2ToFinal" location="(32,12)" from="/0/@elements.5" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>