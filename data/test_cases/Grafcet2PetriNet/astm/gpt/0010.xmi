<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file:/model/grafcet10" name="ComplexGrafcet">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="file:/model/grafcet10#S0" name="InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="file:/model/grafcet10#S1" name="CheckSensors" isInitial="false" isActive="false" action="check_sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="file:/model/grafcet10#S2" name="ProcessData" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="file:/model/grafcet10#S3" name="ErrorHandler" isInitial="false" isActive="false" action="handle_error"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="file:/model/grafcet10#T0" name="T_InitToCheck" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="file:/model/grafcet10#T1" name="T_CheckToProcess" condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="file:/model/grafcet10#T2" name="T_CheckToError" condition="sensors_fail"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="file:/model/grafcet10#T3" name="T_ProcessToError" condition="processing_fail"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" location="file:/model/grafcet10#T4" name="T_ErrorToInit" condition="reset_received"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="file:/model/grafcet10#C0" name="C_Init_to_T0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" location="file:/model/grafcet10#C1" name="C_T0_to_S1" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="file:/model/grafcet10#C2" name="C_S1_to_T1" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" location="file:/model/grafcet10#C3" name="C_T1_to_S2" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" location="file:/model/grafcet10#C4" name="C_S1_to_T2" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="file:/model/grafcet10#C5" name="C_T2_to_S3" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" location="file:/model/grafcet10#C6" name="C_S2_to_T3" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="file:/model/grafcet10#C7" name="C_T3_to_S3" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" location="file:/model/grafcet10#C8" name="C_S3_to_T4" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" location="file:/model/grafcet10#C9" name="C_T4_to_S0" from="/0/@elements.8" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>