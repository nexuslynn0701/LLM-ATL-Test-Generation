<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file:/models/grafcet_example_0005.grafcet" name="ComplexGrafcet0005">
    <!-- Elements: 3 Steps + 2 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="(10,10)" name="InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="(30,10)" name="ProcessingStep" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="(50,10)" name="FinalStep" isInitial="false" isActive="false" action="shutdownSystem"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="(20,5)" name="T_Init_to_Proc" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="(40,5)" name="T_Proc_to_Final" condition="processingCompleted"/>
    <!-- Connections: chain with a branch back and a self-loop -->
    <!-- s1 -> t1, t1 -> s2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" location="(15,8)" name="C_s1_t1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" location="(25,8)" name="C_t1_s2" from="/0/@elements.3" to="/0/@elements.1"/>
    <!-- s2 -> t2, t2 -> s3 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" location="(35,8)" name="C_s2_t2" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" location="(45,8)" name="C_t2_s3" from="/0/@elements.4" to="/0/@elements.2"/>
    <!-- branch back: s2 -> t1 forming a reconverging structure -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" location="(28,7)" name="C_s2_t1" from="/0/@elements.1" to="/0/@elements.3"/>
    <!-- self-loop on s2 via t2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" location="(38,6)" name="C_s2_t2_loop" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="(42,6)" name="C_t2_s2_loop" from="/0/@elements.4" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>