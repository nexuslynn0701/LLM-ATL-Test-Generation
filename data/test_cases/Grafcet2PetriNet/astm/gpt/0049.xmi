<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="model.grafcet#/" name="ComplexFlow">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="model.grafcet#/s0" name="InitStep" isInitial="true" isActive="true" action="initSystem()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="model.grafcet#/s1" name="BranchA_Step1" isInitial="false" isActive="false" action="doA1()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="model.grafcet#/s2" name="BranchA_Step2" isInitial="false" isActive="false" action="doA2()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="model.grafcet#/s3" name="BranchB_Step1" isInitial="false" isActive="false" action="doB1()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" location="model.grafcet#/s4" name="MergeStep" isInitial="false" isActive="false" action="mergeBranches()"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="model.grafcet#/t0" name="SplitTransition" condition="readyToSplit"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="model.grafcet#/t1" name="BranchA_Trans1" condition="condA1"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="model.grafcet#/t2" name="BranchA_Trans2" condition="condA2"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="model.grafcet#/t3" name="BranchB_Trans1" condition="condB1"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" location="model.grafcet#/t4" name="JoinTransition" condition="joinAllowed"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="model.grafcet#/c0" name="Init_to_Split" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" location="model.grafcet#/c1" name="Split_to_A1" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" location="model.grafcet#/c2" name="Split_to_B1" from="/0/@elements.5" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" location="model.grafcet#/c3" name="A1_to_T1" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" location="model.grafcet#/c4" name="T1_to_A2" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" location="model.grafcet#/c5" name="A2_to_T2" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" location="model.grafcet#/c6" name="T2_to_Merge" from="/0/@elements.7" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" location="model.grafcet#/c7" name="B1_to_T3" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" location="model.grafcet#/c8" name="T3_to_Merge" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c9" location="model.grafcet#/c9" name="Merge_to_Join" from="/0/@elements.4" to="/0/@elements.9"/>
  </Grafcet:Grafcet>
</xmi:XMI>