<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" location="file:///models/grafcet0034.gcf" name="ProductionLineControl">
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" location="file:///models/grafcet0034.gcf#S0" name="Idle" isInitial="true" isActive="true" action="waitForStartSignal"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" location="file:///models/grafcet0034.gcf#S1" name="LoadMaterial" isInitial="false" isActive="false" action="activateLoader"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" location="file:///models/grafcet0034.gcf#S2" name="Assemble" isInitial="false" isActive="false" action="runAssemblyStation"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" location="file:///models/grafcet0034.gcf#S3" name="QualityCheck" isInitial="false" isActive="false" action="startInspection"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" location="file:///models/grafcet0034.gcf#S4" name="Unload" isInitial="false" isActive="false" action="activateUnloader"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" location="file:///models/grafcet0034.gcf#T0" name="t_start" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" location="file:///models/grafcet0034.gcf#T1" name="t_loaded" condition="materialAtStation"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" location="file:///models/grafcet0034.gcf#T2" name="t_assembled" condition="assemblyComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" location="file:///models/grafcet0034.gcf#T3" name="t_checked" condition="qualityOk"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" location="file:///models/grafcet0034.gcf#T4" name="t_reject" condition="qualityFault"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T5" location="file:///models/grafcet0034.gcf#T5" name="t_unloaded" condition="unloadComplete"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" location="file:///models/grafcet0034.gcf#C0" name="Idle_to_start" grafcet="/0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" location="file:///models/grafcet0034.gcf#C1" name="start_to_LoadMaterial" grafcet="/0" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" location="file:///models/grafcet0034.gcf#C2" name="LoadMaterial_to_loaded" grafcet="/0" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C3" location="file:///models/grafcet0034.gcf#C3" name="loaded_to_Assemble" grafcet="/0" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" location="file:///models/grafcet0034.gcf#C4" name="Assemble_to_assembled" grafcet="/0" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" location="file:///models/grafcet0034.gcf#C5" name="assembled_to_QualityCheck" grafcet="/0" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" location="file:///models/grafcet0034.gcf#C6" name="QualityCheck_to_checked" grafcet="/0" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" location="file:///models/grafcet0034.gcf#C7" name="checked_to_Unload" grafcet="/0" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C8" location="file:///models/grafcet0034.gcf#C8" name="QualityCheck_to_reject" grafcet="/0" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C9" location="file:///models/grafcet0034.gcf#C9" name="reject_to_Idle" grafcet="/0" from="/0/@elements.9" to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C10" location="file:///models/grafcet0034.gcf#C10" name="Unload_to_unloaded" grafcet="/0" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C11" location="file:///models/grafcet0034.gcf#C11" name="unloaded_to_Idle" grafcet="/0" from="/0/@elements.10" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>