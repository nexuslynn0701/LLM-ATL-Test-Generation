<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" location="loc_grafcet_0036" name="ComplexGrafcet0036">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="loc_step_s0_0036" name="InitialStepA" isInitial="true" isActive="true" action="initA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="loc_step_s1_0036" name="IntermediateStepB" isInitial="false" isActive="false" action="computeB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="loc_step_s2_0036" name="BranchStepC" isInitial="false" isActive="false" action="branchC"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="loc_step_s3_0036" name="MergeStepD" isInitial="false" isActive="false" action="mergeD"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" location="loc_step_s4_0036" name="FinalStepE" isInitial="false" isActive="false" action="finalE"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="loc_trans_t0_0036" name="T_A_to_B" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="loc_trans_t1_0036" name="T_B_to_C" condition="y = 1"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="loc_trans_t2_0036" name="T_C_to_D" condition="z &lt; 5"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="loc_trans_t3_0036" name="T_D_to_E" condition="w = true"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 location="loc_conn_c0_0036"
                 name="S0_to_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 location="loc_conn_c1_0036"
                 name="S1_to_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 location="loc_conn_c2_0036"
                 name="S2_to_T2"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 location="loc_conn_c3_0036"
                 name="S3_to_T3"
                 from="/0/@elements.3"
                 to="/0/@elements.8"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 location="loc_conn_c4_0036"
                 name="T0_to_S1"
                 from="/0/@elements.5"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 location="loc_conn_c5_0036"
                 name="T1_to_S2"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 location="loc_conn_c6_0036"
                 name="T2_to_S3"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 location="loc_conn_c7_0036"
                 name="T3_to_S4"
                 from="/0/@elements.8"
                 to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>