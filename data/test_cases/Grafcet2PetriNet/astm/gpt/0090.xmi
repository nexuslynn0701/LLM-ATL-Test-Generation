<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file.grafcet#/" name="ComplexGrafcet0090">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="file.grafcet#/s0" name="InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="file.grafcet#/s1" name="LoadConfig" isInitial="false" isActive="false" action="loadConfiguration"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="file.grafcet#/s2" name="ValidateData" isInitial="false" isActive="false" action="validateInput"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="file.grafcet#/s3" name="ProcessA" isInitial="false" isActive="false" action="processBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" location="file.grafcet#/s4" name="ProcessB" isInitial="false" isActive="false" action="processBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" location="file.grafcet#/s5" name="MergeStep" isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" location="file.grafcet#/s6" name="FinalStep" isInitial="false" isActive="false" action="shutdownSystem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="file.grafcet#/t0" name="T_InitToLoad" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="file.grafcet#/t1" name="T_LoadToValidate" condition="configLoaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="file.grafcet#/t2" name="T_ValidateToBranch" condition="dataValid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="file.grafcet#/t3" name="T_A_ToMerge" condition="branchAComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" location="file.grafcet#/t4" name="T_B_ToMerge" condition="branchBComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" location="file.grafcet#/t5" name="T_MergeToFinal" condition="allDone"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="file.grafcet#/c0" name="C_Init_Load" grafcet="/0" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" location="file.grafcet#/c1" name="C_Load_Validate" grafcet="/0" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="file.grafcet#/c2" name="C_Validate_Branch" grafcet="/0" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" location="file.grafcet#/c3" name="C_ProcessA_Merge" grafcet="/0" from="/0/@elements.3" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" location="file.grafcet#/c4" name="C_ProcessB_Merge" grafcet="/0" from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" location="file.grafcet#/c5" name="C_Merge_Final" grafcet="/0" from="/0/@elements.5" to="/0/@elements.12"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" location="file.grafcet#/c6" name="C_LoadConfig" grafcet="/0" from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="file.grafcet#/c7" name="C_ValidateData" grafcet="/0" from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" location="file.grafcet#/c8" name="C_Branch_ProcessA" grafcet="/0" from="/0/@elements.9" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" location="file.grafcet#/c9" name="C_Branch_ProcessB" grafcet="/0" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" location="file.grafcet#/c10" name="C_MergeStep" grafcet="/0" from="/0/@elements.10" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" location="file.grafcet#/c11" name="C_MergeStepFromB" grafcet="/0" from="/0/@elements.11" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" location="file.grafcet#/c12" name="C_FinalStep" grafcet="/0" from="/0/@elements.12" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>