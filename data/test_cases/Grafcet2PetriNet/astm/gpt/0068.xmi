<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" location="loc_g0" name="ComplexGrafcet_0068">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              location="loc_s0"
              name="InitStep"
              isInitial="true"
              isActive="true"
              action="startSystem"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              location="loc_s1"
              name="MiddleStep1"
              isInitial="false"
              isActive="false"
              action="checkSensors"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              location="loc_s2"
              name="MiddleStep2"
              isInitial="false"
              isActive="false"
              action="computeValues"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              location="loc_s3"
              name="FinalStep"
              isInitial="false"
              isActive="false"
              action="shutdownSystem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              location="loc_t0"
              name="T_Init_to_M1"
              condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              location="loc_t1"
              name="T_M1_to_M2"
              condition="sensorsOk"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              location="loc_t2"
              name="T_M1_to_Final"
              condition="abortRequested"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t3"
              location="loc_t3"
              name="T_M2_to_Final"
              condition="computeDone"/>

    <!-- StepToTransition connections (Step -> Transition) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 location="loc_c0"
                 name="C_Init_to_T0"
                 grafcet="/0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 location="loc_c1"
                 name="C_M1_to_T1"
                 grafcet="/0"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 location="loc_c2"
                 name="C_M1_to_T2"
                 grafcet="/0"
                 from="/0/@elements.1"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 location="loc_c3"
                 name="C_M2_to_T3"
                 grafcet="/0"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>

    <!-- TransitionToStep connections (Transition -> Step) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 location="loc_c4"
                 name="C_T0_to_M1"
                 grafcet="/0"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 location="loc_c5"
                 name="C_T1_to_M2"
                 grafcet="/0"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 location="loc_c6"
                 name="C_T2_to_Final"
                 grafcet="/0"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 location="loc_c7"
                 name="C_T3_to_Final"
                 grafcet="/0"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>