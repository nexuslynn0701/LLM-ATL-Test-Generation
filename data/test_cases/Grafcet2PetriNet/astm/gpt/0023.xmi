<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file.grafcet#//@grafcet" name="ComplexGrafcet0023">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="file.grafcet#//@grafcet/@elements.0" name="InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="file.grafcet#//@grafcet/@elements.1" name="ProcessingStep" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="file.grafcet#//@grafcet/@elements.2" name="FinalStep" isInitial="false" isActive="false" action="shutdownSystem"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="file.grafcet#//@grafcet/@elements.3" name="T_Init_To_Processing" condition="eventStart &amp;&amp; ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="file.grafcet#//@grafcet/@elements.4" name="T_Processing_To_Final" condition="processingDone"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="file.grafcet#//@grafcet/@connections.0" name="C_Init_to_T0" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" location="file.grafcet#//@grafcet/@connections.1" name="C_T0_to_Processing" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="file.grafcet#//@grafcet/@connections.2" name="C_Processing_to_T1" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" location="file.grafcet#//@grafcet/@connections.3" name="C_T1_to_Final" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>