<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" location="file:///grafcet/example0038.grafcet#/"
                   name="ComplexGrafcet0038">

    <!-- Elements: 3 Steps and 2 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0"
              location="file:///grafcet/example0038.grafcet#/s0"
              name="InitStep"
              isInitial="true"
              isActive="true"
              action="initializeSystem"/>

    <elements xsi:type="Grafcet:Step" xmi:id="_s1"
              location="file:///grafcet/example0038.grafcet#/s1"
              name="ProcessingStep"
              isInitial="false"
              isActive="false"
              action="processData"/>

    <elements xsi:type="Grafcet:Step" xmi:id="_s2"
              location="file:///grafcet/example0038.grafcet#/s2"
              name="FinalStep"
              isInitial="false"
              isActive="false"
              action="shutdownSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0"
              location="file:///grafcet/example0038.grafcet#/t0"
              name="StartProcessing"
              condition="startSignal"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t1"
              location="file:///grafcet/example0038.grafcet#/t1"
              name="FinishProcessing"
              condition="processingDone"/>

    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- InitStep -> StartProcessing -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0"
                 location="file:///grafcet/example0038.grafcet#/c0"
                 name="Init_to_Start"
                 from="/0/@elements.0"
                 to="/0/@elements.3"/>

    <!-- StartProcessing -> ProcessingStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1"
                 location="file:///grafcet/example0038.grafcet#/c1"
                 name="Start_to_Process"
                 from="/0/@elements.3"
                 to="/0/@elements.1"/>

    <!-- ProcessingStep -> FinishProcessing -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2"
                 location="file:///grafcet/example0038.grafcet#/c2"
                 name="Process_to_Finish"
                 from="/0/@elements.1"
                 to="/0/@elements.4"/>

    <!-- FinishProcessing -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3"
                 location="file:///grafcet/example0038.grafcet#/c3"
                 name="Finish_to_Final"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>

    <!-- Extra branch: InitStep -> FinishProcessing (shortcut) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4"
                 location="file:///grafcet/example0038.grafcet#/c4"
                 name="Init_to_FinishShortcut"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>

    <!-- Extra loop: FinishProcessing -> ProcessingStep (reprocess) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5"
                 location="file:///grafcet/example0038.grafcet#/c5"
                 name="Finish_to_ProcessLoop"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>

  </Grafcet:Grafcet>
</xmi:XMI>