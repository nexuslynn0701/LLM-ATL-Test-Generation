<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" location="file://grafcet/example0099.grafcet" name="ComplexGrafcet">
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" location="line 1, col 1" name="InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" location="line 5, col 1" name="ProcessingStep" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" location="line 9, col 1" name="FinalStep" isInitial="false" isActive="false" action="shutdownSystem"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" location="line 3, col 1" name="T_Init_to_Process" condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" location="line 7, col 1" name="T_Process_to_Final" condition="processingDone"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" location="line 2, col 3" name="Init_to_T0" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" location="line 4, col 3" name="T0_to_Process" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" location="line 6, col 3" name="Process_to_T1" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C3" location="line 8, col 3" name="T1_to_Final" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>