<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="file://complex.grafcet">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="file://complex.grafcet#InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ProcessStepA" location="file://complex.grafcet#ProcessStepA" isInitial="false" isActive="false" action="processA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessStepB" location="file://complex.grafcet#ProcessStepB" isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="MergeStep" location="file://complex.grafcet#MergeStep" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="FinalStep" location="file://complex.grafcet#FinalStep" isInitial="false" isActive="false" action="finalizeSystem"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_to_A" location="file://complex.grafcet#T_Init_to_A" condition="startA"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Init_to_B" location="file://complex.grafcet#T_Init_to_B" condition="startB"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_A_to_Merge" location="file://complex.grafcet#T_A_to_Merge" condition="A_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_B_to_Merge" location="file://complex.grafcet#T_B_to_Merge" condition="B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_Merge_to_Final" location="file://complex.grafcet#T_Merge_to_Final" condition="all_done"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="file://complex.grafcet#C_Init_to_T0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="C_T0_to_A" location="file://complex.grafcet#C_T0_to_A" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Init_to_T1" location="file://complex.grafcet#C_Init_to_T1" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="C_T1_to_B" location="file://complex.grafcet#C_T1_to_B" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_A_to_T2" location="file://complex.grafcet#C_A_to_T2" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_T2_to_Merge" location="file://complex.grafcet#C_T2_to_Merge" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_B_to_T3" location="file://complex.grafcet#C_B_to_T3" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_T3_to_Merge" location="file://complex.grafcet#C_T3_to_Merge" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="C_Merge_to_T4" location="file://complex.grafcet#C_Merge_to_T4" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_T4_to_Final" location="file://complex.grafcet#C_T4_to_Final" from="/0/@elements.9" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>