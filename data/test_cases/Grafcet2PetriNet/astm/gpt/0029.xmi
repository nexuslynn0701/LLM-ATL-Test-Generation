<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcetExample" location="file:///models/grafcet/complex_0029.gcf">
    <!-- Elements: 4 Steps and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="ProcessingStep" location="2:1-2:30" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="DecisionStep" location="3:1-3:25" isInitial="false" isActive="false" action="evaluate_condition"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="FinalStep" location="4:1-4:25" isInitial="false" isActive="false" action="shutdown_system"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="T_InitToProc" location="5:1-5:30" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="T_ProcToDecision" location="6:1-6:35" condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="T_DecisionToFinal" location="7:1-7:40" condition="decision_positive"/>

    <!-- Connections: chain through all steps and transitions -->
    <!-- InitStep -> T_InitToProc -->
    <connections xsi:type="Grafcet:StepToTransition"
        xmi:id="/0/@connections.0"
        name="C_Init_to_T1"
        location="8:1-8:40"
        from="/0/@elements.0"
        to="/0/@elements.4"/>

    <!-- T_InitToProc -> ProcessingStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
        xmi:id="/0/@connections.1"
        name="C_T1_to_Proc"
        location="9:1-9:40"
        from="/0/@elements.4"
        to="/0/@elements.1"/>

    <!-- ProcessingStep -> T_ProcToDecision -->
    <connections xsi:type="Grafcet:StepToTransition"
        xmi:id="/0/@connections.2"
        name="C_Proc_to_T2"
        location="10:1-10:40"
        from="/0/@elements.1"
        to="/0/@elements.5"/>

    <!-- T_ProcToDecision -> DecisionStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
        xmi:id="/0/@connections.3"
        name="C_T2_to_Decision"
        location="11:1-11:45"
        from="/0/@elements.5"
        to="/0/@elements.2"/>

    <!-- DecisionStep -> T_DecisionToFinal -->
    <connections xsi:type="Grafcet:StepToTransition"
        xmi:id="/0/@connections.4"
        name="C_Decision_to_T3"
        location="12:1-12:45"
        from="/0/@elements.2"
        to="/0/@elements.6"/>

    <!-- T_DecisionToFinal -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
        xmi:id="/0/@connections.5"
        name="C_T3_to_Final"
        location="13:1-13:40"
        from="/0/@elements.6"
        to="/0/@elements.3"/>

    <!-- Additional backward connection creating a loop: FinalStep -> T_ProcToDecision -->
    <connections xsi:type="Grafcet:StepToTransition"
        xmi:id="/0/@connections.6"
        name="C_Final_to_T2"
        location="14:1-14:45"
        from="/0/@elements.3"
        to="/0/@elements.5"/>

  </Grafcet:Grafcet>
</xmi:XMI>