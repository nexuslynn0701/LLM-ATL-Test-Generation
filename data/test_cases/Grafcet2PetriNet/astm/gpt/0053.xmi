<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexMachineControl" location="file://model/grafcet_0053.gcf">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="file://model/grafcet_0053.gcf#InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="LoadStep" location="file://model/grafcet_0053.gcf#LoadStep" isInitial="false" isActive="false" action="load_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessStep" location="file://model/grafcet_0053.gcf#ProcessStep" isInitial="false" isActive="false" action="start_processing"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="CoolingStep" location="file://model/grafcet_0053.gcf#CoolingStep" isInitial="false" isActive="false" action="cool_down"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="FinishStep" location="file://model/grafcet_0053.gcf#FinishStep" isInitial="false" isActive="false" action="finish_cycle"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToLoad" location="file://model/grafcet_0053.gcf#T_InitToLoad" condition="start_button_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_LoadToProcess" location="file://model/grafcet_0053.gcf#T_LoadToProcess" condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_ProcessToCooling" location="file://model/grafcet_0053.gcf#T_ProcessToCooling" condition="temp_above_threshold"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_CoolingToFinish" location="file://model/grafcet_0053.gcf#T_CoolingToFinish" condition="cooled_and_safe"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_ProcessLoopBack" location="file://model/grafcet_0053.gcf#T_ProcessLoopBack" condition="rework_required"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="file://model/grafcet_0053.gcf#C_Init_to_T0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="C_T0_to_Load" location="file://model/grafcet_0053.gcf#C_T0_to_Load" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Load_to_T1" location="file://model/grafcet_0053.gcf#C_Load_to_T1" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="C_T1_to_Process" location="file://model/grafcet_0053.gcf#C_T1_to_Process" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_Process_to_T2" location="file://model/grafcet_0053.gcf#C_Process_to_T2" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_T2_to_Cooling" location="file://model/grafcet_0053.gcf#C_T2_to_Cooling" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_Cooling_to_T3" location="file://model/grafcet_0053.gcf#C_Cooling_to_T3" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_T3_to_Finish" location="file://model/grafcet_0053.gcf#C_T3_to_Finish" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="C_Process_to_T4" location="file://model/grafcet_0053.gcf#C_Process_to_T4" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_T4_to_Load" location="file://model/grafcet_0053.gcf#C_T4_to_Load" from="/0/@elements.9" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>