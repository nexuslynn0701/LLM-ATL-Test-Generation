<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file://grafcet/example16.gcf#/" name="ComplexGrafcet0016">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="file://grafcet/example16.gcf#/s0" name="InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="file://grafcet/example16.gcf#/s1" name="CheckInputs" isInitial="false" isActive="false" action="check_inputs"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="file://grafcet/example16.gcf#/s2" name="ProcessData" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="file://grafcet/example16.gcf#/s3" name="Finalize" isInitial="false" isActive="false" action="finalize_cycle"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" location="file://grafcet/example16.gcf#/s4" name="ErrorHandler" isInitial="false" isActive="false" action="handle_error"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="file://grafcet/example16.gcf#/t0" name="T_InitToCheck" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="file://grafcet/example16.gcf#/t1" name="T_CheckToProcess" condition="inputs_valid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="file://grafcet/example16.gcf#/t2" name="T_ProcessToFinalize" condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="file://grafcet/example16.gcf#/t3" name="T_AnyToError" condition="error_detected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" location="file://grafcet/example16.gcf#/t4" name="T_ErrorToInit" condition="reset_pressed"/>

    <!-- StepToTransition connections (PlaceToTransition in target) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="file://grafcet/example16.gcf#/c0" name="C_s0_t0" grafcet="/0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" location="file://grafcet/example16.gcf#/c1" name="C_s1_t1" grafcet="/0" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="file://grafcet/example16.gcf#/c2" name="C_s2_t2" grafcet="/0" from="/0/@elements.2" to="/0/@elements.7"/>
    <!-- Multiple steps feeding same error transition t3 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" location="file://grafcet/example16.gcf#/c3" name="C_s1_t3" grafcet="/0" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" location="file://grafcet/example16.gcf#/c4" name="C_s2_t3" grafcet="/0" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" location="file://grafcet/example16.gcf#/c5" name="C_s3_t3" grafcet="/0" from="/0/@elements.3" to="/0/@elements.8"/>
    <!-- Error step to reset transition t4 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" location="file://grafcet/example16.gcf#/c6" name="C_s4_t4" grafcet="/0" from="/0/@elements.4" to="/0/@elements.9"/>

    <!-- TransitionToStep connections (TransitionToPlace in target) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="file://grafcet/example16.gcf#/c7" name="C_t0_s1" grafcet="/0" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" location="file://grafcet/example16.gcf#/c8" name="C_t1_s2" grafcet="/0" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" location="file://grafcet/example16.gcf#/c9" name="C_t2_s3" grafcet="/0" from="/0/@elements.7" to="/0/@elements.3"/>
    <!-- Error transition to ErrorHandler step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" location="file://grafcet/example16.gcf#/c10" name="C_t3_s4" grafcet="/0" from="/0/@elements.8" to="/0/@elements.4"/>
    <!-- Reset transition back to initial step, forming a loop -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" location="file://grafcet/example16.gcf#/c11" name="C_t4_s0" grafcet="/0" from="/0/@elements.9" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>