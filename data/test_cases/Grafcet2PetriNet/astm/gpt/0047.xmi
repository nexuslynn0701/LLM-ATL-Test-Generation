<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="g0" location="file.grafcet#/" name="ComplexGrafcet0047">
    <!-- Elements: 4 Steps and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="s0" location="file.grafcet#/s0" name="InitStep" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s1" location="file.grafcet#/s1" name="ProcessingStepA" isInitial="false" isActive="false" action="processA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s2" location="file.grafcet#/s2" name="ProcessingStepB" isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s3" location="file.grafcet#/s3" name="FinalStep" isInitial="false" isActive="false" action="finalize"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t0" location="file.grafcet#/t0" name="T_Init_to_A" condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t1" location="file.grafcet#/t1" name="T_A_to_B" condition="aCompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t2" location="file.grafcet#/t2" name="T_AB_to_Final" condition="bCompleted"/>

    <!-- Connections: StepToTransition (s -> t) -->
    <!-- Initial step to first transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c0" location="file.grafcet#/c0" name="Arc_Init_s0_t0"
        from="/0/@elements.0" to="/0/@elements.4"/>
    <!-- Processing A to transition A->B -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c1" location="file.grafcet#/c1" name="Arc_A_s1_t1"
        from="/0/@elements.1" to="/0/@elements.5"/>
    <!-- Processing B to transition AB->Final -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c2" location="file.grafcet#/c2" name="Arc_B_s2_t2"
        from="/0/@elements.2" to="/0/@elements.6"/>
    <!-- Additional branch from InitStep directly to transition A->B -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c3" location="file.grafcet#/c3" name="Arc_Init_s0_t1"
        from="/0/@elements.0" to="/0/@elements.5"/>

    <!-- Connections: TransitionToStep (t -> s) -->
    <!-- Transition t0 enables step s1 and s2 (fork) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c4" location="file.grafcet#/c4" name="Arc_t0_s1"
        from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c5" location="file.grafcet#/c5" name="Arc_t0_s2"
        from="/0/@elements.4" to="/0/@elements.2"/>
    <!-- Transition t1 goes back to ProcessingStepA (loop) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c6" location="file.grafcet#/c6" name="Arc_t1_s1"
        from="/0/@elements.5" to="/0/@elements.1"/>
    <!-- Transition t2 leads to FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c7" location="file.grafcet#/c7" name="Arc_t2_s3"
        from="/0/@elements.6" to="/0/@elements.3"/>
    <!-- Extra back edge from t2 to InitStep to create a cycle -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c8" location="file.grafcet#/c8" name="Arc_t2_s0"
        from="/0/@elements.6" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>