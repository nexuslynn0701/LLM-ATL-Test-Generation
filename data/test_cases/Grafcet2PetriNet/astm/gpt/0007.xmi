<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="line 1, col 1" name="ComplexGrafcet">
    <!-- Elements: 4 Steps and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="line 2, col 1" name="InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="line 3, col 1" name="CheckStep" isInitial="false" isActive="false" action="checkConditions"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="line 4, col 1" name="ProcessStep" isInitial="false" isActive="false" action="performProcessing"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="line 5, col 1" name="FinalStep" isInitial="false" isActive="false" action="shutdownSystem"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="line 6, col 1" name="T_Init_Check" condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="line 7, col 1" name="T_Check_Process" condition="conditionsOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="line 8, col 1" name="T_Process_Final" condition="processDone"/>
    <!-- Connections: StepToTransition -->
    <!-- s0 -> t0 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="line 9, col 1" name="C_Init_to_T0" from="/0/@elements.0" to="/0/@elements.4"/>
    <!-- s1 -> t1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" location="line 10, col 1" name="C_Check_to_T1" from="/0/@elements.1" to="/0/@elements.5"/>
    <!-- s2 -> t1 (branch join into same transition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="line 11, col 1" name="C_Process_to_T1" from="/0/@elements.2" to="/0/@elements.5"/>
    <!-- s2 -> t2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" location="line 12, col 1" name="C_Process_to_T2" from="/0/@elements.2" to="/0/@elements.6"/>
    <!-- Connections: TransitionToStep -->
    <!-- t0 -> s1 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" location="line 13, col 1" name="C_T0_to_Check" from="/0/@elements.4" to="/0/@elements.1"/>
    <!-- t1 -> s2 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="line 14, col 1" name="C_T1_to_Process" from="/0/@elements.5" to="/0/@elements.2"/>
    <!-- t2 -> s3 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" location="line 15, col 1" name="C_T2_to_Final" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>