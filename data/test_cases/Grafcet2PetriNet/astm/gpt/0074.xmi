<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet0074" location="file://grafcet_models/complex_0074.gcf">
    <!-- Elements: 4 Steps and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ProcessingStep" location="2:1-2:25" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="DecisionStep" location="3:1-3:23" isInitial="false" isActive="false" action="evaluateCondition"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="FinalStep" location="4:1-4:20" isInitial="false" isActive="false" action="shutdownSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_InitToProc" location="5:1-5:22" condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_ProcToDecision" location="6:1-6:26" condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="T_DecisionToFinal" location="7:1-7:26" condition="isSuccessful"/>

    <!-- Connections: StepToTransition (PlaceToTransition rule) -->
    <connections xsi:type="Grafcet:StepToTransition"
        xmi:id="_C1"
        name="C_Init_S1_T1"
        location="10:1-10:30"
        from="/0/@elements.0"
        to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
        xmi:id="_C2"
        name="C_Proc_S2_T2"
        location="11:1-11:30"
        from="/0/@elements.1"
        to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
        xmi:id="_C3"
        name="C_Decision_S3_T3"
        location="12:1-12:32"
        from="/0/@elements.2"
        to="/0/@elements.6"/>

    <!-- Connections: TransitionToStep (TransitionToPlace rule) -->
    <connections xsi:type="Grafcet:TransitionToStep"
        xmi:id="_C4"
        name="C_T1_S2"
        location="13:1-13:25"
        from="/0/@elements.4"
        to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
        xmi:id="_C5"
        name="C_T2_S3"
        location="14:1-14:25"
        from="/0/@elements.5"
        to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
        xmi:id="_C6"
        name="C_T3_S4"
        location="15:1-15:25"
        from="/0/@elements.6"
        to="/0/@elements.3"/>

    <!-- Extra branching: Transition back from DecisionStep to ProcessingStep -->
    <connections xsi:type="Grafcet:StepToTransition"
        xmi:id="_C7"
        name="C_Decision_S3_T2_Back"
        location="16:1-16:35"
        from="/0/@elements.2"
        to="/0/@elements.5"/>

    <!-- Extra loop: Transition from FinalStep back to InitStep -->
    <connections xsi:type="Grafcet:StepToTransition"
        xmi:id="_C8"
        name="C_Final_S4_T1_Loop"
        location="17:1-17:35"
        from="/0/@elements.3"
        to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep"
        xmi:id="_C9"
        name="C_T1_S1_LoopBack"
        location="18:1-18:35"
        from="/0/@elements.4"
        to="/0/@elements.0"/>

  </Grafcet:Grafcet>
</xmi:XMI>