<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ProductionLineGrafcet" location="example/productionLine.gra">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="Init" location="example/productionLine.gra#s0" isInitial="true" isActive="true" action="initializeSystem()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="LoadMaterial" location="example/productionLine.gra#s1" isInitial="false" isActive="false" action="loadMaterial()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessMaterial" location="example/productionLine.gra#s2" isInitial="false" isActive="false" action="processMaterial()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="UnloadMaterial" location="example/productionLine.gra#s3" isInitial="false" isActive="false" action="unloadMaterial()"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="InitToLoad" location="example/productionLine.gra#t0" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="LoadToProcess" location="example/productionLine.gra#t1" condition="materialLoaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="ProcessToUnload" location="example/productionLine.gra#t2" condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="UnloadToInit" location="example/productionLine.gra#t3" condition="unloadComplete"/>

    <!-- Connections: StepToTransition (PlaceToTransition rule in target) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="c_Init_Load" location="example/productionLine.gra#c0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="c_Load_Process" location="example/productionLine.gra#c1" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="c_Process_Unload" location="example/productionLine.gra#c2" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="c_Unload_InitLoop" location="example/productionLine.gra#c3" from="/0/@elements.3" to="/0/@elements.7"/>

    <!-- Connections: TransitionToStep (TransitionToPlace rule in target) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="c_t0_s1" location="example/productionLine.gra#c4" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="c_t1_s2" location="example/productionLine.gra#c5" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="c_t2_s3" location="example/productionLine.gra#c6" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="c_t3_s0" location="example/productionLine.gra#c7" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>