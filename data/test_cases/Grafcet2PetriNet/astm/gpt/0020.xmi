<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="loc:/grafcet/main" name="ComplexGrafcet0020">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="loc:/grafcet/main/s0" name="InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="loc:/grafcet/main/s1" name="PrepareStep" isInitial="false" isActive="false" action="prepare_resources"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="loc:/grafcet/main/s2" name="ProcessStep" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="loc:/grafcet/main/s3" name="FinalizeStep" isInitial="false" isActive="false" action="finalize_operation"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="loc:/grafcet/main/t0" name="ToPrepare" condition="when_start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="loc:/grafcet/main/t1" name="LoopOrFinalize" condition="if_more_items"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="loc:/grafcet/main/t2" name="RestartOrStop" condition="if_error_or_reset"/>
    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="loc:/grafcet/main/c0" name="InitToToPrepare" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" location="loc:/grafcet/main/c1" name="PrepareToProcess" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="loc:/grafcet/main/c2" name="FinalizeToRestartOrStop" from="/0/@elements.3" to="/0/@elements.6"/>
    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" location="loc:/grafcet/main/c3" name="ToPrepareToPrepare" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" location="loc:/grafcet/main/c4" name="LoopOrFinalizeToProcess" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="loc:/grafcet/main/c5" name="LoopOrFinalizeToFinalize" from="/0/@elements.5" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" location="loc:/grafcet/main/c6" name="RestartOrStopToInit" from="/0/@elements.6" to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="loc:/grafcet/main/c7" name="RestartOrStopToPrepare" from="/0/@elements.6" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>