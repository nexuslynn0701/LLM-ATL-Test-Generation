<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" location="file://testcases/grafcet42.gra" name="ComplexGrafcet0042">
    <!-- Elements: 4 Steps, 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="1:1-1:40" name="InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="2:1-2:45" name="LoadStep" isInitial="false" isActive="false" action="load_resources"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="3:1-3:50" name="ProcessStep" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="4:1-4:55" name="FinalStep" isInitial="false" isActive="false" action="finalize_and_cleanup"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="5:1-5:40" name="T_Init_Load" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="6:1-6:45" name="T_Load_Process" condition="load_complete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="7:1-7:50" name="T_Process_FinalOrLoop" condition="processing_done"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 location="8:1-8:40"
                 name="C_Init_to_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 location="9:1-9:45"
                 name="C_Load_to_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 location="10:1-10:50"
                 name="C_Process_to_T2"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c3"
                 location="11:1-11:45"
                 name="C_T0_to_Load"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 location="12:1-12:50"
                 name="C_T1_to_Process"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <!-- Branching: T2 to both Final and back to Init -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 location="13:1-13:55"
                 name="C_T2_to_Final"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 location="14:1-14:60"
                 name="C_T2_to_InitLoop"
                 from="/0/@elements.6"
                 to="/0/@elements.0"/>
  </Grafcet:Grafcet>

</xmi:XMI>