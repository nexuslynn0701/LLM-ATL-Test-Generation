<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file://grafcet_example_80.grafcet" name="ComplexGrafcetExample80">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="L1:C1-L1:C10" name="InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="L2:C1-L2:C15" name="ProcessingStep" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="L3:C1-L3:C20" name="FinalStep" isInitial="false" isActive="false" action="shutdown_system"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="L4:C1-L4:C12" name="CheckInput" condition="input_valid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="L5:C1-L5:C18" name="CheckCompletion" condition="processing_done"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="L6:C1-L6:C22" name="InitToCheckInput" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" location="L7:C1-L7:C24" name="CheckInputToProcessing" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="L8:C1-L8:C26" name="ProcessingToCheckCompletion" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" location="L9:C1-L9:C28" name="CheckCompletionToFinal" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>