<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet0071" location="file://grafcet/complex_0071.g">

    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
      xmi:id="_s0"
      name="InitStep"
      location="file://grafcet/complex_0071.g#s0"
      isInitial="true"
      isActive="true"
      action="initialize_system"/>

    <elements xsi:type="Grafcet:Step"
      xmi:id="_s1"
      name="LoadStep"
      location="file://grafcet/complex_0071.g#s1"
      isInitial="false"
      isActive="false"
      action="load_resources"/>

    <elements xsi:type="Grafcet:Step"
      xmi:id="_s2"
      name="ProcessStep"
      location="file://grafcet/complex_0071.g#s2"
      isInitial="false"
      isActive="false"
      action="process_data"/>

    <elements xsi:type="Grafcet:Step"
      xmi:id="_s3"
      name="FinalStep"
      location="file://grafcet/complex_0071.g#s3"
      isInitial="false"
      isActive="false"
      action="finalize_and_cleanup"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
      xmi:id="_t0"
      name="T_InitToLoad"
      location="file://grafcet/complex_0071.g#t0"
      condition="start_button_pressed"/>

    <elements xsi:type="Grafcet:Transition"
      xmi:id="_t1"
      name="T_LoadToProcess"
      location="file://grafcet/complex_0071.g#t1"
      condition="resources_loaded"/>

    <elements xsi:type="Grafcet:Transition"
      xmi:id="_t2"
      name="T_ProcessLoop"
      location="file://grafcet/complex_0071.g#t2"
      condition="more_items_to_process"/>

    <elements xsi:type="Grafcet:Transition"
      xmi:id="_t3"
      name="T_ProcessToFinal"
      location="file://grafcet/complex_0071.g#t3"
      condition="processing_complete"/>

    <!-- Connections: StepToTransition -->
    <!-- InitStep -> T_InitToLoad -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c0"
      name="C_Init_to_T0"
      location="file://grafcet/complex_0071.g#c0"
      from="/0/@elements.0"
      to="/0/@elements.4"/>

    <!-- LoadStep -> T_LoadToProcess -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c1"
      name="C_Load_to_T1"
      location="file://grafcet/complex_0071.g#c1"
      from="/0/@elements.1"
      to="/0/@elements.5"/>

    <!-- ProcessStep -> T_ProcessLoop (loop back) -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c2"
      name="C_Process_to_T2"
      location="file://grafcet/complex_0071.g#c2"
      from="/0/@elements.2"
      to="/0/@elements.6"/>

    <!-- ProcessStep -> T_ProcessToFinal -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c3"
      name="C_Process_to_T3"
      location="file://grafcet/complex_0071.g#c3"
      from="/0/@elements.2"
      to="/0/@elements.7"/>

    <!-- Connections: TransitionToStep -->
    <!-- T_InitToLoad -> LoadStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
      xmi:id="_c4"
      name="C_T0_to_Load"
      location="file://grafcet/complex_0071.g#c4"
      from="/0/@elements.4"
      to="/0/@elements.1"/>

    <!-- T_LoadToProcess -> ProcessStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
      xmi:id="_c5"
      name="C_T1_to_Process"
      location="file://grafcet/complex_0071.g#c5"
      from="/0/@elements.5"
      to="/0/@elements.2"/>

    <!-- T_ProcessLoop -> ProcessStep (loop) -->
    <connections xsi:type="Grafcet:TransitionToStep"
      xmi:id="_c6"
      name="C_T2_to_Process"
      location="file://grafcet/complex_0071.g#c6"
      from="/0/@elements.6"
      to="/0/@elements.2"/>

    <!-- T_ProcessToFinal -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
      xmi:id="_c7"
      name="C_T3_to_Final"
      location="file://grafcet/complex_0071.g#c7"
      from="/0/@elements.7"
      to="/0/@elements.3"/>

  </Grafcet:Grafcet>
</xmi:XMI>