<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0"
                   location="file:/models/grafcet0067.gfc#/"
                   name="ManufacturingCell">

    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_sInit"
              location="file:/models/grafcet0067.gfc#/steps/init"
              name="Init"
              isInitial="true"
              isActive="true"
              action="reset_counters"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_sLoad"
              location="file:/models/grafcet0067.gfc#/steps/load"
              name="LoadPart"
              isInitial="false"
              isActive="false"
              action="load_part"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_sProcess"
              location="file:/models/grafcet0067.gfc#/steps/process"
              name="ProcessPart"
              isInitial="false"
              isActive="false"
              action="process_part"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_sUnload"
              location="file:/models/grafcet0067.gfc#/steps/unload"
              name="UnloadPart"
              isInitial="false"
              isActive="false"
              action="unload_part"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_tInitToLoad"
              location="file:/models/grafcet0067.gfc#/transitions/init_to_load"
              name="InitToLoad"
              condition="init_done"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_tLoadToProcess"
              location="file:/models/grafcet0067.gfc#/transitions/load_to_process"
              name="LoadToProcess"
              condition="part_loaded"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_tProcessToUnload"
              location="file:/models/grafcet0067.gfc#/transitions/process_to_unload"
              name="ProcessToUnload"
              condition="process_ok"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_tLoopToLoad"
              location="file:/models/grafcet0067.gfc#/transitions/loop_to_load"
              name="LoopToLoad"
              condition="more_parts"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_cInit_Load"
                 location="file:/models/grafcet0067.gfc#/connections/init_load"
                 name="Init_Load"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>

    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_cLoad_Process"
                 location="file:/models/grafcet0067.gfc#/connections/load_process"
                 name="Load_Process"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>

    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_cProcess_Unload"
                 location="file:/models/grafcet0067.gfc#/connections/process_unload"
                 name="Process_Unload"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>

    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_cUnload_Loop"
                 location="file:/models/grafcet0067.gfc#/connections/unload_loop"
                 name="Unload_Loop"
                 from="/0/@elements.3"
                 to="/0/@elements.7"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_cLoadStep"
                 location="file:/models/grafcet0067.gfc#/connections/load_step"
                 name="LoadStep"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>

    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_cProcessStep"
                 location="file:/models/grafcet0067.gfc#/connections/process_step"
                 name="ProcessStep"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>

    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_cUnloadStep"
                 location="file:/models/grafcet0067.gfc#/connections/unload_step"
                 name="UnloadStep"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>

    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_cLoopBackInit"
                 location="file:/models/grafcet0067.gfc#/connections/loop_back_init"
                 name="LoopBackInit"
                 from="/0/@elements.7"
                 to="/0/@elements.0"/>

  </Grafcet:Grafcet>
</xmi:XMI>