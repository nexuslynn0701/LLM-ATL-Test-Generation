<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file://grafcet/complexScenario.gcf" name="ComplexManufacturingCycle">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="file://grafcet/complexScenario.gcf#S0" name="Idle" isInitial="true" isActive="true" action="wait_for_start"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="file://grafcet/complexScenario.gcf#S1" name="LoadMaterials" isInitial="false" isActive="false" action="load_materials"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="file://grafcet/complexScenario.gcf#S2" name="ProcessA" isInitial="false" isActive="false" action="run_process_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="file://grafcet/complexScenario.gcf#S3" name="ProcessB" isInitial="false" isActive="false" action="run_process_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" location="file://grafcet/complexScenario.gcf#S4" name="MergeResults" isInitial="false" isActive="false" action="merge_results"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" location="file://grafcet/complexScenario.gcf#S5" name="QualityCheck" isInitial="false" isActive="false" action="quality_check"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" location="file://grafcet/complexScenario.gcf#S6" name="Rework" isInitial="false" isActive="false" action="rework_step"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s7" location="file://grafcet/complexScenario.gcf#S7" name="Unload" isInitial="false" isActive="false" action="unload_products"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="file://grafcet/complexScenario.gcf#T0" name="StartPressed" condition="start_button_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="file://grafcet/complexScenario.gcf#T1" name="Loaded" condition="materials_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="file://grafcet/complexScenario.gcf#T2" name="SplitToParallel" condition="split_conditions_met"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="file://grafcet/complexScenario.gcf#T3" name="A_Done" condition="process_A_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" location="file://grafcet/complexScenario.gcf#T4" name="B_Done" condition="process_B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" location="file://grafcet/complexScenario.gcf#T5" name="BothDone" condition="A_and_B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" location="file://grafcet/complexScenario.gcf#T6" name="QC_Ok" condition="quality_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t7" location="file://grafcet/complexScenario.gcf#T7" name="QC_Fail" condition="quality_fail"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t8" location="file://grafcet/complexScenario.gcf#T8" name="ReworkDone" condition="rework_complete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t9" location="file://grafcet/complexScenario.gcf#T9" name="CycleEnd" condition="cycle_finished"/>

    <!-- StepToTransition connections (PlaceToTransition in target) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="file://grafcet/complexScenario.gcf#C0" name="Idle_to_Start" from="/0/@elements.0" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" location="file://grafcet/complexScenario.gcf#C1" name="Load_to_Loaded" from="/0/@elements.1" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="file://grafcet/complexScenario.gcf#C2" name="Load_to_Split" from="/0/@elements.1" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" location="file://grafcet/complexScenario.gcf#C3" name="A_to_A_Done" from="/0/@elements.2" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" location="file://grafcet/complexScenario.gcf#C4" name="B_to_B_Done" from="/0/@elements.3" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" location="file://grafcet/complexScenario.gcf#C5" name="Merge_to_QC" from="/0/@elements.4" to="/0/@elements.13"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" location="file://grafcet/complexScenario.gcf#C6" name="QC_to_QC_OK" from="/0/@elements.5" to="/0/@elements.14"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" location="file://grafcet/complexScenario.gcf#C7" name="QC_to_QC_Fail" from="/0/@elements.5" to="/0/@elements.15"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" location="file://grafcet/complexScenario.gcf#C8" name="Rework_to_ReworkDone" from="/0/@elements.6" to="/0/@elements.16"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c9" location="file://grafcet/complexScenario.gcf#C9" name="Unload_to_End" from="/0/@elements.7" to="/0/@elements.17"/>

    <!-- TransitionToStep connections (TransitionToPlace in target) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" location="file://grafcet/complexScenario.gcf#C10" name="Start_to_Load" from="/0/@elements.8" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" location="file://grafcet/complexScenario.gcf#C11" name="Loaded_to_Load" from="/0/@elements.9" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" location="file://grafcet/complexScenario.gcf#C12" name="Split_to_A" from="/0/@elements.10" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" location="file://grafcet/complexScenario.gcf#C13" name="Split_to_B" from="/0/@elements.10" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c14" location="file://grafcet/complexScenario.gcf#C14" name="A_Done_to_Merge" from="/0/@elements.11" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c15" location="file://grafcet/complexScenario.gcf#C15" name="B_Done_to_Merge" from="/0/@elements.12" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c16" location="file://grafcet/complexScenario.gcf#C16" name="BothDone_to_QC" from="/0/@elements.13" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c17" location="file://grafcet/complexScenario.gcf#C17" name="QC_OK_to_Unload" from="/0/@elements.14" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c18" location="file://grafcet/complexScenario.gcf#C18" name="QC_Fail_to_Rework" from="/0/@elements.15" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c19" location="file://grafcet/complexScenario.gcf#C19" name="ReworkDone_to_QC" from="/0/@elements.16" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c20" location="file://grafcet/complexScenario.gcf#C20" name="End_to_Idle" from="/0/@elements.17" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>