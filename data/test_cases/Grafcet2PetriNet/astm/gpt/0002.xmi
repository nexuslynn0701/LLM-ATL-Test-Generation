<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file://model/grafcet2.xmi">
    <!-- Elements: 3 Steps + 2 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="file://model/grafcet2.xmi#s0" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ProcessStep" location="file://model/grafcet2.xmi#s1" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="FinalStep" location="file://model/grafcet2.xmi#s2" isInitial="false" isActive="false" action="cleanup_and_stop"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="ToProcess" location="file://model/grafcet2.xmi#t0" condition="data_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="ToFinal" location="file://model/grafcet2.xmi#t1" condition="finished"/>

    <!-- Connections: 3 StepToTransition + 2 TransitionToStep -->
    <!-- s0 -> t0, s1 -> t0 (two incoming to t0), s1 -> t1; and t0 -> s1, t1 -> s2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="c_s0_t0" location="file://model/grafcet2.xmi#c0"
                 grafcet="/0" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="c_s1_t0" location="file://model/grafcet2.xmi#c1"
                 grafcet="/0" from="/0/@elements.1" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="c_s1_t1" location="file://model/grafcet2.xmi#c2"
                 grafcet="/0" from="/0/@elements.1" to="/0/@elements.4"/>

    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="c_t0_s1" location="file://model/grafcet2.xmi#c3"
                 grafcet="/0" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="c_t1_s2" location="file://model/grafcet2.xmi#c4"
                 grafcet="/0" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>