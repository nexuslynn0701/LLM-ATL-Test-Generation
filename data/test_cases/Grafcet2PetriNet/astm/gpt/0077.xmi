<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" location="loc_grafcet_main" name="ComplexGrafcet">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" location="loc_step_S1" name="S1" isInitial="true" isActive="true" action="init_action"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" location="loc_step_S2" name="S2" isInitial="false" isActive="false" action="process_action"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" location="loc_step_S3" name="S3" isInitial="false" isActive="false" action="finalize_action"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.3" location="loc_trans_T1" name="T1" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" location="loc_trans_T2" name="T2" condition="y = 1"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" location="loc_trans_T3" name="T3" condition="z &lt; 5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" location="loc_conn_S1_T1" name="C_S1_T1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.1" location="loc_conn_T1_S2" name="C_T1_S2" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" location="loc_conn_S2_T2" name="C_S2_T2" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" location="loc_conn_T2_S3" name="C_T2_S3" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.4" location="loc_conn_S1_T3" name="C_S1_T3" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5" location="loc_conn_T3_S3" name="C_T3_S3" from="/0/@elements.5" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>