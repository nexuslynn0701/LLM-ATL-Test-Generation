<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file:///model/grafcet0092.grafcet" name="ComplexProcess">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="file:///model/grafcet0092.grafcet#s0" name="Init" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="file:///model/grafcet0092.grafcet#s1" name="LoadConfig" isInitial="false" isActive="false" action="load_configuration"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="file:///model/grafcet0092.grafcet#s2" name="Validate" isInitial="false" isActive="false" action="validate_inputs"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="file:///model/grafcet0092.grafcet#s3" name="Execute" isInitial="false" isActive="false" action="execute_main"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" location="file:///model/grafcet0092.grafcet#s4" name="Cleanup" isInitial="false" isActive="false" action="cleanup_resources"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="file:///model/grafcet0092.grafcet#t0" name="toLoadConfig" condition="config_required"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="file:///model/grafcet0092.grafcet#t1" name="toValidate" condition="config_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="file:///model/grafcet0092.grafcet#t2" name="toExecute" condition="inputs_valid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="file:///model/grafcet0092.grafcet#t3" name="toCleanup" condition="execution_finished"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" location="file:///model/grafcet0092.grafcet#t4" name="loopOrExit" condition="needs_restart"/>
    <!-- StepToTransition connections (PlaceToTransition in target) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="file:///model/grafcet0092.grafcet#c0" name="Init_to_t0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" location="file:///model/grafcet0092.grafcet#c1" name="LoadConfig_to_t1" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="file:///model/grafcet0092.grafcet#c2" name="Validate_to_t2" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" location="file:///model/grafcet0092.grafcet#c3" name="Execute_to_t3" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" location="file:///model/grafcet0092.grafcet#c4" name="Cleanup_to_t4" from="/0/@elements.4" to="/0/@elements.9"/>
    <!-- TransitionToStep connections (TransitionToPlace in target) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="file:///model/grafcet0092.grafcet#c5" name="t0_to_LoadConfig" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" location="file:///model/grafcet0092.grafcet#c6" name="t1_to_Validate" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="file:///model/grafcet0092.grafcet#c7" name="t2_to_Execute" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" location="file:///model/grafcet0092.grafcet#c8" name="t3_to_Cleanup" from="/0/@elements.8" to="/0/@elements.4"/>
    <!-- loop / alternative path: from loopOrExit transition back to Init -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" location="file:///model/grafcet0092.grafcet#c9" name="t4_to_Init" from="/0/@elements.9" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>