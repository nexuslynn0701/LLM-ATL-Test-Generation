<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file://model/grafcet0046.gfc" name="ComplexSequenceWithBranch">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="file://model/grafcet0046.gfc#s0" name="InitStep" isInitial="true" isActive="true" action="initialize system"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="file://model/grafcet0046.gfc#t0" name="CheckSensors" condition="sensors_ready"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="file://model/grafcet0046.gfc#s1" name="PreProcess" isInitial="false" isActive="false" action="preprocess data"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="file://model/grafcet0046.gfc#t1" name="BranchDecision" condition="mode_auto"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="file://model/grafcet0046.gfc#s2" name="AutoModeStep" isInitial="false" isActive="false" action="run auto sequence"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="file://model/grafcet0046.gfc#t2" name="AutoToFinal" condition="auto_done"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="file://model/grafcet0046.gfc#s3" name="ManualModeStep" isInitial="false" isActive="false" action="run manual sequence"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="file://model/grafcet0046.gfc#t3" name="ManualToFinal" condition="manual_done"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" location="file://model/grafcet0046.gfc#s4" name="FinalStep" isInitial="false" isActive="false" action="shutdown system"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="file://model/grafcet0046.gfc#c0" name="InitToCheck" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" location="file://model/grafcet0046.gfc#c1" name="CheckToPre" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="file://model/grafcet0046.gfc#c2" name="PreToBranch" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" location="file://model/grafcet0046.gfc#c3" name="BranchToAuto" from="/0/@elements.3" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" location="file://model/grafcet0046.gfc#c4" name="BranchToManual" from="/0/@elements.3" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" location="file://model/grafcet0046.gfc#c5" name="AutoToFinalTransition" from="/0/@elements.4" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" location="file://model/grafcet0046.gfc#c6" name="ManualToFinalTransition" from="/0/@elements.6" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="file://model/grafcet0046.gfc#c7" name="AutoToFinalStep" from="/0/@elements.5" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" location="file://model/grafcet0046.gfc#c8" name="ManualToFinalStep" from="/0/@elements.7" to="/0/@elements.8"/>
  </Grafcet:Grafcet>
</xmi:XMI>