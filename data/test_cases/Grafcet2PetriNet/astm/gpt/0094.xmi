<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="loc_grafcet_1" name="ComplexGrafcet_0094">
    <!-- Elements: 4 Steps and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="loc_step_0" name="InitStep" isInitial="true" isActive="true" action="initialize_system()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="loc_step_1" name="ProcessingStep" isInitial="false" isActive="false" action="process_data()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="loc_step_2" name="DecisionStep" isInitial="false" isActive="false" action="evaluate_condition()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="loc_step_3" name="FinalStep" isInitial="false" isActive="false" action="shutdown_system()"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="loc_trans_0" name="T_Init_to_Proc" condition="start_button_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="loc_trans_1" name="T_Proc_to_Decision" condition="processing_complete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="loc_trans_2" name="T_Decision_to_Final" condition="decision_is_positive"/>

    <!-- Connections: StepToTransition and TransitionToStep forming a linear chain -->
    <!-- InitStep -> T_Init_to_Proc -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="loc_conn_0" name="C_InitStep_to_T0" from="/0/@elements.0" to="/0/@elements.4"/>
    <!-- T_Init_to_Proc -> ProcessingStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" location="loc_conn_1" name="C_T0_to_ProcessingStep" from="/0/@elements.4" to="/0/@elements.1"/>

    <!-- ProcessingStep -> T_Proc_to_Decision -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="loc_conn_2" name="C_ProcessingStep_to_T1" from="/0/@elements.1" to="/0/@elements.5"/>
    <!-- T_Proc_to_Decision -> DecisionStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" location="loc_conn_3" name="C_T1_to_DecisionStep" from="/0/@elements.5" to="/0/@elements.2"/>

    <!-- DecisionStep -> T_Decision_to_Final -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" location="loc_conn_4" name="C_DecisionStep_to_T2" from="/0/@elements.2" to="/0/@elements.6"/>
    <!-- T_Decision_to_Final -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="loc_conn_5" name="C_T2_to_FinalStep" from="/0/@elements.6" to="/0/@elements.3"/>

    <!-- Additional branch: InitStep also directly connects to DecisionStep via another transition -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="loc_trans_3" name="T_Init_to_Decision_Alt" condition="skip_processing"/>
    <!-- InitStep -> T_Init_to_Decision_Alt -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" location="loc_conn_6" name="C_InitStep_to_T3" from="/0/@elements.0" to="/0/@elements.7"/>
    <!-- T_Init_to_Decision_Alt -> DecisionStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="loc_conn_7" name="C_T3_to_DecisionStep" from="/0/@elements.7" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>