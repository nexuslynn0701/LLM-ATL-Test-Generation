<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexProcess" location="loc:/grafcet/complex">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="loc:/grafcet/complex/s0"
              isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckInputs" location="loc:/grafcet/complex/s1"
              isInitial="false" isActive="false" action="check_inputs"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessData" location="loc:/grafcet/complex/s2"
              isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ErrorHandler" location="loc:/grafcet/complex/s3"
              isInitial="false" isActive="false" action="handle_error"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="InitToCheck" location="loc:/grafcet/complex/t0"
              condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="CheckToProcess" location="loc:/grafcet/complex/t1"
              condition="inputs_valid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="CheckToError" location="loc:/grafcet/complex/t2"
              condition="inputs_invalid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="ErrorToInit" location="loc:/grafcet/complex/t3"
              condition="reset_error"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_st0"
                 name="c_Init_to_t0" location="loc:/grafcet/complex/st0"
                 from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_st1"
                 name="c_s1_to_t1" location="loc:/grafcet/complex/st1"
                 from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_st2"
                 name="c_s1_to_t2" location="loc:/grafcet/complex/st2"
                 from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_st3"
                 name="c_s2_to_t3" location="loc:/grafcet/complex/st3"
                 from="/0/@elements.2" to="/0/@elements.7"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_ts0"
                 name="c_t0_to_s1" location="loc:/grafcet/complex/ts0"
                 from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_ts1"
                 name="c_t1_to_s2" location="loc:/grafcet/complex/ts1"
                 from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_ts2"
                 name="c_t2_to_s3" location="loc:/grafcet/complex/ts2"
                 from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_ts3"
                 name="c_t3_to_s0" location="loc:/grafcet/complex/ts3"
                 from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>

</xmi:XMI>