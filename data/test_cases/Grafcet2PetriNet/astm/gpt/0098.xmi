<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file://grafcet/complexExample.grafcet">

    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="file://grafcet/complexExample.grafcet#s0" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckInput" location="file://grafcet/complexExample.grafcet#s1" isInitial="false" isActive="false" action="check_input"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessData" location="file://grafcet/complexExample.grafcet#s2" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ErrorHandler" location="file://grafcet/complexExample.grafcet#s3" isInitial="false" isActive="false" action="handle_error"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToCheck" location="file://grafcet/complexExample.grafcet#t0" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_CheckToProcess" location="file://grafcet/complexExample.grafcet#t1" condition="input_valid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_CheckToError" location="file://grafcet/complexExample.grafcet#t2" condition="input_invalid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_Recovery" location="file://grafcet/complexExample.grafcet#t3" condition="retry"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="file://grafcet/complexExample.grafcet#c0"
                 grafcet="/0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Check_to_T1" location="file://grafcet/complexExample.grafcet#c1"
                 grafcet="/0"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Check_to_T2" location="file://grafcet/complexExample.grafcet#c2"
                 grafcet="/0"
                 from="/0/@elements.1"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_Error_to_T3" location="file://grafcet/complexExample.grafcet#c3"
                 grafcet="/0"
                 from="/0/@elements.3"
                 to="/0/@elements.7"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="C_T0_to_Check" location="file://grafcet/complexExample.grafcet#c4"
                 grafcet="/0"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_T1_to_Process" location="file://grafcet/complexExample.grafcet#c5"
                 grafcet="/0"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="C_T2_to_Error" location="file://grafcet/complexExample.grafcet#c6"
                 grafcet="/0"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_T3_to_Check" location="file://grafcet/complexExample.grafcet#c7"
                 grafcet="/0"
                 from="/0/@elements.7"
                 to="/0/@elements.1"/>

  </Grafcet:Grafcet>
</xmi:XMI>