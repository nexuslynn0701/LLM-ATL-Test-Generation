<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="1:1-20:1">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="2:1-2:80" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckInputs" location="3:1-3:80" isInitial="false" isActive="false" action="readSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessData" location="4:1-4:80" isInitial="false" isActive="false" action="computeResults"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="FinalStep" location="5:1-5:80" isInitial="false" isActive="false" action="shutdownSystem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToCheck" location="6:1-6:80" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_CheckToProcess" location="7:1-7:80" condition="inputsValid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_ProcessLoop" location="8:1-8:80" condition="moreDataAvailable"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_ProcessToFinal" location="9:1-9:80" condition="processingComplete"/>

    <!-- StepToTransition connections (PlaceToTransition in target) -->
    <connections xsi:type="Grafcet:StepToTransition"
                xmi:id="_c0"
                name="C_Init_to_T0"
                location="10:1-10:80"
                from="/0/@elements.0"
                to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                xmi:id="_c1"
                name="C_Check_to_T1"
                location="11:1-11:80"
                from="/0/@elements.1"
                to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                xmi:id="_c2"
                name="C_Process_to_T2"
                location="12:1-12:80"
                from="/0/@elements.2"
                to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                xmi:id="_c3"
                name="C_Process_to_T3"
                location="13:1-13:80"
                from="/0/@elements.2"
                to="/0/@elements.7"/>

    <!-- TransitionToStep connections (TransitionToPlace in target) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                xmi:id="_c4"
                name="C_T0_to_Check"
                location="14:1-14:80"
                from="/0/@elements.4"
                to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                xmi:id="_c5"
                name="C_T1_to_Process"
                location="15:1-15:80"
                from="/0/@elements.5"
                to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                xmi:id="_c6"
                name="C_T2_to_Process"
                location="16:1-16:80"
                from="/0/@elements.6"
                to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                xmi:id="_c7"
                name="C_T3_to_Final"
                location="17:1-17:80"
                from="/0/@elements.7"
                to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>