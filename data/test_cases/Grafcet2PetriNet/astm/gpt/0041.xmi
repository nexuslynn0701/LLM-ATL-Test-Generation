<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" location="loc_g0" name="ComplexGrafcet_0041">
    <!-- Elements -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" location="loc_s0" name="InitStep" isInitial="true" isActive="true" action="startSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" location="loc_s1" name="MiddleStep" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" location="loc_s2" name="FinalStep" isInitial="false" isActive="false" action="shutdown"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" location="loc_t0" name="T_InitToMiddle" condition="sensor_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" location="loc_t1" name="T_MiddleToFinal" condition="task_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" location="loc_t2" name="T_LoopToInit" condition="reset_pressed"/>
    <!-- Connections -->
    <!-- S0 -> T0 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" location="loc_c0" name="C_S0_T0" from="/0/@elements.0" to="/0/@elements.3"/>
    <!-- T0 -> S1 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" location="loc_c1" name="C_T0_S1" from="/0/@elements.3" to="/0/@elements.1"/>
    <!-- S1 -> T1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" location="loc_c2" name="C_S1_T1" from="/0/@elements.1" to="/0/@elements.4"/>
    <!-- T1 -> S2 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C3" location="loc_c3" name="C_T1_S2" from="/0/@elements.4" to="/0/@elements.2"/>
    <!-- S2 -> T2 (loop back) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" location="loc_c4" name="C_S2_T2" from="/0/@elements.2" to="/0/@elements.5"/>
    <!-- T2 -> S0 (complete loop) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" location="loc_c5" name="C_T2_S0" from="/0/@elements.5" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>