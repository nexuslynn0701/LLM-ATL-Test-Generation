<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_G0" location="file.grafcet#/" name="ComplexGrafcet_0004">

    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" location="file.grafcet#/S0" name="InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" location="file.grafcet#/S1" name="ProcessingStepA" isInitial="false" isActive="false" action="processA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" location="file.grafcet#/S2" name="ProcessingStepB" isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" location="file.grafcet#/S3" name="FinalStep" isInitial="false" isActive="false" action="finalize"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" location="file.grafcet#/T0" name="T_Init_to_A" condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" location="file.grafcet#/T1" name="T_A_to_B" condition="A_completed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" location="file.grafcet#/T2" name="T_B_to_Final" condition="B_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" location="file.grafcet#/T3" name="T_B_to_Init" condition="resetRequested"/>

    <!-- StepToTransition connections (Step -> Transition) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C0"
                 location="file.grafcet#/C0"
                 name="C_S0_to_T0"
                 grafcet="/0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C1"
                 location="file.grafcet#/C1"
                 name="C_S1_to_T1"
                 grafcet="/0"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C2"
                 location="file.grafcet#/C2"
                 name="C_S2_to_T2"
                 grafcet="/0"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C3"
                 location="file.grafcet#/C3"
                 name="C_S2_to_T3"
                 grafcet="/0"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>

    <!-- TransitionToStep connections (Transition -> Step) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C4"
                 location="file.grafcet#/C4"
                 name="C_T0_to_S1"
                 grafcet="/0"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C5"
                 location="file.grafcet#/C5"
                 name="C_T1_to_S2"
                 grafcet="/0"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C6"
                 location="file.grafcet#/C6"
                 name="C_T2_to_S3"
                 grafcet="/0"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C7"
                 location="file.grafcet#/C7"
                 name="C_T3_to_S0"
                 grafcet="/0"
                 from="/0/@elements.7"
                 to="/0/@elements.0"/>

  </Grafcet:Grafcet>
</xmi:XMI>