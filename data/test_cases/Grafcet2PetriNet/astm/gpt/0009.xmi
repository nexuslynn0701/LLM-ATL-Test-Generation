<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g1" location="loc_g1" name="ComplexGrafcet0009">
    <!-- Elements: 3 Steps, 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="loc_s1" name="InitStep" isInitial="true" isActive="true" action="startSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="loc_s2" name="IntermediateStep" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="loc_s3" name="FinalStep" isInitial="false" isActive="false" action="shutdownSystem"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="loc_t1" name="T_InitToInter" condition="cond_init_to_inter"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="loc_t2" name="T_InterToFinal" condition="cond_inter_to_final"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="loc_t3" name="T_LoopBack" condition="cond_loop_back"/>
    <!-- Connections: StepToTransition -->
    <!-- s1 -> t1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_st1" location="loc_c_st1" name="C_S1_T1" from="/0/@elements.0" to="/0/@elements.3"/>
    <!-- s2 -> t2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_st2" location="loc_c_st2" name="C_S2_T2" from="/0/@elements.1" to="/0/@elements.4"/>
    <!-- s3 -> t3 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_st3" location="loc_c_st3" name="C_S3_T3" from="/0/@elements.2" to="/0/@elements.5"/>
    <!-- Connections: TransitionToStep -->
    <!-- t1 -> s2 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_ts1" location="loc_c_ts1" name="C_T1_S2" from="/0/@elements.3" to="/0/@elements.1"/>
    <!-- t2 -> s3 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_ts2" location="loc_c_ts2" name="C_T2_S3" from="/0/@elements.4" to="/0/@elements.2"/>
    <!-- t3 -> s1 (loop back to initial step) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_ts3" location="loc_c_ts3" name="C_T3_S1" from="/0/@elements.5" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>