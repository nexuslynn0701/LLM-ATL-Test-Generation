<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file://grafcet_examples/model6.gcf#/" name="ComplexGrafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="file://grafcet_examples/model6.gcf#/steps/s0" name="InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="file://grafcet_examples/model6.gcf#/steps/s1" name="CheckSensors" isInitial="false" isActive="false" action="check_sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="file://grafcet_examples/model6.gcf#/steps/s2" name="StartMotor" isInitial="false" isActive="false" action="start_motor"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="file://grafcet_examples/model6.gcf#/steps/s3" name="MonitorRunning" isInitial="false" isActive="false" action="monitor_running"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" location="file://grafcet_examples/model6.gcf#/steps/s4" name="StopMotor" isInitial="false" isActive="false" action="stop_motor"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" location="file://grafcet_examples/model6.gcf#/steps/s5" name="ErrorHandler" isInitial="false" isActive="false" action="handle_error"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="file://grafcet_examples/model6.gcf#/transitions/t0" name="T_Init_to_Check" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="file://grafcet_examples/model6.gcf#/transitions/t1" name="T_Check_to_Start" condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="file://grafcet_examples/model6.gcf#/transitions/t2" name="T_Start_to_Monitor" condition="motor_started"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="file://grafcet_examples/model6.gcf#/transitions/t3" name="T_Monitor_to_Stop" condition="stop_command"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" location="file://grafcet_examples/model6.gcf#/transitions/t4" name="T_Check_to_Error" condition="sensor_failure"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" location="file://grafcet_examples/model6.gcf#/transitions/t5" name="T_Error_to_Init" condition="reset_error"/>
    <!-- Connections Step -> Transition (StepToTransition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="file://grafcet_examples/model6.gcf#/connections/c0" name="C_Init_to_T0" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" location="file://grafcet_examples/model6.gcf#/connections/c1" name="C_Check_to_T1" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="file://grafcet_examples/model6.gcf#/connections/c2" name="C_Check_to_T4" from="/0/@elements.1" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" location="file://grafcet_examples/model6.gcf#/connections/c3" name="C_Start_to_T2" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" location="file://grafcet_examples/model6.gcf#/connections/c4" name="C_Monitor_to_T3" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" location="file://grafcet_examples/model6.gcf#/connections/c5" name="C_Error_to_T5" from="/0/@elements.5" to="/0/@elements.11"/>
    <!-- Connections Transition -> Step (TransitionToStep) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" location="file://grafcet_examples/model6.gcf#/connections/c6" name="C_T0_to_Check" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="file://grafcet_examples/model6.gcf#/connections/c7" name="C_T1_to_Start" from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" location="file://grafcet_examples/model6.gcf#/connections/c8" name="C_T2_to_Monitor" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" location="file://grafcet_examples/model6.gcf#/connections/c9" name="C_T3_to_Stop" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" location="file://grafcet_examples/model6.gcf#/connections/c10" name="C_T4_to_Error" from="/0/@elements.10" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" location="file://grafcet_examples/model6.gcf#/connections/c11" name="C_T5_to_Init" from="/0/@elements.11" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>