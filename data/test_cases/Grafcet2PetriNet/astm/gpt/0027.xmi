<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="1:1-50:1">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              name="InitStep"
              location="2:1-2:50"
              isInitial="true"
              isActive="true"
              action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="ProcessingStep"
              location="3:1-3:50"
              isInitial="false"
              isActive="false"
              action="processData"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="VerificationStep"
              location="4:1-4:50"
              isInitial="false"
              isActive="false"
              action="verifyResults"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              name="FinalStep"
              location="5:1-5:50"
              isInitial="false"
              isActive="false"
              action="cleanupAndStop"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              name="StartProcessing"
              location="6:1-6:50"
              condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="ToVerification"
              location="7:1-7:50"
              condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="ToFinal"
              location="8:1-8:50"
              condition="verificationOk"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t3"
              name="Reprocess"
              location="9:1-9:50"
              condition="verificationFailed"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t4"
              name="DirectFinal"
              location="10:1-10:50"
              condition="skipVerification"/>

    <!-- StepToTransition connections (will become PlaceToTransition) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="c_Init_to_StartProcessing"
                 location="11:1-11:60"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="c_Processing_to_Verification"
                 location="12:1-12:60"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="c_Verification_to_Final"
                 location="13:1-13:60"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 name="c_Verification_to_Reprocess"
                 location="14:1-14:60"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c4"
                 name="c_Processing_to_DirectFinal"
                 location="15:1-15:60"
                 from="/0/@elements.1"
                 to="/0/@elements.8"/>

    <!-- TransitionToStep connections (will become TransitionToPlace) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 name="c_StartProcessing_to_Processing"
                 location="16:1-16:60"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 name="c_ToVerification_to_Verification"
                 location="17:1-17:60"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 name="c_ToFinal_to_Final"
                 location="18:1-18:60"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c8"
                 name="c_Reprocess_to_Processing"
                 location="19:1-19:60"
                 from="/0/@elements.7"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c9"
                 name="c_DirectFinal_to_Final"
                 location="20:1-20:60"
                 from="/0/@elements.8"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>