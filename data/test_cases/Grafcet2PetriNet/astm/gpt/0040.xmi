<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" location="file://grafcet_examples/model40.grafcet" name="ManufacturingCell">

    <!-- Elements: 4 Steps + 3 Transitions (mixed ordering) -->
    <elements xmi:id="_s0" xsi:type="Grafcet:Step"
              location="file://grafcet_examples/model40.grafcet#S0"
              name="InitCell"
              isInitial="true"
              isActive="true"
              action="initialize_cell"/>
    <elements xmi:id="_t0" xsi:type="Grafcet:Transition"
              location="file://grafcet_examples/model40.grafcet#T0"
              name="T_InitToLoad"
              condition="cell_ready &amp;&amp; pallet_available"/>
    <elements xmi:id="_s1" xsi:type="Grafcet:Step"
              location="file://grafcet_examples/model40.grafcet#S1"
              name="LoadPallet"
              isInitial="false"
              isActive="false"
              action="load_pallet"/>
    <elements xmi:id="_t1" xsi:type="Grafcet:Transition"
              location="file://grafcet_examples/model40.grafcet#T1"
              name="T_LoadToProcess"
              condition="load_complete"/>
    <elements xmi:id="_s2" xsi:type="Grafcet:Step"
              location="file://grafcet_examples/model40.grafcet#S2"
              name="ProcessPart"
              isInitial="false"
              isActive="false"
              action="process_part"/>
    <elements xmi:id="_t2" xsi:type="Grafcet:Transition"
              location="file://grafcet_examples/model40.grafcet#T2"
              name="T_ProcessToUnload"
              condition="process_done"/>
    <elements xmi:id="_s3" xsi:type="Grafcet:Step"
              location="file://grafcet_examples/model40.grafcet#S3"
              name="UnloadPallet"
              isInitial="false"
              isActive="false"
              action="unload_pallet"/>

    <!-- Connections: alternating StepToTransition / TransitionToStep -->
    <!-- S0 -> T0 -->
    <connections xmi:id="_c0" xsi:type="Grafcet:StepToTransition"
                 location="file://grafcet_examples/model40.grafcet#C0"
                 name="C_S0_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.1"/>
    <!-- T0 -> S1 -->
    <connections xmi:id="_c1" xsi:type="Grafcet:TransitionToStep"
                 location="file://grafcet_examples/model40.grafcet#C1"
                 name="C_T0_S1"
                 from="/0/@elements.1"
                 to="/0/@elements.2"/>
    <!-- S1 -> T1 -->
    <connections xmi:id="_c2" xsi:type="Grafcet:StepToTransition"
                 location="file://grafcet_examples/model40.grafcet#C2"
                 name="C_S1_T1"
                 from="/0/@elements.2"
                 to="/0/@elements.3"/>
    <!-- T1 -> S2 -->
    <connections xmi:id="_c3" xsi:type="Grafcet:TransitionToStep"
                 location="file://grafcet_examples/model40.grafcet#C3"
                 name="C_T1_S2"
                 from="/0/@elements.3"
                 to="/0/@elements.4"/>
    <!-- S2 -> T2 -->
    <connections xmi:id="_c4" xsi:type="Grafcet:StepToTransition"
                 location="file://grafcet_examples/model40.grafcet#C4"
                 name="C_S2_T2"
                 from="/0/@elements.4"
                 to="/0/@elements.5"/>
    <!-- T2 -> S3 -->
    <connections xmi:id="_c5" xsi:type="Grafcet:TransitionToStep"
                 location="file://grafcet_examples/model40.grafcet#C5"
                 name="C_T2_S3"
                 from="/0/@elements.5"
                 to="/0/@elements.6"/>

  </Grafcet:Grafcet>
</xmi:XMI>