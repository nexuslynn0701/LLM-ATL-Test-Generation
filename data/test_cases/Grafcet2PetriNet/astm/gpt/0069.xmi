    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" location="75,5,10,10" name="LoopBack" condition="repeatLoop"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="15,15,5,5" name="Arc_Init_to_t0" from="/0/@elements.0" to="/0/@elements.5"/>
