<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ProductionLineGrafcet" location="file:///models/productionLine.grafcet">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStep" location="file:///models/productionLine.grafcet#InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="LoadStep" location="file:///models/productionLine.grafcet#LoadStep" isInitial="false" isActive="false" action="loadMaterials"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="ProcessStep" location="file:///models/productionLine.grafcet#ProcessStep" isInitial="false" isActive="false" action="runProcessing"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.3" name="T_Init_Load" location="file:///models/productionLine.grafcet#T_Init_Load" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="T_Load_Process" location="file:///models/productionLine.grafcet#T_Load_Process" condition="materialsLoaded"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="C_Init_to_T_Init_Load" location="file:///models/productionLine.grafcet#C_Init_to_T_Init_Load" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.1" name="C_T_Init_Load_to_Load" location="file:///models/productionLine.grafcet#C_T_Init_Load_to_Load" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" name="C_Load_to_T_Load_Process" location="file:///models/productionLine.grafcet#C_Load_to_T_Load_Process" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" name="C_T_Load_Process_to_Process" location="file:///models/productionLine.grafcet#C_T_Load_Process_to_Process" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>