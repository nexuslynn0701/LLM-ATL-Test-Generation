<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file://grafcet/complex_0095.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="file://grafcet/complex_0095.grafcet#s0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="PrepareStep" location="file://grafcet/complex_0095.grafcet#s1" isInitial="false" isActive="false" action="prepareResources"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ParallelBranchA" location="file://grafcet/complex_0095.grafcet#s2" isInitial="false" isActive="false" action="executeBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ParallelBranchB" location="file://grafcet/complex_0095.grafcet#s3" isInitial="false" isActive="false" action="executeBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="MergeStep" location="file://grafcet/complex_0095.grafcet#s4" isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="FinalStep" location="file://grafcet/complex_0095.grafcet#s5" isInitial="false" isActive="false" action="shutdownSystem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToPrepare" location="file://grafcet/complex_0095.grafcet#t0" condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_PrepareToParallel" location="file://grafcet/complex_0095.grafcet#t1" condition="preparedOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_BranchAtoMerge" location="file://grafcet/complex_0095.grafcet#t2" condition="branchAComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_BranchBtoMerge" location="file://grafcet/complex_0095.grafcet#t3" condition="branchBComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_MergetoFinal" location="file://grafcet/complex_0095.grafcet#t4" condition="bothBranchesDone"/>

    <!-- Connections: StepToTransition (PlaceToTransition in target) -->
    <!-- InitStep -> T_InitToPrepare -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="file://grafcet/complex_0095.grafcet#c0"
        from="/0/@elements.0"
        to="/0/@elements.6"/>
    <!-- PrepareStep -> T_PrepareToParallel -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Prepare_to_T1" location="file://grafcet/complex_0095.grafcet#c1"
        from="/0/@elements.1"
        to="/0/@elements.7"/>
    <!-- ParallelBranchA -> T_BranchAtoMerge -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_BranchA_to_T2" location="file://grafcet/complex_0095.grafcet#c2"
        from="/0/@elements.2"
        to="/0/@elements.8"/>
    <!-- ParallelBranchB -> T_BranchBtoMerge -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_BranchB_to_T3" location="file://grafcet/complex_0095.grafcet#c3"
        from="/0/@elements.3"
        to="/0/@elements.9"/>
    <!-- MergeStep -> T_MergetoFinal -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_Merge_to_T4" location="file://grafcet/complex_0095.grafcet#c4"
        from="/0/@elements.4"
        to="/0/@elements.10"/>

    <!-- Connections: TransitionToStep (TransitionToPlace in target) -->
    <!-- T_InitToPrepare -> PrepareStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_T0_to_Prepare" location="file://grafcet/complex_0095.grafcet#c5"
        from="/0/@elements.6"
        to="/0/@elements.1"/>
    <!-- T_PrepareToParallel -> ParallelBranchA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="C_T1_to_BranchA" location="file://grafcet/complex_0095.grafcet#c6"
        from="/0/@elements.7"
        to="/0/@elements.2"/>
    <!-- T_PrepareToParallel -> ParallelBranchB -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_T1_to_BranchB" location="file://grafcet/complex_0095.grafcet#c7"
        from="/0/@elements.7"
        to="/0/@elements.3"/>
    <!-- T_BranchAtoMerge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_T2_to_Merge" location="file://grafcet/complex_0095.grafcet#c8"
        from="/0/@elements.8"
        to="/0/@elements.4"/>
    <!-- T_BranchBtoMerge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_T3_to_Merge" location="file://grafcet/complex_0095.grafcet#c9"
        from="/0/@elements.9"
        to="/0/@elements.4"/>
    <!-- T_MergetoFinal -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_T4_to_Final" location="file://grafcet/complex_0095.grafcet#c10"
        from="/0/@elements.10"
        to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>