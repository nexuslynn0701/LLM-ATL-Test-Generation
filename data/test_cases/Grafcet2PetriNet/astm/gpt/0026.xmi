<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" location="file://grafcet/example0026.grafcet#/" name="ComplexGrafcet">
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" location="file://grafcet/example0026.grafcet#/S0" name="InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" location="file://grafcet/example0026.grafcet#/S1" name="CheckSensors" isInitial="false" isActive="false" action="checkAllSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" location="file://grafcet/example0026.grafcet#/S2" name="ProcessData" isInitial="false" isActive="false" action="processDataBatch"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" location="file://grafcet/example0026.grafcet#/S3" name="Finalize" isInitial="false" isActive="false" action="finalizeCycle"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" location="file://grafcet/example0026.grafcet#/T0" name="tInitToCheck" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" location="file://grafcet/example0026.grafcet#/T1" name="tCheckToProcess" condition="sensorsOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" location="file://grafcet/example0026.grafcet#/T2" name="tProcessToFinalize" condition="dataProcessed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" location="file://grafcet/example0026.grafcet#/T3" name="tFinalizeToInit" condition="resetRequested"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" location="file://grafcet/example0026.grafcet#/C0" name="cInit_to_tInitToCheck" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" location="file://grafcet/example0026.grafcet#/C1" name="c_tInitToCheck_to_Check" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" location="file://grafcet/example0026.grafcet#/C2" name="cCheck_to_tCheckToProcess" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C3" location="file://grafcet/example0026.grafcet#/C3" name="c_tCheckToProcess_to_Process" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" location="file://grafcet/example0026.grafcet#/C4" name="cProcess_to_tProcessToFinalize" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" location="file://grafcet/example0026.grafcet#/C5" name="c_tProcessToFinalize_to_Finalize" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" location="file://grafcet/example0026.grafcet#/C6" name="cFinalize_to_tFinalizeToInit" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" location="file://grafcet/example0026.grafcet#/C7" name="c_tFinalizeToInit_to_Init" from="/0/@elements.7" to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C8" location="file://grafcet/example0026.grafcet#/C8" name="cInit_to_tCheckToProcess" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C9" location="file://grafcet/example0026.grafcet#/C9" name="c_tInitToCheck_to_Process" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>