<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="(0,0)">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="(10,10)" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ProcessStepA" location="(20,20)" isInitial="false" isActive="false" action="process_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessStepB" location="(30,30)" isInitial="false" isActive="false" action="process_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="FinalStep" location="(40,40)" isInitial="false" isActive="false" action="finalize"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_to_A" location="(15,15)" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_A_to_B" location="(25,25)" condition="A_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_B_to_Final" location="(35,35)" condition="B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_Loop_A" location="(22,18)" condition="retry_A"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="(12,12)" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="C_T0_to_A" location="(18,18)" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_A_to_T1" location="(22,22)" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="C_T1_to_B" location="(28,28)" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_B_to_T2" location="(32,32)" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_T2_to_Final" location="(38,38)" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_A_to_T3" location="(23,19)" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_T3_to_A" location="(24,20)" from="/0/@elements.7" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>