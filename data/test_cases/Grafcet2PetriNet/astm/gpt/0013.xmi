<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_grafcet_main" name="ComplexGrafcet_0013" location="file:/model/grafcet_0013.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_step_A" name="StepA" location="file:/model/grafcet_0013.grafcet#StepA" isInitial="true" isActive="true" action="init_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_B" name="StepB" location="file:/model/grafcet_0013.grafcet#StepB" isInitial="false" isActive="false" action="check_sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_C" name="StepC" location="file:/model/grafcet_0013.grafcet#StepC" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_D" name="StepD" location="file:/model/grafcet_0013.grafcet#StepD" isInitial="false" isActive="false" action="finalize_cycle"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_1" name="T1" location="file:/model/grafcet_0013.grafcet#T1" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_2" name="T2" location="file:/model/grafcet_0013.grafcet#T2" condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_3" name="T3" location="file:/model/grafcet_0013.grafcet#T3" condition="data_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_4" name="T4" location="file:/model/grafcet_0013.grafcet#T4" condition="cycle_complete"/>
    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_A_T1" name="A_to_T1" location="file:/model/grafcet_0013.grafcet#A_to_T1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_A_T2" name="A_to_T2" location="file:/model/grafcet_0013.grafcet#A_to_T2" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_B_T2" name="B_to_T2" location="file:/model/grafcet_0013.grafcet#B_to_T2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_B_T3" name="B_to_T3" location="file:/model/grafcet_0013.grafcet#B_to_T3" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_C_T3" name="C_to_T3" location="file:/model/grafcet_0013.grafcet#C_to_T3" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_C_T4" name="C_to_T4" location="file:/model/grafcet_0013.grafcet#C_to_T4" from="/0/@elements.2" to="/0/@elements.7"/>
    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_T1_B" name="T1_to_B" location="file:/model/grafcet_0013.grafcet#T1_to_B" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_T2_C" name="T2_to_C" location="file:/model/grafcet_0013.grafcet#T2_to_C" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_T3_D" name="T3_to_D" location="file:/model/grafcet_0013.grafcet#T3_to_D" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_T4_A" name="T4_to_A" location="file:/model/grafcet_0013.grafcet#T4_to_A" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>