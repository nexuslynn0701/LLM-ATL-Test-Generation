  <Grafcet:Grafcet xmi:id="/0" location="loc_grafcet_main" name="ComplexGrafcet_0085">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" location="loc_step_A" name="Step_A" isInitial="true" isActive="true" action="Initialize system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" location="loc_step_B" name="Step_B" isInitial="false" isActive="false" action="Check sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" location="loc_step_C" name="Step_C" isInitial="false" isActive="false" action="Process data"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.3" location="loc_trans_T1" name="Transition_T1" condition="sensors_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" location="loc_trans_T2" name="Transition_T2" condition="processing_done"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" location="loc_conn_ST1" name="ST_A_T1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.1" location="loc_conn_ST2" name="ST_B_T2" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.2" location="loc_conn_TS1" name="TS_T1_B" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" location="loc_conn_TS2" name="TS_T2_C" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
