<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file:/grafcet/example0064.gct" name="ComplexGrafcet">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="1,1" name="InitialStep" isInitial="true" isActive="true" action="init_action"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="2,1" name="IntermediateStep1" isInitial="false" isActive="false" action="intermediate_action_1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="3,1" name="IntermediateStep2" isInitial="false" isActive="false" action="intermediate_action_2"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="4,1" name="FinalStep" isInitial="false" isActive="false" action="final_action"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="1,2" name="T0" condition="cond0"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="2,2" name="T1" condition="cond1"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="3,2" name="T2" condition="cond2"/>
    <!-- Linear chain: s0 -> t0 -> s1 -> t1 -> s2 -> t2 -> s3 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="1c" name="S0_to_T0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" location="2c" name="T0_to_S1" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="3c" name="S1_to_T1" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" location="4c" name="T1_to_S2" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" location="5c" name="S2_to_T2" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="6c" name="T2_to_S3" from="/0/@elements.6" to="/0/@elements.3"/>
    <!-- Branching from initial step: s0 -> t1 and t0 -> s2 to create fan-in/out -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" location="7c" name="S0_to_T1" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="8c" name="T0_to_S2" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>