<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexProcess" location="file:///models/complexProcess.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="InitStep" location="1,1"
              isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="LoadStep" location="2,1"
              isInitial="false" isActive="false" action="loadResources"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ProcessStep" location="3,1"
              isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="AltProcessStep" location="3,2"
              isInitial="false" isActive="false" action="alternateProcessing"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="FinalizeStep" location="4,1"
              isInitial="false" isActive="false" action="finalizeExecution"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="InitToLoad" location="1.5,1"
              condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="LoadToProcess" location="2.5,1"
              condition="resourcesLoaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="ProcessDecision" location="3.5,1"
              condition="branchCondition"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="MergeToFinalize" location="3.5,1.5"
              condition="branchCompleted"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1"
                 name="C_Init_Load" location="c1"
                 grafcet="/0"
                 from="/0/@elements.0"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2"
                 name="C_Load_Process" location="c2"
                 grafcet="/0"
                 from="/0/@elements.1"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3"
                 name="C_Process_Decision" location="c3"
                 grafcet="/0"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4"
                 name="C_Alt_Decision" location="c4"
                 grafcet="/0"
                 from="/0/@elements.3"
                 to="/0/@elements.7"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5"
                 name="C_InitToLoad_Target" location="c5"
                 grafcet="/0"
                 from="/0/@elements.5"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6"
                 name="C_LoadToProcess_Target" location="c6"
                 grafcet="/0"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7"
                 name="C_Decision_Process" location="c7"
                 grafcet="/0"
                 from="/0/@elements.7"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8"
                 name="C_Decision_Alt" location="c8"
                 grafcet="/0"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9"
                 name="C_Merge_Finalize" location="c9"
                 grafcet="/0"
                 from="/0/@elements.8"
                 to="/0/@elements.4"/>

    <!-- Additional connections to exercise multiple arcs per node -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c10"
                 name="C_Process_Merge" location="c10"
                 grafcet="/0"
                 from="/0/@elements.2"
                 to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c11"
                 name="C_Alt_Merge" location="c11"
                 grafcet="/0"
                 from="/0/@elements.3"
                 to="/0/@elements.8"/>

  </Grafcet:Grafcet>
</xmi:XMI>