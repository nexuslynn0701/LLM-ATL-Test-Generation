<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" location="L0" name="ComplexGrafcet_0062">

    <!-- Steps -->
    <elements xmi:id="_s0" xsi:type="Grafcet:Step"
              location="L1" name="InitialStep"
              isInitial="true" isActive="true" action="startAction"/>
    <elements xmi:id="_s1" xsi:type="Grafcet:Step"
              location="L2" name="MiddleStepA"
              isInitial="false" isActive="false" action="processA"/>
    <elements xmi:id="_s2" xsi:type="Grafcet:Step"
              location="L3" name="MiddleStepB"
              isInitial="false" isActive="false" action="processB"/>
    <elements xmi:id="_s3" xsi:type="Grafcet:Step"
              location="L4" name="FinalStep"
              isInitial="false" isActive="false" action="finishAction"/>

    <!-- Transitions -->
    <elements xmi:id="_t0" xsi:type="Grafcet:Transition"
              location="L5" name="T_Init_to_A"
              condition="c0"/>
    <elements xmi:id="_t1" xsi:type="Grafcet:Transition"
              location="L6" name="T_A_to_B"
              condition="c1"/>
    <elements xmi:id="_t2" xsi:type="Grafcet:Transition"
              location="L7" name="T_B_to_Final"
              condition="c2"/>
    <elements xmi:id="_t3" xsi:type="Grafcet:Transition"
              location="L8" name="T_B_to_A"
              condition="c3"/>

    <!-- StepToTransition connections -->
    <connections xmi:id="_c0" xsi:type="Grafcet:StepToTransition"
                 location="L9" name="C_Init_T0"
                 grafcet="/0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xmi:id="_c1" xsi:type="Grafcet:StepToTransition"
                 location="L10" name="C_A_T1"
                 grafcet="/0"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xmi:id="_c2" xsi:type="Grafcet:StepToTransition"
                 location="L11" name="C_B_T2"
                 grafcet="/0"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xmi:id="_c3" xsi:type="Grafcet:StepToTransition"
                 location="L12" name="C_B_T3"
                 grafcet="/0"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>

    <!-- TransitionToStep connections -->
    <connections xmi:id="_c4" xsi:type="Grafcet:TransitionToStep"
                 location="L13" name="C_T0_A"
                 grafcet="/0"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xmi:id="_c5" xsi:type="Grafcet:TransitionToStep"
                 location="L14" name="C_T1_B"
                 grafcet="/0"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xmi:id="_c6" xsi:type="Grafcet:TransitionToStep"
                 location="L15" name="C_T2_Final"
                 grafcet="/0"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xmi:id="_c7" xsi:type="Grafcet:TransitionToStep"
                 location="L16" name="C_T3_A"
                 grafcet="/0"
                 from="/0/@elements.7"
                 to="/0/@elements.1"/>

    <!-- grafcet reference on elements -->
    <elements xsi:nil="true" grafcet="/0"/>
  </Grafcet:Grafcet>
</xmi:XMI>