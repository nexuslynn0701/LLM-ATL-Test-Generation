<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_G0" location="file://grafcet/example0070.grafcet" name="ComplexProcess">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_S0"
              location="file://grafcet/example0070.grafcet#S0"
              name="InitStep"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_S1"
              location="file://grafcet/example0070.grafcet#S1"
              name="CheckInputs"
              isInitial="false"
              isActive="false"
              action="check_inputs"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_S2"
              location="file://grafcet/example0070.grafcet#S2"
              name="ProcessData"
              isInitial="false"
              isActive="false"
              action="process_data"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_S3"
              location="file://grafcet/example0070.grafcet#S3"
              name="Finalize"
              isInitial="false"
              isActive="false"
              action="finalize_sequence"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T0"
              location="file://grafcet/example0070.grafcet#T0"
              name="T_Init_to_Check"
              condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T1"
              location="file://grafcet/example0070.grafcet#T1"
              name="T_Check_to_Process"
              condition="inputs_valid"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T2"
              location="file://grafcet/example0070.grafcet#T2"
              name="T_Process_loop"
              condition="more_data"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T3"
              location="file://grafcet/example0070.grafcet#T3"
              name="T_Process_to_Final"
              condition="no_more_data"/>

    <!-- StepToTransition connections (PlaceToTransition in target) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C_ST_0"
                 location="file://grafcet/example0070.grafcet#C_ST_0"
                 name="Arc_Init_to_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C_ST_1"
                 location="file://grafcet/example0070.grafcet#C_ST_1"
                 name="Arc_S1_to_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C_ST_2"
                 location="file://grafcet/example0070.grafcet#C_ST_2"
                 name="Arc_S2_to_T2"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C_ST_3"
                 location="file://grafcet/example0070.grafcet#C_ST_3"
                 name="Arc_S2_to_T3"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>

    <!-- TransitionToStep connections (TransitionToPlace in target) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C_TS_0"
                 location="file://grafcet/example0070.grafcet#C_TS_0"
                 name="Arc_T0_to_S1"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C_TS_1"
                 location="file://grafcet/example0070.grafcet#C_TS_1"
                 name="Arc_T1_to_S2"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C_TS_2"
                 location="file://grafcet/example0070.grafcet#C_TS_2"
                 name="Arc_T2_to_S2"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C_TS_3"
                 location="file://grafcet/example0070.grafcet#C_TS_3"
                 name="Arc_T3_to_S3"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>