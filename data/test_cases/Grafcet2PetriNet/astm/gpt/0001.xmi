<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file://model/complexGrafcet.grafcet">
    <!-- Elements: 4 Steps and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="StartStep" location="file://model/complexGrafcet.grafcet#s0" isInitial="true" isActive="true" action="initAction"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="MiddleStepA" location="file://model/complexGrafcet.grafcet#s1" isInitial="false" isActive="false" action="processA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="MiddleStepB" location="file://model/complexGrafcet.grafcet#s2" isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="EndStep" location="file://model/complexGrafcet.grafcet#s3" isInitial="false" isActive="false" action="finalize"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="ToBranch" location="file://model/complexGrafcet.grafcet#t0" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="JoinBranch" location="file://model/complexGrafcet.grafcet#t1" condition="y &gt; 10"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="ToEnd" location="file://model/complexGrafcet.grafcet#t2" condition="z == 1"/>

    <!-- Connections: StepToTransition (PlaceToTransition rule) -->
    <!-- StartStep -> ToBranch -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="c_Start_to_Branch"
                 location="file://model/complexGrafcet.grafcet#c0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>

    <!-- MiddleStepA -> JoinBranch -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="c_A_to_Join"
                 location="file://model/complexGrafcet.grafcet#c1"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>

    <!-- MiddleStepB -> JoinBranch -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="c_B_to_Join"
                 location="file://model/complexGrafcet.grafcet#c2"
                 from="/0/@elements.2"
                 to="/0/@elements.5"/>

    <!-- EndStep -> ToEnd (creates an extra outgoing arc from EndStep) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 name="c_End_to_ToEnd"
                 location="file://model/complexGrafcet.grafcet#c3"
                 from="/0/@elements.3"
                 to="/0/@elements.6"/>

    <!-- Connections: TransitionToStep (TransitionToPlace rule) -->
    <!-- ToBranch -> MiddleStepA -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 name="c_Branch_to_A"
                 location="file://model/complexGrafcet.grafcet#c4"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>

    <!-- ToBranch -> MiddleStepB -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 name="c_Branch_to_B"
                 location="file://model/complexGrafcet.grafcet#c5"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>

    <!-- JoinBranch -> EndStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 name="c_Join_to_End"
                 location="file://model/complexGrafcet.grafcet#c6"
                 from="/0/@elements.5"
                 to="/0/@elements.3"/>

    <!-- ToEnd -> StartStep (creates a small cycle) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 name="c_ToEnd_to_Start"
                 location="file://model/complexGrafcet.grafcet#c7"
                 from="/0/@elements.6"
                 to="/0/@elements.0"/>

  </Grafcet:Grafcet>
</xmi:XMI>