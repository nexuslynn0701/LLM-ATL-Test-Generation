<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" location="0:0-0:0" name="ComplexGrafcetExample">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" location="1:1-1:10" name="InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" location="2:1-2:10" name="CheckInput" isInitial="false" isActive="false" action="checkInputSignal"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" location="3:1-3:10" name="ProcessData" isInitial="false" isActive="false" action="processDataBlock"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" location="4:1-4:10" name="Finalize" isInitial="false" isActive="false" action="finalizeProcedure"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" location="5:1-5:10" name="ErrorHandler" isInitial="false" isActive="false" action="handleErrorCondition"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" location="6:1-6:10" name="T_InitToCheck" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" location="7:1-7:10" name="T_CheckToProcess" condition="inputValid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" location="8:1-8:10" name="T_ProcessToFinalize" condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" location="9:1-9:10" name="T_CheckToError" condition="inputInvalid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" location="10:1-10:10" name="T_ErrorToInit" condition="resetCommand"/>

    <!-- StepToTransition connections (PlaceToTransition in target) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" location="11:1-11:10" name="C_Init_Check" grafcet="/0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C1" location="12:1-12:10" name="C_Check_Process" grafcet="/0" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" location="13:1-13:10" name="C_Process_Finalize" grafcet="/0" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" location="14:1-14:10" name="C_Check_Error" grafcet="/0" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" location="15:1-15:10" name="C_Error_Init" grafcet="/0" from="/0/@elements.4" to="/0/@elements.9"/>

    <!-- TransitionToStep connections (TransitionToPlace in target) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" location="16:1-16:10" name="C_Check_from_Init" grafcet="/0" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C6" location="17:1-17:10" name="C_Process_from_Check" grafcet="/0" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" location="18:1-18:10" name="C_Finalize_from_Process" grafcet="/0" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C8" location="19:1-19:10" name="C_Error_from_Check" grafcet="/0" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C9" location="20:1-20:10" name="C_Init_from_Error" grafcet="/0" from="/0/@elements.9" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>