<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" location="loc_g0" name="ComplexGrafcet">
    <!-- Elements: 4 Steps and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="loc_s0" name="InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="loc_s1" name="IntermediateStep1" isInitial="false" isActive="false" action="check_sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="loc_s2" name="IntermediateStep2" isInitial="false" isActive="false" action="compute_values"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="loc_s3" name="FinalStep" isInitial="false" isActive="false" action="shutdown_system"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="loc_t0" name="T_Init_to_Steps" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="loc_t1" name="T_S1_to_S2" condition="sensor_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="loc_t2" name="T_S2_to_Final" condition="computation_done"/>

    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- From InitStep to first transition, then to IntermediateStep1 and IntermediateStep2 (branch) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="loc_c0" name="C_s0_t0" grafcet="/0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" location="loc_c1" name="C_t0_s1" grafcet="/0" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" location="loc_c2" name="C_t0_s2" grafcet="/0" from="/0/@elements.4" to="/0/@elements.2"/>

    <!-- Linear progression S1 -> T1 -> S2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" location="loc_c3" name="C_s1_t1" grafcet="/0" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" location="loc_c4" name="C_t1_s2" grafcet="/0" from="/0/@elements.5" to="/0/@elements.2"/>

    <!-- Merge from S2 to T2, then to FinalStep -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" location="loc_c5" name="C_s2_t2" grafcet="/0" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" location="loc_c6" name="C_t2_s3" grafcet="/0" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>