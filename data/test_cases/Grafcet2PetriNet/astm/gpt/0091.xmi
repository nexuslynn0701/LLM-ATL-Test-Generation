<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:version="2.0"
      location="example/location/grafcet0091"
      name="ComplexGrafcet0091">

    <!-- Elements: Steps and Transitions -->

    <!-- Step 0: initial and active -->
    <elements xsi:type="Grafcet:Step"
        location="loc_step_0"
        name="Step_Initial_0"
        isInitial="true"
        isActive="true"
        action="initializeSystem"/>

    <!-- Step 1: non-initial inactive -->
    <elements xsi:type="Grafcet:Step"
        location="loc_step_1"
        name="Step_1"
        isInitial="false"
        isActive="false"
        action="checkSensors"/>

    <!-- Step 2: non-initial active -->
    <elements xsi:type="Grafcet:Step"
        location="loc_step_2"
        name="Step_2"
        isInitial="false"
        isActive="true"
        action="processData"/>

    <!-- Step 3: sink step with multiple incoming transitions -->
    <elements xsi:type="Grafcet:Step"
        location="loc_step_3"
        name="Step_3"
        isInitial="false"
        isActive="false"
        action="finalize"/>

    <!-- Transition 4 -->
    <elements xsi:type="Grafcet:Transition"
        location="loc_trans_4"
        name="Transition_4"
        condition="cond_step0_to_step1"/>

    <!-- Transition 5 -->
    <elements xsi:type="Grafcet:Transition"
        location="loc_trans_5"
        name="Transition_5"
        condition="cond_step1_to_step2"/>

    <!-- Transition 6: branching from Step 2 -->
    <elements xsi:type="Grafcet:Transition"
        location="loc_trans_6"
        name="Transition_6"
        condition="cond_step2_branch"/>

    <!-- Transition 7: converging to Step 3 -->
    <elements xsi:type="Grafcet:Transition"
        location="loc_trans_7"
        name="Transition_7"
        condition="cond_to_step3"/>

    <!-- Connections: StepToTransition and TransitionToStep -->

    <!-- C0: Step 0 -> Transition 4 -->
    <connections xsi:type="Grafcet:StepToTransition"
        location="loc_conn_0"
        name="C_S0_T4"
        from="/0/@elements.0"
        to="/0/@elements.4"/>

    <!-- C1: Transition 4 -> Step 1 -->
    <connections xsi:type="Grafcet:TransitionToStep"
        location="loc_conn_1"
        name="C_T4_S1"
        from="/0/@elements.4"
        to="/0/@elements.1"/>

    <!-- C2: Step 1 -> Transition 5 -->
    <connections xsi:type="Grafcet:StepToTransition"
        location="loc_conn_2"
        name="C_S1_T5"
        from="/0/@elements.1"
        to="/0/@elements.5"/>

    <!-- C3: Transition 5 -> Step 2 -->
    <connections xsi:type="Grafcet:TransitionToStep"
        location="loc_conn_3"
        name="C_T5_S2"
        from="/0/@elements.5"
        to="/0/@elements.2"/>

    <!-- C4: Step 2 -> Transition 6 -->
    <connections xsi:type="Grafcet:StepToTransition"
        location="loc_conn_4"
        name="C_S2_T6"
        from="/0/@elements.2"
        to="/0/@elements.6"/>

    <!-- C5: Transition 6 -> Step 1 (loop back) -->
    <connections xsi:type="Grafcet:TransitionToStep"
        location="loc_conn_5"
        name="C_T6_S1"
        from="/0/@elements.6"
        to="/0/@elements.1"/>

    <!-- C6: Step 2 -> Transition 7 (branch to Step 3) -->
    <connections xsi:type="Grafcet:StepToTransition"
        location="loc_conn_6"
        name="C_S2_T7"
        from="/0/@elements.2"
        to="/0/@elements.7"/>

    <!-- C7: Transition 7 -> Step 3 -->
    <connections xsi:type="Grafcet:TransitionToStep"
        location="loc_conn_7"
        name="C_T7_S3"
        from="/0/@elements.7"
        to="/0/@elements.3"/>

    <!-- C8: Step 0 -> Transition 7 (alternative path to Step 3) -->
    <connections xsi:type="Grafcet:StepToTransition"
        location="loc_conn_8"
        name="C_S0_T7"
        from="/0/@elements.0"
        to="/0/@elements.7"/>

  </Grafcet:Grafcet>
</xmi:XMI>