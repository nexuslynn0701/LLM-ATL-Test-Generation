<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0"
                   location="file:///model/grafcet0011.grafcet#/"
                   name="ComplexProcess">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              location="file:///model/grafcet0011.grafcet#/steps/s0"
              name="InitStep"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              location="file:///model/grafcet0011.grafcet#/steps/s1"
              name="LoadConfig"
              isInitial="false"
              isActive="false"
              action="load_configuration"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              location="file:///model/grafcet0011.grafcet#/steps/s2"
              name="CheckSensors"
              isInitial="false"
              isActive="false"
              action="check_sensors"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              location="file:///model/grafcet0011.grafcet#/steps/s3"
              name="RunCycle"
              isInitial="false"
              isActive="false"
              action="execute_cycle"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s4"
              location="file:///model/grafcet0011.grafcet#/steps/s4"
              name="Shutdown"
              isInitial="false"
              isActive="false"
              action="shutdown_sequence"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              location="file:///model/grafcet0011.grafcet#/transitions/t0"
              name="InitToLoad"
              condition="config_available"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              location="file:///model/grafcet0011.grafcet#/transitions/t1"
              name="LoadToCheck"
              condition="load_ok"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              location="file:///model/grafcet0011.grafcet#/transitions/t2"
              name="CheckToRun"
              condition="all_sensors_ok"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t3"
              location="file:///model/grafcet0011.grafcet#/transitions/t3"
              name="RunLoop"
              condition="continue_cycle"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t4"
              location="file:///model/grafcet0011.grafcet#/transitions/t4"
              name="RunToShutdown"
              condition="stop_requested"/>
    <!-- Step index mapping in /0/@elements -->
    <!-- 0:_s0, 1:_s1, 2:_s2, 3:_s3, 4:_s4, 5:_t0, 6:_t1, 7:_t2, 8:_t3, 9:_t4 -->
    <!-- Connections Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 location="file:///model/grafcet0011.grafcet#/connections/c0"
                 name="Init_to_t0"
                 from="/0/@elements.0"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 location="file:///model/grafcet0011.grafcet#/connections/c1"
                 name="Load_to_t1"
                 from="/0/@elements.1"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 location="file:///model/grafcet0011.grafcet#/connections/c2"
                 name="Check_to_t2"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 location="file:///model/grafcet0011.grafcet#/connections/c3"
                 name="Run_to_t3"
                 from="/0/@elements.3"
                 to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c4"
                 location="file:///model/grafcet0011.grafcet#/connections/c4"
                 name="Run_to_t4"
                 from="/0/@elements.3"
                 to="/0/@elements.9"/>
    <!-- Connections Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 location="file:///model/grafcet0011.grafcet#/connections/c5"
                 name="t0_to_Load"
                 from="/0/@elements.5"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 location="file:///model/grafcet0011.grafcet#/connections/c6"
                 name="t1_to_Check"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 location="file:///model/grafcet0011.grafcet#/connections/c7"
                 name="t2_to_Run"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c8"
                 location="file:///model/grafcet0011.grafcet#/connections/c8"
                 name="t3_to_RunLoop"
                 from="/0/@elements.8"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c9"
                 location="file:///model/grafcet0011.grafcet#/connections/c9"
                 name="t4_to_Shutdown"
                 from="/0/@elements.9"
                 to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>