<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" location="loc_grafcet_main" name="ComplexGrafcet_0003">
    <!-- Elements: 3 Steps + 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="loc_step_S0" name="S0_Init" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="loc_step_S1" name="S1_Process" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="loc_step_S2" name="S2_Final" isInitial="false" isActive="false" action="shutdown_system"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="loc_trans_T0" name="T0_Start" condition="start_button_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="loc_trans_T1" name="T1_Complete" condition="processing_complete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="loc_trans_T2" name="T2_Reset" condition="reset_triggered"/>

    <!-- Connections: StepToTransition -->
    <!-- S0 -> T0 -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c_st_0"
                 location="loc_conn_ST0"
                 name="C_S0_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.3"/>
    <!-- S1 -> T1 -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c_st_1"
                 location="loc_conn_ST1"
                 name="C_S1_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.4"/>
    <!-- S2 -> T2 -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c_st_2"
                 location="loc_conn_ST2"
                 name="C_S2_T2"
                 from="/0/@elements.2"
                 to="/0/@elements.5"/>

    <!-- Connections: TransitionToStep -->
    <!-- T0 -> S1 -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c_ts_0"
                 location="loc_conn_TS0"
                 name="C_T0_S1"
                 from="/0/@elements.3"
                 to="/0/@elements.1"/>
    <!-- T1 -> S2 -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c_ts_1"
                 location="loc_conn_TS1"
                 name="C_T1_S2"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>
    <!-- T2 -> S0 (loop back) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c_ts_2"
                 location="loc_conn_TS2"
                 name="C_T2_S0"
                 from="/0/@elements.5"
                 to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>