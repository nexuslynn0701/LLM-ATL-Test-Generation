<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file.grafcet#/" name="ComplexGrafcet">
    <!-- Elements: 4 Steps, 3 Transitions -->
    <elements xmi:id="_s0" xsi:type="Grafcet:Step" location="file.grafcet#/s0" name="InitStep" isInitial="true" isActive="true" action="initialize system"/>
    <elements xmi:id="_s1" xsi:type="Grafcet:Step" location="file.grafcet#/s1" name="ProcessingStep" isInitial="false" isActive="false" action="process data"/>
    <elements xmi:id="_s2" xsi:type="Grafcet:Step" location="file.grafcet#/s2" name="DecisionStep" isInitial="false" isActive="false" action="evaluate condition"/>
    <elements xmi:id="_s3" xsi:type="Grafcet:Step" location="file.grafcet#/s3" name="FinalStep" isInitial="false" isActive="false" action="finalize system"/>
    <elements xmi:id="_t0" xsi:type="Grafcet:Transition" location="file.grafcet#/t0" name="T_InitToProc" condition="start == true"/>
    <elements xmi:id="_t1" xsi:type="Grafcet:Transition" location="file.grafcet#/t1" name="T_ProcToDecision" condition="processingDone"/>
    <elements xmi:id="_t2" xsi:type="Grafcet:Transition" location="file.grafcet#/t2" name="T_DecisionToFinal" condition="decision == APPROVED"/>
    <!-- Connections: chain S0 -> T0 -> S1 -> T1 -> S2 -> T2 -> S3 -->
    <connections xmi:id="_c0" xsi:type="Grafcet:StepToTransition" location="file.grafcet#/c0" name="C_Init_to_T0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xmi:id="_c1" xsi:type="Grafcet:TransitionToStep" location="file.grafcet#/c1" name="C_T0_to_Proc" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xmi:id="_c2" xsi:type="Grafcet:StepToTransition" location="file.grafcet#/c2" name="C_Proc_to_T1" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xmi:id="_c3" xsi:type="Grafcet:TransitionToStep" location="file.grafcet#/c3" name="C_T1_to_Decision" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xmi:id="_c4" xsi:type="Grafcet:StepToTransition" location="file.grafcet#/c4" name="C_Decision_to_T2" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xmi:id="_c5" xsi:type="Grafcet:TransitionToStep" location="file.grafcet#/c5" name="C_T2_to_Final" from="/0/@elements.6" to="/0/@elements.3"/>
    <!-- Additional branching: ProcessingStep also connects directly to FinalStep via T1 and T2 -->
    <connections xmi:id="_c6" xsi:type="Grafcet:StepToTransition" location="file.grafcet#/c6" name="C_Proc_to_T2_alt" from="/0/@elements.1" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>