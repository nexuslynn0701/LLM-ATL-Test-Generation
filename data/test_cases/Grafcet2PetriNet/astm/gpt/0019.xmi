<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file:/grafcet/example19.grafcet#/" name="ComplexGrafcet">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="file:/grafcet/example19.grafcet#/s0" name="InitStep" isInitial="true" isActive="true" action="initSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="file:/grafcet/example19.grafcet#/s1" name="LoadConfig" isInitial="false" isActive="false" action="loadConfiguration"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="file:/grafcet/example19.grafcet#/s2" name="RunMain" isInitial="false" isActive="false" action="runMainLoop"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="file:/grafcet/example19.grafcet#/s3" name="ErrorHandler" isInitial="false" isActive="false" action="handleError"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="file:/grafcet/example19.grafcet#/t0" name="T_InitToLoad" condition="configAvailable"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="file:/grafcet/example19.grafcet#/t1" name="T_LoadToRun" condition="loadOk"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="file:/grafcet/example19.grafcet#/t2" name="T_RunToError" condition="errorDetected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="file:/grafcet/example19.grafcet#/t3" name="T_ErrorToInit" condition="reset"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="file:/grafcet/example19.grafcet#/c0" name="C_Init_to_T0" grafcet="/0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" location="file:/grafcet/example19.grafcet#/c1" name="C_T0_to_Load" grafcet="/0" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="file:/grafcet/example19.grafcet#/c2" name="C_Load_to_T1" grafcet="/0" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" location="file:/grafcet/example19.grafcet#/c3" name="C_T1_to_Run" grafcet="/0" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" location="file:/grafcet/example19.grafcet#/c4" name="C_Run_to_T2" grafcet="/0" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="file:/grafcet/example19.grafcet#/c5" name="C_T2_to_Error" grafcet="/0" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" location="file:/grafcet/example19.grafcet#/c6" name="C_Error_to_T3" grafcet="/0" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="file:/grafcet/example19.grafcet#/c7" name="C_T3_to_Init" grafcet="/0" from="/0/@elements.7" to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" location="file:/grafcet/example19.grafcet#/c8" name="C_Run_to_T1_alt" grafcet="/0" from="/0/@elements.2" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>