<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0"
                   location="file://grafcet/complexScenario.gcf"
                   name="ComplexGrafcetExample">

    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              location="file://grafcet/complexScenario.gcf#s1"
              name="InitStep"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              location="file://grafcet/complexScenario.gcf#s2"
              name="CheckSensors"
              isInitial="false"
              isActive="false"
              action="check_sensors"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              location="file://grafcet/complexScenario.gcf#s3"
              name="ProcessData"
              isInitial="false"
              isActive="false"
              action="process_data"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s4"
              location="file://grafcet/complexScenario.gcf#s4"
              name="Finalize"
              isInitial="false"
              isActive="false"
              action="finalize_run"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              location="file://grafcet/complexScenario.gcf#t1"
              name="InitToCheck"
              condition="init_done"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              location="file://grafcet/complexScenario.gcf#t2"
              name="CheckToProcess"
              condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t3"
              location="file://grafcet/complexScenario.gcf#t3"
              name="ProcessToFinalize"
              condition="processing_complete"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t4"
              location="file://grafcet/complexScenario.gcf#t4"
              name="ProcessLoopBack"
              condition="more_data"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 location="file://grafcet/complexScenario.gcf#c1"
                 name="c_Init_to_t1"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 location="file://grafcet/complexScenario.gcf#c2"
                 name="c_s2_to_t2"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 location="file://grafcet/complexScenario.gcf#c3"
                 name="c_s3_to_t3"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c4"
                 location="file://grafcet/complexScenario.gcf#c4"
                 name="c_s3_to_t4"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 location="file://grafcet/complexScenario.gcf#c5"
                 name="c_t1_to_s2"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 location="file://grafcet/complexScenario.gcf#c6"
                 name="c_t2_to_s3"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 location="file://grafcet/complexScenario.gcf#c7"
                 name="c_t3_to_s4"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c8"
                 location="file://grafcet/complexScenario.gcf#c8"
                 name="c_t4_to_s3"
                 from="/0/@elements.7"
                 to="/0/@elements.2"/>

  </Grafcet:Grafcet>
</xmi:XMI>