<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" location="loc:/grafcet/main" name="ComplexGrafcet0055">
    <!-- Elements: 4 Steps and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="loc:/grafcet/main#s0" name="InitStep" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="loc:/grafcet/main#s1" name="ProcessStepA" isInitial="false" isActive="false" action="processA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="loc:/grafcet/main#s2" name="ProcessStepB" isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="loc:/grafcet/main#s3" name="FinalStep" isInitial="false" isActive="false" action="finalize"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="loc:/grafcet/main#t0" name="T_Init_to_A" condition="condInitToA"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="loc:/grafcet/main#t1" name="T_A_to_B" condition="condAToB"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="loc:/grafcet/main#t2" name="T_B_to_Final" condition="condBToFinal"/>

    <!-- Connections: StepToTransition (PlaceToTransition in target) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 location="loc:/grafcet/main#c0"
                 name="C_Init_to_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 location="loc:/grafcet/main#c1"
                 name="C_A_to_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 location="loc:/grafcet/main#c2"
                 name="C_B_to_T2"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>

    <!-- Connections: TransitionToStep (TransitionToPlace in target) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c3"
                 location="loc:/grafcet/main#c3"
                 name="C_T0_to_A"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 location="loc:/grafcet/main#c4"
                 name="C_T1_to_B"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 location="loc:/grafcet/main#c5"
                 name="C_T2_to_Final"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>