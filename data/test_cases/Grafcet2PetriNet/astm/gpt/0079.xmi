<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="g1" name="ComplexGrafcet" location="file.grafcet:1">
    <elements xsi:type="Grafcet:Step"
              xmi:id="s1"
              name="InitStep"
              location="file.grafcet:3"
              isInitial="true"
              isActive="true"
              action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="s2"
              name="CheckSensors"
              location="file.grafcet:5"
              isInitial="false"
              isActive="false"
              action="checkAllSensors"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="s3"
              name="ProcessData"
              location="file.grafcet:7"
              isInitial="false"
              isActive="false"
              action="processInputData"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="s4"
              name="Finalize"
              location="file.grafcet:9"
              isInitial="false"
              isActive="false"
              action="shutdownSequence"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t1"
              name="T_InitToCheck"
              location="file.grafcet:11"
              condition="startSignal==true"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t2"
              name="T_CheckToProcess"
              location="file.grafcet:13"
              condition="sensorsOk==true"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t3"
              name="T_ProcessToFinalize"
              location="file.grafcet:15"
              condition="processingDone==true"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t4"
              name="T_LoopToInit"
              location="file.grafcet:17"
              condition="restartRequested==true"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c1"
                 name="Arc_Init_Check"
                 location="file.grafcet:21"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c2"
                 name="Arc_Check_Process"
                 location="file.grafcet:23"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c3"
                 name="Arc_Process_Finalize"
                 location="file.grafcet:25"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c4"
                 name="Arc_Finalize_Init"
                 location="file.grafcet:27"
                 from="/0/@elements.7"
                 to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c5"
                 name="Arc_Check_AltProcess"
                 location="file.grafcet:29"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c6"
                 name="Arc_AltProcess_Finalize"
                 location="file.grafcet:31"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>