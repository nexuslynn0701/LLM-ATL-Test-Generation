<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file://grafcet/example12.grafcet" name="ComplexGrafcet">
    <!-- Elements: 4 Steps and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="file://grafcet/example12.grafcet#s0" name="InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="file://grafcet/example12.grafcet#s1" name="CheckSensors" isInitial="false" isActive="false" action="readSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="file://grafcet/example12.grafcet#s2" name="ProcessData" isInitial="false" isActive="false" action="computeValues"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="file://grafcet/example12.grafcet#s3" name="Shutdown" isInitial="false" isActive="false" action="releaseResources"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="file://grafcet/example12.grafcet#t0" name="T_Init_To_Check" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="file://grafcet/example12.grafcet#t1" name="T_Check_To_Process" condition="sensorsOk"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="file://grafcet/example12.grafcet#t2" name="T_Process_To_Shutdown" condition="stopRequested"/>

    <!-- Connections: StepToTransition (PlaceToTransition in target) -->
    <!-- s0 -> t0, s1 -> t1, s2 -> t2, s3 -> t1 (multiple incoming to t1) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="file://grafcet/example12.grafcet#c0" name="C_Init_To_T0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" location="file://grafcet/example12.grafcet#c1" name="C_S1_To_T1" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="file://grafcet/example12.grafcet#c2" name="C_S2_To_T2" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" location="file://grafcet/example12.grafcet#c3" name="C_S3_To_T1_Alt" from="/0/@elements.3" to="/0/@elements.5"/>

    <!-- Connections: TransitionToStep (TransitionToPlace in target) -->
    <!-- t0 -> s1, t1 -> s2 and s3 (branching), t2 -> s0 (loop back to initial) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" location="file://grafcet/example12.grafcet#c4" name="C_T0_To_S1" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="file://grafcet/example12.grafcet#c5" name="C_T1_To_S2" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" location="file://grafcet/example12.grafcet#c6" name="C_T1_To_S3" from="/0/@elements.5" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="file://grafcet/example12.grafcet#c7" name="C_T2_To_S0_Loop" from="/0/@elements.6" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>