<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="(0,0,100,100)" name="ComplexGrafcet0061">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="(10,10,40,40)" name="InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="(60,10,40,40)" name="ProcessStep1" isInitial="false" isActive="false" action="processStage1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="(110,10,40,40)" name="ProcessStep2" isInitial="false" isActive="false" action="processStage2"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="(160,10,40,40)" name="FinalStep" isInitial="false" isActive="false" action="finalizeSystem"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="(35,60,30,30)" name="T_Init_to_P1" condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="(85,60,30,30)" name="T_P1_to_P2" condition="stage1Done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="(135,60,30,30)" name="T_P2_to_Final" condition="stage2Done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="(60,110,30,30)" name="T_LoopBack" condition="retryRequired"/>
    <!-- Connections Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="(25,35,20,20)" name="C_Init_to_T0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" location="(75,35,20,20)" name="C_P1_to_T1" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="(125,35,20,20)" name="C_P2_to_T2" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" location="(55,85,20,20)" name="C_Final_to_T3" from="/0/@elements.3" to="/0/@elements.7"/>
    <!-- Connections Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" location="(35,75,20,20)" name="C_T0_to_P1" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="(85,75,20,20)" name="C_T1_to_P2" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" location="(135,75,20,20)" name="C_T2_to_Final" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="(45,125,20,20)" name="C_T3_to_P1" from="/0/@elements.7" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>