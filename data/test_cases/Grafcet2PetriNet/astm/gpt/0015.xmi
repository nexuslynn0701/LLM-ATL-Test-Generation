<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" location="loc:/grafcet/complex0015" name="ComplexGrafcet0015">

    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              location="loc:/grafcet/complex0015#S0"
              name="InitStep"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              location="loc:/grafcet/complex0015#S1"
              name="CheckInput"
              isInitial="false"
              isActive="false"
              action="check_input_values"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              location="loc:/grafcet/complex0015#S2"
              name="ProcessData"
              isInitial="false"
              isActive="false"
              action="process_data_main"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              location="loc:/grafcet/complex0015#S3"
              name="ErrorHandler"
              isInitial="false"
              isActive="false"
              action="handle_error_state"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              location="loc:/grafcet/complex0015#T0"
              name="T_InitToCheck"
              condition="init_done"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              location="loc:/grafcet/complex0015#T1"
              name="T_CheckToProcess"
              condition="inputs_valid"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              location="loc:/grafcet/complex0015#T2"
              name="T_CheckToError"
              condition="inputs_invalid"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t3"
              location="loc:/grafcet/complex0015#T3"
              name="T_ErrorToInit"
              condition="reset_requested"/>

    <!-- StepToTransition connections (PlaceToTransition rule triggers) -->
    <!-- S0 -> T0 -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 location="loc:/grafcet/complex0015#C0"
                 name="C_S0_T0"
                 grafcet="/0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <!-- S1 -> T1 -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 location="loc:/grafcet/complex0015#C1"
                 name="C_S1_T1"
                 grafcet="/0"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <!-- S1 -> T2 (branch) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 location="loc:/grafcet/complex0015#C2"
                 name="C_S1_T2"
                 grafcet="/0"
                 from="/0/@elements.1"
                 to="/0/@elements.6"/>
    <!-- S3 -> T3 -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 location="loc:/grafcet/complex0015#C3"
                 name="C_S3_T3"
                 grafcet="/0"
                 from="/0/@elements.3"
                 to="/0/@elements.7"/>

    <!-- TransitionToStep connections (TransitionToPlace rule triggers) -->
    <!-- T0 -> S1 -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 location="loc:/grafcet/complex0015#C4"
                 name="C_T0_S1"
                 grafcet="/0"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <!-- T1 -> S2 -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 location="loc:/grafcet/complex0015#C5"
                 name="C_T1_S2"
                 grafcet="/0"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <!-- T2 -> S3 -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 location="loc:/grafcet/complex0015#C6"
                 name="C_T2_S3"
                 grafcet="/0"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <!-- T3 -> S0 (loop back to initial) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 location="loc:/grafcet/complex0015#C7"
                 name="C_T3_S0"
                 grafcet="/0"
                 from="/0/@elements.7"
                 to="/0/@elements.0"/>

  </Grafcet:Grafcet>
</xmi:XMI>