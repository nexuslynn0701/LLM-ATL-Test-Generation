<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file://grafcet0072.gct" name="ComplexCycleGrafcet">
    <!-- Elements: 3 Steps and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="file://grafcet0072.gct#s0" name="InitStep" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="file://grafcet0072.gct#s1" name="ProcessingStep" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="file://grafcet0072.gct#s2" name="FinalStep" isInitial="false" isActive="false" action="finalize"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="file://grafcet0072.gct#t0" name="T_Init_to_Proc" condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="file://grafcet0072.gct#t1" name="T_Proc_to_Final" condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="file://grafcet0072.gct#t2" name="T_Final_to_Init" condition="resetSignal"/>

    <!-- Connections: chain forming a cycle plus an additional branch -->
    <!-- InitStep -> T_Init_to_Proc -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="file://grafcet0072.gct#c0" name="Arc_Init_to_T0" from="/0/@elements.0" to="/0/@elements.3"/>
    <!-- T_Init_to_Proc -> ProcessingStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" location="file://grafcet0072.gct#c1" name="Arc_T0_to_Proc" from="/0/@elements.3" to="/0/@elements.1"/>
    <!-- ProcessingStep -> T_Proc_to_Final -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="file://grafcet0072.gct#c2" name="Arc_Proc_to_T1" from="/0/@elements.1" to="/0/@elements.4"/>
    <!-- T_Proc_to_Final -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" location="file://grafcet0072.gct#c3" name="Arc_T1_to_Final" from="/0/@elements.4" to="/0/@elements.2"/>
    <!-- FinalStep -> T_Final_to_Init -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" location="file://grafcet0072.gct#c4" name="Arc_Final_to_T2" from="/0/@elements.2" to="/0/@elements.5"/>
    <!-- T_Final_to_Init -> InitStep (closing the cycle) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="file://grafcet0072.gct#c5" name="Arc_T2_to_Init" from="/0/@elements.5" to="/0/@elements.0"/>

    <!-- Additional branch: InitStep -> T_Proc_to_Final directly (StepToTransition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" location="file://grafcet0072.gct#c6" name="Arc_Init_direct_to_T1" from="/0/@elements.0" to="/0/@elements.4"/>
    <!-- Additional branch: T_Init_to_Proc -> FinalStep directly (TransitionToStep) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="file://grafcet0072.gct#c7" name="Arc_T0_direct_to_Final" from="/0/@elements.3" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>