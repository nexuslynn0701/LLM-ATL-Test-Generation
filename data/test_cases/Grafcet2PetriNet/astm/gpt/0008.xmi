    <elements xsi:type="Grafcet:Step" xmi:id="_S2" location="file://grafcet_complex.grafcet#S2" name="ProcessStepB" isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" location="file://grafcet_complex.grafcet#S3" name="FinalStep" isInitial="false" isActive="false" action="finalize"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" location="file://grafcet_complex.grafcet#T0" name="T_Init_to_A" condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" location="file://grafcet_complex.grafcet#T1" name="T_A_to_B" condition="A_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" location="file://grafcet_complex.grafcet#T2" name="T_B_to_Final" condition="B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" location="file://grafcet_complex.grafcet#T3" name="T_Final_to_Init" condition="resetRequested"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" location="file://grafcet_complex.grafcet#C0" name="Arc_S0_T0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" location="file://grafcet_complex.grafcet#C1" name="Arc_T0_S1" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" location="file://grafcet_complex.grafcet#C2" name="Arc_S1_T1" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C3" location="file://grafcet_complex.grafcet#C3" name="Arc_T1_S2" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" location="file://grafcet_complex.grafcet#C4" name="Arc_S2_T2" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" location="file://grafcet_complex.grafcet#C5" name="Arc_T2_S3" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" location="file://grafcet_complex.grafcet#C6" name="Arc_S3_T3" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" location="file://grafcet_complex.grafcet#C7" name="Arc_T3_S0" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
