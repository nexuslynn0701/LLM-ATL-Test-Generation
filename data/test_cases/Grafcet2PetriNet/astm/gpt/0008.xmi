<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" location="file://grafcet_complex.grafcet" name="ComplexGrafcet">
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" location="file://grafcet_complex.grafcet#S0" name="InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
