<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_grafcet1" name="ComplexGrafcet" location="model/ComplexGrafcet.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_step1" name="InitStep" location="line:1,col:1" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step2" name="ProcessingStep" location="line:5,col:1" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step3" name="DecisionStep" location="line:10,col:1" isInitial="false" isActive="false" action="evaluateCondition"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step4" name="FinalStep" location="line:15,col:1" isInitial="false" isActive="false" action="finalizeSystem"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans1" name="T_InitToProcess" location="line:3,col:5" condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans2" name="T_ProcessToDecision" location="line:8,col:5" condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans3" name="T_DecisionToFinal" location="line:13,col:5" condition="conditionTrue"/>
    <!-- Step->Transition connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_st1" name="Arc_Init_to_T1" location="line:2,col:10" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_st2" name="Arc_Process_to_T2" location="line:7,col:10" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_st3" name="Arc_Decision_to_T3" location="line:12,col:10" from="/0/@elements.2" to="/0/@elements.6"/>
    <!-- Transition->Step connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_ts1" name="Arc_T1_to_Process" location="line:4,col:10" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_ts2" name="Arc_T2_to_Decision" location="line:9,col:10" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_ts3" name="Arc_T3_to_Final" location="line:14,col:10" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>