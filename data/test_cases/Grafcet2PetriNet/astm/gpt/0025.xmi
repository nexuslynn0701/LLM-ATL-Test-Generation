<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="loc_g0" name="ComplexGrafcet0025">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="loc_s0" name="InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="loc_s1" name="ProcessingStep" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="loc_s2" name="FinalStep" isInitial="false" isActive="false" action="shutdown"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="loc_t0" name="T_InitToProc" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="loc_t1" name="T_ProcToFinal" condition="processing_complete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="loc_t2" name="T_LoopBack" condition="retry_requested"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="loc_c0" name="C_Init_to_T0" grafcet="/0" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" location="loc_c1" name="C_T0_to_S1" grafcet="/0" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="loc_c2" name="C_S1_to_T1" grafcet="/0" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" location="loc_c3" name="C_T1_to_S2" grafcet="/0" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" location="loc_c4" name="C_S1_to_T2" grafcet="/0" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="loc_c5" name="C_T2_to_S1" grafcet="/0" from="/0/@elements.5" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>