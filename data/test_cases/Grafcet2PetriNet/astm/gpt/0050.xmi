<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0"
                   name="ComplexGrafcet"
                   location="file:/models/grafcet/complex_0050.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              name="InitStep"
              location="line 1"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="LoadStep"
              location="line 5"
              isInitial="false"
              isActive="false"
              action="load_data"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="ProcessStep"
              location="line 10"
              isInitial="false"
              isActive="false"
              action="process_data"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              name="FinalizeStep"
              location="line 15"
              isInitial="false"
              isActive="false"
              action="finalize_and_cleanup"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              name="InitToLoad"
              location="line 20"
              condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="LoadToProcess"
              location="line 25"
              condition="data_loaded"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="ProcessToFinalize"
              location="line 30"
              condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t3"
              name="LoopBack"
              location="line 35"
              condition="repeat_requested"/>
    <!-- StepToTransition connections (PlaceToTransition in target) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="C_Init_to_T0"
                 location="line 40"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="C_Load_to_T1"
                 location="line 41"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="C_Process_to_T2"
                 location="line 42"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <!-- Extra StepToTransition from two different steps into same transition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 name="C_Finalize_to_T3"
                 location="line 43"
                 from="/0/@elements.3"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c4"
                 name="C_Init_to_T3"
                 location="line 44"
                 from="/0/@elements.0"
                 to="/0/@elements.7"/>
    <!-- TransitionToStep connections (TransitionToPlace in target) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 name="C_T0_to_Load"
                 location="line 50"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 name="C_T1_to_Process"
                 location="line 51"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 name="C_T2_to_Finalize"
                 location="line 52"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <!-- Loop-back connection from Transition to initial Step -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c8"
                 name="C_T3_to_Init"
                 location="line 53"
                 from="/0/@elements.7"
                 to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>