<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file://grafcet_model_0088.grafcet" name="ComplexProcess">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="file://grafcet_model_0088.grafcet#s0" name="InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="file://grafcet_model_0088.grafcet#s1" name="CheckSensors" isInitial="false" isActive="false" action="readSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="file://grafcet_model_0088.grafcet#s2" name="ProcessData" isInitial="false" isActive="false" action="computeResults"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="file://grafcet_model_0088.grafcet#s3" name="ErrorHandler" isInitial="false" isActive="false" action="handleError"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="file://grafcet_model_0088.grafcet#t0" name="toCheck" condition="init_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="file://grafcet_model_0088.grafcet#t1" name="toProcess" condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="file://grafcet_model_0088.grafcet#t2" name="toError" condition="error_detected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="file://grafcet_model_0088.grafcet#t3" name="recheck" condition="retry"/>

    <!-- StepToTransition connections (PlaceToTransition in target) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="file://grafcet_model_0088.grafcet#c0" name="Init_to_t0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" location="file://grafcet_model_0088.grafcet#c1" name="Check_to_t1" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="file://grafcet_model_0088.grafcet#c2" name="Check_to_t2" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" location="file://grafcet_model_0088.grafcet#c3" name="Process_to_t3" from="/0/@elements.2" to="/0/@elements.7"/>

    <!-- TransitionToStep connections (TransitionToPlace in target) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" location="file://grafcet_model_0088.grafcet#c4" name="t0_to_Check" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="file://grafcet_model_0088.grafcet#c5" name="t1_to_Process" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" location="file://grafcet_model_0088.grafcet#c6" name="t2_to_Error" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="file://grafcet_model_0088.grafcet#c7" name="t3_to_Check" from="/0/@elements.7" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>