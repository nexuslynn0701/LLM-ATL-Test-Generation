<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0"
    location="file:///models/grafcet0035.grafcet#/"
    name="ComplexGrafcet0035">

    <!-- Elements: 4 Steps and 3 Transitions -->
    <elements xsi:type="Grafcet:Step"
      xmi:id="_s0"
      location="file:///models/grafcet0035.grafcet#/steps/s0"
      name="InitStep"
      isInitial="true"
      isActive="true"
      action="initialize_system"/>

    <elements xsi:type="Grafcet:Step"
      xmi:id="_s1"
      location="file:///models/grafcet0035.grafcet#/steps/s1"
      name="LoadStep"
      isInitial="false"
      isActive="false"
      action="load_material"/>

    <elements xsi:type="Grafcet:Step"
      xmi:id="_s2"
      location="file:///models/grafcet0035.grafcet#/steps/s2"
      name="ProcessStep"
      isInitial="false"
      isActive="false"
      action="run_processing"/>

    <elements xsi:type="Grafcet:Step"
      xmi:id="_s3"
      location="file:///models/grafcet0035.grafcet#/steps/s3"
      name="FinalStep"
      isInitial="false"
      isActive="false"
      action="shutdown_system"/>

    <elements xsi:type="Grafcet:Transition"
      xmi:id="_t0"
      location="file:///models/grafcet0035.grafcet#/transitions/t0"
      name="T_InitToLoad"
      condition="start_button_pressed"/>

    <elements xsi:type="Grafcet:Transition"
      xmi:id="_t1"
      location="file:///models/grafcet0035.grafcet#/transitions/t1"
      name="T_LoadToProcess"
      condition="load_complete"/>

    <elements xsi:type="Grafcet:Transition"
      xmi:id="_t2"
      location="file:///models/grafcet0035.grafcet#/transitions/t2"
      name="T_ProcessToFinal"
      condition="process_finished"/>

    <!-- Connections: chain S0->T0->S1->T1->S2->T2->S3 plus a backward loop S2->T1 and a shortcut S1->T2 -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c0"
      location="file:///models/grafcet0035.grafcet#/connections/c0"
      name="C_S0_T0"
      from="/0/@elements.0"
      to="/0/@elements.4"/>

    <connections xsi:type="Grafcet:TransitionToStep"
      xmi:id="_c1"
      location="file:///models/grafcet0035.grafcet#/connections/c1"
      name="C_T0_S1"
      from="/0/@elements.4"
      to="/0/@elements.1"/>

    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c2"
      location="file:///models/grafcet0035.grafcet#/connections/c2"
      name="C_S1_T1"
      from="/0/@elements.1"
      to="/0/@elements.5"/>

    <connections xsi:type="Grafcet:TransitionToStep"
      xmi:id="_c3"
      location="file:///models/grafcet0035.grafcet#/connections/c3"
      name="C_T1_S2"
      from="/0/@elements.5"
      to="/0/@elements.2"/>

    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c4"
      location="file:///models/grafcet0035.grafcet#/connections/c4"
      name="C_S2_T2"
      from="/0/@elements.2"
      to="/0/@elements.6"/>

    <connections xsi:type="Grafcet:TransitionToStep"
      xmi:id="_c5"
      location="file:///models/grafcet0035.grafcet#/connections/c5"
      name="C_T2_S3"
      from="/0/@elements.6"
      to="/0/@elements.3"/>

    <!-- Backward loop: S2 -> T1 -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c6"
      location="file:///models/grafcet0035.grafcet#/connections/c6"
      name="C_S2_T1_Back"
      from="/0/@elements.2"
      to="/0/@elements.5"/>

    <!-- Shortcut: S1 -> T2 -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c7"
      location="file:///models/grafcet0035.grafcet#/connections/c7"
      name="C_S1_T2_Skip"
      from="/0/@elements.1"
      to="/0/@elements.6"/>

  </Grafcet:Grafcet>
</xmi:XMI>