<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" location="loc_grafcet_main" name="ComplexGrafcet">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" location="loc_step_A" name="StepA" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" location="loc_step_B" name="StepB" isInitial="false" isActive="false" action="check_inputs"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" location="loc_step_C" name="StepC" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.3" location="loc_trans_T1" name="TransT1" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" location="loc_trans_T2" name="TransT2" condition="inputs_valid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" location="loc_trans_T3" name="TransT3" condition="processing_done"/>

    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" location="loc_conn_ST1" name="A_to_T1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.1" location="loc_conn_TS1" name="T1_to_B" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" location="loc_conn_ST2" name="B_to_T2" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" location="loc_conn_TS2" name="T2_to_C" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.4" location="loc_conn_ST3" name="C_to_T3" from="/0/@elements.2" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5" location="loc_conn_TS3" name="T3_to_A" from="/0/@elements.5" to="/0/@elements.0"/>
  </Grafcet:Grafcet>

</xmi:XMI>