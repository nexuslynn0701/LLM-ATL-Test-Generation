<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="loc:/grafcet/main" name="ComplexGrafcet0018">
    <!-- Elements -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="loc:/grafcet/main#S0" name="InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="loc:/grafcet/main#S1" name="ProcessStepA" isInitial="false" isActive="false" action="process_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="loc:/grafcet/main#S2" name="ProcessStepB" isInitial="false" isActive="false" action="process_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="loc:/grafcet/main#S3" name="FinalStep" isInitial="false" isActive="false" action="finalize_system"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="loc:/grafcet/main#T0" name="InitToA" condition="cond_init_to_A"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="loc:/grafcet/main#T1" name="AToB" condition="cond_A_to_B"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="loc:/grafcet/main#T2" name="LoopBack" condition="cond_loop_back"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="loc:/grafcet/main#T3" name="BToFinal" condition="cond_B_to_final"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 location="loc:/grafcet/main#C0"
                 name="Init_to_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 location="loc:/grafcet/main#C1"
                 name="S1_to_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 location="loc:/grafcet/main#C2"
                 name="S2_to_T3"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 location="loc:/grafcet/main#C3"
                 name="Final_to_T2"
                 from="/0/@elements.3"
                 to="/0/@elements.6"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 location="loc:/grafcet/main#C4"
                 name="T0_to_S1"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 location="loc:/grafcet/main#C5"
                 name="T1_to_S2"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 location="loc:/grafcet/main#C6"
                 name="T3_to_Final"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 location="loc:/grafcet/main#C7"
                 name="T2_to_Init"
                 from="/0/@elements.6"
                 to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>