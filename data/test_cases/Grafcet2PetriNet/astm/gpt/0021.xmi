<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file.grafcet#/" name="ComplexGrafcet0021">
    <!-- Elements: 4 Steps and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="file.grafcet#/s0" name="InitStep" isInitial="true" isActive="true" action="initAction()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="file.grafcet#/s1" name="MiddleStepA" isInitial="false" isActive="false" action="computeA()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="file.grafcet#/s2" name="MiddleStepB" isInitial="false" isActive="false" action="computeB()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="file.grafcet#/s3" name="FinalStep" isInitial="false" isActive="false" action="finalize()"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="file.grafcet#/t0" name="T_Init_to_A" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="file.grafcet#/t1" name="T_A_to_B" condition="y &lt; 5"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="file.grafcet#/t2" name="T_B_to_Final" condition="z = 1"/>

    <!-- Connections: sequence with a small branch and reconvergence -->
    <!-- InitStep -> T_Init_to_A -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="file.grafcet#/c0" name="C_Init_T0" from="/0/@elements.0" to="/0/@elements.4"/>
    <!-- T_Init_to_A -> MiddleStepA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" location="file.grafcet#/c1" name="C_T0_S1" from="/0/@elements.4" to="/0/@elements.1"/>

    <!-- MiddleStepA -> T_A_to_B -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="file.grafcet#/c2" name="C_S1_T1" from="/0/@elements.1" to="/0/@elements.5"/>
    <!-- T_A_to_B -> MiddleStepB -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" location="file.grafcet#/c3" name="C_T1_S2" from="/0/@elements.5" to="/0/@elements.2"/>

    <!-- MiddleStepB -> T_B_to_Final -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" location="file.grafcet#/c4" name="C_S2_T2" from="/0/@elements.2" to="/0/@elements.6"/>
    <!-- T_B_to_Final -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="file.grafcet#/c5" name="C_T2_S3" from="/0/@elements.6" to="/0/@elements.3"/>

    <!-- Additional branch: InitStep also directly to T_A_to_B, and T_A_to_B back to MiddleStepA (loop) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" location="file.grafcet#/c6" name="C_Init_T1" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="file.grafcet#/c7" name="C_T1_S1_loop" from="/0/@elements.5" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>