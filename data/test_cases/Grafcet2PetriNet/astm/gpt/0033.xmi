<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="g0" location="file:///model/grafcet_0033.gcf" name="ProductionCycle">
    <!-- Elements: 3 Steps and 2 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="s0" location="1:1-1:40" name="InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s1" location="2:1-2:45" name="ProcessingStep" isInitial="false" isActive="false" action="processBatch"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s2" location="3:1-3:42" name="FinalStep" isInitial="false" isActive="false" action="shutdownSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="t0" location="4:1-4:38" name="StartProcessing" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t1" location="5:1-5:41" name="FinishProcessing" condition="batchCompleted"/>

    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- InitStep -> StartProcessing -->
    <connections xsi:type="Grafcet:StepToTransition"
        xmi:id="c0"
        location="6:1-6:50"
        name="Init_to_Start"
        from="/0/@elements.0"
        to="/0/@elements.3"/>

    <!-- StartProcessing -> ProcessingStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
        xmi:id="c1"
        location="7:1-7:52"
        name="Start_to_Processing"
        from="/0/@elements.3"
        to="/0/@elements.1"/>

    <!-- ProcessingStep -> FinishProcessing -->
    <connections xsi:type="Grafcet:StepToTransition"
        xmi:id="c2"
        location="8:1-8:55"
        name="Processing_to_Finish"
        from="/0/@elements.1"
        to="/0/@elements.4"/>

    <!-- FinishProcessing -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
        xmi:id="c3"
        location="9:1-9:50"
        name="Finish_to_Final"
        from="/0/@elements.4"
        to="/0/@elements.2"/>

    <!-- Additional back-loop: FinalStep -> StartProcessing (creates a cycle) -->
    <connections xsi:type="Grafcet:StepToTransition"
        xmi:id="c4"
        location="10:1-10:60"
        name="Final_to_Start"
        from="/0/@elements.2"
        to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>