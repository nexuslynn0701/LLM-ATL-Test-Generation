<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file:///model/grafcet0082.grafcet" name="ComplexGrafcet_0082">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="1:1-1:40" name="InitStep" isInitial="true" isActive="true" action="initializeSystem()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="2:1-2:45" name="LoadConfig" isInitial="false" isActive="false" action="loadConfiguration()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="3:1-3:45" name="ValidateConfig" isInitial="false" isActive="false" action="validateConfiguration()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="4:1-4:40" name="RunMainLoop" isInitial="false" isActive="false" action="runMainLoop()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" location="5:1-5:40" name="ErrorHandler" isInitial="false" isActive="false" action="handleError()"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="10:1-10:40" name="T_InitToLoad" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="11:1-11:45" name="T_LoadToValidate" condition="configLoaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="12:1-12:45" name="T_ValidateToRun" condition="configValid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="13:1-13:45" name="T_ValidateToError" condition="configInvalid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" location="14:1-14:45" name="T_ErrorToInit" condition="errorCleared"/>

    <!-- StepToTransition connections (PlaceToTransition in target) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="20:1-20:60" name="C_Init_to_T0" grafcet="/0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" location="21:1-21:60" name="C_Load_to_T1" grafcet="/0" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="22:1-22:60" name="C_Validate_to_T2" grafcet="/0" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" location="23:1-23:60" name="C_Validate_to_T3" grafcet="/0" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" location="24:1-24:60" name="C_Error_to_T4" grafcet="/0" from="/0/@elements.4" to="/0/@elements.9"/>

    <!-- TransitionToStep connections (TransitionToPlace in target) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="30:1-30:60" name="C_T0_to_Load" grafcet="/0" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" location="31:1-31:60" name="C_T1_to_Validate" grafcet="/0" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="32:1-32:60" name="C_T2_to_Run" grafcet="/0" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" location="33:1-33:60" name="C_T3_to_Error" grafcet="/0" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" location="34:1-34:60" name="C_T4_to_Init" grafcet="/0" from="/0/@elements.9" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>