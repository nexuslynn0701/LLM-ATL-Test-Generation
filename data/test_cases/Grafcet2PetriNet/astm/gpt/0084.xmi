<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ProductionLineController" location="plant:A1">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="Init" location="plant:A1:Init" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="Load" location="plant:A1:Load" isInitial="false" isActive="false" action="load_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="Process" location="plant:A1:Process" isInitial="false" isActive="false" action="start_processing"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="Unload" location="plant:A1:Unload" isInitial="false" isActive="false" action="unload_product"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="t_Init_to_Load" location="plant:A1:t0" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="t_Load_to_Process" location="plant:A1:t1" condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="t_Process_to_Unload" location="plant:A1:t2" condition="process_complete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="t_Unload_to_Load" location="plant:A1:t3" condition="unload_done"/>

    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- Linear path: Init -> t0 -> Load -> t1 -> Process -> t2 -> Unload -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="c_Init_to_t0"
                 location="plant:A1:c0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c1"
                 name="c_t0_to_Load"
                 location="plant:A1:c1"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>

    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="c_Load_to_t1"
                 location="plant:A1:c2"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c3"
                 name="c_t1_to_Process"
                 location="plant:A1:c3"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>

    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c4"
                 name="c_Process_to_t2"
                 location="plant:A1:c4"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 name="c_t2_to_Unload"
                 location="plant:A1:c5"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>

    <!-- Loop back: Unload -> t3 -> Load (cycle in the grafcet) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c6"
                 name="c_Unload_to_t3"
                 location="plant:A1:c6"
                 from="/0/@elements.3"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 name="c_t3_to_Load"
                 location="plant:A1:c7"
                 from="/0/@elements.7"
                 to="/0/@elements.1"/>
  </Grafcet:Grafcet>

</xmi:XMI>