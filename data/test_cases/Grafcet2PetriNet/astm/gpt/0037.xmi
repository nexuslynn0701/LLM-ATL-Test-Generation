<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0"
                   location="(0,0)"
                   name="ComplexProcess">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              location="(10,10)"
              name="InitStep"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              location="(20,10)"
              name="ValidationStep"
              isInitial="false"
              isActive="false"
              action="validate_inputs"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              location="(30,10)"
              name="ProcessingStep"
              isInitial="false"
              isActive="false"
              action="process_data"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              location="(40,10)"
              name="FinalStep"
              isInitial="false"
              isActive="false"
              action="finalize_and_cleanup"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              location="(15,20)"
              name="T_InitToValidation"
              condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              location="(25,20)"
              name="T_ValidationToProcessing"
              condition="inputs_valid"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              location="(35,20)"
              name="T_ProcessingToFinal"
              condition="processing_done"/>
    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 location="(12,15)"
                 name="C_Init_to_T0"
                 grafcet="/0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 location="(22,15)"
                 name="C_Validation_to_T1"
                 grafcet="/0"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 location="(32,15)"
                 name="C_Processing_to_T2"
                 grafcet="/0"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c3"
                 location="(18,25)"
                 name="C_T0_to_Validation"
                 grafcet="/0"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 location="(28,25)"
                 name="C_T1_to_Processing"
                 grafcet="/0"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 location="(38,25)"
                 name="C_T2_to_Final"
                 grafcet="/0"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>