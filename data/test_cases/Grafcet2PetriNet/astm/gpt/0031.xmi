<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" location="file:///grafcet0031.grafcet" name="ComplexProcess">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="1:1-1:50" name="InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="2:1-2:50" name="LoadConfig" isInitial="false" isActive="false" action="load_configuration"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="3:1-3:50" name="RunMainLoop" isInitial="false" isActive="false" action="execute_main_loop"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="4:1-4:50" name="ErrorHandler" isInitial="false" isActive="false" action="handle_error"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="10:1-10:40" name="T_InitToLoad" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="11:1-11:40" name="T_LoadToRun" condition="config_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="12:1-12:40" name="T_RunToError" condition="fault_detected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="13:1-13:40" name="T_ErrorToInit" condition="reset_signal"/>

    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- Linear chain with loop back and branching to exercise all rules -->

    <!-- InitStep -> T_InitToLoad -->
    <connections xsi:type="Grafcet:StepToTransition"
                xmi:id="_c0"
                location="20:1-20:40"
                name="C_Init_to_T0"
                from="/0/@elements.0"
                to="/0/@elements.4"/>
    <!-- T_InitToLoad -> LoadConfig -->
    <connections xsi:type="Grafcet:TransitionToStep"
                xmi:id="_c1"
                location="21:1-21:40"
                name="C_T0_to_Load"
                from="/0/@elements.4"
                to="/0/@elements.1"/>

    <!-- LoadConfig -> T_LoadToRun -->
    <connections xsi:type="Grafcet:StepToTransition"
                xmi:id="_c2"
                location="22:1-22:40"
                name="C_Load_to_T1"
                from="/0/@elements.1"
                to="/0/@elements.5"/>
    <!-- T_LoadToRun -> RunMainLoop -->
    <connections xsi:type="Grafcet:TransitionToStep"
                xmi:id="_c3"
                location="23:1-23:40"
                name="C_T1_to_Run"
                from="/0/@elements.5"
                to="/0/@elements.2"/>

    <!-- RunMainLoop -> T_RunToError -->
    <connections xsi:type="Grafcet:StepToTransition"
                xmi:id="_c4"
                location="24:1-24:40"
                name="C_Run_to_T2"
                from="/0/@elements.2"
                to="/0/@elements.6"/>
    <!-- T_RunToError -> ErrorHandler -->
    <connections xsi:type="Grafcet:TransitionToStep"
                xmi:id="_c5"
                location="25:1-25:40"
                name="C_T2_to_Error"
                from="/0/@elements.6"
                to="/0/@elements.3"/>

    <!-- ErrorHandler -> T_ErrorToInit (loop back to InitStep) -->
    <connections xsi:type="Grafcet:StepToTransition"
                xmi:id="_c6"
                location="26:1-26:40"
                name="C_Error_to_T3"
                from="/0/@elements.3"
                to="/0/@elements.7"/>
    <!-- T_ErrorToInit -> InitStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                xmi:id="_c7"
                location="27:1-27:40"
                name="C_T3_to_Init"
                from="/0/@elements.7"
                to="/0/@elements.0"/>

    <!-- Additional branching from LoadConfig to ErrorHandler through T_RunToError -->
    <!-- LoadConfig -> T_RunToError (alternative path) -->
    <connections xsi:type="Grafcet:StepToTransition"
                xmi:id="_c8"
                location="28:1-28:40"
                name="C_Load_to_T2_alt"
                from="/0/@elements.1"
                to="/0/@elements.6"/>
    <!-- T_RunToError -> LoadConfig (recovery path) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                xmi:id="_c9"
                location="29:1-29:40"
                name="C_T2_to_Load_recover"
                from="/0/@elements.6"
                to="/0/@elements.1"/>

  </Grafcet:Grafcet>
</xmi:XMI>