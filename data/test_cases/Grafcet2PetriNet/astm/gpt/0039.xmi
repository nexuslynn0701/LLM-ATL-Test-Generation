<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" location="file://grafcet/example0039.gcf" name="ComplexGrafcet0039">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="1:1-1:50" name="InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="2:1-2:50" name="CheckSensors" isInitial="false" isActive="false" action="check_sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="3:1-3:50" name="ProcessData" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="4:1-4:50" name="ErrorHandler" isInitial="false" isActive="false" action="handle_error"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="5:1-5:50" name="T_InitToCheck" condition="start_button_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="6:1-6:50" name="T_CheckToProcess" condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="7:1-7:50" name="T_ProcessToError" condition="processing_failed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="8:1-8:50" name="T_ErrorToInit" condition="reset_command"/>

    <!-- StepToTransition connections (PlaceToTransition in target) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 location="10:1-10:60"
                 name="C_Init_to_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 location="11:1-11:60"
                 name="C_S1_to_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 location="12:1-12:60"
                 name="C_S2_to_T2"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 location="13:1-13:60"
                 name="C_S3_to_T3"
                 from="/0/@elements.3"
                 to="/0/@elements.7"/>

    <!-- TransitionToStep connections (TransitionToPlace in target) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 location="15:1-15:60"
                 name="C_T0_to_S1"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 location="16:1-16:60"
                 name="C_T1_to_S2"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 location="17:1-17:60"
                 name="C_T2_to_S3"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 location="18:1-18:60"
                 name="C_T3_to_S0"
                 from="/0/@elements.7"
                 to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>