<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="loc_grafcet_main" name="ComplexGrafcet0045">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="loc_step_0" name="InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="loc_step_1" name="WaitStep" isInitial="false" isActive="false" action="wait_for_event"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="loc_step_2" name="ProcessStep" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="loc_step_3" name="ErrorStep" isInitial="false" isActive="false" action="handle_error"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" location="loc_step_4" name="FinalStep" isInitial="false" isActive="false" action="cleanup_and_finish"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="loc_trans_0" name="t_init_to_wait" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="loc_trans_1" name="t_wait_to_process" condition="event_received"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="loc_trans_2" name="t_process_to_final" condition="processing_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="loc_trans_3" name="t_any_to_error" condition="error_detected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" location="loc_trans_4" name="t_error_to_wait" condition="recover_ok"/>

    <!-- StepToTransition connections (PlaceToTransition in target) -->
    <!-- InitStep -> t_init_to_wait -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="loc_conn_0" name="c_s0_t0" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- WaitStep -> t_wait_to_process -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" location="loc_conn_1" name="c_s1_t1" from="/0/@elements.1" to="/0/@elements.6"/>
    <!-- ProcessStep -> t_process_to_final -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="loc_conn_2" name="c_s2_t2" from="/0/@elements.2" to="/0/@elements.7"/>
    <!-- WaitStep -> t_any_to_error -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" location="loc_conn_3" name="c_s1_t3" from="/0/@elements.1" to="/0/@elements.8"/>
    <!-- ProcessStep -> t_any_to_error -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" location="loc_conn_4" name="c_s2_t3" from="/0/@elements.2" to="/0/@elements.8"/>
    <!-- FinalStep -> t_any_to_error -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" location="loc_conn_5" name="c_s4_t3" from="/0/@elements.4" to="/0/@elements.8"/>
    <!-- ErrorStep -> t_error_to_wait -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" location="loc_conn_6" name="c_s3_t4" from="/0/@elements.3" to="/0/@elements.9"/>

    <!-- TransitionToStep connections (TransitionToPlace in target) -->
    <!-- t_init_to_wait -> WaitStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="loc_conn_7" name="c_t0_s1" from="/0/@elements.5" to="/0/@elements.1"/>
    <!-- t_wait_to_process -> ProcessStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" location="loc_conn_8" name="c_t1_s2" from="/0/@elements.6" to="/0/@elements.2"/>
    <!-- t_process_to_final -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" location="loc_conn_9" name="c_t2_s4" from="/0/@elements.7" to="/0/@elements.4"/>
    <!-- t_any_to_error -> ErrorStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" location="loc_conn_10" name="c_t3_s3" from="/0/@elements.8" to="/0/@elements.3"/>
    <!-- t_error_to_wait -> WaitStep (loop back) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" location="loc_conn_11" name="c_t4_s1" from="/0/@elements.9" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>