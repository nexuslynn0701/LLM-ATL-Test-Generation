<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <!-- Single Grafcet root element -->
  <Grafcet:Grafcet xmi:id="_g0" location="file:/models/grafcet0087.gcf#/"
                   name="ComplexCycleWithBranch">

    <!-- Elements: Steps and Transitions -->
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              location="file:/models/grafcet0087.gcf#/steps/s1"
              name="InitStep"
              isInitial="true"
              isActive="true"
              action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              location="file:/models/grafcet0087.gcf#/steps/s2"
              name="BranchStepA"
              isInitial="false"
              isActive="false"
              action="executeBranchA"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              location="file:/models/grafcet0087.gcf#/steps/s3"
              name="BranchStepB"
              isInitial="false"
              isActive="false"
              action="executeBranchB"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s4"
              location="file:/models/grafcet0087.gcf#/steps/s4"
              name="MergeStep"
              isInitial="false"
              isActive="false"
              action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s5"
              location="file:/models/grafcet0087.gcf#/steps/s5"
              name="FinalStep"
              isInitial="false"
              isActive="false"
              action="shutdownSystem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              location="file:/models/grafcet0087.gcf#/transitions/t1"
              name="ToBranch"
              condition="startCommandReceived"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              location="file:/models/grafcet0087.gcf#/transitions/t2"
              name="SplitToA"
              condition="modeASelected"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t3"
              location="file:/models/grafcet0087.gcf#/transitions/t3"
              name="SplitToB"
              condition="modeBSelected"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t4"
              location="file:/models/grafcet0087.gcf#/transitions/t4"
              name="FromAtoMerge"
              condition="branchACompleted"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t5"
              location="file:/models/grafcet0087.gcf#/transitions/t5"
              name="FromBtoMerge"
              condition="branchBCompleted"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t6"
              location="file:/models/grafcet0087.gcf#/transitions/t6"
              name="ToFinal"
              condition="mergeComplete"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t7"
              location="file:/models/grafcet0087.gcf#/transitions/t7"
              name="LoopBack"
              condition="restartRequested"/>

    <!-- Connections: StepToTransition (PlaceToTransition in target) -->
    <!-- InitStep -> ToBranch -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 location="file:/models/grafcet0087.gcf#/connections/c1"
                 name="Init_to_ToBranch"
                 from="/0/@elements.0"
                 to="/0/@elements.5"/>
    <!-- BranchStepA -> FromAtoMerge -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 location="file:/models/grafcet0087.gcf#/connections/c2"
                 name="A_to_MergeTransition"
                 from="/0/@elements.1"
                 to="/0/@elements.8"/>
    <!-- BranchStepB -> FromBtoMerge -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 location="file:/models/grafcet0087.gcf#/connections/c3"
                 name="B_to_MergeTransition"
                 from="/0/@elements.2"
                 to="/0/@elements.9"/>
    <!-- MergeStep -> ToFinal -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c4"
                 location="file:/models/grafcet0087.gcf#/connections/c4"
                 name="Merge_to_FinalTransition"
                 from="/0/@elements.3"
                 to="/0/@elements.10"/>
    <!-- FinalStep -> LoopBack -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c5"
                 location="file:/models/grafcet0087.gcf#/connections/c5"
                 name="Final_to_LoopBack"
                 from="/0/@elements.4"
                 to="/0/@elements.11"/>

    <!-- Connections: TransitionToStep (TransitionToPlace in target) -->
    <!-- ToBranch -> BranchStepA -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 location="file:/models/grafcet0087.gcf#/connections/c6"
                 name="ToBranch_to_A"
                 from="/0/@elements.5"
                 to="/0/@elements.1"/>
    <!-- ToBranch -> BranchStepB -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 location="file:/models/grafcet0087.gcf#/connections/c7"
                 name="ToBranch_to_B"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <!-- SplitToA -> BranchStepA (extra incoming for BranchStepA) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c8"
                 location="file:/models/grafcet0087.gcf#/connections/c8"
                 name="SplitToA_to_A"
                 from="/0/@elements.6"
                 to="/0/@elements.1"/>
    <!-- SplitToB -> BranchStepB (extra incoming for BranchStepB) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c9"
                 location="file:/models/grafcet0087.gcf#/connections/c9"
                 name="SplitToB_to_B"
                 from="/0/@elements.7"
                 to="/0/@elements.2"/>
    <!-- FromAtoMerge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c10"
                 location="file:/models/grafcet0087.gcf#/connections/c10"
                 name="FromAtoMerge_to_Merge"
                 from="/0/@elements.8"
                 to="/0/@elements.3"/>
    <!-- FromBtoMerge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c11"
                 location="file:/models/grafcet0087.gcf#/connections/c11"
                 name="FromBtoMerge_to_Merge"
                 from="/0/@elements.9"
                 to="/0/@elements.3"/>
    <!-- ToFinal -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c12"
                 location="file:/models/grafcet0087.gcf#/connections/c12"
                 name="ToFinal_to_Final"
                 from="/0/@elements.10"
                 to="/0/@elements.4"/>
    <!-- LoopBack -> InitStep (cycle) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c13"
                 location="file:/models/grafcet0087.gcf#/connections/c13"
                 name="LoopBack_to_Init"
                 from="/0/@elements.11"
                 to="/0/@elements.0"/>

  </Grafcet:Grafcet>
</xmi:XMI>