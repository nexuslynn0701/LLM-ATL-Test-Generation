<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" location="file://grafcet0059.gcf#/" name="ComplexProcess">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="file://grafcet0059.gcf#/s0" name="InitStep" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="file://grafcet0059.gcf#/s1" name="Prepare" isInitial="false" isActive="false" action="prepareData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="file://grafcet0059.gcf#/s2" name="Process" isInitial="false" isActive="false" action="runProcess"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="file://grafcet0059.gcf#/s3" name="Finalize" isInitial="false" isActive="false" action="finalizeRun"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="file://grafcet0059.gcf#/t0" name="T_Init_Prepare" condition="init_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="file://grafcet0059.gcf#/t1" name="T_Prepare_Process" condition="prepared"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="file://grafcet0059.gcf#/t2" name="T_Process_Finalize" condition="completed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" location="file://grafcet0059.gcf#/t3" name="T_Finalize_Prepare" condition="restart"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="file://grafcet0059.gcf#/c0" name="C_Init_to_T0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" location="file://grafcet0059.gcf#/c1" name="C_T0_to_Prepare" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" location="file://grafcet0059.gcf#/c2" name="C_Prepare_to_T1" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" location="file://grafcet0059.gcf#/c3" name="C_T1_to_Process" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" location="file://grafcet0059.gcf#/c4" name="C_Process_to_T2" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="file://grafcet0059.gcf#/c5" name="C_T2_to_Finalize" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" location="file://grafcet0059.gcf#/c6" name="C_Finalize_to_T3" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" location="file://grafcet0059.gcf#/c7" name="C_T3_to_Prepare" from="/0/@elements.7" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
