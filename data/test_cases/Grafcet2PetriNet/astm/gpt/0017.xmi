<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_G0" location="loc:/grafcet/main" name="ComplexGrafcet0017">
    <!-- Elements: 4 Steps + 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" location="loc:/grafcet/main/S0" name="InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" location="loc:/grafcet/main/S1" name="CheckInputs" isInitial="false" isActive="false" action="checkInputs"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" location="loc:/grafcet/main/S2" name="ProcessData" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" location="loc:/grafcet/main/S3" name="Finalize" isInitial="false" isActive="false" action="finalizeProcess"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" location="loc:/grafcet/main/T0" name="T_InitToCheck" condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" location="loc:/grafcet/main/T1" name="T_CheckToProcess" condition="inputsValid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" location="loc:/grafcet/main/T2" name="T_ProcessLoop" condition="moreData"/>

    <!-- Connections: StepToTransition (PlaceToTransition rule) -->
    <!-- S0 -> T0, S1 -> T1, S2 -> T1, S2 -> T2 -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C_ST_0"
                 location="loc:/grafcet/main/C_ST_0"
                 name="C_S0_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C_ST_1"
                 location="loc:/grafcet/main/C_ST_1"
                 name="C_S1_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C_ST_2"
                 location="loc:/grafcet/main/C_ST_2"
                 name="C_S2_T1"
                 from="/0/@elements.2"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C_ST_3"
                 location="loc:/grafcet/main/C_ST_3"
                 name="C_S2_T2"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>

    <!-- Connections: TransitionToStep (TransitionToPlace rule) -->
    <!-- T0 -> S1, T1 -> S2, T2 -> S2 (self-loop), T2 -> S3 -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C_TS_0"
                 location="loc:/grafcet/main/C_TS_0"
                 name="C_T0_S1"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C_TS_1"
                 location="loc:/grafcet/main/C_TS_1"
                 name="C_T1_S2"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C_TS_2"
                 location="loc:/grafcet/main/C_TS_2"
                 name="C_T2_S2_Loop"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C_TS_3"
                 location="loc:/grafcet/main/C_TS_3"
                 name="C_T2_S3"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>