<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0055" location="diagram_0055">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="pos_1" isInitial="true" isActive="false" action="start_action"/>
    <elements xsi:type="Grafcet:Transition" name="Trans1" location="pos_2" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="pos_3" isInitial="false" isActive="false" action="middle_action"/>
    <elements xsi:type="Grafcet:Transition" name="Trans2" location="pos_4" condition="y &lt; 10"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="pos_5" isInitial="false" isActive="false" action="end_action"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn1" location="conn_1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn2" location="conn_2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn3" location="conn_3" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn4" location="conn_4" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>