<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet4" location="L4">
    <elements xsi:type="Grafcet:Step" name="S1" location="L4_S1" isInitial="true" isActive="false" action="act1"/>
    <elements xsi:type="Grafcet:Step" name="S2" location="L4_S2" isInitial="false" isActive="true" action="act2"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="L4_T1" condition="cond1"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="L4_T2" condition="cond2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="L4_C1" from="/0/@elements.0" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C2" location="L4_C2" from="/0/@elements.2" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C3" location="L4_C3" from="/0/@elements.1" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C4" location="L4_C4" from="/0/@elements.3" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>