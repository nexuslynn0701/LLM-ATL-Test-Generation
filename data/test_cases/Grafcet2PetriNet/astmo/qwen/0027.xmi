<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0027" location="file://test_0027.grafcet">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="file://test_0027.grafcet#StartStep" isInitial="true" isActive="false" action="startAction"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="file://test_0027.grafcet#T1" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="file://test_0027.grafcet#MiddleStep" isInitial="false" isActive="false" action="middleAction"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="file://test_0027.grafcet#T2" condition="y &lt; 10"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="file://test_0027.grafcet#EndStep" isInitial="false" isActive="false" action="endAction"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_Start_T1" location="file://test_0027.grafcet#Conn_Start_T1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T1_Middle" location="file://test_0027.grafcet#Conn_T1_Middle" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_Middle_T2" location="file://test_0027.grafcet#Conn_Middle_T2" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T2_End" location="file://test_0027.grafcet#Conn_T2_End" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>