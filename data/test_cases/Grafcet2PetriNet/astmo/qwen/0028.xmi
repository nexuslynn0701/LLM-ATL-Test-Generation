<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0028" location="loc_0028">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="step_loc_1" isInitial="true" isActive="false" action="start"/>
    <elements xsi:type="Grafcet:Transition" name="Trans1" location="trans_loc_1" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="step_loc_2" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" name="Trans2" location="trans_loc_2" condition="y &lt; 10"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="step_loc_3" isInitial="false" isActive="false" action="end"/>
    
    <connections xsi:type="Grafcet:StepToTransition" name="Conn1" location="conn_loc_1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn2" location="conn_loc_2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn3" location="conn_loc_3" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn4" location="conn_loc_4" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>