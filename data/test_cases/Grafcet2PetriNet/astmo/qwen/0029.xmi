<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0029" location="file://test_0029.gfc">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="file://test_0029.gfc#StartStep" isInitial="true" isActive="false" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="file://test_0029.gfc#T1" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="file://test_0029.gfc#MiddleStep" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="file://test_0029.gfc#T2" condition="y == 1"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="file://test_0029.gfc#EndStep" isInitial="false" isActive="false" action="finalize"/>
    
    <connections xsi:type="Grafcet:StepToTransition" name="StartToT1" location="file://test_0029.gfc#StartToT1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T1ToMiddle" location="file://test_0029.gfc#T1ToMiddle" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="MiddleToT2" location="file://test_0029.gfc#MiddleToT2" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T2ToEnd" location="file://test_0029.gfc#T2ToEnd" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>