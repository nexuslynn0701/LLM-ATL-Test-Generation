<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0073" location="loc_main">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="loc_start" isInitial="true" isActive="false" action="start_action"/>
    <elements xsi:type="Grafcet:Transition" name="CondTrans" location="loc_cond" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="loc_middle" isInitial="false" isActive="false" action="middle_action"/>
    <elements xsi:type="Grafcet:Transition" name="FinalTrans" location="loc_final" condition="y == 1"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="loc_end" isInitial="false" isActive="false" action="end_action"/>
    <connections xsi:type="Grafcet:StepToTransition" name="StartToCond" location="conn_1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="CondToMiddle" location="conn_2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="MiddleToFinal" location="conn_3" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="FinalToEnd" location="conn_4" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>