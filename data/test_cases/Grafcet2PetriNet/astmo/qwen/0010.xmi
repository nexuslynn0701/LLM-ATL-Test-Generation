<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0010" location="diagram_0010">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="step_001" isInitial="true" isActive="false" action="start_action"/>
    <elements xsi:type="Grafcet:Transition" name="Trans1" location="trans_001" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="step_002" isInitial="false" isActive="false" action="middle_action"/>
    <elements xsi:type="Grafcet:Transition" name="Trans2" location="trans_002" condition="y &lt; 10"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="step_003" isInitial="false" isActive="false" action="end_action"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_S1_T1" location="conn_001" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T1_S2" location="conn_002" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_S2_T2" location="conn_003" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T2_S3" location="conn_004" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>