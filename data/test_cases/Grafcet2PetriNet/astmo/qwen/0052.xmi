<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0052" location="diagram_0052">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="pos_start" isInitial="true" isActive="false" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="Trans1" location="pos_trans1" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="pos_middle" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" name="Trans2" location="pos_trans2" condition="y &lt; 10"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="pos_end" isInitial="false" isActive="false" action="finalize"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_Start_To_Trans1" location="conn_1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_Trans1_To_Middle" location="conn_2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_Middle_To_Trans2" location="conn_3" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_Trans2_To_End" location="conn_4" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>