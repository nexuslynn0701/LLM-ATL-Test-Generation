<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0100" location="loc_0100">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="step_loc_1" isInitial="true" isActive="false" action="start"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="step_loc_2" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="step_loc_3" isInitial="false" isActive="false" action="end"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="trans_loc_1" condition="x>0"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="trans_loc_2" condition="y&lt;5"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_S1_T1" location="conn_loc_1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T1_S2" location="conn_loc_2" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_S2_T2" location="conn_loc_3" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T2_S3" location="conn_loc_4" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>