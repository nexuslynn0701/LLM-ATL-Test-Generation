<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0034" location="loc_0034">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="step_loc_1" isInitial="true" isActive="false" action="activate_valve"/>
