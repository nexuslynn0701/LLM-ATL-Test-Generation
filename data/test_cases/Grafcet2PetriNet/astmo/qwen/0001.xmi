<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet" location="MainDiagram">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="TopLeft" isInitial="true" isActive="false" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="Middle" condition="x>0"/>
    <elements xsi:type="Grafcet:Step" name="ProcessStep" location="Center" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="Bottom" condition="y&lt;10"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="BottomRight" isInitial="false" isActive="false" action="finish"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn1" location="Path1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn2" location="Path2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn3" location="Path3" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn4" location="Path4" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>