<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0012" location="file://test_0012.gfc">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="file://test_0012.gfc#InitialStep" isInitial="true" isActive="false" action="start"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="file://test_0012.gfc#T1" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="file://test_0012.gfc#MiddleStep" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="file://test_0012.gfc#T2" condition="y == 1"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="file://test_0012.gfc#FinalStep" isInitial="false" isActive="false" action="end"/>
    <connections xsi:type="Grafcet:StepToTransition" name="ST_T1" location="file://test_0012.gfc#ST_T1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T1_TS" location="file://test_0012.gfc#T1_TS" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="ST_T2" location="file://test_0012.gfc#ST_T2" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T2_TS" location="file://test_0012.gfc#T2_TS" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>