<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="loc_grafcet_3" name="Grafcet_3">
    <elements xsi:type="Grafcet:Step" location="loc_step_1" name="Step_1" isInitial="true" isActive="true" action="Action_1"/>
    <elements xsi:type="Grafcet:Step" location="loc_step_2" name="Step_2" isInitial="false" isActive="false" action="Action_2"/>
    <elements xsi:type="Grafcet:Step" location="loc_step_3" name="Step_3" isInitial="false" isActive="false" action="Action_3"/>
    <elements xsi:type="Grafcet:Transition" location="loc_trans_1" name="Transition_1" condition="Condition_1"/>
    <elements xsi:type="Grafcet:Transition" location="loc_trans_2" name="Transition_2" condition="Condition_2"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc_conn_1" name="Connection_1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc_conn_2" name="Connection_2" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc_conn_3" name="Connection_3" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc_conn_4" name="Connection_4" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
