<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="loc0" name="G0">
    <elements xsi:type="Grafcet:Step" location="loc1" name="S1" isInitial="true" isActive="true" action="action1"/>
    <elements xsi:type="Grafcet:Step" location="loc2" name="S2" isInitial="false" isActive="false" action="action2"/>
    <elements xsi:type="Grafcet:Step" location="loc3" name="S3" isInitial="false" isActive="false" action="action3"/>
    <elements xsi:type="Grafcet:Transition" location="loc4" name="T1" condition="cond1"/>
    <elements xsi:type="Grafcet:Transition" location="loc5" name="T2" condition="cond2"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc6" name="ST1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc7" name="TS1" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc8" name="ST2" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc9" name="TS2" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc10" name="ST3" from="/0/@elements.2" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>