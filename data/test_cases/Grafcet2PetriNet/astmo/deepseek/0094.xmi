<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ProductionLine" location="Line1">
    <elements xsi:type="Grafcet:Step" name="Start" location="Cell1" isInitial="true" isActive="true" action="Initialize"/>
    <elements xsi:type="Grafcet:Step" name="Process" location="Cell2" isInitial="false" isActive="false" action="ProcessPart"/>
    <elements xsi:type="Grafcet:Step" name="Finish" location="Cell3" isInitial="false" isActive="false" action="Finalize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="Cell4" condition="StartSignal"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="Cell5" condition="ProcessComplete"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="Cell6" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C2" location="Cell7" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C3" location="Cell8" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C4" location="Cell9" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>