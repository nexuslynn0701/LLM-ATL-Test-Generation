<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="loc0" name="ProductionLine">
    <elements xsi:type="Grafcet:Step" location="loc1" name="Start" isInitial="true" isActive="true" action="Initialize"/>
    <elements xsi:type="Grafcet:Transition" location="loc2" name="T1" condition="StartPressed"/>
    <elements xsi:type="Grafcet:Step" location="loc3" name="Processing" isInitial="false" isActive="false" action="Process"/>
    <elements xsi:type="Grafcet:Transition" location="loc4" name="T2" condition="ProcessComplete"/>
    <elements xsi:type="Grafcet:Step" location="loc5" name="Packaging" isInitial="false" isActive="false" action="Package"/>
    <elements xsi:type="Grafcet:Transition" location="loc6" name="T3" condition="PackageComplete"/>
    <elements xsi:type="Grafcet:Step" location="loc7" name="End" isInitial="false" isActive="false" action="Finish"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc8" name="C1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc9" name="C2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc10" name="C3" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc11" name="C4" from="/0/@elements.3" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc12" name="C5" from="/0/@elements.4" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc13" name="C6" from="/0/@elements.5" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>