<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet0036" location="loc_grafcet_0036">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.0"
              name="InitialStepA"
              location="loc_step_A"
              isInitial="true"
              isActive="true"
              action="startA"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.1"
              name="StepB"
              location="loc_step_B"
              isInitial="false"
              isActive="false"
              action="processB"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.2"
              name="StepC"
              location="loc_step_C"
              isInitial="false"
              isActive="true"
              action="processC"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.3"
              name="Trans1"
              location="loc_trans_1"
              condition="cond1"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.4"
              name="Trans2"
              location="loc_trans_2"
              condition="cond2"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.0"
                 name="Conn_A_T1"
                 location="loc_conn_A_T1"
                 from="/0/@elements.0"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.1"
                 name="Conn_B_T1"
                 location="loc_conn_B_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.2"
                 name="Conn_C_T2"
                 location="loc_conn_C_T2"
                 from="/0/@elements.2"
                 to="/0/@elements.4"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.3"
                 name="Conn_T1_B"
                 location="loc_conn_T1_B"
                 from="/0/@elements.3"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.4"
                 name="Conn_T2_C"
                 location="loc_conn_T2_C"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>