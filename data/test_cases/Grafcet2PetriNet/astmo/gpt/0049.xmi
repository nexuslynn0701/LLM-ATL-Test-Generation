<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ProductionLineGrafcet" location="model_location_0049">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="loc_s0" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckSensors" location="loc_s1" isInitial="false" isActive="false" action="verify_sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="StartConveyor" location="loc_s2" isInitial="false" isActive="false" action="start_conveyor"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToCheck" location="loc_t0" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_CheckToStart" location="loc_t1" condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_StartToInit" location="loc_t2" condition="cycle_complete"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="loc_c0" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="C_T0_to_Check" location="loc_c1" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Check_to_T1" location="loc_c2" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="C_T1_to_Start" location="loc_c3" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_Start_to_T2" location="loc_c4" from="/0/@elements.2" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_T2_to_Init" location="loc_c5" from="/0/@elements.5" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>