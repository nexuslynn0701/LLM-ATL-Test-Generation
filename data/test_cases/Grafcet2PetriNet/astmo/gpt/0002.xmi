<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet" location="loc_grafcet_0002">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.0"
              name="InitStep"
              location="loc_step_init_0002"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.1"
              name="ProcessStepA"
              location="loc_step_A_0002"
              isInitial="false"
              isActive="false"
              action="process_A"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.2"
              name="ProcessStepB"
              location="loc_step_B_0002"
              isInitial="false"
              isActive="false"
              action="process_B"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.3"
              name="FinalStep"
              location="loc_step_final_0002"
              isInitial="false"
              isActive="false"
              action="finalize"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.4"
              name="T_Init_to_A"
              location="loc_trans_1_0002"
              condition="cond_init_to_A"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.5"
              name="T_A_to_B"
              location="loc_trans_2_0002"
              condition="cond_A_to_B"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.6"
              name="T_B_to_A"
              location="loc_trans_3_0002"
              condition="cond_B_to_A"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.7"
              name="T_B_to_Final"
              location="loc_trans_4_0002"
              condition="cond_B_to_Final"/>

    <!-- Connections: StepToTransition (PlaceToTransition in target) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.0"
                 name="C_Init_to_T1"
                 location="loc_conn_ST_1_0002"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.1"
                 name="C_A_to_T2"
                 location="loc_conn_ST_2_0002"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.2"
                 name="C_B_to_T3"
                 location="loc_conn_ST_3_0002"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.3"
                 name="C_B_to_T4"
                 location="loc_conn_ST_4_0002"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>

    <!-- Connections: TransitionToStep (TransitionToPlace in target) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.4"
                 name="C_T1_to_A"
                 location="loc_conn_TS_1_0002"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.5"
                 name="C_T2_to_B"
                 location="loc_conn_TS_2_0002"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.6"
                 name="C_T3_to_A"
                 location="loc_conn_TS_3_0002"
                 from="/0/@elements.6"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.7"
                 name="C_T4_to_Final"
                 location="loc_conn_TS_4_0002"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>

</xmi:XMI>