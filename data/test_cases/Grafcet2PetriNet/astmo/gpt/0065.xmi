<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_grafcet_main" name="MainGrafcet0065" location="file://model0065.grafcet">
    <elements xsi:type="Grafcet:Step" xmi:id="_step_A" name="StepA" location="file://model0065.grafcet#StepA" isInitial="true" isActive="true" action="InitializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_B" name="StepB" location="file://model0065.grafcet#StepB" isInitial="false" isActive="false" action="CheckSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_C" name="StepC" location="file://model0065.grafcet#StepC" isInitial="false" isActive="false" action="StartActuators"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_1" name="T1" location="file://model0065.grafcet#T1" condition="SensorsReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_2" name="T2" location="file://model0065.grafcet#T2" condition="StartCommand"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn_ST_A1" name="A_to_T1" location="file://model0065.grafcet#A_to_T1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn_TS_1B" name="T1_to_B" location="file://model0065.grafcet#T1_to_B" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn_ST_B2" name="B_to_T2" location="file://model0065.grafcet#B_to_T2" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn_TS_2C" name="T2_to_C" location="file://model0065.grafcet#T2_to_C" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>