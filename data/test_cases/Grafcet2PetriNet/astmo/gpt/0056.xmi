<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g1" name="ComplexGrafcet" location="loc://grafcet/complex">
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="InitStep" location="loc://grafcet/complex/step1" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessingStepA" location="loc://grafcet/complex/step2" isInitial="false" isActive="false" action="processDataA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ProcessingStepB" location="loc://grafcet/complex/step3" isInitial="false" isActive="false" action="processDataB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="FinalStep" location="loc://grafcet/complex/step4" isInitial="false" isActive="false" action="finalizeSystem"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Init_to_A" location="loc://grafcet/complex/trans1" condition="cond_init_to_A"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_A_to_B" location="loc://grafcet/complex/trans2" condition="cond_A_to_B"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_B_to_Final" location="loc://grafcet/complex/trans3" condition="cond_B_to_Final"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_LoopBack" location="loc://grafcet/complex/trans4" condition="cond_loop_back"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Init_to_T1" location="loc://grafcet/complex/conn1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="C_T1_to_A" location="loc://grafcet/complex/conn2" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_A_to_T2" location="loc://grafcet/complex/conn3" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="C_T2_to_B" location="loc://grafcet/complex/conn4" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_B_to_T3" location="loc://grafcet/complex/conn5" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="C_T3_to_Final" location="loc://grafcet/complex/conn6" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_Final_to_T4" location="loc://grafcet/complex/conn7" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_T4_to_Init" location="loc://grafcet/complex/conn8" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>