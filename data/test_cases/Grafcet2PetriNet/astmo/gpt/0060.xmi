<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet0060" location="file://grafcet/models/complex0060.gcf">

    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_S0"
              name="InitStep"
              location="file://grafcet/models/complex0060.gcf#S0"
              isInitial="true"
              isActive="true"
              action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_S1"
              name="LoadData"
              location="file://grafcet/models/complex0060.gcf#S1"
              isInitial="false"
              isActive="false"
              action="loadConfiguration"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_S2"
              name="ProcessData"
              location="file://grafcet/models/complex0060.gcf#S2"
              isInitial="false"
              isActive="false"
              action="processInput"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_S3"
              name="Finalize"
              location="file://grafcet/models/complex0060.gcf#S3"
              isInitial="false"
              isActive="false"
              action="cleanupAndExit"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T0"
              name="t_init_to_load"
              location="file://grafcet/models/complex0060.gcf#T0"
              condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T1"
              name="t_load_to_process"
              location="file://grafcet/models/complex0060.gcf#T1"
              condition="dataLoaded"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T2"
              name="t_process_to_finalize"
              location="file://grafcet/models/complex0060.gcf#T2"
              condition="processingComplete"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T3"
              name="t_process_loop"
              location="file://grafcet/models/complex0060.gcf#T3"
              condition="moreData"/>

    <!-- StepToTransition connections -->
    <!-- InitStep -> t_init_to_load -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C0"
                 name="c_init_to_t0"
                 location="file://grafcet/models/complex0060.gcf#C0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <!-- LoadData -> t_load_to_process -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C1"
                 name="c_load_to_t1"
                 location="file://grafcet/models/complex0060.gcf#C1"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <!-- ProcessData -> t_process_to_finalize -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C2"
                 name="c_process_to_t2"
                 location="file://grafcet/models/complex0060.gcf#C2"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <!-- ProcessData -> t_process_loop -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C3"
                 name="c_process_to_t3"
                 location="file://grafcet/models/complex0060.gcf#C3"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>

    <!-- TransitionToStep connections -->
    <!-- t_init_to_load -> LoadData -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C4"
                 name="c_t0_to_load"
                 location="file://grafcet/models/complex0060.gcf#C4"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <!-- t_load_to_process -> ProcessData -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C5"
                 name="c_t1_to_process"
                 location="file://grafcet/models/complex0060.gcf#C5"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <!-- t_process_to_finalize -> Finalize -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C6"
                 name="c_t2_to_finalize"
                 location="file://grafcet/models/complex0060.gcf#C6"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <!-- t_process_loop -> ProcessData (loop back) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C7"
                 name="c_t3_to_process"
                 location="file://grafcet/models/complex0060.gcf#C7"
                 from="/0/@elements.7"
                 to="/0/@elements.2"/>

  </Grafcet:Grafcet>
</xmi:XMI>