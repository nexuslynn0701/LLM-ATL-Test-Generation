<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_grafcet1" name="ComplexGrafcet" location="file://complex/grafcet.gcf">
    <elements xsi:type="Grafcet:Step" xmi:id="_step1" name="InitStep" location="L1" isInitial="true" isActive="true" action="initialize system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step2" name="ProcessStep" location="L2" isInitial="false" isActive="false" action="process data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step3" name="FinalStep" location="L3" isInitial="false" isActive="false" action="finalize process"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans1" name="T1" location="L4" condition="start condition"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans2" name="T2" location="L5" condition="continue condition"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="ST_Init_T1" location="LC1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="TS_T1_Proc" location="LC2" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="ST_Proc_T2" location="LC3" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="TS_T2_Final" location="LC4" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>