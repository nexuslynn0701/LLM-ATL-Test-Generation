<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ProductionLineGrafcet" location="file://models/production_line.grafcet">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStep" location="file://models/production_line.grafcet#InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="LoadMaterial" location="file://models/production_line.grafcet#LoadMaterial" isInitial="false" isActive="false" action="load_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="ProcessMaterial" location="file://models/production_line.grafcet#ProcessMaterial" isInitial="false" isActive="false" action="process_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="UnloadMaterial" location="file://models/production_line.grafcet#UnloadMaterial" isInitial="false" isActive="false" action="unload_material"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="T_InitToLoad" location="file://models/production_line.grafcet#T_InitToLoad" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="T_LoadToProcess" location="file://models/production_line.grafcet#T_LoadToProcess" condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="T_ProcessToUnload" location="file://models/production_line.grafcet#T_ProcessToUnload" condition="processing_done"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="C_Init_to_TInitLoad" location="file://models/production_line.grafcet#C_Init_to_TInitLoad" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.1" name="C_TInitLoad_to_Load" location="file://models/production_line.grafcet#C_TInitLoad_to_Load" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" name="C_Load_to_TLoadProcess" location="file://models/production_line.grafcet#C_Load_to_TLoadProcess" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" name="C_TLoadProcess_to_Process" location="file://models/production_line.grafcet#C_TLoadProcess_to_Process" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.4" name="C_Process_to_TProcessUnload" location="file://models/production_line.grafcet#C_Process_to_TProcessUnload" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5" name="C_TProcessUnload_to_Unload" location="file://models/production_line.grafcet#C_TProcessUnload_to_Unload" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>