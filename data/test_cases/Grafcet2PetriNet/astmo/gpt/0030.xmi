<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ProductionLine" location="plant:A1">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="Start" location="plant:A1" isInitial="true" isActive="true" action="init_sequence"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="Load" location="plant:A1" isInitial="false" isActive="false" action="load_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="Process" location="plant:A1" isInitial="false" isActive="false" action="run_machine"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Start_Load" location="plant:A1" condition="sensor_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Load_Process" location="plant:A1" condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_Process_Load" location="plant:A1" condition="recycle_cycle"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Start_to_T_Start_Load" location="plant:A1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="C_T_Start_Load_to_Load" location="plant:A1" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Load_to_T_Load_Process" location="plant:A1" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="C_T_Load_Process_to_Process" location="plant:A1" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_Process_to_T_Process_Load" location="plant:A1" from="/0/@elements.2" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_T_Process_Load_to_Load" location="plant:A1" from="/0/@elements.5" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>