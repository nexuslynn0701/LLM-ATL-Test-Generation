<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="g1" name="ComplexGrafcet31" location="model/0031">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="s1"
              name="InitStepA"
              location="model/0031#s1"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="s2"
              name="ProcessingStepB"
              location="model/0031#s2"
              isInitial="false"
              isActive="false"
              action="process_data"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="s3"
              name="FinalStepC"
              location="model/0031#s3"
              isInitial="false"
              isActive="false"
              action="shutdown"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t1"
              name="T_Init_to_Proc"
              location="model/0031#t1"
              condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t2"
              name="T_Proc_to_Final"
              location="model/0031#t2"
              condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t3"
              name="T_LoopBack"
              location="model/0031#t3"
              condition="error_detected"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c1"
                 name="Arc_s1_t1"
                 location="model/0031#c1"
                 from="/0/@elements.0"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c2"
                 name="Arc_s2_t2"
                 location="model/0031#c2"
                 from="/0/@elements.1"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c3"
                 name="Arc_s3_t3"
                 location="model/0031#c3"
                 from="/0/@elements.2"
                 to="/0/@elements.5"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c4"
                 name="Arc_t1_s2"
                 location="model/0031#c4"
                 from="/0/@elements.3"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c5"
                 name="Arc_t2_s3"
                 location="model/0031#c5"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c6"
                 name="Arc_t3_s1"
                 location="model/0031#c6"
                 from="/0/@elements.5"
                 to="/0/@elements.0"/>
  </Grafcet:Grafcet>

</xmi:XMI>