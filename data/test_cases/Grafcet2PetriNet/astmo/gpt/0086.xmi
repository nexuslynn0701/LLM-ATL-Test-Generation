<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet0086" location="file://grafcet/complex_0086.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.0"
              name="InitStepA"
              location="file://grafcet/complex_0086.gcf#InitStepA"
              isInitial="true"
              isActive="true"
              action="initialize system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.1"
              name="ProcessingStepB"
              location="file://grafcet/complex_0086.gcf#ProcessingStepB"
              isInitial="false"
              isActive="false"
              action="process data"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.2"
              name="FinalStepC"
              location="file://grafcet/complex_0086.gcf#FinalStepC"
              isInitial="false"
              isActive="false"
              action="finalize and log"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.3"
              name="Transition1"
              location="file://grafcet/complex_0086.gcf#Transition1"
              condition="startProcessing"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.4"
              name="Transition2"
              location="file://grafcet/complex_0086.gcf#Transition2"
              condition="processingComplete"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.5"
              name="Transition3"
              location="file://grafcet/complex_0086.gcf#Transition3"
              condition="retryRequested"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.0"
                 name="Arc_ST_A_T1"
                 location="file://grafcet/complex_0086.gcf#Arc_ST_A_T1"
                 from="/0/@elements.0"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.1"
                 name="Arc_ST_B_T2"
                 location="file://grafcet/complex_0086.gcf#Arc_ST_B_T2"
                 from="/0/@elements.1"
                 to="/0/@elements.4"/>
    <!-- extra StepToTransition to exercise multiple incoming arcs on a Transition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.2"
                 name="Arc_ST_C_T3"
                 location="file://grafcet/complex_0086.gcf#Arc_ST_C_T3"
                 from="/0/@elements.2"
                 to="/0/@elements.5"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.3"
                 name="Arc_TS_T1_B"
                 location="file://grafcet/complex_0086.gcf#Arc_TS_T1_B"
                 from="/0/@elements.3"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.4"
                 name="Arc_TS_T2_C"
                 location="file://grafcet/complex_0086.gcf#Arc_TS_T2_C"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>
    <!-- extra TransitionToStep to create a loop back to InitStepA -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.5"
                 name="Arc_TS_T3_A"
                 location="file://grafcet/complex_0086.gcf#Arc_TS_T3_A"
                 from="/0/@elements.5"
                 to="/0/@elements.0"/>
  </Grafcet:Grafcet>

</xmi:XMI>