<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ProductionLine" location="file://grafcet/productionLine.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              name="InitBuffer"
              location="file://grafcet/productionLine.gcf#InitBuffer"
              isInitial="true"
              isActive="true"
              action="load_buffer"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="CheckSensors"
              location="file://grafcet/productionLine.gcf#CheckSensors"
              isInitial="false"
              isActive="false"
              action="read_sensors"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="StartConveyor"
              location="file://grafcet/productionLine.gcf#StartConveyor"
              isInitial="false"
              isActive="false"
              action="start_conveyor"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              name="StopConveyor"
              location="file://grafcet/productionLine.gcf#StopConveyor"
              isInitial="false"
              isActive="false"
              action="stop_conveyor"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              name="BufferLoaded"
              location="file://grafcet/productionLine.gcf#BufferLoaded"
              condition="buffer_full"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="SensorsOk"
              location="file://grafcet/productionLine.gcf#SensorsOk"
              condition="all_ok"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="StopRequested"
              location="file://grafcet/productionLine.gcf#StopRequested"
              condition="stop_signal"/>

    <!-- StepToTransition Connections -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="InitToBufferLoaded"
                 location="file://grafcet/productionLine.gcf#InitToBufferLoaded"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="CheckToSensorsOk"
                 location="file://grafcet/productionLine.gcf#CheckToSensorsOk"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="StartToStopRequested"
                 location="file://grafcet/productionLine.gcf#StartToStopRequested"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>

    <!-- TransitionToStep Connections -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c3"
                 name="BufferLoadedToCheck"
                 location="file://grafcet/productionLine.gcf#BufferLoadedToCheck"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 name="SensorsOkToStart"
                 location="file://grafcet/productionLine.gcf#SensorsOkToStart"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 name="StopRequestedToStop"
                 location="file://grafcet/productionLine.gcf#StopRequestedToStop"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>