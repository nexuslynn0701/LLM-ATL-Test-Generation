<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet0055" location="file:///models/grafcet0055.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              name="InitStepA"
              location="file:///models/grafcet0055.gcf#InitStepA"
              isInitial="true"
              isActive="true"
              action="initialize system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="ProcessingStepB"
              location="file:///models/grafcet0055.gcf#ProcessingStepB"
              isInitial="false"
              isActive="false"
              action="process data"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="FinalStepC"
              location="file:///models/grafcet0055.gcf#FinalStepC"
              isInitial="false"
              isActive="false"
              action="shutdown"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              name="T_A_to_B"
              location="file:///models/grafcet0055.gcf#T_A_to_B"
              condition="data_ready"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="T_B_to_C"
              location="file:///models/grafcet0055.gcf#T_B_to_C"
              condition="processing_done"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="Arc_A_T0"
                 location="file:///models/grafcet0055.gcf#Arc_A_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="Arc_B_T1"
                 location="file:///models/grafcet0055.gcf#Arc_B_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.4"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c2"
                 name="Arc_T0_B"
                 location="file:///models/grafcet0055.gcf#Arc_T0_B"
                 from="/0/@elements.3"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c3"
                 name="Arc_T1_C"
                 location="file:///models/grafcet0055.gcf#Arc_T1_C"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>
  </Grafcet:Grafcet>

</xmi:XMI>