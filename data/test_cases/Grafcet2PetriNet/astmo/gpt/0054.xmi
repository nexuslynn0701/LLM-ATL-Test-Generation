<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet0054" location="file://grafcet/complex0054.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              name="InitStep"
              location="file://grafcet/complex0054.gcf#InitStep"
              isInitial="true"
              isActive="true"
              action="initialize system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="ProcessingStepA"
              location="file://grafcet/complex0054.gcf#ProcessingStepA"
              isInitial="false"
              isActive="false"
              action="process A"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="ProcessingStepB"
              location="file://grafcet/complex0054.gcf#ProcessingStepB"
              isInitial="false"
              isActive="false"
              action="process B"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              name="FinalStep"
              location="file://grafcet/complex0054.gcf#FinalStep"
              isInitial="false"
              isActive="false"
              action="finalize"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              name="T_Init_to_A"
              location="file://grafcet/complex0054.gcf#T_Init_to_A"
              condition="startA"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="T_Init_to_B"
              location="file://grafcet/complex0054.gcf#T_Init_to_B"
              condition="startB"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="T_A_to_Final"
              location="file://grafcet/complex0054.gcf#T_A_to_Final"
              condition="doneA"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t3"
              name="T_B_to_Final"
              location="file://grafcet/complex0054.gcf#T_B_to_Final"
              condition="doneB"/>

    <!-- Connections: StepToTransition (PlaceToTransition in target) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="Arc_Init_to_T0"
                 location="file://grafcet/complex0054.gcf#Arc_Init_to_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="Arc_Init_to_T1"
                 location="file://grafcet/complex0054.gcf#Arc_Init_to_T1"
                 from="/0/@elements.0"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="Arc_A_to_T2"
                 location="file://grafcet/complex0054.gcf#Arc_A_to_T2"
                 from="/0/@elements.1"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 name="Arc_B_to_T3"
                 location="file://grafcet/complex0054.gcf#Arc_B_to_T3"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>

    <!-- Connections: TransitionToStep (TransitionToPlace in target) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 name="Arc_T0_to_A"
                 location="file://grafcet/complex0054.gcf#Arc_T0_to_A"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 name="Arc_T1_to_B"
                 location="file://grafcet/complex0054.gcf#Arc_T1_to_B"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 name="Arc_T2_to_Final"
                 location="file://grafcet/complex0054.gcf#Arc_T2_to_Final"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 name="Arc_T3_to_Final"
                 location="file://grafcet/complex0054.gcf#Arc_T3_to_Final"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>