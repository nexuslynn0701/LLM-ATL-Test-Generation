<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet_0023" location="loc:/models/grafcet/0023">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStep" location="loc:/models/grafcet/0023#InitStep" isInitial="true" isActive="true" action="initialize system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="LoadConfig" location="loc:/models/grafcet/0023#LoadConfig" isInitial="false" isActive="false" action="load configuration"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="StartExecution" location="loc:/models/grafcet/0023#StartExecution" isInitial="false" isActive="false" action="start main loop"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="ErrorHandler" location="loc:/models/grafcet/0023#ErrorHandler" isInitial="false" isActive="false" action="handle error"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="T_InitToLoad" location="loc:/models/grafcet/0023#T_InitToLoad" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="T_LoadToStart" location="loc:/models/grafcet/0023#T_LoadToStart" condition="config_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="T_Error" location="loc:/models/grafcet/0023#T_Error" condition="error_detected"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="Arc_Init_to_T1" location="loc:/models/grafcet/0023#Arc_Init_to_T1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.1" name="Arc_T1_to_Load" location="loc:/models/grafcet/0023#Arc_T1_to_Load" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" name="Arc_Load_to_T2" location="loc:/models/grafcet/0023#Arc_Load_to_T2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" name="Arc_T2_to_Start" location="loc:/models/grafcet/0023#Arc_T2_to_Start" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.4" name="Arc_Start_to_TError" location="loc:/models/grafcet/0023#Arc_Start_to_TError" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5" name="Arc_TError_to_ErrorHandler" location="loc:/models/grafcet/0023#Arc_TError_to_ErrorHandler" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>