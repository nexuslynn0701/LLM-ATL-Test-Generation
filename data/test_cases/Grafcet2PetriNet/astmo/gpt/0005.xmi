<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet0005" location="file://grafcet_models/complex_0005.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0"
              name="InitStepA" location="file://grafcet_models/complex_0005.gcf#InitStepA"
              isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1"
              name="ProcessingStepB" location="file://grafcet_models/complex_0005.gcf#ProcessingStepB"
              isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2"
              name="DecisionStepC" location="file://grafcet_models/complex_0005.gcf#DecisionStepC"
              isInitial="false" isActive="false" action="evaluate_condition"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3"
              name="FinalStepD" location="file://grafcet_models/complex_0005.gcf#FinalStepD"
              isInitial="false" isActive="false" action="shutdown_system"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4"
              name="T1" location="file://grafcet_models/complex_0005.gcf#T1"
              condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5"
              name="T2" location="file://grafcet_models/complex_0005.gcf#T2"
              condition="processing_complete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6"
              name="T3" location="file://grafcet_models/complex_0005.gcf#T3"
              condition="condition_true"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.7"
              name="T4" location="file://grafcet_models/complex_0005.gcf#T4"
              condition="condition_false"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0"
                 name="Arc_Init_to_T1"
                 location="file://grafcet_models/complex_0005.gcf#Arc_Init_to_T1"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.1"
                 name="Arc_Proc_to_T2"
                 location="file://grafcet_models/complex_0005.gcf#Arc_Proc_to_T2"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2"
                 name="Arc_Dec_to_T3"
                 location="file://grafcet_models/complex_0005.gcf#Arc_Dec_to_T3"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.3"
                 name="Arc_Dec_to_T4"
                 location="file://grafcet_models/complex_0005.gcf#Arc_Dec_to_T4"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.4"
                 name="Arc_T1_to_Proc"
                 location="file://grafcet_models/complex_0005.gcf#Arc_T1_to_Proc"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5"
                 name="Arc_T2_to_Dec"
                 location="file://grafcet_models/complex_0005.gcf#Arc_T2_to_Dec"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.6"
                 name="Arc_T3_to_Final"
                 location="file://grafcet_models/complex_0005.gcf#Arc_T3_to_Final"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.7"
                 name="Arc_T4_to_Proc"
                 location="file://grafcet_models/complex_0005.gcf#Arc_T4_to_Proc"
                 from="/0/@elements.7"
                 to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>