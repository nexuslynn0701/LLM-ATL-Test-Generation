<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ProductionLineGrafcet" location="factory_floor_line_3">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="LoadStation" location="pos_A1" isInitial="true" isActive="true" action="load_item"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="ProcessStation" location="pos_B2" isInitial="false" isActive="false" action="process_item"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="UnloadStation" location="pos_C3" isInitial="false" isActive="false" action="unload_item"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.3" name="LoadedToProcess" location="tr_A1_B2" condition="item_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="ProcessToUnload" location="tr_B2_C3" condition="processing_done"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="Arc_Load_to_L2P" location="conn_A1_L2P" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.1" name="Arc_L2P_to_Process" location="conn_L2P_B2" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" name="Arc_Process_to_P2U" location="conn_B2_P2U" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" name="Arc_P2U_to_Unload" location="conn_P2U_C3" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>