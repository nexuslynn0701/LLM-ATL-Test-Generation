<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="file://model8.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              name="InitStep"
              location="file://model8.grafcet#InitStep"
              isInitial="true"
              isActive="true"
              action="initialize system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="ProcessingStep"
              location="file://model8.grafcet#ProcessingStep"
              isInitial="false"
              isActive="false"
              action="process data"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="FinalStep"
              location="file://model8.grafcet#FinalStep"
              isInitial="false"
              isActive="false"
              action="shutdown"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              name="T_InitToProcess"
              location="file://model8.grafcet#T_InitToProcess"
              condition="start command received"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="T_ProcessToFinal"
              location="file://model8.grafcet#T_ProcessToFinal"
              condition="processing complete"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="C_Init_to_T0"
                 location="file://model8.grafcet#C_Init_to_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="C_Process_to_T1"
                 location="file://model8.grafcet#C_Process_to_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.4"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c2"
                 name="C_T0_to_Process"
                 location="file://model8.grafcet#C_T0_to_Process"
                 from="/0/@elements.3"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c3"
                 name="C_T1_to_Final"
                 location="file://model8.grafcet#C_T1_to_Final"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>
  </Grafcet:Grafcet>

</xmi:XMI>