<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet14" location="file://grafcet_models/model_0014.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.0"
              name="InitStepA"
              location="file://grafcet_models/model_0014.gcf#InitStepA"
              isInitial="true"
              isActive="true"
              action="initialize subsystem A"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.1"
              name="MiddleStepB"
              location="file://grafcet_models/model_0014.gcf#MiddleStepB"
              isInitial="false"
              isActive="false"
              action="process data B"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.2"
              name="FinalStepC"
              location="file://grafcet_models/model_0014.gcf#FinalStepC"
              isInitial="false"
              isActive="false"
              action="shutdown subsystem C"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.3"
              name="TransAB"
              location="file://grafcet_models/model_0014.gcf#TransAB"
              condition="A_completed"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.4"
              name="TransBA"
              location="file://grafcet_models/model_0014.gcf#TransBA"
              condition="B_retry"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.5"
              name="TransBC"
              location="file://grafcet_models/model_0014.gcf#TransBC"
              condition="B_done"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.0"
                 name="Arc_Init_to_AB"
                 location="file://grafcet_models/model_0014.gcf#Arc_Init_to_AB"
                 from="/0/@elements.0"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.1"
                 name="Arc_Middle_to_BA"
                 location="file://grafcet_models/model_0014.gcf#Arc_Middle_to_BA"
                 from="/0/@elements.1"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.2"
                 name="Arc_Middle_to_BC"
                 location="file://grafcet_models/model_0014.gcf#Arc_Middle_to_BC"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.3"
                 name="Arc_AB_to_Middle"
                 location="file://grafcet_models/model_0014.gcf#Arc_AB_to_Middle"
                 from="/0/@elements.3"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.4"
                 name="Arc_BA_to_Init"
                 location="file://grafcet_models/model_0014.gcf#Arc_BA_to_Init"
                 from="/0/@elements.4"
                 to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.5"
                 name="Arc_BC_to_Final"
                 location="file://grafcet_models/model_0014.gcf#Arc_BC_to_Final"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>