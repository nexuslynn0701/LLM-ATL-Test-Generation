<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="g1" name="ProductionLineGrafcet" location="file://model/grafcet_0076.gc">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="s1"
              name="StartStep"
              location="file://model/grafcet_0076.gc#s1"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="s2"
              name="LoadMaterials"
              location="file://model/grafcet_0076.gc#s2"
              isInitial="false"
              isActive="false"
              action="load_materials"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="s3"
              name="AssemblyStep"
              location="file://model/grafcet_0076.gc#s3"
              isInitial="false"
              isActive="false"
              action="assemble_components"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="s4"
              name="QualityCheck"
              location="file://model/grafcet_0076.gc#s4"
              isInitial="false"
              isActive="false"
              action="check_quality"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="s5"
              name="PackagingStep"
              location="file://model/grafcet_0076.gc#s5"
              isInitial="false"
              isActive="false"
              action="package_products"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t1"
              name="T_StartToLoad"
              location="file://model/grafcet_0076.gc#t1"
              condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t2"
              name="T_LoadToAssembly"
              location="file://model/grafcet_0076.gc#t2"
              condition="materials_loaded"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t3"
              name="T_AssemblyToCheck"
              location="file://model/grafcet_0076.gc#t3"
              condition="assembly_complete"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t4"
              name="T_CheckToPackaging"
              location="file://model/grafcet_0076.gc#t4"
              condition="quality_ok"/>

    <!-- Connections: StepToTransition (PlaceToTransition arcs in target) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c1"
                 name="C_Start_to_T1"
                 location="file://model/grafcet_0076.gc#c1"
                 from="/0/@elements.0"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c2"
                 name="C_Load_to_T2"
                 location="file://model/grafcet_0076.gc#c2"
                 from="/0/@elements.1"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c3"
                 name="C_Assembly_to_T3"
                 location="file://model/grafcet_0076.gc#c3"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c4"
                 name="C_Check_to_T4"
                 location="file://model/grafcet_0076.gc#c4"
                 from="/0/@elements.3"
                 to="/0/@elements.8"/>

    <!-- Connections: TransitionToStep (TransitionToPlace arcs in target) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c5"
                 name="C_T1_to_Load"
                 location="file://model/grafcet_0076.gc#c5"
                 from="/0/@elements.5"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c6"
                 name="C_T2_to_Assembly"
                 location="file://model/grafcet_0076.gc#c6"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c7"
                 name="C_T3_to_Check"
                 location="file://model/grafcet_0076.gc#c7"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c8"
                 name="C_T4_to_Packaging"
                 location="file://model/grafcet_0076.gc#c8"
                 from="/0/@elements.8"
                 to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>