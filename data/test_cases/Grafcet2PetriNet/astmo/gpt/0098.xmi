<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ProductionLineGrafcet" location="plant:A1:line3">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitializeSystem" location="plant:A1:line3:step:init" isInitial="true" isActive="true" action="INIT_SEQ"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="LoadMaterial" location="plant:A1:line3:step:load" isInitial="false" isActive="false" action="LOAD_MATERIAL"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="ProcessMaterial" location="plant:A1:line3:step:process" isInitial="false" isActive="false" action="PROCESS_MATERIAL"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="UnloadMaterial" location="plant:A1:line3:step:unload" isInitial="false" isActive="false" action="UNLOAD_MATERIAL"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="T_init_to_load" location="plant:A1:line3:trans:init_load" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="T_load_to_process" location="plant:A1:line3:trans:load_process" condition="materialLoaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="T_process_to_unload" location="plant:A1:line3:trans:process_unload" condition="processComplete"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="C_init_load" location="plant:A1:line3:conn:init_load" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.1" name="C_load_step" location="plant:A1:line3:conn:load_step" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" name="C_load_process" location="plant:A1:line3:conn:load_process" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" name="C_process_step" location="plant:A1:line3:conn:process_step" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.4" name="C_process_unload" location="plant:A1:line3:conn:process_unload" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5" name="C_unload_step" location="plant:A1:line3:conn:unload_step" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>