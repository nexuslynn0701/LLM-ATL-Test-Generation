<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ProductionLineGrafcet" location="plant:lineA:main">

    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.0"
              name="InitStep"
              location="plant:lineA:init"
              isInitial="true"
              isActive="true"
              action="initialize_conveyors"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.1"
              name="LoadStep"
              location="plant:lineA:load"
              isInitial="false"
              isActive="false"
              action="load_material"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.2"
              name="ProcessStep"
              location="plant:lineA:process"
              isInitial="false"
              isActive="false"
              action="start_processing"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.3"
              name="UnloadStep"
              location="plant:lineA:unload"
              isInitial="false"
              isActive="false"
              action="unload_output"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.4"
              name="T_InitToLoad"
              location="plant:lineA:init_to_load"
              condition="conveyors_ready"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.5"
              name="T_LoadToProcess"
              location="plant:lineA:load_to_process"
              condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.6"
              name="T_ProcessToUnload"
              location="plant:lineA:process_to_unload"
              condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.7"
              name="T_UnloadToInit"
              location="plant:lineA:unload_to_init"
              condition="output_cleared"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.0"
                 name="C_Init_to_TInitLoad"
                 location="plant:lineA:conn0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.1"
                 name="C_Load_to_TLoadProcess"
                 location="plant:lineA:conn1"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.2"
                 name="C_Process_to_TProcessUnload"
                 location="plant:lineA:conn2"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.3"
                 name="C_Unload_to_TUnloadInit"
                 location="plant:lineA:conn3"
                 from="/0/@elements.3"
                 to="/0/@elements.7"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.4"
                 name="C_TInitLoad_to_Load"
                 location="plant:lineA:conn4"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.5"
                 name="C_TLoadProcess_to_Process"
                 location="plant:lineA:conn5"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.6"
                 name="C_TProcessUnload_to_Unload"
                 location="plant:lineA:conn6"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.7"
                 name="C_TUnloadInit_to_Init"
                 location="plant:lineA:conn7"
                 from="/0/@elements.7"
                 to="/0/@elements.0"/>

  </Grafcet:Grafcet>
</xmi:XMI>