<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_G0" name="ProductionSequence" location="factory_line_01">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitBuffer" location="factory_line_01" isInitial="true" isActive="true" action="initialize_buffer"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="LoadMaterial" location="factory_line_01" isInitial="false" isActive="false" action="load_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="StartMachine" location="factory_line_01" isInitial="false" isActive="false" action="start_machine"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="QualityCheck" location="factory_line_01" isInitial="false" isActive="false" action="quality_check"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="PackProduct" location="factory_line_01" isInitial="false" isActive="false" action="pack_product"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="bufferReady" location="factory_line_01" condition="buffer_sensor_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="materialLoaded" location="factory_line_01" condition="material_sensor_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="machineRunning" location="factory_line_01" condition="rpm_stable"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="checkPassed" location="factory_line_01" condition="quality_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" name="packCompleted" location="factory_line_01" condition="pack_counter_full"/>

    <!-- StepToTransition Connections (Step -> Transition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="c_Init_to_bufferReady" location="factory_line_01" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C1" name="c_Load_to_materialLoaded" location="factory_line_01" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="c_Start_to_machineRunning" location="factory_line_01" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="c_Check_to_checkPassed" location="factory_line_01" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="c_Pack_to_packCompleted" location="factory_line_01" from="/0/@elements.4" to="/0/@elements.9"/>

    <!-- TransitionToStep Connections (Transition -> Step) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="c_bufferReady_to_Load" location="factory_line_01" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C6" name="c_materialLoaded_to_Start" location="factory_line_01" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="c_machineRunning_to_Check" location="factory_line_01" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C8" name="c_checkPassed_to_Pack" location="factory_line_01" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C9" name="c_packCompleted_to_Init" location="factory_line_01" from="/0/@elements.9" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>