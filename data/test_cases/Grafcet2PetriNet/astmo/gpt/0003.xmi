<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ProductionLineGrafcet" location="factory.floor.zone5">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0"
              name="InitStep" location="factory.floor.zone5"
              isInitial="true" isActive="true" action="initialize_conveyor_and_sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1"
              name="LoadStep" location="factory.floor.zone5"
              isInitial="false" isActive="false" action="load_material_to_carrier"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2"
              name="ProcessStep" location="factory.floor.zone5"
              isInitial="false" isActive="false" action="execute_processing_operation"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3"
              name="UnloadStep" location="factory.floor.zone5"
              isInitial="false" isActive="false" action="unload_finished_product"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4"
              name="InitToLoadTransition" location="factory.floor.zone5"
              condition="conveyor_ready_and_sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5"
              name="LoadToProcessTransition" location="factory.floor.zone5"
              condition="material_loaded_and_clamped"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6"
              name="ProcessToUnloadTransition" location="factory.floor.zone5"
              condition="processing_cycle_completed"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0"
                 name="Arc_Init_to_InitToLoad" location="factory.floor.zone5"
                 from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.1"
                 name="Arc_Load_to_LoadToProcess" location="factory.floor.zone5"
                 from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2"
                 name="Arc_Process_to_ProcessToUnload" location="factory.floor.zone5"
                 from="/0/@elements.2" to="/0/@elements.6"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3"
                 name="Arc_InitToLoad_to_Load" location="factory.floor.zone5"
                 from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.4"
                 name="Arc_LoadToProcess_to_Process" location="factory.floor.zone5"
                 from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5"
                 name="Arc_ProcessToUnload_to_Unload" location="factory.floor.zone5"
                 from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>