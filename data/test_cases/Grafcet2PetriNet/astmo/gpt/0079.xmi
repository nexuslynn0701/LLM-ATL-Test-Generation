<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ProductionLineGrafcet" location="plant:lineA">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.0"
              name="InitStep"
              location="plant:lineA:init"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.1"
              name="LoadMaterial"
              location="plant:lineA:load"
              isInitial="false"
              isActive="false"
              action="load_material"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.2"
              name="ProcessMaterial"
              location="plant:lineA:process"
              isInitial="false"
              isActive="false"
              action="process_material"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.3"
              name="UnloadMaterial"
              location="plant:lineA:unload"
              isInitial="false"
              isActive="false"
              action="unload_material"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.4"
              name="T_InitToLoad"
              location="plant:lineA:t0"
              condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.5"
              name="T_LoadToProcess"
              location="plant:lineA:t1"
              condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.6"
              name="T_ProcessToUnload"
              location="plant:lineA:t2"
              condition="processing_done"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.0"
                 name="C_Init_to_T0"
                 location="plant:lineA:c0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.1"
                 name="C_Load_to_T1"
                 location="plant:lineA:c1"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.2"
                 name="C_Process_to_T2"
                 location="plant:lineA:c2"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.3"
                 name="C_T0_to_Load"
                 location="plant:lineA:c3"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.4"
                 name="C_T1_to_Process"
                 location="plant:lineA:c4"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.5"
                 name="C_T2_to_Unload"
                 location="plant:lineA:c5"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>