<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <!-- Single Grafcet with multiple steps, transitions, and a branching/merging structure -->
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet_0096" location="file://grafcet/complex_0096.gct">

    <!-- Elements: 4 Steps and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="loc_S0" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="BranchStepA" location="loc_S1" isInitial="false" isActive="false" action="do_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="BranchStepB" location="loc_S2" isInitial="false" isActive="false" action="do_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="JoinStep" location="loc_S3" isInitial="false" isActive="false" action="finalize"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="SplitTransition" location="loc_T0" condition="cond_split"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="TransAB" location="loc_T1" condition="cond_AB"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="MergeTransition" location="loc_T2" condition="cond_merge"/>

    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- InitStep -> SplitTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C0"
                 name="Arc_Init_to_Split"
                 location="loc_C0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>

    <!-- SplitTransition -> BranchStepA -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C1"
                 name="Arc_Split_to_A"
                 location="loc_C1"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>

    <!-- SplitTransition -> BranchStepB -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C2"
                 name="Arc_Split_to_B"
                 location="loc_C2"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>

    <!-- BranchStepA -> TransAB -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C3"
                 name="Arc_A_to_AB"
                 location="loc_C3"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>

    <!-- BranchStepB -> TransAB -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C4"
                 name="Arc_B_to_AB"
                 location="loc_C4"
                 from="/0/@elements.2"
                 to="/0/@elements.5"/>

    <!-- TransAB -> JoinStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C5"
                 name="Arc_AB_to_Join"
                 location="loc_C5"
                 from="/0/@elements.5"
                 to="/0/@elements.3"/>

    <!-- JoinStep -> MergeTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C6"
                 name="Arc_Join_to_Merge"
                 location="loc_C6"
                 from="/0/@elements.3"
                 to="/0/@elements.6"/>

    <!-- MergeTransition -> InitStep (loop back) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C7"
                 name="Arc_Merge_to_Init"
                 location="loc_C7"
                 from="/0/@elements.6"
                 to="/0/@elements.0"/>

  </Grafcet:Grafcet>
</xmi:XMI>