<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ProductionLineGrafcet" location="modelLocation:/production/line">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStep" location="modelLocation:/production/line/steps/init" isInitial="true" isActive="true" action="Initialize conveyors and sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="LoadMaterialStep" location="modelLocation:/production/line/steps/load" isInitial="false" isActive="false" action="Load raw material onto conveyor"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="ProcessStep" location="modelLocation:/production/line/steps/process" isInitial="false" isActive="false" action="Run machining operation"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="UnloadStep" location="modelLocation:/production/line/steps/unload" isInitial="false" isActive="false" action="Unload finished product"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="T_InitToLoad" location="modelLocation:/production/line/transitions/initToLoad" condition="ConveyorsReady AND SensorsOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="T_LoadToProcess" location="modelLocation:/production/line/transitions/loadToProcess" condition="MaterialLoaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="T_ProcessToUnload" location="modelLocation:/production/line/transitions/processToUnload" condition="ProcessingComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.7" name="T_UnloadToInit" location="modelLocation:/production/line/transitions/unloadToInit" condition="UnloadingComplete"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="Arc_Init_to_T_InitToLoad" location="modelLocation:/production/line/connections/init_to_T_InitToLoad" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.1" name="Arc_T_InitToLoad_to_Load" location="modelLocation:/production/line/connections/T_InitToLoad_to_load" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" name="Arc_Load_to_T_LoadToProcess" location="modelLocation:/production/line/connections/load_to_T_LoadToProcess" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" name="Arc_T_LoadToProcess_to_Process" location="modelLocation:/production/line/connections/T_LoadToProcess_to_process" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.4" name="Arc_Process_to_T_ProcessToUnload" location="modelLocation:/production/line/connections/process_to_T_ProcessToUnload" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5" name="Arc_T_ProcessToUnload_to_Unload" location="modelLocation:/production/line/connections/T_ProcessToUnload_to_unload" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.6" name="Arc_Unload_to_T_UnloadToInit" location="modelLocation:/production/line/connections/unload_to_T_UnloadToInit" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.7" name="Arc_T_UnloadToInit_to_Init" location="modelLocation:/production/line/connections/T_UnloadToInit_to_init" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>