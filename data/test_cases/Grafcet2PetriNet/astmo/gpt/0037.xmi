<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_grafcet1" name="ProductionLineGrafcet" location="file://model/productionLine.grafcet">
    <elements xsi:type="Grafcet:Step" xmi:id="_step1" name="LoadMaterial" location="file://model/productionLine.grafcet#LoadMaterial" isInitial="true" isActive="true" action="load_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step2" name="ProcessMaterial" location="file://model/productionLine.grafcet#ProcessMaterial" isInitial="false" isActive="false" action="process_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step3" name="UnloadMaterial" location="file://model/productionLine.grafcet#UnloadMaterial" isInitial="false" isActive="false" action="unload_material"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans1" name="T_LoadToProcess" location="file://model/productionLine.grafcet#T_LoadToProcess" condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans2" name="T_ProcessToUnload" location="file://model/productionLine.grafcet#T_ProcessToUnload" condition="processing_done"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn1" name="Arc_Load_To_T1" location="file://model/productionLine.grafcet#Arc_Load_To_T1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn2" name="Arc_T1_To_Process" location="file://model/productionLine.grafcet#Arc_T1_To_Process" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn3" name="Arc_Process_To_T2" location="file://model/productionLine.grafcet#Arc_Process_To_T2" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn4" name="Arc_T2_To_Unload" location="file://model/productionLine.grafcet#Arc_T2_To_Unload" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>