<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet0072" location="file://model/complex0072.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStepA" location="file://model/complex0072.grafcet#InitStepA" isInitial="true" isActive="true" action="initialize system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="MiddleStepB" location="file://model/complex0072.grafcet#MiddleStepB" isInitial="false" isActive="false" action="perform computation"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="BranchStepC" location="file://model/complex0072.grafcet#BranchStepC" isInitial="false" isActive="false" action="prepare branch"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="FinalStepD" location="file://model/complex0072.grafcet#FinalStepD" isInitial="false" isActive="false" action="shutdown"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="Transition1" location="file://model/complex0072.grafcet#Transition1" condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="Transition2" location="file://model/complex0072.grafcet#Transition2" condition="computeDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="Transition3" location="file://model/complex0072.grafcet#Transition3" condition="branchOk"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.0"
                 name="Arc_Init_to_T1"
                 location="file://model/complex0072.grafcet#Arc_Init_to_T1"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.1"
                 name="Arc_Middle_to_T2"
                 location="file://model/complex0072.grafcet#Arc_Middle_to_T2"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.2"
                 name="Arc_Branch_to_T3"
                 location="file://model/complex0072.grafcet#Arc_Branch_to_T3"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.3"
                 name="Arc_T1_to_Middle"
                 location="file://model/complex0072.grafcet#Arc_T1_to_Middle"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.4"
                 name="Arc_T2_to_Branch"
                 location="file://model/complex0072.grafcet#Arc_T2_to_Branch"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.5"
                 name="Arc_T3_to_Final"
                 location="file://model/complex0072.grafcet#Arc_T3_to_Final"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>