<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="FactorySequence" location="file:/models/factorySequence.gcf">
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="StartStep" location="file:/models/factorySequence.gcf#S0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="LoadMaterial" location="file:/models/factorySequence.gcf#S1" isInitial="false" isActive="false" action="loadMaterial"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ProcessMaterial" location="file:/models/factorySequence.gcf#S2" isInitial="false" isActive="false" action="processMaterial"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="UnloadMaterial" location="file:/models/factorySequence.gcf#S3" isInitial="false" isActive="false" action="unloadMaterial"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="FromStartToLoad" location="file:/models/factorySequence.gcf#T0" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="FromLoadToProcess" location="file:/models/factorySequence.gcf#T1" condition="materialLoaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="FromProcessToUnload" location="file:/models/factorySequence.gcf#T2" condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="FromUnloadToStart" location="file:/models/factorySequence.gcf#T3" condition="unloadComplete"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="Arc_Start_to_T0" location="file:/models/factorySequence.gcf#C0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="Arc_T0_to_S1" location="file:/models/factorySequence.gcf#C1" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="Arc_S1_to_T1" location="file:/models/factorySequence.gcf#C2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C3" name="Arc_T1_to_S2" location="file:/models/factorySequence.gcf#C3" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="Arc_S2_to_T2" location="file:/models/factorySequence.gcf#C4" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="Arc_T2_to_S3" location="file:/models/factorySequence.gcf#C5" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" name="Arc_S3_to_T3" location="file:/models/factorySequence.gcf#C6" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="Arc_T3_to_S0" location="file:/models/factorySequence.gcf#C7" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>