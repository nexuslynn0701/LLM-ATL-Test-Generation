<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_grafcet_main" name="ProductionLineGrafcet" location="file://model/production_line.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_step_start"
              name="StartStep"
              location="file://model/production_line.grafcet#StartStep"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_step_load"
              name="LoadMaterial"
              location="file://model/production_line.grafcet#LoadMaterial"
              isInitial="false"
              isActive="false"
              action="load_material"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_step_process"
              name="ProcessMaterial"
              location="file://model/production_line.grafcet#ProcessMaterial"
              isInitial="false"
              isActive="false"
              action="process_material"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_step_unload"
              name="UnloadMaterial"
              location="file://model/production_line.grafcet#UnloadMaterial"
              isInitial="false"
              isActive="false"
              action="unload_material"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_trans_t1"
              name="T_Load"
              location="file://model/production_line.grafcet#T_Load"
              condition="command_load"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_trans_t2"
              name="T_Process"
              location="file://model/production_line.grafcet#T_Process"
              condition="sensor_loaded"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_trans_t3"
              name="T_Unload"
              location="file://model/production_line.grafcet#T_Unload"
              condition="sensor_processed"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_trans_t4"
              name="T_Reset"
              location="file://model/production_line.grafcet#T_Reset"
              condition="command_reset"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_conn_s_start_t1"
                 name="Arc_Start_to_T_Load"
                 location="file://model/production_line.grafcet#Arc_Start_to_T_Load"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_conn_s_load_t2"
                 name="Arc_Load_to_T_Process"
                 location="file://model/production_line.grafcet#Arc_Load_to_T_Process"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_conn_s_process_t3"
                 name="Arc_Process_to_T_Unload"
                 location="file://model/production_line.grafcet#Arc_Process_to_T_Unload"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_conn_s_unload_t4"
                 name="Arc_Unload_to_T_Reset"
                 location="file://model/production_line.grafcet#Arc_Unload_to_T_Reset"
                 from="/0/@elements.3"
                 to="/0/@elements.7"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_conn_t1_s_load"
                 name="Arc_T_Load_to_Load"
                 location="file://model/production_line.grafcet#Arc_T_Load_to_Load"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_conn_t2_s_process"
                 name="Arc_T_Process_to_Process"
                 location="file://model/production_line.grafcet#Arc_T_Process_to_Process"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_conn_t3_s_unload"
                 name="Arc_T_Unload_to_Unload"
                 location="file://model/production_line.grafcet#Arc_T_Unload_to_Unload"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_conn_t4_s_start"
                 name="Arc_T_Reset_to_Start"
                 location="file://model/production_line.grafcet#Arc_T_Reset_to_Start"
                 from="/0/@elements.7"
                 to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>