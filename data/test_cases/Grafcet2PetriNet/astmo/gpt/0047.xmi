<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ProductionLineGrafcet" location="factoryFloor">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStep" location="factoryFloor" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="LoadMaterial" location="loadingZone" isInitial="false" isActive="false" action="loadMaterial"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="ProcessMaterial" location="processingUnit" isInitial="false" isActive="false" action="processMaterial"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="UnloadMaterial" location="unloadingZone" isInitial="false" isActive="false" action="unloadMaterial"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="T_InitToLoad" location="factoryFloor" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="T_LoadToProcess" location="loadingZone" condition="materialLoaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="T_ProcessToUnload" location="processingUnit" condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.7" name="T_UnloadToInit" location="unloadingZone" condition="unloadingComplete"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="C_Init_Load" location="factoryFloor" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.1" name="C_Load_Process" location="loadingZone" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" name="C_Load_TProcess" location="loadingZone" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" name="C_Process_Unload" location="processingUnit" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.4" name="C_Process_TUnload" location="processingUnit" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5" name="C_Unload_Init" location="unloadingZone" from="/0/@elements.7" to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.6" name="C_Unload_TInit" location="unloadingZone" from="/0/@elements.3" to="/0/@elements.7"/>
  </Grafcet:Grafcet>
</xmi:XMI>