<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_grafcet1" name="ComplexProcess" location="model://grafcet/complex">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_step1" name="InitStep" location="model://grafcet/complex#s1" isInitial="true" isActive="true" action="initialize system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step2" name="LoadData" location="model://grafcet/complex#s2" isInitial="false" isActive="false" action="load data from source"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step3" name="ProcessData" location="model://grafcet/complex#s3" isInitial="false" isActive="false" action="process loaded data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step4" name="Finalize" location="model://grafcet/complex#s4" isInitial="false" isActive="false" action="finalize and cleanup"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans1" name="t_init_load" location="model://grafcet/complex#t1" condition="system initialized"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans2" name="t_load_process" location="model://grafcet/complex#t2" condition="data loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans3" name="t_process_finalize" location="model://grafcet/complex#t3" condition="processing complete"/>
    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_s1_t1" name="arc_init_to_t1" location="model://grafcet/complex#c1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_s2_t2" name="arc_load_to_t2" location="model://grafcet/complex#c2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_s3_t3" name="arc_process_to_t3" location="model://grafcet/complex#c3" from="/0/@elements.2" to="/0/@elements.6"/>
    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t1_s2" name="arc_t1_to_load" location="model://grafcet/complex#c4" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t2_s3" name="arc_t2_to_process" location="model://grafcet/complex#c5" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t3_s4" name="arc_t3_to_finalize" location="model://grafcet/complex#c6" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>