<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ProductionLineControl" location="plantA/section3">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="StartupStep" location="plantA/section3/startup" isInitial="true" isActive="true" action="initialize_machines"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="LoadMaterial" location="plantA/section3/load" isInitial="false" isActive="false" action="load_raw_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="ProcessBatch" location="plantA/section3/process" isInitial="false" isActive="false" action="run_batch_cycle"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="UnloadMaterial" location="plantA/section3/unload" isInitial="false" isActive="false" action="unload_finished_goods"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="StartupToLoad" location="plantA/section3/t1" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="LoadToProcess" location="plantA/section3/t2" condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="ProcessToUnload" location="plantA/section3/t3" condition="batch_completed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.7" name="UnloadToStartup" location="plantA/section3/t4" condition="line_cleared"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="Arc_Startup_to_T1" location="plantA/section3/c0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.1" name="Arc_T1_to_Load" location="plantA/section3/c1" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" name="Arc_Load_to_T2" location="plantA/section3/c2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" name="Arc_T2_to_Process" location="plantA/section3/c3" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.4" name="Arc_Process_to_T3" location="plantA/section3/c4" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5" name="Arc_T3_to_Unload" location="plantA/section3/c5" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.6" name="Arc_Unload_to_T4" location="plantA/section3/c6" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.7" name="Arc_T4_to_Startup" location="plantA/section3/c7" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>