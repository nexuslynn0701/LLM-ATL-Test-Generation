<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_grafcet_main" name="ProductionLineGrafcet" location="plantA.section3">
    <elements xsi:type="Grafcet:Step" xmi:id="_step_start" name="StartStep" location="plantA.section3" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_load" name="LoadStep" location="plantA.section3" isInitial="false" isActive="false" action="load_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_process" name="ProcessStep" location="plantA.section3" isInitial="false" isActive="false" action="process_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_unload" name="UnloadStep" location="plantA.section3" isInitial="false" isActive="false" action="unload_material"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_t1" name="T1_Load" location="plantA.section3" condition="material_detected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_t2" name="T2_Process" location="plantA.section3" condition="load_complete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_t3" name="T3_Unload" location="plantA.section3" condition="process_complete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_t4" name="T4_Reset" location="plantA.section3" condition="unload_complete"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn_s_start_t1" name="Arc_Start_to_T1" location="plantA.section3" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn_t1_s_load" name="Arc_T1_to_Load" location="plantA.section3" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn_s_load_t2" name="Arc_Load_to_T2" location="plantA.section3" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn_t2_s_process" name="Arc_T2_to_Process" location="plantA.section3" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn_s_process_t3" name="Arc_Process_to_T3" location="plantA.section3" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn_t3_s_unload" name="Arc_T3_to_Unload" location="plantA.section3" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn_s_unload_t4" name="Arc_Unload_to_T4" location="plantA.section3" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn_t4_s_start" name="Arc_T4_to_Start" location="plantA.section3" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>