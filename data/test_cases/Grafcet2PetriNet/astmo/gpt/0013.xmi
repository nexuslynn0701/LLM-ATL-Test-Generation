<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g1" name="ProductionLineGrafcet" location="file://grafcets/production_line.gcf">
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="StartStep" location="file://grafcets/production_line.gcf#s1" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="LoadMaterial" location="file://grafcets/production_line.gcf#s2" isInitial="false" isActive="false" action="load_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ProcessMaterial" location="file://grafcets/production_line.gcf#s3" isInitial="false" isActive="false" action="process_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="UnloadMaterial" location="file://grafcets/production_line.gcf#s4" isInitial="false" isActive="false" action="unload_material"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Load" location="file://grafcets/production_line.gcf#t1" condition="material_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_Process" location="file://grafcets/production_line.gcf#t2" condition="loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_Unload" location="file://grafcets/production_line.gcf#t3" condition="processed"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="Arc_S1_T1" location="file://grafcets/production_line.gcf#c1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="Arc_T1_S2" location="file://grafcets/production_line.gcf#c2" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="Arc_S2_T2" location="file://grafcets/production_line.gcf#c3" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="Arc_T2_S3" location="file://grafcets/production_line.gcf#c4" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="Arc_S3_T3" location="file://grafcets/production_line.gcf#c5" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="Arc_T3_S4" location="file://grafcets/production_line.gcf#c6" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>