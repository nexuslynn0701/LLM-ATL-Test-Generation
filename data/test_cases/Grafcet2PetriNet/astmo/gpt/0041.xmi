<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexMachineSequence" location="file://model/complex_grafcet.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              name="Startup"
              location="file://model/complex_grafcet.gcf#Startup"
              isInitial="true"
              isActive="true"
              action="init_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="Warmup"
              location="file://model/complex_grafcet.gcf#Warmup"
              isInitial="false"
              isActive="false"
              action="heat_components"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="Production"
              location="file://model/complex_grafcet.gcf#Production"
              isInitial="false"
              isActive="false"
              action="run_cycle"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              name="Shutdown"
              location="file://model/complex_grafcet.gcf#Shutdown"
              isInitial="false"
              isActive="false"
              action="stop_system"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              name="toWarmup"
              location="file://model/complex_grafcet.gcf#toWarmup"
              condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="toProduction"
              location="file://model/complex_grafcet.gcf#toProduction"
              condition="warmup_complete"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="toShutdown"
              location="file://model/complex_grafcet.gcf#toShutdown"
              condition="stop_command"/>

    <!-- StepToTransition connections (PlaceToTransition arcs in target) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="Startup_toWarmup"
                 location="file://model/complex_grafcet.gcf#Startup_toWarmup"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="Warmup_toProduction"
                 location="file://model/complex_grafcet.gcf#Warmup_toProduction"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="Production_toShutdownTransition"
                 location="file://model/complex_grafcet.gcf#Production_toShutdownTransition"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>

    <!-- TransitionToStep connections (TransitionToPlace arcs in target) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c3"
                 name="toWarmup_Warmup"
                 location="file://model/complex_grafcet.gcf#toWarmup_Warmup"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 name="toProduction_Production"
                 location="file://model/complex_grafcet.gcf#toProduction_Production"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 name="toShutdown_Shutdown"
                 location="file://model/complex_grafcet.gcf#toShutdown_Shutdown"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>

</xmi:XMI>