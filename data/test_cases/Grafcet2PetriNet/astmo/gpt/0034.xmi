<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ProductionLine" location="model_location_0034">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="LoadMaterial" location="loc_step_load" isInitial="true" isActive="true" action="load_material_action"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="ProcessMaterial" location="loc_step_process" isInitial="false" isActive="false" action="process_material_action"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="UnloadMaterial" location="loc_step_unload" isInitial="false" isActive="false" action="unload_material_action"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.3" name="StartProcessing" location="loc_trans_start" condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="FinishProcessing" location="loc_trans_finish" condition="processing_complete"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="Arc_Load_to_Start" location="loc_conn_0" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.1" name="Arc_Start_to_Process" location="loc_conn_1" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" name="Arc_Process_to_Finish" location="loc_conn_2" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" name="Arc_Finish_to_Unload" location="loc_conn_3" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>