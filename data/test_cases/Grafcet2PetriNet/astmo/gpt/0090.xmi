<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet0090" location="file://model/grafcet0090.grafcet">
    <!-- Elements: 3 Steps + 2 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="L1" isInitial="true" isActive="true" action="startSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="IntermediateStep" location="L2" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="FinalStep" location="L3" isInitial="false" isActive="false" action="shutdown"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_to_Intermediate" location="L4" condition="condA"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Intermediate_to_Final" location="L5" condition="condB"/>

    <!-- Connections: 2 StepToTransition + 2 TransitionToStep forming a linear chain -->
    <!-- InitStep -> T_Init_to_Intermediate -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="C_Init_to_T0"
                 location="LC0"
                 from="/0/@elements.0"
                 to="/0/@elements.3"/>
    <!-- T_Init_to_Intermediate -> IntermediateStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c1"
                 name="C_T0_to_Intermediate"
                 location="LC1"
                 from="/0/@elements.3"
                 to="/0/@elements.1"/>
    <!-- IntermediateStep -> T_Intermediate_to_Final -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="C_Intermediate_to_T1"
                 location="LC2"
                 from="/0/@elements.1"
                 to="/0/@elements.4"/>
    <!-- T_Intermediate_to_Final -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c3"
                 name="C_T1_to_Final"
                 location="LC3"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>
  </Grafcet:Grafcet>

</xmi:XMI>