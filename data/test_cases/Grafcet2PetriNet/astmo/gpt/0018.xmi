<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g1" name="ComplexGrafcet0018" location="file://complexGrafcet0018.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="StartStep"
              location="file://complexGrafcet0018.gcf#s1"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="ProcessingStepA"
              location="file://complexGrafcet0018.gcf#s2"
              isInitial="false"
              isActive="false"
              action="process_A"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              name="ProcessingStepB"
              location="file://complexGrafcet0018.gcf#s3"
              isInitial="false"
              isActive="false"
              action="process_B"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s4"
              name="FinalStep"
              location="file://complexGrafcet0018.gcf#s4"
              isInitial="false"
              isActive="false"
              action="shutdown_system"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="T_Start_to_A"
              location="file://complexGrafcet0018.gcf#t1"
              condition="start_completed"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="T_A_to_B"
              location="file://complexGrafcet0018.gcf#t2"
              condition="A_ok"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t3"
              name="T_B_to_Final"
              location="file://complexGrafcet0018.gcf#t3"
              condition="B_ok"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t4"
              name="T_A_to_FinalDirect"
              location="file://complexGrafcet0018.gcf#t4"
              condition="A_skip_B"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="C_Start_to_T1"
                 location="file://complexGrafcet0018.gcf#c1"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="C_A_to_T2"
                 location="file://complexGrafcet0018.gcf#c2"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 name="C_B_to_T3"
                 location="file://complexGrafcet0018.gcf#c3"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c4"
                 name="C_A_to_T4"
                 location="file://complexGrafcet0018.gcf#c4"
                 from="/0/@elements.1"
                 to="/0/@elements.7"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 name="C_T1_to_A"
                 location="file://complexGrafcet0018.gcf#c5"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 name="C_T2_to_B"
                 location="file://complexGrafcet0018.gcf#c6"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 name="C_T3_to_Final"
                 location="file://complexGrafcet0018.gcf#c7"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c8"
                 name="C_T4_to_FinalDirect"
                 location="file://complexGrafcet0018.gcf#c8"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>