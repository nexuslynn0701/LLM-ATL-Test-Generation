<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g1" name="ComplexProcess" location="plant/lineA">
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="InitStep" location="plant/lineA/s1" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="LoadStep" location="plant/lineA/s2" isInitial="false" isActive="false" action="loadMaterial"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ProcessStep" location="plant/lineA/s3" isInitial="false" isActive="false" action="runProcessing"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Init_Load" location="plant/lineA/t1" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_Load_Process" location="plant/lineA/t2" condition="materialReady"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Init_to_T1" location="plant/lineA/c1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="C_T1_to_Load" location="plant/lineA/c2" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_Load_to_T2" location="plant/lineA/c3" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="C_T2_to_Process" location="plant/lineA/c4" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>