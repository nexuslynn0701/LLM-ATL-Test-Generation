<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g1" name="ProductionLineGrafcet" location="file://model/production_line.grafcet">
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="StartStep" location="file://model/production_line.grafcet#StartStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="LoadMaterialStep" location="file://model/production_line.grafcet#LoadMaterialStep" isInitial="false" isActive="false" action="load_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ProcessMaterialStep" location="file://model/production_line.grafcet#ProcessMaterialStep" isInitial="false" isActive="false" action="process_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="UnloadMaterialStep" location="file://model/production_line.grafcet#UnloadMaterialStep" isInitial="false" isActive="false" action="unload_material"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="StartToLoadTransition" location="file://model/production_line.grafcet#StartToLoadTransition" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="LoadToProcessTransition" location="file://model/production_line.grafcet#LoadToProcessTransition" condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="ProcessToUnloadTransition" location="file://model/production_line.grafcet#ProcessToUnloadTransition" condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="UnloadToStartTransition" location="file://model/production_line.grafcet#UnloadToStartTransition" condition="unload_complete"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="Arc_Start_to_t1" location="file://model/production_line.grafcet#Arc_Start_to_t1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="Arc_t1_to_Load" location="file://model/production_line.grafcet#Arc_t1_to_Load" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="Arc_Load_to_t2" location="file://model/production_line.grafcet#Arc_Load_to_t2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="Arc_t2_to_Process" location="file://model/production_line.grafcet#Arc_t2_to_Process" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="Arc_Process_to_t3" location="file://model/production_line.grafcet#Arc_Process_to_t3" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="Arc_t3_to_Unload" location="file://model/production_line.grafcet#Arc_t3_to_Unload" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="Arc_Unload_to_t4" location="file://model/production_line.grafcet#Arc_Unload_to_t4" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="Arc_t4_to_Start" location="file://model/production_line.grafcet#Arc_t4_to_Start" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>