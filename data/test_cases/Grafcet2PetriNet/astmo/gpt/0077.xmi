<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ProductionLineGrafcet" location="plant:areaA:line3">
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitBuffer" location="plant:areaA:line3:stepInit" isInitial="true" isActive="true" action="initialize_buffer"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="LoadMaterial" location="plant:areaA:line3:stepLoad" isInitial="false" isActive="false" action="load_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ProcessBatch" location="plant:areaA:line3:stepProcess" isInitial="false" isActive="false" action="process_batch"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="t_start_loading" location="plant:areaA:line3:transStart" condition="buffer_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="t_start_processing" location="plant:areaA:line3:transProcess" condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="t_reset_cycle" location="plant:areaA:line3:transReset" condition="batch_completed"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="c_Init_to_startLoading" location="plant:areaA:line3:conn0" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="c_startLoading_to_Load" location="plant:areaA:line3:conn1" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="c_Load_to_startProcessing" location="plant:areaA:line3:conn2" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C3" name="c_startProcessing_to_Process" location="plant:areaA:line3:conn3" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="c_Process_to_resetCycle" location="plant:areaA:line3:conn4" from="/0/@elements.2" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="c_resetCycle_to_Init" location="plant:areaA:line3:conn5" from="/0/@elements.5" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>