<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet0066" location="loc_grafcet_0066">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0"
              name="InitStepA" location="loc_step_A"
              isInitial="true" isActive="true" action="startA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1"
              name="StepB" location="loc_step_B"
              isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2"
              name="InitStepC" location="loc_step_C"
              isInitial="true" isActive="false" action="startC"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3"
              name="StepD" location="loc_step_D"
              isInitial="false" isActive="true" action="finalizeD"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4"
              name="Trans1" location="loc_trans_1" condition="cond1"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5"
              name="Trans2" location="loc_trans_2" condition="cond2"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6"
              name="Trans3" location="loc_trans_3" condition="cond3"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0"
                 name="Arc_ST_A_T1" location="loc_conn_A_T1"
                 from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.1"
                 name="Arc_ST_B_T1" location="loc_conn_B_T1"
                 from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2"
                 name="Arc_ST_B_T2" location="loc_conn_B_T2"
                 from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.3"
                 name="Arc_ST_C_T3" location="loc_conn_C_T3"
                 from="/0/@elements.2" to="/0/@elements.6"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.4"
                 name="Arc_TS_T1_D" location="loc_conn_T1_D"
                 from="/0/@elements.4" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5"
                 name="Arc_TS_T2_D" location="loc_conn_T2_D"
                 from="/0/@elements.5" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.6"
                 name="Arc_TS_T3_B" location="loc_conn_T3_B"
                 from="/0/@elements.6" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>