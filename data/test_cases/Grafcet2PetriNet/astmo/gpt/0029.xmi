<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet0029" location="file://complex/grafcet_0029.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0"
              name="InitStepA" location="file://complex/grafcet_0029.gcf#InitStepA"
              isInitial="true" isActive="true" action="initialize system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1"
              name="ProcessingStepB" location="file://complex/grafcet_0029.gcf#ProcessingStepB"
              isInitial="false" isActive="false" action="process data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2"
              name="DecisionStepC" location="file://complex/grafcet_0029.gcf#DecisionStepC"
              isInitial="false" isActive="false" action="evaluate condition"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3"
              name="FinalStepD" location="file://complex/grafcet_0029.gcf#FinalStepD"
              isInitial="false" isActive="false" action="shutdown system"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4"
              name="T_A_to_B" location="file://complex/grafcet_0029.gcf#T_A_to_B"
              condition="init_complete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5"
              name="T_B_to_C" location="file://complex/grafcet_0029.gcf#T_B_to_C"
              condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6"
              name="T_C_to_D" location="file://complex/grafcet_0029.gcf#T_C_to_D"
              condition="decision_positive"/>

    <!-- StepToTransition connections (PlaceToTransition arcs in target) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0"
                 name="Conn_A_T1" location="file://complex/grafcet_0029.gcf#Conn_A_T1"
                 from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.1"
                 name="Conn_B_T2" location="file://complex/grafcet_0029.gcf#Conn_B_T2"
                 from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2"
                 name="Conn_C_T3" location="file://complex/grafcet_0029.gcf#Conn_C_T3"
                 from="/0/@elements.2" to="/0/@elements.6"/>

    <!-- TransitionToStep connections (TransitionToPlace arcs in target) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3"
                 name="Conn_T1_B" location="file://complex/grafcet_0029.gcf#Conn_T1_B"
                 from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.4"
                 name="Conn_T2_C" location="file://complex/grafcet_0029.gcf#Conn_T2_C"
                 from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5"
                 name="Conn_T3_D" location="file://complex/grafcet_0029.gcf#Conn_T3_D"
                 from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>

</xmi:XMI>