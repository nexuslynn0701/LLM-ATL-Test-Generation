<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet0048" location="loc_grafcet_0048">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0"
              name="InitStepA"
              location="loc_step_A"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1"
              name="ProcessingStepB"
              location="loc_step_B"
              isInitial="false"
              isActive="false"
              action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2"
              name="FinalStepC"
              location="loc_step_C"
              isInitial="false"
              isActive="false"
              action="finalize_sequence"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.3"
              name="TransAB"
              location="loc_trans_AB"
              condition="data_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4"
              name="TransBC"
              location="loc_trans_BC"
              condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5"
              name="TransCA"
              location="loc_trans_CA"
              condition="reset_triggered"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0"
                 name="Arc_Init_to_AB"
                 location="loc_conn_0"
                 from="/0/@elements.0"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.1"
                 name="Arc_B_to_BC"
                 location="loc_conn_1"
                 from="/0/@elements.1"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2"
                 name="Arc_C_to_CA"
                 location="loc_conn_2"
                 from="/0/@elements.2"
                 to="/0/@elements.5"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3"
                 name="Arc_AB_to_B"
                 location="loc_conn_3"
                 from="/0/@elements.3"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.4"
                 name="Arc_BC_to_C"
                 location="loc_conn_4"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5"
                 name="Arc_CA_to_Init"
                 location="loc_conn_5"
                 from="/0/@elements.5"
                 to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>