<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_grafcet0021" name="ComplexProcess" location="model/location/0021">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_stepA"
              name="StepA"
              location="model/location/0021/StepA"
              isInitial="true"
              isActive="true"
              action="Initialize system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_stepB"
              name="StepB"
              location="model/location/0021/StepB"
              isInitial="false"
              isActive="false"
              action="Perform operation 1"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_stepC"
              name="StepC"
              location="model/location/0021/StepC"
              isInitial="false"
              isActive="false"
              action="Perform operation 2"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_stepD"
              name="StepD"
              location="model/location/0021/StepD"
              isInitial="false"
              isActive="false"
              action="Finalize process"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_trans1"
              name="T1"
              location="model/location/0021/T1"
              condition="cond1"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_trans2"
              name="T2"
              location="model/location/0021/T2"
              condition="cond2"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_trans3"
              name="T3"
              location="model/location/0021/T3"
              condition="cond3"/>

    <!-- Connections: StepToTransition -->
    <!-- StepA -> T1 -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_conn_ST_A_T1"
                 name="Arc_A_T1"
                 location="model/location/0021/Arc_A_T1"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <!-- StepB -> T2 -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_conn_ST_B_T2"
                 name="Arc_B_T2"
                 location="model/location/0021/Arc_B_T2"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <!-- StepC -> T2 (fan-in to T2) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_conn_ST_C_T2"
                 name="Arc_C_T2"
                 location="model/location/0021/Arc_C_T2"
                 from="/0/@elements.2"
                 to="/0/@elements.5"/>
    <!-- StepC -> T3 -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_conn_ST_C_T3"
                 name="Arc_C_T3"
                 location="model/location/0021/Arc_C_T3"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>

    <!-- Connections: TransitionToStep -->
    <!-- T1 -> StepB -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_conn_TS_T1_B"
                 name="Arc_T1_B"
                 location="model/location/0021/Arc_T1_B"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <!-- T2 -> StepC -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_conn_TS_T2_C"
                 name="Arc_T2_C"
                 location="model/location/0021/Arc_T2_C"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <!-- T3 -> StepD -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_conn_TS_T3_D"
                 name="Arc_T3_D"
                 location="model/location/0021/Arc_T3_D"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>