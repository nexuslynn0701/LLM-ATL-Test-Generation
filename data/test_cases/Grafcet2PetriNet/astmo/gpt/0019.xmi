<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g1" name="ProductionLine" location="file://grafcet/production_line.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="LoadStation"
              location="file://grafcet/production_line.gcf#LoadStation"
              isInitial="true"
              isActive="true"
              action="load_parts"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="ProcessStation"
              location="file://grafcet/production_line.gcf#ProcessStation"
              isInitial="false"
              isActive="false"
              action="process_parts"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              name="UnloadStation"
              location="file://grafcet/production_line.gcf#UnloadStation"
              isInitial="false"
              isActive="false"
              action="unload_parts"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="Loaded"
              location="file://grafcet/production_line.gcf#Loaded"
              condition="parts_loaded"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="Processed"
              location="file://grafcet/production_line.gcf#Processed"
              condition="parts_processed"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="LoadToLoaded"
                 location="file://grafcet/production_line.gcf#LoadToLoaded"
                 from="/0/@elements.0"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="ProcessToProcessed"
                 location="file://grafcet/production_line.gcf#ProcessToProcessed"
                 from="/0/@elements.1"
                 to="/0/@elements.4"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c3"
                 name="LoadedToProcess"
                 location="file://grafcet/production_line.gcf#LoadedToProcess"
                 from="/0/@elements.3"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 name="ProcessedToUnload"
                 location="file://grafcet/production_line.gcf#ProcessedToUnload"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>
  </Grafcet:Grafcet>

</xmi:XMI>