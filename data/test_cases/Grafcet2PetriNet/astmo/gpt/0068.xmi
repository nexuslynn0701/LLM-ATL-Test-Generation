<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ComplexMachineGrafcet" location="file://model/grafcet_complex_0068.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStep" location="file://model/grafcet_complex_0068.gcf#Init" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="LoadMaterial" location="file://model/grafcet_complex_0068.gcf#LoadMaterial" isInitial="false" isActive="false" action="load_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="ProcessMaterial" location="file://model/grafcet_complex_0068.gcf#ProcessMaterial" isInitial="false" isActive="false" action="process_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="UnloadMaterial" location="file://model/grafcet_complex_0068.gcf#UnloadMaterial" isInitial="false" isActive="false" action="unload_material"/>
