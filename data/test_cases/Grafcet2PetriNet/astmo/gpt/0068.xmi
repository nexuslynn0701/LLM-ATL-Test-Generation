    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" name="C_Process_To_T_ProcessToUnload" location="file://model/grafcet_complex_0068.gcf#C_Process_To_T_ProcessToUnload" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.3" name="C_Unload_To_T_UnloadToInit" location="file://model/grafcet_complex_0068.gcf#C_Unload_To_T_UnloadToInit" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.4" name="C_Process_To_T_ProcessToError" location="file://model/grafcet_complex_0068.gcf#C_Process_To_T_ProcessToError" from="/0/@elements.2" to="/0/@elements.9"/>
