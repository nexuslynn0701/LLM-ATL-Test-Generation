    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.9" name="T_ProcessToError" location="file://model/grafcet_complex_0068.gcf#T_ProcessToError" condition="error_detected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.10" name="T_ErrorToInit" location="file://model/grafcet_complex_0068.gcf#T_ErrorToInit" condition="error_resolved"/>

