    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="T_InitToLoad" location="file://model/grafcet_complex_0068.gcf#T_InitToLoad" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="T_LoadToProcess" location="file://model/grafcet_complex_0068.gcf#T_LoadToProcess" condition="material_loaded"/>
