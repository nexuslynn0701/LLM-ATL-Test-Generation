<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet0038" location="file:///model0038.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              name="InitStepA"
              location="file:///model0038.grafcet#s0"
              isInitial="true"
              isActive="true"
              action="initialize system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="ProcessingStepB"
              location="file:///model0038.grafcet#s1"
              isInitial="false"
              isActive="false"
              action="process data"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="FinalStepC"
              location="file:///model0038.grafcet#s2"
              isInitial="false"
              isActive="false"
              action="shutdown system"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              name="TransitionAB"
              location="file:///model0038.grafcet#t0"
              condition="data_ready"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="TransitionBC"
              location="file:///model0038.grafcet#t1"
              condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="TransitionLoopCtoB"
              location="file:///model0038.grafcet#t2"
              condition="retry_required"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="Arc_Init_to_AB"
                 location="file:///model0038.grafcet#c0"
                 from="/0/@elements.0"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="Arc_Proc_to_BC"
                 location="file:///model0038.grafcet#c1"
                 from="/0/@elements.1"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="Arc_Final_to_Loop"
                 location="file:///model0038.grafcet#c2"
                 from="/0/@elements.2"
                 to="/0/@elements.5"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c3"
                 name="Arc_AB_to_Proc"
                 location="file:///model0038.grafcet#c3"
                 from="/0/@elements.3"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 name="Arc_BC_to_Final"
                 location="file:///model0038.grafcet#c4"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 name="Arc_Loop_to_Proc"
                 location="file:///model0038.grafcet#c5"
                 from="/0/@elements.5"
                 to="/0/@elements.1"/>
  </Grafcet:Grafcet>

</xmi:XMI>