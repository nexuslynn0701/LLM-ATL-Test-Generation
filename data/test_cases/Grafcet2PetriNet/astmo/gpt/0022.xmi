<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_grafcet0022" name="ProductionLineGrafcet" location="factory:lineA">
    <elements xsi:type="Grafcet:Step" xmi:id="_step_start" name="StartStep" location="factory:lineA:start" isInitial="true" isActive="true" action="initialize_conveyor"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_load" name="LoadStep" location="factory:lineA:load" isInitial="false" isActive="false" action="load_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_process" name="ProcessStep" location="factory:lineA:process" isInitial="false" isActive="false" action="run_machine"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_unload" name="UnloadStep" location="factory:lineA:unload" isInitial="false" isActive="false" action="unload_product"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_t1" name="T1" location="factory:lineA:t1" condition="conveyor_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_t2" name="T2" location="factory:lineA:t2" condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_t3" name="T3" location="factory:lineA:t3" condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_t4" name="T4" location="factory:lineA:t4" condition="unloading_done"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn_s_start_t1" name="Arc_Start_T1" location="factory:lineA:arc_start_t1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn_t1_s_load" name="Arc_T1_Load" location="factory:lineA:arc_t1_load" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn_s_load_t2" name="Arc_Load_T2" location="factory:lineA:arc_load_t2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn_t2_s_process" name="Arc_T2_Process" location="factory:lineA:arc_t2_process" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn_s_process_t3" name="Arc_Process_T3" location="factory:lineA:arc_process_t3" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn_t3_s_unload" name="Arc_T3_Unload" location="factory:lineA:arc_t3_unload" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn_s_unload_t4" name="Arc_Unload_T4" location="factory:lineA:arc_unload_t4" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn_t4_s_start" name="Arc_T4_Start" location="factory:lineA:arc_t4_start" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>