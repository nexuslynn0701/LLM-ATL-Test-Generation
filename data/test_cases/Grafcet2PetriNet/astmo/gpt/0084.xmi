                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.8"
                 name="Merge_to_Final"
                 location="file:///models/grafcet/complex_0084.gcf#Merge_to_Final"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>