<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet0084" location="file:///models/grafcet/complex_0084.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStep" location="file:///models/grafcet/complex_0084.gcf#InitStep" isInitial="true" isActive="true" action="InitializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="ProcessingStepA" location="file:///models/grafcet/complex_0084.gcf#ProcessingStepA" isInitial="false" isActive="false" action="ProcessDataA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="ProcessingStepB" location="file:///models/grafcet/complex_0084.gcf#ProcessingStepB" isInitial="false" isActive="false" action="ProcessDataB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="FinalStep" location="file:///models/grafcet/complex_0084.gcf#FinalStep" isInitial="false" isActive="false" action="ShutdownSystem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="StartProcessing" location="file:///models/grafcet/complex_0084.gcf#StartProcessing" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="BranchToA" location="file:///models/grafcet/complex_0084.gcf#BranchToA" condition="modeA"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="BranchToB" location="file:///models/grafcet/complex_0084.gcf#BranchToB" condition="modeB"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.7" name="MergeToFinal" location="file:///models/grafcet/complex_0084.gcf#MergeToFinal" condition="processingDone"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.0"
                 name="Init_to_Start"
                 location="file:///models/grafcet/complex_0084.gcf#Init_to_Start"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.1"
                 name="Init_to_BranchA"
                 location="file:///models/grafcet/complex_0084.gcf#Init_to_BranchA"
                 from="/0/@elements.0"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.2"
                 name="Init_to_BranchB"
                 location="file:///models/grafcet/complex_0084.gcf#Init_to_BranchB"
                 from="/0/@elements.0"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.3"
                 name="StepA_to_Merge"
                 location="file:///models/grafcet/complex_0084.gcf#StepA_to_Merge"
                 from="/0/@elements.1"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.4"
                 name="StepB_to_Merge"
                 location="file:///models/grafcet/complex_0084.gcf#StepB_to_Merge"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.5"
                 name="Start_to_StepA"
                 location="file:///models/grafcet/complex_0084.gcf#Start_to_StepA"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.6"
                 name="BranchA_to_StepA"
                 location="file:///models/grafcet/complex_0084.gcf#BranchA_to_StepA"
                 from="/0/@elements.5"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.7"
                 name="BranchB_to_StepB"
                 location="file:///models/grafcet/complex_0084.gcf#BranchB_to_StepB"
