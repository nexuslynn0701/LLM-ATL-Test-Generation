<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="FactoryLineControl" location="model.grafcet#0">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0"
              name="InitBuffer" location="model.grafcet#step0"
              isInitial="true" isActive="true" action="reset_buffer"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1"
              name="CheckSensor" location="model.grafcet#step1"
              isInitial="false" isActive="false" action="read_sensor"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2"
              name="MoveConveyor" location="model.grafcet#step2"
              isInitial="false" isActive="false" action="move_conveyor"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3"
              name="StopConveyor" location="model.grafcet#step3"
              isInitial="false" isActive="false" action="stop_conveyor"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.4"
              name="Alarm" location="model.grafcet#step4"
              isInitial="false" isActive="false" action="raise_alarm"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5"
              name="T_InitToCheck" location="model.grafcet#trans0"
              condition="buffer_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6"
              name="T_CheckToMove" location="model.grafcet#trans1"
              condition="sensor_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.7"
              name="T_MoveToStop" location="model.grafcet#trans2"
              condition="position_reached"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.8"
              name="T_CheckToAlarm" location="model.grafcet#trans3"
              condition="sensor_error"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0"
                 name="C_InitToCheck" location="model.grafcet#conn0"
                 from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.1"
                 name="C_CheckToMove" location="model.grafcet#conn1"
                 from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2"
                 name="C_MoveToStop" location="model.grafcet#conn2"
                 from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.3"
                 name="C_CheckToAlarm" location="model.grafcet#conn3"
                 from="/0/@elements.1" to="/0/@elements.8"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.4"
                 name="C_T_InitToCheck_To_Check" location="model.grafcet#conn4"
                 from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5"
                 name="C_T_CheckToMove_To_Move" location="model.grafcet#conn5"
                 from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.6"
                 name="C_T_MoveToStop_To_Stop" location="model.grafcet#conn6"
                 from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.7"
                 name="C_T_CheckToAlarm_To_Alarm" location="model.grafcet#conn7"
                 from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>

</xmi:XMI>