<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ProductionLine" location="factory.floor.sectionB">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0"
              name="LoadStation"
              location="factory.floor.sectionB.load"
              isInitial="true"
              isActive="true"
              action="load_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1"
              name="ProcessStation"
              location="factory.floor.sectionB.process"
              isInitial="false"
              isActive="false"
              action="process_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2"
              name="UnloadStation"
              location="factory.floor.sectionB.unload"
              isInitial="false"
              isActive="false"
              action="unload_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3"
              name="InspectionStation"
              location="factory.floor.sectionB.inspect"
              isInitial="false"
              isActive="false"
              action="inspect_material"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4"
              name="LoadedToProcessing"
              location="factory.floor.sectionB.t1"
              condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5"
              name="ProcessingToUnloading"
              location="factory.floor.sectionB.t2"
              condition="processing_complete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6"
              name="UnloadingToInspection"
              location="factory.floor.sectionB.t3"
              condition="unloading_complete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.7"
              name="InspectionToLoad"
              location="factory.floor.sectionB.t4"
              condition="inspection_complete"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0"
                 name="Load_to_Proc"
                 location="factory.floor.sectionB.c1"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.1"
                 name="Proc_to_Unload"
                 location="factory.floor.sectionB.c2"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2"
                 name="Unload_to_Inspect"
                 location="factory.floor.sectionB.c3"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.3"
                 name="Inspect_to_Load_T"
                 location="factory.floor.sectionB.c4"
                 from="/0/@elements.3"
                 to="/0/@elements.7"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.4"
                 name="LoadedToProcessing_to_ProcStep"
                 location="factory.floor.sectionB.c5"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5"
                 name="ProcessingToUnloading_to_UnloadStep"
                 location="factory.floor.sectionB.c6"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.6"
                 name="UnloadingToInspection_to_InspectStep"
                 location="factory.floor.sectionB.c7"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.7"
                 name="InspectionToLoad_to_LoadStep"
                 location="factory.floor.sectionB.c8"
                 from="/0/@elements.7"
                 to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>