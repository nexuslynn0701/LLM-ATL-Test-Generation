<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g000" name="ComplexProcess" location="PlantA.Line3">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="Startup" location="PlantA.Line3" isInitial="true" isActive="true" action="init_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="LoadMaterials" location="PlantA.Line3" isInitial="false" isActive="false" action="load_materials"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="Assembly" location="PlantA.Line3" isInitial="false" isActive="false" action="perform_assembly"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="QualityCheck" location="PlantA.Line3" isInitial="false" isActive="false" action="quality_inspection"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_StartupToLoad" location="PlantA.Line3" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_LoadToAssembly" location="PlantA.Line3" condition="materials_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_AssemblyToQuality" location="PlantA.Line3" condition="assembly_complete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_QualityToStartup" location="PlantA.Line3" condition="rework_required"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="Arc_Startup_Load" location="PlantA.Line3" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="Arc_Load_Assembly" location="PlantA.Line3" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="Arc_LoadToAssembly" location="PlantA.Line3" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="Arc_Assembly_Quality" location="PlantA.Line3" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="Arc_AssemblyToQuality" location="PlantA.Line3" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="Arc_Quality_Startup" location="PlantA.Line3" from="/0/@elements.7" to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="Arc_QualityToStartup" location="PlantA.Line3" from="/0/@elements.3" to="/0/@elements.7"/>
  </Grafcet:Grafcet>
</xmi:XMI>