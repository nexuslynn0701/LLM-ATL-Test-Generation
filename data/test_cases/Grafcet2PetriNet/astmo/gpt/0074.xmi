<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ProductionLine" location="file://model/productionLine.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              name="InitBuffer"
              location="file://model/productionLine.gcf#InitBuffer"
              isInitial="true"
              isActive="true"
              action="initialize buffer"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="LoadMaterial"
              location="file://model/productionLine.gcf#LoadMaterial"
              isInitial="false"
              isActive="false"
              action="load material"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="ProcessMaterial"
              location="file://model/productionLine.gcf#ProcessMaterial"
              isInitial="false"
              isActive="false"
              action="process material"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              name="UnloadMaterial"
              location="file://model/productionLine.gcf#UnloadMaterial"
              isInitial="false"
              isActive="false"
              action="unload material"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              name="T_InitToLoad"
              location="file://model/productionLine.gcf#T_InitToLoad"
              condition="buffer ready"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="T_LoadToProcess"
              location="file://model/productionLine.gcf#T_LoadToProcess"
              condition="material loaded"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="T_ProcessToUnload"
              location="file://model/productionLine.gcf#T_ProcessToUnload"
              condition="processing done"/>

    <!-- StepToTransition connections (PlaceToTransition arcs in target) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="C_InitBuffer_to_T_InitToLoad"
                 location="file://model/productionLine.gcf#C_InitBuffer_to_T_InitToLoad"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="C_LoadMaterial_to_T_LoadToProcess"
                 location="file://model/productionLine.gcf#C_LoadMaterial_to_T_LoadToProcess"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="C_ProcessMaterial_to_T_ProcessToUnload"
                 location="file://model/productionLine.gcf#C_ProcessMaterial_to_T_ProcessToUnload"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>

    <!-- TransitionToStep connections (TransitionToPlace arcs in target) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c3"
                 name="C_T_InitToLoad_to_LoadMaterial"
                 location="file://model/productionLine.gcf#C_T_InitToLoad_to_LoadMaterial"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 name="C_T_LoadToProcess_to_ProcessMaterial"
                 location="file://model/productionLine.gcf#C_T_LoadToProcess_to_ProcessMaterial"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 name="C_T_ProcessToUnload_to_UnloadMaterial"
                 location="file://model/productionLine.gcf#C_T_ProcessToUnload_to_UnloadMaterial"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>