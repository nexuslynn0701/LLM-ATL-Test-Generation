<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="MainGrafcet" location="file://model/MainGrafcet.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0"
              name="InitStep" location="file://model/MainGrafcet.gcf#InitStep"
              isInitial="true" isActive="true" action="initialize system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1"
              name="ProcessingStepA" location="file://model/MainGrafcet.gcf#ProcessingStepA"
              isInitial="false" isActive="false" action="process A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2"
              name="ProcessingStepB" location="file://model/MainGrafcet.gcf#ProcessingStepB"
              isInitial="false" isActive="false" action="process B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3"
              name="FinalStep" location="file://model/MainGrafcet.gcf#FinalStep"
              isInitial="false" isActive="false" action="finalize"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4"
              name="T_Init_to_A" location="file://model/MainGrafcet.gcf#T_Init_to_A"
              condition="startCondition"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5"
              name="T_A_to_B" location="file://model/MainGrafcet.gcf#T_A_to_B"
              condition="aCompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6"
              name="T_B_to_Final" location="file://model/MainGrafcet.gcf#T_B_to_Final"
              condition="bCompleted"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0"
                 name="Arc_Init_to_TInitA"
                 location="file://model/MainGrafcet.gcf#Arc_Init_to_TInitA"
                 from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.1"
                 name="Arc_A_to_TATB"
                 location="file://model/MainGrafcet.gcf#Arc_A_to_TATB"
                 from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2"
                 name="Arc_B_to_TBFinal"
                 location="file://model/MainGrafcet.gcf#Arc_B_to_TBFinal"
                 from="/0/@elements.2" to="/0/@elements.6"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3"
                 name="Arc_TInitA_to_A"
                 location="file://model/MainGrafcet.gcf#Arc_TInitA_to_A"
                 from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.4"
                 name="Arc_TATB_to_B"
                 location="file://model/MainGrafcet.gcf#Arc_TATB_to_B"
                 from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5"
                 name="Arc_TBFinal_to_Final"
                 location="file://model/MainGrafcet.gcf#Arc_TBFinal_to_Final"
                 from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>

</xmi:XMI>