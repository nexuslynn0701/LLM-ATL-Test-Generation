<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet0045" location="file://model0045.grafcet">
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="file://model0045.grafcet#S0" isInitial="true" isActive="true" action="initialize system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="ProcessStep" location="file://model0045.grafcet#S1" isInitial="false" isActive="false" action="process data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="FinalStep" location="file://model0045.grafcet#S2" isInitial="false" isActive="false" action="shutdown"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_InitToProcess" location="file://model0045.grafcet#T0" condition="start button pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_ProcessLoop" location="file://model0045.grafcet#T1" condition="more data available"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_ProcessToFinal" location="file://model0045.grafcet#T2" condition="no more data"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_Init_to_T0" location="file://model0045.grafcet#C0" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="C_T0_to_Process" location="file://model0045.grafcet#C1" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="C_Process_to_T1" location="file://model0045.grafcet#C2" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C3" name="C_T1_to_Process" location="file://model0045.grafcet#C3" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_Process_to_T2" location="file://model0045.grafcet#C4" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="C_T2_to_Final" location="file://model0045.grafcet#C5" from="/0/@elements.5" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>