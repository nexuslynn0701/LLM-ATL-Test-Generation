<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ManufacturingCellGrafcet" location="file:/models/grafcet_0035.gcf">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="LoadPart" location="file:/models/grafcet_0035.gcf#LoadPart" isInitial="true" isActive="true" action="robot.grab()"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.1" name="PartLoaded" location="file:/models/grafcet_0035.gcf#PartLoaded" condition="sensor.partPresent"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="MoveToPress" location="file:/models/grafcet_0035.gcf#MoveToPress" isInitial="false" isActive="false" action="robot.moveToPress()"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.3" name="AtPressPosition" location="file:/models/grafcet_0035.gcf#AtPressPosition" condition="sensor.atPress"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.4" name="PressPart" location="file:/models/grafcet_0035.gcf#PressPart" isInitial="false" isActive="false" action="press.down()"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="PressCompleted" location="file:/models/grafcet_0035.gcf#PressCompleted" condition="sensor.pressDone"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.6" name="UnloadPart" location="file:/models/grafcet_0035.gcf#UnloadPart" isInitial="false" isActive="false" action="robot.unload()"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.7" name="CycleFinished" location="file:/models/grafcet_0035.gcf#CycleFinished" condition="sensor.cycleDone"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="c_Load_to_loaded" location="file:/models/grafcet_0035.gcf#c_Load_to_loaded" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.1" name="c_loaded_to_move" location="file:/models/grafcet_0035.gcf#c_loaded_to_move" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" name="c_move_to_atPress" location="file:/models/grafcet_0035.gcf#c_move_to_atPress" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" name="c_atPress_to_press" location="file:/models/grafcet_0035.gcf#c_atPress_to_press" from="/0/@elements.3" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.4" name="c_press_to_completed" location="file:/models/grafcet_0035.gcf#c_press_to_completed" from="/0/@elements.4" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5" name="c_completed_to_unload" location="file:/models/grafcet_0035.gcf#c_completed_to_unload" from="/0/@elements.5" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.6" name="c_unload_to_cycleFinished" location="file:/models/grafcet_0035.gcf#c_unload_to_cycleFinished" from="/0/@elements.6" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.7" name="c_cycleFinished_to_load" location="file:/models/grafcet_0035.gcf#c_cycleFinished_to_load" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>