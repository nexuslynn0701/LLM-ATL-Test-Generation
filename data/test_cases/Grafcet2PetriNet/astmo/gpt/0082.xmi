<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="g1" name="FactoryLine" location="file://model0082.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="s1" name="Start" location="file://model0082.grafcet#Start" isInitial="true" isActive="true" action="initialize system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s2" name="LoadMaterial" location="file://model0082.grafcet#LoadMaterial" isInitial="false" isActive="false" action="load material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s3" name="ProcessMaterial" location="file://model0082.grafcet#ProcessMaterial" isInitial="false" isActive="false" action="process material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s4" name="UnloadMaterial" location="file://model0082.grafcet#UnloadMaterial" isInitial="false" isActive="false" action="unload material"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="t1" name="T_StartToLoad" location="file://model0082.grafcet#T_StartToLoad" condition="system ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t2" name="T_LoadToProcess" location="file://model0082.grafcet#T_LoadToProcess" condition="material loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t3" name="T_ProcessToUnload" location="file://model0082.grafcet#T_ProcessToUnload" condition="process finished"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c1" name="C_Start_Load" location="file://model0082.grafcet#C_Start_Load"
        from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c2" name="C_Load_Process" location="file://model0082.grafcet#C_Load_Process"
        from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c3" name="C_Process_Unload" location="file://model0082.grafcet#C_Process_Unload"
        from="/0/@elements.2" to="/0/@elements.6"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c4" name="C_Start_Load_Back" location="file://model0082.grafcet#C_Start_Load_Back"
        from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c5" name="C_Load_Process_Back" location="file://model0082.grafcet#C_Load_Process_Back"
        from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c6" name="C_Process_Unload_Back" location="file://model0082.grafcet#C_Process_Unload_Back"
        from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>

</xmi:XMI>