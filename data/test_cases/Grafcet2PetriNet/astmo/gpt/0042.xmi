<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ProductionLineGrafcet" location="file://model/productionLine.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              name="InitStep"
              location="file://model/productionLine.grafcet#InitStep"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="LoadMaterial"
              location="file://model/productionLine.grafcet#LoadMaterial"
              isInitial="false"
              isActive="false"
              action="load_material"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="ProcessMaterial"
              location="file://model/productionLine.grafcet#ProcessMaterial"
              isInitial="false"
              isActive="false"
              action="process_material"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              name="UnloadMaterial"
              location="file://model/productionLine.grafcet#UnloadMaterial"
              isInitial="false"
              isActive="false"
              action="unload_material"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              name="T_Init_to_Load"
              location="file://model/productionLine.grafcet#T_Init_to_Load"
              condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="T_Load_to_Process"
              location="file://model/productionLine.grafcet#T_Load_to_Process"
              condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="T_Process_to_Unload"
              location="file://model/productionLine.grafcet#T_Process_to_Unload"
              condition="processing_done"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="C_Init_to_T0"
                 location="file://model/productionLine.grafcet#C_Init_to_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="C_Load_to_T1"
                 location="file://model/productionLine.grafcet#C_Load_to_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="C_Process_to_T2"
                 location="file://model/productionLine.grafcet#C_Process_to_T2"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c3"
                 name="C_T0_to_Load"
                 location="file://model/productionLine.grafcet#C_T0_to_Load"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 name="C_T1_to_Process"
                 location="file://model/productionLine.grafcet#C_T1_to_Process"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 name="C_T2_to_Unload"
                 location="file://model/productionLine.grafcet#C_T2_to_Unload"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>

</xmi:XMI>