<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g1" name="ProductionLine" location="factoryFloor">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="LoadMaterials"
              location="zoneA"
              isInitial="true"
              isActive="true"
              action="startConveyor"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="AssembleParts"
              location="zoneB"
              isInitial="false"
              isActive="false"
              action="robotArm"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              name="QualityCheck"
              location="zoneC"
              isInitial="false"
              isActive="false"
              action="inspectionCamera"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="AfterLoading"
              location="zoneA"
              condition="materialsLoaded"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="AfterAssembly"
              location="zoneB"
              condition="assemblyComplete"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t3"
              name="AfterInspection"
              location="zoneC"
              condition="inspectionPassed"/>

    <!-- StepToTransition connections (PlaceToTransition arcs in target) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="c_Load_to_AfterLoading"
                 location="conn_zoneA"
                 from="/0/@elements.0"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="c_Assemble_to_AfterAssembly"
                 location="conn_zoneB"
                 from="/0/@elements.1"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 name="c_Quality_to_AfterInspection"
                 location="conn_zoneC"
                 from="/0/@elements.2"
                 to="/0/@elements.5"/>

    <!-- TransitionToStep connections (TransitionToPlace arcs in target) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 name="c_AfterLoading_to_Assemble"
                 location="conn_zoneAB"
                 from="/0/@elements.3"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 name="c_AfterAssembly_to_Quality"
                 location="conn_zoneBC"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 name="c_AfterInspection_to_Load"
                 location="conn_zoneCA"
                 from="/0/@elements.5"
                 to="/0/@elements.0"/>
  </Grafcet:Grafcet>

</xmi:XMI>