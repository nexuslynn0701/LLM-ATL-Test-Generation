<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ProductionLineGrafcet" location="plant:lineA">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitLine" location="plant:lineA:init" isInitial="true" isActive="true" action="reset_counters"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="LoadMaterial" location="plant:lineA:load" isInitial="false" isActive="false" action="move_conveyor"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessMaterial" location="plant:lineA:process" isInitial="false" isActive="false" action="start_machine"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="UnloadMaterial" location="plant:lineA:unload" isInitial="false" isActive="false" action="stop_conveyor"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="InitToLoad" location="plant:lineA:t0" condition="line_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="LoadToProcess" location="plant:lineA:t1" condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="ProcessToUnload" location="plant:lineA:t2" condition="process_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="UnloadToInit" location="plant:lineA:t3" condition="buffer_empty"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="Arc_Init_Load" location="plant:lineA:c0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="Arc_Load_Process" location="plant:lineA:c1" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="Arc_Load_Process_T" location="plant:lineA:c2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="Arc_Process_Step" location="plant:lineA:c3" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="Arc_Process_Unload_T" location="plant:lineA:c4" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="Arc_Unload_Step" location="plant:lineA:c5" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="Arc_Unload_Init_T" location="plant:lineA:c6" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="Arc_Init_Step" location="plant:lineA:c7" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>