<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet0007" location="loc_grafcet_0007">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.0"
              name="InitStepA"
              location="loc_step_A"
              isInitial="true"
              isActive="true"
              action="initialize_A"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.1"
              name="InitStepB"
              location="loc_step_B"
              isInitial="true"
              isActive="false"
              action="initialize_B"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.2"
              name="MiddleStepC"
              location="loc_step_C"
              isInitial="false"
              isActive="false"
              action="process_C"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.3"
              name="FinalStepD"
              location="loc_step_D"
              isInitial="false"
              isActive="true"
              action="finalize_D"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.4"
              name="Trans1"
              location="loc_trans_1"
              condition="cond_1"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.5"
              name="Trans2"
              location="loc_trans_2"
              condition="cond_2"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.6"
              name="Trans3"
              location="loc_trans_3"
              condition="cond_3"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.0"
                 name="Arc_ST_A_T1"
                 location="loc_conn_A_T1"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.1"
                 name="Arc_ST_B_T1"
                 location="loc_conn_B_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.2"
                 name="Arc_ST_C_T2"
                 location="loc_conn_C_T2"
                 from="/0/@elements.2"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.3"
                 name="Arc_ST_D_T3"
                 location="loc_conn_D_T3"
                 from="/0/@elements.3"
                 to="/0/@elements.6"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.4"
                 name="Arc_TS_T1_C"
                 location="loc_conn_T1_C"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.5"
                 name="Arc_TS_T2_D"
                 location="loc_conn_T2_D"
                 from="/0/@elements.5"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.6"
                 name="Arc_TS_T3_B"
                 location="loc_conn_T3_B"
                 from="/0/@elements.6"
                 to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>