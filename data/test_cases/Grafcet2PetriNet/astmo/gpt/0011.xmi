<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g1" name="G_Main" location="file://model/grafcet_main.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="S_Init" location="file://model/grafcet_main.gcf#S_Init" isInitial="true" isActive="true" action="Initialize system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="S_Load" location="file://model/grafcet_main.gcf#S_Load" isInitial="false" isActive="false" action="Load data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="S_Process" location="file://model/grafcet_main.gcf#S_Process" isInitial="false" isActive="false" action="Process data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="S_Finalize" location="file://model/grafcet_main.gcf#S_Finalize" isInitial="false" isActive="false" action="Finalize and cleanup"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Start" location="file://model/grafcet_main.gcf#T_Start" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_ToProcess" location="file://model/grafcet_main.gcf#T_ToProcess" condition="dataLoaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_ToFinalize" location="file://model/grafcet_main.gcf#T_ToFinalize" condition="processingCompleted"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_S1_T1" location="file://model/grafcet_main.gcf#C_S1_T1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_S2_T2" location="file://model/grafcet_main.gcf#C_S2_T2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_S3_T3" location="file://model/grafcet_main.gcf#C_S3_T3" from="/0/@elements.2" to="/0/@elements.6"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="C_T1_S2" location="file://model/grafcet_main.gcf#C_T1_S2" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_T2_S3" location="file://model/grafcet_main.gcf#C_T2_S3" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="C_T3_S4" location="file://model/grafcet_main.gcf#C_T3_S4" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>

</xmi:XMI>