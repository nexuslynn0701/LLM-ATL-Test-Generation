<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ProductionLineGrafcet" location="file://model/grafcet_0046">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              name="InitStep"
              location="file://model/grafcet_0046#InitStep"
              isInitial="true"
              isActive="true"
              action="initialize_conveyor"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="LoadStep"
              location="file://model/grafcet_0046#LoadStep"
              isInitial="false"
              isActive="false"
              action="load_item"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="ProcessStep"
              location="file://model/grafcet_0046#ProcessStep"
              isInitial="false"
              isActive="false"
              action="process_item"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              name="InitToLoad"
              location="file://model/grafcet_0046#InitToLoad"
              condition="sensor_ready"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="LoadToProcess"
              location="file://model/grafcet_0046#LoadToProcess"
              condition="item_loaded"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="Arc_Init_to_InitToLoad"
                 location="file://model/grafcet_0046#Arc_Init_to_InitToLoad"
                 from="/0/@elements.0"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="Arc_Load_to_LoadToProcess"
                 location="file://model/grafcet_0046#Arc_Load_to_LoadToProcess"
                 from="/0/@elements.1"
                 to="/0/@elements.4"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c2"
                 name="Arc_InitToLoad_to_Load"
                 location="file://model/grafcet_0046#Arc_InitToLoad_to_Load"
                 from="/0/@elements.3"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c3"
                 name="Arc_LoadToProcess_to_Process"
                 location="file://model/grafcet_0046#Arc_LoadToProcess_to_Process"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>
  </Grafcet:Grafcet>

</xmi:XMI>