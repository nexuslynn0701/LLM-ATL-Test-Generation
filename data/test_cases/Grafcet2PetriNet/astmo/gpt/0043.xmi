<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g1" name="ComplexGrafcet0043" location="file://model0043.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="InitStep_A" location="file://model0043.grafcet#s1" isInitial="true" isActive="true" action="initialize system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessingStep_B" location="file://model0043.grafcet#s2" isInitial="false" isActive="false" action="process data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="FinalStep_C" location="file://model0043.grafcet#s3" isInitial="false" isActive="false" action="shutdown"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_StartToProcess" location="file://model0043.grafcet#t1" condition="startProcessing"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_ProcessToFinal" location="file://model0043.grafcet#t2" condition="processingComplete"/>

    <!-- Connections: StepToTransition -->
    <!-- Two different steps leading to the same transition t1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="Arc_S1_T1" location="file://model0043.grafcet#c1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="Arc_S2_T1" location="file://model0043.grafcet#c2" from="/0/@elements.1" to="/0/@elements.3"/>

    <!-- One step leading to transition t2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="Arc_S2_T2" location="file://model0043.grafcet#c3" from="/0/@elements.1" to="/0/@elements.4"/>

    <!-- Connections: TransitionToStep -->
    <!-- Transition t1 can activate both s2 and s3 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="Arc_T1_S2" location="file://model0043.grafcet#c4" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="Arc_T1_S3" location="file://model0043.grafcet#c5" from="/0/@elements.3" to="/0/@elements.2"/>

    <!-- Transition t2 leads to final step s3 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="Arc_T2_S3" location="file://model0043.grafcet#c6" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>

</xmi:XMI>