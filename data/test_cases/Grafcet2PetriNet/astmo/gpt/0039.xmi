<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ProductionLineGrafcet" location="factory_floor">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStep" location="factory_floor" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="LoadMaterial" location="factory_floor" isInitial="false" isActive="false" action="load_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="ProcessMaterial" location="factory_floor" isInitial="false" isActive="false" action="process_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="UnloadMaterial" location="factory_floor" isInitial="false" isActive="false" action="unload_material"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="T_Init_to_Load" location="factory_floor" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="T_Load_to_Process" location="factory_floor" condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="T_Process_to_Unload" location="factory_floor" condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.7" name="T_Unload_to_Init" location="factory_floor" condition="unloading_done"/>

    <!-- StepToTransition connections (PlaceToTransition arcs in target) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.0"
                 name="C_Init_to_T1"
                 location="factory_floor"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.1"
                 name="C_Load_to_T2"
                 location="factory_floor"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.2"
                 name="C_Process_to_T3"
                 location="factory_floor"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.3"
                 name="C_Unload_to_T4"
                 location="factory_floor"
                 from="/0/@elements.3"
                 to="/0/@elements.7"/>

    <!-- TransitionToStep connections (TransitionToPlace arcs in target) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.4"
                 name="C_T1_to_Load"
                 location="factory_floor"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.5"
                 name="C_T2_to_Process"
                 location="factory_floor"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.6"
                 name="C_T3_to_Unload"
                 location="factory_floor"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.7"
                 name="C_T4_to_Init"
                 location="factory_floor"
                 from="/0/@elements.7"
                 to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>