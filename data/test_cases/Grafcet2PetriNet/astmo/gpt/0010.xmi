<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet0010" location="model/location/0010">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStepA" location="model/location/0010#InitA" isInitial="true" isActive="true" action="startA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="MiddleStepB" location="model/location/0010#MiddleB" isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="FinalStepC" location="model/location/0010#FinalC" isInitial="false" isActive="false" action="finishC"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="InitStepD" location="model/location/0010#InitD" isInitial="true" isActive="false" action="startD"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="TransAB" location="model/location/0010#TransAB" condition="condAB"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="TransBC" location="model/location/0010#TransBC" condition="condBC"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="TransAD" location="model/location/0010#TransAD" condition="condAD"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.7" name="TransDC" location="model/location/0010#TransDC" condition="condDC"/>

    <!-- Connections Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition"
        xmi:id="/0/@connections.0"
        name="Conn_InitA_TransAB"
        location="model/location/0010#ConnA_AB"
        from="/0/@elements.0"
        to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
        xmi:id="/0/@connections.1"
        name="Conn_MiddleB_TransBC"
        location="model/location/0010#ConnB_BC"
        from="/0/@elements.1"
        to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
        xmi:id="/0/@connections.2"
        name="Conn_InitD_TransDC"
        location="model/location/0010#ConnD_DC"
        from="/0/@elements.3"
        to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition"
        xmi:id="/0/@connections.3"
        name="Conn_InitA_TransAD"
        location="model/location/0010#ConnA_AD"
        from="/0/@elements.0"
        to="/0/@elements.6"/>

    <!-- Connections Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep"
        xmi:id="/0/@connections.4"
        name="Conn_TransAB_MiddleB"
        location="model/location/0010#ConnAB_B"
        from="/0/@elements.4"
        to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
        xmi:id="/0/@connections.5"
        name="Conn_TransBC_FinalC"
        location="model/location/0010#ConnBC_C"
        from="/0/@elements.5"
        to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
        xmi:id="/0/@connections.6"
        name="Conn_TransAD_InitD"
        location="model/location/0010#ConnAD_D"
        from="/0/@elements.6"
        to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
        xmi:id="/0/@connections.7"
        name="Conn_TransDC_FinalC"
        location="model/location/0010#ConnDC_C"
        from="/0/@elements.7"
        to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>