<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet_0064" location="file://model/complexGrafcet_0064.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.0"
              name="InitStep"
              location="file://model/complexGrafcet_0064.gcf#InitStep"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.1"
              name="ProcessingStepA"
              location="file://model/complexGrafcet_0064.gcf#ProcessingStepA"
              isInitial="false"
              isActive="false"
              action="process_A"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.2"
              name="ProcessingStepB"
              location="file://model/complexGrafcet_0064.gcf#ProcessingStepB"
              isInitial="false"
              isActive="false"
              action="process_B"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="/0/@elements.3"
              name="FinalStep"
              location="file://model/complexGrafcet_0064.gcf#FinalStep"
              isInitial="false"
              isActive="false"
              action="finalize_system"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.4"
              name="T_Init_to_A"
              location="file://model/complexGrafcet_0064.gcf#T_Init_to_A"
              condition="init_complete"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.5"
              name="T_A_to_B"
              location="file://model/complexGrafcet_0064.gcf#T_A_to_B"
              condition="A_done"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="/0/@elements.6"
              name="T_B_to_Final"
              location="file://model/complexGrafcet_0064.gcf#T_B_to_Final"
              condition="B_done"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.0"
                 name="C_Init_to_T_Init_to_A"
                 location="file://model/complexGrafcet_0064.gcf#C_Init_to_T_Init_to_A"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.1"
                 name="C_A_to_T_A_to_B"
                 location="file://model/complexGrafcet_0064.gcf#C_A_to_T_A_to_B"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="/0/@connections.2"
                 name="C_B_to_T_B_to_Final"
                 location="file://model/complexGrafcet_0064.gcf#C_B_to_T_B_to_Final"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.3"
                 name="C_T_Init_to_A_to_A"
                 location="file://model/complexGrafcet_0064.gcf#C_T_Init_to_A_to_A"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.4"
                 name="C_T_A_to_B_to_B"
                 location="file://model/complexGrafcet_0064.gcf#C_T_A_to_B_to_B"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="/0/@connections.5"
                 name="C_T_B_to_Final_to_Final"
                 location="file://model/complexGrafcet_0064.gcf#C_T_B_to_Final_to_Final"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>