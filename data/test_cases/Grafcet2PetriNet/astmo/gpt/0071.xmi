<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_grafcet_0071" name="ComplexManufacturingCell" location="factory/lineA/cell3">
    <elements xsi:type="Grafcet:Step" xmi:id="_step_s1" name="LoadPart" location="factory/lineA/cell3/s1" isInitial="true" isActive="true" action="grab_part"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_s2" name="ClampPart" location="factory/lineA/cell3/s2" isInitial="false" isActive="false" action="clamp"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_s3" name="DrillHole" location="factory/lineA/cell3/s3" isInitial="false" isActive="false" action="drill"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_s4" name="UnloadPart" location="factory/lineA/cell3/s4" isInitial="false" isActive="false" action="release_part"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_t1" name="T_LoadToClamp" location="factory/lineA/cell3/t1" condition="part_detected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_t2" name="T_ClampToDrill" location="factory/lineA/cell3/t2" condition="clamp_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_t3" name="T_DrillToUnload" location="factory/lineA/cell3/t3" condition="hole_complete"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn_c1" name="C_LoadToClamp" location="factory/lineA/cell3/c1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn_c2" name="C_ClampToDrill" location="factory/lineA/cell3/c2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn_c3" name="C_DrillToUnload" location="factory/lineA/cell3/c3" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn_c4" name="C_LoadToClamp_Return" location="factory/lineA/cell3/c4" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn_c5" name="C_ClampToDrill_Return" location="factory/lineA/cell3/c5" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn_c6" name="C_DrillToUnload_Return" location="factory/lineA/cell3/c6" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>