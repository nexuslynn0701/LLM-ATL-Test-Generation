<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0088" name="ProductionLineGrafcet" location="plant://sectionA">
    <elements xsi:type="Grafcet:Step" xmi:id="_g0088_s0" name="IdleStep" location="plant://sectionA/Idle" isInitial="true" isActive="false" action="waitForStartSignal"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_g0088_s1" name="LoadStep" location="plant://sectionA/Load" isInitial="false" isActive="false" action="loadMaterial"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_g0088_s2" name="ProcessStep" location="plant://sectionA/Process" isInitial="false" isActive="false" action="runProcessingUnit"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_g0088_s3" name="UnloadStep" location="plant://sectionA/Unload" isInitial="false" isActive="false" action="unloadFinishedGoods"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_g0088_t0" name="T_Start" location="plant://sectionA/T_Start" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_g0088_t1" name="T_Loaded" location="plant://sectionA/T_Loaded" condition="sensorLoaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_g0088_t2" name="T_Processed" location="plant://sectionA/T_Processed" condition="processingComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_g0088_t3" name="T_Reset" location="plant://sectionA/T_Reset" condition="resetRequested"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_g0088_c0" name="Arc_Idle_to_Start" location="plant://sectionA/C_Idle_Start" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_g0088_c1" name="Arc_Start_to_Load" location="plant://sectionA/C_Start_Load" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_g0088_c2" name="Arc_Load_to_Loaded" location="plant://sectionA/C_Load_Loaded" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_g0088_c3" name="Arc_Loaded_to_Process" location="plant://sectionA/C_Loaded_Process" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_g0088_c4" name="Arc_Process_to_Processed" location="plant://sectionA/C_Process_Processed" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_g0088_c5" name="Arc_Processed_to_Unload" location="plant://sectionA/C_Processed_Unload" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_g0088_c6" name="Arc_Unload_to_Reset" location="plant://sectionA/C_Unload_Reset" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_g0088_c7" name="Arc_Reset_to_Idle" location="plant://sectionA/C_Reset_Idle" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>