<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="IndustrialSequence" location="plant:A1:seq01">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStep" location="plant:A1:seq01:init" isInitial="true" isActive="true" action="initialize system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="LoadStep" location="plant:A1:seq01:load" isInitial="false" isActive="false" action="load materials"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="ProcessStep" location="plant:A1:seq01:process" isInitial="false" isActive="false" action="run processing"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="FinalStep" location="plant:A1:seq01:final" isInitial="false" isActive="false" action="shutdown system"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="T_InitToLoad" location="plant:A1:seq01:t1" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="T_LoadToProcess" location="plant:A1:seq01:t2" condition="materials_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="T_ProcessToFinal" location="plant:A1:seq01:t3" condition="process_complete"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="Arc_Init_to_T1" location="plant:A1:seq01:arc0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.1" name="Arc_T1_to_Load" location="plant:A1:seq01:arc1" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" name="Arc_Load_to_T2" location="plant:A1:seq01:arc2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" name="Arc_T2_to_Process" location="plant:A1:seq01:arc3" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.4" name="Arc_Process_to_T3" location="plant:A1:seq01:arc4" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5" name="Arc_T3_to_Final" location="plant:A1:seq01:arc5" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>