<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ProductionLineGrafcet" location="file://model/grafcet0016.gcf">
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="file://model/grafcet0016.gcf#S0" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="LoadMaterial" location="file://model/grafcet0016.gcf#S1" isInitial="false" isActive="false" action="load_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ProcessMaterial" location="file://model/grafcet0016.gcf#S2" isInitial="false" isActive="false" action="process_material"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="UnloadMaterial" location="file://model/grafcet0016.gcf#S3" isInitial="false" isActive="false" action="unload_material"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_InitToLoad" location="file://model/grafcet0016.gcf#T0" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_LoadToProcess" location="file://model/grafcet0016.gcf#T1" condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_ProcessToUnload" location="file://model/grafcet0016.gcf#T2" condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="T_UnloadToInit" location="file://model/grafcet0016.gcf#T3" condition="unload_complete"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="Arc_Init_to_T0" location="file://model/grafcet0016.gcf#C0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="Arc_T0_to_Load" location="file://model/grafcet0016.gcf#C1" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="Arc_Load_to_T1" location="file://model/grafcet0016.gcf#C2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C3" name="Arc_T1_to_Process" location="file://model/grafcet0016.gcf#C3" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="Arc_Process_to_T2" location="file://model/grafcet0016.gcf#C4" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="Arc_T2_to_Unload" location="file://model/grafcet0016.gcf#C5" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" name="Arc_Unload_to_T3" location="file://model/grafcet0016.gcf#C6" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="Arc_T3_to_Init" location="file://model/grafcet0016.gcf#C7" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>