<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcetExample" location="loc://grafcet/main">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStepA" location="loc://grafcet/stepA" isInitial="true" isActive="true" action="initialize subsystem A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="InitStepB" location="loc://grafcet/stepB" isInitial="true" isActive="false" action="initialize subsystem B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="ProcessingStep" location="loc://grafcet/stepProcessing" isInitial="false" isActive="false" action="process data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="FinalStep" location="loc://grafcet/stepFinal" isInitial="false" isActive="false" action="finalize and shutdown"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="T_InitToProcess" location="loc://grafcet/transInitToProc" condition="A and B initialized"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="T_ProcessToFinal" location="loc://grafcet/transProcToFinal" condition="processing complete"/>

    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="Arc_InitA_to_TInitProc" location="loc://grafcet/conn0"
        from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.1" name="Arc_InitB_to_TInitProc" location="loc://grafcet/conn1"
        from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.2" name="Arc_TInitProc_to_Processing" location="loc://grafcet/conn2"
        from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.3" name="Arc_Processing_to_TProcFinal" location="loc://grafcet/conn3"
        from="/0/@elements.2" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.4" name="Arc_TProcFinal_to_Final" location="loc://grafcet/conn4"
        from="/0/@elements.5" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>