<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_grafcet_1" name="ProductionLine" location="file://model/productionLine.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_step_A" name="LoadMaterial" location="file://model/productionLine.grafcet#LoadMaterial" isInitial="true" isActive="true" action="load"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_B" name="ProcessMaterial" location="file://model/productionLine.grafcet#ProcessMaterial" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_C" name="UnloadMaterial" location="file://model/productionLine.grafcet#UnloadMaterial" isInitial="false" isActive="false" action="unload"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_D" name="QualityCheck" location="file://model/productionLine.grafcet#QualityCheck" isInitial="false" isActive="false" action="inspect"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_T1" name="T_LoadToProcess" location="file://model/productionLine.grafcet#T_LoadToProcess" condition="loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_T2" name="T_ProcessToUnload" location="file://model/productionLine.grafcet#T_ProcessToUnload" condition="processed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_T3" name="T_UnloadToQuality" location="file://model/productionLine.grafcet#T_UnloadToQuality" condition="unloaded"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_conn_ST_A_T1"
                 name="Arc_Load_to_T1"
                 location="file://model/productionLine.grafcet#Arc_Load_to_T1"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_conn_ST_B_T2"
                 name="Arc_Process_to_T2"
                 location="file://model/productionLine.grafcet#Arc_Process_to_T2"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_conn_ST_C_T3"
                 name="Arc_Unload_to_T3"
                 location="file://model/productionLine.grafcet#Arc_Unload_to_T3"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_conn_TS_T1_B"
                 name="Arc_T1_to_Process"
                 location="file://model/productionLine.grafcet#Arc_T1_to_Process"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_conn_TS_T2_C"
                 name="Arc_T2_to_Unload"
                 location="file://model/productionLine.grafcet#Arc_T2_to_Unload"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_conn_TS_T3_D"
                 name="Arc_T3_to_Quality"
                 location="file://model/productionLine.grafcet#Arc_T3_to_Quality"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>