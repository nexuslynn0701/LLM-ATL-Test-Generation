<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet0057" location="loc://grafcet/main">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStepA" location="loc://grafcet/main/stepA" isInitial="true" isActive="true" action="startA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="InitStepB" location="loc://grafcet/main/stepB" isInitial="true" isActive="false" action="startB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="MiddleStepC" location="loc://grafcet/main/stepC" isInitial="false" isActive="false" action="processC"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="BranchStepD" location="loc://grafcet/main/stepD" isInitial="false" isActive="true" action="branchD"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="FinalStepE" location="loc://grafcet/main/stepE" isInitial="false" isActive="false" action="finishE"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="TransitionAB" location="loc://grafcet/main/transAB" condition="condAB"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="TransitionBC" location="loc://grafcet/main/transBC" condition="condBC"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="TransitionCD" location="loc://grafcet/main/transCD" condition="condCD"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="TransitionDE" location="loc://grafcet/main/transDE" condition="condDE"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="TransitionLoopC" location="loc://grafcet/main/transLoopC" condition="condLoopC"/>

    <!-- StepToTransition connections (PlaceToTransition arcs in target) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="Arc_InitA_AB" location="loc://grafcet/main/conn0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="Arc_InitB_AB" location="loc://grafcet/main/conn1" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="Arc_MidC_BC" location="loc://grafcet/main/conn2" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="Arc_MidC_LoopC" location="loc://grafcet/main/conn3" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="Arc_BranchD_CD" location="loc://grafcet/main/conn4" from="/0/@elements.3" to="/0/@elements.7"/>

    <!-- TransitionToStep connections (TransitionToPlace arcs in target) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="Arc_AB_MidC" location="loc://grafcet/main/conn5" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="Arc_BC_BranchD" location="loc://grafcet/main/conn6" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="Arc_CD_FinalE" location="loc://grafcet/main/conn7" from="/0/@elements.7" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="Arc_LoopC_MidC" location="loc://grafcet/main/conn8" from="/0/@elements.9" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="Arc_DE_FinalE" location="loc://grafcet/main/conn9" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>