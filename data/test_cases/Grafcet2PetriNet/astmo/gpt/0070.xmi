<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ComplexProcessGrafcet" location="model/grafcet/complex/0070">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStep" location="model/grafcet/complex/0070#InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="LoadDataStep" location="model/grafcet/complex/0070#LoadDataStep" isInitial="false" isActive="false" action="load_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="ProcessDataStep" location="model/grafcet/complex/0070#ProcessDataStep" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="FinalizeStep" location="model/grafcet/complex/0070#FinalizeStep" isInitial="false" isActive="false" action="finalize_and_cleanup"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" name="InitToLoadTrans" location="model/grafcet/complex/0070#InitToLoadTrans" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="LoadToProcessTrans" location="model/grafcet/complex/0070#LoadToProcessTrans" condition="data_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="ProcessToFinalizeTrans" location="model/grafcet/complex/0070#ProcessToFinalizeTrans" condition="processing_complete"/>
    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="Arc_Init_to_InitToLoad" location="model/grafcet/complex/0070#Arc_Init_to_InitToLoad" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.1" name="Arc_Load_to_LoadToProcess" location="model/grafcet/complex/0070#Arc_Load_to_LoadToProcess" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" name="Arc_Process_to_ProcessToFinalize" location="model/grafcet/complex/0070#Arc_Process_to_ProcessToFinalize" from="/0/@elements.2" to="/0/@elements.6"/>
    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" name="Arc_InitToLoad_to_Load" location="model/grafcet/complex/0070#Arc_InitToLoad_to_Load" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.4" name="Arc_LoadToProcess_to_Process" location="model/grafcet/complex/0070#Arc_LoadToProcess_to_Process" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5" name="Arc_ProcessToFinalize_to_Finalize" location="model/grafcet/complex/0070#Arc_ProcessToFinalize_to_Finalize" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>