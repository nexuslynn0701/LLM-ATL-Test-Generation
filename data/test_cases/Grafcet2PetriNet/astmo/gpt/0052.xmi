<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" location="file://grafcet_models/model_0052.gcf" name="IndustrialSequence0052">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" location="L1" name="LoadMaterial" isInitial="true" isActive="true" action="start_loader"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" location="L2" name="AlignMaterial" isInitial="false" isActive="false" action="align_sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" location="L3" name="PressMaterial" isInitial="false" isActive="false" action="activate_press"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" location="L4" name="UnloadMaterial" isInitial="false" isActive="false" action="start_unloader"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.4" location="T1" name="LoadedToAligned" condition="loader_complete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" location="T2" name="AlignedToPressed" condition="alignment_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" location="T3" name="PressedToUnload" condition="press_cycle_done"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" location="C1" name="Arc_Load_to_T1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.1" location="C2" name="Arc_T1_to_Align" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" location="C3" name="Arc_Align_to_T2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" location="C4" name="Arc_T2_to_Press" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.4" location="C5" name="Arc_Press_to_T3" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5" location="C6" name="Arc_T3_to_Unload" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>