<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ProductionLineGrafcet" location="file://model/grafcet_0069.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              name="InitStep"
              location="file://model/grafcet_0069.gcf#InitStep"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="LoadMaterial"
              location="file://model/grafcet_0069.gcf#LoadMaterial"
              isInitial="false"
              isActive="false"
              action="load_material"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="ProcessMaterial"
              location="file://model/grafcet_0069.gcf#ProcessMaterial"
              isInitial="false"
              isActive="false"
              action="process_material"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              name="UnloadMaterial"
              location="file://model/grafcet_0069.gcf#UnloadMaterial"
              isInitial="false"
              isActive="false"
              action="unload_material"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              name="T_InitToLoad"
              location="file://model/grafcet_0069.gcf#T_InitToLoad"
              condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="T_LoadToProcess"
              location="file://model/grafcet_0069.gcf#T_LoadToProcess"
              condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="T_ProcessToUnload"
              location="file://model/grafcet_0069.gcf#T_ProcessToUnload"
              condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t3"
              name="T_UnloadToInit"
              location="file://model/grafcet_0069.gcf#T_UnloadToInit"
              condition="unload_complete"/>

    <!-- StepToTransition connections (PlaceToTransition arcs in target) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="C_Init_to_T0"
                 location="file://model/grafcet_0069.gcf#C_Init_to_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="C_Load_to_T1"
                 location="file://model/grafcet_0069.gcf#C_Load_to_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="C_Process_to_T2"
                 location="file://model/grafcet_0069.gcf#C_Process_to_T2"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 name="C_Unload_to_T3"
                 location="file://model/grafcet_0069.gcf#C_Unload_to_T3"
                 from="/0/@elements.3"
                 to="/0/@elements.7"/>

    <!-- TransitionToStep connections (TransitionToPlace arcs in target) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 name="C_T0_to_Load"
                 location="file://model/grafcet_0069.gcf#C_T0_to_Load"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 name="C_T1_to_Process"
                 location="file://model/grafcet_0069.gcf#C_T1_to_Process"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 name="C_T2_to_Unload"
                 location="file://model/grafcet_0069.gcf#C_T2_to_Unload"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 name="C_T3_to_Init"
                 location="file://model/grafcet_0069.gcf#C_T3_to_Init"
                 from="/0/@elements.7"
                 to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>