<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet0026" location="locG0026">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStepA" location="locS_A" isInitial="true" isActive="true" action="Initialize subsystem A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="InitStepB" location="locS_B" isInitial="true" isActive="false" action="Initialize subsystem B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="ProcessStep1" location="locS_P1" isInitial="false" isActive="false" action="Process stage 1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="ProcessStep2" location="locS_P2" isInitial="false" isActive="false" action="Process stage 2"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.4" name="FinalStep" location="locS_F" isInitial="false" isActive="false" action="Finalize sequence"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="T_InitToP1" location="locT_1" condition="A and B initialized"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="T_P1ToP2" location="locT_2" condition="Stage1 complete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.7" name="T_P2ToFinal" location="locT_3" condition="Stage2 complete"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="Arc_InitA_to_T1" location="locC_0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.1" name="Arc_InitB_to_T1" location="locC_1" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.2" name="Arc_T1_to_P1" location="locC_2" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.3" name="Arc_P1_to_T2" location="locC_3" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.4" name="Arc_T2_to_P2" location="locC_4" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.5" name="Arc_P2_to_T3" location="locC_5" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.6" name="Arc_T3_to_Final" location="locC_6" from="/0/@elements.7" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>