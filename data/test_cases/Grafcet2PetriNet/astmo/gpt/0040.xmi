<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_grafcet1" name="ProductionLineControl" location="plantA.line3">
    <elements xsi:type="Grafcet:Step" xmi:id="_step1" name="StartLine" location="plantA.line3.start" isInitial="true" isActive="true" action="InitializeConveyors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step2" name="FeedMaterial" location="plantA.line3.feed" isInitial="false" isActive="false" action="ActivateFeeders"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step3" name="ProcessMaterial" location="plantA.line3.process" isInitial="false" isActive="false" action="RunProcessingUnit"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans1" name="t_start_to_feed" location="plantA.line3.ctrl" condition="conveyorsReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans2" name="t_feed_to_process" location="plantA.line3.ctrl" condition="materialAtStation"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn1" name="arc_start_feed" location="plantA.line3.conn" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn2" name="arc_feed_process" location="plantA.line3.conn" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn3" name="arc_feed_tprocess" location="plantA.line3.conn" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn4" name="arc_tprocess_process" location="plantA.line3.conn" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>