<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet0033" location="loc://grafcet/0033">
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="loc://grafcet/0033/step0" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="MiddleStep" location="loc://grafcet/0033/step1" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="FinalStep" location="loc://grafcet/0033/step2" isInitial="false" isActive="false" action="shutdown_system"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_InitToMiddle" location="loc://grafcet/0033/trans0" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_MiddleLoop" location="loc://grafcet/0033/trans1" condition="more_data"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_MiddleToFinal" location="loc://grafcet/0033/trans2" condition="no_more_data"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_Init_to_T0" location="loc://grafcet/0033/conn0" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="C_T0_to_Middle" location="loc://grafcet/0033/conn1" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="C_Middle_to_T1" location="loc://grafcet/0033/conn2" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C3" name="C_T1_to_Middle" location="loc://grafcet/0033/conn3" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_Middle_to_T2" location="loc://grafcet/0033/conn4" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="C_T2_to_Final" location="loc://grafcet/0033/conn5" from="/0/@elements.5" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>