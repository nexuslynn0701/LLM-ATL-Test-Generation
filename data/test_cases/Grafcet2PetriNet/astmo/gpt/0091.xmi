<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ProductionLine" location="file:/models/grafcet_productionline.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              name="LoadStation"
              location="file:/models/grafcet_productionline.gcf#LoadStation"
              isInitial="true"
              isActive="true"
              action="load_material"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="ProcessStation"
              location="file:/models/grafcet_productionline.gcf#ProcessStation"
              isInitial="false"
              isActive="false"
              action="process_material"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="UnloadStation"
              location="file:/models/grafcet_productionline.gcf#UnloadStation"
              isInitial="false"
              isActive="false"
              action="unload_material"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              name="ErrorHandler"
              location="file:/models/grafcet_productionline.gcf#ErrorHandler"
              isInitial="true"
              isActive="false"
              action="handle_error"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              name="T_LoadToProcess"
              location="file:/models/grafcet_productionline.gcf#T_LoadToProcess"
              condition="material_loaded"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="T_ProcessToUnload"
              location="file:/models/grafcet_productionline.gcf#T_ProcessToUnload"
              condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="T_ErrorToLoad"
              location="file:/models/grafcet_productionline.gcf#T_ErrorToLoad"
              condition="error_cleared"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="Arc_Load_to_T0"
                 location="file:/models/grafcet_productionline.gcf#Arc_Load_to_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="Arc_Process_to_T1"
                 location="file:/models/grafcet_productionline.gcf#Arc_Process_to_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="Arc_Error_to_T2"
                 location="file:/models/grafcet_productionline.gcf#Arc_Error_to_T2"
                 from="/0/@elements.3"
                 to="/0/@elements.6"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c3"
                 name="Arc_T0_to_Process"
                 location="file:/models/grafcet_productionline.gcf#Arc_T0_to_Process"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 name="Arc_T1_to_Unload"
                 location="file:/models/grafcet_productionline.gcf#Arc_T1_to_Unload"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 name="Arc_T2_to_Load"
                 location="file:/models/grafcet_productionline.gcf#Arc_T2_to_Load"
                 from="/0/@elements.6"
                 to="/0/@elements.0"/>
  </Grafcet:Grafcet>

</xmi:XMI>