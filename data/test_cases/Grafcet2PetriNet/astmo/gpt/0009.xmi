<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="g1" name="ProductionLineGrafcet" location="file://model/grafcet_0009.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="s1"
              name="InputBufferStep"
              location="file://model/grafcet_0009.gcf#s1"
              isInitial="true"
              isActive="true"
              action="loadBuffer"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="s2"
              name="ProcessingStep"
              location="file://model/grafcet_0009.gcf#s2"
              isInitial="false"
              isActive="false"
              action="processItem"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="s3"
              name="QualityCheckStep"
              location="file://model/grafcet_0009.gcf#s3"
              isInitial="false"
              isActive="false"
              action="inspectItem"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="s4"
              name="OutputBufferStep"
              location="file://model/grafcet_0009.gcf#s4"
              isInitial="false"
              isActive="false"
              action="storeItem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t1"
              name="StartProcessingTransition"
              location="file://model/grafcet_0009.gcf#t1"
              condition="bufferNotEmpty"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t2"
              name="FinishProcessingTransition"
              location="file://model/grafcet_0009.gcf#t2"
              condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t3"
              name="QualityApprovedTransition"
              location="file://model/grafcet_0009.gcf#t3"
              condition="qualityOk"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c1"
                 name="InputToStartProcessing"
                 location="file://model/grafcet_0009.gcf#c1"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c2"
                 name="ProcessingToFinish"
                 location="file://model/grafcet_0009.gcf#c2"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c3"
                 name="QualityToApproved"
                 location="file://model/grafcet_0009.gcf#c3"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c4"
                 name="StartToProcessing"
                 location="file://model/grafcet_0009.gcf#c4"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c5"
                 name="FinishToQuality"
                 location="file://model/grafcet_0009.gcf#c5"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c6"
                 name="ApprovedToOutput"
                 location="file://model/grafcet_0009.gcf#c6"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
  </Grafcet:Grafcet>

</xmi:XMI>