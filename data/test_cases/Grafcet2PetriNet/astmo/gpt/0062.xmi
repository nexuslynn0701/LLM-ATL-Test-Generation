<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_grafcet_main" name="ComplexGrafcet62" location="file://model62.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_step_A" name="StepA" location="file://model62.grafcet#StepA" isInitial="true" isActive="true" action="Initialize system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_B" name="StepB" location="file://model62.grafcet#StepB" isInitial="false" isActive="false" action="Check sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_C" name="StepC" location="file://model62.grafcet#StepC" isInitial="false" isActive="false" action="Process data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step_D" name="StepD" location="file://model62.grafcet#StepD" isInitial="false" isActive="false" action="Shutdown system"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_1" name="T1" location="file://model62.grafcet#T1" condition="SensorsReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_2" name="T2" location="file://model62.grafcet#T2" condition="DataProcessed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans_3" name="T3" location="file://model62.grafcet#T3" condition="ErrorDetected"/>
    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn_ST_A_1" name="Arc_A_T1" location="file://model62.grafcet#Arc_A_T1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn_ST_B_2" name="Arc_B_T2" location="file://model62.grafcet#Arc_B_T2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_conn_ST_C_3" name="Arc_C_T3" location="file://model62.grafcet#Arc_C_T3" from="/0/@elements.2" to="/0/@elements.6"/>
    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn_TS_1_B" name="Arc_T1_B" location="file://model62.grafcet#Arc_T1_B" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn_TS_2_C" name="Arc_T2_C" location="file://model62.grafcet#Arc_T2_C" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_conn_TS_3_D" name="Arc_T3_D" location="file://model62.grafcet#Arc_T3_D" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>