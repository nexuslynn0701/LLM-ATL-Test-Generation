<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet" location="test">
    <elements xsi:type="Grafcet:Step" name="Step0" location="loc0" isInitial="true" isActive="true" action="Initialize"/>
    <elements xsi:type="Grafcet:Step" name="Step1" location="loc1" isInitial="false" isActive="false" action="ProcessA"/>
    <elements xsi:type="Grafcet:Step" name="Step2" location="loc2" isInitial="false" isActive="false" action="ProcessB"/>
    <elements xsi:type="Grafcet:Step" name="Step3" location="loc3" isInitial="false" isActive="false" action="ProcessC"/>
    <elements xsi:type="Grafcet:Transition" name="T0" location="loc4" condition="StartCondition"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="loc5" condition="ConditionA"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="loc6" condition="ConditionB"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="loc7" condition="ConditionC"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S0toT0" location="loc8" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T0toS1" location="loc9" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S1toT1" location="loc10" from="/0/@elements.1" to="/0/@elements.5"/>
