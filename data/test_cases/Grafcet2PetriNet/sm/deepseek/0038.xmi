    <connections xsi:type="Grafcet:StepToTransition" name="S2toT2" location="loc12" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T2toS3" location="loc13" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S3toT3" location="loc14" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T3toS0" location="loc15" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>