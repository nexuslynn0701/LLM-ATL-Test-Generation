    <connections xsi:type="Grafcet:TransitionToStep" name="T3toS3" location="loc14" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S3toT4" location="loc15" from="/0/@elements.3" to="/0/@elements.7"/>
