    <elements xsi:type="Grafcet:Step" name="StepC" location="loc4" isInitial="false" isActive="false" action="ProcessC"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="loc5" condition="StartCondition"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="loc6" condition="ConditionA"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="loc7" condition="ConditionB"/>
    <elements xsi:type="Grafcet:Transition" name="T4" location="loc8" condition="ConditionC"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S0toT1" location="loc9" from="/0/@elements.0" to="/0/@elements.4"/>
