<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet" location="test">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="loc1" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Step" name="StepA" location="loc2" isInitial="false" isActive="false" action="ProcessA"/>
