<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet" location="test.grafcet">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="step1.loc" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Step" name="StepA" location="stepA.loc" isInitial="false" isActive="false" action="ProcessA"/>
    <elements xsi:type="Grafcet:Step" name="StepB" location="stepB.loc" isInitial="false" isActive="false" action="ProcessB"/>
    <elements xsi:type="Grafcet:Step" name="StepC" location="stepC.loc" isInitial="false" isActive="false" action="ProcessC"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="t1.loc" condition="X1"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="t2.loc" condition="X2"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="t3.loc" condition="X3"/>
    <elements xsi:type="Grafcet:Transition" name="T4" location="t4.loc" condition="X4"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S1toT1" location="c1.loc" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T1toS2" location="c2.loc" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S2toT2" location="c3.loc" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T2toS3" location="c4.loc" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S3toT3" location="c5.loc" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T3toS4" location="c6.loc" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S4toT4" location="c7.loc" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T4toS1" location="c8.loc" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>