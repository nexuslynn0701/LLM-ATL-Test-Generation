<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="Grafcet_0070" location="loc_0">
    <elements xsi:type="Grafcet:Step" name="Step_Initial" location="loc_1" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Step" name="Step_A" location="loc_2" isInitial="false" isActive="false" action="ProcessA"/>
    <elements xsi:type="Grafcet:Step" name="Step_B" location="loc_3" isInitial="false" isActive="false" action="ProcessB"/>
    <elements xsi:type="Grafcet:Step" name="Step_C" location="loc_4" isInitial="false" isActive="false" action="ProcessC"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="loc_5" condition="x &gt; 10"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="loc_6" condition="y == 0"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="loc_7" condition="z &lt; 5"/>
    <elements xsi:type="Grafcet:Transition" name="T4" location="loc_8" condition="flag"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S0_T1" location="loc_9" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T1_S1" location="loc_10" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S1_T2" location="loc_11" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T2_S2" location="loc_12" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S2_T3" location="loc_13" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T3_S3" location="loc_14" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S3_T4" location="loc_15" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T4_S0" location="loc_16" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>