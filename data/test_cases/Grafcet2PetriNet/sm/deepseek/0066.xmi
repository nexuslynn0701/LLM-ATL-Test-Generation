<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexGrafcet" location="model/complex.grafcet">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="step1" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Step" name="ProcessStep" location="step2" isInitial="false" isActive="false" action="Process"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="step3" isInitial="false" isActive="false" action="End"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="trans1" condition="StartButton"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="trans2" condition="SensorOk"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="trans3" condition="TimerDone"/>
    <elements xsi:type="Grafcet:Step" name="ParallelStep1" location="step4" isInitial="false" isActive="false" action="ParallelAction1"/>
    <elements xsi:type="Grafcet:Step" name="ParallelStep2" location="step5" isInitial="false" isActive="false" action="ParallelAction2"/>
    <elements xsi:type="Grafcet:Transition" name="T4" location="trans4" condition="AndCondition"/>
    <elements xsi:type="Grafcet:Transition" name="T5" location="trans5" condition="OrCondition"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S1toT1" location="conn1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T1toS2" location="conn2" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S2toT2" location="conn3" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T2toS3" location="conn4" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S1toT3" location="conn5" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T3toPS1" location="conn6" from="/0/@elements.5" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T3toPS2" location="conn7" from="/0/@elements.5" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" name="PS1toT4" location="conn8" from="/0/@elements.6" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" name="PS2toT5" location="conn9" from="/0/@elements.7" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T4toS3" location="conn10" from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T5toS3" location="conn11" from="/0/@elements.9" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>