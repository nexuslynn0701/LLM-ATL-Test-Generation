<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet" location="testLocation">
    <elements xsi:type="Grafcet:Step" name="Step1" location="loc1" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Step" name="Step2" location="loc2" isInitial="false" isActive="false" action="Process"/>
    <elements xsi:type="Grafcet:Step" name="Step3" location="loc3" isInitial="false" isActive="false" action="End"/>
    <elements xsi:type="Grafcet:Transition" name="Trans1" location="loc4" condition="X1"/>
    <elements xsi:type="Grafcet:Transition" name="Trans2" location="loc5" condition="X2"/>
    <elements xsi:type="Grafcet:Transition" name="Trans3" location="loc6" condition="X3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn1" location="loc7" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn2" location="loc8" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn3" location="loc9" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn4" location="loc10" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn5" location="loc11" from="/0/@elements.2" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn6" location="loc12" from="/0/@elements.5" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>