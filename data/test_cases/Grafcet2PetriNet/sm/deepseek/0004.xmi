<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet" location="test_location">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="loc1" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Step" name="Step1" location="loc2" isInitial="false" isActive="false" action="Process"/>
    <elements xsi:type="Grafcet:Step" name="Step2" location="loc3" isInitial="false" isActive="false" action="Validate"/>
    <elements xsi:type="Grafcet:Step" name="Step3" location="loc4" isInitial="false" isActive="false" action="Output"/>
    <elements xsi:type="Grafcet:Transition" name="Trans1" location="loc5" condition="x &gt; 10"/>
    <elements xsi:type="Grafcet:Transition" name="Trans2" location="loc6" condition="y == 0"/>
    <elements xsi:type="Grafcet:Transition" name="Trans3" location="loc7" condition="z &lt; 5"/>
    <elements xsi:type="Grafcet:Transition" name="Trans4" location="loc8" condition="flag == true"/>
    <connections xsi:type="Grafcet:StepToTransition" name="conn1" location="loc9" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="conn2" location="loc10" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="conn3" location="loc11" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="conn4" location="loc12" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="conn5" location="loc13" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="conn6" location="loc14" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="conn7" location="loc15" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="conn8" location="loc16" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>