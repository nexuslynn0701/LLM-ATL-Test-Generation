<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="loc0" name="TestGrafcet">
    <elements xsi:type="Grafcet:Step" location="loc1" name="InitialStep" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Step" location="loc2" name="Step1" isInitial="false" isActive="false" action="Process"/>
    <elements xsi:type="Grafcet:Step" location="loc3" name="Step2" isInitial="false" isActive="false" action="Validate"/>
    <elements xsi:type="Grafcet:Step" location="loc4" name="Step3" isInitial="false" isActive="false" action="Output"/>
    <elements xsi:type="Grafcet:Transition" location="loc5" name="T1" condition="StartButton"/>
    <elements xsi:type="Grafcet:Transition" location="loc6" name="T2" condition="SensorOK"/>
    <elements xsi:type="Grafcet:Transition" location="loc7" name="T3" condition="TimerDone"/>
    <elements xsi:type="Grafcet:Transition" location="loc8" name="T4" condition="Reset"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc9" name="S0toT1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc10" name="T1toS1" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc11" name="S1toT2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc12" name="T2toS2" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc13" name="S2toT3" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc14" name="T3toS3" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" location="loc15" name="S3toT4" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="loc16" name="T4toS0" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>