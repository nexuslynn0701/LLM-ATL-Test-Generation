    <connections xsi:type="Grafcet:StepToTransition" name="S3_to_T3" location="loc_c5" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T3_to_S4" location="loc_c6" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S4_to_T4" location="loc_c7" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T4_to_S1" location="loc_c8" from="/0/@elements.7" to="/0/@elements.0"/>
