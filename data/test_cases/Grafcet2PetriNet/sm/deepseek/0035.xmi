    <elements xsi:type="Grafcet:Transition" name="T1" location="loc_t1" condition="Sensor1"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="loc_t2" condition="Sensor2"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="loc_t3" condition="Sensor3"/>
    <elements xsi:type="Grafcet:Transition" name="T4" location="loc_t4" condition="Sensor4"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S1_to_T1" location="loc_c1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T1_to_S2" location="loc_c2" from="/0/@elements.4" to="/0/@elements.1"/>
