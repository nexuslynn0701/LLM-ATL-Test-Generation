<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="Grafcet_0035" location="loc_main">
    <elements xsi:type="Grafcet:Step" name="Step_Initial" location="loc_s1" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Step" name="Step_A" location="loc_s2" isInitial="false" isActive="false" action="ProcessA"/>
    <elements xsi:type="Grafcet:Step" name="Step_B" location="loc_s3" isInitial="false" isActive="false" action="ProcessB"/>
