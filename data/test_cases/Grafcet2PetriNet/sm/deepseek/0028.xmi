<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="Grafcet_0028" location="loc_main">
    <elements xsi:type="Grafcet:Step" name="Step_Initial" location="loc_s1" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Step" name="Step_A" location="loc_s2" isInitial="false" isActive="false" action="Process_A"/>
    <elements xsi:type="Grafcet:Step" name="Step_B" location="loc_s3" isInitial="false" isActive="false" action="Process_B"/>
    <elements xsi:type="Grafcet:Step" name="Step_C" location="loc_s4" isInitial="false" isActive="false" action="Process_C"/>
    <elements xsi:type="Grafcet:Transition" name="Trans_1" location="loc_t1" condition="Start_Button"/>
    <elements xsi:type="Grafcet:Transition" name="Trans_2" location="loc_t2" condition="Sensor_A"/>
    <elements xsi:type="Grafcet:Transition" name="Trans_3" location="loc_t3" condition="Sensor_B"/>
    <elements xsi:type="Grafcet:Transition" name="Trans_4" location="loc_t4" condition="Sensor_C"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_1" location="loc_c1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_2" location="loc_c2" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_3" location="loc_c3" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_4" location="loc_c4" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_5" location="loc_c5" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_6" location="loc_c6" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_7" location="loc_c7" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_8" location="loc_c8" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>