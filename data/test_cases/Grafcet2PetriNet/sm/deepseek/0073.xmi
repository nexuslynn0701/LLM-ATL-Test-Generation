<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="model0073" name="TestGrafcet0073">
    <elements xsi:type="Grafcet:Step" location="step1_loc" name="S1" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Step" location="step2_loc" name="S2" isInitial="false" isActive="false" action="Process"/>
    <elements xsi:type="Grafcet:Step" location="step3_loc" name="S3" isInitial="false" isActive="false" action="Check"/>
    <elements xsi:type="Grafcet:Step" location="step4_loc" name="S4" isInitial="false" isActive="false" action="End"/>
    <elements xsi:type="Grafcet:Transition" location="trans1_loc" name="T1" condition="x>10"/>
    <elements xsi:type="Grafcet:Transition" location="trans2_loc" name="T2" condition="y==5"/>
    <elements xsi:type="Grafcet:Transition" location="trans3_loc" name="T3" condition="z&lt;0"/>
    <elements xsi:type="Grafcet:Transition" location="trans4_loc" name="T4" condition="done"/>
    <connections xsi:type="Grafcet:StepToTransition" location="conn1_loc" name="ST1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" location="conn2_loc" name="ST2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" location="conn3_loc" name="ST3" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="conn4_loc" name="TS1" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="conn5_loc" name="TS2" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="conn6_loc" name="TS3" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="conn7_loc" name="TS4" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>