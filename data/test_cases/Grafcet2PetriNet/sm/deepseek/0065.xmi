<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="Grafcet_0065" location="loc_main">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="loc_s1" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Step" name="StepA" location="loc_s2" isInitial="false" isActive="false" action="ProcessA"/>
    <elements xsi:type="Grafcet:Step" name="StepB" location="loc_s3" isInitial="false" isActive="false" action="ProcessB"/>
    <elements xsi:type="Grafcet:Step" name="StepC" location="loc_s4" isInitial="false" isActive="false" action="ProcessC"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="loc_t1" condition="StartButton"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="loc_t2" condition="SensorA"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="loc_t3" condition="SensorB"/>
    <elements xsi:type="Grafcet:Transition" name="T4" location="loc_t4" condition="TimerDone"/>
    <elements xsi:type="Grafcet:Transition" name="T5" location="loc_t5" condition="Reset"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="loc_c1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C2" location="loc_c2" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C3" location="loc_c3" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C4" location="loc_c4" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C5" location="loc_c5" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C6" location="loc_c6" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C7" location="loc_c7" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C8" location="loc_c8" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>