<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="file://complex.grafcet">
    <!-- Elements: Steps and Transitions -->
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="file://complex.grafcet#s0"
              isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="BranchLeft" location="file://complex.grafcet#s1"
              isInitial="false" isActive="false" action="executeLeftBranch"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="BranchRight" location="file://complex.grafcet#s2"
              isInitial="false" isActive="false" action="executeRightBranch"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="MergeStep" location="file://complex.grafcet#s3"
              isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="LoopStep" location="file://complex.grafcet#s4"
              isInitial="false" isActive="false" action="loopAction"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="FinalStep" location="file://complex.grafcet#s5"
              isInitial="false" isActive="false" action="finalizeSystem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_to_Branch" location="file://complex.grafcet#t0"
              condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Branch_Left" location="file://complex.grafcet#t1"
              condition="chooseLeft"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_Branch_Right" location="file://complex.grafcet#t2"
              condition="chooseRight"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_Join" location="file://complex.grafcet#t3"
              condition="bothDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_Loop" location="file://complex.grafcet#t4"
              condition="repeatLoop"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_ExitLoop" location="file://complex.grafcet#t5"
              condition="exitLoop"/>

    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- InitStep -> T_Init_to_Branch -> BranchLeft -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0"
                 name="C_Init_to_T0" location="file://complex.grafcet#c0"
                 from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1"
                 name="C_T0_to_Left" location="file://complex.grafcet#c1"
                 from="/0/@elements.6" to="/0/@elements.1"/>

    <!-- InitStep -> T_Branch_Right -> BranchRight (parallel branch from same initial step) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2"
                 name="C_Init_to_T2" location="file://complex.grafcet#c2"
                 from="/0/@elements.0" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3"
                 name="C_T2_to_Right" location="file://complex.grafcet#c3"
                 from="/0/@elements.8" to="/0/@elements.2"/>

    <!-- BranchLeft -> T_Branch_Left -> MergeStep -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4"
                 name="C_Left_to_T1" location="file://complex.grafcet#c4"
                 from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5"
                 name="C_T1_to_Merge" location="file://complex.grafcet#c5"
                 from="/0/@elements.7" to="/0/@elements.3"/>

    <!-- BranchRight -> T_Join -> MergeStep (join with shared target step) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6"
                 name="C_Right_to_T3" location="file://complex.grafcet#c6"
                 from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7"
                 name="C_T3_to_Merge" location="file://complex.grafcet#c7"
                 from="/0/@elements.9" to="/0/@elements.3"/>

    <!-- MergeStep -> T_Loop -> LoopStep -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8"
                 name="C_Merge_to_T4" location="file://complex.grafcet#c8"
                 from="/0/@elements.3" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9"
                 name="C_T4_to_Loop" location="file://complex.grafcet#c9"
                 from="/0/@elements.10" to="/0/@elements.4"/>

    <!-- LoopStep -> T_Loop (self-loop back to LoopStep) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c10"
                 name="C_Loop_to_T4" location="file://complex.grafcet#c10"
                 from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11"
                 name="C_T4_to_LoopAgain" location="file://complex.grafcet#c11"
                 from="/0/@elements.10" to="/0/@elements.4"/>

    <!-- LoopStep -> T_ExitLoop -> FinalStep -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c12"
                 name="C_Loop_to_T5" location="file://complex.grafcet#c12"
                 from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13"
                 name="C_T5_to_Final" location="file://complex.grafcet#c13"
                 from="/0/@elements.11" to="/0/@elements.5"/>

  </Grafcet:Grafcet>
</xmi:XMI>