<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet0048" location="file://grafcet/complex0048.gcf">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="BranchStepA" location="2:1-2:25" isInitial="false" isActive="false" action="prepare_branch_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="BranchStepB" location="3:1-3:25" isInitial="false" isActive="false" action="prepare_branch_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="MergeStep" location="4:1-4:20" isInitial="false" isActive="false" action="merge_branches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="LoopStep" location="5:1-5:20" isInitial="false" isActive="true" action="loop_processing"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S5" name="FinalStep" location="6:1-6:20" isInitial="false" isActive="false" action="shutdown_system"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_Init_to_Branch" location="10:1-10:30" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_BranchA_to_Merge" location="11:1-11:35" condition="branch_A_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_BranchB_to_Merge" location="12:1-12:35" condition="branch_B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="T_Merge_to_Loop" location="13:1-13:30" condition="merge_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" name="T_Loop_self" location="14:1-14:30" condition="loop_again"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T5" name="T_Loop_to_Final" location="15:1-15:35" condition="stop_requested"/>
    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- From initial step to branching transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_S0_T0" location="20:1-20:25" from="/0/@elements.0" to="/0/@elements.6"/>
    <!-- From branching transition to BranchStepA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="C_T0_S1" location="21:1-21:25" from="/0/@elements.6" to="/0/@elements.1"/>
    <!-- From branching transition to BranchStepB (fan-out) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C2" name="C_T0_S2" location="22:1-22:25" from="/0/@elements.6" to="/0/@elements.2"/>
    <!-- From BranchStepA to its transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="C_S1_T1" location="23:1-23:25" from="/0/@elements.1" to="/0/@elements.7"/>
    <!-- From BranchStepB to its transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_S2_T2" location="24:1-24:25" from="/0/@elements.2" to="/0/@elements.8"/>
    <!-- From T1 to MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="C_T1_S3" location="25:1-25:25" from="/0/@elements.7" to="/0/@elements.3"/>
    <!-- From T2 to MergeStep (join) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C6" name="C_T2_S3" location="26:1-26:25" from="/0/@elements.8" to="/0/@elements.3"/>
    <!-- From MergeStep to Loop transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C7" name="C_S3_T3" location="27:1-27:25" from="/0/@elements.3" to="/0/@elements.9"/>
    <!-- From T3 to LoopStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C8" name="C_T3_S4" location="28:1-28:25" from="/0/@elements.9" to="/0/@elements.4"/>
    <!-- Loop: from LoopStep to T4 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C9" name="C_S4_T4" location="29:1-29:25" from="/0/@elements.4" to="/0/@elements.10"/>
    <!-- Loop: from T4 back to LoopStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C10" name="C_T4_S4" location="30:1-30:25" from="/0/@elements.10" to="/0/@elements.4"/>
    <!-- From LoopStep to final transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C11" name="C_S4_T5" location="31:1-31:25" from="/0/@elements.4" to="/0/@elements.11"/>
    <!-- From final transition to FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C12" name="C_T5_S5" location="32:1-32:25" from="/0/@elements.11" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>