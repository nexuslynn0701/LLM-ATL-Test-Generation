<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="file://complex_grafcet.g7">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="file://complex_grafcet.g7#s0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckInput" location="file://complex_grafcet.g7#s1" isInitial="false" isActive="false" action="checkInput"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessA" location="file://complex_grafcet.g7#s2" isInitial="false" isActive="false" action="executeBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ProcessB" location="file://complex_grafcet.g7#s3" isInitial="false" isActive="false" action="executeBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="MergeStep" location="file://complex_grafcet.g7#s4" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="LoopBody" location="file://complex_grafcet.g7#s5" isInitial="false" isActive="false" action="loopIteration"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" name="EndStep" location="file://complex_grafcet.g7#s6" isInitial="false" isActive="false" action="finalizeSystem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="t_init_to_check" location="file://complex_grafcet.g7#t0" condition="afterInit"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="t_decision" location="file://complex_grafcet.g7#t1" condition="inputOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="t_toA" location="file://complex_grafcet.g7#t2" condition="branchA"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="t_toB" location="file://complex_grafcet.g7#t3" condition="branchB"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="t_fromA" location="file://complex_grafcet.g7#t4" condition="doneA"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="t_fromB" location="file://complex_grafcet.g7#t5" condition="doneB"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="t_merge_to_loop" location="file://complex_grafcet.g7#t6" condition="merged"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t7" name="t_loop_back" location="file://complex_grafcet.g7#t7" condition="moreIterations"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t8" name="t_loop_exit" location="file://complex_grafcet.g7#t8" condition="noMoreIterations"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t9" name="t_to_end" location="file://complex_grafcet.g7#t9" condition="finish"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="c_s0_t0" location="file://complex_grafcet.g7#c0" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="c_s1_t1" location="file://complex_grafcet.g7#c1" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="c_s1_t2" location="file://complex_grafcet.g7#c2" from="/0/@elements.1" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="c_s1_t3" location="file://complex_grafcet.g7#c3" from="/0/@elements.1" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="c_s2_t4" location="file://complex_grafcet.g7#c4" from="/0/@elements.2" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="c_s3_t5" location="file://complex_grafcet.g7#c5" from="/0/@elements.3" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="c_s4_t6" location="file://complex_grafcet.g7#c6" from="/0/@elements.4" to="/0/@elements.13"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="c_s5_t7" location="file://complex_grafcet.g7#c7" from="/0/@elements.5" to="/0/@elements.14"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="c_s5_t8" location="file://complex_grafcet.g7#c8" from="/0/@elements.5" to="/0/@elements.15"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c9" name="c_s4_t9" location="file://complex_grafcet.g7#c9" from="/0/@elements.4" to="/0/@elements.16"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="c_t0_s1" location="file://complex_grafcet.g7#c10" from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="c_t1_s1" location="file://complex_grafcet.g7#c11" from="/0/@elements.8" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="c_t2_s2" location="file://complex_grafcet.g7#c12" from="/0/@elements.9" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="c_t3_s3" location="file://complex_grafcet.g7#c13" from="/0/@elements.10" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c14" name="c_t4_s4" location="file://complex_grafcet.g7#c14" from="/0/@elements.11" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c15" name="c_t5_s4" location="file://complex_grafcet.g7#c15" from="/0/@elements.12" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c16" name="c_t6_s5" location="file://complex_grafcet.g7#c16" from="/0/@elements.13" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c17" name="c_t7_s5" location="file://complex_grafcet.g7#c17" from="/0/@elements.14" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c18" name="c_t8_s6" location="file://complex_grafcet.g7#c18" from="/0/@elements.15" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c19" name="c_t9_s6" location="file://complex_grafcet.g7#c19" from="/0/@elements.16" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
