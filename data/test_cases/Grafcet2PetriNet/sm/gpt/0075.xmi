<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexGrafcet0075" location="file://complexGrafcet0075.grafcet">
    <elements xsi:type="Grafcet:Step" name="InitStep" location="file://complexGrafcet0075.grafcet#InitStep" isInitial="true" isActive="true" action="reset_counters"/>
    <elements xsi:type="Grafcet:Step" name="ParallelStepA" location="file://complexGrafcet0075.grafcet#ParallelStepA" isInitial="false" isActive="false" action="start_motor_A"/>
    <elements xsi:type="Grafcet:Step" name="ParallelStepB" location="file://complexGrafcet0075.grafcet#ParallelStepB" isInitial="false" isActive="false" action="start_motor_B"/>
    <elements xsi:type="Grafcet:Step" name="MergeStep" location="file://complexGrafcet0075.grafcet#MergeStep" isInitial="false" isActive="false" action="check_parallel_completion"/>
    <elements xsi:type="Grafcet:Step" name="LoopBodyStep" location="file://complexGrafcet0075.grafcet#LoopBodyStep" isInitial="false" isActive="false" action="process_item"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="file://complexGrafcet0075.grafcet#FinalStep" isInitial="false" isActive="false" action="shutdown_system"/>
    <elements xsi:type="Grafcet:Transition" name="T_Init_To_ParallelA" location="file://complexGrafcet0075.grafcet#T_Init_To_ParallelA" condition="start_cmd_A"/>
    <elements xsi:type="Grafcet:Transition" name="T_Init_To_ParallelB" location="file://complexGrafcet0075.grafcet#T_Init_To_ParallelB" condition="start_cmd_B"/>
    <elements xsi:type="Grafcet:Transition" name="T_Parallel_To_Merge" location="file://complexGrafcet0075.grafcet#T_Parallel_To_Merge" condition="A_done and B_done"/>
    <elements xsi:type="Grafcet:Transition" name="T_Merge_To_Loop" location="file://complexGrafcet0075.grafcet#T_Merge_To_Loop" condition="items_pending &gt; 0"/>
    <elements xsi:type="Grafcet:Transition" name="T_Loop_Back" location="file://complexGrafcet0075.grafcet#T_Loop_Back" condition="more_items"/>
    <elements xsi:type="Grafcet:Transition" name="T_Loop_To_Final" location="file://complexGrafcet0075.grafcet#T_Loop_To_Final" condition="not more_items"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_to_TA" location="file://complexGrafcet0075.grafcet#C_Init_to_TA" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_to_TB" location="file://complexGrafcet0075.grafcet#C_Init_to_TB" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TA_to_StepA" location="file://complexGrafcet0075.grafcet#C_TA_to_StepA" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TB_to_StepB" location="file://complexGrafcet0075.grafcet#C_TB_to_StepB" from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_StepA_to_TParallel" location="file://complexGrafcet0075.grafcet#C_StepA_to_TParallel" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_StepB_to_TParallel" location="file://complexGrafcet0075.grafcet#C_StepB_to_TParallel" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TParallel_to_Merge" location="file://complexGrafcet0075.grafcet#C_TParallel_to_Merge" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Merge_to_TLoop" location="file://complexGrafcet0075.grafcet#C_Merge_to_TLoop" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TLoop_to_LoopBody" location="file://complexGrafcet0075.grafcet#C_TLoop_to_LoopBody" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_LoopBody_to_TBack" location="file://complexGrafcet0075.grafcet#C_LoopBody_to_TBack" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TBack_to_LoopBody" location="file://complexGrafcet0075.grafcet#C_TBack_to_LoopBody" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_LoopBody_to_TFinal" location="file://complexGrafcet0075.grafcet#C_LoopBody_to_TFinal" from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TFinal_to_FinalStep" location="file://complexGrafcet0075.grafcet#C_TFinal_to_FinalStep" from="/0/@elements.11" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>