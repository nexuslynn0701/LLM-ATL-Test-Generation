<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet0015" location="file://complexGrafcet0015.grafcet">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStep" location="1:1-1:10" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="ParallelStepA" location="2:1-2:15" isInitial="false" isActive="false" action="performTaskA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="ParallelStepB" location="3:1-3:15" isInitial="false" isActive="false" action="performTaskB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="MergeStep" location="4:1-4:12" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.4" name="EndStep" location="5:1-5:9" isInitial="false" isActive="false" action="finalizeProcess"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="T_Init_to_Parallel" location="6:1-6:25" condition="startCommandReceived"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="T_ParallelA_to_Merge" location="7:1-7:27" condition="taskACompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.7" name="T_ParallelB_to_Merge" location="8:1-8:27" condition="taskBCompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.8" name="T_Merge_to_End" location="9:1-9:20" condition="mergeSuccessful"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.9" name="T_Loop_Back" location="10:1-10:18" condition="restartRequested"/>

    <!-- Connections: StepToTransition -->
    <!-- InitStep -> T_Init_to_Parallel -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="C_Init_to_TInitParallel" location="11:1-11:30" grafcet="/0" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- ParallelStepA -> T_ParallelA_to_Merge -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.1" name="C_ParA_to_TParAMerge" location="12:1-12:30" grafcet="/0" from="/0/@elements.1" to="/0/@elements.6"/>
    <!-- ParallelStepB -> T_ParallelB_to_Merge -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.2" name="C_ParB_to_TParBMerge" location="13:1-13:30" grafcet="/0" from="/0/@elements.2" to="/0/@elements.7"/>
    <!-- MergeStep -> T_Merge_to_End -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.3" name="C_Merge_to_TMergeEnd" location="14:1-14:28" grafcet="/0" from="/0/@elements.3" to="/0/@elements.8"/>
    <!-- EndStep -> T_Loop_Back -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.4" name="C_End_to_TLoopBack" location="15:1-15:28" grafcet="/0" from="/0/@elements.4" to="/0/@elements.9"/>

    <!-- Connections: TransitionToStep -->
    <!-- T_Init_to_Parallel -> ParallelStepA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.5" name="C_TInitParallel_to_ParA" location="16:1-16:35" grafcet="/0" from="/0/@elements.5" to="/0/@elements.1"/>
    <!-- T_Init_to_Parallel -> ParallelStepB -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.6" name="C_TInitParallel_to_ParB" location="17:1-17:35" grafcet="/0" from="/0/@elements.5" to="/0/@elements.2"/>
    <!-- T_ParallelA_to_Merge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.7" name="C_TParAMerge_to_Merge" location="18:1-18:33" grafcet="/0" from="/0/@elements.6" to="/0/@elements.3"/>
    <!-- T_ParallelB_to_Merge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.8" name="C_TParBMerge_to_Merge" location="19:1-19:33" grafcet="/0" from="/0/@elements.7" to="/0/@elements.3"/>
    <!-- T_Merge_to_End -> EndStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.9" name="C_TMergeEnd_to_End" location="20:1-20:30" grafcet="/0" from="/0/@elements.8" to="/0/@elements.4"/>
    <!-- T_Loop_Back -> InitStep (loop) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.10" name="C_TLoopBack_to_Init" location="21:1-21:32" grafcet="/0" from="/0/@elements.9" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>