<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexGrafcetTest" location="file://complexGrafcet.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" name="InitStep" location="file://complexGrafcet.grafcet#InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" name="CheckSensors" location="file://complexGrafcet.grafcet#CheckSensors" isInitial="false" isActive="false" action="check_sensors"/>
    <elements xsi:type="Grafcet:Step" name="StartMotor" location="file://complexGrafcet.grafcet#StartMotor" isInitial="false" isActive="false" action="start_motor"/>
    <elements xsi:type="Grafcet:Step" name="MonitorSpeed" location="file://complexGrafcet.grafcet#MonitorSpeed" isInitial="false" isActive="false" action="monitor_speed"/>
    <elements xsi:type="Grafcet:Step" name="StopMotor" location="file://complexGrafcet.grafcet#StopMotor" isInitial="false" isActive="false" action="stop_motor"/>
    <elements xsi:type="Grafcet:Step" name="ErrorHandler" location="file://complexGrafcet.grafcet#ErrorHandler" isInitial="false" isActive="false" action="handle_error"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="file://complexGrafcet.grafcet#FinalStep" isInitial="false" isActive="false" action="shutdown"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" name="T_InitToCheck" location="file://complexGrafcet.grafcet#T_InitToCheck" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" name="T_CheckToStart" location="file://complexGrafcet.grafcet#T_CheckToStart" condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" name="T_CheckToError" location="file://complexGrafcet.grafcet#T_CheckToError" condition="sensors_fault"/>
    <elements xsi:type="Grafcet:Transition" name="T_StartToMonitor" location="file://complexGrafcet.grafcet#T_StartToMonitor" condition="motor_started"/>
    <elements xsi:type="Grafcet:Transition" name="T_MonitorToStop" location="file://complexGrafcet.grafcet#T_MonitorToStop" condition="stop_request"/>
    <elements xsi:type="Grafcet:Transition" name="T_MonitorToError" location="file://complexGrafcet.grafcet#T_MonitorToError" condition="overspeed"/>
    <elements xsi:type="Grafcet:Transition" name="T_StopToFinal" location="file://complexGrafcet.grafcet#T_StopToFinal" condition="motor_stopped"/>
    <elements xsi:type="Grafcet:Transition" name="T_ErrorToFinal" location="file://complexGrafcet.grafcet#T_ErrorToFinal" condition="error_resolved"/>
    <!-- StepToTransition connections -->
    <!-- InitStep -> T_InitToCheck -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_to_TInitToCheck" location="file://complexGrafcet.grafcet#C_Init_to_TInitToCheck" from="/0/@elements.0" to="/0/@elements.7"/>
    <!-- CheckSensors -> T_CheckToStart -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Check_to_TCheckToStart" location="file://complexGrafcet.grafcet#C_Check_to_TCheckToStart" from="/0/@elements.1" to="/0/@elements.8"/>
    <!-- CheckSensors -> T_CheckToError -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Check_to_TCheckToError" location="file://complexGrafcet.grafcet#C_Check_to_TCheckToError" from="/0/@elements.1" to="/0/@elements.9"/>
    <!-- StartMotor -> T_StartToMonitor -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Start_to_TStartToMonitor" location="file://complexGrafcet.grafcet#C_Start_to_TStartToMonitor" from="/0/@elements.2" to="/0/@elements.10"/>
    <!-- MonitorSpeed -> T_MonitorToStop -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Monitor_to_TMonitorToStop" location="file://complexGrafcet.grafcet#C_Monitor_to_TMonitorToStop" from="/0/@elements.3" to="/0/@elements.11"/>
    <!-- MonitorSpeed -> T_MonitorToError -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Monitor_to_TMonitorToError" location="file://complexGrafcet.grafcet#C_Monitor_to_TMonitorToError" from="/0/@elements.3" to="/0/@elements.12"/>
    <!-- StopMotor -> T_StopToFinal -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Stop_to_TStopToFinal" location="file://complexGrafcet.grafcet#C_Stop_to_TStopToFinal" from="/0/@elements.4" to="/0/@elements.13"/>
    <!-- ErrorHandler -> T_ErrorToFinal -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Error_to_TErrorToFinal" location="file://complexGrafcet.grafcet#C_Error_to_TErrorToFinal" from="/0/@elements.5" to="/0/@elements.14"/>
    <!-- TransitionToStep connections -->
    <!-- T_InitToCheck -> CheckSensors -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TInitToCheck_to_Check" location="file://complexGrafcet.grafcet#C_TInitToCheck_to_Check" from="/0/@elements.7" to="/0/@elements.1"/>
    <!-- T_CheckToStart -> StartMotor -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TCheckToStart_to_Start" location="file://complexGrafcet.grafcet#C_TCheckToStart_to_Start" from="/0/@elements.8" to="/0/@elements.2"/>
    <!-- T_CheckToError -> ErrorHandler -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TCheckToError_to_Error" location="file://complexGrafcet.grafcet#C_TCheckToError_to_Error" from="/0/@elements.9" to="/0/@elements.5"/>
    <!-- T_StartToMonitor -> MonitorSpeed -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TStartToMonitor_to_Monitor" location="file://complexGrafcet.grafcet#C_TStartToMonitor_to_Monitor" from="/0/@elements.10" to="/0/@elements.3"/>
    <!-- T_MonitorToStop -> StopMotor -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TMonitorToStop_to_Stop" location="file://complexGrafcet.grafcet#C_TMonitorToStop_to_Stop" from="/0/@elements.11" to="/0/@elements.4"/>
    <!-- T_MonitorToError -> ErrorHandler -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TMonitorToError_to_Error" location="file://complexGrafcet.grafcet#C_TMonitorToError_to_Error" from="/0/@elements.12" to="/0/@elements.5"/>
    <!-- T_StopToFinal -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TStopToFinal_to_Final" location="file://complexGrafcet.grafcet#C_TStopToFinal_to_Final" from="/0/@elements.13" to="/0/@elements.6"/>
    <!-- T_ErrorToFinal -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TErrorToFinal_to_Final" location="file://complexGrafcet.grafcet#C_TErrorToFinal_to_Final" from="/0/@elements.14" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>