<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g1" name="ComplexGrafcetExample" location="file:/model/grafcet_0055.gct">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="CheckSensors" location="2:1-2:25" isInitial="false" isActive="false" action="read_sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="NormalOperation" location="3:1-3:30" isInitial="false" isActive="false" action="run_main_loop"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="ErrorHandling" location="4:1-4:28" isInitial="false" isActive="false" action="handle_error_state"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="Shutdown" location="5:1-5:20" isInitial="false" isActive="false" action="perform_shutdown"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" name="Maintenance" location="6:1-6:24" isInitial="false" isActive="false" action="enter_maintenance_mode"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_InitToCheck" location="10:1-10:30" condition="init_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_CheckToNormal" location="11:1-11:32" condition="sensors_ok &amp; no_alarm"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_CheckToError" location="12:1-12:30" condition="sensor_fault or alarm"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_NormalToShutdown" location="13:1-13:36" condition="shutdown_requested"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_ErrorToShutdown" location="14:1-14:34" condition="critical_error"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="T_ShutdownToInit" location="15:1-15:34" condition="restart_command"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t7" name="T_NormalToMaintenance" location="16:1-16:40" condition="maintenance_requested"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t8" name="T_MaintenanceToNormal" location="17:1-17:40" condition="maintenance_completed"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Init_s1_t1" location="20:1-20:40" grafcet="/0" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Check_s2_t2" location="21:1-21:40" grafcet="/0" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_Check_s2_t3" location="22:1-22:40" grafcet="/0" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_Normal_s3_t4" location="23:1-23:40" grafcet="/0" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_Error_s4_t5" location="24:1-24:40" grafcet="/0" from="/0/@elements.3" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_Shutdown_s5_t6" location="25:1-25:40" grafcet="/0" from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_Normal_s3_t7" location="26:1-26:40" grafcet="/0" from="/0/@elements.2" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="C_Maintenance_s6_t8" location="27:1-27:45" grafcet="/0" from="/0/@elements.5" to="/0/@elements.13"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_t1_s2" location="30:1-30:30" grafcet="/0" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_t2_s3" location="31:1-31:30" grafcet="/0" from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_t3_s4" location="32:1-32:30" grafcet="/0" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_t4_s5" location="33:1-33:30" grafcet="/0" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="C_t5_s5" location="34:1-34:30" grafcet="/0" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c14" name="C_t6_s1" location="35:1-35:30" grafcet="/0" from="/0/@elements.11" to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c15" name="C_t7_s6" location="36:1-36:35" grafcet="/0" from="/0/@elements.12" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c16" name="C_t8_s3" location="37:1-37:35" grafcet="/0" from="/0/@elements.13" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>