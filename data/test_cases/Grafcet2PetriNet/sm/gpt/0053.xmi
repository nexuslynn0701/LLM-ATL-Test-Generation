<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file://grafcets/complexExample.gcf">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="1,1" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="BranchA" location="2,1" isInitial="false" isActive="false" action="executeBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="BranchB" location="2,2" isInitial="false" isActive="false" action="executeBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="MergeStep" location="3,1" isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="LoopStep" location="4,1" isInitial="false" isActive="false" action="loopAction"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="FinalStep" location="5,1" isInitial="false" isActive="false" action="shutdownSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_to_BranchA" location="1.5,1" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Init_to_BranchB" location="1.5,2" condition="alternateStart"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_Branches_to_Merge" location="2.5,1.5" condition="branchesCompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_Merge_to_Loop" location="3.5,1" condition="mergeOk"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_Loop_to_Loop" location="4.5,1" condition="loopCondition"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_Loop_to_Final" location="4.5,1.5" condition="exitLoop"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="c0" grafcet="/0" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Init_to_T1" location="c1" grafcet="/0" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_BranchA_to_T2" location="c2" grafcet="/0" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_BranchB_to_T2" location="c3" grafcet="/0" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_Merge_to_T3" location="c4" grafcet="/0" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_Loop_to_T4" location="c5" grafcet="/0" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_Loop_to_T5" location="c6" grafcet="/0" from="/0/@elements.4" to="/0/@elements.11"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_T0_to_BranchA" location="c7" grafcet="/0" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_T1_to_BranchB" location="c8" grafcet="/0" from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_T2_to_Merge" location="c9" grafcet="/0" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_T3_to_Loop" location="c10" grafcet="/0" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_T4_to_Loop" location="c11" grafcet="/0" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_T5_to_Final" location="c12" grafcet="/0" from="/0/@elements.11" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>