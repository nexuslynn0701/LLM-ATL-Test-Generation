<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="file:/models/complex_grafcet.gcf">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="file:/models/complex_grafcet.gcf#InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckSensors" location="file:/models/complex_grafcet.gcf#CheckSensors" isInitial="false" isActive="false" action="read_sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessData" location="file:/models/complex_grafcet.gcf#ProcessData" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ErrorHandler" location="file:/models/complex_grafcet.gcf#ErrorHandler" isInitial="false" isActive="false" action="handle_error"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="Finalize" location="file:/models/complex_grafcet.gcf#Finalize" isInitial="false" isActive="false" action="finalize_sequence"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="InitToCheck" location="file:/models/complex_grafcet.gcf#InitToCheck" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="CheckToProcess" location="file:/models/complex_grafcet.gcf#CheckToProcess" condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="CheckToError" location="file:/models/complex_grafcet.gcf#CheckToError" condition="sensors_fault"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="ProcessToFinalize" location="file:/models/complex_grafcet.gcf#ProcessToFinalize" condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="ErrorToFinalize" location="file:/models/complex_grafcet.gcf#ErrorToFinalize" condition="error_cleared"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_Check" location="file:/models/complex_grafcet.gcf#C_Init_Check" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="C_CheckSensors" location="file:/models/complex_grafcet.gcf#C_CheckSensors" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Check_Process" location="file:/models/complex_grafcet.gcf#C_Check_Process" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_Check_Error" location="file:/models/complex_grafcet.gcf#C_Check_Error" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="C_ProcessStep" location="file:/models/complex_grafcet.gcf#C_ProcessStep" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_ErrorStep" location="file:/models/complex_grafcet.gcf#C_ErrorStep" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_Process_Finalize" location="file:/models/complex_grafcet.gcf#C_Process_Finalize" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_Error_Finalize" location="file:/models/complex_grafcet.gcf#C_Error_Finalize" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_FinalStepFromProcess" location="file:/models/complex_grafcet.gcf#C_FinalStepFromProcess" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_FinalStepFromError" location="file:/models/complex_grafcet.gcf#C_FinalStepFromError" from="/0/@elements.9" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>