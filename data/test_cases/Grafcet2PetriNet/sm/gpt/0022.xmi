<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet0022" location="file:///grafcets/complex0022.gcf">
    <!-- Elements: 5 Steps + 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="line 1" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckInputs" location="line 5" isInitial="false" isActive="false" action="readSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessA" location="line 9" isInitial="false" isActive="false" action="computePathA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ProcessB" location="line 13" isInitial="false" isActive="false" action="computePathB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="FinalStep" location="line 17" isInitial="false" isActive="false" action="shutdownSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="InitToCheck" location="line 21" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="BranchToAorB" location="line 25" condition="modeAorBSelected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="JoinToFinal" location="line 29" condition="AandBCompleted"/>

    <!-- Connections: sequence, branching, merging, and convergence -->
    <!-- InitStep -> InitToCheck -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="c_Init_to_t0" location="line 33" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- InitToCheck -> CheckInputs -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="c_t0_to_s1" location="line 34" from="/0/@elements.5" to="/0/@elements.1"/>

    <!-- CheckInputs -> BranchToAorB -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="c_s1_to_t1" location="line 35" from="/0/@elements.1" to="/0/@elements.6"/>
    <!-- BranchToAorB -> ProcessA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="c_t1_to_s2" location="line 36" from="/0/@elements.6" to="/0/@elements.2"/>
    <!-- BranchToAorB -> ProcessB -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="c_t1_to_s3" location="line 37" from="/0/@elements.6" to="/0/@elements.3"/>

    <!-- ProcessA -> JoinToFinal -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="c_s2_to_t2" location="line 38" from="/0/@elements.2" to="/0/@elements.7"/>
    <!-- ProcessB -> JoinToFinal -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="c_s3_to_t2" location="line 39" from="/0/@elements.3" to="/0/@elements.7"/>

    <!-- JoinToFinal -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="c_t2_to_s4" location="line 40" from="/0/@elements.7" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>