<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_grafcet0051" name="ComplexGrafcet0051" location="test/location/0051">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_stepA" name="InitStepA" location="loc_stepA" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_stepB" name="ParallelStepB" location="loc_stepB" isInitial="false" isActive="false" action="check_sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_stepC" name="ParallelStepC" location="loc_stepC" isInitial="false" isActive="false" action="log_status"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_stepD" name="MergeStepD" location="loc_stepD" isInitial="false" isActive="false" action="prepare_output"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_stepE" name="FinalStepE" location="loc_stepE" isInitial="false" isActive="false" action="shutdown"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans1" name="T_init_to_parallel" location="loc_trans1" condition="start_cmd"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans2" name="T_to_stepB" location="loc_trans2" condition="branch_B"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans3" name="T_to_stepC" location="loc_trans3" condition="branch_C"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans4" name="T_parallel_to_merge" location="loc_trans4" condition="both_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans5" name="T_merge_to_final" location="loc_trans5" condition="ok_to_shutdown"/>

    <!-- Connections Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_sA_t1" name="C_SA_T1" location="loc_c_sA_t1" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_sA_t2" name="C_SA_T2" location="loc_c_sA_t2" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_sA_t3" name="C_SA_T3" location="loc_c_sA_t3" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_sB_t4" name="C_SB_T4" location="loc_c_sB_t4" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_sC_t4" name="C_SC_T4" location="loc_c_sC_t4" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_sD_t5" name="C_SD_T5" location="loc_c_sD_t5" from="/0/@elements.3" to="/0/@elements.9"/>

    <!-- Connections Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t1_sA" name="C_T1_SA" location="loc_c_t1_sA" from="/0/@elements.5" to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t1_sB" name="C_T1_SB" location="loc_c_t1_sB" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t1_sC" name="C_T1_SC" location="loc_c_t1_sC" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t2_sB" name="C_T2_SB" location="loc_c_t2_sB" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t3_sC" name="C_T3_SC" location="loc_c_t3_sC" from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t4_sD" name="C_T4_SD" location="loc_c_t4_sD" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t5_sE" name="C_T5_SE" location="loc_c_t5_sE" from="/0/@elements.9" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>