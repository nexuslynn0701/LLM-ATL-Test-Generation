<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="model.grafcet">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="model.grafcet#s0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ParallelBranchA" location="model.grafcet#s1" isInitial="false" isActive="false" action="runBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ParallelBranchB" location="model.grafcet#s2" isInitial="false" isActive="false" action="runBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="MergeStep" location="model.grafcet#s3" isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="LoopStep" location="model.grafcet#s4" isInitial="false" isActive="false" action="loopAction"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="FinalStep" location="model.grafcet#s5" isInitial="false" isActive="false" action="finalizeSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="InitToParallel" location="model.grafcet#t0" condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="ToBranchA" location="model.grafcet#t1" condition="selectA"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="ToBranchB" location="model.grafcet#t2" condition="selectB"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="JoinBranches" location="model.grafcet#t3" condition="A_done_and_B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="LoopTransition" location="model.grafcet#t4" condition="loopCondition"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="ToFinal" location="model.grafcet#t5" condition="finish"/>

    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- From InitStep to InitToParallel, then split to BranchA and BranchB -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="Init_to_InitToParallel" location="model.grafcet#c0" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="InitToParallel_to_BranchA" location="model.grafcet#c1" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="InitToParallel_to_BranchB" location="model.grafcet#c2" from="/0/@elements.6" to="/0/@elements.2"/>

    <!-- Additional guarded transitions from InitStep directly to A or B (alternative paths) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="Init_to_ToBranchA" location="model.grafcet#c3" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="ToBranchA_to_BranchA" location="model.grafcet#c4" from="/0/@elements.7" to="/0/@elements.1"/>

    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="Init_to_ToBranchB" location="model.grafcet#c5" from="/0/@elements.0" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="ToBranchB_to_BranchB" location="model.grafcet#c6" from="/0/@elements.8" to="/0/@elements.2"/>

    <!-- BranchA and BranchB both go to JoinBranches transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="BranchA_to_JoinBranches" location="model.grafcet#c7" from="/0/@elements.1" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="BranchB_to_JoinBranches" location="model.grafcet#c8" from="/0/@elements.2" to="/0/@elements.9"/>

    <!-- JoinBranches leads to MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="JoinBranches_to_MergeStep" location="model.grafcet#c9" from="/0/@elements.9" to="/0/@elements.3"/>

    <!-- From MergeStep to LoopTransition, loop back to LoopStep and again to MergeStep -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c10" name="MergeStep_to_LoopTransition" location="model.grafcet#c10" from="/0/@elements.3" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="LoopTransition_to_LoopStep" location="model.grafcet#c11" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c12" name="LoopStep_to_LoopTransition" location="model.grafcet#c12" from="/0/@elements.4" to="/0/@elements.10"/>

    <!-- From MergeStep also to ToFinal, then to FinalStep -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c13" name="MergeStep_to_ToFinal" location="model.grafcet#c13" from="/0/@elements.3" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c14" name="ToFinal_to_FinalStep" location="model.grafcet#c14" from="/0/@elements.11" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>