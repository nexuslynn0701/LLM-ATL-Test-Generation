<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet0024" location="file://complexGrafcet0024.gcf">
    <!-- Elements: 4 steps and 3 transitions with branching and join -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="StartStep" location="1:1-1:10" isInitial="true" isActive="true" action="init_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="BranchStepA" location="2:1-2:15" isInitial="false" isActive="false" action="process_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="BranchStepB" location="3:1-3:15" isInitial="false" isActive="false" action="process_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="JoinStep" location="4:1-4:15" isInitial="false" isActive="false" action="finalize"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="SplitTransition" location="5:1-5:20" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="ToJoinFromA" location="6:1-6:22" condition="A_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="ToJoinFromB" location="7:1-7:22" condition="B_done"/>

    <!-- Connections: one split, two parallel branches joining into one step -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="Start_to_Split" location="8:1-8:25" grafcet="/0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="Split_to_A" location="9:1-9:23" grafcet="/0" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="Split_to_B" location="10:1-10:23" grafcet="/0" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="A_to_JoinTrans" location="11:1-11:27" grafcet="/0" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="B_to_JoinTrans" location="12:1-12:27" grafcet="/0" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="JoinFromA_to_JoinStep" location="13:1-13:32" grafcet="/0" from="/0/@elements.5" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="JoinFromB_to_JoinStep" location="14:1-14:32" grafcet="/0" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>