<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="file://complex.grafcet">
    <!-- Elements: 5 Steps (3 initial, 2 non-initial) and 4 Transitions forming branches, joins, and a loop -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitA" location="1:1-1:10" isInitial="true" isActive="true" action="startA()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="InitB" location="2:1-2:10" isInitial="true" isActive="false" action="startB()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="Middle" location="3:1-3:10" isInitial="false" isActive="false" action="doMiddle()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="Branch1" location="4:1-4:10" isInitial="false" isActive="false" action="branch1()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="End" location="5:1-5:10" isInitial="false" isActive="false" action="finish()"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToMid" location="6:1-6:10" condition="condA_or_B"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_MidToBranch" location="7:1-7:10" condition="splitCond"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_BranchToEnd" location="8:1-8:10" condition="joinCond"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_LoopToMid" location="9:1-9:10" condition="loopBack"/>
    <!-- Connections: branching from two initials to middle, then to two branches, then join and loop -->
    <!-- From initial steps to transition t0 (two incoming StepToTransition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_InitA_T0" location="10:1-10:10" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_InitB_T0" location="11:1-11:10" from="/0/@elements.1" to="/0/@elements.5"/>
    <!-- Transition t0 to step Middle -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="C_T0_Mid" location="12:1-12:10" from="/0/@elements.5" to="/0/@elements.2"/>
    <!-- Middle to transition t1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_Mid_T1" location="13:1-13:10" from="/0/@elements.2" to="/0/@elements.6"/>
    <!-- Transition t1 to two steps: Branch1 and End (parallel branch, one path skips directly to End) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="C_T1_Branch1" location="14:1-14:10" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_T1_End" location="15:1-15:10" from="/0/@elements.6" to="/0/@elements.4"/>
    <!-- Branch1 to transition t2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_Branch1_T2" location="16:1-16:10" from="/0/@elements.3" to="/0/@elements.7"/>
    <!-- End also to transition t2 (join from two steps) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_End_T2" location="17:1-17:10" from="/0/@elements.4" to="/0/@elements.7"/>
    <!-- Transition t2 back to End (self-loop via TransitionToStep) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_T2_End" location="18:1-18:10" from="/0/@elements.7" to="/0/@elements.4"/>
    <!-- Loop from End via t3 back to Middle -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c9" name="C_End_T3" location="19:1-19:10" from="/0/@elements.4" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_T3_Mid" location="20:1-20:10" from="/0/@elements.8" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>