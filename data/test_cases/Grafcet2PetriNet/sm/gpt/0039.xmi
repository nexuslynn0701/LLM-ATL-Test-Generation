<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet0039" location="file:///models/grafcet0039">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="1,1" isInitial="true" isActive="true" action="init_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ParallelStep1" location="2,1" isInitial="false" isActive="false" action="check_sensor_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ParallelStep2" location="2,2" isInitial="false" isActive="false" action="check_sensor_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="MergeStep" location="3,1.5" isInitial="false" isActive="false" action="merge_results"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="LoopStep" location="4,1.5" isInitial="false" isActive="false" action="loop_processing"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="FinalStep" location="5,1.5" isInitial="false" isActive="false" action="shutdown_system"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_To_Parallel" location="1.5,1" condition="start_cmd"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Init_To_Parallel2" location="1.5,2" condition="start_cmd_B"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_Parallel_To_Merge" location="2.5,1.5" condition="A_and_B_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_Merge_To_Loop" location="3.5,1.5" condition="merge_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_Loop_Self" location="4.5,1.5" condition="loop_again"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_Loop_To_Final" location="4.8,1.5" condition="loop_done"/>

    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- From InitStep to two parallel transitions -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="1.25,1" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Init_to_T1" location="1.25,2" from="/0/@elements.0" to="/0/@elements.7"/>

    <!-- From parallel transitions to their steps -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="C_T0_to_S1" location="1.75,1" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="C_T1_to_S2" location="1.75,2" from="/0/@elements.7" to="/0/@elements.2"/>

    <!-- From parallel steps to a single merge transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_S1_to_T2" location="2.25,1.2" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_S2_to_T2" location="2.25,1.8" from="/0/@elements.2" to="/0/@elements.8"/>

    <!-- From merge transition to merge step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="C_T2_to_S3" location="2.75,1.5" from="/0/@elements.8" to="/0/@elements.3"/>

    <!-- From merge step to loop transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_S3_to_T3" location="3.25,1.5" from="/0/@elements.3" to="/0/@elements.9"/>

    <!-- From loop transition to loop step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_T3_to_S4" location="3.75,1.5" from="/0/@elements.9" to="/0/@elements.4"/>

    <!-- Self-loop on LoopStep via T4 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c9" name="C_S4_to_T4" location="4.25,1.6" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_T4_to_S4" location="4.75,1.4" from="/0/@elements.10" to="/0/@elements.4"/>

    <!-- From LoopStep to FinalStep -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c11" name="C_S4_to_T5" location="4.6,1.5" from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_T5_to_S5" location="5.0,1.5" from="/0/@elements.11" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>