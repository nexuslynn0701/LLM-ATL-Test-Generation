<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="file:/models/grafcet/complex_0089.grafcet">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckSensors" location="2:1-2:25" isInitial="false" isActive="false" action="checkAllSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ParallelBranchA" location="3:1-3:28" isInitial="false" isActive="false" action="runBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ParallelBranchB" location="4:1-4:28" isInitial="false" isActive="false" action="runBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="MergeStep" location="5:1-5:22" isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="LoopBody" location="6:1-6:22" isInitial="false" isActive="false" action="executeLoopBody"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" name="FinalStep" location="7:1-7:20" isInitial="false" isActive="false" action="finalizeSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_Check" location="10:1-10:30" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Check_Parallel" location="11:1-11:32" condition="sensorsOk"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_ParallelA_Merge" location="12:1-12:35" condition="branchAComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_ParallelB_Merge" location="13:1-13:35" condition="branchBComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_Merge_Loop" location="14:1-14:30" condition="mergeOk"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_Loop_Reentry" location="15:1-15:32" condition="loopCondition"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="T_Loop_Final" location="16:1-16:30" condition="not loopCondition"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_T0" location="20:1-20:30" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Check_T1" location="21:1-21:30" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Check_T1_BranchA" location="22:1-22:40" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_Check_T1_BranchB" location="23:1-23:40" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_ParallelA_T2" location="24:1-24:32" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_ParallelB_T3" location="25:1-25:32" from="/0/@elements.3" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_Merge_T4" location="26:1-26:30" from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_Loop_T5" location="27:1-27:30" from="/0/@elements.5" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="C_Loop_T6" location="28:1-28:30" from="/0/@elements.5" to="/0/@elements.13"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_T0_Check" location="30:1-30:30" from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_T1_ParallelA" location="31:1-31:32" from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_T1_ParallelB" location="32:1-32:32" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_T2_Merge" location="33:1-33:30" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="C_T3_Merge" location="34:1-34:30" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c14" name="C_T4_Loop" location="35:1-35:30" from="/0/@elements.11" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c15" name="C_T5_LoopBack" location="36:1-36:34" from="/0/@elements.12" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c16" name="C_T6_Final" location="37:1-37:30" from="/0/@elements.13" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>