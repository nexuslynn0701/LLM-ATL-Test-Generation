<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexGrafcet0045" location="file://complex/grafcet0045.grafcet">
    <elements xsi:type="Grafcet:Step" name="InitStep" location="file://complex/grafcet0045.grafcet#InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" name="BranchStepA" location="file://complex/grafcet0045.grafcet#BranchStepA" isInitial="false" isActive="false" action="handle_branch_A"/>
    <elements xsi:type="Grafcet:Step" name="BranchStepB" location="file://complex/grafcet0045.grafcet#BranchStepB" isInitial="false" isActive="false" action="handle_branch_B"/>
    <elements xsi:type="Grafcet:Step" name="MergeStep" location="file://complex/grafcet0045.grafcet#MergeStep" isInitial="false" isActive="false" action="merge_branches"/>
    <elements xsi:type="Grafcet:Step" name="LoopStep" location="file://complex/grafcet0045.grafcet#LoopStep" isInitial="false" isActive="true" action="loop_processing"/>
    <elements xsi:type="Grafcet:Transition" name="T_Init_To_BranchA" location="file://complex/grafcet0045.grafcet#T_Init_To_BranchA" condition="cond_init_A"/>
    <elements xsi:type="Grafcet:Transition" name="T_Init_To_BranchB" location="file://complex/grafcet0045.grafcet#T_Init_To_BranchB" condition="cond_init_B"/>
    <elements xsi:type="Grafcet:Transition" name="T_BranchA_To_Merge" location="file://complex/grafcet0045.grafcet#T_BranchA_To_Merge" condition="cond_A_done"/>
    <elements xsi:type="Grafcet:Transition" name="T_BranchB_To_Merge" location="file://complex/grafcet0045.grafcet#T_BranchB_To_Merge" condition="cond_B_done"/>
    <elements xsi:type="Grafcet:Transition" name="T_Merge_To_Loop" location="file://complex/grafcet0045.grafcet#T_Merge_To_Loop" condition="cond_merge_ok"/>
    <elements xsi:type="Grafcet:Transition" name="T_Loop_Back" location="file://complex/grafcet0045.grafcet#T_Loop_Back" condition="cond_loop_again"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_to_TA" location="file://complex/grafcet0045.grafcet#C_Init_to_TA" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_to_TB" location="file://complex/grafcet0045.grafcet#C_Init_to_TB" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_BranchA_to_T_MergeA" location="file://complex/grafcet0045.grafcet#C_BranchA_to_T_MergeA" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_BranchB_to_T_MergeB" location="file://complex/grafcet0045.grafcet#C_BranchB_to_T_MergeB" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Merge_to_T_Loop" location="file://complex/grafcet0045.grafcet#C_Merge_to_T_Loop" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Loop_to_T_LoopBack" location="file://complex/grafcet0045.grafcet#C_Loop_to_T_LoopBack" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TA_to_BranchA" location="file://complex/grafcet0045.grafcet#C_TA_to_BranchA" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TB_to_BranchB" location="file://complex/grafcet0045.grafcet#C_TB_to_BranchB" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_MergeA_to_Merge" location="file://complex/grafcet0045.grafcet#C_T_MergeA_to_Merge" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_MergeB_to_Merge" location="file://complex/grafcet0045.grafcet#C_T_MergeB_to_Merge" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_Loop_to_LoopStep" location="file://complex/grafcet0045.grafcet#C_T_Loop_to_LoopStep" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_LoopBack_to_BranchA" location="file://complex/grafcet0045.grafcet#C_T_LoopBack_to_BranchA" from="/0/@elements.10" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
