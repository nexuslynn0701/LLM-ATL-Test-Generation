<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file:/models/grafcet_complex_0031.grafcet">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initializeSystem()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ParallelStepA" location="2:1-2:25" isInitial="false" isActive="false" action="runBranchA()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ParallelStepB" location="3:1-3:25" isInitial="false" isActive="false" action="runBranchB()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="MergeStep" location="4:1-4:20" isInitial="false" isActive="false" action="mergeBranches()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="LoopBodyStep" location="5:1-5:25" isInitial="false" isActive="false" action="processLoopBody()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="FinalStep" location="6:1-6:20" isInitial="false" isActive="false" action="finalizeSystem()"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_To_Parallel" location="10:1-10:30" condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_ParallelA_To_Merge" location="11:1-11:35" condition="branchAComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_ParallelB_To_Merge" location="12:1-12:35" condition="branchBComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_Merge_To_Loop" location="13:1-13:30" condition="allBranchesDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_Loop_To_Loop" location="14:1-14:30" condition="!loopExit"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_Loop_To_Final" location="15:1-15:30" condition="loopExit"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="20:1-20:30" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="C_T0_to_S1" location="21:1-21:30" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="C_T0_to_S2" location="22:1-22:30" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_S1_to_T1" location="23:1-23:30" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_S2_to_T2" location="24:1-24:30" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_T1_to_S3" location="25:1-25:30" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="C_T2_to_S3" location="26:1-26:30" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_S3_to_T3" location="27:1-27:30" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_T3_to_S4" location="28:1-28:30" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c9" name="C_S4_to_T4" location="29:1-29:30" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_T4_to_S4" location="30:1-30:30" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c11" name="C_S4_to_T5" location="31:1-31:30" from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_T5_to_S5" location="32:1-32:30" from="/0/@elements.11" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>