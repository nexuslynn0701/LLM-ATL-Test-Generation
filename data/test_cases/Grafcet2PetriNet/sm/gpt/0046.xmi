<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexGrafcet0046" location="file://complex_grafcet_0046.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" name="InitStep" location="loc1" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" name="CheckSensors" location="loc2" isInitial="false" isActive="false" action="readSensors"/>
    <elements xsi:type="Grafcet:Step" name="ProcessData" location="loc3" isInitial="false" isActive="false" action="computeStatistics"/>
    <elements xsi:type="Grafcet:Step" name="SafetyCheck" location="loc4" isInitial="false" isActive="false" action="verifySafetyLimits"/>
    <elements xsi:type="Grafcet:Step" name="ActuateOutputs" location="loc5" isInitial="false" isActive="false" action="updateActuators"/>
    <elements xsi:type="Grafcet:Step" name="ErrorHandler" location="loc6" isInitial="false" isActive="false" action="handleErrorCondition"/>
    <elements xsi:type="Grafcet:Step" name="Finalize" location="loc7" isInitial="false" isActive="false" action="shutdownSequence"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" name="T_InitToCheck" location="loc8" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" name="T_CheckToProcess" location="loc9" condition="sensorsOK"/>
    <elements xsi:type="Grafcet:Transition" name="T_ProcessToSafety" location="loc10" condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition" name="T_SafetyToActuate" location="loc11" condition="safetyOK"/>
    <elements xsi:type="Grafcet:Transition" name="T_ActuateToFinalize" location="loc12" condition="outputsUpdated"/>
    <elements xsi:type="Grafcet:Transition" name="T_ProcessToError" location="loc13" condition="processingError"/>
    <elements xsi:type="Grafcet:Transition" name="T_SafetyToError" location="loc14" condition="safetyViolation"/>
    <elements xsi:type="Grafcet:Transition" name="T_ErrorToFinalize" location="loc15" condition="errorCleared"/>
    <elements xsi:type="Grafcet:Transition" name="T_FinalizeToInit" location="loc16" condition="restartRequested"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_to_T1" location="connLoc1" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Check_to_T2" location="connLoc2" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Process_to_T3" location="connLoc3" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Safety_to_T4" location="connLoc4" from="/0/@elements.3" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Actuate_to_T5" location="connLoc5" from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Process_to_T6" location="connLoc6" from="/0/@elements.2" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Safety_to_T7" location="connLoc7" from="/0/@elements.3" to="/0/@elements.13"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Error_to_T8" location="connLoc8" from="/0/@elements.5" to="/0/@elements.14"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Finalize_to_T9" location="connLoc9" from="/0/@elements.6" to="/0/@elements.15"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T1_to_Check" location="connLoc10" from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T2_to_Process" location="connLoc11" from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T3_to_Safety" location="connLoc12" from="/0/@elements.9" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T4_to_Actuate" location="connLoc13" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T5_to_Finalize" location="connLoc14" from="/0/@elements.11" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T6_to_Error" location="connLoc15" from="/0/@elements.12" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T7_to_Error" location="connLoc16" from="/0/@elements.13" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T8_to_Finalize" location="connLoc17" from="/0/@elements.14" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T9_to_Init" location="connLoc18" from="/0/@elements.15" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>