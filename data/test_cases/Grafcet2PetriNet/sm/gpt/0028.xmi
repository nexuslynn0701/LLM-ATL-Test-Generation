<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="g1" name="ComplexGrafcet" location="loc_grafcet_root">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="s1" name="InitStep" location="loc_step_s1" isInitial="true" isActive="true" action="initSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s2" name="CheckSensors" location="loc_step_s2" isInitial="false" isActive="false" action="checkSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s3" name="ParallelBranchA" location="loc_step_s3" isInitial="false" isActive="false" action="runBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s4" name="ParallelBranchB" location="loc_step_s4" isInitial="false" isActive="false" action="runBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s5" name="JoinBranches" location="loc_step_s5" isInitial="false" isActive="false" action="joinAndValidate"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s6" name="LoopBody" location="loc_step_s6" isInitial="false" isActive="false" action="iterateLoop"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s7" name="FinalStep" location="loc_step_s7" isInitial="false" isActive="false" action="shutdownSystem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="t1" name="T_Init_To_Check" location="loc_trans_t1" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t2" name="T_Check_To_Fork" location="loc_trans_t2" condition="sensorsOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t3" name="T_Fork_To_A" location="loc_trans_t3" condition="branchAEnabled"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t4" name="T_Fork_To_B" location="loc_trans_t4" condition="branchBEnabled"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t5" name="T_A_To_Join" location="loc_trans_t5" condition="branchACompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t6" name="T_B_To_Join" location="loc_trans_t6" condition="branchBCompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t7" name="T_Join_To_Loop" location="loc_trans_t7" condition="validationOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t8" name="T_Loop_Back" location="loc_trans_t8" condition="repeatLoop"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t9" name="T_Loop_To_Final" location="loc_trans_t9" condition="loopDone"/>

    <!-- StepToTransition Connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c1" name="C_s1_t1" location="loc_conn_c1" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c2" name="C_s2_t2" location="loc_conn_c2" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c3" name="C_s2_t3" location="loc_conn_c3" from="/0/@elements.1" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c4" name="C_s2_t4" location="loc_conn_c4" from="/0/@elements.1" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c5" name="C_s3_t5" location="loc_conn_c5" from="/0/@elements.2" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c6" name="C_s4_t6" location="loc_conn_c6" from="/0/@elements.3" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c7" name="C_s5_t7" location="loc_conn_c7" from="/0/@elements.4" to="/0/@elements.13"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c8" name="C_s6_t8" location="loc_conn_c8" from="/0/@elements.5" to="/0/@elements.14"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c9" name="C_s6_t9" location="loc_conn_c9" from="/0/@elements.5" to="/0/@elements.15"/>

    <!-- TransitionToStep Connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c10" name="C_t1_s2" location="loc_conn_c10" from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c11" name="C_t2_s5" location="loc_conn_c11" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c12" name="C_t3_s3" location="loc_conn_c12" from="/0/@elements.9" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c13" name="C_t4_s4" location="loc_conn_c13" from="/0/@elements.10" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c14" name="C_t5_s5" location="loc_conn_c14" from="/0/@elements.11" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c15" name="C_t6_s5" location="loc_conn_c15" from="/0/@elements.12" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c16" name="C_t7_s6" location="loc_conn_c16" from="/0/@elements.13" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c17" name="C_t8_s6" location="loc_conn_c17" from="/0/@elements.14" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c18" name="C_t9_s7" location="loc_conn_c18" from="/0/@elements.15" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>