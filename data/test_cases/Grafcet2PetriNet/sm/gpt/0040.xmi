<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="g1" name="ComplexGrafcet0040" location="loc_g1">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="s1" name="InitStep" location="loc_s1" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s2" name="ParallelBranchA" location="loc_s2" isInitial="false" isActive="false" action="run_branch_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s3" name="ParallelBranchB" location="loc_s3" isInitial="false" isActive="false" action="run_branch_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s4" name="MergeStep" location="loc_s4" isInitial="false" isActive="false" action="merge_parallel"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s5" name="FinalStep" location="loc_s5" isInitial="false" isActive="false" action="shutdown_system"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="t1" name="T_Init_To_Parallel" location="loc_t1" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t2" name="T_A_To_Merge" location="loc_t2" condition="branch_A_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t3" name="T_B_To_Merge" location="loc_t3" condition="branch_B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t4" name="T_Merge_To_Final" location="loc_t4" condition="all_branches_done"/>

    <!-- Connections -->
    <!-- From initial step to first transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c1" name="C_Init_to_T1" location="loc_c1" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- From first transition to two parallel steps -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c2" name="C_T1_to_A" location="loc_c2" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c3" name="C_T1_to_B" location="loc_c3" from="/0/@elements.5" to="/0/@elements.2"/>

    <!-- From branch A/B steps to their transitions -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c4" name="C_A_to_T2" location="loc_c4" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c5" name="C_B_to_T3" location="loc_c5" from="/0/@elements.2" to="/0/@elements.7"/>

    <!-- From branch transitions to merge step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c6" name="C_T2_to_Merge" location="loc_c6" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c7" name="C_T3_to_Merge" location="loc_c7" from="/0/@elements.7" to="/0/@elements.3"/>

    <!-- From merge step to final transition, and then to final step -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c8" name="C_Merge_to_T4" location="loc_c8" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c9" name="C_T4_to_Final" location="loc_c9" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>