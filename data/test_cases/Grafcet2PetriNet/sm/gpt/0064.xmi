<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexGrafcet_0064" location="file://complex_grafcet_0064.grafcet">
    <!-- Elements: 5 Steps (including two initial), 4 Transitions -->
    <elements xsi:type="Grafcet:Step" name="InitStepA" location="0:0-0:5" isInitial="true" isActive="true" action="initializeA"/>
    <elements xsi:type="Grafcet:Step" name="InitStepB" location="1:0-1:5" isInitial="true" isActive="false" action="initializeB"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="2:0-2:5" isInitial="false" isActive="false" action="computeMiddle"/>
    <elements xsi:type="Grafcet:Step" name="ParallelStep" location="3:0-3:5" isInitial="false" isActive="true" action="handleParallel"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="4:0-4:5" isInitial="false" isActive="false" action="finalizeSystem"/>
    <elements xsi:type="Grafcet:Transition" name="T1_JoinInitials" location="5:0-5:5" condition="condAandB"/>
    <elements xsi:type="Grafcet:Transition" name="T2_Split" location="6:0-6:5" condition="condSplit"/>
    <elements xsi:type="Grafcet:Transition" name="T3_LoopMiddle" location="7:0-7:5" condition="condLoop"/>
    <elements xsi:type="Grafcet:Transition" name="T4_ToFinal" location="8:0-8:5" condition="condToFinal"/>
    <!-- Connections: mix of 1-to-1, many-to-1, 1-to-many, and loop -->
    <!-- From both initial steps to T1 (many Steps -> one Transition) -->
    <connections xsi:type="Grafcet:StepToTransition" name="C1_InitA_to_T1" location="9:0-9:5" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C2_InitB_to_T1" location="10:0-10:5" from="/0/@elements.1" to="/0/@elements.5"/>
    <!-- From T1 to MiddleStep -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C3_T1_to_Middle" location="11:0-11:5" from="/0/@elements.5" to="/0/@elements.2"/>
    <!-- From MiddleStep to T2 and T3 (one Step -> two Transitions) -->
    <connections xsi:type="Grafcet:StepToTransition" name="C4_Middle_to_T2" location="12:0-12:5" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C5_Middle_to_T3" location="13:0-13:5" from="/0/@elements.2" to="/0/@elements.7"/>
    <!-- From T2 to MiddleStep and ParallelStep (one Transition -> two Steps) -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C6_T2_to_Middle" location="14:0-14:5" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C7_T2_to_Parallel" location="15:0-15:5" from="/0/@elements.6" to="/0/@elements.3"/>
    <!-- Loop connection: T3 back to MiddleStep -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C8_T3_to_MiddleLoop" location="16:0-16:5" from="/0/@elements.7" to="/0/@elements.2"/>
    <!-- From ParallelStep to T4, then to FinalStep -->
    <connections xsi:type="Grafcet:StepToTransition" name="C9_Parallel_to_T4" location="17:0-17:5" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C10_T4_to_Final" location="18:0-18:5" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>