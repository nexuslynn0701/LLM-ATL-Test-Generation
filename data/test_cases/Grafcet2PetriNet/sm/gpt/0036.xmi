<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexCycleGrafcet" location="loc_grafcet_0036">
    <elements xsi:type="Grafcet:Step" name="InitStep" location="loc_step_0" isInitial="true" isActive="true" action="initialize_system()"/>
    <elements xsi:type="Grafcet:Step" name="CheckSensors" location="loc_step_1" isInitial="false" isActive="false" action="check_sensors()"/>
    <elements xsi:type="Grafcet:Step" name="ProcessData" location="loc_step_2" isInitial="false" isActive="false" action="process_data()"/>
    <elements xsi:type="Grafcet:Step" name="ErrorHandler" location="loc_step_3" isInitial="false" isActive="false" action="handle_error()"/>
    <elements xsi:type="Grafcet:Step" name="Finalize" location="loc_step_4" isInitial="false" isActive="false" action="finalize_system()"/>
    <elements xsi:type="Grafcet:Transition" name="T_InitToCheck" location="loc_trans_0" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" name="T_CheckToProcess" location="loc_trans_1" condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" name="T_ProcessToCheck" location="loc_trans_2" condition="more_data"/>
    <elements xsi:type="Grafcet:Transition" name="T_ProcessToFinalize" location="loc_trans_3" condition="no_more_data"/>
    <elements xsi:type="Grafcet:Transition" name="T_CheckToError" location="loc_trans_4" condition="sensor_failure"/>
    <elements xsi:type="Grafcet:Transition" name="T_ErrorToFinalize" location="loc_trans_5" condition="error_resolved"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_to_T0" location="loc_conn_0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T0_to_Check" location="loc_conn_1" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Check_to_T1" location="loc_conn_2" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T1_to_Process" location="loc_conn_3" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Process_to_T2" location="loc_conn_4" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T2_to_Check" location="loc_conn_5" from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Process_to_T3" location="loc_conn_6" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T3_to_Finalize" location="loc_conn_7" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Check_to_T4" location="loc_conn_8" from="/0/@elements.1" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T4_to_Error" location="loc_conn_9" from="/0/@elements.9" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Error_to_T5" location="loc_conn_10" from="/0/@elements.3" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T5_to_Finalize" location="loc_conn_11" from="/0/@elements.10" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>