<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet" location="file://complexGrafcet.grafcet">
    <!-- Elements: 5 Steps + 3 Transitions (= 8 elements) -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initSystem()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="ParallelStepA" location="2:1-2:25" isInitial="false" isActive="false" action="runBranchA()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ParallelStepB" location="3:1-3:25" isInitial="false" isActive="false" action="runBranchB()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="MergeStep" location="4:1-4:20" isInitial="false" isActive="false" action="mergeBranches()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="FinalStep" location="5:1-5:20" isInitial="false" isActive="false" action="shutdown()"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_Init_to_Parallel" location="10:1-10:30" condition="startCommand"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_Parallel_to_Merge" location="11:1-11:30" condition="A_done and B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_Merge_to_Final" location="12:1-12:30" condition="ackReceived"/>

    <!-- Connections: 4 StepToTransition + 3 TransitionToStep (= 7 connections) -->
    <!-- InitStep -> T_Init_to_Parallel -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_Init_to_T0" location="20:1-20:30" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- T_Init_to_Parallel -> ParallelStepA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="C_T0_to_A" location="21:1-21:30" from="/0/@elements.5" to="/0/@elements.1"/>
    <!-- T_Init_to_Parallel -> ParallelStepB -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C2" name="C_T0_to_B" location="22:1-22:30" from="/0/@elements.5" to="/0/@elements.2"/>

    <!-- ParallelStepA -> T_Parallel_to_Merge -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="C_A_to_T1" location="23:1-23:30" from="/0/@elements.1" to="/0/@elements.6"/>
    <!-- ParallelStepB -> T_Parallel_to_Merge -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_B_to_T1" location="24:1-24:30" from="/0/@elements.2" to="/0/@elements.6"/>

    <!-- T_Parallel_to_Merge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="C_T1_to_Merge" location="25:1-25:30" from="/0/@elements.6" to="/0/@elements.3"/>

    <!-- MergeStep -> T_Merge_to_Final -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" name="C_Merge_to_T2" location="26:1-26:30" from="/0/@elements.3" to="/0/@elements.7"/>
    <!-- T_Merge_to_Final -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="C_T2_to_Final" location="27:1-27:30" from="/0/@elements.7" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>