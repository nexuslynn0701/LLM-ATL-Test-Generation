<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="G_MultiBranchCycle" location="file:/models/grafcet_multi_branch_cycle.grafcet">
    <!-- Elements: 5 Steps + 3 Transitions = 8 elements -->
    <elements xsi:type="Grafcet:Step" name="S_Start" location="1:1-1:20" isInitial="true" isActive="true" action="initSystem"/>
    <elements xsi:type="Grafcet:Step" name="S_BranchA1" location="2:1-2:25" isInitial="false" isActive="false" action="doBranchA1"/>
    <elements xsi:type="Grafcet:Step" name="S_BranchA2" location="3:1-3:25" isInitial="false" isActive="false" action="doBranchA2"/>
    <elements xsi:type="Grafcet:Step" name="S_BranchB" location="4:1-4:25" isInitial="false" isActive="false" action="doBranchB"/>
    <elements xsi:type="Grafcet:Step" name="S_JoinAndLoop" location="5:1-5:30" isInitial="false" isActive="false" action="joinAndLoop"/>
    <elements xsi:type="Grafcet:Transition" name="T_Split" location="6:1-6:25" condition="sensorReady"/>
    <elements xsi:type="Grafcet:Transition" name="T_InnerA" location="7:1-7:25" condition="subConditionA"/>
    <elements xsi:type="Grafcet:Transition" name="T_JoinLoop" location="8:1-8:30" condition="allDone"/>

    <!-- Connections: indexes correspond to element positions above (0..7) -->
    <!-- 0: S_Start, 1: S_BranchA1, 2: S_BranchA2, 3: S_BranchB, 4: S_JoinAndLoop, 5: T_Split, 6: T_InnerA, 7: T_JoinLoop -->

    <!-- From initial step to split transition -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_S_Start_to_T_Split" location="9:1-9:40"
                 from="/0/@elements.0" to="/0/@elements.5"/>

    <!-- Split into two parallel branches: A1 and B -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_Split_to_S_BranchA1" location="10:1-10:45"
                 from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_Split_to_S_BranchB" location="11:1-11:45"
                 from="/0/@elements.5" to="/0/@elements.3"/>

    <!-- Inner transition inside branch A: from A1 to A2 -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_S_BranchA1_to_T_InnerA" location="12:1-12:50"
                 from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_InnerA_to_S_BranchA2" location="13:1-13:50"
                 from="/0/@elements.6" to="/0/@elements.2"/>

    <!-- Join A2 and B into JoinAndLoop step via a common transition -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_S_BranchA2_to_T_JoinLoop" location="14:1-14:55"
                 from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_S_BranchB_to_T_JoinLoop" location="15:1-15:55"
                 from="/0/@elements.3" to="/0/@elements.7"/>

    <!-- From join step back to start, creating a loop -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_JoinLoop_to_S_JoinAndLoop" location="16:1-16:55"
                 from="/0/@elements.7" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_S_JoinAndLoop_to_T_Split" location="17:1-17:55"
                 from="/0/@elements.4" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>