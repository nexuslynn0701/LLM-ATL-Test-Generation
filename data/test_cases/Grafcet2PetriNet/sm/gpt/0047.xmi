    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="Shutdown" location="file://complex_grafcet_0047#S4" isInitial="false" isActive="false" action="performShutdown"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="InitToCheck" location="file://complex_grafcet_0047#T0" condition="initComplete"/>
