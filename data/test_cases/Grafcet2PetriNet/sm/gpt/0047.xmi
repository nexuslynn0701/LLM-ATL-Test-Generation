    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C5" name="C_S3_to_T5" location="file://complex_grafcet_0047#C5" from="/0/@elements.3" to="/0/@elements.10"/>

    <!-- Connections: TransitionToStep -->
