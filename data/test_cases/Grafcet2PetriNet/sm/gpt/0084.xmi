<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexGrafcetExample" location="file:/models/grafcet_complex_0084.gcf">
    <elements xsi:type="Grafcet:Step" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" name="ParallelStepA" location="2:1-2:25" isInitial="false" isActive="false" action="run_subprocess_A"/>
    <elements xsi:type="Grafcet:Step" name="ParallelStepB" location="3:1-3:25" isInitial="false" isActive="false" action="run_subprocess_B"/>
    <elements xsi:type="Grafcet:Step" name="MergeStep" location="4:1-4:20" isInitial="false" isActive="false" action="merge_results"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="5:1-5:18" isInitial="false" isActive="false" action="shutdown_system"/>
    <elements xsi:type="Grafcet:Transition" name="T_Init_To_Parallel" location="6:1-6:35" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" name="T_ParallelA_To_Merge" location="7:1-7:40" condition="subprocess_A_done"/>
    <elements xsi:type="Grafcet:Transition" name="T_ParallelB_To_Merge" location="8:1-8:40" condition="subprocess_B_done"/>
    <elements xsi:type="Grafcet:Transition" name="T_Merge_To_Final" location="9:1-9:30" condition="all_results_collected"/>
    <elements xsi:type="Grafcet:Transition" name="T_Final_Loopback" location="10:1-10:35" condition="restart_requested"/>

    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_to_TParallel" location="11:1-11:40" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TParallel_to_ParA" location="12:1-12:40" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TParallel_to_ParB" location="13:1-13:40" from="/0/@elements.5" to="/0/@elements.2"/>

    <connections xsi:type="Grafcet:StepToTransition" name="C_ParA_to_TMergeA" location="14:1-14:40" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_ParB_to_TMergeB" location="15:1-15:40" from="/0/@elements.2" to="/0/@elements.7"/>

    <connections xsi:type="Grafcet:TransitionToStep" name="C_TMergeA_to_Merge" location="16:1-16:40" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TMergeB_to_Merge" location="17:1-17:40" from="/0/@elements.7" to="/0/@elements.3"/>

    <connections xsi:type="Grafcet:StepToTransition" name="C_Merge_to_TFinal" location="18:1-18:35" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TFinal_to_Final" location="19:1-19:35" from="/0/@elements.8" to="/0/@elements.4"/>

    <connections xsi:type="Grafcet:StepToTransition" name="C_Final_to_TLoopback" location="20:1-20:40" from="/0/@elements.4" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TLoopback_to_Init" location="21:1-21:40" from="/0/@elements.9" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>