<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexBranchingGrafcet" location="file://grafcets/complexBranching.grafcet">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="1,1" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ParallelStepA" location="2,1" isInitial="false" isActive="false" action="runBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ParallelStepB" location="2,2" isInitial="false" isActive="false" action="runBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="JoinStep" location="3,1" isInitial="false" isActive="false" action="joinBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="LoopStep" location="4,1" isInitial="false" isActive="false" action="loopProcessing"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="FinalStep" location="5,1" isInitial="false" isActive="false" action="shutdownSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_to_Parallel" location="1.5,1" condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_ParallelA_to_Join" location="2.5,1" condition="branchAComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_ParallelB_to_Join" location="2.5,2" condition="branchBComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_Join_to_Loop" location="3.5,1" condition="joinedOk"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_Loop_to_Loop" location="4.5,1" condition="moreWork"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_Loop_to_Final" location="4.5,2" condition="noMoreWork"/>

    <!-- Connections: StepToTransition -->
    <!-- InitStep -> T_Init_to_Parallel -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="C_Init_to_T0"
                 location="1.2,1"
                 from="/0/@elements.0"
                 to="/0/@elements.6"/>
    <!-- ParallelStepA -> T_ParallelA_to_Join -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="C_A_to_T1"
                 location="2.2,1"
                 from="/0/@elements.1"
                 to="/0/@elements.7"/>
    <!-- ParallelStepB -> T_ParallelB_to_Join -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="C_B_to_T2"
                 location="2.2,2"
                 from="/0/@elements.2"
                 to="/0/@elements.8"/>
    <!-- JoinStep -> T_Join_to_Loop -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 name="C_Join_to_T3"
                 location="3.2,1"
                 from="/0/@elements.3"
                 to="/0/@elements.9"/>
    <!-- LoopStep -> T_Loop_to_Loop -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c4"
                 name="C_Loop_to_T4"
                 location="4.2,1"
                 from="/0/@elements.4"
                 to="/0/@elements.10"/>
    <!-- LoopStep -> T_Loop_to_Final -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c5"
                 name="C_Loop_to_T5"
                 location="4.2,2"
                 from="/0/@elements.4"
                 to="/0/@elements.11"/>

    <!-- Connections: TransitionToStep -->
    <!-- T_Init_to_Parallel -> ParallelStepA (branch A) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 name="C_T0_to_A"
                 location="1.8,1"
                 from="/0/@elements.6"
                 to="/0/@elements.1"/>
    <!-- T_Init_to_Parallel -> ParallelStepB (branch B) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 name="C_T0_to_B"
                 location="1.8,2"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>
    <!-- T_ParallelA_to_Join -> JoinStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c8"
                 name="C_T1_to_Join"
                 location="2.8,1"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
    <!-- T_ParallelB_to_Join -> JoinStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c9"
                 name="C_T2_to_Join"
                 location="2.8,2"
                 from="/0/@elements.8"
                 to="/0/@elements.3"/>
    <!-- T_Join_to_Loop -> LoopStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c10"
                 name="C_T3_to_Loop"
                 location="3.8,1"
                 from="/0/@elements.9"
                 to="/0/@elements.4"/>
    <!-- T_Loop_to_Loop -> LoopStep (self-loop) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c11"
                 name="C_T4_to_Loop"
                 location="4.8,1"
                 from="/0/@elements.10"
                 to="/0/@elements.4"/>
    <!-- T_Loop_to_Final -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c12"
                 name="C_T5_to_Final"
                 location="4.8,2"
                 from="/0/@elements.11"
                 to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>