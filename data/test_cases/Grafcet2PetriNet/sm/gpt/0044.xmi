<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexGrafcet0044" location="file://complex/grafcet0044.grafcet">
    <!-- Elements: 4 Steps (2 initial) and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" name="S_Init1" location="1:1-1:10" isInitial="true" isActive="true" action="start_motor"/>
    <elements xsi:type="Grafcet:Step" name="S_Init2" location="2:1-2:10" isInitial="true" isActive="false" action="prepare_system"/>
    <elements xsi:type="Grafcet:Step" name="S_Work" location="3:1-3:10" isInitial="false" isActive="false" action="run_cycle"/>
    <elements xsi:type="Grafcet:Step" name="S_End" location="4:1-4:10" isInitial="false" isActive="false" action="shutdown"/>
    <elements xsi:type="Grafcet:Transition" name="T_FromInit1ToWork" location="5:1-5:10" condition="sensorA &gt; 0"/>
    <elements xsi:type="Grafcet:Transition" name="T_FromInit2ToWork" location="6:1-6:10" condition="sensorB = true"/>
    <elements xsi:type="Grafcet:Transition" name="T_FromWorkToEnd" location="7:1-7:10" condition="cycle_complete"/>
    <!-- Connections: parallel paths merging on S_Work, then to S_End -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_SInit1_TInit1" location="10:1-10:10" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TInit1_SWork" location="11:1-11:10" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_SInit2_TInit2" location="12:1-12:10" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TInit2_SWork" location="13:1-13:10" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_SWork_TWorkEnd" location="14:1-14:10" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TWorkEnd_SEnd" location="15:1-15:10" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>