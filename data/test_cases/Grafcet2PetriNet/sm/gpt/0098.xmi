<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet0098" location="file://complexGrafcet0098.grafcet">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="1,1" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="ParallelStepA" location="2,1" isInitial="false" isActive="false" action="executeBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ParallelStepB" location="2,2" isInitial="false" isActive="false" action="executeBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="MergeStep" location="3,1" isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="LoopStep" location="4,1" isInitial="false" isActive="false" action="loopBody"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S5" name="FinalStep" location="5,1" isInitial="false" isActive="false" action="terminateSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_Init_To_Parallel" location="1.5,1" condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_Parallel_To_Merge_A" location="2.5,1" condition="branchA_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_Parallel_To_Merge_B" location="2.5,2" condition="branchB_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="T_Merge_To_Loop" location="3.5,1" condition="bothBranchesDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" name="T_Loop_Self" location="4.5,1" condition="loopCondition"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T5" name="T_Loop_To_Final" location="4.7,1" condition="exitLoop"/>

    <!-- Connections: StepToTransition -->
    <!-- From InitStep to first transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C_ST_0" name="C_Init_to_T0" location="1.2,1"
                 grafcet="/0"
                 from="/0/@elements.0"
                 to="/0/@elements.6"/>
    <!-- From ParallelStepA to its join transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C_ST_1" name="C_S1_to_T1" location="2.2,1"
                 grafcet="/0"
                 from="/0/@elements.1"
                 to="/0/@elements.7"/>
    <!-- From ParallelStepB to its join transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C_ST_2" name="C_S2_to_T2" location="2.2,2"
                 grafcet="/0"
                 from="/0/@elements.2"
                 to="/0/@elements.8"/>
    <!-- From MergeStep to transition to LoopStep -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C_ST_3" name="C_S3_to_T3" location="3.2,1"
                 grafcet="/0"
                 from="/0/@elements.3"
                 to="/0/@elements.9"/>
    <!-- From LoopStep to self-loop transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C_ST_4" name="C_S4_to_T4" location="4.2,1"
                 grafcet="/0"
                 from="/0/@elements.4"
                 to="/0/@elements.10"/>
    <!-- From LoopStep to transition leading to FinalStep -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C_ST_5" name="C_S4_to_T5" location="4.3,1"
                 grafcet="/0"
                 from="/0/@elements.4"
                 to="/0/@elements.11"/>

    <!-- Connections: TransitionToStep -->
    <!-- From first transition to two parallel steps -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C_TS_0" name="C_T0_to_S1" location="1.8,1"
                 grafcet="/0"
                 from="/0/@elements.6"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C_TS_1" name="C_T0_to_S2" location="1.8,2"
                 grafcet="/0"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>
    <!-- From parallel-join transitions to MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C_TS_2" name="C_T1_to_S3" location="2.8,1"
                 grafcet="/0"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C_TS_3" name="C_T2_to_S3" location="2.8,2"
                 grafcet="/0"
                 from="/0/@elements.8"
                 to="/0/@elements.3"/>
    <!-- From MergeStep transition to LoopStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C_TS_4" name="C_T3_to_S4" location="3.8,1"
                 grafcet="/0"
                 from="/0/@elements.9"
                 to="/0/@elements.4"/>
    <!-- Self-loop on LoopStep via T4 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C_TS_5" name="C_T4_to_S4" location="4.8,1"
                 grafcet="/0"
                 from="/0/@elements.10"
                 to="/0/@elements.4"/>
    <!-- From loop exit transition to FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C_TS_6" name="C_T5_to_S5" location="4.9,1"
                 grafcet="/0"
                 from="/0/@elements.11"
                 to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>