<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexGrafcet0043" location="model/grafcet_0043.gra">
    <!-- Elements: 4 Steps, 3 Transitions (one initial branch that rejoins, plus a self-loop) -->
    <elements xsi:type="Grafcet:Step" name="StartStep" location="model/grafcet_0043.gra#StartStep" isInitial="true" isActive="true" action="initSystem()"/>
    <elements xsi:type="Grafcet:Transition" name="T_StartToBranch" location="model/grafcet_0043.gra#T_StartToBranch" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Step" name="BranchA" location="model/grafcet_0043.gra#BranchA" isInitial="false" isActive="false" action="executeBranchA()"/>
    <elements xsi:type="Grafcet:Step" name="BranchB" location="model/grafcet_0043.gra#BranchB" isInitial="false" isActive="false" action="executeBranchB()"/>
    <elements xsi:type="Grafcet:Transition" name="T_BranchAToJoin" location="model/grafcet_0043.gra#T_BranchAToJoin" condition="branchACompleted"/>
    <elements xsi:type="Grafcet:Transition" name="T_BranchBToJoin" location="model/grafcet_0043.gra#T_BranchBToJoin" condition="branchBCompleted"/>
    <elements xsi:type="Grafcet:Step" name="JoinStep" location="model/grafcet_0043.gra#JoinStep" isInitial="false" isActive="false" action="finalizeProcess()"/>
    <!-- Connections -->
    <!-- StartStep -> T_StartToBranch -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Start_to_TStart" location="model/grafcet_0043.gra#C_Start_to_TStart" from="/0/@elements.0" to="/0/@elements.1"/>
    <!-- T_StartToBranch -> BranchA -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TStart_to_BranchA" location="model/grafcet_0043.gra#C_TStart_to_BranchA" from="/0/@elements.1" to="/0/@elements.2"/>
    <!-- T_StartToBranch -> BranchB -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TStart_to_BranchB" location="model/grafcet_0043.gra#C_TStart_to_BranchB" from="/0/@elements.1" to="/0/@elements.3"/>
    <!-- BranchA -> T_BranchAToJoin -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_BranchA_to_TAJoin" location="model/grafcet_0043.gra#C_BranchA_to_TAJoin" from="/0/@elements.2" to="/0/@elements.4"/>
    <!-- BranchB -> T_BranchBToJoin -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_BranchB_to_TBJoin" location="model/grafcet_0043.gra#C_BranchB_to_TBJoin" from="/0/@elements.3" to="/0/@elements.5"/>
    <!-- T_BranchAToJoin -> JoinStep -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TAJoin_to_Join" location="model/grafcet_0043.gra#C_TAJoin_to_Join" from="/0/@elements.4" to="/0/@elements.6"/>
    <!-- T_BranchBToJoin -> JoinStep (two incoming transitions to JoinStep) -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TBJoin_to_Join" location="model/grafcet_0043.gra#C_TBJoin_to_Join" from="/0/@elements.5" to="/0/@elements.6"/>
    <!-- Self loop on JoinStep via T_BranchAToJoin to exercise multiple connections reuse -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Join_to_TAJoin" location="model/grafcet_0043.gra#C_Join_to_TAJoin" from="/0/@elements.6" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>