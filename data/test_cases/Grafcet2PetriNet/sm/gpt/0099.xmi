<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexCycleGrafcet" location="file://grafcets/complex_cycle_0099.gcf">
    <!-- Elements: 4 Steps + 3 Transitions, interleaved -->
    <elements xsi:type="Grafcet:Step" name="S_Init" location="1:1-1:10" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Transition" name="T_StartupToCheck" location="2:1-2:20" condition="system_ready &amp; no_errors"/>
    <elements xsi:type="Grafcet:Step" name="S_Check" location="3:1-3:15" isInitial="false" isActive="false" action="run_diagnostics"/>
    <elements xsi:type="Grafcet:Transition" name="T_CheckToLoop" location="4:1-4:18" condition="diagnostics_ok"/>
    <elements xsi:type="Grafcet:Step" name="S_Loop" location="5:1-5:12" isInitial="false" isActive="false" action="main_control_loop"/>
    <elements xsi:type="Grafcet:Transition" name="T_LoopToErrorOrBack" location="6:1-6:30" condition="iteration_complete"/>
    <elements xsi:type="Grafcet:Step" name="S_Error" location="7:1-7:12" isInitial="false" isActive="false" action="handle_error_and_log"/>
    <!-- Connections: create a cycle with a branch from loop to error and back to check -->
    <!-- S_Init (0) --> T_StartupToCheck (1) -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_SInit_TStartup" location="10:1-10:25" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TStartup_SCheck" location="11:1-11:26" from="/0/@elements.1" to="/0/@elements.2"/>
    <!-- S_Check (2) --> T_CheckToLoop (3) -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_SCheck_TCheck" location="12:1-12:24" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TCheck_SLoop" location="13:1-13:23" from="/0/@elements.3" to="/0/@elements.4"/>
    <!-- S_Loop (4) --> T_LoopToErrorOrBack (5) -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_SLoop_TLoop" location="14:1-14:22" from="/0/@elements.4" to="/0/@elements.5"/>
    <!-- T_LoopToErrorOrBack (5) branches to S_Error (6) and back to S_Check (2) -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TLoop_SError" location="15:1-15:23" from="/0/@elements.5" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TLoop_SCheckBack" location="16:1-16:28" from="/0/@elements.5" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>