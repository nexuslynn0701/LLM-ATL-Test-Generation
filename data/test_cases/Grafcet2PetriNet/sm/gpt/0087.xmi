<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file:/models/grafcet0087">

    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              name="InitStep"
              location="file:/models/grafcet0087#InitStep"
              isInitial="true"
              isActive="true"
              action="initializeSystem"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="ParallelStepA"
              location="file:/models/grafcet0087#ParallelStepA"
              isInitial="false"
              isActive="false"
              action="runBranchA"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="ParallelStepB"
              location="file:/models/grafcet0087#ParallelStepB"
              isInitial="false"
              isActive="false"
              action="runBranchB"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              name="MergeStep"
              location="file:/models/grafcet0087#MergeStep"
              isInitial="false"
              isActive="false"
              action="mergeBranches"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_s4"
              name="LoopStep"
              location="file:/models/grafcet0087#LoopStep"
              isInitial="false"
              isActive="false"
              action="loopProcessing"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              name="T_Init_to_Parallel"
              location="file:/models/grafcet0087#T_Init_to_Parallel"
              condition="startSignal"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="T_ParallelA_to_Merge"
              location="file:/models/grafcet0087#T_ParallelA_to_Merge"
              condition="branchA_done"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="T_ParallelB_to_Merge"
              location="file:/models/grafcet0087#T_ParallelB_to_Merge"
              condition="branchB_done"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t3"
              name="T_Merge_to_Loop"
              location="file:/models/grafcet0087#T_Merge_to_Loop"
              condition="merge_ok"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t4"
              name="T_Loop_to_Parallel"
              location="file:/models/grafcet0087#T_Loop_to_Parallel"
              condition="loop_again"/>

    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- From initial step to first transition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="C_Init_to_T0"
                 location="file:/models/grafcet0087#C_Init_to_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.5"/>

    <!-- From T0 to parallel steps A and B -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c1"
                 name="C_T0_to_ParallelA"
                 location="file:/models/grafcet0087#C_T0_to_ParallelA"
                 from="/0/@elements.5"
                 to="/0/@elements.1"/>

    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c2"
                 name="C_T0_to_ParallelB"
                 location="file:/models/grafcet0087#C_T0_to_ParallelB"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>

    <!-- From parallel steps to merge step via distinct transitions -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 name="C_ParallelA_to_T1"
                 location="file:/models/grafcet0087#C_ParallelA_to_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.6"/>

    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 name="C_T1_to_Merge"
                 location="file:/models/grafcet0087#C_T1_to_Merge"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>

    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c5"
                 name="C_ParallelB_to_T2"
                 location="file:/models/grafcet0087#C_ParallelB_to_T2"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>

    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 name="C_T2_to_Merge"
                 location="file:/models/grafcet0087#C_T2_to_Merge"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>

    <!-- From merge step to loop step -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c7"
                 name="C_Merge_to_T3"
                 location="file:/models/grafcet0087#C_Merge_to_T3"
                 from="/0/@elements.3"
                 to="/0/@elements.8"/>

    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c8"
                 name="C_T3_to_Loop"
                 location="file:/models/grafcet0087#C_T3_to_Loop"
                 from="/0/@elements.8"
                 to="/0/@elements.4"/>

    <!-- Loop back from loop step to parallel via another transition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c9"
                 name="C_Loop_to_T4"
                 location="file:/models/grafcet0087#C_Loop_to_T4"
                 from="/0/@elements.4"
                 to="/0/@elements.9"/>

    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c10"
                 name="C_T4_to_ParallelA"
                 location="file:/models/grafcet0087#C_T4_to_ParallelA"
                 from="/0/@elements.9"
                 to="/0/@elements.1"/>

  </Grafcet:Grafcet>
</xmi:XMI>