<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet" location="model.grafcet">

    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="s0" name="InitStep" location="model.grafcet#s0" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s1" name="BranchStepA" location="model.grafcet#s1" isInitial="false" isActive="false" action="process_branch_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s2" name="BranchStepB" location="model.grafcet#s2" isInitial="false" isActive="false" action="process_branch_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s3" name="MergeStep" location="model.grafcet#s3" isInitial="false" isActive="false" action="merge_results"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s4" name="LoopStep" location="model.grafcet#s4" isInitial="false" isActive="false" action="loop_processing"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="t0" name="T_Init_to_BranchA" location="model.grafcet#t0" condition="start &amp;&amp; mode = 'A'"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t1" name="T_Init_to_BranchB" location="model.grafcet#t1" condition="start &amp;&amp; mode = 'B'"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t2" name="T_Branches_to_Merge" location="model.grafcet#t2" condition="A_done and B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t3" name="T_Merge_to_Loop" location="model.grafcet#t3" condition="merge_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t4" name="T_Loop_back" location="model.grafcet#t4" condition="need_retry"/>

    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- From InitStep to two alternative transitions -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c0" name="C_Init_to_T0" location="model.grafcet#c0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c1" name="C_Init_to_T1" location="model.grafcet#c1" from="/0/@elements.0" to="/0/@elements.6"/>

    <!-- From transitions to branch steps -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c2" name="C_T0_to_BranchA" location="model.grafcet#c2" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c3" name="C_T1_to_BranchB" location="model.grafcet#c3" from="/0/@elements.6" to="/0/@elements.2"/>

    <!-- From branch steps to common transition (converging into merge) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c4" name="C_BranchA_to_T2" location="model.grafcet#c4" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c5" name="C_BranchB_to_T2" location="model.grafcet#c5" from="/0/@elements.2" to="/0/@elements.7"/>

    <!-- From transition to merge step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c6" name="C_T2_to_Merge" location="model.grafcet#c6" from="/0/@elements.7" to="/0/@elements.3"/>

    <!-- From merge step to loop transition and back to loop step -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c7" name="C_Merge_to_T3" location="model.grafcet#c7" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c8" name="C_T3_to_Loop" location="model.grafcet#c8" from="/0/@elements.8" to="/0/@elements.4"/>

    <!-- Loop: from loop step back via transition to itself -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c9" name="C_Loop_to_T4" location="model.grafcet#c9" from="/0/@elements.4" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c10" name="C_T4_to_Loop" location="model.grafcet#c10" from="/0/@elements.9" to="/0/@elements.4"/>

  </Grafcet:Grafcet>
</xmi:XMI>