<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet0041" location="file:/models/grafcet_0041.grafcet">
    <!-- Elements: 4 steps + 3 transitions, arranged in a loop with a branch -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="ProcessStepA" location="2:1-2:25" isInitial="false" isActive="false" action="process_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ProcessStepB" location="3:1-3:25" isInitial="false" isActive="false" action="process_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="FinalStep" location="4:1-4:20" isInitial="false" isActive="false" action="shutdown"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_Init_to_A" location="5:1-5:30" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_A_to_B" location="6:1-6:30" condition="task_A_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_B_to_Final_or_Loop" location="7:1-7:40" condition="task_B_done"/>
    <!-- Connections: form a path S0 -> T0 -> S1 -> T1 -> S2 -> T2 -> S3 and a loop S2 -> T2 -> S1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_S0_T0" location="8:1-8:25" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="C_T0_S1" location="9:1-9:25" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="C_S1_T1" location="10:1-10:25" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C3" name="C_T1_S2" location="11:1-11:25" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_S2_T2" location="12:1-12:25" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="C_T2_S3" location="13:1-13:25" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C6" name="C_T2_S1_Loop" location="14:1-14:30" from="/0/@elements.6" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>