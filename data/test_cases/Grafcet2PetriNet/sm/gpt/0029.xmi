<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcetExample" location="file://grafcet/complex.grafcet">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="file://grafcet/complex.grafcet#S0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="BranchStep1" location="file://grafcet/complex.grafcet#S1" isInitial="false" isActive="false" action="checkSensorA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="BranchStep2" location="file://grafcet/complex.grafcet#S2" isInitial="false" isActive="false" action="checkSensorB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="MergeStep" location="file://grafcet/complex.grafcet#S3" isInitial="false" isActive="false" action="evaluateBranchResult"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="LoopStep" location="file://grafcet/complex.grafcet#S4" isInitial="false" isActive="false" action="retryOperation"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S5" name="FinalStep" location="file://grafcet/complex.grafcet#S5" isInitial="false" isActive="false" action="shutdownSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_Init_to_Branch" location="file://grafcet/complex.grafcet#T0" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_to_Branch1" location="file://grafcet/complex.grafcet#T1" condition="sensorA_OK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_to_Branch2" location="file://grafcet/complex.grafcet#T2" condition="sensorB_OK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="T_Branches_to_Merge" location="file://grafcet/complex.grafcet#T3" condition="branchesEvaluated"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" name="T_Merge_to_Loop" location="file://grafcet/complex.grafcet#T4" condition="needRetry"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T5" name="T_Loop_to_Merge" location="file://grafcet/complex.grafcet#T5" condition="retryCompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T6" name="T_Merge_to_Final" location="file://grafcet/complex.grafcet#T6" condition="noRetryNeeded"/>

    <!-- Connections: StepToTransition (from Step to Transition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_Init_to_T0" location="file://grafcet/complex.grafcet#C0" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C1" name="C_Branch1_to_T3" location="file://grafcet/complex.grafcet#C1" from="/0/@elements.1" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="C_Branch2_to_T3" location="file://grafcet/complex.grafcet#C2" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="C_Merge_to_T4" location="file://grafcet/complex.grafcet#C3" from="/0/@elements.3" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_Loop_to_T5" location="file://grafcet/complex.grafcet#C4" from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C5" name="C_Merge_to_T6" location="file://grafcet/complex.grafcet#C5" from="/0/@elements.3" to="/0/@elements.12"/>

    <!-- Connections: TransitionToStep (from Transition to Step) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C6" name="C_T0_to_Branch1" location="file://grafcet/complex.grafcet#C6" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="C_T0_to_Branch2" location="file://grafcet/complex.grafcet#C7" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C8" name="C_T1_to_Branch1" location="file://grafcet/complex.grafcet#C8" from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C9" name="C_T2_to_Branch2" location="file://grafcet/complex.grafcet#C9" from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C10" name="C_T3_to_Merge" location="file://grafcet/complex.grafcet#C10" from="/0/@elements.9" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C11" name="C_T4_to_Loop" location="file://grafcet/complex.grafcet#C11" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C12" name="C_T5_to_Merge" location="file://grafcet/complex.grafcet#C12" from="/0/@elements.11" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C13" name="C_T6_to_Final" location="file://grafcet/complex.grafcet#C13" from="/0/@elements.12" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>