<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet0077" location="file://complex_grafcet_0077.grafcet">
    <!-- Elements: 4 Steps and 3 Transitions in a branching/merging structure with a self-loop -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="Start" location="loc_S0" isInitial="true" isActive="true" action="initSystem()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="BranchA" location="loc_S1" isInitial="false" isActive="false" action="handleA()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="BranchB" location="loc_S2" isInitial="false" isActive="false" action="handleB()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="Join" location="loc_S3" isInitial="false" isActive="false" action="finalize()"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_Start_to_Branches" location="loc_T0" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_Branches_to_Join" location="loc_T1" condition="A_done and B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_SelfLoop_Join" location="loc_T2" condition="retryRequired"/>

    <!-- Connections: branching, merging, and self-loop -->
    <!-- Start -> T0 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_S0_T0" location="loc_C0" from="/0/@elements.0" to="/0/@elements.4"/>
    <!-- T0 -> BranchA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="C_T0_S1" location="loc_C1" from="/0/@elements.4" to="/0/@elements.1"/>
    <!-- T0 -> BranchB -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C2" name="C_T0_S2" location="loc_C2" from="/0/@elements.4" to="/0/@elements.2"/>

    <!-- BranchA -> T1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="C_S1_T1" location="loc_C3" from="/0/@elements.1" to="/0/@elements.5"/>
    <!-- BranchB -> T1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_S2_T1" location="loc_C4" from="/0/@elements.2" to="/0/@elements.5"/>
    <!-- T1 -> Join -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="C_T1_S3" location="loc_C5" from="/0/@elements.5" to="/0/@elements.3"/>

    <!-- Self-loop on Join via T2 -->
    <!-- Join -> T2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" name="C_S3_T2" location="loc_C6" from="/0/@elements.3" to="/0/@elements.6"/>
    <!-- T2 -> Join -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="C_T2_S3" location="loc_C7" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>