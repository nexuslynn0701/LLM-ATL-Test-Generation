<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet name="ComplexGrafcet0094" location="file:complexGrafcet0094.gcf">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" name="BranchStepA" location="2:1-2:25" isInitial="false" isActive="false" action="performActionA"/>
    <elements xsi:type="Grafcet:Step" name="BranchStepB" location="3:1-3:25" isInitial="false" isActive="false" action="performActionB"/>
    <elements xsi:type="Grafcet:Step" name="MergeStep" location="4:1-4:20" isInitial="false" isActive="false" action="mergeActions"/>
    <elements xsi:type="Grafcet:Step" name="LoopStep" location="5:1-5:20" isInitial="false" isActive="true" action="loopProcessing"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="6:1-6:20" isInitial="false" isActive="false" action="finalizeSystem"/>

    <elements xsi:type="Grafcet:Transition" name="T_Init_To_BranchA" location="10:1-10:30" condition="condInitToA"/>
    <elements xsi:type="Grafcet:Transition" name="T_Init_To_BranchB" location="11:1-11:30" condition="condInitToB"/>
    <elements xsi:type="Grafcet:Transition" name="T_A_To_Merge" location="12:1-12:25" condition="condAToMerge"/>
    <elements xsi:type="Grafcet:Transition" name="T_B_To_Merge" location="13:1-13:25" condition="condBToMerge"/>
    <elements xsi:type="Grafcet:Transition" name="T_Merge_To_Loop" location="14:1-14:25" condition="condMergeToLoop"/>
    <elements xsi:type="Grafcet:Transition" name="T_Loop_Self" location="15:1-15:25" condition="condLoopSelf"/>
    <elements xsi:type="Grafcet:Transition" name="T_Loop_To_Final" location="16:1-16:25" condition="condLoopToFinal"/>

    <!-- Connections: StepToTransition -->
    <!-- InitStep -> T_Init_To_BranchA -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_To_TA" location="20:1-20:40"
        from="/0/@elements.0" to="/0/@elements.6"/>
    <!-- InitStep -> T_Init_To_BranchB -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_To_TB" location="21:1-21:40"
        from="/0/@elements.0" to="/0/@elements.7"/>
    <!-- BranchStepA -> T_A_To_Merge -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_A_To_TM" location="22:1-22:40"
        from="/0/@elements.1" to="/0/@elements.8"/>
    <!-- BranchStepB -> T_B_To_Merge -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_B_To_TM" location="23:1-23:40"
        from="/0/@elements.2" to="/0/@elements.9"/>
    <!-- MergeStep -> T_Merge_To_Loop -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Merge_To_TLoop" location="24:1-24:45"
        from="/0/@elements.3" to="/0/@elements.10"/>
    <!-- LoopStep -> T_Loop_Self -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Loop_To_TSelf" location="25:1-25:45"
        from="/0/@elements.4" to="/0/@elements.11"/>
    <!-- LoopStep -> T_Loop_To_Final -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Loop_To_TFinal" location="26:1-26:45"
        from="/0/@elements.4" to="/0/@elements.12"/>

    <!-- Connections: TransitionToStep -->
    <!-- T_Init_To_BranchA -> BranchStepA -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TA_To_A" location="30:1-30:40"
        from="/0/@elements.6" to="/0/@elements.1"/>
    <!-- T_Init_To_BranchB -> BranchStepB -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TB_To_B" location="31:1-31:40"
        from="/0/@elements.7" to="/0/@elements.2"/>
    <!-- T_A_To_Merge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TM_From_A" location="32:1-32:40"
        from="/0/@elements.8" to="/0/@elements.3"/>
    <!-- T_B_To_Merge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TM_From_B" location="33:1-33:40"
        from="/0/@elements.9" to="/0/@elements.3"/>
    <!-- T_Merge_To_Loop -> LoopStep -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TLoop_To_Loop" location="34:1-34:45"
        from="/0/@elements.10" to="/0/@elements.4"/>
    <!-- T_Loop_Self -> LoopStep (self-loop) -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TSelf_To_Loop" location="35:1-35:45"
        from="/0/@elements.11" to="/0/@elements.4"/>
    <!-- T_Loop_To_Final -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TFinal_To_Final" location="36:1-36:45"
        from="/0/@elements.12" to="/0/@elements.5"/>

  </Grafcet:Grafcet>
</xmi:XMI>