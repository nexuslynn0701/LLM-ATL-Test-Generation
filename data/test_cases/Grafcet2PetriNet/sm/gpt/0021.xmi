<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexGrafcet0021" location="file:/models/grafcet0021.gcf">
    <elements xsi:type="Grafcet:Step" name="InitStep" location="1:1-1:50" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" name="ParallelBranchA" location="2:1-2:60" isInitial="false" isActive="false" action="handleBranchA"/>
    <elements xsi:type="Grafcet:Step" name="ParallelBranchB" location="3:1-3:60" isInitial="false" isActive="false" action="handleBranchB"/>
    <elements xsi:type="Grafcet:Step" name="MergeStep1" location="4:1-4:60" isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step" name="LoopBody" location="5:1-5:60" isInitial="false" isActive="false" action="loopProcessing"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="6:1-6:60" isInitial="false" isActive="false" action="shutdownSystem"/>
    <elements xsi:type="Grafcet:Transition" name="T_Init_To_Split" location="10:1-10:60" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" name="T_Split_To_A" location="11:1-11:60" condition="chooseA"/>
    <elements xsi:type="Grafcet:Transition" name="T_Split_To_B" location="12:1-12:60" condition="chooseB"/>
    <elements xsi:type="Grafcet:Transition" name="T_A_To_Merge" location="13:1-13:60" condition="A_done"/>
    <elements xsi:type="Grafcet:Transition" name="T_B_To_Merge" location="14:1-14:60" condition="B_done"/>
    <elements xsi:type="Grafcet:Transition" name="T_Merge_To_Loop" location="15:1-15:60" condition="bothCompleted"/>
    <elements xsi:type="Grafcet:Transition" name="T_Loop_Repeat" location="16:1-16:60" condition="moreWork"/>
    <elements xsi:type="Grafcet:Transition" name="T_Loop_To_Final" location="17:1-17:60" condition="noMoreWork"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_TSplit" location="20:1-20:60" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TSplit_StepA" location="21:1-21:60" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TSplit_StepB" location="22:1-22:60" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_A_To_TA" location="23:1-23:60" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_B_To_TB" location="24:1-24:60" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TA_To_Merge" location="25:1-25:60" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TB_To_Merge" location="26:1-26:60" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Merge_To_TMergeLoop" location="27:1-27:60" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TMergeLoop_To_LoopBody" location="28:1-28:60" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Loop_To_TRepeat" location="29:1-29:60" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TRepeat_To_Loop" location="30:1-30:60" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Loop_To_TFinal" location="31:1-31:60" from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TFinal_To_FinalStep" location="32:1-32:60" from="/0/@elements.11" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>