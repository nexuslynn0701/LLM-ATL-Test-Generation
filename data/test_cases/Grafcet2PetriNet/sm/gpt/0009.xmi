<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet0009" location="model/location/0009">
    <!-- Elements: 5 Steps + 4 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="loc_S0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="ParallelStepA" location="loc_S1" isInitial="false" isActive="false" action="runBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ParallelStepB" location="loc_S2" isInitial="false" isActive="false" action="runBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="MergeStep" location="loc_S3" isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="FinalStep" location="loc_S4" isInitial="false" isActive="false" action="shutdownSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="SplitTransition" location="loc_T0" condition="cond_split"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="JoinTransition" location="loc_T1" condition="cond_join"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="DirectTransition" location="loc_T2" condition="cond_direct"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="LoopTransition" location="loc_T3" condition="cond_loop"/>

    <!-- Connections: StepToTransition -->
    <!-- From initial step to split and direct transitions -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_S0_T0" location="loc_C0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C1" name="C_S0_T2" location="loc_C1" from="/0/@elements.0" to="/0/@elements.7"/>

    <!-- From parallel branch steps to join transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="C_S1_T1" location="loc_C2" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="C_S2_T1" location="loc_C3" from="/0/@elements.2" to="/0/@elements.6"/>

    <!-- From merge and final steps to loop transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_S3_T3" location="loc_C4" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C5" name="C_S4_T3" location="loc_C5" from="/0/@elements.4" to="/0/@elements.8"/>

    <!-- Connections: TransitionToStep -->
    <!-- Split transition to parallel steps -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C6" name="C_T0_S1" location="loc_C6" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="C_T0_S2" location="loc_C7" from="/0/@elements.5" to="/0/@elements.2"/>

    <!-- Direct path from init step to merge step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C8" name="C_T2_S3" location="loc_C8" from="/0/@elements.7" to="/0/@elements.3"/>

    <!-- Join transition to merge step and then to final step through loop transition -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C9" name="C_T1_S3" location="loc_C9" from="/0/@elements.6" to="/0/@elements.3"/>

    <!-- Loop transition to initial and final steps -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C10" name="C_T3_S0" location="loc_C10" from="/0/@elements.8" to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C11" name="C_T3_S4" location="loc_C11" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>