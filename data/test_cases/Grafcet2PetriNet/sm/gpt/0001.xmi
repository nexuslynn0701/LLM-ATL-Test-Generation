<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet" location="file://complexGrafcet.g7">
    <!-- Elements: 4 Steps + 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="ParallelStep1" location="2:1-2:25" isInitial="false" isActive="false" action="runBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ParallelStep2" location="3:1-3:25" isInitial="false" isActive="false" action="runBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="FinalStep" location="4:1-4:20" isInitial="false" isActive="false" action="shutdownSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="SplitTransition" location="5:1-5:25" condition="startTrigger"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="BranchAtoJoin" location="6:1-6:25" condition="branchAComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="BranchBtoJoin" location="7:1-7:25" condition="branchBComplete"/>

    <!-- Connections: sequence + fork/join-like structure -->
    <!-- InitStep -> SplitTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_Init_to_Split" location="10:1-10:40" from="/0/@elements.0" to="/0/@elements.4"/>

    <!-- SplitTransition -> ParallelStep1 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="C_Split_to_P1" location="11:1-11:40" from="/0/@elements.4" to="/0/@elements.1"/>

    <!-- SplitTransition -> ParallelStep2 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C2" name="C_Split_to_P2" location="12:1-12:40" from="/0/@elements.4" to="/0/@elements.2"/>

    <!-- ParallelStep1 -> BranchAtoJoin -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="C_P1_to_JoinA" location="13:1-13:45" from="/0/@elements.1" to="/0/@elements.5"/>

    <!-- ParallelStep2 -> BranchBtoJoin -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_P2_to_JoinB" location="14:1-14:45" from="/0/@elements.2" to="/0/@elements.6"/>

    <!-- BranchAtoJoin -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="C_JoinA_to_Final" location="15:1-15:45" from="/0/@elements.5" to="/0/@elements.3"/>

    <!-- BranchBtoJoin -> FinalStep (multiple incoming to FinalStep) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C6" name="C_JoinB_to_Final" location="16:1-16:45" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>