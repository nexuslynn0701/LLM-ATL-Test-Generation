<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet" location="file://complex_grafcet.gcf">
    <!-- Elements: 4 Steps + 3 Transitions, mixed initial/active and actions/conditions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="file://complex_grafcet.gcf#S0" isInitial="true" isActive="true" action="initSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="ProcessStepA" location="file://complex_grafcet.gcf#S1" isInitial="false" isActive="false" action="processA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ProcessStepB" location="file://complex_grafcet.gcf#S2" isInitial="false" isActive="true" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="EndStep" location="file://complex_grafcet.gcf#S3" isInitial="false" isActive="false" action="shutdown"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="InitToA" location="file://complex_grafcet.gcf#T0" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="AToB" location="file://complex_grafcet.gcf#T1" condition="y == true"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="LoopOrEnd" location="file://complex_grafcet.gcf#T2" condition="z &lt;= 3"/>

    <!-- Connections:
         S0 -> T0 -> S1
         S1 -> T1 -> S2
         S2 -> T2 -> S1   (loop back)
         S2 -> T2 -> S3   (fork to end) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_S0_T0" location="file://complex_grafcet.gcf#C0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="C_T0_S1" location="file://complex_grafcet.gcf#C1" from="/0/@elements.4" to="/0/@elements.1"/>

    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="C_S1_T1" location="file://complex_grafcet.gcf#C2" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C3" name="C_T1_S2" location="file://complex_grafcet.gcf#C3" from="/0/@elements.5" to="/0/@elements.2"/>

    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_S2_T2" location="file://complex_grafcet.gcf#C4" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="C_T2_S1" location="file://complex_grafcet.gcf#C5" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C6" name="C_T2_S3" location="file://complex_grafcet.gcf#C6" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>