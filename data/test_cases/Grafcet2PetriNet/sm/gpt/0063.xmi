<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="g1" name="ComplexGrafcet0063" location="file://complexGrafcet0063.grafcet">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="s1" name="InitStep" location="file://complexGrafcet0063.grafcet#s1" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s2" name="ParallelBranchA" location="file://complexGrafcet0063.grafcet#s2" isInitial="false" isActive="false" action="run_branch_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s3" name="ParallelBranchB" location="file://complexGrafcet0063.grafcet#s3" isInitial="false" isActive="false" action="run_branch_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s4" name="MergeStep" location="file://complexGrafcet0063.grafcet#s4" isInitial="false" isActive="false" action="merge_branches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s5" name="FinalStep" location="file://complexGrafcet0063.grafcet#s5" isInitial="false" isActive="false" action="shutdown_system"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="t1" name="ToParallel" location="file://complexGrafcet0063.grafcet#t1" condition="start_parallel"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t2" name="BranchAProgress" location="file://complexGrafcet0063.grafcet#t2" condition="A_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t3" name="BranchBProgress" location="file://complexGrafcet0063.grafcet#t3" condition="B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t4" name="FromParallelToMerge" location="file://complexGrafcet0063.grafcet#t4" condition="A_and_B_completed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t5" name="ToFinal" location="file://complexGrafcet0063.grafcet#t5" condition="merge_done"/>

    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- Initial step to first transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c1" name="c_Init_to_t1" location="file://complexGrafcet0063.grafcet#c1" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- Transition to parallel steps -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c2" name="c_t1_to_s2" location="file://complexGrafcet0063.grafcet#c2" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c3" name="c_t1_to_s3" location="file://complexGrafcet0063.grafcet#c3" from="/0/@elements.5" to="/0/@elements.2"/>

    <!-- Branch A: s2 -> t2 -> s4 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c4" name="c_s2_to_t2" location="file://complexGrafcet0063.grafcet#c4" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c5" name="c_t2_to_s4" location="file://complexGrafcet0063.grafcet#c5" from="/0/@elements.6" to="/0/@elements.3"/>

    <!-- Branch B: s3 -> t3 -> s4 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c6" name="c_s3_to_t3" location="file://complexGrafcet0063.grafcet#c6" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c7" name="c_t3_to_s4" location="file://complexGrafcet0063.grafcet#c7" from="/0/@elements.7" to="/0/@elements.3"/>

    <!-- Merge step s4 through t4 to itself (self-loop to model re-check condition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c8" name="c_s4_to_t4" location="file://complexGrafcet0063.grafcet#c8" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c9" name="c_t4_to_s4" location="file://complexGrafcet0063.grafcet#c9" from="/0/@elements.8" to="/0/@elements.3"/>

    <!-- Merge step to final transition and final step -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c10" name="c_s4_to_t5" location="file://complexGrafcet0063.grafcet#c10" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c11" name="c_t5_to_s5" location="file://complexGrafcet0063.grafcet#c11" from="/0/@elements.9" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>