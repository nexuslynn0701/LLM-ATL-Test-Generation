<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexGrafcet" location="file:///models/grafcet/complex_0091.gcf">
    <!-- Elements: 5 Steps + 4 Transitions -->
    <elements xsi:type="Grafcet:Step" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" name="ParallelStepA" location="2:1-2:25" isInitial="false" isActive="false" action="process_channel_A"/>
    <elements xsi:type="Grafcet:Step" name="ParallelStepB" location="3:1-3:25" isInitial="false" isActive="false" action="process_channel_B"/>
    <elements xsi:type="Grafcet:Step" name="MergeStep" location="4:1-4:20" isInitial="false" isActive="false" action="merge_results"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="5:1-5:20" isInitial="false" isActive="false" action="shutdown_system"/>
    <elements xsi:type="Grafcet:Transition" name="SplitTransition1" location="6:1-6:25" condition="sensor_ready &amp;&amp; mode=1"/>
    <elements xsi:type="Grafcet:Transition" name="SplitTransition2" location="7:1-7:25" condition="sensor_ready &amp;&amp; mode=2"/>
    <elements xsi:type="Grafcet:Transition" name="JoinTransition" location="8:1-8:25" condition="A_done &amp;&amp; B_done"/>
    <elements xsi:type="Grafcet:Transition" name="ExitTransition" location="9:1-9:25" condition="results_ok || forced_shutdown"/>

    <!-- Connections (indices for elements: 0..8) -->
    <!-- InitStep (0) -> SplitTransition1 (5) -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_to_Split1" location="10:1-10:40" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- InitStep (0) -> SplitTransition2 (6) -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_to_Split2" location="11:1-11:40" from="/0/@elements.0" to="/0/@elements.6"/>

    <!-- SplitTransition1 (5) -> ParallelStepA (1) -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_Split1_to_A" location="12:1-12:40" from="/0/@elements.5" to="/0/@elements.1"/>
    <!-- SplitTransition2 (6) -> ParallelStepB (2) -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_Split2_to_B" location="13:1-13:40" from="/0/@elements.6" to="/0/@elements.2"/>

    <!-- ParallelStepA (1) -> JoinTransition (7) -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_A_to_Join" location="14:1-14:40" from="/0/@elements.1" to="/0/@elements.7"/>
    <!-- ParallelStepB (2) -> JoinTransition (7) -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_B_to_Join" location="15:1-15:40" from="/0/@elements.2" to="/0/@elements.7"/>

    <!-- JoinTransition (7) -> MergeStep (3) -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_Join_to_Merge" location="16:1-16:40" from="/0/@elements.7" to="/0/@elements.3"/>

    <!-- MergeStep (3) -> ExitTransition (8) -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Merge_to_Exit" location="17:1-17:40" from="/0/@elements.3" to="/0/@elements.8"/>

    <!-- ExitTransition (8) -> FinalStep (4) -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_Exit_to_Final" location="18:1-18:40" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>