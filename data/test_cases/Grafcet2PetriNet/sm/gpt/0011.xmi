<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="g1" name="ComplexGrafcet" location="1:1-1:1">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="s1"
              name="InitStep" location="2:1-2:20"
              isInitial="true" isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s2"
              name="BranchLeft" location="3:1-3:25"
              isInitial="false" isActive="false"
              action="execute_left_branch"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s3"
              name="BranchRight" location="4:1-4:26"
              isInitial="false" isActive="false"
              action="execute_right_branch"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s4"
              name="MergeStep" location="5:1-5:22"
              isInitial="false" isActive="false"
              action="merge_results"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s5"
              name="LoopStep" location="6:1-6:21"
              isInitial="false" isActive="false"
              action="perform_loop_iteration"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s6"
              name="FinalStep" location="7:1-7:21"
              isInitial="false" isActive="false"
              action="finalize_sequence"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="t1"
              name="T_Init_to_Branch" location="8:1-8:30"
              condition="sys_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t2"
              name="T_BranchLeft_to_Merge" location="9:1-9:35"
              condition="left_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t3"
              name="T_BranchRight_to_Merge" location="10:1-10:36"
              condition="right_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t4"
              name="T_Merge_to_Loop" location="11:1-11:30"
              condition="results_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t5"
              name="T_Loop_to_Loop" location="12:1-12:29"
              condition="more_iterations"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t6"
              name="T_Loop_to_Final" location="13:1-13:31"
              condition="no_more_iterations"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c1"
                 name="C_Init_to_T1" location="14:1-14:30"
                 from="/0/@elements.0"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c2"
                 name="C_Init_to_T1_SecondPath" location="15:1-15:40"
                 from="/0/@elements.0"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c3"
                 name="C_BranchLeft_to_T2" location="16:1-16:35"
                 from="/0/@elements.1"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c4"
                 name="C_BranchRight_to_T3" location="17:1-17:36"
                 from="/0/@elements.2"
                 to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c5"
                 name="C_Merge_to_T4" location="18:1-18:30"
                 from="/0/@elements.3"
                 to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c6"
                 name="C_Loop_to_T5" location="19:1-19:28"
                 from="/0/@elements.4"
                 to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c7"
                 name="C_Loop_to_T6" location="20:1-20:28"
                 from="/0/@elements.4"
                 to="/0/@elements.11"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c8"
                 name="C_T1_to_Branches" location="21:1-21:34"
                 from="/0/@elements.6"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c9"
                 name="C_T1_to_BranchRight" location="22:1-22:36"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c10"
                 name="C_T2_to_Merge" location="23:1-23:30"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c11"
                 name="C_T3_to_Merge" location="24:1-24:30"
                 from="/0/@elements.8"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c12"
                 name="C_T4_to_Loop" location="25:1-25:28"
                 from="/0/@elements.9"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c13"
                 name="C_T5_to_Loop" location="26:1-26:28"
                 from="/0/@elements.10"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c14"
                 name="C_T6_to_Final" location="27:1-27:30"
                 from="/0/@elements.11"
                 to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>