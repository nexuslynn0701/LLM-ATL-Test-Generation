<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet0027" location="file:///models/grafcet0027.gct">
    <!-- Elements (Steps and Transitions) -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="1,1" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckSensors" location="2,1" isInitial="false" isActive="false" action="check_sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="NormalOperation" location="3,1" isInitial="false" isActive="false" action="run_normal_cycle"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ErrorHandler" location="4,2" isInitial="false" isActive="false" action="handle_error"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="Shutdown" location="5,1" isInitial="false" isActive="false" action="perform_shutdown"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="Maintenance" location="3,3" isInitial="false" isActive="false" action="maintenance_mode"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="InitToCheck" location="1.5,1" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="CheckToNormal" location="2.5,1" condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="NormalToError" location="3.5,1.5" condition="fault_detected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="ErrorToShutdown" location="4.5,2" condition="critical_fault"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="NormalToShutdown" location="3.5,0.5" condition="stop_command"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="NormalToMaintenance" location="3,2" condition="maintenance_request"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="MaintenanceToNormal" location="3,2.5" condition="maintenance_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t7" name="LoopNormal" location="3.5,1" condition="cycle_complete"/>

    <!-- Connections Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="Init_to_t0" location="c0_loc" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="S1_to_t1" location="c1_loc" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="S2_to_t2" location="c2_loc" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="S2_to_t4" location="c3_loc" from="/0/@elements.2" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="S2_to_t5" location="c4_loc" from="/0/@elements.2" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="S3_to_t3" location="c5_loc" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="S5_to_t6" location="c6_loc" from="/0/@elements.5" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="S2_to_t7" location="c7_loc" from="/0/@elements.2" to="/0/@elements.13"/>

    <!-- Connections Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="t0_to_S1" location="c8_loc" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="t1_to_S2" location="c9_loc" from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="t2_to_S3" location="c10_loc" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="t3_to_S4" location="c11_loc" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="t4_to_S4" location="c12_loc" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="t5_to_S5" location="c13_loc" from="/0/@elements.11" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c14" name="t6_to_S2" location="c14_loc" from="/0/@elements.12" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c15" name="t7_to_S2" location="c15_loc" from="/0/@elements.13" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>