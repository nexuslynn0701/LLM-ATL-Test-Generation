<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexGrafcet0049" location="file://grafcet_models/complex_0049.gcf">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" name="Init" location="1:1-1:10" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" name="CheckSensors" location="2:1-2:20" isInitial="false" isActive="false" action="read_sensors"/>
    <elements xsi:type="Grafcet:Step" name="ProcessData" location="3:1-3:20" isInitial="false" isActive="false" action="compute_values"/>
    <elements xsi:type="Grafcet:Step" name="ErrorHandler" location="4:1-4:25" isInitial="false" isActive="false" action="handle_error"/>
    <elements xsi:type="Grafcet:Step" name="Shutdown" location="5:1-5:18" isInitial="false" isActive="false" action="stop_system"/>
    <elements xsi:type="Grafcet:Transition" name="T_InitToCheck" location="6:1-6:25" condition="start_button_pressed"/>
    <elements xsi:type="Grafcet:Transition" name="T_CheckToProcess" location="7:1-7:30" condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" name="T_CheckToError" location="8:1-8:30" condition="sensors_fail"/>
    <elements xsi:type="Grafcet:Transition" name="T_ProcessLoop" location="9:1-9:28" condition="more_data_available"/>
    <elements xsi:type="Grafcet:Transition" name="T_ProcessToShutdown" location="10:1-10:35" condition="processing_complete"/>
    <elements xsi:type="Grafcet:Transition" name="T_ErrorToShutdown" location="11:1-11:32" condition="acknowledge_error"/>
    <elements xsi:type="Grafcet:Transition" name="T_ShutdownToInit" location="12:1-12:32" condition="restart_command"/>

    <!-- Connections: StepToTransition (from Step to Transition) -->
    <!-- Init -> T_InitToCheck -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_T_InitToCheck" location="20:1-20:40" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- CheckSensors -> T_CheckToProcess -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Check_T_CheckToProcess" location="21:1-21:45" from="/0/@elements.1" to="/0/@elements.6"/>
    <!-- CheckSensors -> T_CheckToError (branch) -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Check_T_CheckToError" location="22:1-22:45" from="/0/@elements.1" to="/0/@elements.7"/>
    <!-- ProcessData -> T_ProcessLoop (self-loop via transition) -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Process_T_ProcessLoop" location="23:1-23:45" from="/0/@elements.2" to="/0/@elements.8"/>
    <!-- ProcessData -> T_ProcessToShutdown -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Process_T_ProcessToShutdown" location="24:1-24:48" from="/0/@elements.2" to="/0/@elements.9"/>
    <!-- ErrorHandler -> T_ErrorToShutdown -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Error_T_ErrorToShutdown" location="25:1-25:48" from="/0/@elements.3" to="/0/@elements.10"/>
    <!-- Shutdown -> T_ShutdownToInit (cycle back to Init) -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Shutdown_T_ShutdownToInit" location="26:1-26:50" from="/0/@elements.4" to="/0/@elements.11"/>

    <!-- Connections: TransitionToStep (from Transition to Step) -->
    <!-- T_InitToCheck -> CheckSensors -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_InitToCheck_Check" location="30:1-30:50" from="/0/@elements.5" to="/0/@elements.1"/>
    <!-- T_CheckToProcess -> ProcessData -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_CheckToProcess_Process" location="31:1-31:55" from="/0/@elements.6" to="/0/@elements.2"/>
    <!-- T_CheckToError -> ErrorHandler -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_CheckToError_Error" location="32:1-32:50" from="/0/@elements.7" to="/0/@elements.3"/>
    <!-- T_ProcessLoop -> ProcessData (loop) -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_ProcessLoop_Process" location="33:1-33:50" from="/0/@elements.8" to="/0/@elements.2"/>
    <!-- T_ProcessToShutdown -> Shutdown -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_ProcessToShutdown_Shutdown" location="34:1-34:60" from="/0/@elements.9" to="/0/@elements.4"/>
    <!-- T_ErrorToShutdown -> Shutdown -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_ErrorToShutdown_Shutdown" location="35:1-35:60" from="/0/@elements.10" to="/0/@elements.4"/>
    <!-- T_ShutdownToInit -> Init (cycle) -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_ShutdownToInit_Init" location="36:1-36:55" from="/0/@elements.11" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>