<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet" location="file://complex.grafcet">
    <!-- Elements: 5 Steps + 4 Transitions = 9 elements -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="file://complex.grafcet#S0" isInitial="true" isActive="true" action="initialize_system();"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="CheckSensors" location="file://complex.grafcet#S1" isInitial="false" isActive="false" action="read_sensors();"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="NormalOperation" location="file://complex.grafcet#S2" isInitial="false" isActive="false" action="run_cycle();"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="ErrorHandling" location="file://complex.grafcet#S3" isInitial="false" isActive="false" action="handle_error();"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="Shutdown" location="file://complex.grafcet#S4" isInitial="false" isActive="false" action="shutdown_all();"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="InitToCheck" location="file://complex.grafcet#T0" condition="init_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="SensorsOk" location="file://complex.grafcet#T1" condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="ErrorDetected" location="file://complex.grafcet#T2" condition="error_detected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="StopRequested" location="file://complex.grafcet#T3" condition="stop_request or fatal_error"/>

    <!-- Connections: linear path, branch to error, loop back, and termination -->
    <!-- InitStep -> InitToCheck -> CheckSensors -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_Init_S0_T0" location="file://complex.grafcet#C0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="C_Init_T0_S1" location="file://complex.grafcet#C1" from="/0/@elements.5" to="/0/@elements.1"/>

    <!-- CheckSensors -> SensorsOk -> NormalOperation -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="C_Check_S1_T1" location="file://complex.grafcet#C2" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C3" name="C_Check_T1_S2" location="file://complex.grafcet#C3" from="/0/@elements.6" to="/0/@elements.2"/>

    <!-- NormalOperation -> ErrorDetected -> ErrorHandling -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_Op_S2_T2" location="file://complex.grafcet#C4" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="C_Op_T2_S3" location="file://complex.grafcet#C5" from="/0/@elements.7" to="/0/@elements.3"/>

    <!-- ErrorHandling -> StopRequested -> Shutdown -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" name="C_Err_S3_T3" location="file://complex.grafcet#C6" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="C_Err_T3_S4" location="file://complex.grafcet#C7" from="/0/@elements.8" to="/0/@elements.4"/>

    <!-- Loop: Shutdown -> ErrorDetected -> ErrorHandling (recovery attempt loopback) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C8" name="C_Loop_S4_T2" location="file://complex.grafcet#C8" from="/0/@elements.4" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C9" name="C_Loop_T2_S3" location="file://complex.grafcet#C9" from="/0/@elements.7" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>