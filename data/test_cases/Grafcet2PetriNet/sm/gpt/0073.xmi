<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet0073" location="file://complex/grafcet_0073.gcf">
    <!-- Elements: 5 Steps + 4 Transitions (including a dead-end step and a transition with multiple outgoing) -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitialStep" location="file://complex/grafcet_0073.gcf#S0" isInitial="true" isActive="true" action="initSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="ProcessingStepA" location="file://complex/grafcet_0073.gcf#S1" isInitial="false" isActive="false" action="processA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ProcessingStepB" location="file://complex/grafcet_0073.gcf#S2" isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="FinalStep" location="file://complex/grafcet_0073.gcf#S3" isInitial="false" isActive="false" action="shutdown"/>
    <!-- Dead-end step: no incoming or outgoing connections -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="IsolatedStep" location="file://complex/grafcet_0073.gcf#S4" isInitial="false" isActive="false" action="orphanAction"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_init_to_A" location="file://complex/grafcet_0073.gcf#T0" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_A_to_B" location="file://complex/grafcet_0073.gcf#T1" condition="A_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_B_to_final" location="file://complex/grafcet_0073.gcf#T2" condition="B_done"/>
    <!-- Fork transition: one incoming step, two outgoing steps -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="T_A_to_B_or_final" location="file://complex/grafcet_0073.gcf#T3" condition="A_partial_done"/>

    <!-- Connections: normal chain S0 -> T0 -> S1 -> T1 -> S2 -> T2 -> S3 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_S0_T0" location="file://complex/grafcet_0073.gcf#C0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="C_T0_S1" location="file://complex/grafcet_0073.gcf#C1" from="/0/@elements.5" to="/0/@elements.1"/>

    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="C_S1_T1" location="file://complex/grafcet_0073.gcf#C2" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C3" name="C_T1_S2" location="file://complex/grafcet_0073.gcf#C3" from="/0/@elements.6" to="/0/@elements.2"/>

    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_S2_T2" location="file://complex/grafcet_0073.gcf#C4" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="C_T2_S3" location="file://complex/grafcet_0073.gcf#C5" from="/0/@elements.7" to="/0/@elements.3"/>

    <!-- Additional path: S1 -> T3 -> S2 and S1 -> T3 -> S3 (fork from A to B or Final) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" name="C_S1_T3" location="file://complex/grafcet_0073.gcf#C6" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="C_T3_S2" location="file://complex/grafcet_0073.gcf#C7" from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C8" name="C_T3_S3" location="file://complex/grafcet_0073.gcf#C8" from="/0/@elements.8" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>