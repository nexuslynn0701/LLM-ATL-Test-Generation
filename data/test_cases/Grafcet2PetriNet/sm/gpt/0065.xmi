<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet_0065" location="file://grafcet/complex_0065.gcf">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="1:1-1:40" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ParallelStepA" location="2:1-2:40" isInitial="false" isActive="false" action="processBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ParallelStepB" location="3:1-3:40" isInitial="false" isActive="false" action="processBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="MergeStep" location="4:1-4:40" isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="LoopStep" location="5:1-5:40" isInitial="false" isActive="false" action="performLoop"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="FinalStep" location="6:1-6:40" isInitial="false" isActive="false" action="shutdownSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToParallel" location="10:1-10:50" condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_ParallelToMergeA" location="11:1-11:50" condition="branchAComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_ParallelToMergeB" location="12:1-12:50" condition="branchBComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_MergeToLoop" location="13:1-13:50" condition="bothBranchesDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_LoopSelf" location="14:1-14:50" condition="loopCondition"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_LoopToFinal" location="15:1-15:50" condition="exitLoop"/>

    <!-- Connections: StepToTransition -->
    <!-- InitStep -> T_InitToParallel -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="C_Init_to_T0"
                 location="20:1-20:60"
                 grafcet="/0"
                 from="/0/@elements.0"
                 to="/0/@elements.6"/>
    <!-- ParallelStepA -> T_ParallelToMergeA -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="C_S1_to_T1"
                 location="21:1-21:60"
                 grafcet="/0"
                 from="/0/@elements.1"
                 to="/0/@elements.7"/>
    <!-- ParallelStepB -> T_ParallelToMergeB -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="C_S2_to_T2"
                 location="22:1-22:60"
                 grafcet="/0"
                 from="/0/@elements.2"
                 to="/0/@elements.8"/>
    <!-- MergeStep -> T_MergeToLoop -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 name="C_S3_to_T3"
                 location="23:1-23:60"
                 grafcet="/0"
                 from="/0/@elements.3"
                 to="/0/@elements.9"/>
    <!-- LoopStep -> T_LoopSelf -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c4"
                 name="C_S4_to_T4"
                 location="24:1-24:60"
                 grafcet="/0"
                 from="/0/@elements.4"
                 to="/0/@elements.10"/>
    <!-- LoopStep -> T_LoopToFinal -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c5"
                 name="C_S4_to_T5"
                 location="25:1-25:60"
                 grafcet="/0"
                 from="/0/@elements.4"
                 to="/0/@elements.11"/>

    <!-- Connections: TransitionToStep -->
    <!-- T_InitToParallel -> ParallelStepA -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 name="C_T0_to_S1"
                 location="30:1-30:60"
                 grafcet="/0"
                 from="/0/@elements.6"
                 to="/0/@elements.1"/>
    <!-- T_InitToParallel -> ParallelStepB -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 name="C_T0_to_S2"
                 location="31:1-31:60"
                 grafcet="/0"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>
    <!-- T_ParallelToMergeA -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c8"
                 name="C_T1_to_S3"
                 location="32:1-32:60"
                 grafcet="/0"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
    <!-- T_ParallelToMergeB -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c9"
                 name="C_T2_to_S3"
                 location="33:1-33:60"
                 grafcet="/0"
                 from="/0/@elements.8"
                 to="/0/@elements.3"/>
    <!-- T_MergeToLoop -> LoopStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c10"
                 name="C_T3_to_S4"
                 location="34:1-34:60"
                 grafcet="/0"
                 from="/0/@elements.9"
                 to="/0/@elements.4"/>
    <!-- T_LoopSelf -> LoopStep (self-loop) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c11"
                 name="C_T4_to_S4"
                 location="35:1-35:60"
                 grafcet="/0"
                 from="/0/@elements.10"
                 to="/0/@elements.4"/>
    <!-- T_LoopToFinal -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c12"
                 name="C_T5_to_S5"
                 location="36:1-36:60"
                 grafcet="/0"
                 from="/0/@elements.11"
                 to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>