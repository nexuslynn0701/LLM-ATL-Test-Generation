<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet0072" location="model/grafcet0072.gcf">
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStep" location="model/grafcet0072.gcf#InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="ParallelBranchA" location="model/grafcet0072.gcf#ParallelBranchA" isInitial="false" isActive="false" action="branch_A_processing"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="ParallelBranchB" location="model/grafcet0072.gcf#ParallelBranchB" isInitial="false" isActive="false" action="branch_B_processing"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="MergeStep" location="model/grafcet0072.gcf#MergeStep" isInitial="false" isActive="false" action="merge_results"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.4" name="LoopBody" location="model/grafcet0072.gcf#LoopBody" isInitial="false" isActive="false" action="loop_iteration"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.5" name="FinalStep" location="model/grafcet0072.gcf#FinalStep" isInitial="false" isActive="false" action="shutdown_system"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="T_Init_To_Parallel" location="model/grafcet0072.gcf#T_Init_To_Parallel" condition="start_command_received"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.7" name="T_ParallelA_To_Merge" location="model/grafcet0072.gcf#T_ParallelA_To_Merge" condition="branch_A_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.8" name="T_ParallelB_To_Merge" location="model/grafcet0072.gcf#T_ParallelB_To_Merge" condition="branch_B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.9" name="T_Merge_To_LoopBody" location="model/grafcet0072.gcf#T_Merge_To_LoopBody" condition="results_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.10" name="T_LoopBody_To_Merge" location="model/grafcet0072.gcf#T_LoopBody_To_Merge" condition="more_iterations_needed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.11" name="T_LoopBody_To_Final" location="model/grafcet0072.gcf#T_LoopBody_To_Final" condition="no_more_iterations"/>

    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="C_Init_To_TInit" location="model/grafcet0072.gcf#C_Init_To_TInit" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.1" name="C_TInit_To_BranchA" location="model/grafcet0072.gcf#C_TInit_To_BranchA" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.2" name="C_TInit_To_BranchB" location="model/grafcet0072.gcf#C_TInit_To_BranchB" from="/0/@elements.6" to="/0/@elements.2"/>

    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.3" name="C_BranchA_To_TA" location="model/grafcet0072.gcf#C_BranchA_To_TA" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.4" name="C_TA_To_Merge" location="model/grafcet0072.gcf#C_TA_To_Merge" from="/0/@elements.7" to="/0/@elements.3"/>

    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.5" name="C_BranchB_To_TB" location="model/grafcet0072.gcf#C_BranchB_To_TB" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.6" name="C_TB_To_Merge" location="model/grafcet0072.gcf#C_TB_To_Merge" from="/0/@elements.8" to="/0/@elements.3"/>

    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.7" name="C_Merge_To_TMergeLoop" location="model/grafcet0072.gcf#C_Merge_To_TMergeLoop" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.8" name="C_TMergeLoop_To_LoopBody" location="model/grafcet0072.gcf#C_TMergeLoop_To_LoopBody" from="/0/@elements.9" to="/0/@elements.4"/>

    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.9" name="C_LoopBody_To_TBackMerge" location="model/grafcet0072.gcf#C_LoopBody_To_TBackMerge" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.10" name="C_TBackMerge_To_Merge" location="model/grafcet0072.gcf#C_TBackMerge_To_Merge" from="/0/@elements.10" to="/0/@elements.3"/>

    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.11" name="C_LoopBody_To_TFinal" location="model/grafcet0072.gcf#C_LoopBody_To_TFinal" from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.12" name="C_TFinal_To_FinalStep" location="model/grafcet0072.gcf#C_TFinal_To_FinalStep" from="/0/@elements.11" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>