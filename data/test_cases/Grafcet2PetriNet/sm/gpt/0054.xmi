<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetTest" location="model.gra">

    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="model.gra#s0"
              isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="BranchStep1" location="model.gra#s1"
              isInitial="false" isActive="false" action="branchAction1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="BranchStep2" location="model.gra#s2"
              isInitial="false" isActive="false" action="branchAction2"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="MergeStep" location="model.gra#s3"
              isInitial="false" isActive="false" action="mergeProcessing"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="FinalStep" location="model.gra#s4"
              isInitial="false" isActive="false" action="finalizeSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="TransInitToBranch1" location="model.gra#t0"
              condition="condInitToB1"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="TransInitToBranch2" location="model.gra#t1"
              condition="condInitToB2"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="TransBranch1ToMerge" location="model.gra#t2"
              condition="condB1ToMerge"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="TransBranch2ToMerge" location="model.gra#t3"
              condition="condB2ToMerge"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="TransMergeToFinal" location="model.gra#t4"
              condition="condMergeToFinal"/>

    <!-- Connections: StepToTransition and TransitionToStep -->

    <!-- From initial step to two parallel branch transitions -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0"
                 name="C_Init_to_T0" location="model.gra#c0"
                 grafcet="/0"
                 from="/0/@elements.0"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1"
                 name="C_Init_to_T1" location="model.gra#c1"
                 grafcet="/0"
                 from="/0/@elements.0"
                 to="/0/@elements.6"/>

    <!-- From branch steps to merge transitions -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2"
                 name="C_B1_to_T2" location="model.gra#c2"
                 grafcet="/0"
                 from="/0/@elements.1"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3"
                 name="C_B2_to_T3" location="model.gra#c3"
                 grafcet="/0"
                 from="/0/@elements.2"
                 to="/0/@elements.8"/>

    <!-- From merge step to final transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4"
                 name="C_Merge_to_T4" location="model.gra#c4"
                 grafcet="/0"
                 from="/0/@elements.3"
                 to="/0/@elements.9"/>

    <!-- From transitions to steps: forward flow -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5"
                 name="C_T0_to_B1" location="model.gra#c5"
                 grafcet="/0"
                 from="/0/@elements.5"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6"
                 name="C_T1_to_B2" location="model.gra#c6"
                 grafcet="/0"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7"
                 name="C_T2_to_Merge" location="model.gra#c7"
                 grafcet="/0"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8"
                 name="C_T3_to_Merge" location="model.gra#c8"
                 grafcet="/0"
                 from="/0/@elements.8"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9"
                 name="C_T4_to_Final" location="model.gra#c9"
                 grafcet="/0"
                 from="/0/@elements.9"
                 to="/0/@elements.4"/>

  </Grafcet:Grafcet>
</xmi:XMI>