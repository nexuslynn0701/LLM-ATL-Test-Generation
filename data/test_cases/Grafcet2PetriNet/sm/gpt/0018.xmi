<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="g1" name="ComplexGrafcet0018" location="file.grafcet#ComplexGrafcet0018">

    <!-- Elements: steps and transitions -->
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="s1"
              name="InitStep"
              location="file.grafcet#InitStep"
              isInitial="true"
              isActive="true"
              action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="s2"
              name="ParallelStepA"
              location="file.grafcet#ParallelStepA"
              isInitial="false"
              isActive="false"
              action="executeBranchA"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="s3"
              name="ParallelStepB"
              location="file.grafcet#ParallelStepB"
              isInitial="false"
              isActive="false"
              action="executeBranchB"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="s4"
              name="MergeStep"
              location="file.grafcet#MergeStep"
              isInitial="false"
              isActive="false"
              action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="s5"
              name="LoopStep"
              location="file.grafcet#LoopStep"
              isInitial="false"
              isActive="false"
              action="loopIteration"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t1"
              name="T_init_to_parallel"
              location="file.grafcet#T_init_to_parallel"
              condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t2"
              name="T_parallelA_to_merge"
              location="file.grafcet#T_parallelA_to_merge"
              condition="branchA_done"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t3"
              name="T_parallelB_to_merge"
              location="file.grafcet#T_parallelB_to_merge"
              condition="branchB_done"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t4"
              name="T_merge_to_loop"
              location="file.grafcet#T_merge_to_loop"
              condition="merge_ok"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="t5"
              name="T_loop_cycle"
              location="file.grafcet#T_loop_cycle"
              condition="continueLoop"/>

    <!-- Connections -->
    <!-- InitStep -> T_init_to_parallel -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c1"
                 name="C_Init_to_T1"
                 location="file.grafcet#C_Init_to_T1"
                 from="/0/@elements.0"
                 to="/0/@elements.5"/>

    <!-- T_init_to_parallel -> ParallelStepA -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c2"
                 name="C_T1_to_A"
                 location="file.grafcet#C_T1_to_A"
                 from="/0/@elements.5"
                 to="/0/@elements.1"/>

    <!-- T_init_to_parallel -> ParallelStepB -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c3"
                 name="C_T1_to_B"
                 location="file.grafcet#C_T1_to_B"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>

    <!-- ParallelStepA -> T_parallelA_to_merge -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c4"
                 name="C_A_to_T2"
                 location="file.grafcet#C_A_to_T2"
                 from="/0/@elements.1"
                 to="/0/@elements.6"/>

    <!-- ParallelStepB -> T_parallelB_to_merge -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c5"
                 name="C_B_to_T3"
                 location="file.grafcet#C_B_to_T3"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>

    <!-- T_parallelA_to_merge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c6"
                 name="C_T2_to_Merge"
                 location="file.grafcet#C_T2_to_Merge"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>

    <!-- T_parallelB_to_merge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c7"
                 name="C_T3_to_Merge"
                 location="file.grafcet#C_T3_to_Merge"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>

    <!-- MergeStep -> T_merge_to_loop -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c8"
                 name="C_Merge_to_T4"
                 location="file.grafcet#C_Merge_to_T4"
                 from="/0/@elements.3"
                 to="/0/@elements.8"/>

    <!-- T_merge_to_loop -> LoopStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c9"
                 name="C_T4_to_Loop"
                 location="file.grafcet#C_T4_to_Loop"
                 from="/0/@elements.8"
                 to="/0/@elements.4"/>

    <!-- LoopStep -> T_loop_cycle (back to same step) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="c10"
                 name="C_Loop_to_T5"
                 location="file.grafcet#C_Loop_to_T5"
                 from="/0/@elements.4"
                 to="/0/@elements.9"/>

    <!-- T_loop_cycle -> LoopStep (self-loop) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="c11"
                 name="C_T5_to_Loop"
                 location="file.grafcet#C_T5_to_Loop"
                 from="/0/@elements.9"
                 to="/0/@elements.4"/>

  </Grafcet:Grafcet>
</xmi:XMI>