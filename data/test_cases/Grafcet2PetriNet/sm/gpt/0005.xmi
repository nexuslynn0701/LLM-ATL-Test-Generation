<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g000" name="ComplexGrafcetExample" location="file.grafcet#/"
                   >
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="file.grafcet#/s0"
              isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ParallelStepA1" location="file.grafcet#/s1"
              isInitial="false" isActive="false" action="runBranchA1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ParallelStepA2" location="file.grafcet#/s2"
              isInitial="false" isActive="false" action="runBranchA2"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="JoinStepA" location="file.grafcet#/s3"
              isInitial="false" isActive="false" action="joinBranchesA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="LoopBodyStep" location="file.grafcet#/s4"
              isInitial="false" isActive="false" action="loopBodyAction"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="FinalStep" location="file.grafcet#/s5"
              isInitial="false" isActive="false" action="finalizeSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_init_to_parallel" location="file.grafcet#/t0"
              condition="startCommand"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_parallelA1_to_join" location="file.grafcet#/t1"
              condition="branchA1Done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_parallelA2_to_join" location="file.grafcet#/t2"
              condition="branchA2Done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_join_to_loopBody" location="file.grafcet#/t3"
              condition="allBranchesADone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_loopBody_selfLoop" location="file.grafcet#/t4"
              condition="loopCondition"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_loopBody_to_final" location="file.grafcet#/t5"
              condition="exitLoop"/>

    <!-- Connections: from Steps to Transitions -->
    <!-- InitStep -> T_init_to_parallel -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0"
                 name="C_Init_to_T0" location="file.grafcet#/c0"
                 from="/0/@elements.0" to="/0/@elements.6"/>
    <!-- ParallelStepA1 -> T_parallelA1_to_join -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1"
                 name="C_S1_to_T1" location="file.grafcet#/c1"
                 from="/0/@elements.1" to="/0/@elements.7"/>
    <!-- ParallelStepA2 -> T_parallelA2_to_join -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2"
                 name="C_S2_to_T2" location="file.grafcet#/c2"
                 from="/0/@elements.2" to="/0/@elements.8"/>
    <!-- JoinStepA -> T_join_to_loopBody -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3"
                 name="C_S3_to_T3" location="file.grafcet#/c3"
                 from="/0/@elements.3" to="/0/@elements.9"/>
    <!-- LoopBodyStep -> T_loopBody_selfLoop -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4"
                 name="C_S4_to_T4" location="file.grafcet#/c4"
                 from="/0/@elements.4" to="/0/@elements.10"/>
    <!-- LoopBodyStep -> T_loopBody_to_final -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5"
                 name="C_S4_to_T5" location="file.grafcet#/c5"
                 from="/0/@elements.4" to="/0/@elements.11"/>

    <!-- Connections: from Transitions to Steps -->
    <!-- T_init_to_parallel -> ParallelStepA1 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6"
                 name="C_T0_to_S1" location="file.grafcet#/c6"
                 from="/0/@elements.6" to="/0/@elements.1"/>
    <!-- T_init_to_parallel -> ParallelStepA2 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7"
                 name="C_T0_to_S2" location="file.grafcet#/c7"
                 from="/0/@elements.6" to="/0/@elements.2"/>
    <!-- T_parallelA1_to_join -> JoinStepA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8"
                 name="C_T1_to_S3" location="file.grafcet#/c8"
                 from="/0/@elements.7" to="/0/@elements.3"/>
    <!-- T_parallelA2_to_join -> JoinStepA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9"
                 name="C_T2_to_S3" location="file.grafcet#/c9"
                 from="/0/@elements.8" to="/0/@elements.3"/>
    <!-- T_join_to_loopBody -> LoopBodyStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10"
                 name="C_T3_to_S4" location="file.grafcet#/c10"
                 from="/0/@elements.9" to="/0/@elements.4"/>
    <!-- T_loopBody_selfLoop -> LoopBodyStep (self-loop via transition) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11"
                 name="C_T4_to_S4" location="file.grafcet#/c11"
                 from="/0/@elements.10" to="/0/@elements.4"/>
    <!-- T_loopBody_to_final -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12"
                 name="C_T5_to_S5" location="file.grafcet#/c12"
                 from="/0/@elements.11" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>