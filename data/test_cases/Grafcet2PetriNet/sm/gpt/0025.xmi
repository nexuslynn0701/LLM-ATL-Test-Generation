<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexGrafcet0025" location="file://grafcets/complex_0025.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" name="InitStep" location="file://grafcets/complex_0025.gcf#InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" name="PrepStep" location="file://grafcets/complex_0025.gcf#PrepStep" isInitial="false" isActive="false" action="prepare_cycle"/>
    <elements xsi:type="Grafcet:Step" name="BranchA_Step1" location="file://grafcets/complex_0025.gcf#BranchA_Step1" isInitial="false" isActive="false" action="execute_branch_A_1"/>
    <elements xsi:type="Grafcet:Step" name="BranchA_Step2" location="file://grafcets/complex_0025.gcf#BranchA_Step2" isInitial="false" isActive="false" action="execute_branch_A_2"/>
    <elements xsi:type="Grafcet:Step" name="BranchB_Step1" location="file://grafcets/complex_0025.gcf#BranchB_Step1" isInitial="false" isActive="false" action="execute_branch_B_1"/>
    <elements xsi:type="Grafcet:Step" name="BranchB_Step2" location="file://grafcets/complex_0025.gcf#BranchB_Step2" isInitial="false" isActive="false" action="execute_branch_B_2"/>
    <elements xsi:type="Grafcet:Step" name="MergeStep" location="file://grafcets/complex_0025.gcf#MergeStep" isInitial="false" isActive="false" action="merge_branches"/>
    <elements xsi:type="Grafcet:Step" name="LoopStep" location="file://grafcets/complex_0025.gcf#LoopStep" isInitial="false" isActive="false" action="loop_action"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="file://grafcets/complex_0025.gcf#FinalStep" isInitial="false" isActive="false" action="finalize_system"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" name="T_Init_To_Prep" location="file://grafcets/complex_0025.gcf#T_Init_To_Prep" condition="start_button_pressed"/>
    <elements xsi:type="Grafcet:Transition" name="T_Prep_To_Split" location="file://grafcets/complex_0025.gcf#T_Prep_To_Split" condition="prep_completed"/>
    <elements xsi:type="Grafcet:Transition" name="T_Split_To_BranchA1" location="file://grafcets/complex_0025.gcf#T_Split_To_BranchA1" condition="choose_branch_A"/>
    <elements xsi:type="Grafcet:Transition" name="T_Split_To_BranchB1" location="file://grafcets/complex_0025.gcf#T_Split_To_BranchB1" condition="choose_branch_B"/>
    <elements xsi:type="Grafcet:Transition" name="T_BranchA1_To_A2" location="file://grafcets/complex_0025.gcf#T_BranchA1_To_A2" condition="A1_done"/>
    <elements xsi:type="Grafcet:Transition" name="T_BranchB1_To_B2" location="file://grafcets/complex_0025.gcf#T_BranchB1_To_B2" condition="B1_done"/>
    <elements xsi:type="Grafcet:Transition" name="T_A2_To_Merge" location="file://grafcets/complex_0025.gcf#T_A2_To_Merge" condition="A2_done"/>
    <elements xsi:type="Grafcet:Transition" name="T_B2_To_Merge" location="file://grafcets/complex_0025.gcf#T_B2_To_Merge" condition="B2_done"/>
    <elements xsi:type="Grafcet:Transition" name="T_Merge_To_Loop" location="file://grafcets/complex_0025.gcf#T_Merge_To_Loop" condition="both_branches_done"/>
    <elements xsi:type="Grafcet:Transition" name="T_Loop_Back" location="file://grafcets/complex_0025.gcf#T_Loop_Back" condition="loop_again"/>
    <elements xsi:type="Grafcet:Transition" name="T_Loop_To_Final" location="file://grafcets/complex_0025.gcf#T_Loop_To_Final" condition="finish_requested"/>

    <!-- Connections (indexing of elements starts at 0 in the order above) -->
    <!-- 0: InitStep, 1: PrepStep, 2: BranchA_Step1, 3: BranchA_Step2, 4: BranchB_Step1, 5: BranchB_Step2, 6: MergeStep, 7: LoopStep, 8: FinalStep -->
    <!-- 9: T_Init_To_Prep, 10: T_Prep_To_Split, 11: T_Split_To_BranchA1, 12: T_Split_To_BranchB1, 13: T_BranchA1_To_A2, 14: T_BranchB1_To_B2, 15: T_A2_To_Merge, 16: T_B2_To_Merge, 17: T_Merge_To_Loop, 18: T_Loop_Back, 19: T_Loop_To_Final -->

    <!-- InitStep -> T_Init_To_Prep -> PrepStep -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_to_TInitPrep" location="file://grafcets/complex_0025.gcf#C_Init_to_TInitPrep" from="/0/@elements.0" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TInitPrep_to_Prep" location="file://grafcets/complex_0025.gcf#C_TInitPrep_to_Prep" from="/0/@elements.9" to="/0/@elements.1"/>

    <!-- PrepStep -> T_Prep_To_Split -> BranchA_Step1 (fan-out via two transitions) -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Prep_to_TPrepSplit" location="file://grafcets/complex_0025.gcf#C_Prep_to_TPrepSplit" from="/0/@elements.1" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TPrepSplit_to_BranchA1" location="file://grafcets/complex_0025.gcf#C_TPrepSplit_to_BranchA1" from="/0/@elements.10" to="/0/@elements.2"/>

    <!-- Additional split: PrepStep to BranchB via alternate path -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Prep_to_TSplitA" location="file://grafcets/complex_0025.gcf#C_Prep_to_TSplitA" from="/0/@elements.1" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Prep_to_TSplitB" location="file://grafcets/complex_0025.gcf#C_Prep_to_TSplitB" from="/0/@elements.1" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TSplitA_to_BranchA1" location="file://grafcets/complex_0025.gcf#C_TSplitA_to_BranchA1" from="/0/@elements.11" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TSplitB_to_BranchB1" location="file://grafcets/complex_0025.gcf#C_TSplitB_to_BranchB1" from="/0/@elements.12" to="/0/@elements.4"/>

    <!-- Branch A path: BranchA_Step1 -> T_BranchA1_To_A2 -> BranchA_Step2 -> T_A2_To_Merge -> MergeStep -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_A1_to_TA1A2" location="file://grafcets/complex_0025.gcf#C_A1_to_TA1A2" from="/0/@elements.2" to="/0/@elements.13"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TA1A2_to_A2" location="file://grafcets/complex_0025.gcf#C_TA1A2_to_A2" from="/0/@elements.13" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_A2_to_TA2Merge" location="file://grafcets/complex_0025.gcf#C_A2_to_TA2Merge" from="/0/@elements.3" to="/0/@elements.15"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TA2Merge_to_Merge" location="file://grafcets/complex_0025.gcf#C_TA2Merge_to_Merge" from="/0/@elements.15" to="/0/@elements.6"/>

    <!-- Branch B path: BranchB_Step1 -> T_BranchB1_To_B2 -> BranchB_Step2 -> T_B2_To_Merge -> MergeStep -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_B1_to_TB1B2" location="file://grafcets/complex_0025.gcf#C_B1_to_TB1B2" from="/0/@elements.4" to="/0/@elements.14"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TB1B2_to_B2" location="file://grafcets/complex_0025.gcf#C_TB1B2_to_B2" from="/0/@elements.14" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_B2_to_TB2Merge" location="file://grafcets/complex_0025.gcf#C_B2_to_TB2Merge" from="/0/@elements.5" to="/0/@elements.16"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TB2Merge_to_Merge" location="file://grafcets/complex_0025.gcf#C_TB2Merge_to_Merge" from="/0/@elements.16" to="/0/@elements.6"/>

    <!-- Merge -> T_Merge_To_Loop -> LoopStep -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Merge_to_TMergeLoop" location="file://grafcets/complex_0025.gcf#C_Merge_to_TMergeLoop" from="/0/@elements.6" to="/0/@elements.17"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TMergeLoop_to_Loop" location="file://grafcets/complex_0025.gcf#C_TMergeLoop_to_Loop" from="/0/@elements.17" to="/0/@elements.7"/>

    <!-- Loop structure: LoopStep -> T_Loop_Back -> MergeStep -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Loop_to_TLoopBack" location="file://grafcets/complex_0025.gcf#C_Loop_to_TLoopBack" from="/0/@elements.7" to="/0/@elements.18"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TLoopBack_to_Merge" location="file://grafcets/complex_0025.gcf#C_TLoopBack_to_Merge" from="/0/@elements.18" to="/0/@elements.6"/>

    <!-- Exit from loop to final: LoopStep -> T_Loop_To_Final -> FinalStep -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Loop_to_TLoopFinal" location="file://grafcets/complex_0025.gcf#C_Loop_to_TLoopFinal" from="/0/@elements.7" to="/0/@elements.19"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_TLoopFinal_to_Final" location="file://grafcets/complex_0025.gcf#C_TLoopFinal_to_Final" from="/0/@elements.19" to="/0/@elements.8"/>
  </Grafcet:Grafcet>
</xmi:XMI>