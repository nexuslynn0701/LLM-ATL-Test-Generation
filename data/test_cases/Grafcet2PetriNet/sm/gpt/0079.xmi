<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet0079" location="file://complex_grafcet_0079">

    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="InitStep"
              location="file://complex_grafcet_0079#s1"
              isInitial="true"
              isActive="true"
              action="initializeSystem"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="LoadConfig"
              location="file://complex_grafcet_0079#s2"
              isInitial="false"
              isActive="false"
              action="loadConfiguration"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              name="RunPrimary"
              location="file://complex_grafcet_0079#s3"
              isInitial="false"
              isActive="false"
              action="runPrimaryCycle"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_s4"
              name="RunSecondary"
              location="file://complex_grafcet_0079#s4"
              isInitial="false"
              isActive="false"
              action="runSecondaryCycle"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_s5"
              name="ErrorHandler"
              location="file://complex_grafcet_0079#s5"
              isInitial="false"
              isActive="false"
              action="handleError"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_s6"
              name="Shutdown"
              location="file://complex_grafcet_0079#s6"
              isInitial="false"
              isActive="false"
              action="performShutdown"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="T_InitToLoad"
              location="file://complex_grafcet_0079#t1"
              condition="startPressed"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="T_LoadToRun"
              location="file://complex_grafcet_0079#t2"
              condition="configLoaded"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t3"
              name="T_RunToSecondary"
              location="file://complex_grafcet_0079#t3"
              condition="secondaryRequested"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t4"
              name="T_SecondaryToRun"
              location="file://complex_grafcet_0079#t4"
              condition="secondaryCompleted"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t5"
              name="T_RunToError"
              location="file://complex_grafcet_0079#t5"
              condition="faultDetected"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t6"
              name="T_ErrorToShutdown"
              location="file://complex_grafcet_0079#t6"
              condition="abortConfirmed"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t7"
              name="T_ShutdownToInit"
              location="file://complex_grafcet_0079#t7"
              condition="resetPressed"/>

    <!-- Connections: StepToTransition and TransitionToStep -->

    <!-- InitStep -> T_InitToLoad -> LoadConfig -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c1"
                 name="C_Init_to_T1"
                 location="file://complex_grafcet_0079#c1"
                 from="/0/@elements.0"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c2"
                 name="C_T1_to_Load"
                 location="file://complex_grafcet_0079#c2"
                 from="/0/@elements.6"
                 to="/0/@elements.1"/>

    <!-- LoadConfig -> T_LoadToRun -> RunPrimary -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 name="C_Load_to_T2"
                 location="file://complex_grafcet_0079#c3"
                 from="/0/@elements.1"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c4"
                 name="C_T2_to_Run"
                 location="file://complex_grafcet_0079#c4"
                 from="/0/@elements.7"
                 to="/0/@elements.2"/>

    <!-- RunPrimary -> T_RunToSecondary -> RunSecondary -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c5"
                 name="C_Run_to_T3"
                 location="file://complex_grafcet_0079#c5"
                 from="/0/@elements.2"
                 to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c6"
                 name="C_T3_to_Secondary"
                 location="file://complex_grafcet_0079#c6"
                 from="/0/@elements.8"
                 to="/0/@elements.3"/>

    <!-- RunSecondary -> T_SecondaryToRun -> RunPrimary -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c7"
                 name="C_Secondary_to_T4"
                 location="file://complex_grafcet_0079#c7"
                 from="/0/@elements.3"
                 to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c8"
                 name="C_T4_to_Run"
                 location="file://complex_grafcet_0079#c8"
                 from="/0/@elements.9"
                 to="/0/@elements.2"/>

    <!-- RunPrimary -> T_RunToError -> ErrorHandler -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c9"
                 name="C_Run_to_T5"
                 location="file://complex_grafcet_0079#c9"
                 from="/0/@elements.2"
                 to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c10"
                 name="C_T5_to_Error"
                 location="file://complex_grafcet_0079#c10"
                 from="/0/@elements.10"
                 to="/0/@elements.4"/>

    <!-- ErrorHandler -> T_ErrorToShutdown -> Shutdown -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c11"
                 name="C_Error_to_T6"
                 location="file://complex_grafcet_0079#c11"
                 from="/0/@elements.4"
                 to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c12"
                 name="C_T6_to_Shutdown"
                 location="file://complex_grafcet_0079#c12"
                 from="/0/@elements.11"
                 to="/0/@elements.5"/>

    <!-- Shutdown -> T_ShutdownToInit -> InitStep (loop back to initial) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c13"
                 name="C_Shutdown_to_T7"
                 location="file://complex_grafcet_0079#c13"
                 from="/0/@elements.5"
                 to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c14"
                 name="C_T7_to_Init"
                 location="file://complex_grafcet_0079#c14"
                 from="/0/@elements.12"
                 to="/0/@elements.0"/>

  </Grafcet:Grafcet>
</xmi:XMI>