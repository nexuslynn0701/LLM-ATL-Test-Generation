<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexGrafcet" location="file://complex_grafcet.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" name="InitStep" location="file://complex_grafcet.grafcet#InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" name="CheckSensors" location="file://complex_grafcet.grafcet#CheckSensors" isInitial="false" isActive="false" action="verifySensors"/>
    <elements xsi:type="Grafcet:Step" name="ProcessData" location="file://complex_grafcet.grafcet#ProcessData" isInitial="false" isActive="false" action="computeResults"/>
    <elements xsi:type="Grafcet:Step" name="ErrorHandler" location="file://complex_grafcet.grafcet#ErrorHandler" isInitial="false" isActive="false" action="handleError"/>
    <elements xsi:type="Grafcet:Step" name="Finalize" location="file://complex_grafcet.grafcet#Finalize" isInitial="false" isActive="false" action="shutdownSystem"/>
    <elements xsi:type="Grafcet:Step" name="LoopBack" location="file://complex_grafcet.grafcet#LoopBack" isInitial="false" isActive="false" action="resetCycle"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" name="T_InitToCheck" location="file://complex_grafcet.grafcet#T_InitToCheck" condition="startCommandReceived"/>
    <elements xsi:type="Grafcet:Transition" name="T_CheckToProcess" location="file://complex_grafcet.grafcet#T_CheckToProcess" condition="sensorsOK"/>
    <elements xsi:type="Grafcet:Transition" name="T_CheckToError" location="file://complex_grafcet.grafcet#T_CheckToError" condition="sensorsFailed"/>
    <elements xsi:type="Grafcet:Transition" name="T_ProcessToFinalize" location="file://complex_grafcet.grafcet#T_ProcessToFinalize" condition="processingComplete"/>
    <elements xsi:type="Grafcet:Transition" name="T_ProcessToError" location="file://complex_grafcet.grafcet#T_ProcessToError" condition="processingError"/>
    <elements xsi:type="Grafcet:Transition" name="T_ErrorToFinalize" location="file://complex_grafcet.grafcet#T_ErrorToFinalize" condition="errorAcknowledged"/>
    <elements xsi:type="Grafcet:Transition" name="T_FinalizeToLoop" location="file://complex_grafcet.grafcet#T_FinalizeToLoop" condition="restartRequested"/>
    <elements xsi:type="Grafcet:Transition" name="T_LoopToInit" location="file://complex_grafcet.grafcet#T_LoopToInit" condition="loopComplete"/>

    <!-- Connections: indices of elements -->
    <!-- 0: InitStep (Step) -->
    <!-- 1: CheckSensors (Step) -->
    <!-- 2: ProcessData (Step) -->
    <!-- 3: ErrorHandler (Step) -->
    <!-- 4: Finalize (Step) -->
    <!-- 5: LoopBack (Step) -->
    <!-- 6: T_InitToCheck (Transition) -->
    <!-- 7: T_CheckToProcess (Transition) -->
    <!-- 8: T_CheckToError (Transition) -->
    <!-- 9: T_ProcessToFinalize (Transition) -->
    <!-- 10: T_ProcessToError (Transition) -->
    <!-- 11: T_ErrorToFinalize (Transition) -->
    <!-- 12: T_FinalizeToLoop (Transition) -->
    <!-- 13: T_LoopToInit (Transition) -->

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_to_T_InitToCheck" location="file://complex_grafcet.grafcet#C_Init_to_T_InitToCheck" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Check_to_T_CheckToProcess" location="file://complex_grafcet.grafcet#C_Check_to_T_CheckToProcess" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Check_to_T_CheckToError" location="file://complex_grafcet.grafcet#C_Check_to_T_CheckToError" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Process_to_T_ProcessToFinalize" location="file://complex_grafcet.grafcet#C_Process_to_T_ProcessToFinalize" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Process_to_T_ProcessToError" location="file://complex_grafcet.grafcet#C_Process_to_T_ProcessToError" from="/0/@elements.2" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Error_to_T_ErrorToFinalize" location="file://complex_grafcet.grafcet#C_Error_to_T_ErrorToFinalize" from="/0/@elements.3" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Finalize_to_T_FinalizeToLoop" location="file://complex_grafcet.grafcet#C_Finalize_to_T_FinalizeToLoop" from="/0/@elements.4" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C_Loop_to_T_LoopToInit" location="file://complex_grafcet.grafcet#C_Loop_to_T_LoopToInit" from="/0/@elements.5" to="/0/@elements.13"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_InitToCheck_to_Check" location="file://complex_grafcet.grafcet#C_T_InitToCheck_to_Check" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_CheckToProcess_to_Process" location="file://complex_grafcet.grafcet#C_T_CheckToProcess_to_Process" from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_CheckToError_to_Error" location="file://complex_grafcet.grafcet#C_T_CheckToError_to_Error" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_ProcessToFinalize_to_Finalize" location="file://complex_grafcet.grafcet#C_T_ProcessToFinalize_to_Finalize" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_ProcessToError_to_Error" location="file://complex_grafcet.grafcet#C_T_ProcessToError_to_Error" from="/0/@elements.10" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_ErrorToFinalize_to_Finalize" location="file://complex_grafcet.grafcet#C_T_ErrorToFinalize_to_Finalize" from="/0/@elements.11" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_FinalizeToLoop_to_Loop" location="file://complex_grafcet.grafcet#C_T_FinalizeToLoop_to_Loop" from="/0/@elements.12" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_T_LoopToInit_to_Init" location="file://complex_grafcet.grafcet#C_T_LoopToInit_to_Init" from="/0/@elements.13" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>