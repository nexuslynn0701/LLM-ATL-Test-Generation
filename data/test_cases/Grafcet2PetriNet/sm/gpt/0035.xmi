<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet" location="file://complex.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="file://complex.grafcet#S0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="CheckSensors" location="file://complex.grafcet#S1" isInitial="false" isActive="false" action="verifyInputs"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="Processing" location="file://complex.grafcet#S2" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="ErrorHandler" location="file://complex.grafcet#S3" isInitial="false" isActive="false" action="handleError"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="Finalize" location="file://complex.grafcet#S4" isInitial="false" isActive="false" action="finalizeSequence"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S5" name="LoopBack" location="file://complex.grafcet#S5" isInitial="false" isActive="false" action="resetFlags"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_InitToCheck" location="file://complex.grafcet#T0" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_CheckToProcess" location="file://complex.grafcet#T1" condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_CheckToError" location="file://complex.grafcet#T2" condition="sensors_fail"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="T_ProcessToFinalize" location="file://complex.grafcet#T3" condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" name="T_ErrorToLoop" location="file://complex.grafcet#T4" condition="error_cleared"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T5" name="T_LoopToInit" location="file://complex.grafcet#T5" condition="restart_requested"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T6" name="T_FinalizeToInit" location="file://complex.grafcet#T6" condition="auto_restart"/>

    <!-- Connections: linear, branching, merging, and loopback -->
    <!-- InitStep -> T_InitToCheck -> CheckSensors -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_S0_T0" location="file://complex.grafcet#C0" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="C_T0_S1" location="file://complex.grafcet#C1" from="/0/@elements.6" to="/0/@elements.1"/>

    <!-- CheckSensors -> T_CheckToProcess -> Processing -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="C_S1_T1" location="file://complex.grafcet#C2" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C3" name="C_T1_S2" location="file://complex.grafcet#C3" from="/0/@elements.7" to="/0/@elements.2"/>

    <!-- CheckSensors -> T_CheckToError -> ErrorHandler (branch) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_S1_T2" location="file://complex.grafcet#C4" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="C_T2_S3" location="file://complex.grafcet#C5" from="/0/@elements.8" to="/0/@elements.3"/>

    <!-- Processing -> T_ProcessToFinalize -> Finalize -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" name="C_S2_T3" location="file://complex.grafcet#C6" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="C_T3_S4" location="file://complex.grafcet#C7" from="/0/@elements.9" to="/0/@elements.4"/>

    <!-- ErrorHandler -> T_ErrorToLoop -> LoopBack -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C8" name="C_S3_T4" location="file://complex.grafcet#C8" from="/0/@elements.3" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C9" name="C_T4_S5" location="file://complex.grafcet#C9" from="/0/@elements.10" to="/0/@elements.5"/>

    <!-- LoopBack -> T_LoopToInit -> InitStep (loop) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C10" name="C_S5_T5" location="file://complex.grafcet#C10" from="/0/@elements.5" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C11" name="C_T5_S0" location="file://complex.grafcet#C11" from="/0/@elements.11" to="/0/@elements.0"/>

    <!-- Finalize -> T_FinalizeToInit -> InitStep (alternative restart path) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C12" name="C_S4_T6" location="file://complex.grafcet#C12" from="/0/@elements.4" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C13" name="C_T6_S0" location="file://complex.grafcet#C13" from="/0/@elements.12" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>