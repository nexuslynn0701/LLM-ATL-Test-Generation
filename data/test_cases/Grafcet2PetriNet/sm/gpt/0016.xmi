<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet" location="loc_grafcet_001">

    <!-- Elements: 5 Steps + 3 Transitions = 8 elements -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="loc_step_0"
              isInitial="true" isActive="true" action="initAction()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="BranchStep1" location="loc_step_1"
              isInitial="false" isActive="false" action="branchAction1()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="BranchStep2" location="loc_step_2"
              isInitial="false" isActive="false" action="branchAction2()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="MergeStep" location="loc_step_3"
              isInitial="false" isActive="false" action="mergeAction()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="FinalStep" location="loc_step_4"
              isInitial="false" isActive="false" action="finalAction()"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="SplitTransition" location="loc_trans_0"
              condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="JoinTransition" location="loc_trans_1"
              condition="y == 1"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="FinalTransition" location="loc_trans_2"
              condition="done"/>

    <!-- Connections:
         S0 -> T0
         T0 -> S1, T0 -> S2  (fan-out)
         S1 -> T1, S2 -> T1  (fan-in)
         T1 -> S3
         S3 -> T2
         T2 -> S4
    -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0"
                 name="C_S0_T0" location="loc_conn_0"
                 from="/0/@elements.0"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1"
                 name="C_T0_S1" location="loc_conn_1"
                 from="/0/@elements.5"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C2"
                 name="C_T0_S2" location="loc_conn_2"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3"
                 name="C_S1_T1" location="loc_conn_3"
                 from="/0/@elements.1"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4"
                 name="C_S2_T1" location="loc_conn_4"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5"
                 name="C_T1_S3" location="loc_conn_5"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6"
                 name="C_S3_T2" location="loc_conn_6"
                 from="/0/@elements.3"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7"
                 name="C_T2_S4" location="loc_conn_7"
                 from="/0/@elements.7"
                 to="/0/@elements.4"/>

  </Grafcet:Grafcet>
</xmi:XMI>