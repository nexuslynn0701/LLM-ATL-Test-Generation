<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet0034" location="file://testcases/grafcet0034.gra">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="1,1" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ParallelStepA1" location="2,1" isInitial="false" isActive="false" action="run_branch_A1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ParallelStepA2" location="2,2" isInitial="false" isActive="false" action="run_branch_A2"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="JoinStepA" location="3,1" isInitial="false" isActive="false" action="join_branch_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="IntermediateStepB" location="4,1" isInitial="false" isActive="false" action="process_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="BranchB1" location="5,1" isInitial="false" isActive="false" action="branch_B1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" name="BranchB2" location="5,2" isInitial="false" isActive="false" action="branch_B2"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s7" name="RejoinB" location="6,1" isInitial="false" isActive="false" action="rejoin_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s8" name="FinalStep" location="7,1" isInitial="false" isActive="false" action="shutdown_system"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_to_A" location="1.5,1" condition="start_button_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_A_to_Parallel" location="2.5,1.5" condition="mode_A_selected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_A1_to_JoinA" location="2.8,1" condition="A1_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_A2_to_JoinA" location="2.8,2" condition="A2_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_JoinA_to_B" location="3.5,1" condition="all_A_paths_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_B_to_Branches" location="4.5,1" condition="branching_condition_B"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="T_B1_to_RejoinB" location="5.5,1" condition="B1_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t7" name="T_B2_to_RejoinB" location="5.5,2" condition="B2_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t8" name="T_RejoinB_to_Final" location="6.5,1" condition="all_B_paths_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t9" name="T_Final_to_Init" location="7.5,1" condition="reset_request"/>

    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- Initial step to first transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="1.25,1" grafcet="/0" from="/0/@elements.0" to="/0/@elements.9"/>
    <!-- Transition T0 to ParallelStepA1 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="C_T0_to_A1" location="1.75,1" grafcet="/0" from="/0/@elements.9" to="/0/@elements.1"/>
    <!-- ParallelStepA1 to Transition T1 (fan-out start) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_A1_to_T1" location="2.25,1.3" grafcet="/0" from="/0/@elements.1" to="/0/@elements.10"/>
    <!-- Transition T1 to ParallelStepA1 (self path in parallel branch) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="C_T1_to_A1" location="2.75,1.3" grafcet="/0" from="/0/@elements.10" to="/0/@elements.1"/>
    <!-- ParallelStepA1 to Transition T2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_A1_to_T2" location="2.4,1" grafcet="/0" from="/0/@elements.1" to="/0/@elements.11"/>
    <!-- ParallelStepA2 to Transition T3 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_A2_to_T3" location="2.4,2" grafcet="/0" from="/0/@elements.2" to="/0/@elements.12"/>
    <!-- Transition T2 to JoinStepA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="C_T2_to_JoinA" location="3.0,1" grafcet="/0" from="/0/@elements.11" to="/0/@elements.3"/>
    <!-- Transition T3 to JoinStepA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_T3_to_JoinA" location="3.0,1.8" grafcet="/0" from="/0/@elements.12" to="/0/@elements.3"/>

    <!-- JoinStepA to Transition T4 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="C_JoinA_to_T4" location="3.25,1" grafcet="/0" from="/0/@elements.3" to="/0/@elements.13"/>
    <!-- Transition T4 to IntermediateStepB -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_T4_to_B" location="3.75,1" grafcet="/0" from="/0/@elements.13" to="/0/@elements.4"/>

    <!-- IntermediateStepB to Transition T5 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c10" name="C_B_to_T5" location="4.25,1" grafcet="/0" from="/0/@elements.4" to="/0/@elements.14"/>
    <!-- Transition T5 to BranchB1 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_T5_to_B1" location="4.75,1" grafcet="/0" from="/0/@elements.14" to="/0/@elements.5"/>
    <!-- Transition T5 to BranchB2 (fan-out) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_T5_to_B2" location="4.75,1.5" grafcet="/0" from="/0/@elements.14" to="/0/@elements.6"/>

    <!-- BranchB1 to Transition T6 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c13" name="C_B1_to_T6" location="5.25,1" grafcet="/0" from="/0/@elements.5" to="/0/@elements.15"/>
    <!-- BranchB2 to Transition T7 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c14" name="C_B2_to_T7" location="5.25,2" grafcet="/0" from="/0/@elements.6" to="/0/@elements.16"/>

    <!-- Transition T6 to RejoinB -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c15" name="C_T6_to_RejoinB" location="5.75,1" grafcet="/0" from="/0/@elements.15" to="/0/@elements.7"/>
    <!-- Transition T7 to RejoinB -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c16" name="C_T7_to_RejoinB" location="5.75,1.8" grafcet="/0" from="/0/@elements.16" to="/0/@elements.7"/>

    <!-- RejoinB to Transition T8 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c17" name="C_RejoinB_to_T8" location="6.25,1" grafcet="/0" from="/0/@elements.7" to="/0/@elements.17"/>
    <!-- Transition T8 to FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c18" name="C_T8_to_Final" location="6.75,1" grafcet="/0" from="/0/@elements.17" to="/0/@elements.8"/>

    <!-- FinalStep to Transition T9 (loop back) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c19" name="C_Final_to_T9" location="7.25,1" grafcet="/0" from="/0/@elements.8" to="/0/@elements.18"/>
    <!-- Transition T9 back to InitStep (closing loop) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c20" name="C_T9_to_Init" location="7.75,1" grafcet="/0" from="/0/@elements.18" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>