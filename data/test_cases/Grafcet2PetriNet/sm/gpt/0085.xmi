<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcetExample" location="file://complex.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="file://complex.grafcet#S0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="CheckSensors" location="file://complex.grafcet#S1" isInitial="false" isActive="false" action="checkSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="BranchA" location="file://complex.grafcet#S2" isInitial="false" isActive="false" action="processBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="BranchB" location="file://complex.grafcet#S3" isInitial="false" isActive="false" action="processBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="MergeStep" location="file://complex.grafcet#S4" isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S5" name="LoopStep" location="file://complex.grafcet#S5" isInitial="false" isActive="false" action="loopProcessing"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S6" name="FinalStep" location="file://complex.grafcet#S6" isInitial="false" isActive="false" action="finalizeSystem"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_InitToCheck" location="file://complex.grafcet#T0" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_CheckToBranchA" location="file://complex.grafcet#T1" condition="sensorModeA"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_CheckToBranchB" location="file://complex.grafcet#T2" condition="sensorModeB"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="T_BranchAToMerge" location="file://complex.grafcet#T3" condition="branchACompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" name="T_BranchBToMerge" location="file://complex.grafcet#T4" condition="branchBCompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T5" name="T_MergeToLoop" location="file://complex.grafcet#T5" condition="bothBranchesDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T6" name="T_LoopToSelf" location="file://complex.grafcet#T6" condition="needMoreIterations"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T7" name="T_LoopToFinal" location="file://complex.grafcet#T7" condition="loopCompleted"/>
    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_Init_S0_T0" location="file://complex.grafcet#C0" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C1" name="C_Check_S1_T1" location="file://complex.grafcet#C1" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="C_Check_S1_T2" location="file://complex.grafcet#C2" from="/0/@elements.1" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="C_BranchA_S2_T3" location="file://complex.grafcet#C3" from="/0/@elements.2" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_BranchB_S3_T4" location="file://complex.grafcet#C4" from="/0/@elements.3" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C5" name="C_Merge_S4_T5" location="file://complex.grafcet#C5" from="/0/@elements.4" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" name="C_Loop_S5_T6" location="file://complex.grafcet#C6" from="/0/@elements.5" to="/0/@elements.13"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C7" name="C_Loop_S5_T7" location="file://complex.grafcet#C7" from="/0/@elements.5" to="/0/@elements.14"/>
    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C8" name="C_T0_S1" location="file://complex.grafcet#C8" from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C9" name="C_T1_S2" location="file://complex.grafcet#C9" from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C10" name="C_T2_S3" location="file://complex.grafcet#C10" from="/0/@elements.9" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C11" name="C_T3_S4" location="file://complex.grafcet#C11" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C12" name="C_T4_S4" location="file://complex.grafcet#C12" from="/0/@elements.11" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C13" name="C_T5_S5" location="file://complex.grafcet#C13" from="/0/@elements.12" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C14" name="C_T6_S5" location="file://complex.grafcet#C14" from="/0/@elements.13" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C15" name="C_T7_S6" location="file://complex.grafcet#C15" from="/0/@elements.14" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>