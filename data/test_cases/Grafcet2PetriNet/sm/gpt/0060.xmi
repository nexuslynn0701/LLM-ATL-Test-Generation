<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet0060" location="file://grafcets/0060.grafcet">
    <!-- Elements: 5 Steps + 4 Transitions -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_S0"
              name="InitStep"
              location="line:1"
              isInitial="true"
              isActive="true"
              action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_S1"
              name="BranchA"
              location="line:5"
              isInitial="false"
              isActive="false"
              action="processBranchA"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_S2"
              name="BranchB"
              location="line:9"
              isInitial="false"
              isActive="false"
              action="processBranchB"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_S3"
              name="MergeStep"
              location="line:13"
              isInitial="false"
              isActive="false"
              action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_S4"
              name="FinalStep"
              location="line:17"
              isInitial="false"
              isActive="false"
              action="finalizeSequence"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T0"
              name="T_Init_To_Branches"
              location="line:3"
              condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T1"
              name="T_BranchA_To_Merge"
              location="line:7"
              condition="branchADone"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T2"
              name="T_BranchB_To_Merge"
              location="line:11"
              condition="branchBDone"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T3"
              name="T_Merge_To_Final"
              location="line:15"
              condition="mergeComplete"/>
    <!-- Connections: parallel fan-out from Init, join at Merge, then to Final -->
    <!-- InitStep -> T_Init_To_Branches -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C0"
                 name="C_Init_to_T0"
                 location="line:2"
                 from="/0/@elements.0"
                 to="/0/@elements.5"/>
    <!-- T_Init_To_Branches -> BranchA -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C1"
                 name="C_T0_to_BranchA"
                 location="line:4"
                 from="/0/@elements.5"
                 to="/0/@elements.1"/>
    <!-- T_Init_To_Branches -> BranchB -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C2"
                 name="C_T0_to_BranchB"
                 location="line:4b"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <!-- BranchA -> T_BranchA_To_Merge -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C3"
                 name="C_BranchA_to_T1"
                 location="line:6"
                 from="/0/@elements.1"
                 to="/0/@elements.6"/>
    <!-- BranchB -> T_BranchB_To_Merge -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C4"
                 name="C_BranchB_to_T2"
                 location="line:10"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>
    <!-- T_BranchA_To_Merge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C5"
                 name="C_T1_to_Merge"
                 location="line:8"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>
    <!-- T_BranchB_To_Merge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C6"
                 name="C_T2_to_Merge"
                 location="line:12"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
    <!-- MergeStep -> T_Merge_To_Final -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C7"
                 name="C_Merge_to_T3"
                 location="line:14"
                 from="/0/@elements.3"
                 to="/0/@elements.8"/>
    <!-- T_Merge_To_Final -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C8"
                 name="C_T3_to_Final"
                 location="line:16"
                 from="/0/@elements.8"
                 to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>