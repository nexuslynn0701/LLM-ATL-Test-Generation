<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet0037" location="file:///models/grafcet0037.gcf">
    <!-- Elements: Steps and Transitions -->
    <!-- Steps -->
    <elements xmi:id="_s0" xsi:type="Grafcet:Step" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xmi:id="_s1" xsi:type="Grafcet:Step" name="ParallelStepA" location="2:1-2:30" isInitial="false" isActive="false" action="executeBranchA"/>
    <elements xmi:id="_s2" xsi:type="Grafcet:Step" name="ParallelStepB" location="3:1-3:30" isInitial="false" isActive="false" action="executeBranchB"/>
    <elements xmi:id="_s3" xsi:type="Grafcet:Step" name="MergeStep" location="4:1-4:30" isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xmi:id="_s4" xsi:type="Grafcet:Step" name="LoopStep" location="5:1-5:30" isInitial="false" isActive="false" action="handleLoop"/>
    <elements xmi:id="_s5" xsi:type="Grafcet:Step" name="FinalStep" location="6:1-6:25" isInitial="false" isActive="false" action="shutdownSystem"/>
    <!-- Transitions -->
    <elements xmi:id="_t0" xsi:type="Grafcet:Transition" name="T_Init_To_Parallel" location="10:1-10:40" condition="startSignal"/>
    <elements xmi:id="_t1" xsi:type="Grafcet:Transition" name="T_Init_To_BranchB" location="11:1-11:40" condition="startAndAltBranch"/>
    <elements xmi:id="_t2" xsi:type="Grafcet:Transition" name="T_A_To_Merge" location="12:1-12:35" condition="branchAComplete"/>
    <elements xmi:id="_t3" xsi:type="Grafcet:Transition" name="T_B_To_Merge" location="13:1-13:35" condition="branchBComplete"/>
    <elements xmi:id="_t4" xsi:type="Grafcet:Transition" name="T_Merge_To_Loop" location="14:1-14:40" condition="bothBranchesDone"/>
    <elements xmi:id="_t5" xsi:type="Grafcet:Transition" name="T_Loop_Self" location="15:1-15:35" condition="loopCondition"/>
    <elements xmi:id="_t6" xsi:type="Grafcet:Transition" name="T_Loop_To_Final" location="16:1-16:40" condition="loopExit"/>
    <!-- Connections -->
    <!-- From initial step to parallel transitions (fan-out) -->
    <connections xmi:id="_c0" xsi:type="Grafcet:StepToTransition" name="C_Init_T0" location="20:1-20:30" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xmi:id="_c1" xsi:type="Grafcet:StepToTransition" name="C_Init_T1" location="21:1-21:30" from="/0/@elements.0" to="/0/@elements.7"/>
    <!-- From transitions to parallel steps -->
    <connections xmi:id="_c2" xsi:type="Grafcet:TransitionToStep" name="C_T0_S1" location="22:1-22:30" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xmi:id="_c3" xsi:type="Grafcet:TransitionToStep" name="C_T1_S2" location="23:1-23:30" from="/0/@elements.7" to="/0/@elements.2"/>
    <!-- From parallel steps to merge transitions -->
    <connections xmi:id="_c4" xsi:type="Grafcet:StepToTransition" name="C_S1_T2" location="24:1-24:30" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xmi:id="_c5" xsi:type="Grafcet:StepToTransition" name="C_S2_T3" location="25:1-25:30" from="/0/@elements.2" to="/0/@elements.9"/>
    <!-- From merge transitions to merge step (fan-in) -->
    <connections xmi:id="_c6" xsi:type="Grafcet:TransitionToStep" name="C_T2_S3" location="26:1-26:30" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xmi:id="_c7" xsi:type="Grafcet:TransitionToStep" name="C_T3_S3" location="27:1-27:30" from="/0/@elements.9" to="/0/@elements.3"/>
    <!-- From merge step to loop transition -->
    <connections xmi:id="_c8" xsi:type="Grafcet:StepToTransition" name="C_S3_T4" location="28:1-28:30" from="/0/@elements.3" to="/0/@elements.10"/>
    <!-- From loop transition to loop step -->
    <connections xmi:id="_c9" xsi:type="Grafcet:TransitionToStep" name="C_T4_S4" location="29:1-29:30" from="/0/@elements.10" to="/0/@elements.4"/>
    <!-- Self-loop on loop step -->
    <connections xmi:id="_c10" xsi:type="Grafcet:StepToTransition" name="C_S4_T5" location="30:1-30:30" from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xmi:id="_c11" xsi:type="Grafcet:TransitionToStep" name="C_T5_S4" location="31:1-31:30" from="/0/@elements.11" to="/0/@elements.4"/>
    <!-- From loop step to final step -->
    <connections xmi:id="_c12" xsi:type="Grafcet:StepToTransition" name="C_S4_T6" location="32:1-32:30" from="/0/@elements.4" to="/0/@elements.12"/>
    <connections xmi:id="_c13" xsi:type="Grafcet:TransitionToStep" name="C_T6_S5" location="33:1-33:30" from="/0/@elements.12" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>