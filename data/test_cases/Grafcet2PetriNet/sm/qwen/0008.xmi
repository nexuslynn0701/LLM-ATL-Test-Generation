<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0008" location="diagram_0008">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="x=100,y=100" isInitial="true" isActive="false" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="x=100,y=200" condition="sensorA"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="x=100,y=300" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="x=100,y=400" condition="timerExpired"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="x=100,y=500" isInitial="false" isActive="false" action="finish"/>
    <elements xsi:type="Grafcet:Step" name="BranchStep" location="x=250,y=300" isInitial="false" isActive="false" action="branchAction"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="x=250,y=200" condition="sensorB"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn1" location="line_1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn2" location="line_2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn3" location="line_3" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn4" location="line_4" from="/0/@elements.3" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn5" location="line_5" from="/0/@elements.0" to="/0/@elements.6"/>
