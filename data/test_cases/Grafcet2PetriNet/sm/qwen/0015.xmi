<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0015" location="diagram_0015">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="x=100,y=100" isInitial="true" isActive="false" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="x=200,y=100" condition="sensorA"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="x=300,y=100" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="x=400,y=100" condition="timerExpired"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="x=500,y=100" isInitial="false" isActive="false" action="finish"/>
    
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_S1_T1" location="x=150,y=100" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T1_S2" location="x=250,y=100" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_S2_T2" location="x=350,y=100" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T2_S3" location="x=450,y=100" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>