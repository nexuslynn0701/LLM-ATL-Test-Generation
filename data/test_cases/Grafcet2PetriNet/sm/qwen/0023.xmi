<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0023" location="diagram_0023">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="x=100,y=100" isInitial="true" isActive="false" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="x=100,y=200" condition="sensorA = true"/>
    <elements xsi:type="Grafcet:Step" name="ProcessStep" location="x=100,y=300" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="x=100,y=400" condition="timer > 5"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="x=100,y=500" isInitial="false" isActive="false" action="finish"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn1" location="x=100,y=150" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn2" location="x=100,y=250" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn3" location="x=100,y=350" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn4" location="x=100,y=450" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>