<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0057" location="diagram_0057">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="x=100,y=100" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="x=200,y=100" condition="sensorA"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="x=300,y=100" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="x=400,y=100" condition="timerExpired"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="x=500,y=100" isInitial="false" isActive="false" action="finish"/>
    
    <connections xsi:type="Grafcet:StepToTransition" name="Conn1" location="from_Start_to_T1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn2" location="from_T1_to_Middle" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn3" location="from_Middle_to_T2" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn4" location="from_T2_to_End" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>