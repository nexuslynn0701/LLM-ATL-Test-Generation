<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0041" location="diagram_0041">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="x=100,y=100" isInitial="true" isActive="false" action="start_process"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="x=200,y=100" condition="sensor_ok"/>
    <elements xsi:type="Grafcet:Step" name="ProcessingStep" location="x=300,y=100" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="x=400,y=100" condition="timeout OR error"/>
    <elements xsi:type="Grafcet:Step" name="ErrorStep" location="x=500,y=50" isInitial="false" isActive="false" action="handle_error"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="x=500,y=150" isInitial="false" isActive="false" action="finish_process"/>
    
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="from_Initial_to_T1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C2" location="from_T1_to_Processing" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C3" location="from_Processing_to_T2" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C4" location="from_T2_to_Error" from="/0/@elements.3" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C5" location="from_T2_to_Final" from="/0/@elements.3" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>