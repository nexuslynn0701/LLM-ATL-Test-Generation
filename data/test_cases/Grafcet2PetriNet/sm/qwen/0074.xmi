<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0074" location="file://test_0074.grafcet">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="10,20" isInitial="true" isActive="true" action="initialize()"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="50,20" condition="sensorA = true"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="90,20" isInitial="false" isActive="false" action="process()"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="130,20" condition="timer > 5"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="170,20" isInitial="false" isActive="false" action="finish()"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn1" location="30,20" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn2" location="70,20" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn3" location="110,20" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn4" location="150,20" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>