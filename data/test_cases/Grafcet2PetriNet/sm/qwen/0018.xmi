<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0018" location="diagram_0018">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="pos(100,100)" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="pos(200,100)" condition="sensorA"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="pos(300,100)" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="pos(400,100)" condition="timerExpired"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="pos(500,100)" isInitial="false" isActive="false" action="finish"/>
    
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_S1_T1" location="conn(100-200)" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T1_S2" location="conn(200-300)" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_S2_T2" location="conn(300-400)" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T2_S3" location="conn(400-500)" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>