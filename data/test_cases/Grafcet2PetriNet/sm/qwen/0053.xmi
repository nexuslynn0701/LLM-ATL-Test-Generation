    <elements xsi:type="Grafcet:Step" name="ProcessStep" location="pos_2" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="pos_3" condition="timeout OR error"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="pos_4" isInitial="false" isActive="false" action="finalize"/>
    
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="conn_1" from="/0/@elements.0" to="/0/@elements.1"/>
