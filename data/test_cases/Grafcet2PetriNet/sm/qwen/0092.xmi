<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0092" location="diagram.grafcet">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="x=100,y=100" isInitial="true" isActive="false" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="x=100,y=200" condition="sensorA"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="x=100,y=300" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="x=100,y=400" condition="timerExpired"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="x=100,y=500" isInitial="false" isActive="false" action="finish"/>
    
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="x=100,y=150" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C2" location="x=100,y=250" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C3" location="x=100,y=350" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C4" location="x=100,y=450" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>