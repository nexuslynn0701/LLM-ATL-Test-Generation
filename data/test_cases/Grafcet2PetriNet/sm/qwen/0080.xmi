<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0080" location="file://test_0080.grafcet">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="10,10" isInitial="true" isActive="false" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="10,50" condition="sensorA"/>
    <elements xsi:type="Grafcet:Step" name="ProcessStep" location="10,90" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="10,130" condition="timeout OR manualStop"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="10,170" isInitial="false" isActive="false" action="finalize"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="10,30" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C2" location="10,70" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C3" location="10,110" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C4" location="10,150" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>