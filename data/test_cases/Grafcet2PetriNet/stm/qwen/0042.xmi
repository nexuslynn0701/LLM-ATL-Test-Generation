<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0042" location="file://test_0042.gfc">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="10,10" isInitial="true" isActive="false" action="startProcess()"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="50,10" condition="sensorA &amp;&amp; sensorB"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="90,10" isInitial="false" isActive="false" action="processData()"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="130,10" condition="timeout || errorDetected"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="170,10" isInitial="false" isActive="false" action="finishProcess()"/>
    <connections xsi:type="Grafcet:StepToTransition" name="ST1" location="30,10" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="TS1" location="70,10" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="ST2" location="110,10" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="TS2" location="150,10" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>