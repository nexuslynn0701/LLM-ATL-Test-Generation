<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0025" location="main">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="x=100,y=100" isInitial="true" isActive="false" action="startProcess"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="x=200,y=100" condition="sensorA"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="x=300,y=100" isInitial="false" isActive="false" action="activateValve"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="x=400,y=100" condition="timeout"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="x=500,y=100" isInitial="false" isActive="false" action="stopProcess"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="from InitialStep to T1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C2" location="from T1 to MiddleStep" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C3" location="from MiddleStep to T2" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C4" location="from T2 to FinalStep" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>