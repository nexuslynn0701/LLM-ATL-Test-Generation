<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0036" location="file://test_0036.grafcet">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="10,10" isInitial="true" isActive="true" action="start_process"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="100,50" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="200,90" isInitial="false" isActive="false" action="end_process"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="50,30" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="150,70" condition="y == true"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_S1_T1" location="30,20" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T1_S2" location="70,40" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_S2_T2" location="120,60" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T2_S3" location="170,80" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>