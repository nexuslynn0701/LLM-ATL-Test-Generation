<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0072" location="file://test_0072.gfc">
    <elements xsi:type="Grafcet:Step" name="S1" location="10,10" isInitial="true" isActive="false" action="activate_motor"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="50,10" condition="sensor_A"/>
    <elements xsi:type="Grafcet:Step" name="S2" location="90,10" isInitial="false" isActive="false" action="deactivate_valve"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="130,10" condition="timer_expired"/>
    <elements xsi:type="Grafcet:Step" name="S3" location="170,10" isInitial="false" isActive="false" action="reset_system"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="30,10" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C2" location="70,10" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C3" location="110,10" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C4" location="150,10" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>