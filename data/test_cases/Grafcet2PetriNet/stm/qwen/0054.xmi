<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0054" location="diagram_0054">
    <elements xsi:type="Grafcet:Step" name="S1" location="x=100,y=100" isInitial="true" isActive="false" action="activate_motor"/>
    <elements xsi:type="Grafcet:Step" name="S2" location="x=300,y=100" isInitial="false" isActive="true" action="deactivate_valve"/>
    <elements xsi:type="Grafcet:Step" name="S3" location="x=200,y=300" isInitial="false" isActive="false" action="reset_counter"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="x=200,y=50" condition="sensor_A &amp;&amp; !timeout"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="x=200,y=200" condition="counter &gt; 5"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="x=400,y=200" condition="emergency_stop"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="from_S1_to_T1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C2" location="from_S2_to_T2" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C3" location="from_S2_to_T3" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C4" location="from_T1_to_S2" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C5" location="from_T2_to_S3" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C6" location="from_T3_to_S1" from="/0/@elements.5" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>