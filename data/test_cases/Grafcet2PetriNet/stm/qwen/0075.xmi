<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0075" location="file://test_0075.grafcet">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="loc_start" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="loc_t1" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="loc_middle" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="loc_t2" condition="y == 1"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="loc_end" isInitial="false" isActive="false" action="finalize"/>
    
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_S1_T1" location="conn_s1_t1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T1_S2" location="conn_t1_s2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_S2_T2" location="conn_s2_t2" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T2_S3" location="conn_t2_s3" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>