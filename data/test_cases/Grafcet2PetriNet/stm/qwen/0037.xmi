<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0037" location="file.grafcet">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="step1" isInitial="true" isActive="false" action="startProcess"/>
    <elements xsi:type="Grafcet:Transition" name="CondTrans" location="trans1" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="step2" isInitial="false" isActive="true" action="processData"/>
    <elements xsi:type="Grafcet:Transition" name="FinalTrans" location="trans2" condition="y == 1"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="step3" isInitial="false" isActive="false" action="endProcess"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn1" location="conn1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn2" location="conn2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn3" location="conn3" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn4" location="conn4" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>