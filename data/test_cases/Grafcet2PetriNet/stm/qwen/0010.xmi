<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0010" location="main.grafcet">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="step1.loc" isInitial="true" isActive="false" action="start_process"/>
    <elements xsi:type="Grafcet:Transition" name="Trans1" location="trans1.loc" condition="sensorA = true"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="step2.loc" isInitial="false" isActive="true" action="process_data"/>
    <elements xsi:type="Grafcet:Transition" name="Trans2" location="trans2.loc" condition="timer > 5"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="step3.loc" isInitial="false" isActive="false" action="end_process"/>
    
    <connections xsi:type="Grafcet:StepToTransition" name="Conn1" location="conn1.loc" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn2" location="conn2.loc" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn3" location="conn3.loc" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn4" location="conn4.loc" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>