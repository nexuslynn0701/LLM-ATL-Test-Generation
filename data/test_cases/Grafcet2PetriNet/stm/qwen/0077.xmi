<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0077" location="main">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="top-left" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="middle-top" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="center" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="middle-bottom" condition="y == 5"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="bottom-right" isInitial="false" isActive="false" action="finalize"/>
    
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="link1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C2" location="link2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C3" location="link3" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C4" location="link4" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>