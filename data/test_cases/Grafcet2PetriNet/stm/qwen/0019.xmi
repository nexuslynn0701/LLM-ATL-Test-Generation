<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0019" location="main.grafcet">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="step1.loc" isInitial="true" isActive="true" action="start_process"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="trans1.loc" condition="sensorA"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="step2.loc" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="trans2.loc" condition="timer_expired"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="step3.loc" isInitial="false" isActive="false" action="finish"/>
    
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="conn1.loc" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C2" location="conn2.loc" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C3" location="conn3.loc" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C4" location="conn4.loc" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>