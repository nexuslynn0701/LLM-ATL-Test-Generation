<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0003" location="file:///test0003.grafcet">
    <elements xsi:type="Grafcet:Step" name="S1" location="10,10" isInitial="true" isActive="false" action="activate_motor"/>
    <elements xsi:type="Grafcet:Step" name="S2" location="100,10" isInitial="false" isActive="true" action="open_valve"/>
    <elements xsi:type="Grafcet:Step" name="S3" location="190,10" isInitial="false" isActive="false" action="close_valve"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="55,40" condition="sensor_A"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="145,40" condition="timer_expired"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="235,40" condition="emergency_stop"/>
    <connections xsi:type="Grafcet:StepToTransition" name="ST1" location="30,25" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="TS1" location="75,25" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="ST2" location="120,25" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="TS2" location="165,25" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="ST3" location="210,25" from="/0/@elements.2" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="TS3" location="255,25" from="/0/@elements.5" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>