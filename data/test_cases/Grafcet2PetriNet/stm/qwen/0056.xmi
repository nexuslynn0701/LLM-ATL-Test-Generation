<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0056" location="diagram_0056">
    <elements xsi:type="Grafcet:Step" name="StartStep" location="pos_0" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="pos_1" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Step" name="MiddleStep" location="pos_2" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="pos_3" condition="y == 1"/>
    <elements xsi:type="Grafcet:Step" name="EndStep" location="pos_4" isInitial="false" isActive="false" action="finalize"/>
    
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_S1_T1" location="conn_0" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T1_S2" location="conn_1" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="Conn_S2_T2" location="conn_2" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="Conn_T2_S3" location="conn_3" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>