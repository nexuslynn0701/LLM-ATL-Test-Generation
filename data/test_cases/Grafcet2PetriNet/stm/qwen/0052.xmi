<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="TestGrafcet_0052" location="file://test_0052.grafcet">
    <elements xsi:type="Grafcet:Step" name="S1" location="loc_S1" isInitial="true" isActive="false" action="activate_motor"/>
    <elements xsi:type="Grafcet:Step" name="S2" location="loc_S2" isInitial="false" isActive="true" action="open_valve"/>
    <elements xsi:type="Grafcet:Step" name="S3" location="loc_S3" isInitial="false" isActive="false" action="close_valve"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="loc_T1" condition="sensor_A"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="loc_T2" condition="timer_expired"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="loc_T3" condition="emergency_stop"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="conn_S1_T1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C2" location="conn_T1_S2" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C3" location="conn_S2_T2" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C4" location="conn_T2_S3" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C5" location="conn_S3_T3" from="/0/@elements.2" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C6" location="conn_T3_S1" from="/0/@elements.5" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>