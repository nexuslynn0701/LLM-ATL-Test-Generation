<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="1:1-50:1">

    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="2:1-2:50"
              isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ProcessingStepA" location="3:1-3:60"
              isInitial="false" isActive="false" action="process_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessingStepB" location="4:1-4:60"
              isInitial="false" isActive="false" action="process_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="MergeStep" location="5:1-5:60"
              isInitial="false" isActive="false" action="merge_results"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="LoopStep" location="6:1-6:60"
              isInitial="false" isActive="false" action="loop_body"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="FinalStep" location="7:1-7:60"
              isInitial="false" isActive="false" action="finalize"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_to_A" location="10:1-10:60"
              condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_A_to_B" location="11:1-11:60"
              condition="A_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_B_to_Merge" location="12:1-12:60"
              condition="B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_Merge_to_Loop" location="13:1-13:60"
              condition="merged_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_Loop_to_Merge" location="14:1-14:60"
              condition="loop_again"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_Loop_to_Final" location="15:1-15:60"
              condition="loop_finished"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="20:1-20:60"
                 from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_A_to_T1" location="21:1-21:60"
                 from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_B_to_T2" location="22:1-22:60"
                 from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_Merge_to_T3" location="23:1-23:60"
                 from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_Loop_to_T4" location="24:1-24:60"
                 from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_Loop_to_T5" location="25:1-25:60"
                 from="/0/@elements.4" to="/0/@elements.11"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="C_T0_to_A" location="30:1-30:60"
                 from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_T1_to_B" location="31:1-31:60"
                 from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_T2_to_Merge" location="32:1-32:60"
                 from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_T3_to_Loop" location="33:1-33:60"
                 from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_T4_to_Merge" location="34:1-34:60"
                 from="/0/@elements.10" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_T5_to_Final" location="35:1-35:60"
                 from="/0/@elements.11" to="/0/@elements.5"/>

  </Grafcet:Grafcet>
</xmi:XMI>