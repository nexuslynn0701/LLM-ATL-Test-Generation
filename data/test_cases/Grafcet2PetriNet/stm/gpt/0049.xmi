<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file:/model/ComplexGrafcetExample.gcf">
    <!-- Elements: 5 Steps (2 initial, 3 non-initial) and 4 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStepA" location="1:1-1:20" isInitial="true" isActive="true" action="A_on_start"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="InitStepB" location="2:1-2:20" isInitial="true" isActive="false" action="B_on_start"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="IntermediateStep" location="3:1-3:25" isInitial="false" isActive="false" action="intermediate_action"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ParallelStep" location="4:1-4:22" isInitial="false" isActive="false" action="parallel_action"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="FinalStep" location="5:1-5:18" isInitial="false" isActive="false" action="finalize"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_A_to_mid" location="6:1-6:25" condition="x &gt; 0"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_B_to_mid" location="7:1-7:25" condition="y = 1"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_mid_to_parallel" location="8:1-8:30" condition="z &lt; 10"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_parallel_to_final" location="9:1-9:32" condition="done = true"/>

    <!-- Connections: multiple StepToTransition and TransitionToStep, including fan-in and fan-out -->
    <!-- Initial step A to transition t0 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_s0_t0" location="10:1-10:30" grafcet="/0" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- Initial step B to transition t1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_s1_t1" location="11:1-11:30" grafcet="/0" from="/0/@elements.1" to="/0/@elements.6"/>
    <!-- Two transitions converging to the same intermediate step (fan-in) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="C_t0_s2" location="12:1-12:32" grafcet="/0" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="C_t1_s2" location="13:1-13:32" grafcet="/0" from="/0/@elements.6" to="/0/@elements.2"/>
    <!-- Intermediate step to transition leading into a parallel step -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_s2_t2" location="14:1-14:30" grafcet="/0" from="/0/@elements.2" to="/0/@elements.7"/>
    <!-- Transition t2 branching to two different steps (fan-out) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_t2_s3" location="15:1-15:32" grafcet="/0" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="C_t2_s4" location="16:1-16:32" grafcet="/0" from="/0/@elements.7" to="/0/@elements.4"/>
    <!-- Parallel step leading to final step through last transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_s3_t3" location="17:1-17:30" grafcet="/0" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_t3_s4" location="18:1-18:30" grafcet="/0" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>