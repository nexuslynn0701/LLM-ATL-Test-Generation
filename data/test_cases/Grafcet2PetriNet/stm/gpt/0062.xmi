<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file:///models/grafcet/complexExample.grafcet">

    <!-- Elements: mix of steps and transitions, multiple branches and merges -->

    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="Start" location="1:1-1:20" isInitial="true" isActive="true" action="initSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="Prepare" location="2:1-2:25" isInitial="false" isActive="false" action="prepareResources"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="BranchA_Step1" location="3:1-3:30" isInitial="false" isActive="false" action="doBranchA1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="BranchA_Step2" location="4:1-4:30" isInitial="false" isActive="false" action="doBranchA2"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="BranchB_Step1" location="5:1-5:30" isInitial="false" isActive="false" action="doBranchB1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="MergeStep" location="6:1-6:30" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" name="LoopStep" location="7:1-7:30" isInitial="false" isActive="true" action="loopAction"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s7" name="FinalStep" location="8:1-8:30" isInitial="false" isActive="false" action="shutdownSystem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="toPrepare" location="11:1-11:25" condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="splitToBranches" location="12:1-12:30" condition="preparedOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="branchAContinue" location="13:1-13:30" condition="A_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="branchBContinue" location="14:1-14:30" condition="B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="mergeTransition" location="15:1-15:30" condition="A_done and B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="loopBack" location="16:1-16:30" condition="not finished"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="toFinal" location="17:1-17:30" condition="finished"/>

    <!-- Connections: StepToTransition and TransitionToStep, with branching, merging, and a loop -->

    <!-- Start -> toPrepare -> Prepare -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="c_Start_toPrepare" location="21:1-21:40"
                 from="/0/@elements.0" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="c_toPrepare_Prepare" location="22:1-22:40"
                 from="/0/@elements.8" to="/0/@elements.1"/>

    <!-- Prepare -> splitToBranches -> BranchA_Step1 & BranchB_Step1 (fan-out) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="c_Prepare_split" location="23:1-23:40"
                 from="/0/@elements.1" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="c_split_BranchA1" location="24:1-24:40"
                 from="/0/@elements.9" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="c_split_BranchB1" location="25:1-25:40"
                 from="/0/@elements.9" to="/0/@elements.4"/>

    <!-- Branch A: BranchA_Step1 -> branchAContinue -> BranchA_Step2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="c_A1_to_Atrans" location="26:1-26:40"
                 from="/0/@elements.2" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="c_Atrans_to_A2" location="27:1-27:40"
                 from="/0/@elements.10" to="/0/@elements.3"/>

    <!-- Branch B: BranchB_Step1 -> branchBContinue (goes directly to MergeStep) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="c_B1_to_Btrans" location="28:1-28:40"
                 from="/0/@elements.4" to="/0/@elements.11"/>

    <!-- Merge of branches: BranchA_Step2 and BranchB_Step1 both go to mergeTransition, then to MergeStep -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="c_A2_to_mergeTrans" location="29:1-29:40"
                 from="/0/@elements.3" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c9" name="c_B1_to_mergeTrans" location="30:1-30:40"
                 from="/0/@elements.4" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="c_mergeTrans_to_MergeStep" location="31:1-31:45"
                 from="/0/@elements.12" to="/0/@elements.5"/>

    <!-- MergeStep -> loopBack -> LoopStep (enter loop) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c11" name="c_Merge_to_loopBack" location="32:1-32:45"
                 from="/0/@elements.5" to="/0/@elements.13"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="c_loopBack_to_LoopStep" location="33:1-33:45"
                 from="/0/@elements.13" to="/0/@elements.6"/>

    <!-- Loop: LoopStep -> loopBack -> LoopStep (self-loop via same transition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c13" name="c_LoopStep_to_loopBack_again" location="34:1-34:50"
                 from="/0/@elements.6" to="/0/@elements.13"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c14" name="c_loopBack_to_LoopStep_again" location="35:1-35:50"
                 from="/0/@elements.13" to="/0/@elements.6"/>

    <!-- Exit loop: LoopStep -> toFinal -> FinalStep -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c15" name="c_LoopStep_toFinal" location="36:1-36:45"
                 from="/0/@elements.6" to="/0/@elements.14"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c16" name="c_toFinal_FinalStep" location="37:1-37:45"
                 from="/0/@elements.14" to="/0/@elements.7"/>

  </Grafcet:Grafcet>
</xmi:XMI>