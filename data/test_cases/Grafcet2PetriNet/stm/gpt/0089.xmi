<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file:///models/grafcet_example_0089.grafcet">

    <!-- Elements: 4 Steps + 3 Transitions (7 total) -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="BranchStepA" location="2:1-2:25" isInitial="false" isActive="false" action="perform_task_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="BranchStepB" location="3:1-3:25" isInitial="false" isActive="false" action="perform_task_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="JoinStep" location="4:1-4:20" isInitial="false" isActive="false" action="finalize_tasks"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="SplitTransition" location="5:1-5:30" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="LoopTransitionA" location="6:1-6:35" condition="retry_A &gt; 0"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="JoinTransition" location="7:1-7:30" condition="A_done and B_done"/>

    <!-- Connections forming:
         s0 -> t0 -> s1
         s1 -> t1 -> s1 (self-loop)
         s1 -> t2 -> s3
         s0 -> t0 -> s2
         s2 -> t2 -> s3
    -->

    <!-- From initial step to split transition (fan-out) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="Init_to_Split" location="8:1-8:40"
                 from="/0/@elements.0" to="/0/@elements.4"/>

    <!-- Split transition to branch steps -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="Split_to_A" location="9:1-9:40"
                 from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="Split_to_B" location="10:1-10:40"
                 from="/0/@elements.4" to="/0/@elements.2"/>

    <!-- Loop on BranchStepA via LoopTransitionA -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="A_to_LoopA" location="11:1-11:40"
                 from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="LoopA_to_A" location="12:1-12:40"
                 from="/0/@elements.5" to="/0/@elements.1"/>

    <!-- From branch steps to join transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="A_to_Join" location="13:1-13:40"
                 from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="B_to_Join" location="14:1-14:40"
                 from="/0/@elements.2" to="/0/@elements.6"/>

    <!-- Join transition to final step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="Join_to_Final" location="15:1-15:40"
                 from="/0/@elements.6" to="/0/@elements.3"/>

  </Grafcet:Grafcet>
</xmi:XMI>