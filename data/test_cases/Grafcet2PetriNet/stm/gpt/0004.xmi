<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet" location="1:1-100:1">

    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="2:1-2:50"
              isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="ParallelStep1" location="3:1-3:60"
              isInitial="false" isActive="false" action="computeBranch1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ParallelStep2" location="4:1-4:60"
              isInitial="false" isActive="false" action="computeBranch2"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="MergeStep" location="5:1-5:50"
              isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="LoopBody" location="6:1-6:50"
              isInitial="false" isActive="false" action="processLoop"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S5" name="FinalStep" location="7:1-7:40"
              isInitial="false" isActive="false" action="shutdown"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_init_to_parallel" location="10:1-10:60"
              condition="start && ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_parallel1_to_merge" location="11:1-11:60"
              condition="branch1Done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_parallel2_to_merge" location="12:1-12:60"
              condition="branch2Done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="T_merge_to_loop" location="13:1-13:50"
              condition="resultsOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" name="T_loop_iterate" location="14:1-14:50"
              condition="moreWork"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T5" name="T_loop_exit" location="15:1-15:50"
              condition="!moreWork"/>

    <!-- Connections: from Step to Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_Init_to_T0" location="20:1-20:40"
                 from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C1" name="C_S1_to_T1" location="21:1-21:40"
                 from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="C_S2_to_T2" location="22:1-22:40"
                 from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="C_S3_to_T3" location="23:1-23:40"
                 from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_S4_to_T4" location="24:1-24:40"
                 from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C5" name="C_S4_to_T5" location="25:1-25:40"
                 from="/0/@elements.4" to="/0/@elements.11"/>

    <!-- Connections: from Transition to Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C6" name="C_T0_to_S1" location="30:1-30:40"
                 from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="C_T0_to_S2" location="31:1-31:40"
                 from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C8" name="C_T1_to_S3" location="32:1-32:40"
                 from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C9" name="C_T2_to_S3" location="33:1-33:40"
                 from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C10" name="C_T3_to_S4" location="34:1-34:40"
                 from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C11" name="C_T4_to_S4" location="35:1-35:40"
                 from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C12" name="C_T5_to_S5" location="36:1-36:40"
                 from="/0/@elements.11" to="/0/@elements.5"/>

  </Grafcet:Grafcet>
</xmi:XMI>