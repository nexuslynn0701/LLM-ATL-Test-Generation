<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_grafcetRoot"
                   name="ComplexSequentialBranchingGrafcet"
                   location="file://model/grafcet_complex_0069.gcf">

    <!-- Elements: steps and transitions -->
    <!-- Steps -->
    <elements xmi:id="_stepS1"
              xsi:type="Grafcet:Step"
              name="S1_Initial"
              location="1,1"
              isInitial="true"
              isActive="true"
              action="init_system"/>
    <elements xmi:id="_stepS2"
              xsi:type="Grafcet:Step"
              name="S2_BranchA"
              location="2,1"
              isInitial="false"
              isActive="false"
              action="branch_A_action"/>
    <elements xmi:id="_stepS3"
              xsi:type="Grafcet:Step"
              name="S3_BranchB"
              location="2,2"
              isInitial="false"
              isActive="false"
              action="branch_B_action"/>
    <elements xmi:id="_stepS4"
              xsi:type="Grafcet:Step"
              name="S4_Join"
              location="3,1"
              isInitial="false"
              isActive="false"
              action="join_action"/>
    <elements xmi:id="_stepS5"
              xsi:type="Grafcet:Step"
              name="S5_Loop"
              location="4,1"
              isInitial="false"
              isActive="false"
              action="loop_action"/>
    <elements xmi:id="_stepS6"
              xsi:type="Grafcet:Step"
              name="S6_Terminal"
              location="5,1"
              isInitial="false"
              isActive="false"
              action="terminate_system"/>

    <!-- Transitions -->
    <elements xmi:id="_transT1"
              xsi:type="Grafcet:Transition"
              name="T1_toBranches"
              location="1.5,1"
              condition="cond_branches_ready"/>
    <elements xmi:id="_transT2"
              xsi:type="Grafcet:Transition"
              name="T2_toJoinFromA"
              location="2.5,1"
              condition="cond_branch_A_done"/>
    <elements xmi:id="_transT3"
              xsi:type="Grafcet:Transition"
              name="T3_toJoinFromB"
              location="2.5,2"
              condition="cond_branch_B_done"/>
    <elements xmi:id="_transT4"
              xsi:type="Grafcet:Transition"
              name="T4_toLoop"
              location="3.5,1"
              condition="cond_join_complete"/>
    <elements xmi:id="_transT5"
              xsi:type="Grafcet:Transition"
              name="T5_loopBack"
              location="4.5,0.5"
              condition="cond_loop_repeat"/>
    <elements xmi:id="_transT6"
              xsi:type="Grafcet:Transition"
              name="T6_exitLoop"
              location="4.5,1.5"
              condition="cond_exit_loop"/>

    <!-- Connections: StepToTransition and TransitionToStep -->

    <!-- From initial step to branching transition -->
    <connections xmi:id="_connS1_T1"
                 xsi:type="Grafcet:StepToTransition"
                 name="C_S1_T1"
                 location="c1"
                 from="/0/@elements.0"
                 to="/0/@elements.6"/>

    <!-- Branching from T1 to S2 and S3 -->
    <connections xmi:id="_connT1_S2"
                 xsi:type="Grafcet:TransitionToStep"
                 name="C_T1_S2"
                 location="c2"
                 from="/0/@elements.6"
                 to="/0/@elements.1"/>
    <connections xmi:id="_connT1_S3"
                 xsi:type="Grafcet:TransitionToStep"
                 name="C_T1_S3"
                 location="c3"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>

    <!-- From S2 to T2; S3 to T3 -->
    <connections xmi:id="_connS2_T2"
                 xsi:type="Grafcet:StepToTransition"
                 name="C_S2_T2"
                 location="c4"
                 from="/0/@elements.1"
                 to="/0/@elements.7"/>
    <connections xmi:id="_connS3_T3"
                 xsi:type="Grafcet:StepToTransition"
                 name="C_S3_T3"
                 location="c5"
                 from="/0/@elements.2"
                 to="/0/@elements.8"/>

    <!-- From T2 and T3 to join step S4 -->
    <connections xmi:id="_connT2_S4"
                 xsi:type="Grafcet:TransitionToStep"
                 name="C_T2_S4"
                 location="c6"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
    <connections xmi:id="_connT3_S4"
                 xsi:type="Grafcet:TransitionToStep"
                 name="C_T3_S4"
                 location="c7"
                 from="/0/@elements.8"
                 to="/0/@elements.3"/>

    <!-- From join step S4 to T4, then to loop step S5 -->
    <connections xmi:id="_connS4_T4"
                 xsi:type="Grafcet:StepToTransition"
                 name="C_S4_T4"
                 location="c8"
                 from="/0/@elements.3"
                 to="/0/@elements.9"/>
    <connections xmi:id="_connT4_S5"
                 xsi:type="Grafcet:TransitionToStep"
                 name="C_T4_S5"
                 location="c9"
                 from="/0/@elements.9"
                 to="/0/@elements.4"/>

    <!-- Loop: S5 to T5 back to S4 -->
    <connections xmi:id="_connS5_T5"
                 xsi:type="Grafcet:StepToTransition"
                 name="C_S5_T5"
                 location="c10"
                 from="/0/@elements.4"
                 to="/0/@elements.10"/>
    <connections xmi:id="_connT5_S4"
                 xsi:type="Grafcet:TransitionToStep"
                 name="C_T5_S4"
                 location="c11"
                 from="/0/@elements.10"
                 to="/0/@elements.3"/>

    <!-- Exit loop: S5 to T6 to terminal S6 -->
    <connections xmi:id="_connS5_T6"
                 xsi:type="Grafcet:StepToTransition"
                 name="C_S5_T6"
                 location="c12"
                 from="/0/@elements.4"
                 to="/0/@elements.11"/>
    <connections xmi:id="_connT6_S6"
                 xsi:type="Grafcet:TransitionToStep"
                 name="C_T6_S6"
                 location="c13"
                 from="/0/@elements.11"
                 to="/0/@elements.5"/>

  </Grafcet:Grafcet>
</xmi:XMI>