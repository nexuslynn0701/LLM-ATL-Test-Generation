<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet0068" location="file://grafcet_models/complex0068.grafcet">

    <!-- Elements: 4 Steps + 3 Transitions -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              name="InitStep"
              location="1:1-1:40"
              isInitial="true"
              isActive="true"
              action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="ProcessingStep"
              location="2:1-2:45"
              isInitial="false"
              isActive="false"
              action="processData"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="DecisionStep"
              location="3:1-3:50"
              isInitial="false"
              isActive="false"
              action="evaluateCondition"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              name="FinalStep"
              location="4:1-4:40"
              isInitial="false"
              isActive="false"
              action="shutdownSystem"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              name="T_InitToProc"
              location="5:1-5:40"
              condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="T_ProcToDecision"
              location="6:1-6:50"
              condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="T_DecisionToFinal"
              location="7:1-7:55"
              condition="decisionIsFinal"/>

    <!-- Connections forming a linear chain with a branch back:
         s0 -> t0 -> s1 -> t1 -> s2 -> t2 -> s3
         and an extra loop s2 -> t1 and t2 -> s1 -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="C_InitStep_T_InitToProc"
                 location="8:1-8:60"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c1"
                 name="C_T_InitToProc_ProcessingStep"
                 location="9:1-9:65"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>

    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c2"
                 name="C_ProcessingStep_T_ProcToDecision"
                 location="10:1-10:70"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c3"
                 name="C_T_ProcToDecision_DecisionStep"
                 location="11:1-11:75"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>

    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c4"
                 name="C_DecisionStep_T_DecisionToFinal"
                 location="12:1-12:75"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 name="C_T_DecisionToFinal_FinalStep"
                 location="13:1-13:70"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>

    <!-- Additional loop: DecisionStep -> T_ProcToDecision and T_DecisionToFinal -> ProcessingStep -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c6"
                 name="C_DecisionStep_T_ProcToDecision_Loop"
                 location="14:1-14:80"
                 from="/0/@elements.2"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c7"
                 name="C_T_DecisionToFinal_ProcessingStep_Loop"
                 location="15:1-15:85"
                 from="/0/@elements.6"
                 to="/0/@elements.1"/>

  </Grafcet:Grafcet>
</xmi:XMI>