<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g1" name="ComplexGrafcet_0033" location="file://complex_grafcet_0033.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="InitStep" location="1:1-1:10"
              isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="CheckSensors" location="2:1-2:15"
              isInitial="false" isActive="false" action="checkAllSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ProcessData" location="3:1-3:14"
              isInitial="false" isActive="false" action="processIncomingData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="BranchLeft" location="4:1-4:12"
              isInitial="false" isActive="false" action="executeLeftBranch"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="BranchRight" location="5:1-5:13"
              isInitial="false" isActive="false" action="executeRightBranch"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" name="MergeStep" location="6:1-6:10"
              isInitial="false" isActive="false" action="mergeAndFinalize"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s7" name="LoopStep" location="7:1-7:9"
              isInitial="false" isActive="false" action="performLoopIteration"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_InitToCheck" location="10:1-10:16"
              condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_CheckToProcess" location="11:1-11:20"
              condition="sensorsValid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_ProcessToBranchLeft" location="12:1-12:25"
              condition="selectLeft"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_ProcessToBranchRight" location="13:1-13:26"
              condition="selectRight"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_BranchesToMerge" location="14:1-14:23"
              condition="leftDone and rightDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="T_MergeToLoop" location="15:1-15:19"
              condition="needMoreIterations"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t7" name="T_LoopBack" location="16:1-16:15"
              condition="loopAgain"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Init_to_T1" location="20:1-20:18"
                 from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_S2_to_T2" location="21:1-21:16"
                 from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_S3_to_T3" location="22:1-22:16"
                 from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_S3_to_T4" location="23:1-23:16"
                 from="/0/@elements.2" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_S4_to_T5" location="24:1-24:16"
                 from="/0/@elements.3" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_S5_to_T5" location="25:1-25:16"
                 from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_S6_to_T6" location="26:1-26:16"
                 from="/0/@elements.5" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="C_S7_to_T7" location="27:1-27:16"
                 from="/0/@elements.6" to="/0/@elements.13"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_T1_to_S2" location="30:1-30:16"
                 from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_T2_to_S3" location="31:1-31:17"
                 from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_T3_to_S4" location="32:1-32:17"
                 from="/0/@elements.9" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_T4_to_S5" location="33:1-33:17"
                 from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="C_T5_to_S6" location="34:1-34:17"
                 from="/0/@elements.11" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c14" name="C_T6_to_S7" location="35:1-35:17"
                 from="/0/@elements.12" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c15" name="C_T7_to_S3" location="36:1-36:17"
                 from="/0/@elements.13" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>