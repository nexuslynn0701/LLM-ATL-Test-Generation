<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g1" name="ComplexGrafcetExample" location="file:/model/complexGrafcet.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="CheckSensors" location="2:1-2:25" isInitial="false" isActive="false" action="readSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ProcessingA" location="3:1-3:25" isInitial="false" isActive="false" action="computeA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="ProcessingB" location="4:1-4:25" isInitial="false" isActive="false" action="computeB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="MergeResults" location="5:1-5:25" isInitial="false" isActive="false" action="mergeAB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" name="ErrorHandler" location="6:1-6:25" isInitial="false" isActive="false" action="handleError"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s7" name="FinalStep" location="7:1-7:25" isInitial="false" isActive="false" action="shutdownSystem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Init_To_Check" location="10:1-10:30" condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_Check_To_Branch" location="11:1-11:35" condition="sensorsOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_Check_To_Error" location="12:1-12:35" condition="sensorsFail"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_Fork_To_A" location="13:1-13:30" condition="parallelStart"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_Fork_To_B" location="14:1-14:30" condition="parallelStart"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="T_A_To_Merge" location="15:1-15:30" condition="doneA"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t7" name="T_B_To_Merge" location="16:1-16:30" condition="doneB"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t8" name="T_Merge_To_Final" location="17:1-17:30" condition="mergeComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t9" name="T_Error_To_Final" location="18:1-18:30" condition="errorResolved"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Init_to_t1" location="20:1-20:40" grafcet="/0" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_s2_to_t2" location="21:1-21:40" grafcet="/0" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_s2_to_t3" location="22:1-22:40" grafcet="/0" from="/0/@elements.1" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_s2_to_t4" location="23:1-23:40" grafcet="/0" from="/0/@elements.1" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_s2_to_t5" location="24:1-24:40" grafcet="/0" from="/0/@elements.1" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_s3_to_t6" location="25:1-25:40" grafcet="/0" from="/0/@elements.2" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_s4_to_t7" location="26:1-26:40" grafcet="/0" from="/0/@elements.3" to="/0/@elements.13"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="C_s5_to_t8" location="27:1-27:40" grafcet="/0" from="/0/@elements.4" to="/0/@elements.14"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c9" name="C_s6_to_t9" location="28:1-28:40" grafcet="/0" from="/0/@elements.5" to="/0/@elements.15"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_t1_to_s2" location="30:1-30:40" grafcet="/0" from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_t2_to_s3" location="31:1-31:40" grafcet="/0" from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_t3_to_s6" location="32:1-32:40" grafcet="/0" from="/0/@elements.9" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="C_t4_to_s3" location="33:1-33:40" grafcet="/0" from="/0/@elements.10" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c14" name="C_t5_to_s4" location="34:1-34:40" grafcet="/0" from="/0/@elements.11" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c15" name="C_t6_to_s5" location="35:1-35:40" grafcet="/0" from="/0/@elements.12" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c16" name="C_t7_to_s5" location="36:1-36:40" grafcet="/0" from="/0/@elements.13" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c17" name="C_t8_to_s7" location="37:1-37:40" grafcet="/0" from="/0/@elements.14" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c18" name="C_t9_to_s7" location="38:1-38:40" grafcet="/0" from="/0/@elements.15" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>