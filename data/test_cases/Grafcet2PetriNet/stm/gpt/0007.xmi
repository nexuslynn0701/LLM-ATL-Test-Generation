<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexScenario" location="file:/model/complexScenario.grafcet">
    <!-- Elements: 5 Steps + 4 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="file:/model/complexScenario.grafcet#s0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="BranchStepA" location="file:/model/complexScenario.grafcet#s1" isInitial="false" isActive="false" action="handleBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="BranchStepB" location="file:/model/complexScenario.grafcet#s2" isInitial="false" isActive="false" action="handleBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="MergeStep" location="file:/model/complexScenario.grafcet#s3" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="FinalStep" location="file:/model/complexScenario.grafcet#s4" isInitial="false" isActive="false" action="shutdownSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_to_Branch" location="file:/model/complexScenario.grafcet#t0" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_BranchA_to_Merge" location="file:/model/complexScenario.grafcet#t1" condition="branchAComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_BranchB_to_Merge" location="file:/model/complexScenario.grafcet#t2" condition="branchBComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_Merge_to_Final" location="file:/model/complexScenario.grafcet#t3" condition="bothBranchesDone"/>

    <!-- Connections: StepToTransition (s0->t0, s1->t1, s2->t2, s3->t3) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="file:/model/complexScenario.grafcet#c0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_BranchA_to_T1" location="file:/model/complexScenario.grafcet#c1" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_BranchB_to_T2" location="file:/model/complexScenario.grafcet#c2" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_Merge_to_T3" location="file:/model/complexScenario.grafcet#c3" from="/0/@elements.3" to="/0/@elements.8"/>

    <!-- Connections: TransitionToStep (t0->s1, t0->s2, t1->s3, t2->s3, t3->s4) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="C_T0_to_BranchA" location="file:/model/complexScenario.grafcet#c4" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_T0_to_BranchB" location="file:/model/complexScenario.grafcet#c5" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="C_T1_to_Merge" location="file:/model/complexScenario.grafcet#c6" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_T2_to_Merge" location="file:/model/complexScenario.grafcet#c7" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_T3_to_Final" location="file:/model/complexScenario.grafcet#c8" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>