<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="loc:/grafcet/complex">
    <!-- Elements: mix of steps and transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_e0" name="InitStep" location="loc:/grafcet/complex/e0"
              isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_e1" name="BranchStepA" location="loc:/grafcet/complex/e1"
              isInitial="false" isActive="false" action="performActionA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_e2" name="BranchStepB" location="loc:/grafcet/complex/e2"
              isInitial="false" isActive="false" action="performActionB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_e3" name="MergeStep" location="loc:/grafcet/complex/e3"
              isInitial="false" isActive="false" action="mergeActions"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_e4" name="FinalStep" location="loc:/grafcet/complex/e4"
              isInitial="false" isActive="false" action="terminateSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_e5" name="T_InitToBranch" location="loc:/grafcet/complex/e5"
              condition="startCommand"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_e6" name="T_BranchToMergeA" location="loc:/grafcet/complex/e6"
              condition="A_completed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_e7" name="T_BranchToMergeB" location="loc:/grafcet/complex/e7"
              condition="B_completed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_e8" name="T_MergeToFinal" location="loc:/grafcet/complex/e8"
              condition="A_and_B_done"/>

    <!-- Connections: a small graph with branching and merging -->
    <!-- InitStep -> T_InitToBranch -> BranchStepA -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T" location="loc:/grafcet/complex/c0"
                 from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="C_T_to_A" location="loc:/grafcet/complex/c1"
                 from="/0/@elements.5" to="/0/@elements.1"/>

    <!-- InitStep -> T_InitToBranch -> BranchStepB (parallel branch) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Init_to_T_Second" location="loc:/grafcet/complex/c2"
                 from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="C_T_to_B" location="loc:/grafcet/complex/c3"
                 from="/0/@elements.5" to="/0/@elements.2"/>

    <!-- BranchStepA -> T_BranchToMergeA -> MergeStep -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_A_to_TA" location="loc:/grafcet/complex/c4"
                 from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_TA_to_Merge" location="loc:/grafcet/complex/c5"
                 from="/0/@elements.6" to="/0/@elements.3"/>

    <!-- BranchStepB -> T_BranchToMergeB -> MergeStep -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_B_to_TB" location="loc:/grafcet/complex/c6"
                 from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_TB_to_Merge" location="loc:/grafcet/complex/c7"
                 from="/0/@elements.7" to="/0/@elements.3"/>

    <!-- MergeStep -> T_MergeToFinal -> FinalStep -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="C_Merge_to_TFinal" location="loc:/grafcet/complex/c8"
                 from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_TFinal_to_Final" location="loc:/grafcet/complex/c9"
                 from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>