<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcetExample" location="1:1-100:1">
    <elements xsi:type="Grafcet:Step" xmi:id="s0" name="InitStep" location="2:1-2:50" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s1" name="BranchStepA" location="3:1-3:50" isInitial="false" isActive="false" action="runBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s2" name="BranchStepB" location="4:1-4:50" isInitial="false" isActive="false" action="runBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s3" name="JoinStep" location="5:1-5:50" isInitial="false" isActive="false" action="joinBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s4" name="LoopStep" location="6:1-6:50" isInitial="false" isActive="false" action="performLoop"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t0" name="T_Init_to_Branch" location="7:1-7:50" condition="startCommand"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t1" name="T_BranchA_to_Join" location="8:1-8:50" condition="A_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t2" name="T_BranchB_to_Join" location="9:1-9:50" condition="B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t3" name="T_Join_to_Loop" location="10:1-10:50" condition="both_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t4" name="T_LoopBack" location="11:1-11:50" condition="repeatLoop"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c0" name="C_Init_to_T0" location="12:1-12:60" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c1" name="C_T0_to_A" location="13:1-13:60" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c2" name="C_T0_to_B" location="14:1-14:60" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c3" name="C_A_to_T1" location="15:1-15:60" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c4" name="C_T1_to_Join" location="16:1-16:60" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c5" name="C_B_to_T2" location="17:1-17:60" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c6" name="C_T2_to_Join" location="18:1-18:60" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c7" name="C_Join_to_T3" location="19:1-19:60" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c8" name="C_T3_to_Loop" location="20:1-20:60" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c9" name="C_Loop_to_T4" location="21:1-21:60" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c10" name="C_T4_to_Join" location="22:1-22:60" from="/0/@elements.10" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>