<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g000" name="ComplexGrafcet" location="file://complexGrafcet.grafcet">
    <!-- Elements: 4 Steps + 3 Transitions = 7 elements -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="1:1-1:40" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ProcessingStep" location="2:1-2:60" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="SecondaryStep" location="3:1-3:60" isInitial="false" isActive="false" action="secondaryAction"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="FinalStep" location="4:1-4:40" isInitial="false" isActive="false" action="finalize"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="CheckInputs" location="5:1-5:50" condition="inputs_valid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="AltPath" location="6:1-6:50" condition="alternative_condition"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="Finish" location="7:1-7:50" condition="processing_done"/>
    <!-- Connections: mixed fan-in and fan-out -->
    <!-- s0 -> t0, s0 -> t1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="S0_to_T0" location="8:1-8:40" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="S0_to_T1" location="9:1-9:40" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- s1 -> t1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="S1_to_T1" location="10:1-10:40" from="/0/@elements.1" to="/0/@elements.5"/>
    <!-- t0 -> s1 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="T0_to_S1" location="11:1-11:40" from="/0/@elements.4" to="/0/@elements.1"/>
    <!-- t1 -> s2 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="T1_to_S2" location="12:1-12:40" from="/0/@elements.5" to="/0/@elements.2"/>
    <!-- s2 -> t2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="S2_to_T2" location="13:1-13:40" from="/0/@elements.2" to="/0/@elements.6"/>
    <!-- s3 -> t2 (fan-in to t2) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="S3_to_T2" location="14:1-14:40" from="/0/@elements.3" to="/0/@elements.6"/>
    <!-- t2 -> s3 (loop on s3) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="T2_to_S3" location="15:1-15:40" from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>