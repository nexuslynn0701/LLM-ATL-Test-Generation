<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g1" name="ComplexGrafcet" location="0;0;1024;768">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="InitStep" location="10;10;80;40" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="CheckSensors" location="120;10;80;40" isInitial="false" isActive="false" action="checkSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ProcessData" location="230;10;80;40" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="ErrorHandler" location="340;10;80;40" isInitial="false" isActive="false" action="handleError"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="Finalize" location="450;10;80;40" isInitial="false" isActive="false" action="finalizeProcess"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Init_To_Check" location="65;70;40;20" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_Check_To_Process" location="175;70;40;20" condition="sensorsOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_Check_To_Error" location="285;70;40;20" condition="sensorsFail"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_Process_To_Finalize" location="395;70;40;20" condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_Error_To_Finalize" location="505;70;40;20" condition="errorResolved"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="T_Finalize_To_Init" location="560;40;40;20" condition="resetCommand"/>
    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- InitStep -> T_Init_To_Check -> CheckSensors -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Init_To_T1" location="0;0;0;0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="C_T1_To_Check" location="0;0;0;0" from="/0/@elements.5" to="/0/@elements.1"/>
    <!-- CheckSensors -> T_Check_To_Process -> ProcessData -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_Check_To_T2" location="0;0;0;0" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="C_T2_To_Process" location="0;0;0;0" from="/0/@elements.6" to="/0/@elements.2"/>
    <!-- CheckSensors -> T_Check_To_Error -> ErrorHandler -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_Check_To_T3" location="0;0;0;0" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="C_T3_To_Error" location="0;0;0;0" from="/0/@elements.7" to="/0/@elements.3"/>
    <!-- ProcessData -> T_Process_To_Finalize -> Finalize -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_Process_To_T4" location="0;0;0;0" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_T4_To_Finalize" location="0;0;0;0" from="/0/@elements.8" to="/0/@elements.4"/>
    <!-- ErrorHandler -> T_Error_To_Finalize -> Finalize -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c9" name="C_Error_To_T5" location="0;0;0;0" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_T5_To_Finalize" location="0;0;0;0" from="/0/@elements.9" to="/0/@elements.4"/>
    <!-- Finalize -> T_Finalize_To_Init -> InitStep (loop back) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c11" name="C_Finalize_To_T6" location="0;0;0;0" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_T6_To_Init" location="0;0;0;0" from="/0/@elements.10" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>