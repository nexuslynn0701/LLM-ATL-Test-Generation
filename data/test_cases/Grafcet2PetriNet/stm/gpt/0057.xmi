<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g000" location="0,0,100,100" name="ComplexGrafcet0057">
    <!-- Elements: 5 Steps (2 initial), 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" location="10,10,40,40" name="InitStepA" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" location="60,10,90,40" name="InitStepB" isInitial="true" isActive="false" action="prepareSubsystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" location="35,60,65,90" name="ConvergeStep" isInitial="false" isActive="false" action="mergeFlows"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" location="20,110,50,140" name="BranchStepLeft" isInitial="false" isActive="false" action="leftBranchAction"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" location="80,110,110,140" name="BranchStepRight" isInitial="false" isActive="false" action="rightBranchAction"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" location="35,45,65,55" name="TransInitToConverge" condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" location="35,95,65,105" name="TransConvergeToBranch" condition="readyToBranch"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" location="50,155,80,165" name="TransJoinBranches" condition="bothCompleted"/>
    <!-- Connections: parallel inputs, fan-out, and reconvergence -->
    <!-- Initial steps to convergence transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" location="25,40,25,45" name="Arc_InitA_T0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" location="75,40,75,45" name="Arc_InitB_T0" from="/0/@elements.1" to="/0/@elements.5"/>
    <!-- Convergence transition to converge step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" location="50,55,50,60" name="Arc_T0_Converge" from="/0/@elements.5" to="/0/@elements.2"/>
    <!-- Converge step to branching transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" location="50,90,50,95" name="Arc_Converge_T1" from="/0/@elements.2" to="/0/@elements.6"/>
    <!-- Branching transition to two branch steps -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" location="35,105,35,110" name="Arc_T1_Left" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" location="95,105,95,110" name="Arc_T1_Right" from="/0/@elements.6" to="/0/@elements.4"/>
    <!-- Branch steps reconverging to final transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" location="35,140,50,155" name="Arc_Left_T2" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" location="95,140,80,155" name="Arc_Right_T2" from="/0/@elements.4" to="/0/@elements.7"/>
    <!-- Final transition back to converge step to form a loop -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" location="65,165,65,60" name="Arc_T2_Converge" from="/0/@elements.7" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>