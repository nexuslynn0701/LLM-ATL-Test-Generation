<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g1" name="ComplexSequentialBranchingGrafcet" location="file://model/grafcet_0053.gcf">
    <!-- Elements: 5 Steps + 3 Transitions = 8 elements -->
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="CheckSensors" location="2:1-2:25" isInitial="false" isActive="false" action="checkSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ProcessBranchA" location="3:1-3:25" isInitial="false" isActive="false" action="processA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="ProcessBranchB" location="4:1-4:25" isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="FinalizeStep" location="5:1-5:25" isInitial="false" isActive="false" action="finalizeSystem"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_InitToCheck" location="6:1-6:25" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_CheckToBranches" location="7:1-7:30" condition="sensorsOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_BranchesToFinalize" location="8:1-8:30" condition="branchADone_and_branchBDone"/>
    <!-- Connections -->
    <!-- InitStep -> T_InitToCheck -> CheckSensors -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Init_to_T1" location="9:1-9:40" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="C_T1_to_Check" location="10:1-10:40" from="/0/@elements.5" to="/0/@elements.1"/>
    <!-- CheckSensors -> T_CheckToBranches -> ProcessBranchA -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_Check_to_T2" location="11:1-11:40" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="C_T2_to_A" location="12:1-12:40" from="/0/@elements.6" to="/0/@elements.2"/>
    <!-- CheckSensors -> T_CheckToBranches -> ProcessBranchB (parallel branch) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_T2_to_B" location="13:1-13:40" from="/0/@elements.6" to="/0/@elements.3"/>
    <!-- ProcessBranchA -> T_BranchesToFinalize -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_A_to_T3" location="14:1-14:40" from="/0/@elements.2" to="/0/@elements.7"/>
    <!-- ProcessBranchB -> T_BranchesToFinalize -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_B_to_T3" location="15:1-15:40" from="/0/@elements.3" to="/0/@elements.7"/>
    <!-- T_BranchesToFinalize -> FinalizeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_T3_to_Final" location="16:1-16:40" from="/0/@elements.7" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>