<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="loc_g0">

    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_sA" name="StartStep" location="loc_sA"
              isInitial="true" isActive="true" action="startAction"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_sB" name="MiddleStep1" location="loc_sB"
              isInitial="false" isActive="false" action="midAction1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_sC" name="MiddleStep2" location="loc_sC"
              isInitial="false" isActive="false" action="midAction2"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_sD" name="EndStep" location="loc_sD"
              isInitial="false" isActive="false" action="endAction"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_sE" name="IsolatedStep" location="loc_sE"
              isInitial="false" isActive="false" action="isolatedAction"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T1" location="loc_t1"
              condition="cond1"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T2" location="loc_t2"
              condition="cond2"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T3" location="loc_t3"
              condition="cond3"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T4" location="loc_t4"
              condition="cond4"/>

    <!-- StepToTransition connections (Step -> Transition) -->
    <!-- Linear chain: StartStep -> T1 -> MiddleStep1 -> T2 -> MiddleStep2 -> T3 -> EndStep -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_cST1" name="ST_Start_T1"
                 location="loc_cST1"
                 from="/0/@elements.0"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_cST2" name="ST_Mid1_T2"
                 location="loc_cST2"
                 from="/0/@elements.1"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_cST3" name="ST_Mid2_T3"
                 location="loc_cST3"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>

    <!-- Branching: StartStep -> T4 (parallel path) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_cST4" name="ST_Start_T4"
                 location="loc_cST4"
                 from="/0/@elements.0"
                 to="/0/@elements.8"/>

    <!-- TransitionToStep connections (Transition -> Step) -->
    <!-- Continue linear chain -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_cTS1" name="TS_T1_Mid1"
                 location="loc_cTS1"
                 from="/0/@elements.5"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_cTS2" name="TS_T2_Mid2"
                 location="loc_cTS2"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_cTS3" name="TS_T3_End"
                 location="loc_cTS3"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>

    <!-- Branch from T4 directly to EndStep (join pattern) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_cTS4" name="TS_T4_End"
                 location="loc_cTS4"
                 from="/0/@elements.8"
                 to="/0/@elements.3"/>

    <!-- Self-loop around MiddleStep2 via T2 (cycle) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_cST5" name="ST_Mid2_T2"
                 location="loc_cST5"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_cTS5" name="TS_T2_Mid2_loop"
                 location="loc_cTS5"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>

  </Grafcet:Grafcet>
</xmi:XMI>