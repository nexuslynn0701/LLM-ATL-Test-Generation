<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="loc_grafcet_root">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="loc_s0" isInitial="true" isActive="true" action="start_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ValidationStep" location="loc_s1" isInitial="false" isActive="false" action="validate_input"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessingStep" location="loc_s2" isInitial="false" isActive="false" action="process_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="AlternativeProcessingStep" location="loc_s3" isInitial="false" isActive="false" action="process_alternative"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="MergeStep" location="loc_s4" isInitial="false" isActive="false" action="merge_results"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="FinalStep" location="loc_s5" isInitial="false" isActive="false" action="shutdown_system"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="CheckInput" location="loc_t0" condition="input_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="ReenterInput" location="loc_t1" condition="input_not_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="ParallelBranchStart" location="loc_t2" condition="start_parallel"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="JoinBranches" location="loc_t3" condition="branches_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="FinishProcess" location="loc_t4" condition="ready_to_finish"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="InitToCheckInput" location="loc_c0" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="InitToReenterInput" location="loc_c1" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="ValidationToParallelStart" location="loc_c2" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="ProcessingToJoin" location="loc_c3" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="AltProcessingToJoin" location="loc_c4" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="MergeToFinish" location="loc_c5" from="/0/@elements.4" to="/0/@elements.10"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="CheckInputToValidation" location="loc_c6" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="ReenterToInit" location="loc_c7" from="/0/@elements.7" to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="ParallelStartToProcessing" location="loc_c8" from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="ParallelStartToAltProcessing" location="loc_c9" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="JoinToMerge" location="loc_c10" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="FinishToFinal" location="loc_c11" from="/0/@elements.10" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>