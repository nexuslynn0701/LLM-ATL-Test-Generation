<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file://complex_grafcet_0082.grafcet">
    <!-- Elements: 5 Steps (2 initial), 4 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="Init_Main" location="1:1-1:20" isInitial="true" isActive="true" action="startSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="Prepare_A" location="2:1-2:25" isInitial="false" isActive="false" action="prepareA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="Prepare_B" location="3:1-3:25" isInitial="false" isActive="false" action="prepareB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="Parallel_A" location="4:1-4:25" isInitial="false" isActive="false" action="executeA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="Parallel_B" location="5:1-5:25" isInitial="false" isActive="false" action="executeB"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_To_Prepare" location="6:1-6:30" condition="initDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Prepare_To_Parallel" location="7:1-7:35" condition="bothPrepared"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_Parallel_A_Loop" location="8:1-8:30" condition="repeatA"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_Parallel_B_Loop" location="9:1-9:30" condition="repeatB"/>

    <!-- Connections: chain with fan-out and two self-contained loops -->
    <!-- s0 -> t0 -> s1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_s0_t0" location="10:1-10:30"
        grafcet="/0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="C_t0_s1" location="11:1-11:30"
        grafcet="/0" from="/0/@elements.5" to="/0/@elements.1"/>

    <!-- s1 -> t1 -> s2 and s3 (fan-out from transition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_s1_t1" location="12:1-12:30"
        grafcet="/0" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="C_t1_s2" location="13:1-13:30"
        grafcet="/0" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="C_t1_s3" location="14:1-14:30"
        grafcet="/0" from="/0/@elements.6" to="/0/@elements.3"/>

    <!-- Local loop on branch A: s3 -> t2 -> s3 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_s3_t2" location="15:1-15:30"
        grafcet="/0" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="C_t2_s3" location="16:1-16:30"
        grafcet="/0" from="/0/@elements.7" to="/0/@elements.3"/>

    <!-- Local loop on branch B: s2 -> t3 -> s4 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_s2_t3" location="17:1-17:30"
        grafcet="/0" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_t3_s4" location="18:1-18:30"
        grafcet="/0" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>