<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file:///models/grafcet/complexExample.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initSystem()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="PrepareStep" location="2:1-2:25" isInitial="false" isActive="false" action="prepareResources()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessingStep" location="3:1-3:30" isInitial="false" isActive="false" action="processData()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="AlternateStep" location="4:1-4:28" isInitial="false" isActive="false" action="alternateFlow()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="FinalStep" location="5:1-5:22" isInitial="false" isActive="false" action="finalizeSystem()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="ErrorStep" location="6:1-6:22" isInitial="false" isActive="false" action="handleError()"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToPrepare" location="10:1-10:30" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_PrepareToProcess" location="11:1-11:35" condition="resourcesAllocated"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_ProcessToFinal" location="12:1-12:32" condition="success"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_ProcessToAlt" location="13:1-13:30" condition="requiresAltPath"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_AltToFinal" location="14:1-14:28" condition="altCompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_ErrorFromInit" location="15:1-15:32" condition="initFailed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="T_ErrorFromPrepare" location="16:1-16:36" condition="prepareFailed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t7" name="T_ErrorFromProcess" location="17:1-17:36" condition="processingFailed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t8" name="T_ErrorFromAlt" location="18:1-18:32" condition="altFailed"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="20:1-20:30" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Prepare_to_T1" location="21:1-21:32" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Process_to_T2" location="22:1-22:32" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_Process_to_T3" location="23:1-23:32" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_Alt_to_T4" location="24:1-24:30" from="/0/@elements.3" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_Init_to_T5" location="25:1-25:30" from="/0/@elements.0" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_Prepare_to_T6" location="26:1-26:32" from="/0/@elements.1" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_Process_to_T7" location="27:1-27:32" from="/0/@elements.2" to="/0/@elements.13"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="C_Alt_to_T8" location="28:1-28:30" from="/0/@elements.3" to="/0/@elements.14"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_T0_to_Prepare" location="30:1-30:32" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_T1_to_Process" location="31:1-31:32" from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_T2_to_Final" location="32:1-32:30" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_T3_to_Alt" location="33:1-33:28" from="/0/@elements.9" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="C_T4_to_Final" location="34:1-34:30" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c14" name="C_T5_to_Error" location="35:1-35:30" from="/0/@elements.11" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c15" name="C_T6_to_Error" location="36:1-36:30" from="/0/@elements.12" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c16" name="C_T7_to_Error" location="37:1-37:30" from="/0/@elements.13" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c17" name="C_T8_to_Error" location="38:1-38:30" from="/0/@elements.14" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>