<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file:///models/grafcet/complex_0008.gcf">

    <!-- Elements: 4 Steps, 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="1:1-1:40"
              isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="BranchStepA" location="2:1-2:50"
              isInitial="false" isActive="false" action="perform_check_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="BranchStepB" location="3:1-3:50"
              isInitial="false" isActive="false" action="perform_check_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="FinalStep" location="4:1-4:40"
              isInitial="false" isActive="false" action="shutdown_sequence"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="SplitTransition" location="5:1-5:60"
              condition="sensor_ready &amp; power_on"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="JoinTransitionA" location="6:1-6:60"
              condition="check_A_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="JoinTransitionB" location="7:1-7:60"
              condition="check_B_ok"/>

    <!-- Connections: fan-out from s0 to s1,s2; fan-in from s1,s2 to s3 -->
    <!-- s0 -> t0 (step to transition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0"
                 name="Arc_Init_to_Split" location="10:1-10:80"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>

    <!-- t0 -> s1 (transition to step) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1"
                 name="Arc_Split_to_A" location="11:1-11:80"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>

    <!-- t0 -> s2 (transition to step) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2"
                 name="Arc_Split_to_B" location="12:1-12:80"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>

    <!-- s1 -> t1 (step to transition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3"
                 name="Arc_A_to_JoinA" location="13:1-13:80"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>

    <!-- s2 -> t2 (step to transition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4"
                 name="Arc_B_to_JoinB" location="14:1-14:80"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>

    <!-- t1 -> s3 (transition to step) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5"
                 name="Arc_JoinA_to_Final" location="15:1-15:80"
                 from="/0/@elements.5"
                 to="/0/@elements.3"/>

    <!-- t2 -> s3 (transition to step) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6"
                 name="Arc_JoinB_to_Final" location="16:1-16:80"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>

  </Grafcet:Grafcet>
</xmi:XMI>