<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g000" name="ComplexGrafcet" location="1:1-1:80">
    <!-- Elements: steps and transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="InitStep" location="2:1-2:40" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="BranchStep1" location="3:1-3:45" isInitial="false" isActive="false" action="prepareBranch1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="BranchStep2" location="4:1-4:45" isInitial="false" isActive="false" action="prepareBranch2"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="MergeStep" location="5:1-5:45" isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="LoopStep" location="6:1-6:45" isInitial="false" isActive="false" action="loopProcessing"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" name="FinalStep" location="7:1-7:45" isInitial="false" isActive="false" action="finalizeSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_init_to_branch" location="8:1-8:50" condition="startCommand"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_branch1" location="9:1-9:50" condition="branch1Ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_branch2" location="10:1-10:50" condition="branch2Ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_merge" location="11:1-11:50" condition="branchesCompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_loopForward" location="12:1-12:50" condition="continueLoop"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="T_loopBack" location="13:1-13:50" condition="repeatLoop"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t7" name="T_to_final" location="14:1-14:50" condition="finishCommand"/>

    <!-- Connections: from steps to transitions -->
    <!-- InitStep -> T_init_to_branch -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_st_1" name="C_Init_to_T1" location="15:1-15:40" from="/0/@elements.0" to="/0/@elements.6"/>
    <!-- BranchStep1 -> T_branch1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_st_2" name="C_S2_to_T2" location="16:1-16:40" from="/0/@elements.1" to="/0/@elements.7"/>
    <!-- BranchStep2 -> T_branch2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_st_3" name="C_S3_to_T3" location="17:1-17:40" from="/0/@elements.2" to="/0/@elements.8"/>
    <!-- MergeStep -> T_loopForward -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_st_4" name="C_S4_to_T5" location="18:1-18:40" from="/0/@elements.3" to="/0/@elements.10"/>
    <!-- LoopStep -> T_loopBack -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_st_5" name="C_S5_to_T6" location="19:1-19:40" from="/0/@elements.4" to="/0/@elements.11"/>
    <!-- LoopStep -> T_to_final -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_st_6" name="C_S5_to_T7" location="20:1-20:40" from="/0/@elements.4" to="/0/@elements.12"/>

    <!-- Connections: from transitions to steps -->
    <!-- T_init_to_branch -> BranchStep1 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_ts_1" name="C_T1_to_S2" location="21:1-21:40" from="/0/@elements.6" to="/0/@elements.1"/>
    <!-- T_init_to_branch -> BranchStep2 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_ts_2" name="C_T1_to_S3" location="22:1-22:40" from="/0/@elements.6" to="/0/@elements.2"/>
    <!-- T_branch1 -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_ts_3" name="C_T2_to_S4" location="23:1-23:40" from="/0/@elements.7" to="/0/@elements.3"/>
    <!-- T_branch2 -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_ts_4" name="C_T3_to_S4" location="24:1-24:40" from="/0/@elements.8" to="/0/@elements.3"/>
    <!-- T_merge -> LoopStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_ts_5" name="C_T4_to_S5" location="25:1-25:40" from="/0/@elements.9" to="/0/@elements.4"/>
    <!-- T_loopForward -> LoopStep (self-loop entry) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_ts_6" name="C_T5_to_S5" location="26:1-26:40" from="/0/@elements.10" to="/0/@elements.4"/>
    <!-- T_loopBack -> MergeStep (back edge) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_ts_7" name="C_T6_to_S4" location="27:1-27:40" from="/0/@elements.11" to="/0/@elements.3"/>
    <!-- T_to_final -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_ts_8" name="C_T7_to_S6" location="28:1-28:40" from="/0/@elements.12" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>