<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="g1" name="ComplexGrafcet" location="1">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="s1" name="StartStep" location="2" isInitial="true" isActive="true" action="initSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s2" name="ProcessingStepA" location="3" isInitial="false" isActive="false" action="processA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s3" name="ProcessingStepB" location="4" isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s4" name="MergeStep" location="5" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s5" name="LoopStep" location="6" isInitial="false" isActive="false" action="iterate"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s6" name="FinalStep" location="7" isInitial="false" isActive="false" action="shutdown"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="t1" name="toA" location="8" condition="condA"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t2" name="toB" location="9" condition="condB"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t3" name="joinAB" location="10" condition="condJoin"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t4" name="toLoop" location="11" condition="loopReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t5" name="loopBack" location="12" condition="continueLoop"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t6" name="toFinal" location="13" condition="finish"/>

    <!-- Connections: from Steps to Transitions -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c1" name="Start_to_t1" location="14" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi-type="Grafcet:StepToTransition" xmi:id="c2" name="Start_to_t2" location="15" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c3" name="A_to_t3" location="16" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c4" name="B_to_t3" location="17" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c5" name="Merge_to_t4" location="18" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c6" name="Loop_to_t5" location="19" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c7" name="Loop_to_t6" location="20" from="/0/@elements.4" to="/0/@elements.11"/>

    <!-- Connections: from Transitions to Steps -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c8" name="t1_to_A" location="21" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c9" name="t2_to_B" location="22" from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c10" name="t3_to_Merge" location="23" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c11" name="t4_to_Loop" location="24" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c12" name="t5_to_Loop" location="25" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c13" name="t6_to_Final" location="26" from="/0/@elements.11" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>