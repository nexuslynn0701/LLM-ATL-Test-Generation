<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="model://ComplexGrafcetExample">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="model://ComplexGrafcetExample#InitStep" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckInputs" location="model://ComplexGrafcetExample#CheckInputs" isInitial="false" isActive="false" action="check_inputs"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ComputeA" location="model://ComplexGrafcetExample#ComputeA" isInitial="false" isActive="false" action="compute_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ComputeB" location="model://ComplexGrafcetExample#ComputeB" isInitial="false" isActive="false" action="compute_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="MergeResults" location="model://ComplexGrafcetExample#MergeResults" isInitial="false" isActive="false" action="merge_results"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="FinalizeStep" location="model://ComplexGrafcetExample#FinalizeStep" isInitial="false" isActive="false" action="finalize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" name="ErrorHandler" location="model://ComplexGrafcetExample#ErrorHandler" isInitial="false" isActive="false" action="handle_error"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_To_Check" location="model://ComplexGrafcetExample#T_Init_To_Check" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Check_To_Parallel" location="model://ComplexGrafcetExample#T_Check_To_Parallel" condition="inputs_valid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_Error_From_Check" location="model://ComplexGrafcetExample#T_Error_From_Check" condition="inputs_invalid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_Parallel_To_Merge" location="model://ComplexGrafcetExample#T_Parallel_To_Merge" condition="A_done_and_B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_Merge_To_Final" location="model://ComplexGrafcetExample#T_Merge_To_Final" condition="merge_success"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_Error_To_Final" location="model://ComplexGrafcetExample#T_Error_To_Final" condition="ack_error"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="model://ComplexGrafcetExample#C_Init_to_T0" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Check_to_T1" location="model://ComplexGrafcetExample#C_Check_to_T1" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Check_to_T2" location="model://ComplexGrafcetExample#C_Check_to_T2" from="/0/@elements.1" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_ComputeA_to_T3" location="model://ComplexGrafcetExample#C_ComputeA_to_T3" from="/0/@elements.2" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_ComputeB_to_T3" location="model://ComplexGrafcetExample#C_ComputeB_to_T3" from="/0/@elements.3" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_Merge_to_T4" location="model://ComplexGrafcetExample#C_Merge_to_T4" from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_Error_to_T5" location="model://ComplexGrafcetExample#C_Error_to_T5" from="/0/@elements.6" to="/0/@elements.12"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_T0_to_Check" location="model://ComplexGrafcetExample#C_T0_to_Check" from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_T1_to_ComputeA" location="model://ComplexGrafcetExample#C_T1_to_ComputeA" from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_T1_to_ComputeB" location="model://ComplexGrafcetExample#C_T1_to_ComputeB" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_T2_to_Error" location="model://ComplexGrafcetExample#C_T2_to_Error" from="/0/@elements.9" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_T3_to_Merge" location="model://ComplexGrafcetExample#C_T3_to_Merge" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_T4_to_Final" location="model://ComplexGrafcetExample#C_T4_to_Final" from="/0/@elements.11" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="C_T5_to_Final" location="model://ComplexGrafcetExample#C_T5_to_Final" from="/0/@elements.12" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>