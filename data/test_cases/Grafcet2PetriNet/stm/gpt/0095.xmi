<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet" location="loc_grafcet_1">

    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="loc_step_0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="ProcessingStepA" location="loc_step_1" isInitial="false" isActive="false" action="processA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ProcessingStepB" location="loc_step_2" isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="MergeStep" location="loc_step_3" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="FinalStep" location="loc_step_4" isInitial="false" isActive="false" action="finalizeSystem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_Init_To_Branch" location="loc_trans_0" condition="startCommand"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_To_A" location="loc_trans_1" condition="pathASelected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_To_B" location="loc_trans_2" condition="pathBSelected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="T_From_A" location="loc_trans_3" condition="ACompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" name="T_From_B" location="loc_trans_4" condition="BCompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T5" name="T_To_Final" location="loc_trans_5" condition="mergingDone"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_S0_T0" location="loc_conn_0"
                 from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C1" name="C_S0_T1" location="loc_conn_1"
                 from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="C_S0_T2" location="loc_conn_2"
                 from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="C_S1_T3" location="loc_conn_3"
                 from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_S2_T4" location="loc_conn_4"
                 from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C5" name="C_S3_T5" location="loc_conn_5"
                 from="/0/@elements.3" to="/0/@elements.10"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C6" name="C_T0_S1" location="loc_conn_6"
                 from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="C_T0_S2" location="loc_conn_7"
                 from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C8" name="C_T1_S1" location="loc_conn_8"
                 from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C9" name="C_T2_S2" location="loc_conn_9"
                 from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C10" name="C_T3_S3" location="loc_conn_10"
                 from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C11" name="C_T4_S3" location="loc_conn_11"
                 from="/0/@elements.9" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C12" name="C_T5_S4" location="loc_conn_12"
                 from="/0/@elements.10" to="/0/@elements.4"/>

  </Grafcet:Grafcet>
</xmi:XMI>