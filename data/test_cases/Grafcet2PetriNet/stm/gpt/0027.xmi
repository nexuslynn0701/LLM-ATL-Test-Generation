<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet_0027" location="file://complex_grafcet_0027.grafcet">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="1,1" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="BranchStepA" location="2,1" isInitial="false" isActive="false" action="executeBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="BranchStepB" location="2,2" isInitial="false" isActive="false" action="executeBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="JoinStep" location="3,1" isInitial="false" isActive="false" action="joinBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="LoopStep" location="4,1" isInitial="false" isActive="false" action="loopProcessing"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S5" name="FinalStep" location="5,1" isInitial="false" isActive="false" action="finalizeSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_Init_to_Branch" location="1.5,1" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_Branch_to_JoinA" location="2.5,1" condition="branchACompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_Branch_to_JoinB" location="2.5,2" condition="branchBCompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="T_Join_to_Loop" location="3.5,1" condition="bothBranchesDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" name="T_Loop_self" location="4.5,1" condition="needMoreIterations"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T5" name="T_Loop_to_Final" location="4.5,2" condition="loopComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T6" name="T_Skip_to_Final" location="2.5,0" condition="skipBranches"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_S0_T0" location="c0" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C1" name="C_S1_T1" location="c1" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="C_S2_T2" location="c2" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="C_S3_T3" location="c3" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_S4_T4" location="c4" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C5" name="C_S4_T5" location="c5" from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" name="C_S0_T6" location="c6" from="/0/@elements.0" to="/0/@elements.12"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="C_T0_S1" location="c7" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C8" name="C_T0_S2" location="c8" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C9" name="C_T1_S3" location="c9" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C10" name="C_T2_S3" location="c10" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C11" name="C_T3_S4" location="c11" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C12" name="C_T4_S4" location="c12" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C13" name="C_T5_S5" location="c13" from="/0/@elements.11" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C14" name="C_T6_S5" location="c14" from="/0/@elements.12" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>