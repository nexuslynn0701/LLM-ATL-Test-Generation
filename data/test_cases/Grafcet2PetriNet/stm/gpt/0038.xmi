<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="loc:grafcet:0">

    <!-- Elements: 4 Steps, 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="loc:step:0"
              isInitial="true" isActive="true" action="initializeSystem()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ParallelStepA" location="loc:step:1"
              isInitial="false" isActive="false" action="doActionA()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ParallelStepB" location="loc:step:2"
              isInitial="false" isActive="false" action="doActionB()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="FinalStep" location="loc:step:3"
              isInitial="false" isActive="false" action="shutdownSystem()"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="SplitTransition" location="loc:trans:0"
              condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="JoinTransition" location="loc:trans:1"
              condition="bothDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="LoopTransition" location="loc:trans:2"
              condition="retryRequested"/>

    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- InitStep -> SplitTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0"
                 name="c_Init_to_Split" location="loc:conn:0"
                 from="/0/@elements.0" to="/0/@elements.4"/>
    <!-- SplitTransition -> ParallelStepA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1"
                 name="c_Split_to_A" location="loc:conn:1"
                 from="/0/@elements.4" to="/0/@elements.1"/>
    <!-- SplitTransition -> ParallelStepB -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2"
                 name="c_Split_to_B" location="loc:conn:2"
                 from="/0/@elements.4" to="/0/@elements.2"/>

    <!-- ParallelStepA -> JoinTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3"
                 name="c_A_to_Join" location="loc:conn:3"
                 from="/0/@elements.1" to="/0/@elements.5"/>
    <!-- ParallelStepB -> JoinTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4"
                 name="c_B_to_Join" location="loc:conn:4"
                 from="/0/@elements.2" to="/0/@elements.5"/>

    <!-- JoinTransition -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5"
                 name="c_Join_to_Final" location="loc:conn:5"
                 from="/0/@elements.5" to="/0/@elements.3"/>

    <!-- Loop: FinalStep -> LoopTransition -> ParallelStepA -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6"
                 name="c_Final_to_Loop" location="loc:conn:6"
                 from="/0/@elements.3" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7"
                 name="c_Loop_to_A" location="loc:conn:7"
                 from="/0/@elements.6" to="/0/@elements.1"/>

  </Grafcet:Grafcet>
</xmi:XMI>