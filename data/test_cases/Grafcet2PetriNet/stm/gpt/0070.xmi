<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="1:1-100:1">
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="2:1-2:40" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckSensors" location="3:1-3:45" isInitial="false" isActive="false" action="readSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessData" location="4:1-4:45" isInitial="false" isActive="false" action="computeValues"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="Idle" location="5:1-5:35" isInitial="false" isActive="false" action="waitForEvent"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="ErrorHandler" location="6:1-6:45" isInitial="false" isActive="false" action="handleError"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToCheck" location="10:1-10:40" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_CheckToProcess" location="11:1-11:45" condition="sensorsOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_ProcessToIdle" location="12:1-12:45" condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_ErrorDetected" location="13:1-13:45" condition="errorDetected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_Recovery" location="14:1-14:45" condition="recover"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_Check" location="20:1-20:40" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="C_Check_FromInit" location="21:1-21:50" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Check_Process" location="22:1-22:45" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="C_Process_FromCheck" location="23:1-23:50" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_Process_Idle" location="24:1-24:45" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_Idle_FromProcess" location="25:1-25:50" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_Check_Error" location="26:1-26:45" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_Error_FromCheck" location="27:1-27:50" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="C_Error_Idle" location="28:1-28:45" from="/0/@elements.4" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_Idle_FromError" location="29:1-29:50" from="/0/@elements.9" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>