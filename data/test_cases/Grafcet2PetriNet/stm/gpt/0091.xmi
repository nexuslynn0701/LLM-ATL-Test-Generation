<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet0091" location="0:0-0:0">
    <!-- Elements: 4 Steps + 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initAction()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="ParallelStepA" location="2:1-2:25" isInitial="false" isActive="false" action="doA()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ParallelStepB" location="3:1-3:25" isInitial="false" isActive="false" action="doB()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="FinalStep" location="4:1-4:20" isInitial="false" isActive="false" action="finish()"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="SplitTransition" location="5:1-5:25" condition="condSplit"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="JoinTransition" location="6:1-6:22" condition="condJoin"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="LoopTransition" location="7:1-7:23" condition="condLoop"/>

    <!-- Connections: cover multiple patterns (fan-out, fan-in, loop, chain) -->

    <!-- From initial step to split transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="S0_to_T0" location="8:1-8:30" from="/0/@elements.0" to="/0/@elements.4"/>

    <!-- Split: T0 to S1 and S2 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="T0_to_S1" location="9:1-9:30" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C2" name="T0_to_S2" location="10:1-10:30" from="/0/@elements.4" to="/0/@elements.2"/>

    <!-- From S1 and S2 to join transition T1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="S1_to_T1" location="11:1-11:30" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="S2_to_T1" location="12:1-12:30" from="/0/@elements.2" to="/0/@elements.5"/>

    <!-- T1 goes to final step S3 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="T1_to_S3" location="13:1-13:30" from="/0/@elements.5" to="/0/@elements.3"/>

    <!-- Loop: from final step S3 back through T2 to S1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" name="S3_to_T2" location="14:1-14:30" from="/0/@elements.3" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="T2_to_S1" location="15:1-15:30" from="/0/@elements.6" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>