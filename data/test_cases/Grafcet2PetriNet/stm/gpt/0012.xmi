<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="g1" name="ComplexSequentialParallelGrafcet" location="testLocation.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="s1" name="InitStep" location="loc_s1" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s2" name="BranchStepA" location="loc_s2" isInitial="false" isActive="false" action="prepareBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s3" name="BranchStepB" location="loc_s3" isInitial="false" isActive="false" action="prepareBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s4" name="JoinStep" location="loc_s4" isInitial="false" isActive="false" action="joinBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="s5" name="FinalStep" location="loc_s5" isInitial="false" isActive="false" action="finalizeProcess"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="t1" name="T_Init_to_Branches" location="loc_t1" condition="startCommand"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t2" name="T_BranchA_to_Join" location="loc_t2" condition="branchA_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t3" name="T_BranchB_to_Join" location="loc_t3" condition="branchB_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="t4" name="T_Join_to_Final" location="loc_t4" condition="all_branches_done"/>
    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- From initial step to branching transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c1" name="C_Init_to_T1" location="loc_c1" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- From branching transition to branch step A -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c2" name="C_T1_to_A" location="loc_c2" from="/0/@elements.5" to="/0/@elements.1"/>
    <!-- From branching transition to branch step B -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c3" name="C_T1_to_B" location="loc_c3" from="/0/@elements.5" to="/0/@elements.2"/>
    <!-- From branch step A to its transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c4" name="C_A_to_T2" location="loc_c4" from="/0/@elements.1" to="/0/@elements.6"/>
    <!-- From branch step B to its transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c5" name="C_B_to_T3" location="loc_c5" from="/0/@elements.2" to="/0/@elements.7"/>
    <!-- From branch A transition to join step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c6" name="C_T2_to_Join" location="loc_c6" from="/0/@elements.6" to="/0/@elements.3"/>
    <!-- From branch B transition to join step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c7" name="C_T3_to_Join" location="loc_c7" from="/0/@elements.7" to="/0/@elements.3"/>
    <!-- From join step to final transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="c8" name="C_Join_to_T4" location="loc_c8" from="/0/@elements.3" to="/0/@elements.8"/>
    <!-- From final transition to final step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="c9" name="C_T4_to_Final" location="loc_c9" from="/0/@elements.8" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>