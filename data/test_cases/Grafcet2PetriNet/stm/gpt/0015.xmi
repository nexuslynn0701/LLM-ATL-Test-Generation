<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="1:1-40:1">
    <!-- Elements: mix of steps and transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="2:3-2:40"
              isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ParallelStepA" location="3:3-3:45"
              isInitial="false" isActive="false" action="run_branch_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ParallelStepB" location="4:3-4:45"
              isInitial="false" isActive="false" action="run_branch_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="JoinStep" location="5:3-5:40"
              isInitial="false" isActive="false" action="join_branches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="LoopBody" location="6:3-6:40"
              isInitial="false" isActive="false" action="loop_action"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="FinalStep" location="7:3-7:40"
              isInitial="false" isActive="false" action="finalize"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_to_Parallel" location="10:3-10:60"
              condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_to_A" location="11:3-11:50"
              condition="select_A"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_to_B" location="12:3-12:50"
              condition="select_B"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_Parallel_to_Join" location="13:3-13:60"
              condition="A_done AND B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_Join_to_Loop" location="14:3-14:55"
              condition="joined_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_Loop_to_Loop" location="15:3-15:55"
              condition="loop_continue"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="T_Loop_to_Final" location="16:3-16:55"
              condition="loop_exit"/>

    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- InitStep -> T_Init_to_Parallel -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0"
                 name="C_Init_to_Parallel" location="20:3-20:60"
                 from="/0/@elements.0" to="/0/@elements.6"/>
    <!-- T_Init_to_Parallel -> ParallelStepA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1"
                 name="C_ParallelA_from_Init" location="21:3-21:65"
                 from="/0/@elements.6" to="/0/@elements.1"/>
    <!-- T_Init_to_Parallel -> ParallelStepB -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2"
                 name="C_ParallelB_from_Init" location="22:3-22:65"
                 from="/0/@elements.6" to="/0/@elements.2"/>

    <!-- ParallelStepA -> T_to_A -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3"
                 name="C_A_to_TA" location="23:3-23:50"
                 from="/0/@elements.1" to="/0/@elements.7"/>
    <!-- T_to_A -> JoinStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4"
                 name="C_TA_to_Join" location="24:3-24:55"
                 from="/0/@elements.7" to="/0/@elements.3"/>

    <!-- ParallelStepB -> T_to_B -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5"
                 name="C_B_to_TB" location="25:3-25:50"
                 from="/0/@elements.2" to="/0/@elements.8"/>
    <!-- T_to_B -> JoinStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6"
                 name="C_TB_to_Join" location="26:3-26:55"
                 from="/0/@elements.8" to="/0/@elements.3"/>

    <!-- JoinStep -> T_Join_to_Loop -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7"
                 name="C_Join_to_Loop" location="27:3-27:55"
                 from="/0/@elements.3" to="/0/@elements.10"/>
    <!-- T_Join_to_Loop -> LoopBody -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8"
                 name="C_JoinLoop_to_Body" location="28:3-28:60"
                 from="/0/@elements.10" to="/0/@elements.4"/>

    <!-- LoopBody -> T_Loop_to_Loop (self-loop transition in loop region) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c9"
                 name="C_LoopBody_to_TLoop" location="29:3-29:60"
                 from="/0/@elements.4" to="/0/@elements.11"/>
    <!-- T_Loop_to_Loop -> LoopBody (closing the loop) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10"
                 name="C_TLoop_to_Body" location="30:3-30:55"
                 from="/0/@elements.11" to="/0/@elements.4"/>

    <!-- LoopBody -> T_Loop_to_Final -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c11"
                 name="C_LoopBody_to_FinalT" location="31:3-31:65"
                 from="/0/@elements.4" to="/0/@elements.12"/>
    <!-- T_Loop_to_Final -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12"
                 name="C_FinalT_to_FinalStep" location="32:3-32:65"
                 from="/0/@elements.12" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>