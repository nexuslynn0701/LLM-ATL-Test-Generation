<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="loc_g0">

    <!-- Elements: 4 Steps and 3 Transitions forming a branched / merged structure -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="StartStep" location="loc_s0"
              isInitial="true" isActive="true" action="initSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="LeftBranchStep" location="loc_s1"
              isInitial="false" isActive="false" action="processLeft"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="RightBranchStep" location="loc_s2"
              isInitial="false" isActive="false" action="processRight"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="MergeStep" location="loc_s3"
              isInitial="false" isActive="false" action="finalize"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="SplitTransition" location="loc_t0"
              condition="cond_split"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="LeftToMergeTransition" location="loc_t1"
              condition="cond_left_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="RightToMergeTransition" location="loc_t2"
              condition="cond_right_done"/>

    <!-- Connections: S0 -> T0, then T0 -> S1 and S2 (branch), then S1/S2 -> T1/T2, then T1/T2 -> S3 (merge) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="Arc_S0_T0" location="loc_c0"
                 from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="Arc_T0_S1" location="loc_c1"
                 from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="Arc_T0_S2" location="loc_c2"
                 from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="Arc_S1_T1" location="loc_c3"
                 from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="Arc_S2_T2" location="loc_c4"
                 from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="Arc_T1_S3" location="loc_c5"
                 from="/0/@elements.5" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="Arc_T2_S3" location="loc_c6"
                 from="/0/@elements.6" to="/0/@elements.3"/>

  </Grafcet:Grafcet>
</xmi:XMI>