<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcetExample" location="loc_grafcet_0031">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="loc_s0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="CheckSensors" location="loc_s1" isInitial="false" isActive="false" action="readSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ProcessData" location="loc_s2" isInitial="false" isActive="false" action="computeValues"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="StoreResults" location="loc_s3" isInitial="false" isActive="false" action="saveToDatabase"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="ErrorHandler" location="loc_s4" isInitial="false" isActive="false" action="handleError"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S5" name="Finalize" location="loc_s5" isInitial="false" isActive="false" action="cleanupAndStop"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_InitToCheck" location="loc_t0" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_CheckToProcess" location="loc_t1" condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_CheckToError" location="loc_t2" condition="sensors_fail"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="T_ProcessToStoreOrError" location="loc_t3" condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" name="T_StoreToFinalize" location="loc_t4" condition="store_success"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T5" name="T_ErrorToFinalize" location="loc_t5" condition="error_resolved"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T6" name="T_FinalizeToInit" location="loc_t6" condition="restart_requested"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_S0_T0" location="loc_c0" grafcet="/0" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C1" name="C_S1_T1" location="loc_c1" grafcet="/0" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="C_S1_T2" location="loc_c2" grafcet="/0" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="C_S2_T3" location="loc_c3" grafcet="/0" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_S3_T4" location="loc_c4" grafcet="/0" from="/0/@elements.3" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C5" name="C_S4_T5" location="loc_c5" grafcet="/0" from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" name="C_S5_T6" location="loc_c6" grafcet="/0" from="/0/@elements.5" to="/0/@elements.12"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="C_T0_S1" location="loc_c7" grafcet="/0" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C8" name="C_T1_S2" location="loc_c8" grafcet="/0" from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C9" name="C_T2_S4" location="loc_c9" grafcet="/0" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C10" name="C_T3_S3" location="loc_c10" grafcet="/0" from="/0/@elements.9" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C11" name="C_T3_S4" location="loc_c11" grafcet="/0" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C12" name="C_T4_S5" location="loc_c12" grafcet="/0" from="/0/@elements.10" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C13" name="C_T5_S5" location="loc_c13" grafcet="/0" from="/0/@elements.11" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C14" name="C_T6_S0" location="loc_c14" grafcet="/0" from="/0/@elements.12" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>