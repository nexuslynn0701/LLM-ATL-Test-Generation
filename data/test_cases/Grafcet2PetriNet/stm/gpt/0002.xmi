<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file://complexGrafcet.gcf">
    <!-- Elements: 4 Steps and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="1:1-1:20"
              isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ProcessingStepA" location="2:1-2:25"
              isInitial="false" isActive="false" action="processA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessingStepB" location="3:1-3:25"
              isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="FinalStep" location="4:1-4:25"
              isInitial="false" isActive="false" action="finalize"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_to_A" location="5:1-5:25"
              condition="start and ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_A_to_B" location="6:1-6:25"
              condition="doneA or retryA"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_B_to_Final" location="7:1-7:25"
              condition="doneB and not error"/>

    <!-- Connections: linear chain S0 -> T0 -> S1 -> T1 -> S2 -> T2 -> S3,
         plus a backward branch from S2 back to T0 to create a loop -->
    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="Arc_S0_T0" location="8:1-8:30"
                 from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="Arc_S1_T1" location="9:1-9:30"
                 from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="Arc_S2_T2" location="10:1-10:30"
                 from="/0/@elements.2" to="/0/@elements.6"/>
    <!-- backward/alternative StepToTransition creating a loop -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="Arc_S2_T0_Back" location="11:1-11:35"
                 from="/0/@elements.2" to="/0/@elements.4"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="Arc_T0_S1" location="12:1-12:30"
                 from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="Arc_T1_S2" location="13:1-13:30"
                 from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="Arc_T2_S3" location="14:1-14:30"
                 from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>