<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcetExample" location="file://grafcet/complexExample.grafcet">

    <!-- Elements: Steps and Transitions -->
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="1:1-1:20"
              isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="BranchStepA" location="2:1-2:25"
              isInitial="false" isActive="false" action="processBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="BranchStepB" location="3:1-3:25"
              isInitial="false" isActive="false" action="processBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="MergeStep" location="4:1-4:20"
              isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="LoopStep" location="5:1-5:20"
              isInitial="false" isActive="false" action="loopProcessing"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S5" name="TerminalStep" location="6:1-6:25"
              isInitial="false" isActive="false" action="finalizeSystem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_Init_to_Branches" location="10:1-10:35"
              condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_to_BranchA" location="11:1-11:30"
              condition="mode = A"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_to_BranchB" location="12:1-12:30"
              condition="mode = B"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="T_Branches_to_Merge" location="13:1-13:35"
              condition="branchDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" name="T_Loop" location="14:1-14:25"
              condition="needMoreProcessing"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T5" name="T_ExitLoop" location="15:1-15:30"
              condition="noMoreProcessing"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T6" name="T_to_Terminal" location="16:1-16:30"
              condition="finalCondition"/>

    <!-- Connections -->
    <!-- Initial step to first transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0"
                 name="C_InitStep_to_T0" location="20:1-20:40"
                 from="/0/@elements.0" to="/0/@elements.6"/>
    <!-- T0 to BranchStepA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1"
                 name="C_T0_to_S1" location="21:1-21:35"
                 from="/0/@elements.6" to="/0/@elements.1"/>
    <!-- T0 to BranchStepB -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C2"
                 name="C_T0_to_S2" location="22:1-22:35"
                 from="/0/@elements.6" to="/0/@elements.2"/>

    <!-- BranchStepA to T1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3"
                 name="C_S1_to_T1" location="23:1-23:35"
                 from="/0/@elements.1" to="/0/@elements.7"/>
    <!-- BranchStepB to T2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4"
                 name="C_S2_to_T2" location="24:1-24:35"
                 from="/0/@elements.2" to="/0/@elements.8"/>

    <!-- T1 to MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5"
                 name="C_T1_to_S3" location="25:1-25:35"
                 from="/0/@elements.7" to="/0/@elements.3"/>
    <!-- T2 to MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C6"
                 name="C_T2_to_S3" location="26:1-26:35"
                 from="/0/@elements.8" to="/0/@elements.3"/>

    <!-- MergeStep to T3 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C7"
                 name="C_S3_to_T3" location="27:1-27:35"
                 from="/0/@elements.3" to="/0/@elements.9"/>

    <!-- T3 to LoopStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C8"
                 name="C_T3_to_S4" location="28:1-28:35"
                 from="/0/@elements.9" to="/0/@elements.4"/>

    <!-- LoopStep to T4 (loop back) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C9"
                 name="C_S4_to_T4" location="29:1-29:35"
                 from="/0/@elements.4" to="/0/@elements.10"/>
    <!-- T4 back to LoopStep (self-loop) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C10"
                 name="C_T4_to_S4" location="30:1-30:35"
                 from="/0/@elements.10" to="/0/@elements.4"/>

    <!-- LoopStep to T5 (exit loop) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C11"
                 name="C_S4_to_T5" location="31:1-31:35"
                 from="/0/@elements.4" to="/0/@elements.11"/>

    <!-- T5 to TerminalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C12"
                 name="C_T5_to_S5" location="32:1-32:35"
                 from="/0/@elements.11" to="/0/@elements.5"/>

    <!-- TerminalStep to T6 (optional final transition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C13"
                 name="C_S5_to_T6" location="33:1-33:35"
                 from="/0/@elements.5" to="/0/@elements.12"/>

    <!-- T6 back to MergeStep to create another branch into terminal section -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C14"
                 name="C_T6_to_S3" location="34:1-34:35"
                 from="/0/@elements.12" to="/0/@elements.3"/>

  </Grafcet:Grafcet>
</xmi:XMI>