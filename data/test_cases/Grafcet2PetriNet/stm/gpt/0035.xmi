<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet" location="test/location/0035">
    <!-- Elements: 4 Steps, 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="loc_S0"
              isInitial="true" isActive="true" action="initAction"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="BranchStep1" location="loc_S1"
              isInitial="false" isActive="false" action="branch1Action"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="BranchStep2" location="loc_S2"
              isInitial="false" isActive="false" action="branch2Action"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="MergeStep" location="loc_S3"
              isInitial="false" isActive="false" action="mergeAction"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_InitToBranches" location="loc_T0"
              condition="startCondition"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_Branch1ToMerge" location="loc_T1"
              condition="condBranch1"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_Branch2ToMerge" location="loc_T2"
              condition="condBranch2"/>

    <!-- Connections: fan-out and fan-in pattern -->
    <!-- InitStep -> T_InitToBranches -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0"
                 name="ST_Init_to_T0" location="loc_C0"
                 from="/0/@elements.0" to="/0/@elements.4"/>
    <!-- T_InitToBranches -> BranchStep1 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1"
                 name="TT_T0_to_B1" location="loc_C1"
                 from="/0/@elements.4" to="/0/@elements.1"/>
    <!-- T_InitToBranches -> BranchStep2 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C2"
                 name="TT_T0_to_B2" location="loc_C2"
                 from="/0/@elements.4" to="/0/@elements.2"/>

    <!-- BranchStep1 -> T_Branch1ToMerge -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3"
                 name="ST_B1_to_T1" location="loc_C3"
                 from="/0/@elements.1" to="/0/@elements.5"/>
    <!-- BranchStep2 -> T_Branch2ToMerge -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4"
                 name="ST_B2_to_T2" location="loc_C4"
                 from="/0/@elements.2" to="/0/@elements.6"/>

    <!-- T_Branch1ToMerge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5"
                 name="TT_T1_to_Merge" location="loc_C5"
                 from="/0/@elements.5" to="/0/@elements.3"/>
    <!-- T_Branch2ToMerge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C6"
                 name="TT_T2_to_Merge" location="loc_C6"
                 from="/0/@elements.6" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>