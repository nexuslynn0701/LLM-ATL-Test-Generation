<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet0041" location="file://complexGrafcet0041.grafcet">

    <!-- Elements: 4 Steps + 3 Transitions = 7 elements -->
    <elements xmi:id="step0" xsi:type="Grafcet:Step"
              name="InitStep" location="1:1-1:20"
              isInitial="true" isActive="true"
              action="initializeSystem"/>
    <elements xmi:id="step1" xsi:type="Grafcet:Step"
              name="ParallelStepA" location="2:1-2:25"
              isInitial="false" isActive="false"
              action="runBranchA"/>
    <elements xmi:id="step2" xsi:type="Grafcet:Step"
              name="ParallelStepB" location="3:1-3:25"
              isInitial="false" isActive="false"
              action="runBranchB"/>
    <elements xmi:id="step3" xsi:type="Grafcet:Step"
              name="MergeStep" location="4:1-4:20"
              isInitial="false" isActive="false"
              action="mergeBranches"/>

    <elements xmi:id="trans0" xsi:type="Grafcet:Transition"
              name="ToParallel" location="5:1-5:25"
              condition="startParallel"/>
    <elements xmi:id="trans1" xsi:type="Grafcet:Transition"
              name="ToMergeFromA" location="6:1-6:28"
              condition="doneA"/>
    <elements xmi:id="trans2" xsi:type="Grafcet:Transition"
              name="ToMergeFromB" location="7:1-7:28"
              condition="doneB"/>

    <!-- Connections:
         step0 -> trans0 -> step1 and step2 (fan-out)
         step1 -> trans1 -> step3
         step2 -> trans2 -> step3
    -->
    <connections xmi:id="c0" xsi:type="Grafcet:StepToTransition"
                 name="Init_to_ToParallel" location="8:1-8:30"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>

    <connections xmi:id="c1" xsi:type="Grafcet:TransitionToStep"
                 name="ToParallel_to_A" location="9:1-9:30"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>

    <connections xmi:id="c2" xsi:type="Grafcet:TransitionToStep"
                 name="ToParallel_to_B" location="10:1-10:30"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>

    <connections xmi:id="c3" xsi:type="Grafcet:StepToTransition"
                 name="A_to_ToMergeFromA" location="11:1-11:32"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>

    <connections xmi:id="c4" xsi:type="Grafcet:TransitionToStep"
                 name="ToMergeFromA_to_Merge" location="12:1-12:35"
                 from="/0/@elements.5"
                 to="/0/@elements.3"/>

    <connections xmi:id="c5" xsi:type="Grafcet:StepToTransition"
                 name="B_to_ToMergeFromB" location="13:1-13:32"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>

    <connections xmi:id="c6" xsi:type="Grafcet:TransitionToStep"
                 name="ToMergeFromB_to_Merge" location="14:1-14:35"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>

  </Grafcet:Grafcet>
</xmi:XMI>