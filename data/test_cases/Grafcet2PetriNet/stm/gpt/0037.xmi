<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="file://complex_grafcet.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="1:1-1:10" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckSensors" location="2:1-2:15" isInitial="false" isActive="false" action="readSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ErrorHandler" location="3:1-3:15" isInitial="false" isActive="false" action="handleError"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ProcessData" location="4:1-4:15" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="Finalize" location="5:1-5:10" isInitial="false" isActive="false" action="finalizeRun"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="LogStatistics" location="6:1-6:15" isInitial="false" isActive="false" action="logStats"/>
    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_init_to_check" location="10:1-10:20" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_check_to_process" location="11:1-11:22" condition="sensorsOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_check_to_error" location="12:1-12:22" condition="sensorsFail"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_error_to_init" location="13:1-13:20" condition="resetRequested"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_process_to_finalize" location="14:1-14:25" condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_finalize_to_log" location="15:1-15:22" condition="logEnabled"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="T_finalize_to_init" location="16:1-16:22" condition="restartRequested"/>
    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_s0_t0" location="20:1-20:15" grafcet="/0" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_s1_t1" location="21:1-21:15" grafcet="/0" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_s1_t2" location="22:1-22:15" grafcet="/0" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_s2_t3" location="23:1-23:15" grafcet="/0" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_s3_t4" location="24:1-24:15" grafcet="/0" from="/0/@elements.3" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_s4_t5" location="25:1-25:15" grafcet="/0" from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_s4_t6" location="26:1-26:15" grafcet="/0" from="/0/@elements.4" to="/0/@elements.12"/>
    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_t0_s1" location="30:1-30:15" grafcet="/0" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_t1_s3" location="31:1-31:15" grafcet="/0" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_t2_s2" location="32:1-32:15" grafcet="/0" from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_t3_s0" location="33:1-33:15" grafcet="/0" from="/0/@elements.9" to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_t4_s4" location="34:1-34:15" grafcet="/0" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_t5_s5" location="35:1-35:15" grafcet="/0" from="/0/@elements.11" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="C_t6_s0" location="36:1-36:15" grafcet="/0" from="/0/@elements.12" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>