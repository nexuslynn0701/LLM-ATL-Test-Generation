<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexSequenceWithBranchAndLoop" location="1:1-200:1">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="2:1-2:40" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="LoadStep" location="3:1-3:40" isInitial="false" isActive="false" action="loadResources"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessStep" location="4:1-4:40" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="CheckStep" location="5:1-5:40" isInitial="false" isActive="false" action="checkCondition"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="AltProcessStep" location="6:1-6:40" isInitial="false" isActive="false" action="alternativeProcess"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="MergeStep" location="7:1-7:40" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" name="FinalStep" location="8:1-8:40" isInitial="false" isActive="false" action="finalizeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s7" name="LoopStep" location="9:1-9:40" isInitial="false" isActive="false" action="loopExecution"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_Load" location="10:1-10:40" condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Load_Process" location="11:1-11:40" condition="resourcesLoaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_Process_Check" location="12:1-12:40" condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_Check_ToAlt" location="13:1-13:40" condition="needsAlternative"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_Check_ToMerge" location="14:1-14:40" condition="conditionOk"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_Alt_ToMerge" location="15:1-15:40" condition="alternativeDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="T_Merge_Final" location="16:1-16:40" condition="mergedSuccessfully"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t7" name="T_Final_Loop" location="17:1-17:40" condition="repeatRequested"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t8" name="T_Loop_Process" location="18:1-18:40" condition="loopNext"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_To_T_Init_Load" location="20:1-20:60"
                 grafcet="/0"
                 from="/0/@elements.0"
                 to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Load_To_T_Load_Process" location="21:1-21:60"
                 grafcet="/0"
                 from="/0/@elements.1"
                 to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Process_To_T_Process_Check" location="22:1-22:60"
                 grafcet="/0"
                 from="/0/@elements.2"
                 to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_Check_To_T_Check_ToAlt" location="23:1-23:60"
                 grafcet="/0"
                 from="/0/@elements.3"
                 to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_Check_To_T_Check_ToMerge" location="24:1-24:60"
                 grafcet="/0"
                 from="/0/@elements.3"
                 to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_Alt_To_T_Alt_ToMerge" location="25:1-25:60"
                 grafcet="/0"
                 from="/0/@elements.4"
                 to="/0/@elements.13"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_Merge_To_T_Merge_Final" location="26:1-26:60"
                 grafcet="/0"
                 from="/0/@elements.5"
                 to="/0/@elements.14"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_Final_To_T_Final_Loop" location="27:1-27:60"
                 grafcet="/0"
                 from="/0/@elements.6"
                 to="/0/@elements.15"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="C_Loop_To_T_Loop_Process" location="28:1-28:60"
                 grafcet="/0"
                 from="/0/@elements.7"
                 to="/0/@elements.16"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_T_Init_Load_To_Load" location="30:1-30:60"
                 grafcet="/0"
                 from="/0/@elements.8"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_T_Load_Process_To_Process" location="31:1-31:60"
                 grafcet="/0"
                 from="/0/@elements.9"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_T_Process_Check_To_Check" location="32:1-32:60"
                 grafcet="/0"
                 from="/0/@elements.10"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_T_Check_ToAlt_To_Alt" location="33:1-33:60"
                 grafcet="/0"
                 from="/0/@elements.11"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="C_T_Check_ToMerge_To_Merge" location="34:1-34:60"
                 grafcet="/0"
                 from="/0/@elements.12"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c14" name="C_T_Alt_ToMerge_To_Merge" location="35:1-35:60"
                 grafcet="/0"
                 from="/0/@elements.13"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c15" name="C_T_Merge_Final_To_Final" location="36:1-36:60"
                 grafcet="/0"
                 from="/0/@elements.14"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c16" name="C_T_Final_Loop_To_Loop" location="37:1-37:60"
                 grafcet="/0"
                 from="/0/@elements.15"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c17" name="C_T_Loop_Process_To_Process" location="38:1-38:60"
                 grafcet="/0"
                 from="/0/@elements.16"
                 to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>