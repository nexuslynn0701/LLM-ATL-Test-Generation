<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file:/models/grafcet_0093.grafcet">
    <!-- Elements: 4 Steps + 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="file:/models/grafcet_0093.grafcet#InitStep" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ProcessingStepA" location="file:/models/grafcet_0093.grafcet#ProcessingStepA" isInitial="false" isActive="false" action="processA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessingStepB" location="file:/models/grafcet_0093.grafcet#ProcessingStepB" isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="FinalStep" location="file:/models/grafcet_0093.grafcet#FinalStep" isInitial="false" isActive="false" action="shutdownSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToA" location="file:/models/grafcet_0093.grafcet#T_InitToA" condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_AToB" location="file:/models/grafcet_0093.grafcet#T_AToB" condition="aComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_BToFinalOrLoop" location="file:/models/grafcet_0093.grafcet#T_BToFinalOrLoop" condition="bComplete"/>

    <!-- Connections: linear chain + branch and loop -->
    <!-- InitStep -> T_InitToA -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="file:/models/grafcet_0093.grafcet#C_Init_to_T0"
                 from="/0/@elements.0" to="/0/@elements.4"/>

    <!-- T_InitToA -> ProcessingStepA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="C_T0_to_A" location="file:/models/grafcet_0093.grafcet#C_T0_to_A"
                 from="/0/@elements.4" to="/0/@elements.1"/>

    <!-- ProcessingStepA -> T_AToB -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_A_to_T1" location="file:/models/grafcet_0093.grafcet#C_A_to_T1"
                 from="/0/@elements.1" to="/0/@elements.5"/>

    <!-- T_AToB -> ProcessingStepB -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="C_T1_to_B" location="file:/models/grafcet_0093.grafcet#C_T1_to_B"
                 from="/0/@elements.5" to="/0/@elements.2"/>

    <!-- ProcessingStepB -> T_BToFinalOrLoop -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_B_to_T2" location="file:/models/grafcet_0093.grafcet#C_B_to_T2"
                 from="/0/@elements.2" to="/0/@elements.6"/>

    <!-- T_BToFinalOrLoop -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_T2_to_Final" location="file:/models/grafcet_0093.grafcet#C_T2_to_Final"
                 from="/0/@elements.6" to="/0/@elements.3"/>

    <!-- T_BToFinalOrLoop -> ProcessingStepA (loop back) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="C_T2_to_A_Loop" location="file:/models/grafcet_0093.grafcet#C_T2_to_A_Loop"
                 from="/0/@elements.6" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>