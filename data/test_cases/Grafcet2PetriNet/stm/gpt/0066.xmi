<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file://complex_grafcet_0066.grafcet">
    <!-- Steps -->
    <elements xmi:id="_s0" xsi:type="Grafcet:Step" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xmi:id="_s1" xsi:type="Grafcet:Step" name="CheckSensors" location="2:1-2:25" isInitial="false" isActive="false" action="readSensors"/>
    <elements xmi:id="_s2" xsi:type="Grafcet:Step" name="ProcessData" location="3:1-3:24" isInitial="false" isActive="false" action="computeResults"/>
    <elements xmi:id="_s3" xsi:type="Grafcet:Step" name="ErrorHandling" location="4:1-4:24" isInitial="false" isActive="false" action="handleError"/>
    <elements xmi:id="_s4" xsi:type="Grafcet:Step" name="Finalize" location="5:1-5:18" isInitial="false" isActive="false" action="shutdownSystem"/>

    <!-- Transitions -->
    <elements xmi:id="_t0" xsi:type="Grafcet:Transition" name="InitToCheck" location="6:1-6:23" condition="systemReady"/>
    <elements xmi:id="_t1" xsi:type="Grafcet:Transition" name="CheckToProcess" location="7:1-7:25" condition="sensorsOK"/>
    <elements xmi:id="_t2" xsi:type="Grafcet:Transition" name="ProcessToFinalize" location="8:1-8:27" condition="processingDone"/>
    <elements xmi:id="_t3" xsi:type="Grafcet:Transition" name="CheckToError" location="9:1-9:24" condition="sensorFailure"/>
    <elements xmi:id="_t4" xsi:type="Grafcet:Transition" name="ErrorToFinalize" location="10:1-10:26" condition="errorCleared"/>

    <!-- StepToTransition connections (from Step to Transition) -->
    <connections xmi:id="_c0" xsi:type="Grafcet:StepToTransition" name="Init_to_t0" location="11:1-11:30" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xmi:id="_c1" xsi:type="Grafcet:StepToTransition" name="Check_to_t1" location="12:1-12:32" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xmi:id="_c2" xsi:type="Grafcet:StepToTransition" name="Process_to_t2" location="13:1-13:34" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xmi:id="_c3" xsi:type="Grafcet:StepToTransition" name="Check_to_t3" location="14:1-14:32" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xmi:id="_c4" xsi:type="Grafcet:StepToTransition" name="Error_to_t4" location="15:1-15:31" from="/0/@elements.3" to="/0/@elements.9"/>

    <!-- TransitionToStep connections (from Transition to Step) -->
    <connections xmi:id="_c5" xsi:type="Grafcet:TransitionToStep" name="t0_to_Check" location="16:1-16:30" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xmi:id="_c6" xsi:type="Grafcet:TransitionToStep" name="t1_to_Process" location="17:1-17:32" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xmi:id="_c7" xsi:type="Grafcet:TransitionToStep" name="t2_to_Finalize" location="18:1-18:34" from="/0/@elements.7" to="/0/@elements.4"/>
    <connections xmi:id="_c8" xsi:type="Grafcet:TransitionToStep" name="t3_to_Error" location="19:1-19:30" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xmi:id="_c9" xsi:type="Grafcet:TransitionToStep" name="t4_to_Finalize" location="20:1-20:34" from="/0/@elements.9" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>