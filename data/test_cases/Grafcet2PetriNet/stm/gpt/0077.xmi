<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexSequenceWithBranchAndMerge" location="1:1-50:1">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="Start" location="2:3-2:40" isInitial="true" isActive="true" action="initSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="Prepare" location="3:3-3:40" isInitial="false" isActive="false" action="prepareResources"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="BranchA_Step1" location="4:3-4:50" isInitial="false" isActive="false" action="performBranchA1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="BranchA_Step2" location="5:3-5:50" isInitial="false" isActive="false" action="performBranchA2"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="BranchB_Step1" location="6:3-6:50" isInitial="false" isActive="false" action="performBranchB1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="Merge" location="7:3-7:40" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" name="Final" location="8:3-8:40" isInitial="false" isActive="false" action="finalizeSystem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Start_Prepare" location="10:3-10:50" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Prepare_BranchA" location="11:3-11:55" condition="mode = A"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_Prepare_BranchB" location="12:3-12:55" condition="mode = B"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_BranchA1_A2" location="13:3-13:55" condition="A1_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_BranchA2_Merge" location="14:3-14:55" condition="A2_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_BranchB1_Merge" location="15:3-15:55" condition="B1_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="T_Merge_Final" location="16:3-16:55" condition="allBranchesComplete"/>

    <!-- Connections: StepToTransition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Start_to_T0" location="20:3-20:60" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Prepare_to_T1" location="21:3-21:60" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Prepare_to_T2" location="22:3-22:60" from="/0/@elements.1" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_BranchA1_to_T3" location="23:3-23:65" from="/0/@elements.2" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_BranchA2_to_T4" location="24:3-24:65" from="/0/@elements.3" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_BranchB1_to_T5" location="25:3-25:65" from="/0/@elements.4" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_Merge_to_T6" location="26:3-26:60" from="/0/@elements.5" to="/0/@elements.13"/>

    <!-- Connections: TransitionToStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_T0_to_Prepare" location="30:3-30:60" from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_T1_to_BranchA1" location="31:3-31:65" from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_T2_to_BranchB1" location="32:3-32:65" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_T3_to_BranchA2" location="33:3-33:65" from="/0/@elements.10" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_T4_to_Merge_fromA" location="34:3-34:70" from="/0/@elements.11" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_T5_to_Merge_fromB" location="35:3-35:70" from="/0/@elements.12" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="C_T6_to_Final" location="36:3-36:60" from="/0/@elements.13" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>