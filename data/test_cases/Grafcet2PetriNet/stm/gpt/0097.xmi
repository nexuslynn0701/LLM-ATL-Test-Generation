<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet0097" location="file://complex/grafcet0097.gcf">

    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_S0"
              name="InitStep"
              location="file://complex/grafcet0097.gcf#InitStep"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_S1"
              name="CheckSensors"
              location="file://complex/grafcet0097.gcf#CheckSensors"
              isInitial="false"
              isActive="false"
              action="check_sensors"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_S2"
              name="ParallelBranchLeft"
              location="file://complex/grafcet0097.gcf#ParallelBranchLeft"
              isInitial="false"
              isActive="false"
              action="left_branch_action"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_S3"
              name="ParallelBranchRight"
              location="file://complex/grafcet0097.gcf#ParallelBranchRight"
              isInitial="false"
              isActive="false"
              action="right_branch_action"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_S4"
              name="MergeStep"
              location="file://complex/grafcet0097.gcf#MergeStep"
              isInitial="false"
              isActive="false"
              action="merge_and_continue"/>

    <elements xsi:type="Grafcet:Step"
              xmi:id="_S5"
              name="FinalStep"
              location="file://complex/grafcet0097.gcf#FinalStep"
              isInitial="false"
              isActive="false"
              action="finalize_sequence"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T0"
              name="T_Init_To_Check"
              location="file://complex/grafcet0097.gcf#T_Init_To_Check"
              condition="start_command"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T1"
              name="T_Check_To_Parallel"
              location="file://complex/grafcet0097.gcf#T_Check_To_Parallel"
              condition="sensors_ok"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T2"
              name="T_Left_To_Merge"
              location="file://complex/grafcet0097.gcf#T_Left_To_Merge"
              condition="left_done"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T3"
              name="T_Right_To_Merge"
              location="file://complex/grafcet0097.gcf#T_Right_To_Merge"
              condition="right_done"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T4"
              name="T_Merge_To_Final"
              location="file://complex/grafcet0097.gcf#T_Merge_To_Final"
              condition="merge_complete"/>

    <elements xsi:type="Grafcet:Transition"
              xmi:id="_T5"
              name="T_Final_Loop"
              location="file://complex/grafcet0097.gcf#T_Final_Loop"
              condition="repeat_cycle"/>

    <!-- Connections: StepToTransition and TransitionToStep -->

    <!-- InitStep -> T0 -> CheckSensors -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C0"
                 name="C_Init_to_T0"
                 location="file://complex/grafcet0097.gcf#C_Init_to_T0"
                 from="/0/@elements.0"
                 to="/0/@elements.6"/>

    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C1"
                 name="C_T0_to_Check"
                 location="file://complex/grafcet0097.gcf#C_T0_to_Check"
                 from="/0/@elements.6"
                 to="/0/@elements.1"/>

    <!-- CheckSensors -> T1 -> ParallelBranchLeft and ParallelBranchRight (fan-out through multiple transitions) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C2"
                 name="C_Check_to_T1"
                 location="file://complex/grafcet0097.gcf#C_Check_to_T1"
                 from="/0/@elements.1"
                 to="/0/@elements.7"/>

    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C3"
                 name="C_T1_to_Left"
                 location="file://complex/grafcet0097.gcf#C_T1_to_Left"
                 from="/0/@elements.7"
                 to="/0/@elements.2"/>

    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C4"
                 name="C_T1_to_Right"
                 location="file://complex/grafcet0097.gcf#C_T1_to_Right"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>

    <!-- ParallelBranchLeft -> T2 -> MergeStep -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C5"
                 name="C_Left_to_T2"
                 location="file://complex/grafcet0097.gcf#C_Left_to_T2"
                 from="/0/@elements.2"
                 to="/0/@elements.8"/>

    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C6"
                 name="C_T2_to_Merge"
                 location="file://complex/grafcet0097.gcf#C_T2_to_Merge"
                 from="/0/@elements.8"
                 to="/0/@elements.4"/>

    <!-- ParallelBranchRight -> T3 -> MergeStep -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C7"
                 name="C_Right_to_T3"
                 location="file://complex/grafcet0097.gcf#C_Right_to_T3"
                 from="/0/@elements.3"
                 to="/0/@elements.9"/>

    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C8"
                 name="C_T3_to_Merge"
                 location="file://complex/grafcet0097.gcf#C_T3_to_Merge"
                 from="/0/@elements.9"
                 to="/0/@elements.4"/>

    <!-- MergeStep -> T4 -> FinalStep -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C9"
                 name="C_Merge_to_T4"
                 location="file://complex/grafcet0097.gcf#C_Merge_to_T4"
                 from="/0/@elements.4"
                 to="/0/@elements.10"/>

    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C10"
                 name="C_T4_to_Final"
                 location="file://complex/grafcet0097.gcf#C_T4_to_Final"
                 from="/0/@elements.10"
                 to="/0/@elements.5"/>

    <!-- FinalStep -> T5 -> InitStep (loop back to initial) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C11"
                 name="C_Final_to_T5"
                 location="file://complex/grafcet0097.gcf#C_Final_to_T5"
                 from="/0/@elements.5"
                 to="/0/@elements.11"/>

    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C12"
                 name="C_T5_to_Init"
                 location="file://complex/grafcet0097.gcf#C_T5_to_Init"
                 from="/0/@elements.11"
                 to="/0/@elements.0"/>

  </Grafcet:Grafcet>
</xmi:XMI>