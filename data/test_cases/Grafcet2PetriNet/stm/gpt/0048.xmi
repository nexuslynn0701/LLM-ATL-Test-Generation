<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="1:1-50:1">

    <!-- Elements: mix of steps and transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="2:1-2:80"
              isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckSensors" location="3:1-3:80"
              isInitial="false" isActive="false" action="read_sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessData" location="4:1-4:80"
              isInitial="false" isActive="false" action="compute_values"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ErrorHandler" location="5:1-5:80"
              isInitial="false" isActive="false" action="handle_error"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="Shutdown" location="6:1-6:80"
              isInitial="false" isActive="false" action="shutdown_sequence"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToCheck" location="7:1-7:80"
              condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_CheckToProcess" location="8:1-8:80"
              condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_CheckToError" location="9:1-9:80"
              condition="sensors_fail"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_ProcessToShutdown" location="10:1-10:80"
              condition="processing_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_ErrorToShutdown" location="11:1-11:80"
              condition="error_resolved"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_ShutdownToInit" location="12:1-12:80"
              condition="reset_command"/>

    <!-- Connections: form branching, merging, and a loop -->

    <!-- InitStep -> T_InitToCheck -> CheckSensors -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="20:1-20:80"
                 from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="C_T0_to_Check" location="21:1-21:80"
                 from="/0/@elements.5" to="/0/@elements.1"/>

    <!-- CheckSensors -> T_CheckToProcess -> ProcessData -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Check_to_T1" location="22:1-22:80"
                 from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="C_T1_to_Process" location="23:1-23:80"
                 from="/0/@elements.6" to="/0/@elements.2"/>

    <!-- CheckSensors -> T_CheckToError -> ErrorHandler -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_Check_to_T2" location="24:1-24:80"
                 from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_T2_to_Error" location="25:1-25:80"
                 from="/0/@elements.7" to="/0/@elements.3"/>

    <!-- ProcessData -> T_ProcessToShutdown -> Shutdown -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_Process_to_T3" location="26:1-26:80"
                 from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_T3_to_Shutdown" location="27:1-27:80"
                 from="/0/@elements.8" to="/0/@elements.4"/>

    <!-- ErrorHandler -> T_ErrorToShutdown -> Shutdown -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="C_Error_to_T4" location="28:1-28:80"
                 from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_T4_to_Shutdown" location="29:1-29:80"
                 from="/0/@elements.9" to="/0/@elements.4"/>

    <!-- Shutdown -> T_ShutdownToInit -> InitStep (loop back) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c10" name="C_Shutdown_to_T5" location="30:1-30:80"
                 from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_T5_to_Init" location="31:1-31:80"
                 from="/0/@elements.10" to="/0/@elements.0"/>

  </Grafcet:Grafcet>
</xmi:XMI>