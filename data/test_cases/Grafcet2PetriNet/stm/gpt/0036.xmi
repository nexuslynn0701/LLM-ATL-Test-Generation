<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="loc_g0">

    <!-- Elements: 4 Steps + 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="loc_s0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ParallelStepA" location="loc_s1" isInitial="false" isActive="false" action="doTaskA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ParallelStepB" location="loc_s2" isInitial="false" isActive="false" action="doTaskB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="FinalStep" location="loc_s3" isInitial="false" isActive="false" action="finalize"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="SplitTrans" location="loc_t0" condition="cond_split"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="JoinTrans" location="loc_t1" condition="cond_join"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="LoopBackTrans" location="loc_t2" condition="cond_loop"/>

    <!-- Connections -->
    <!-- Initial step to split transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="ST_Init_Split" location="loc_c0"
                 from="/0/@elements.0" to="/0/@elements.4"/>
    <!-- Split transition to parallel steps -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="TS_Split_A" location="loc_c1"
                 from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="TS_Split_B" location="loc_c2"
                 from="/0/@elements.4" to="/0/@elements.2"/>

    <!-- Parallel steps to join transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="ST_A_Join" location="loc_c3"
                 from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="ST_B_Join" location="loc_c4"
                 from="/0/@elements.2" to="/0/@elements.5"/>

    <!-- Join transition to final step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="TS_Join_Final" location="loc_c5"
                 from="/0/@elements.5" to="/0/@elements.3"/>

    <!-- Loop back from final step to split transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="ST_Final_LoopBack" location="loc_c6"
                 from="/0/@elements.3" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="TS_LoopBack_Init" location="loc_c7"
                 from="/0/@elements.6" to="/0/@elements.0"/>

  </Grafcet:Grafcet>
</xmi:XMI>