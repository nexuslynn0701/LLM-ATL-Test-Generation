<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="loc_g0">

    <!-- Elements: 5 Steps (2 initial) + 4 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStepA" location="loc_s0" isInitial="true" isActive="true" action="initA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="InitStepB" location="loc_s1" isInitial="true" isActive="false" action="initB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="MiddleStep1" location="loc_s2" isInitial="false" isActive="false" action="middle1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="MiddleStep2" location="loc_s3" isInitial="false" isActive="true" action="middle2"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="FinalStep" location="loc_s4" isInitial="false" isActive="false" action="final"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToM1" location="loc_t0" condition="cond_init_to_m1"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_InitToM2" location="loc_t1" condition="cond_init_to_m2"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_M1M2ToFinal" location="loc_t2" condition="cond_m1m2_to_final"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_LoopOnM2" location="loc_t3" condition="cond_loop_m2"/>

    <!-- Connections: fork, join, and loop patterns -->
    <!-- From initial steps to T_InitToM1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_s0_t0" location="loc_c0"
      from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_s1_t0" location="loc_c1"
      from="/0/@elements.1" to="/0/@elements.5"/>

    <!-- T_InitToM1 to MiddleStep1 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="C_t0_s2" location="loc_c2"
      from="/0/@elements.5" to="/0/@elements.2"/>

    <!-- From initial steps to T_InitToM2 (parallel branch) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_s0_t1" location="loc_c3"
      from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_s1_t1" location="loc_c4"
      from="/0/@elements.1" to="/0/@elements.6"/>

    <!-- T_InitToM2 to MiddleStep2 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_t1_s3" location="loc_c5"
      from="/0/@elements.6" to="/0/@elements.3"/>

    <!-- From MiddleStep1 and MiddleStep2 to join transition T_M1M2ToFinal -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_s2_t2" location="loc_c6"
      from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_s3_t2" location="loc_c7"
      from="/0/@elements.3" to="/0/@elements.7"/>

    <!-- T_M1M2ToFinal to FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_t2_s4" location="loc_c8"
      from="/0/@elements.7" to="/0/@elements.4"/>

    <!-- Loop on MiddleStep2 via T_LoopOnM2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c9" name="C_s3_t3" location="loc_c9"
      from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_t3_s3" location="loc_c10"
      from="/0/@elements.8" to="/0/@elements.3"/>

  </Grafcet:Grafcet>
</xmi:XMI>