<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="loc:/grafcet/complex">
    <!-- Elements: 5 Steps + 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="loc:/grafcet/complex/s0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ProcessingStepA" location="loc:/grafcet/complex/s1" isInitial="false" isActive="false" action="processA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessingStepB" location="loc:/grafcet/complex/s2" isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="MergeStep" location="loc:/grafcet/complex/s3" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="FinalStep" location="loc:/grafcet/complex/s4" isInitial="false" isActive="false" action="shutdownSystem"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="TransInitToA" location="loc:/grafcet/complex/t0" condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="TransAToBranch" location="loc:/grafcet/complex/t1" condition="aCompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="TransToFinal" location="loc:/grafcet/complex/t2" condition="allDone"/>

    <!-- Connections: StepToTransition and TransitionToStep -->

    <!-- From InitStep to TransInitToA -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="Arc_s0_t0" location="loc:/grafcet/complex/c0" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- From TransInitToA to ProcessingStepA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="Arc_t0_s1" location="loc:/grafcet/complex/c1" from="/0/@elements.5" to="/0/@elements.1"/>

    <!-- From ProcessingStepA to TransAToBranch -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="Arc_s1_t1" location="loc:/grafcet/complex/c2" from="/0/@elements.1" to="/0/@elements.6"/>
    <!-- From TransAToBranch to ProcessingStepB (branch 1) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="Arc_t1_s2" location="loc:/grafcet/complex/c3" from="/0/@elements.6" to="/0/@elements.2"/>
    <!-- From TransAToBranch to MergeStep (branch 2 direct) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="Arc_t1_s3_direct" location="loc:/grafcet/complex/c4" from="/0/@elements.6" to="/0/@elements.3"/>

    <!-- From ProcessingStepB to TransToFinal -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="Arc_s2_t2" location="loc:/grafcet/complex/c5" from="/0/@elements.2" to="/0/@elements.7"/>
    <!-- From MergeStep to TransToFinal (second incoming to same transition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="Arc_s3_t2" location="loc:/grafcet/complex/c6" from="/0/@elements.3" to="/0/@elements.7"/>

    <!-- From TransToFinal to FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="Arc_t2_s4" location="loc:/grafcet/complex/c7" from="/0/@elements.7" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>