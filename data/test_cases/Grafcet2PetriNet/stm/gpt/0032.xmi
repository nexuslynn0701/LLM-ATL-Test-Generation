<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcetExample" location="file:/models/grafcet_0032.grafcet">

    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="1:1-1:40"
              isInitial="true" isActive="true" action="initializeSystem()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="CheckSensors" location="2:1-2:60"
              isInitial="false" isActive="false" action="readSensors()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ComputeControl" location="3:1-3:60"
              isInitial="false" isActive="false" action="computeControlLaw()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="Actuate" location="4:1-4:55"
              isInitial="false" isActive="false" action="applyActuators()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="ErrorHandler" location="5:1-5:65"
              isInitial="false" isActive="false" action="enterErrorMode()"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="t_Init_to_Check" location="10:1-10:55"
              condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="t_Check_to_Compute" location="11:1-11:60"
              condition="sensorsOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="t_Compute_to_Actuate" location="12:1-12:60"
              condition="controlComputed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="t_Actuate_to_Check" location="13:1-13:60"
              condition="cycleComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" name="t_Check_to_Error" location="14:1-14:65"
              condition="sensorsFailed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T5" name="t_Error_to_Init" location="15:1-15:60"
              condition="resetRequested"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="c_S0_T0" location="20:1-20:40"
                 from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C1" name="c_S1_T1" location="21:1-21:40"
                 from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="c_S2_T2" location="22:1-22:40"
                 from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="c_S3_T3" location="23:1-23:40"
                 from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="c_S1_T4" location="24:1-24:40"
                 from="/0/@elements.1" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C5" name="c_S4_T5" location="25:1-25:40"
                 from="/0/@elements.4" to="/0/@elements.10"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C6" name="c_T0_S1" location="30:1-30:40"
                 from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="c_T1_S2" location="31:1-31:40"
                 from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C8" name="c_T2_S3" location="32:1-32:40"
                 from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C9" name="c_T3_S1" location="33:1-33:40"
                 from="/0/@elements.8" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C10" name="c_T4_S4" location="34:1-34:40"
                 from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C11" name="c_T5_S0" location="35:1-35:40"
                 from="/0/@elements.10" to="/0/@elements.0"/>

  </Grafcet:Grafcet>
</xmi:XMI>