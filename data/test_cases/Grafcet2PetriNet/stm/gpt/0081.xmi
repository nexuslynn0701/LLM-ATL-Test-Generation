<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g1" name="ComplexGrafcetExample" location="file://complex_grafcet_0081.gcf">

    <!-- Elements: 5 Steps and 3 Transitions -->

    <!-- Step S1: initial and active -->
    <elements xsi:type="Grafcet:Step"
      xmi:id="_s1"
      name="Step_S1"
      location="(10,10)"
      isInitial="true"
      isActive="true"
      action="initializeSystem"/>

    <!-- Step S2: non-initial, active -->
    <elements xsi:type="Grafcet:Step"
      xmi:id="_s2"
      name="Step_S2"
      location="(40,10)"
      isInitial="false"
      isActive="true"
      action="monitorInputs"/>

    <!-- Step S3: non-initial, inactive -->
    <elements xsi:type="Grafcet:Step"
      xmi:id="_s3"
      name="Step_S3"
      location="(70,10)"
      isInitial="false"
      isActive="false"
      action="processData"/>

    <!-- Step S4: non-initial, inactive -->
    <elements xsi:type="Grafcet:Step"
      xmi:id="_s4"
      name="Step_S4"
      location="(100,10)"
      isInitial="false"
      isActive="false"
      action="finalizeCycle"/>

    <!-- Step S5: non-initial, inactive (used in branch) -->
    <elements xsi:type="Grafcet:Step"
      xmi:id="_s5"
      name="Step_S5"
      location="(40,40)"
      isInitial="false"
      isActive="false"
      action="alternatePath"/>

    <!-- Transition T1: S1 -> S2 and S5 (branch fan-out) -->
    <elements xsi:type="Grafcet:Transition"
      xmi:id="_t1"
      name="Transition_T1"
      location="(25,10)"
      condition="startPressed"/>

    <!-- Transition T2: S2 and S5 -> S3 (merge fan-in) -->
    <elements xsi:type="Grafcet:Transition"
      xmi:id="_t2"
      name="Transition_T2"
      location="(55,15)"
      condition="dataReady"/>

    <!-- Transition T3: S3 -> S4, and S4 feeds back to S1 (cycle) -->
    <elements xsi:type="Grafcet:Transition"
      xmi:id="_t3"
      name="Transition_T3"
      location="(85,10)"
      condition="cycleComplete"/>

    <!-- Connections -->

    <!-- From S1 to T1 -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c_s1_t1"
      name="C_S1_T1"
      location="(18,10)"
      from="/0/@elements.0"
      to="/0/@elements.5"/>

    <!-- From T1 to S2 -->
    <connections xsi:type="Grafcet:TransitionToStep"
      xmi:id="_c_t1_s2"
      name="C_T1_S2"
      location="(32,10)"
      from="/0/@elements.5"
      to="/0/@elements.1"/>

    <!-- From T1 to S5 (branch) -->
    <connections xsi:type="Grafcet:TransitionToStep"
      xmi:id="_c_t1_s5"
      name="C_T1_S5"
      location="(30,25)"
      from="/0/@elements.5"
      to="/0/@elements.4"/>

    <!-- From S2 to T2 -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c_s2_t2"
      name="C_S2_T2"
      location="(48,10)"
      from="/0/@elements.1"
      to="/0/@elements.6"/>

    <!-- From S5 to T2 (merge) -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c_s5_t2"
      name="C_S5_T2"
      location="(45,25)"
      from="/0/@elements.4"
      to="/0/@elements.6"/>

    <!-- From T2 to S3 -->
    <connections xsi:type="Grafcet:TransitionToStep"
      xmi:id="_c_t2_s3"
      name="C_T2_S3"
      location="(62,10)"
      from="/0/@elements.6"
      to="/0/@elements.2"/>

    <!-- From S3 to T3 -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c_s3_t3"
      name="C_S3_T3"
      location="(78,10)"
      from="/0/@elements.2"
      to="/0/@elements.7"/>

    <!-- From T3 to S4 -->
    <connections xsi:type="Grafcet:TransitionToStep"
      xmi:id="_c_t3_s4"
      name="C_T3_S4"
      location="(92,10)"
      from="/0/@elements.7"
      to="/0/@elements.3"/>

    <!-- From S4 back to T1 (cycle creating a loop) -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c_s4_t1"
      name="C_S4_T1"
      location="(60,5)"
      from="/0/@elements.3"
      to="/0/@elements.5"/>

  </Grafcet:Grafcet>
</xmi:XMI>