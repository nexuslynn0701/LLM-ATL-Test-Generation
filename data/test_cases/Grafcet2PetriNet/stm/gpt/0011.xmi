<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_grafcet1" name="ComplexGrafcetExample" location="file://complexGrafcet.gra">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_step0" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step1" name="LoadConfig" location="2:1-2:20" isInitial="false" isActive="false" action="load_configuration"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step2" name="CheckSensors" location="3:1-3:20" isInitial="false" isActive="false" action="check_sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step3" name="RunProcessA" location="4:1-4:20" isInitial="false" isActive="false" action="execute_process_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step4" name="RunProcessB" location="5:1-5:20" isInitial="false" isActive="false" action="execute_process_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step5" name="MergeResults" location="6:1-6:20" isInitial="false" isActive="false" action="merge_results"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_step6" name="Finalize" location="7:1-7:20" isInitial="false" isActive="false" action="finalize_and_log"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans0" name="t_init_to_load" location="8:1-8:20" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans1" name="t_load_to_check" location="9:1-9:20" condition="config_loaded"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans2" name="t_check_to_parallel" location="10:1-10:20" condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans3" name="t_procA_to_merge" location="11:1-11:20" condition="procA_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans4" name="t_procB_to_merge" location="12:1-12:20" condition="procB_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_trans5" name="t_merge_to_finalize" location="13:1-13:20" condition="results_consistent"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_s0_t0" name="c_init_to_t0" location="20:1-20:30" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_s1_t1" name="c_load_to_t1" location="21:1-21:30" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_s2_t2" name="c_check_to_t2" location="22:1-22:30" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_s3_t3" name="c_procA_to_t3" location="23:1-23:30" from="/0/@elements.3" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_s4_t4" name="c_procB_to_t4" location="24:1-24:30" from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c_s5_t5" name="c_merge_to_t5" location="25:1-25:30" from="/0/@elements.5" to="/0/@elements.12"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t0_s1" name="c_t0_to_load" location="30:1-30:30" from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t1_s2" name="c_t1_to_check" location="31:1-31:30" from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t2_s3" name="c_t2_to_procA" location="32:1-32:30" from="/0/@elements.9" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t2_s4" name="c_t2_to_procB" location="33:1-33:30" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t3_s5" name="c_t3_to_merge" location="34:1-34:30" from="/0/@elements.10" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t4_s5" name="c_t4_to_merge" location="35:1-35:30" from="/0/@elements.11" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c_t5_s6" name="c_t5_to_finalize" location="36:1-36:30" from="/0/@elements.12" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>