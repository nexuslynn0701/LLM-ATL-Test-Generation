<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:version="2.0" name="ComplexGrafcetExample" location="1:1-100:1">
    <!-- Elements: 6 Steps and 4 Transitions -->
    <elements xsi:type="Grafcet:Step" name="InitStep" location="2:1-2:40" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" name="PrepareStep" location="3:1-3:50" isInitial="false" isActive="false" action="prepareResources"/>
    <elements xsi:type="Grafcet:Step" name="BranchStep1" location="4:1-4:50" isInitial="false" isActive="false" action="branchPath1"/>
    <elements xsi:type="Grafcet:Step" name="BranchStep2" location="5:1-5:50" isInitial="false" isActive="false" action="branchPath2"/>
    <elements xsi:type="Grafcet:Step" name="MergeStep" location="6:1-6:50" isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="7:1-7:40" isInitial="false" isActive="false" action="finalizeSystem"/>

    <elements xsi:type="Grafcet:Transition" name="T_InitToPrepare" location="8:1-8:60" condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" name="T_PrepareToBranch" location="9:1-9:60" condition="resourcesReady"/>
    <elements xsi:type="Grafcet:Transition" name="T_BranchesToMerge" location="10:1-10:70" condition="branchCompleted"/>
    <elements xsi:type="Grafcet:Transition" name="T_MergeToFinal" location="11:1-11:60" condition="mergeOk"/>

    <!-- Connections: StepToTransition -->
    <!-- InitStep -> T_InitToPrepare -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Init_to_InitPrepare" location="12:1-12:80" from="/0/@elements.0" to="/0/@elements.6"/>
    <!-- PrepareStep -> T_PrepareToBranch -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Prepare_to_PrepareBranch" location="13:1-13:80" from="/0/@elements.1" to="/0/@elements.7"/>
    <!-- BranchStep1 -> T_BranchesToMerge -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Branch1_to_BranchesMerge" location="14:1-14:80" from="/0/@elements.2" to="/0/@elements.8"/>
    <!-- BranchStep2 -> T_BranchesToMerge -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Branch2_to_BranchesMerge" location="15:1-15:80" from="/0/@elements.3" to="/0/@elements.8"/>

    <!-- Connections: TransitionToStep -->
    <!-- T_InitToPrepare -> PrepareStep -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_InitPrepare_to_Prepare" location="16:1-16:80" from="/0/@elements.6" to="/0/@elements.1"/>
    <!-- T_PrepareToBranch -> BranchStep1 -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_PrepareBranch_to_Branch1" location="17:1-17:80" from="/0/@elements.7" to="/0/@elements.2"/>
    <!-- T_PrepareToBranch -> BranchStep2 -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_PrepareBranch_to_Branch2" location="18:1-18:80" from="/0/@elements.7" to="/0/@elements.3"/>
    <!-- T_BranchesToMerge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" name="C_BranchesMerge_to_Merge" location="19:1-19:80" from="/0/@elements.8" to="/0/@elements.4"/>
    <!-- T_MergeToFinal: MergeStep -> T_MergeToFinal and T_MergeToFinal -> FinalStep -->
    <connections xsi:type="Grafcet:StepToTransition" name="C_Merge_to_MergeFinal" location="20:1-20:80" from="/0/@elements.4" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C_MergeFinal_to_Final" location="21:1-21:80" from="/0/@elements.9" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>