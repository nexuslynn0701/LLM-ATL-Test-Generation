<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcetExample" location="loc_grafcet_0063">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="loc_s0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="CheckSensors" location="loc_s1" isInitial="false" isActive="false" action="readSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ProcessData" location="loc_s2" isInitial="false" isActive="false" action="computeValues"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="ErrorHandler" location="loc_s3" isInitial="false" isActive="false" action="handleError"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="LogStatus" location="loc_s4" isInitial="false" isActive="false" action="logStatus"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S5" name="Shutdown" location="loc_s5" isInitial="false" isActive="false" action="shutdownSystem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="t_InitToCheck" location="loc_t0" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="t_CheckToProcess" location="loc_t1" condition="sensorsOk"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="t_CheckToError" location="loc_t2" condition="sensorsFail"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="t_ProcessToLog" location="loc_t3" condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" name="t_LogToShutdown" location="loc_t4" condition="logComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T5" name="t_ErrorToShutdown" location="loc_t5" condition="criticalError"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T6" name="t_LoopCheck" location="loc_t6" condition="continueMonitoring"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="c_Init_to_T0" location="loc_c0" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C1" name="c_S1_to_T1" location="loc_c1" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="c_S1_to_T2" location="loc_c2" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="c_S2_to_T3" location="loc_c3" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="c_S4_to_T4" location="loc_c4" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C5" name="c_S3_to_T5" location="loc_c5" from="/0/@elements.3" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" name="c_S4_to_T6" location="loc_c6" from="/0/@elements.4" to="/0/@elements.12"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="c_T0_to_S1" location="loc_c7" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C8" name="c_T1_to_S2" location="loc_c8" from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C9" name="c_T2_to_S3" location="loc_c9" from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C10" name="c_T3_to_S4" location="loc_c10" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C11" name="c_T4_to_S5" location="loc_c11" from="/0/@elements.10" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C12" name="c_T5_to_S5" location="loc_c12" from="/0/@elements.11" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C13" name="c_T6_to_S1" location="loc_c13" from="/0/@elements.12" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>