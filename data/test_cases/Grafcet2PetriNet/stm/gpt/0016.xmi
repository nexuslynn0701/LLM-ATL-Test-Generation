<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcetExample16" location="0:0-0:0">
    <!-- Elements: 5 Steps + 3 Transitions = 8 elements -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitialMainStep" location="1:1-1:50" isInitial="true" isActive="true" action="start_main_sequence"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="ParallelStepA" location="2:1-2:50" isInitial="false" isActive="false" action="do_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ParallelStepB" location="3:1-3:50" isInitial="false" isActive="false" action="do_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="MergeStep" location="4:1-4:50" isInitial="false" isActive="false" action="merge_actions"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="FinalStep" location="5:1-5:50" isInitial="false" isActive="false" action="shutdown"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="SplitTransition" location="6:1-6:50" condition="cond_split"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="JoinTransition" location="7:1-7:50" condition="cond_join"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="ToFinalTransition" location="8:1-8:50" condition="always_true"/>

    <!-- Connections: 3 StepToTransition + 4 TransitionToStep = 7 connections -->

    <!-- From initial step to split transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_Initial_to_Split" location="9:1-9:50" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- From split transition to parallel step A -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="C_Split_to_A" location="10:1-10:50" from="/0/@elements.5" to="/0/@elements.1"/>
    <!-- From split transition to parallel step B -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C2" name="C_Split_to_B" location="11:1-11:50" from="/0/@elements.5" to="/0/@elements.2"/>

    <!-- From parallel step A to join transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="C_A_to_Join" location="12:1-12:50" from="/0/@elements.1" to="/0/@elements.6"/>
    <!-- From parallel step B to join transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_B_to_Join" location="13:1-13:50" from="/0/@elements.2" to="/0/@elements.6"/>
    <!-- From join transition to merge step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="C_Join_to_Merge" location="14:1-14:50" from="/0/@elements.6" to="/0/@elements.3"/>

    <!-- From merge step to final transition, then to final step -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" name="C_Merge_to_FinalTransition" location="15:1-15:50" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="C_FinalTransition_to_FinalStep" location="16:1-16:50" from="/0/@elements.7" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>