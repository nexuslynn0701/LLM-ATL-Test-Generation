<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="model/TestGrafcet.ecore">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="model/TestGrafcet.ecore#InitStep"
              isInitial="true" isActive="true" action="initializeSystem()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckSensors" location="model/TestGrafcet.ecore#CheckSensors"
              isInitial="false" isActive="false" action="checkAllSensors()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessData" location="model/TestGrafcet.ecore#ProcessData"
              isInitial="false" isActive="false" action="processIncomingData()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ErrorHandler" location="model/TestGrafcet.ecore#ErrorHandler"
              isInitial="false" isActive="false" action="handleErrorState()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="ShutdownStep" location="model/TestGrafcet.ecore#ShutdownStep"
              isInitial="false" isActive="false" action="shutdownSystem()"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToCheck" location="model/TestGrafcet.ecore#T_InitToCheck"
              condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_CheckToProcess" location="model/TestGrafcet.ecore#T_CheckToProcess"
              condition="sensorsOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_ProcessLoop" location="model/TestGrafcet.ecore#T_ProcessLoop"
              condition="moreData"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_ErrorDetected" location="model/TestGrafcet.ecore#T_ErrorDetected"
              condition="errorDetected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_ErrorResolved" location="model/TestGrafcet.ecore#T_ErrorResolved"
              condition="errorCleared"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_AnyToShutdown" location="model/TestGrafcet.ecore#T_AnyToShutdown"
              condition="shutdownRequested"/>

    <!-- StepToTransition connections -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0"
                 name="C_Init_to_T0" location="model/TestGrafcet.ecore#C_Init_to_T0"
                 from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1"
                 name="C_Check_to_T1" location="model/TestGrafcet.ecore#C_Check_to_T1"
                 from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2"
                 name="C_Process_to_T2" location="model/TestGrafcet.ecore#C_Process_to_T2"
                 from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3"
                 name="C_Check_to_T3" location="model/TestGrafcet.ecore#C_Check_to_T3"
                 from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4"
                 name="C_Error_to_T4" location="model/TestGrafcet.ecore#C_Error_to_T4"
                 from="/0/@elements.3" to="/0/@elements.9"/>
    <!-- global shutdown from multiple steps -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5"
                 name="C_Init_to_T5" location="model/TestGrafcet.ecore#C_Init_to_T5"
                 from="/0/@elements.0" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6"
                 name="C_Process_to_T5" location="model/TestGrafcet.ecore#C_Process_to_T5"
                 from="/0/@elements.2" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7"
                 name="C_Error_to_T5" location="model/TestGrafcet.ecore#C_Error_to_T5"
                 from="/0/@elements.3" to="/0/@elements.10"/>

    <!-- TransitionToStep connections -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8"
                 name="C_T0_to_Check" location="model/TestGrafcet.ecore#C_T0_to_Check"
                 from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9"
                 name="C_T1_to_Process" location="model/TestGrafcet.ecore#C_T1_to_Process"
                 from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10"
                 name="C_T2_to_Process" location="model/TestGrafcet.ecore#C_T2_to_Process"
                 from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11"
                 name="C_T3_to_Error" location="model/TestGrafcet.ecore#C_T3_to_Error"
                 from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12"
                 name="C_T4_to_Process" location="model/TestGrafcet.ecore#C_T4_to_Process"
                 from="/0/@elements.9" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13"
                 name="C_T5_to_Shutdown" location="model/TestGrafcet.ecore#C_T5_to_Shutdown"
                 from="/0/@elements.10" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>