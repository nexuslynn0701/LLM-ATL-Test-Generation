<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0021_root" name="ComplexGrafcet0021" location="model/location/0021">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_g0021_step0" name="InitStep" location="loc_step0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_g0021_step1" name="ParallelStepA" location="loc_step1" isInitial="false" isActive="false" action="performTaskA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_g0021_step2" name="ParallelStepB" location="loc_step2" isInitial="false" isActive="false" action="performTaskB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_g0021_step3" name="MergeStep" location="loc_step3" isInitial="false" isActive="false" action="mergeResults"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_g0021_step4" name="LoopStep" location="loc_step4" isInitial="false" isActive="true" action="loopAction"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_g0021_step5" name="FinalStep" location="loc_step5" isInitial="false" isActive="false" action="finalizeSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_g0021_trans0" name="T_InitToFork" location="loc_trans0" condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_g0021_trans1" name="T_ForkToA" location="loc_trans1" condition="branchToA"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_g0021_trans2" name="T_ForkToB" location="loc_trans2" condition="branchToB"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_g0021_trans3" name="T_AtoMerge" location="loc_trans3" condition="taskAComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_g0021_trans4" name="T_BtoMerge" location="loc_trans4" condition="taskBComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_g0021_trans5" name="T_MergeToLoop" location="loc_trans5" condition="allTasksDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_g0021_trans6" name="T_LoopBack" location="loc_trans6" condition="repeatRequired"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_g0021_trans7" name="T_LoopToFinal" location="loc_trans7" condition="noMoreRepeats"/>

    <!-- Connections: StepToTransition -->
    <!-- InitStep -> T_InitToFork -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_g0021_c_st0"
                 name="C_Init_to_T_InitToFork"
                 location="loc_c_st0"
                 from="/0/@elements.0"
                 to="/0/@elements.6"/>
    <!-- ParallelStepA -> T_AtoMerge -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_g0021_c_st1"
                 name="C_A_to_T_AtoMerge"
                 location="loc_c_st1"
                 from="/0/@elements.1"
                 to="/0/@elements.9"/>
    <!-- ParallelStepB -> T_BtoMerge -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_g0021_c_st2"
                 name="C_B_to_T_BtoMerge"
                 location="loc_c_st2"
                 from="/0/@elements.2"
                 to="/0/@elements.10"/>
    <!-- MergeStep -> T_MergeToLoop -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_g0021_c_st3"
                 name="C_Merge_to_T_MergeToLoop"
                 location="loc_c_st3"
                 from="/0/@elements.3"
                 to="/0/@elements.11"/>
    <!-- LoopStep -> T_LoopBack -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_g0021_c_st4"
                 name="C_Loop_to_T_LoopBack"
                 location="loc_c_st4"
                 from="/0/@elements.4"
                 to="/0/@elements.12"/>
    <!-- LoopStep -> T_LoopToFinal -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_g0021_c_st5"
                 name="C_Loop_to_T_LoopToFinal"
                 location="loc_c_st5"
                 from="/0/@elements.4"
                 to="/0/@elements.13"/>

    <!-- Connections: TransitionToStep -->
    <!-- T_InitToFork -> ParallelStepA -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_g0021_c_ts0"
                 name="C_T_InitToFork_to_A"
                 location="loc_c_ts0"
                 from="/0/@elements.6"
                 to="/0/@elements.1"/>
    <!-- T_InitToFork -> ParallelStepB -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_g0021_c_ts1"
                 name="C_T_InitToFork_to_B"
                 location="loc_c_ts1"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>
    <!-- T_AtoMerge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_g0021_c_ts2"
                 name="C_T_AtoMerge_to_Merge"
                 location="loc_c_ts2"
                 from="/0/@elements.9"
                 to="/0/@elements.3"/>
    <!-- T_BtoMerge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_g0021_c_ts3"
                 name="C_T_BtoMerge_to_Merge"
                 location="loc_c_ts3"
                 from="/0/@elements.10"
                 to="/0/@elements.3"/>
    <!-- T_MergeToLoop -> LoopStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_g0021_c_ts4"
                 name="C_T_MergeToLoop_to_Loop"
                 location="loc_c_ts4"
                 from="/0/@elements.11"
                 to="/0/@elements.4"/>
    <!-- T_LoopBack -> LoopStep (self-loop through transition) -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_g0021_c_ts5"
                 name="C_T_LoopBack_to_Loop"
                 location="loc_c_ts5"
                 from="/0/@elements.12"
                 to="/0/@elements.4"/>
    <!-- T_LoopToFinal -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_g0021_c_ts6"
                 name="C_T_LoopToFinal_to_Final"
                 location="loc_c_ts6"
                 from="/0/@elements.13"
                 to="/0/@elements.5"/>

  </Grafcet:Grafcet>
</xmi:XMI>