<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcetExample" location="test/location/0071">

    <!-- Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="loc_S0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="CheckStep" location="loc_S1" isInitial="false" isActive="false" action="checkInputs"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ProcessStep" location="loc_S2" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="FinalStep" location="loc_S3" isInitial="false" isActive="false" action="finalize"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="InitToCheck" location="loc_T0" condition="inputsReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="CheckToProcess" location="loc_T1" condition="checkOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="ProcessToFinal" location="loc_T2" condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="LoopBack" location="loc_T3" condition="retryRequired"/>

    <!-- Connections: linear path S0 -> T0 -> S1 -> T1 -> S2 -> T2 -> S3 -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C0"
                 name="C_S0_T0"
                 location="loc_C0"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C1"
                 name="C_T0_S1"
                 location="loc_C1"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C2"
                 name="C_S1_T1"
                 location="loc_C2"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C3"
                 name="C_T1_S2"
                 location="loc_C3"
                 from="/0/@elements.5"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C4"
                 name="C_S2_T2"
                 location="loc_C4"
                 from="/0/@elements.2"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C5"
                 name="C_T2_S3"
                 location="loc_C5"
                 from="/0/@elements.6"
                 to="/0/@elements.3"/>

    <!-- Branching / merging via T3: S1 -> T3 -> S0 (loop back to initial), S2 -> T3 -> S1 (alternative path) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C6"
                 name="C_S1_T3"
                 location="loc_C6"
                 from="/0/@elements.1"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C7"
                 name="C_T3_S0"
                 location="loc_C7"
                 from="/0/@elements.7"
                 to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_C8"
                 name="C_S2_T3"
                 location="loc_C8"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_C9"
                 name="C_T3_S1"
                 location="loc_C9"
                 from="/0/@elements.7"
                 to="/0/@elements.1"/>

  </Grafcet:Grafcet>
</xmi:XMI>