<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g001" name="ComplexGrafcetExample" location="1:1-200:1">
    <!-- Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="InitStep" location="2:1-2:50" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ParallelBranchA1" location="3:1-3:60" isInitial="false" isActive="false" action="prepareBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ParallelBranchA2" location="4:1-4:60" isInitial="false" isActive="false" action="executeBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="ParallelBranchB1" location="5:1-5:60" isInitial="false" isActive="false" action="prepareBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="ParallelBranchB2" location="6:1-6:60" isInitial="false" isActive="false" action="executeBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" name="MergeStep" location="7:1-7:60" isInitial="false" isActive="false" action="mergeParallelBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s7" name="LoopBody" location="8:1-8:60" isInitial="false" isActive="false" action="performLoopIteration"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s8" name="FinalStep" location="9:1-9:60" isInitial="false" isActive="false" action="shutdownSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="InitToParallel" location="10:1-10:60" condition="startCommand"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="InitToBranchB" location="11:1-11:60" condition="branchBEnabled"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="A1ToA2" location="12:1-12:60" condition="A1Done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="B1ToB2" location="13:1-13:60" condition="B1Done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="A2ToMerge" location="14:1-14:60" condition="A2Done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="B2ToMerge" location="15:1-15:60" condition="B2Done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t7" name="MergeToLoop" location="16:1-16:60" condition="mergeCompleted"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t8" name="LoopBack" location="17:1-17:60" condition="loopAgain"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t9" name="LoopToFinal" location="18:1-18:60" condition="stopCommand"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="c_Init_to_t1" location="20:1-20:60"
                 from="/0/@elements.0" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="c_Init_to_t2" location="21:1-21:60"
                 from="/0/@elements.0" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="c_s2_to_t3" location="22:1-22:60"
                 from="/0/@elements.1" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="c_s4_to_t4" location="23:1-23:60"
                 from="/0/@elements.3" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="c_s3_to_t5" location="24:1-24:60"
                 from="/0/@elements.2" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="c_s5_to_t6" location="25:1-25:60"
                 from="/0/@elements.4" to="/0/@elements.13"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="c_s6_to_t7" location="26:1-26:60"
                 from="/0/@elements.5" to="/0/@elements.14"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="c_s7_to_t8" location="27:1-27:60"
                 from="/0/@elements.6" to="/0/@elements.15"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c9" name="c_s7_to_t9" location="28:1-28:60"
                 from="/0/@elements.6" to="/0/@elements.16"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="c_t1_to_s2" location="30:1-30:60"
                 from="/0/@elements.8" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="c_t1_to_s4" location="31:1-31:60"
                 from="/0/@elements.8" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="c_t2_to_s4" location="32:1-32:60"
                 from="/0/@elements.9" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="c_t3_to_s3" location="33:1-33:60"
                 from="/0/@elements.10" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c14" name="c_t4_to_s5" location="34:1-34:60"
                 from="/0/@elements.11" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c15" name="c_t5_to_s6" location="35:1-35:60"
                 from="/0/@elements.12" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c16" name="c_t6_to_s6" location="36:1-36:60"
                 from="/0/@elements.13" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c17" name="c_t7_to_s7" location="37:1-37:60"
                 from="/0/@elements.14" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c18" name="c_t8_to_s7" location="38:1-38:60"
                 from="/0/@elements.15" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c19" name="c_t9_to_s8" location="39:1-39:60"
                 from="/0/@elements.16" to="/0/@elements.7"/>
  </Grafcet:Grafcet>
</xmi:XMI>