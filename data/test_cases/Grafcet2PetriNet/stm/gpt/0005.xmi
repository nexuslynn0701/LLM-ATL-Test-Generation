<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="loc_grafcet_0005">
    <!-- Elements: mix of Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="loc_s0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ProcessingA" location="loc_s1" isInitial="false" isActive="false" action="processA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessingB" location="loc_s2" isInitial="false" isActive="false" action="processB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="DecisionStep" location="loc_s3" isInitial="false" isActive="false" action="evaluateCondition"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="MergeStep" location="loc_s4" isInitial="false" isActive="false" action="mergeFlows"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_to_A" location="loc_t0" condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Init_to_B" location="loc_t1" condition="alternativeStart"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_A_to_Decision" location="loc_t2" condition="A_finished"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_B_to_Decision" location="loc_t3" condition="B_finished"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_Decision_to_Merge" location="loc_t4" condition="ok"/>
    <!-- Connections: multiple incoming/outgoing on both Steps and Transitions -->
    <!-- From initial step to two parallel branches -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="loc_c0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Init_to_T1" location="loc_c1" from="/0/@elements.0" to="/0/@elements.6"/>
    <!-- From transitions to branch steps -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="C_T0_to_A" location="loc_c2" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="C_T1_to_B" location="loc_c3" from="/0/@elements.6" to="/0/@elements.2"/>
    <!-- From branch steps to decision (two incoming to same transition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_A_to_T2" location="loc_c4" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_B_to_T3" location="loc_c5" from="/0/@elements.2" to="/0/@elements.8"/>
    <!-- From transitions to decision step (two incoming connections on step) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6" name="C_T2_to_Decision" location="loc_c6" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_T3_to_Decision" location="loc_c7" from="/0/@elements.8" to="/0/@elements.3"/>
    <!-- From decision step to merge step via single transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="C_Decision_to_T4" location="loc_c8" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_T4_to_Merge" location="loc_c9" from="/0/@elements.9" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>