<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcetExample" location="1:1-1:100">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="2:1-2:50" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="CheckSensors" location="3:1-3:50" isInitial="false" isActive="false" action="readSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="ProcessData" location="4:1-4:50" isInitial="false" isActive="false" action="computeResults"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="ErrorHandler" location="5:1-5:50" isInitial="false" isActive="false" action="handleError"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="Finalize" location="6:1-6:50" isInitial="false" isActive="false" action="shutdownSystem"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_InitToCheck" location="7:1-7:50" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_CheckToProcess" location="8:1-8:50" condition="sensorsOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_CheckToError" location="9:1-9:50" condition="sensorFailure"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="T_ProcessToFinalize" location="10:1-10:50" condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" name="T_LoopBack" location="11:1-11:50" condition="retryAllowed"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_S0_T0" location="12:1-12:40" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C1" name="C_S1_T1" location="13:1-13:40" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="C_S1_T2" location="14:1-14:40" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C3" name="C_S2_T3" location="15:1-15:40" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C4" name="C_S3_T4" location="16:1-16:40" from="/0/@elements.3" to="/0/@elements.9"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C5" name="C_T0_S1" location="17:1-17:40" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C6" name="C_T1_S2" location="18:1-18:40" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="C_T2_S3" location="19:1-19:40" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C8" name="C_T3_S4" location="20:1-20:40" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C9" name="C_T4_S1" location="21:1-21:40" from="/0/@elements.9" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>