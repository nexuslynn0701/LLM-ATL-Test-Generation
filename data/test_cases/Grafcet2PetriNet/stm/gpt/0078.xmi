<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="1:1-50:1">

    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="2:1-2:80"
              isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="PrepareStep" location="3:1-3:80"
              isInitial="false" isActive="false" action="prepare_data"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="BranchA_Step1" location="4:1-4:80"
              isInitial="false" isActive="false" action="process_branch_A_1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="BranchA_Step2" location="5:1-5:80"
              isInitial="false" isActive="false" action="process_branch_A_2"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="BranchB_Step1" location="6:1-6:80"
              isInitial="false" isActive="false" action="process_branch_B_1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="MergeStep" location="7:1-7:80"
              isInitial="false" isActive="false" action="merge_results"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" name="LoopBodyStep" location="8:1-8:80"
              isInitial="false" isActive="false" action="loop_body_action"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s7" name="FinalStep" location="9:1-9:80"
              isInitial="false" isActive="false" action="finalize_and_stop"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToPrepare" location="10:1-10:80"
              condition="start_button_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_PrepareToFork" location="11:1-11:80"
              condition="data_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_ForkToBranchA1" location="12:1-12:80"
              condition="mode_A_selected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_ForkToBranchB1" location="13:1-13:80"
              condition="mode_B_selected"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_BranchA1ToA2" location="14:1-14:80"
              condition="branch_A_step1_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_BranchA2ToMerge" location="15:1-15:80"
              condition="branch_A_step2_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="T_BranchB1ToMerge" location="16:1-16:80"
              condition="branch_B_step1_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t7" name="T_MergeToLoopBody" location="17:1-17:80"
              condition="all_branches_completed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t8" name="T_LoopBodyToMerge" location="18:1-18:80"
              condition="loop_iteration_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t9" name="T_LoopBodyToFinal" location="19:1-19:80"
              condition="stop_condition_reached"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="20:1-20:80"
                 from="/0/@elements.0" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Prepare_to_T1" location="21:1-21:80"
                 from="/0/@elements.1" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Prepare_to_T2" location="22:1-22:80"
                 from="/0/@elements.1" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_Prepare_to_T3" location="23:1-23:80"
                 from="/0/@elements.1" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_BranchA1_to_T4" location="24:1-24:80"
                 from="/0/@elements.2" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_BranchA2_to_T5" location="25:1-25:80"
                 from="/0/@elements.3" to="/0/@elements.13"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_BranchB1_to_T6" location="26:1-26:80"
                 from="/0/@elements.4" to="/0/@elements.14"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_Merge_to_T7" location="27:1-27:80"
                 from="/0/@elements.5" to="/0/@elements.15"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="C_LoopBody_to_T8" location="28:1-28:80"
                 from="/0/@elements.6" to="/0/@elements.16"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c9" name="C_LoopBody_to_T9" location="29:1-29:80"
                 from="/0/@elements.6" to="/0/@elements.17"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_T0_to_Prepare" location="30:1-30:80"
                 from="/0/@elements.8" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_T1_to_Prepare" location="31:1-31:80"
                 from="/0/@elements.9" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_T2_to_BranchA1" location="32:1-32:80"
                 from="/0/@elements.10" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="C_T3_to_BranchB1" location="33:1-33:80"
                 from="/0/@elements.11" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c14" name="C_T4_to_BranchA2" location="34:1-34:80"
                 from="/0/@elements.12" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c15" name="C_T5_to_Merge" location="35:1-35:80"
                 from="/0/@elements.13" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c16" name="C_T6_to_Merge" location="36:1-36:80"
                 from="/0/@elements.14" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c17" name="C_T7_to_LoopBody" location="37:1-37:80"
                 from="/0/@elements.15" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c18" name="C_T8_to_Merge" location="38:1-38:80"
                 from="/0/@elements.16" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c19" name="C_T9_to_Final" location="39:1-39:80"
                 from="/0/@elements.17" to="/0/@elements.7"/>

  </Grafcet:Grafcet>
</xmi:XMI>