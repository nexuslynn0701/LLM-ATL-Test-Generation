<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet0043" location="(0,0)">
    <!-- Elements: 5 Steps + 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="(10,10)" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ParallelStepA" location="(20,20)" isInitial="false" isActive="false" action="execute_branch_A"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ParallelStepB" location="(30,20)" isInitial="false" isActive="false" action="execute_branch_B"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="MergeStep" location="(40,30)" isInitial="false" isActive="false" action="merge_branches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="FinalStep" location="(50,40)" isInitial="false" isActive="false" action="shutdown_system"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_Init_To_Parallel" location="(15,15)" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_Parallel_To_Merge" location="(35,25)" condition="branches_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_Merge_To_Final" location="(45,35)" condition="confirm_shutdown"/>
    <!-- Connections: 4 StepToTransition + 4 TransitionToStep -->
    <!-- InitStep -> T_Init_To_Parallel -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_to_T0" location="(12,12)" from="/0/@elements.0" to="/0/@elements.5"/>
    <!-- T_Init_To_Parallel -> ParallelStepA -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="C_T0_to_A" location="(18,18)" from="/0/@elements.5" to="/0/@elements.1"/>
    <!-- T_Init_To_Parallel -> ParallelStepB -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="C_T0_to_B" location="(18,19)" from="/0/@elements.5" to="/0/@elements.2"/>
    <!-- ParallelStepA -> T_Parallel_To_Merge -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_A_to_T1" location="(25,22)" from="/0/@elements.1" to="/0/@elements.6"/>
    <!-- ParallelStepB -> T_Parallel_To_Merge -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_B_to_T1" location="(28,22)" from="/0/@elements.2" to="/0/@elements.6"/>
    <!-- T_Parallel_To_Merge -> MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="C_T1_to_Merge" location="(38,28)" from="/0/@elements.6" to="/0/@elements.3"/>
    <!-- MergeStep -> T_Merge_To_Final -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_Merge_to_T2" location="(42,32)" from="/0/@elements.3" to="/0/@elements.7"/>
    <!-- T_Merge_To_Final -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_T2_to_Final" location="(48,38)" from="/0/@elements.7" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>