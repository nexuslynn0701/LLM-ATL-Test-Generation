<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="model/Grafcet/ComplexGrafcetExample.gcf">

    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="1:1-1:50" isInitial="true" isActive="true" action="initializeResources()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ValidationStep" location="2:1-2:60" isInitial="false" isActive="false" action="validateInput()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessingStepA" location="3:1-3:65" isInitial="false" isActive="false" action="processBranchA()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ProcessingStepB" location="4:1-4:65" isInitial="false" isActive="false" action="processBranchB()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="MergeStep" location="5:1-5:55" isInitial="false" isActive="false" action="mergeResults()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="LoopStep" location="6:1-6:55" isInitial="false" isActive="false" action="handleRetry()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" name="FinalStep" location="7:1-7:55" isInitial="false" isActive="false" action="finalizeAndExit()"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToValidation" location="10:1-10:50" condition="systemReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_ValidationToBranchA" location="11:1-11:60" condition="inputType = 'A'"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_ValidationToBranchB" location="12:1-12:60" condition="inputType = 'B'"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_BranchesToMerge" location="13:1-13:60" condition="branchDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_MergeToLoop" location="14:1-14:55" condition="needRetry"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_LoopBackToValidation" location="15:1-15:70" condition="attempts &lt; maxAttempts"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="T_MergeToFinal" location="16:1-16:55" condition="not needRetry"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_s0_to_t0" location="20:1-20:70"
        from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Validation_s1_to_t1" location="21:1-21:75"
        from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Validation_s1_to_t2" location="22:1-22:75"
        from="/0/@elements.1" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_BranchA_s2_to_t3" location="23:1-23:70"
        from="/0/@elements.2" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_BranchB_s3_to_t3" location="24:1-24:70"
        from="/0/@elements.3" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_Merge_s4_to_t4" location="25:1-25:70"
        from="/0/@elements.4" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_Loop_s5_to_t5" location="26:1-26:70"
        from="/0/@elements.5" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_Merge_s4_to_t6" location="27:1-27:70"
        from="/0/@elements.4" to="/0/@elements.13"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_t0_to_Validation_s1" location="30:1-30:80"
        from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_t1_to_BranchA_s2" location="31:1-31:80"
        from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_t2_to_BranchB_s3" location="32:1-32:80"
        from="/0/@elements.9" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_t3_to_Merge_s4" location="33:1-33:80"
        from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_t4_to_Loop_s5" location="34:1-34:80"
        from="/0/@elements.11" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="C_t5_to_Validation_s1" location="35:1-35:85"
        from="/0/@elements.12" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c14" name="C_t6_to_Final_s6" location="36:1-36:80"
        from="/0/@elements.13" to="/0/@elements.6"/>

  </Grafcet:Grafcet>
</xmi:XMI>