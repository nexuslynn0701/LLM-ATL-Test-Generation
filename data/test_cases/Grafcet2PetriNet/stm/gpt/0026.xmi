<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet0026" location="file://complexGrafcet0026.grafcet">
    <!-- Elements: 5 Steps (2 initial) and 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStepA" location="1:1-1:20" isInitial="true" isActive="true" action="initializeA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="InitStepB" location="2:1-2:20" isInitial="true" isActive="false" action="initializeB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="IntermediateStep" location="3:1-3:25" isInitial="false" isActive="false" action="processIntermediate"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="BranchStep1" location="4:1-4:22" isInitial="false" isActive="false" action="branchAction1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="BranchStep2" location="5:1-5:22" isInitial="false" isActive="false" action="branchAction2"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="TransInitToInter" location="6:1-6:28" condition="condFromInit"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="TransInterToBranch" location="7:1-7:30" condition="condToBranch"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="TransMerge" location="8:1-8:24" condition="condMerge"/>

    <!-- Connections: multiple incoming/outgoing per step/transition -->
    <!-- Two initial steps (s0,s1) converge to transition t0 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="c_s0_t0" location="9:1-9:30" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="c_s1_t0" location="10:1-10:30" from="/0/@elements.1" to="/0/@elements.5"/>

    <!-- Transition t0 goes to intermediate step s2 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c2" name="c_t0_s2" location="11:1-11:30" from="/0/@elements.5" to="/0/@elements.2"/>

    <!-- Intermediate step s2 goes to branching transition t1 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="c_s2_t1" location="12:1-12:30" from="/0/@elements.2" to="/0/@elements.6"/>

    <!-- Branching transition t1 goes to two branch steps s3 and s4 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c4" name="c_t1_s3" location="13:1-13:30" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="c_t1_s4" location="14:1-14:30" from="/0/@elements.6" to="/0/@elements.4"/>

    <!-- Both branch steps converge to merging transition t2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="c_s3_t2" location="15:1-15:30" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="c_s4_t2" location="16:1-16:30" from="/0/@elements.4" to="/0/@elements.7"/>

    <!-- Merging transition t2 returns to intermediate step s2 forming a loop -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="c_t2_s2" location="17:1-17:30" from="/0/@elements.7" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>