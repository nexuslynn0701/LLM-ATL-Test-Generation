<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="file://complexGrafcet.grafcet">
    <!-- Elements: 4 Steps, 3 Transitions -->
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s0"
              name="InitStep"
              location="file://complexGrafcet.grafcet#InitStep"
              isInitial="true"
              isActive="true"
              action="initialize_system"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s1"
              name="ParallelStep1"
              location="file://complexGrafcet.grafcet#ParallelStep1"
              isInitial="false"
              isActive="false"
              action="branch_one_action"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s2"
              name="ParallelStep2"
              location="file://complexGrafcet.grafcet#ParallelStep2"
              isInitial="false"
              isActive="false"
              action="branch_two_action"/>
    <elements xsi:type="Grafcet:Step"
              xmi:id="_s3"
              name="FinalStep"
              location="file://complexGrafcet.grafcet#FinalStep"
              isInitial="false"
              isActive="false"
              action="finalize_system"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t0"
              name="SplitTransition"
              location="file://complexGrafcet.grafcet#SplitTransition"
              condition="cond_split"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t1"
              name="JoinTransition"
              location="file://complexGrafcet.grafcet#JoinTransition"
              condition="cond_join"/>
    <elements xsi:type="Grafcet:Transition"
              xmi:id="_t2"
              name="FinalTransition"
              location="file://complexGrafcet.grafcet#FinalTransition"
              condition="cond_final"/>
    <!-- Connections: fan-out and join patterns -->
    <!-- InitStep -> SplitTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c0"
                 name="Arc_Init_to_Split"
                 location="file://complexGrafcet.grafcet#Arc_Init_to_Split"
                 from="/0/@elements.0"
                 to="/0/@elements.4"/>
    <!-- SplitTransition -> ParallelStep1 -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c1"
                 name="Arc_Split_to_P1"
                 location="file://complexGrafcet.grafcet#Arc_Split_to_P1"
                 from="/0/@elements.4"
                 to="/0/@elements.1"/>
    <!-- SplitTransition -> ParallelStep2 -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c2"
                 name="Arc_Split_to_P2"
                 location="file://complexGrafcet.grafcet#Arc_Split_to_P2"
                 from="/0/@elements.4"
                 to="/0/@elements.2"/>
    <!-- ParallelStep1 -> JoinTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c3"
                 name="Arc_P1_to_Join"
                 location="file://complexGrafcet.grafcet#Arc_P1_to_Join"
                 from="/0/@elements.1"
                 to="/0/@elements.5"/>
    <!-- ParallelStep2 -> JoinTransition -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c4"
                 name="Arc_P2_to_Join"
                 location="file://complexGrafcet.grafcet#Arc_P2_to_Join"
                 from="/0/@elements.2"
                 to="/0/@elements.5"/>
    <!-- JoinTransition -> FinalStep -->
    <connections xsi:type="Grafcet:TransitionToStep"
                 xmi:id="_c5"
                 name="Arc_Join_to_Final"
                 location="file://complexGrafcet.grafcet#Arc_Join_to_Final"
                 from="/0/@elements.5"
                 to="/0/@elements.3"/>
    <!-- FinalStep -> FinalTransition (closing loop or terminating) -->
    <connections xsi:type="Grafcet:StepToTransition"
                 xmi:id="_c6"
                 name="Arc_Final_to_FinalTransition"
                 location="file://complexGrafcet.grafcet#Arc_Final_to_FinalTransition"
                 from="/0/@elements.3"
                 to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>