<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0" name="ComplexSequentialGrafcet" location="1,1">
    <!-- Elements: 4 Steps + 3 Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="2,1" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckStep" location="3,1" isInitial="false" isActive="false" action="checkSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessStep" location="4,1" isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="FinalStep" location="5,1" isInitial="false" isActive="false" action="shutdownSystem"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="TransInitToCheck" location="2,2" condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="TransCheckToProcess" location="3,2" condition="checkOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="TransProcessToFinal" location="4,2" condition="processDone"/>
    <!-- Connections: chain S0->T0->S1->T1->S2->T2->S3 with a small branch -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="Arc_S0_T0" location="2,1.5" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c1" name="Arc_T0_S1" location="2.5,1.5" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="Arc_S1_T1" location="3,1.5" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c3" name="Arc_T1_S2" location="3.5,1.5" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="Arc_S2_T2" location="4,1.5" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c5" name="Arc_T2_S3" location="4.5,1.5" from="/0/@elements.6" to="/0/@elements.3"/>
    <!-- Additional branch: from InitStep directly to ProcessStep via TransCheckToProcess (reused transition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="Arc_S0_T1_Alt" location="2.5,2.0" from="/0/@elements.0" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>