<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g0076" name="ComplexGrafcet0076" location="model/grafcet_0076">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="model/grafcet_0076#s0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckInputs" location="model/grafcet_0076#s1" isInitial="false" isActive="false" action="readSensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessData" location="model/grafcet_0076#s2" isInitial="false" isActive="false" action="computeValues"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="BranchA" location="model/grafcet_0076#s3" isInitial="false" isActive="false" action="executeBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="BranchB" location="model/grafcet_0076#s4" isInitial="false" isActive="false" action="executeBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="MergeStep" location="model/grafcet_0076#s5" isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s6" name="FinalStep" location="model/grafcet_0076#s6" isInitial="false" isActive="false" action="shutdownSystem"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToCheck" location="model/grafcet_0076#t0" condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_CheckToProcess" location="model/grafcet_0076#t1" condition="inputsValid"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_ProcessToA" location="model/grafcet_0076#t2" condition="modeA"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_ProcessToB" location="model/grafcet_0076#t3" condition="modeB"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_AtoMerge" location="model/grafcet_0076#t4" condition="branchAComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_BtoMerge" location="model/grafcet_0076#t5" condition="branchBComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="T_MergeToFinal" location="model/grafcet_0076#t6" condition="allBranchesComplete"/>

    <!-- Connections: StepToTransition (Step -> Transition) -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_Init_s0_t0" location="model/grafcet_0076#c0" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_Check_s1_t1" location="model/grafcet_0076#c1" from="/0/@elements.1" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_Process_s2_t2" location="model/grafcet_0076#c2" from="/0/@elements.2" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_Process_s2_t3" location="model/grafcet_0076#c3" from="/0/@elements.2" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_BranchA_s3_t4" location="model/grafcet_0076#c4" from="/0/@elements.3" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_BranchB_s4_t5" location="model/grafcet_0076#c5" from="/0/@elements.4" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_Merge_s5_t6" location="model/grafcet_0076#c6" from="/0/@elements.5" to="/0/@elements.13"/>

    <!-- Connections: TransitionToStep (Transition -> Step) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="C_t0_s1" location="model/grafcet_0076#c7" from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="C_t1_s2" location="model/grafcet_0076#c8" from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_t2_s3" location="model/grafcet_0076#c9" from="/0/@elements.9" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_t3_s4" location="model/grafcet_0076#c10" from="/0/@elements.10" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_t4_s5" location="model/grafcet_0076#c11" from="/0/@elements.11" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_t5_s5" location="model/grafcet_0076#c12" from="/0/@elements.12" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="C_t6_s6" location="model/grafcet_0076#c13" from="/0/@elements.13" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>