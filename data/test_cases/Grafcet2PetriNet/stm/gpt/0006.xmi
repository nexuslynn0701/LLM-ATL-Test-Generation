<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_G0" name="ComplexGrafcet" location="loc:/grafcet/complex">
    <elements xsi:type="Grafcet:Step" xmi:id="_S0" name="InitStep" location="loc:/grafcet/complex/S0" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S1" name="LoopStep" location="loc:/grafcet/complex/S1" isInitial="false" isActive="false" action="performLoopTask"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S2" name="BranchStepA" location="loc:/grafcet/complex/S2" isInitial="false" isActive="false" action="executeBranchA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S3" name="BranchStepB" location="loc:/grafcet/complex/S3" isInitial="false" isActive="false" action="executeBranchB"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S4" name="MergeStep" location="loc:/grafcet/complex/S4" isInitial="false" isActive="false" action="mergeBranches"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_S5" name="FinalStep" location="loc:/grafcet/complex/S5" isInitial="false" isActive="false" action="finalizeSystem"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T0" name="T_init_to_loop" location="loc:/grafcet/complex/T0" condition="startPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T1" name="T_loop_to_branch" location="loc:/grafcet/complex/T1" condition="loopComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T2" name="T_branchA_to_merge" location="loc:/grafcet/complex/T2" condition="A_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T3" name="T_branchB_to_merge" location="loc:/grafcet/complex/T3" condition="B_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T4" name="T_merge_to_final" location="loc:/grafcet/complex/T4" condition="bothDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T5" name="T_loop_self" location="loc:/grafcet/complex/T5" condition="repeatLoop"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_T6" name="T_branch_switch" location="loc:/grafcet/complex/T6" condition="switchBranch"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C0" name="C_S0_T0" location="loc:/grafcet/complex/C0" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C1" name="C_T0_S1" location="loc:/grafcet/complex/C1" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C2" name="C_S1_T1" location="loc:/grafcet/complex/C2" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C3" name="C_T1_S2" location="loc:/grafcet/complex/C3" from="/0/@elements.7" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C4" name="C_T1_S3" location="loc:/grafcet/complex/C4" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C5" name="C_S2_T2" location="loc:/grafcet/complex/C5" from="/0/@elements.2" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C6" name="C_S3_T3" location="loc:/grafcet/complex/C6" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C7" name="C_T2_S4" location="loc:/grafcet/complex/C7" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C8" name="C_T3_S4" location="loc:/grafcet/complex/C8" from="/0/@elements.9" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C9" name="C_S4_T4" location="loc:/grafcet/complex/C9" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C10" name="C_T4_S5" location="loc:/grafcet/complex/C10" from="/0/@elements.10" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C11" name="C_S1_T5" location="loc:/grafcet/complex/C11" from="/0/@elements.1" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C12" name="C_T5_S1" location="loc:/grafcet/complex/C12" from="/0/@elements.11" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_C13" name="C_S2_T6" location="loc:/grafcet/complex/C13" from="/0/@elements.2" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_C14" name="C_T6_S3" location="loc:/grafcet/complex/C14" from="/0/@elements.12" to="/0/@elements.3"/>
  </Grafcet:Grafcet>
</xmi:XMI>