<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcet" location="file://complex_grafcet.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="1:1-1:20" isInitial="true" isActive="true" action="initialize"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="ParallelStepA1" location="2:1-2:22" isInitial="false" isActive="false" action="startA1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ParallelStepA2" location="3:1-3:22" isInitial="false" isActive="false" action="startA2"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="MergeStepA" location="4:1-4:20" isInitial="false" isActive="false" action="mergeA"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="LoopBody" location="5:1-5:20" isInitial="false" isActive="false" action="doLoop"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s5" name="FinalStep" location="6:1-6:20" isInitial="false" isActive="false" action="finalize"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_init_to_parallel" location="10:1-10:25" condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_parallel_to_A1" location="11:1-11:25" condition="branchA1"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_parallel_to_A2" location="12:1-12:25" condition="branchA2"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_join_A1" location="13:1-13:25" condition="A1_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="T_join_A2" location="14:1-14:25" condition="A2_done"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="T_loop_enter" location="15:1-15:25" condition="readyLoop"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="T_loop_back" location="16:1-16:25" condition="moreIterations"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t7" name="T_loop_exit" location="17:1-17:25" condition="noMoreIterations"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t8" name="T_to_final" location="18:1-18:25" condition="endSignal"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="C_s0_t0" location="20:1-20:25"
                 grafcet="/0" from="/0/@elements.0" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="C_s0_t1" location="21:1-21:25"
                 grafcet="/0" from="/0/@elements.0" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="C_s0_t2" location="22:1-22:25"
                 grafcet="/0" from="/0/@elements.0" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="C_s1_t3" location="23:1-23:25"
                 grafcet="/0" from="/0/@elements.1" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="C_s2_t4" location="24:1-24:25"
                 grafcet="/0" from="/0/@elements.2" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="C_s3_t5" location="25:1-25:25"
                 grafcet="/0" from="/0/@elements.3" to="/0/@elements.11"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="C_s4_t6" location="26:1-26:25"
                 grafcet="/0" from="/0/@elements.4" to="/0/@elements.12"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c7" name="C_s4_t7" location="27:1-27:25"
                 grafcet="/0" from="/0/@elements.4" to="/0/@elements.13"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c8" name="C_s3_t8" location="28:1-28:25"
                 grafcet="/0" from="/0/@elements.3" to="/0/@elements.14"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="C_t0_s1" location="30:1-30:25"
                 grafcet="/0" from="/0/@elements.6" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="C_t0_s2" location="31:1-31:25"
                 grafcet="/0" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="C_t1_s1" location="32:1-32:25"
                 grafcet="/0" from="/0/@elements.7" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="C_t2_s2" location="33:1-33:25"
                 grafcet="/0" from="/0/@elements.8" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="C_t3_s3" location="34:1-34:25"
                 grafcet="/0" from="/0/@elements.9" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c14" name="C_t4_s3" location="35:1-35:25"
                 grafcet="/0" from="/0/@elements.10" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c15" name="C_t5_s4" location="36:1-36:25"
                 grafcet="/0" from="/0/@elements.11" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c16" name="C_t6_s4" location="37:1-37:25"
                 grafcet="/0" from="/0/@elements.12" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c17" name="C_t7_s5" location="38:1-38:25"
                 grafcet="/0" from="/0/@elements.13" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c18" name="C_t8_s5" location="39:1-39:25"
                 grafcet="/0" from="/0/@elements.14" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>