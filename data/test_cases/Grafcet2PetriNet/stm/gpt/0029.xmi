<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="1:1-99:1">
    <!-- Elements: 5 steps + 4 transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="2:1-2:50" isInitial="true" isActive="true" action="initialize_system"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckSensors" location="3:1-3:60" isInitial="false" isActive="false" action="read_sensors"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessData" location="4:1-4:60" isInitial="false" isActive="false" action="compute_results"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="ErrorHandler" location="5:1-5:60" isInitial="false" isActive="false" action="handle_error"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="Shutdown" location="6:1-6:60" isInitial="false" isActive="false" action="shutdown_system"/>

    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="T_InitToCheck" location="7:1-7:60" condition="system_ready"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="T_CheckToProcess" location="8:1-8:60" condition="sensors_ok"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="T_CheckToError" location="9:1-9:60" condition="sensors_fail"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="T_ProcessToShutdown" location="10:1-10:60" condition="processing_done"/>

    <!-- Connections: mixed fan-in and fan-out -->
    <!-- InitStep -> T_InitToCheck -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c0"
      name="C_Init_to_T0"
      location="20:1-20:60"
      from="/0/@elements.0"
      to="/0/@elements.5"/>

    <!-- CheckSensors -> T_CheckToProcess -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c1"
      name="C_Check_to_T1"
      location="21:1-21:60"
      from="/0/@elements.1"
      to="/0/@elements.6"/>

    <!-- CheckSensors -> T_CheckToError -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c2"
      name="C_Check_to_T2"
      location="22:1-22:60"
      from="/0/@elements.1"
      to="/0/@elements.7"/>

    <!-- ProcessData -> T_ProcessToShutdown -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c3"
      name="C_Process_to_T3"
      location="23:1-23:60"
      from="/0/@elements.2"
      to="/0/@elements.8"/>

    <!-- ErrorHandler -> T_ProcessToShutdown (fan-in on transition T3) -->
    <connections xsi:type="Grafcet:StepToTransition"
      xmi:id="_c4"
      name="C_Error_to_T3"
      location="24:1-24:60"
      from="/0/@elements.3"
      to="/0/@elements.8"/>

    <!-- T_InitToCheck -> CheckSensors -->
    <connections xsi:type="Grafcet:TransitionToStep"
      xmi:id="_c5"
      name="C_T0_to_Check"
      location="25:1-25:60"
      from="/0/@elements.5"
      to="/0/@elements.1"/>

    <!-- T_CheckToProcess -> ProcessData -->
    <connections xsi:type="Grafcet:TransitionToStep"
      xmi:id="_c6"
      name="C_T1_to_Process"
      location="26:1-26:60"
      from="/0/@elements.6"
      to="/0/@elements.2"/>

    <!-- T_CheckToError -> ErrorHandler -->
    <connections xsi:type="Grafcet:TransitionToStep"
      xmi:id="_c7"
      name="C_T2_to_Error"
      location="27:1-27:60"
      from="/0/@elements.7"
      to="/0/@elements.3"/>

    <!-- T_ProcessToShutdown -> Shutdown -->
    <connections xsi:type="Grafcet:TransitionToStep"
      xmi:id="_c8"
      name="C_T3_to_Shutdown"
      location="28:1-28:60"
      from="/0/@elements.8"
      to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>