<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="_g000" name="ComplexGrafcetExample" location="file:/models/grafcet_0100.gcf">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="Start" location="file:/models/grafcet_0100.gcf#s0"
              isInitial="true" isActive="true" action="initSystem()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="CheckSensors" location="file:/models/grafcet_0100.gcf#s1"
              isInitial="false" isActive="false" action="readSensors()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessData" location="file:/models/grafcet_0100.gcf#s2"
              isInitial="false" isActive="false" action="computeResults()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="HandleError" location="file:/models/grafcet_0100.gcf#s3"
              isInitial="false" isActive="false" action="raiseAlarm()"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="Finalize" location="file:/models/grafcet_0100.gcf#s4"
              isInitial="false" isActive="false" action="shutdown()"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="ToCheck" location="file:/models/grafcet_0100.gcf#t0"
              condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="ToProcessOk" location="file:/models/grafcet_0100.gcf#t1"
              condition="sensorsOK"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="ToError" location="file:/models/grafcet_0100.gcf#t2"
              condition="sensorsFail"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="ToFinalize" location="file:/models/grafcet_0100.gcf#t3"
              condition="processingDone"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="LoopProcess" location="file:/models/grafcet_0100.gcf#t4"
              condition="needMoreProcessing"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="ResetFromError" location="file:/models/grafcet_0100.gcf#t5"
              condition="resetCommand"/>

    <!-- Connections: Step -> Transition -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0"
                 name="c_Start_ToCheck"
                 location="file:/models/grafcet_0100.gcf#c0"
                 from="/0/@elements.0"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1"
                 name="c_Check_ToProcessOk"
                 location="file:/models/grafcet_0100.gcf#c1"
                 from="/0/@elements.1"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2"
                 name="c_Check_ToError"
                 location="file:/models/grafcet_0100.gcf#c2"
                 from="/0/@elements.1"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3"
                 name="c_Process_ToFinalize"
                 location="file:/models/grafcet_0100.gcf#c3"
                 from="/0/@elements.2"
                 to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4"
                 name="c_Process_Loop"
                 location="file:/models/grafcet_0100.gcf#c4"
                 from="/0/@elements.2"
                 to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5"
                 name="c_Error_Reset"
                 location="file:/models/grafcet_0100.gcf#c5"
                 from="/0/@elements.3"
                 to="/0/@elements.10"/>

    <!-- Connections: Transition -> Step -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c6"
                 name="c_ToCheck_Check"
                 location="file:/models/grafcet_0100.gcf#c6"
                 from="/0/@elements.5"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7"
                 name="c_ToProcessOk_Process"
                 location="file:/models/grafcet_0100.gcf#c7"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8"
                 name="c_ToError_Error"
                 location="file:/models/grafcet_0100.gcf#c8"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9"
                 name="c_ToFinalize_Finalize"
                 location="file:/models/grafcet_0100.gcf#c9"
                 from="/0/@elements.8"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10"
                 name="c_LoopProcess_Process"
                 location="file:/models/grafcet_0100.gcf#c10"
                 from="/0/@elements.9"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11"
                 name="c_ResetFromError_Start"
                 location="file:/models/grafcet_0100.gcf#c11"
                 from="/0/@elements.10"
                 to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>