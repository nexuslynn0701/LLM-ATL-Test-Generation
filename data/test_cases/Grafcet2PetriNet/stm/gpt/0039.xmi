<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet xmi:id="/0" name="ComplexGrafcet0039" location="loc_grafcet_0039">
    <!-- Elements: Steps and Transitions -->
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.0" name="InitStep" location="loc_step_init" isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.1" name="BranchStep1" location="loc_step_branch1" isInitial="false" isActive="false" action="branchAction1"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.2" name="BranchStep2" location="loc_step_branch2" isInitial="false" isActive="false" action="branchAction2"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.3" name="MergeStep" location="loc_step_merge" isInitial="false" isActive="false" action="mergeAction"/>
    <elements xsi:type="Grafcet:Step" xmi:id="/0/@elements.4" name="LoopStep" location="loc_step_loop" isInitial="false" isActive="true" action="loopProcessing"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.5" name="T_Init_to_B1" location="loc_trans_0_1" condition="cond_init_to_b1"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.6" name="T_Init_to_B2" location="loc_trans_0_2" condition="cond_init_to_b2"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.7" name="T_B1_to_Merge" location="loc_trans_1_3" condition="cond_b1_to_merge"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.8" name="T_B2_to_Merge" location="loc_trans_2_3" condition="cond_b2_to_merge"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.9" name="T_Merge_to_Loop" location="loc_trans_3_4" condition="cond_merge_to_loop"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="/0/@elements.10" name="T_Loop_Self" location="loc_trans_4_4" condition="cond_loop_self"/>
    <!-- Connections: StepToTransition and TransitionToStep -->
    <!-- From InitStep to T_Init_to_B1 and T_Init_to_B2 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.0" name="C_Init_to_T1" location="loc_conn_s2t_0_5" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.1" name="C_Init_to_T2" location="loc_conn_s2t_0_6" from="/0/@elements.0" to="/0/@elements.6"/>
    <!-- From T_Init_to_B1 and T_Init_to_B2 to BranchStep1 and BranchStep2 -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.2" name="C_T1_to_B1" location="loc_conn_t2s_5_1" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.3" name="C_T2_to_B2" location="loc_conn_t2s_6_2" from="/0/@elements.6" to="/0/@elements.2"/>
    <!-- From BranchStep1 and BranchStep2 to their transitions towards MergeStep -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.4" name="C_B1_to_T3" location="loc_conn_s2t_1_7" from="/0/@elements.1" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.5" name="C_B2_to_T4" location="loc_conn_s2t_2_8" from="/0/@elements.2" to="/0/@elements.8"/>
    <!-- From T_B1_to_Merge and T_B2_to_Merge to MergeStep -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.6" name="C_T3_to_Merge" location="loc_conn_t2s_7_3" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.7" name="C_T4_to_Merge" location="loc_conn_t2s_8_3" from="/0/@elements.8" to="/0/@elements.3"/>
    <!-- From MergeStep to LoopStep via T_Merge_to_Loop -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.8" name="C_Merge_to_T5" location="loc_conn_s2t_3_9" from="/0/@elements.3" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.9" name="C_T5_to_Loop" location="loc_conn_t2s_9_4" from="/0/@elements.9" to="/0/@elements.4"/>
    <!-- Loop from LoopStep back to itself via T_Loop_Self -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="/0/@connections.10" name="C_Loop_to_T6" location="loc_conn_s2t_4_10" from="/0/@elements.4" to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="/0/@connections.11" name="C_T6_to_Loop" location="loc_conn_t2s_10_4" from="/0/@elements.10" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>