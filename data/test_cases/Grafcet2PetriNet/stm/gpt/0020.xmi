<xmi:XMI xmi:version="2.0"
         xmlns:xmi="http://www.omg.org/XMI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Grafcet="Grafcet">

  <Grafcet:Grafcet xmi:id="_g0" name="ComplexGrafcetExample" location="file://complex/graph/grafcet.grafcet">
    <!-- Steps -->
    <elements xsi:type="Grafcet:Step" xmi:id="_s0" name="InitStep" location="file://complex/graph/grafcet.grafcet#s0"
              isInitial="true" isActive="true" action="initializeSystem"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s1" name="PrepareStep" location="file://complex/graph/grafcet.grafcet#s1"
              isInitial="false" isActive="false" action="prepareResources"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s2" name="ProcessStep" location="file://complex/graph/grafcet.grafcet#s2"
              isInitial="false" isActive="false" action="processData"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s3" name="FinalizeStep" location="file://complex/graph/grafcet.grafcet#s3"
              isInitial="false" isActive="false" action="finalizeRun"/>
    <elements xsi:type="Grafcet:Step" xmi:id="_s4" name="ErrorHandler" location="file://complex/graph/grafcet.grafcet#error"
              isInitial="false" isActive="false" action="handleError"/>

    <!-- Transitions -->
    <elements xsi:type="Grafcet:Transition" xmi:id="_t0" name="InitToPrepare" location="file://complex/graph/grafcet.grafcet#t0"
              condition="startButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t1" name="PrepareToProcess" location="file://complex/graph/grafcet.grafcet#t1"
              condition="resourcesReady"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t2" name="ProcessToFinalize" location="file://complex/graph/grafcet.grafcet#t2"
              condition="processingComplete"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t3" name="FinalizeToInit" location="file://complex/graph/grafcet.grafcet#t3"
              condition="resetRequested"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t4" name="ErrorFromPrepare" location="file://complex/graph/grafcet.grafcet#t4"
              condition="resourceFailure"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t5" name="ErrorFromProcess" location="file://complex/graph/grafcet.grafcet#t5"
              condition="processingFailure"/>
    <elements xsi:type="Grafcet:Transition" xmi:id="_t6" name="RecoverFromError" location="file://complex/graph/grafcet.grafcet#t6"
              condition="errorRecovered"/>

    <!-- Connections: Step -> Transition -->
    <!-- s0 -> t0, s1 -> t1 & t4, s2 -> t2 & t5, s3 -> t3, s4 -> t6 -->
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c0" name="arc_s0_t0"
                 location="file://complex/graph/grafcet.grafcet#c0"
                 from="/0/@elements.0"
                 to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c1" name="arc_s1_t1"
                 location="file://complex/graph/grafcet.grafcet#c1"
                 from="/0/@elements.1"
                 to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c2" name="arc_s1_t4"
                 location="file://complex/graph/grafcet.grafcet#c2"
                 from="/0/@elements.1"
                 to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c3" name="arc_s2_t2"
                 location="file://complex/graph/grafcet.grafcet#c3"
                 from="/0/@elements.2"
                 to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c4" name="arc_s2_t5"
                 location="file://complex/graph/grafcet.grafcet#c4"
                 from="/0/@elements.2"
                 to="/0/@elements.10"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c5" name="arc_s3_t3"
                 location="file://complex/graph/grafcet.grafcet#c5"
                 from="/0/@elements.3"
                 to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:StepToTransition" xmi:id="_c6" name="arc_s4_t6"
                 location="file://complex/graph/grafcet.grafcet#c6"
                 from="/0/@elements.4"
                 to="/0/@elements.11"/>

    <!-- Connections: Transition -> Step -->
    <!-- t0 -> s1, t1 -> s2, t2 -> s3, t3 -> s0, t4 & t5 -> s4, t6 -> s1 (recovery path) -->
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c7" name="arc_t0_s1"
                 location="file://complex/graph/grafcet.grafcet#c7"
                 from="/0/@elements.5"
                 to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c8" name="arc_t1_s2"
                 location="file://complex/graph/grafcet.grafcet#c8"
                 from="/0/@elements.6"
                 to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c9" name="arc_t2_s3"
                 location="file://complex/graph/grafcet.grafcet#c9"
                 from="/0/@elements.7"
                 to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c10" name="arc_t3_s0"
                 location="file://complex/graph/grafcet.grafcet#c10"
                 from="/0/@elements.8"
                 to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c11" name="arc_t4_s4"
                 location="file://complex/graph/grafcet.grafcet#c11"
                 from="/0/@elements.9"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c12" name="arc_t5_s4"
                 location="file://complex/graph/grafcet.grafcet#c12"
                 from="/0/@elements.10"
                 to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" xmi:id="_c13" name="arc_t6_s1"
                 location="file://complex/graph/grafcet.grafcet#c13"
                 from="/0/@elements.11"
                 to="/0/@elements.1"/>
  </Grafcet:Grafcet>

</xmi:XMI>