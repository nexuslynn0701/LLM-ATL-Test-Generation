<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexGrafcet" location="model1">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="step1" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="trans1" condition="SensorA"/>
    <elements xsi:type="Grafcet:Step" name="Step2" location="step2" isInitial="false" isActive="false" action="Process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="trans2" condition="SensorB"/>
    <elements xsi:type="Grafcet:Step" name="Step3" location="step3" isInitial="false" isActive="false" action="Validate"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="trans3" condition="Timer"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="step4" isInitial="false" isActive="false" action="End"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="conn1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C2" location="conn2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C3" location="conn3" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C4" location="conn4" from="/0/@elements.3" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C5" location="conn5" from="/0/@elements.4" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C6" location="conn6" from="/0/@elements.5" to="/0/@elements.6"/>
  </Grafcet:Grafcet>
</xmi:XMI>