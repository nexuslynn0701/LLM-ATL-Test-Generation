<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="Grafcet_0055" location="loc0">
    <elements xsi:type="Grafcet:Step" name="Step1" location="loc1" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Step" name="Step2" location="loc2" isInitial="false" isActive="false" action="Process"/>
    <elements xsi:type="Grafcet:Step" name="Step3" location="loc3" isInitial="false" isActive="false" action="End"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="loc4" condition="x==1"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="loc5" condition="y==2"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="loc6" condition="z==3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S1toT1" location="loc7" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T1toS2" location="loc8" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S2toT2" location="loc9" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T2toS3" location="loc10" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S3toT3" location="loc11" from="/0/@elements.2" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T3toS1" location="loc12" from="/0/@elements.5" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>