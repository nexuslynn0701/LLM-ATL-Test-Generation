<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="ComplexSequence" location="seq1">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="s1" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="t1" condition="StartSignal"/>
    <elements xsi:type="Grafcet:Step" name="IntermediateStep" location="s2" isInitial="false" isActive="false" action="Process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="t2" condition="ProcessDone"/>
    <elements xsi:type="Grafcet:Step" name="FinalStep" location="s3" isInitial="false" isActive="false" action="End"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="t3" condition="Reset"/>
    <elements xsi:type="Grafcet:Step" name="AlternativeStep" location="s4" isInitial="false" isActive="false" action="Alternative"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="c1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C2" location="c2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C3" location="c3" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C4" location="c4" from="/0/@elements.3" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C5" location="c5" from="/0/@elements.4" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C6" location="c6" from="/0/@elements.5" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C7" location="c7" from="/0/@elements.4" to="/0/@elements.5"/>
  </Grafcet:Grafcet>
</xmi:XMI>