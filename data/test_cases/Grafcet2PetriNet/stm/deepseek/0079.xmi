<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="GrafcetTest" location="test.grafcet">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="10,10" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Step" name="StepA" location="10,100" isInitial="false" isActive="false" action="ProcessA"/>
    <elements xsi:type="Grafcet:Step" name="StepB" location="10,200" isInitial="false" isActive="false" action="ProcessB"/>
    <elements xsi:type="Grafcet:Step" name="StepC" location="10,300" isInitial="false" isActive="false" action="ProcessC"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="50,50" condition="StartButton"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="50,150" condition="SensorA"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="50,250" condition="SensorB"/>
    <elements xsi:type="Grafcet:Transition" name="T4" location="50,350" condition="SensorC"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S0_T1" location="0" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T1_S1" location="0" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S1_T2" location="0" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T2_S2" location="0" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S2_T3" location="0" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T3_S3" location="0" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S3_T4" location="0" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T4_S0" location="0" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>