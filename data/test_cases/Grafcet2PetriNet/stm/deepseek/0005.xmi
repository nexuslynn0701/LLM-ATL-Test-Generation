<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="DualBranchSystem" location="file:///models/dualBranch.grafcet">
    <elements xsi:type="Grafcet:Step" name="Start" location="x=10,y=20" isInitial="true" isActive="true" action="Initialize"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="x=10,y=80" condition="start_pressed"/>
    <elements xsi:type="Grafcet:Step" name="BranchA" location="x=10,y=140" isInitial="false" isActive="false" action="ProcessA"/>
    <elements xsi:type="Grafcet:Step" name="BranchB" location="x=200,y=140" isInitial="false" isActive="false" action="ProcessB"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="x=10,y=200" condition="sensor_A_ok"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="x=200,y=200" condition="sensor_B_ok"/>
    <elements xsi:type="Grafcet:Step" name="Merge" location="x=100,y=260" isInitial="false" isActive="false" action="MergeResults"/>
    <elements xsi:type="Grafcet:Transition" name="T4" location="x=100,y=320" condition="merge_complete"/>
    <elements xsi:type="Grafcet:Step" name="End" location="x=100,y=380" isInitial="false" isActive="false" action="Finalize"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="conn1" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C2" location="conn2" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C3" location="conn3" from="/0/@elements.1" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C4" location="conn4" from="/0/@elements.2" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C5" location="conn5" from="/0/@elements.3" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C6" location="conn6" from="/0/@elements.4" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C7" location="conn7" from="/0/@elements.5" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C8" location="conn8" from="/0/@elements.6" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C9" location="conn9" from="/0/@elements.7" to="/0/@elements.8"/>
  </Grafcet:Grafcet>
</xmi:XMI>