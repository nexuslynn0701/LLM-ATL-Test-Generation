<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="G0095" location="model0095">
    <elements xsi:type="Grafcet:Step" name="S1" location="step1" isInitial="true" isActive="true" action="StartMotor"/>
    <elements xsi:type="Grafcet:Step" name="S2" location="step2" isInitial="false" isActive="false" action="OpenValve"/>
    <elements xsi:type="Grafcet:Step" name="S3" location="step3" isInitial="false" isActive="false" action="HeatLiquid"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="trans1" condition="StartButtonPressed"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="trans2" condition="LevelReached"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="trans3" condition="TemperatureOK"/>
    <elements xsi:type="Grafcet:Transition" name="T4" location="trans4" condition="TimerExpired"/>
    <elements xsi:type="Grafcet:Step" name="S4" location="step4" isInitial="false" isActive="false" action="StopMotor"/>
    <connections xsi:type="Grafcet:StepToTransition" name="ST1" location="conn1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="TS1" location="conn2" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="ST2" location="conn3" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="TS2" location="conn4" from="/0/@elements.4" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="ST3" location="conn5" from="/0/@elements.2" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="TS3" location="conn6" from="/0/@elements.5" to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:StepToTransition" name="ST4" location="conn7" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="TS4" location="conn8" from="/0/@elements.6" to="/0/@elements.7"/>
  </Grafcet:Grafcet>
</xmi:XMI>