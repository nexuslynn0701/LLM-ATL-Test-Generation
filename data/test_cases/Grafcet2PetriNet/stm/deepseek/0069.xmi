<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="DualTankSystem" location="model/dualtank.grafcet">
    <elements xsi:type="Grafcet:Step" name="Idle" location="100,50" isInitial="true" isActive="true" action="none"/>
    <elements xsi:type="Grafcet:Step" name="FillTank1" location="100,200" isInitial="false" isActive="false" action="open_valve_1"/>
    <elements xsi:type="Grafcet:Step" name="FillTank2" location="100,350" isInitial="false" isActive="false" action="open_valve_2"/>
    <elements xsi:type="Grafcet:Step" name="DrainTank1" location="300,200" isInitial="false" isActive="false" action="drain_valve_1"/>
    <elements xsi:type="Grafcet:Step" name="DrainTank2" location="300,350" isInitial="false" isActive="false" action="drain_valve_2"/>
    <elements xsi:type="Grafcet:Transition" name="StartFill1" location="100,125" condition="start_btn_pressed"/>
    <elements xsi:type="Grafcet:Transition" name="Level1Full" location="100,275" condition="tank1_full_sensor"/>
    <elements xsi:type="Grafcet:Transition" name="Level2Full" location="100,425" condition="tank2_full_sensor"/>
    <elements xsi:type="Grafcet:Transition" name="Drain1Done" location="300,275" condition="tank1_empty_sensor"/>
    <elements xsi:type="Grafcet:Transition" name="Drain2Done" location="300,425" condition="tank2_empty_sensor"/>
    <elements xsi:type="Grafcet:Transition" name="BothDrained" location="200,500" condition="cycle_complete"/>
    <connections xsi:type="Grafcet:StepToTransition" name="s1" location="0" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="t1" location="0" from="/0/@elements.5" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="s2" location="0" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="t2" location="0" from="/0/@elements.6" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="s3" location="0" from="/0/@elements.2" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="t3" location="0" from="/0/@elements.7" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="s4" location="0" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="t4" location="0" from="/0/@elements.8" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" name="s5" location="0" from="/0/@elements.4" to="/0/@elements.9"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="t5" location="0" from="/0/@elements.9" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>