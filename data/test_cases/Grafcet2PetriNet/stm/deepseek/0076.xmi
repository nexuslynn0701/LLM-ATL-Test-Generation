<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="GrafcetTest" location="loc0">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="loc1" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="loc2" condition="X1"/>
    <elements xsi:type="Grafcet:Step" name="Step2" location="loc3" isInitial="false" isActive="false" action="Process"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="loc4" condition="X2"/>
    <elements xsi:type="Grafcet:Step" name="Step3" location="loc5" isInitial="false" isActive="false" action="End"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C1" location="loc6" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C2" location="loc7" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="C3" location="loc8" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="C4" location="loc9" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>