<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="GrafcetTest" location="test.grafcet">
    <elements xsi:type="Grafcet:Step" name="InitialStep" location="10,10" isInitial="true" isActive="true" action="Start"/>
    <elements xsi:type="Grafcet:Step" name="Step1" location="10,80" isInitial="false" isActive="false" action="ProcessA"/>
    <elements xsi:type="Grafcet:Step" name="Step2" location="10,150" isInitial="false" isActive="false" action="ProcessB"/>
    <elements xsi:type="Grafcet:Step" name="Step3" location="10,220" isInitial="false" isActive="false" action="ProcessC"/>
    <elements xsi:type="Grafcet:Transition" name="T1" location="10,45" condition="StartButton"/>
    <elements xsi:type="Grafcet:Transition" name="T2" location="10,115" condition="SensorA"/>
    <elements xsi:type="Grafcet:Transition" name="T3" location="10,185" condition="SensorB"/>
    <elements xsi:type="Grafcet:Transition" name="T4" location="10,255" condition="Reset"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S0toT1" location="10,30" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T1toS1" location="10,60" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S1toT2" location="10,100" from="/0/@elements.1" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T2toS2" location="10,130" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S2toT3" location="10,170" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T3toS3" location="10,200" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:StepToTransition" name="S3toT4" location="10,240" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="T4toS0" location="10,270" from="/0/@elements.7" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>