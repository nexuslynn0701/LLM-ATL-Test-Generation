<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet name="LiftControl" location="root">
    <elements xsi:type="Grafcet:Step" name="Idle" location="step1" isInitial="true" isActive="true" action="Wait"/>
    <elements xsi:type="Grafcet:Step" name="MovingUp" location="step2" isInitial="false" isActive="false" action="GoUp"/>
    <elements xsi:type="Grafcet:Step" name="MovingDown" location="step3" isInitial="false" isActive="false" action="GoDown"/>
    <elements xsi:type="Grafcet:Step" name="DoorOpen" location="step4" isInitial="false" isActive="false" action="OpenDoor"/>
    <elements xsi:type="Grafcet:Transition" name="CallUp" location="trans1" condition="buttonUp"/>
    <elements xsi:type="Grafcet:Transition" name="CallDown" location="trans2" condition="buttonDown"/>
    <elements xsi:type="Grafcet:Transition" name="Arrived" location="trans3" condition="arrived"/>
    <elements xsi:type="Grafcet:Transition" name="DoorClosed" location="trans4" condition="closed"/>
    <elements xsi:type="Grafcet:Transition" name="AfterDelay" location="trans5" condition="timerExpired"/>
    <connections xsi:type="Grafcet:StepToTransition" name="s1t1" location="conn1" from="/0/@elements.0" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:StepToTransition" name="s1t2" location="conn2" from="/0/@elements.0" to="/0/@elements.5"/>
    <connections xsi:type="Grafcet:StepToTransition" name="s2t3" location="conn3" from="/0/@elements.1" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" name="s3t3" location="conn4" from="/0/@elements.2" to="/0/@elements.6"/>
    <connections xsi:type="Grafcet:StepToTransition" name="s4t4" location="conn5" from="/0/@elements.3" to="/0/@elements.7"/>
    <connections xsi:type="Grafcet:StepToTransition" name="s4t5" location="conn6" from="/0/@elements.3" to="/0/@elements.8"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="t1s2" location="conn7" from="/0/@elements.4" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="t2s3" location="conn8" from="/0/@elements.5" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="t3s4" location="conn9" from="/0/@elements.6" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="t4s1" location="conn10" from="/0/@elements.7" to="/0/@elements.0"/>
    <connections xsi:type="Grafcet:TransitionToStep" name="t5s1" location="conn11" from="/0/@elements.8" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>