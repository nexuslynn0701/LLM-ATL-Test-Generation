<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="DocumentationBuild"
    default="generate-docs"
    basedir="/project/home"
    description="Build documentation for the project">
  <targets xmi:id="generate-docs" name="generate-docs" description="Generate all documentation">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src/main/java"
        destdir="target/docs"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="Project API Documentation"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/docs/images"/>
    <tasks xsi:type="Ant:Echo" message="Documentation generation completed"/>
  </targets>
  <targets xmi:id="clean-docs" name="clean-docs" description="Clean documentation directory">
    <tasks xsi:type="Ant:Delete" dir="target/docs" verbose="true" failonerror="true"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile source code">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" optimize="false" deprecation="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.version" value="2.0.1"/>
  <properties xsi:type="Ant:PropertyLocation" name="tools.dir" location="/usr/local/tools"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
</Ant:Project>