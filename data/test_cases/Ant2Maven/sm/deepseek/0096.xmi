<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="PublishArtifacts"
    default="deploy"
    basedir="."
    description="Build and deploy project artifacts">
  <targets xmi:id="deploy" name="deploy" description="Deploy the distribution">
    <tasks xsi:type="Ant:Copy" file="build/dist.jar" todir="/var/www/apps" overwrite="true"/>
    <tasks xsi:type="Ant:Chmod" perm="ugo+rx" file="/var/www/apps/dist.jar"/>
  </targets>
</Ant:Project>