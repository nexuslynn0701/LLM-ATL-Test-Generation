<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SecureBuild"
    default="deploy"
    basedir="/workspace"
    description="Build and deploy secure application">
  <targets xmi:id="deploy" name="deploy" description="Deploy the application">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Copy" todir="dist/app" file="build/app.jar" overwrite="true"/>
    <tasks xsi:type="Ant:Delete" dir="temp" verbose="true" failonerror="false"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run unit tests">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="build/test" debug="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/test-lib.jar" basedir="build/test" compress="true"/>
  </targets>
</Ant:Project>