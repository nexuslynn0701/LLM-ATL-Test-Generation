<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="TestProject72"
    default="build"
    basedir="."
    description="Comprehensive test model for Ant2Maven transformation">
  <targets xmi:id="build" name="build" description="Main build target">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes" taskname="mkdir"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" optimize="true" deprecation="false" fork="false" taskname="compile"/>
    <tasks xsi:type="Ant:Jar" jarfile="target/app.jar" basedir="target/classes" compress="true" encoding="UTF-8" manifest="src/META-INF/MANIFEST.MF" taskname="jar"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="target" includeEmptyDirs="true" failonerror="false" verbose="true" taskname="clean"/>
  </targets>
  <targets xmi:id="javadoc" name="javadoc" description="Generate documentation" ifCondition="java.home">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src/main/java" destdir="target/docs" packagenames="com.example.*" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="My App API" taskname="javadoc"/>
  </targets>
  <targets xmi:id="all" name="all" description="Run all targets">
    <tasks xsi:type="Ant:Tstamp" taskname="timestamp">
      <format property="DSTAMP" pattern="yyyyMMdd" locale="en_US"/>
      <format property="TSTAMP" pattern="HH:mm" offset="2" unit="hour"/>
    </tasks>
    <tasks xsi:type="Ant:Copy" file="README.md" tofile="target/README.txt" overwrite="true" filtering="false" flatten="true" taskname="copy-readme"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="target/classes"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="/opt/lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
</Ant:Project>