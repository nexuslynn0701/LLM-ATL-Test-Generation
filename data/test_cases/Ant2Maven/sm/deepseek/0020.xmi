<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="build"
    basedir="."
    description="Sample build project">
  <targets xmi:id="build" name="build" description="Main build target">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes" taskname="mkdir"/>
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="false" optimize="false" deprecation="false" taskname="javac"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes" compress="true" encoding="UTF-8" taskname="jar"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" taskname="delete"/>
    <tasks xsi:type="Ant:Delete" file="dist/app.jar" verbose="true" quiet="false" failonerror="true" taskname="delete-jar"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run tests">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="build/test-classes" debug="true" fork="false" optimize="false" deprecation="false" taskname="javac-test"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/test.jar" basedir="build/test-classes" compress="true" encoding="UTF-8" taskname="jar-test"/>
  </targets>
</Ant:Project>