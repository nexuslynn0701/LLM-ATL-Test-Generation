<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="build"
    basedir="."
    description="Sample build project">
  <targets xmi:id="clean" name="clean" description="Clean build directory">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true"/>
  </targets>
  <targets xmi:id="build" name="build" description="Compile and package">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="false" optimize="false" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/myapp.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run tests" ifCondition="test.enabled">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="build/test-classes" debug="true"/>
    <tasks xsi:type="Ant:Copy" file="test/config.properties" todir="build/test-classes" overwrite="true" filtering="false" flatten="false"/>
  </targets>
  <targets xmi:id="docs" name="docs" description="Generate documentation" unless="skip.docs">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="build/docs" packagenames="com.example.*" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="MyApp API"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="/usr/local/lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
</Ant:Project>