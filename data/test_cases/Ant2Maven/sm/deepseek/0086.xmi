<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="PackageManager"
    default="deploy"
    basedir="./project"
    description="Build and deploy application">
  <targets xmi:id="deploy" name="deploy" description="Deploy the application">
    <tasks xsi:type="Ant:Javac" srcdir="./src" destdir="./build/classes" debug="true" optimize="false" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="./dist/app.jar" basedir="./build/classes" compress="true" encoding="UTF-8"/>
    <tasks xsi:type="Ant:Mkdir" dir="./dist"/>
    <tasks xsi:type="Ant:Delete" dir="./temp" verbose="true" failonerror="false"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="./build" quiet="true" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" dir="./dist" quiet="true" includeEmptyDirs="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="./build"/>
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="./src"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="./lib"/>
  <properties xsi:type="Ant:PropertyFile" file="./build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
</Ant:Project>