<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="DocumentationProject"
    default="docs"
    basedir="."
    description="Project for generating documentation">
  <targets xmi:id="docs" name="generate-docs" description="Generate Java documentation">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src/main/java"
        destdir="target/docs"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="My API Documentation"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/docs"/>
    <tasks xsi:type="Ant:Delete" dir="target/temp"/>
  </targets>
  <targets xmi:id="build" name="build-project" description="Build the project">
    <tasks xsi:type="Ant:Javac"
        srcdir="src/main/java"
        destdir="target/classes"
        debug="true"
        fork="false"
        optimize="true"
        deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
        destfile="target/dist/myapp.jar"
        basedir="target/classes"
        compress="true"
        encoding="UTF-8"
        manifest="src/META-INF/MANIFEST.MF"/>
  </targets>
</Ant:Project>