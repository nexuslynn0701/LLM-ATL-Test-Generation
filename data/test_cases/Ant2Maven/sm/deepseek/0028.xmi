<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="package"
    basedir="."
    description="Sample build project">
  <targets xmi:id="package" name="package" description="Package the application">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" fork="false" optimize="false" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="target/app.jar" basedir="target/classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/dist"/>
    <tasks xsi:type="Ant:Copy" file="target/app.jar" tofile="target/dist/app.jar" overwrite="true" flatten="false"/>
    <tasks xsi:type="Ant:Delete" dir="target/temp" verbose="false" quiet="true" failonerror="false" includeEmptyDirs="true"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="target" verbose="true" failonerror="true"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run tests" ifCondition="junit.present">
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="target/test-classes" debug="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="target/test.jar" basedir="target/test-classes"/>
  </targets>
</Ant:Project>