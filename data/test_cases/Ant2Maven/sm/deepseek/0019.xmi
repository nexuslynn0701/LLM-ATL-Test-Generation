<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="deploy"
    basedir="/workspace"
    description="Main build project">
  <targets xmi:id="deploy" name="deploy" description="Deploy the application">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" fork="false" optimize="false" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="target/classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir" dir="deploy"/>
    <tasks xsi:type="Ant:Copy" file="dist/app.jar" todir="deploy" overwrite="true" filtering="false" flatten="false" includeEmptyDirs="false"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="target" verbose="false" quiet="false" failonerror="true" includeEmptyDirs="false"/>
    <tasks xsi:type="Ant:Delete" file="dist/app.jar" verbose="false" quiet="false" failonerror="true" includeEmptyDirs="false"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run unit tests">
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="target/test-classes" debug="true" fork="false" optimize="false" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/test.jar" basedir="target/test-classes" compress="false" encoding="UTF-8"/>
  </targets>
  <targets xmi:id="docs" name="docs" description="Generate documentation">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src/main/java" destdir="target/docs" packagenames="com.example.*" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="MyApp API"/>
  </targets>
  <targets xmi:id="archive" name="archive" description="Create distribution archive">
    <tasks xsi:type="Ant:Jar" jarfile="dist/archive.jar" basedir="target/classes" compress="true" encoding="UTF-8"/>
    <tasks xsi:type="Ant:Copy" file="dist/archive.jar" todir="backup" overwrite="false" filtering="false" flatten="false" includeEmptyDirs="false"/>
  </targets>
</Ant:Project>