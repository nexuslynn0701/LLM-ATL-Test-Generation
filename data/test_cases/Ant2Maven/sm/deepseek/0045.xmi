<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="package"
    basedir="."
    description="Sample build project">
  <targets xmi:id="clean" name="clean" description="Clean build directory">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile source code">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="false" optimize="false" deprecation="false"/>
  </targets>
  <targets xmi:id="package" name="package" description="Create JAR file">
    <tasks xsi:type="Ant:Jar" jarfile="dist/myapp.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>
  <targets xmi:id="docs" name="docs" description="Generate documentation">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="build/docs" packagenames="com.example" defaultexcludes="no" author="true" version="true" use="true" windowtitle="MyApp API"/>
  </targets>
  <targets xmi:id="init" name="init" description="Initialize build directories">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/docs"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="all" name="all" description="Run all targets">
    <tasks xsi:type="Ant:Copy" file="README.txt" todir="dist" overwrite="true" filtering="false" flatten="false" includeEmptyDirs="false"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyyMMdd-HHmmss" locale="en_US"/>
    </tasks>
  </targets>
</Ant:Project>