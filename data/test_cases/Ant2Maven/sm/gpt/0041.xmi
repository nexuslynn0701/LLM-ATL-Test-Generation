<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build and package a small library"
    default="buildTarget">

  <targets xmi:id="prepareTarget" name="prepare" description="Create and clean build directories">
    <tasks xsi:type="Ant:Mkdir" dir="build"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Delete" dir="build/tmp" verbose="true" quiet="false" failonerror="false" includeEmptyDirs="true"/>
  </targets>

  <targets xmi:id="buildTarget" name="build" description="Compile sources, package jar, and cleanup">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/library-1.0.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/classes"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="false"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>