<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiPhaseBuild"
    basedir="."
    description="Project with separate compile, package, and clean targets."
    default="t_compile">

  <!-- Default compile target -->
  <targets xmi:id="t_compile" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
  </targets>

  <!-- Packaging target with jar creation -->
  <targets xmi:id="t_package" name="package" description="Create application JAR">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/multiphase-build.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Clean target removing build artifacts -->
  <targets xmi:id="t_clean" name="clean" description="Remove build outputs">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes="**/.git/**"
           defaultexcludes="true"/>
    <tasks xsi:type="Ant:Delete"
           dir="dist"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           defaultexcludes="true"/>
  </targets>
</Ant:Project>