<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiPhaseBuild"
    basedir="."
    description="Build, test, package and clean phases"
    default="buildTarget">

  <targets xmi:id="buildTarget" name="build" description="Compile the main sources">
    <tasks xsi:type="Ant:Mkdir" dir="out/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="out/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
  </targets>

  <targets xmi:id="testTarget" name="test" description="Compile test sources">
    <tasks xsi:type="Ant:Mkdir" dir="out/test-classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="out/test-classes"
           debug="false"
           fork="false"
           optimize="false"
           deprecation="false"/>
  </targets>

  <targets xmi:id="packageTarget" name="package" description="Create application jar">
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/multiphase-app.jar"
           basedir="out/classes"
           compress="true"
           encoding="UTF-8"/>
  </targets>

  <targets xmi:id="cleanTarget" name="clean" description="Remove generated artifacts">
    <tasks xsi:type="Ant:Delete"
           dir="out"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           defaultexcludes="true"/>
    <tasks xsi:type="Ant:Delete"
           file="dist/multiphase-app.jar"
           verbose="true"
           quiet="false"
           failonerror="false"/>
  </targets>

</Ant:Project>