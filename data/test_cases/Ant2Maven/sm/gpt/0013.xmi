<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject13"
    basedir="."
    description="Project with separate compile and package targets"
    default="tg_compile">
  <targets xmi:id="tg_compile" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" deprecation="true"/>
  </targets>
  <targets xmi:id="tg_package" name="package" description="Create application jar">
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample-app.jar" basedir="build/classes" compress="true"/>
    <tasks xsi:type="Ant:Delete" dir="build/temp" failonerror="false" includeEmptyDirs="true"/>
  </targets>
</Ant:Project>