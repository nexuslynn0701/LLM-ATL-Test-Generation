<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="WebShop"
    basedir="."
    description="Build, test, and package a small webshop application"
    default="compileTarget">

  <targets xmi:id="prepareTarget" name="prepare" description="Create build directories and clean old artifacts">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Delete" dir="build/tmp" quiet="true" includeEmptyDirs="true"/>
  </targets>

  <targets xmi:id="compileTarget" name="compile" description="Compile main sources">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           optimize="false"
           deprecation="true"/>
  </targets>

  <targets xmi:id="testTarget" name="test" description="Compile and execute tests if any">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="build/test-classes"
           debug="true"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/test-tmp"
           verbose="true"
           defaultexcludes="true"/>
  </targets>

  <targets xmi:id="packageTarget" name="package" description="Create distribution jar">
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/webshop.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"/>
  </targets>

</Ant:Project>