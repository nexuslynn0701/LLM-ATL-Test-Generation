<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="WebAppBuild"
    basedir="."
    description="Build and package a simple web application."
    default="buildMain">

  <!-- Properties: different subclasses to exercise various rules -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="env."/>

  <!-- A standalone task definition (not referenced by any task) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- First target: main build target with several file-related tasks -->
  <targets xmi:id="buildMain" name="build-main" description="Compile sources and package jar.">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/webapp-main.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Second target: clean target with delete and mkdir -->
  <targets xmi:id="cleanBuild" name="clean-build" description="Clean and recreate output directories.">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.class"
           includesfile="config/clean-includes.txt"
           excludes="**/keep/**"
           excludesfile="config/clean-excludes.txt"
           defaultexcludes="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="build"/>
  </targets>

  <!-- Third target: documentation generation -->
  <targets xmi:id="generateDocs" name="generate-docs" description="Generate project Javadoc.">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.webapp.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="WebApp API Documentation"/>
  </targets>

</Ant:Project>