<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build, package and clean a small library"
    default="compileTarget">

  <!-- Default target: compiles sources -->
  <targets xmi:id="compileTarget" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" deprecation="true"/>
  </targets>

  <!-- Secondary target: creates jar and cleans temp files -->
  <targets xmi:id="packageTarget" name="package" description="Create jar and cleanup">
    <tasks xsi:type="Ant:Jar" jarfile="dist/library.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="true" failonerror="false" includeEmptyDirs="true"/>
  </targets>

</Ant:Project>