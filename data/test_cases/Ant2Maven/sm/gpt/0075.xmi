<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="CompositeBuild"
    basedir="."
    description="Project with multiple targets and various predefined tasks"
    default="buildTarget">

  <!-- Target used as project default -->
  <targets xmi:id="buildTarget" name="build" description="Compile sources and build jar">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/composite-build.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Additional target to generate documentation -->
  <targets xmi:id="docTarget" name="doc" description="Generate project Javadoc">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="CompositeBuild API"/>
  </targets>

  <!-- Additional target to clean build artifacts -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean generated artifacts">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes=""
           includesfile=""
           excludesfile=""
           defaultexcludes="true"/>
  </targets>

</Ant:Project>