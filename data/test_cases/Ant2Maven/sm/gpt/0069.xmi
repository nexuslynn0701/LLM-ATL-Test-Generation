<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build and test a sample library"
    default="compileTarget">

  <targets xmi:id="compileTarget" name="compile" description="Compile main sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/library.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"/>
  </targets>

  <targets xmi:id="testTarget" name="test" description="Prepare and clean test output">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-output"/>
    <tasks xsi:type="Ant:Copy"
           todir="build/test-output"
           overwrite="true"
           includeEmptyDirs="false"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           excludes="**/keep/**"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>