<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntProject0043"
    basedir="."
    description="Project with multiple targets using compile, documentation, archive and file tasks"
    default="build-main">

  <!-- Default build target: compile sources, generate Javadoc, package into JAR -->
  <targets xmi:id="build-main" name="build-main" description="Compile, document and package the main code">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/javadoc"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" deprecation="true"/>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/javadoc"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="Sample Project API"/>
    <tasks xsi:type="Ant:Jar" jarfile="build/lib/sample-main.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>

  <!-- Additional target for cleaning build artifacts -->
  <targets xmi:id="clean-all" name="clean-all" description="Clean all generated files">
    <tasks xsi:type="Ant:Delete" dir="build" includeEmptyDirs="true" verbose="true" failonerror="true"/>
  </targets>

  <!-- Additional target for building tests separately -->
  <targets xmi:id="build-tests" name="build-tests" description="Compile and package test sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="build/test-classes" debug="false" optimize="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="build/lib/sample-tests.jar" basedir="build/test-classes" compress="false"/>
  </targets>

</Ant:Project>