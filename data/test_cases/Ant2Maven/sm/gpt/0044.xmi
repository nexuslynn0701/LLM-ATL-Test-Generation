<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build, test and package a small library"
    default="build-main">

  <!-- Default build target -->
  <targets xmi:id="build-main" name="build-main" description="Compile sources and create jar">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/library-main.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Separate test target -->
  <targets xmi:id="run-tests" name="run-tests" description="Run tests and clean temp files">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-output"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="build/test-output"
           debug="true"
           fork="false"
           optimize="false"
           deprecation="false"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           includesfile="config/delete-includes.txt"
           excludes="**/keep/**"
           excludesfile="config/delete-excludes.txt"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>