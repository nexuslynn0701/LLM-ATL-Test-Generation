<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryManager"
    basedir="."
    description="Build and package a simple library project"
    default="buildTarget">

  <!-- Default build target -->
  <targets xmi:id="buildTarget" name="build" description="Compile and jar the sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/library-manager.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Auxiliary cleanup target (non-default) -->
  <targets xmi:id="cleanTarget" name="clean" description="Remove build outputs">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes="**/.git/**"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>