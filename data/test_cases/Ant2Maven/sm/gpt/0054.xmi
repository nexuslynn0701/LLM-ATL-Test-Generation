<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntProject0054"
    basedir="."
    description="Ant build with multiple targets and file tasks"
    default="t_compile">
  <targets xmi:id="t_compile" name="compile" description="Compile source code">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes"/>
  </targets>
  <targets xmi:id="t_package" name="package" description="Create distribution archive">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app-0054.jar" basedir="build/classes"/>
  </targets>
  <targets xmi:id="t_cleanup" name="cleanup" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="false"/>
    <tasks xsi:type="Ant:Delete" dir="dist" includeEmptyDirs="true" defaultexcludes="true"/>
  </targets>
</Ant:Project>