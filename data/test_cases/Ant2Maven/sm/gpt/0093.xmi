<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Project exercising multiple predefined Ant tasks"
    default="build_main">

  <!-- Properties of different concrete kinds -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="test.src.dir" value="src/test/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="envPrefix"/>

  <!-- Standalone task definition (not referenced by any task) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Target used as default -->
  <targets xmi:id="build_main" name="build.main" description="Compile, jar and prepare distribution">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/dist"/>

    <!-- Compile main sources with simple includes/excludes -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="false">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**"/>
    </tasks>

    <!-- Package compiled classes into a jar -->
    <tasks xsi:type="Ant:Jar" jarfile="build/dist/app-main.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>

    <!-- Generate project documentation -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="ComplexBuild API"/>
  </targets>

  <!-- Additional target to exercise Delete and another Javac -->
  <targets xmi:id="clean_and_test" name="clean-and-test" description="Clean build outputs and compile tests" ifCondition="runTests">
    <!-- Clean build and dist directories -->
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" defaultexcludes="true"/>
    <tasks xsi:type="Ant:Delete" dir="build/dist" quiet="true" includeEmptyDirs="true" excludes="**/.gitignore"/>

    <!-- Recreate needed directories -->
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>

    <!-- Compile test sources with different pattern configuration -->
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="build/test-classes" debug="true" fork="true">
      <inExcludes xsi:type="Ant:Includes" name="**/*Test.java" ifCondition="includeTests"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/integration/**" unless="skipIntegration"/>
    </tasks>
  </targets>

</Ant:Project>