<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Project exercising multiple predefined Ant tasks"
    default="target_compile">
  <targets xmi:id="target_compile" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="build/generated-sources"/>
  </targets>
  <targets xmi:id="target_package" name="package" description="Create application JAR">
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/ComplexBuild.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>
  <targets xmi:id="target_docs" name="docs" description="Generate API documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="ComplexBuild API Documentation"/>
  </targets>
  <targets xmi:id="target_cleanup" name="clean" description="Clean build output">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           includesfile="config/includes.txt"
           excludes="**/keep/**"
           excludesfile="config/excludes.txt"
           defaultexcludes="true"/>
  </targets>
  <targets xmi:id="target_prepare" name="prepare" description="Prepare distribution directory">
    <tasks xsi:type="Ant:Mkdir"
           dir="dist"/>
    <tasks xsi:type="Ant:Copy"
           file="README.md"
           presservelastmodified="true"
           tofile="dist/README.txt"
           todir="dist"
           overwrite="true"
           filtering="false"
           flatten="false"
           includeEmptyDirs="false"/>
  </targets>
</Ant:Project>