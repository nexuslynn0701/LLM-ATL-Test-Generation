<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build and package a small library with tests"
    default="coreBuild">

  <!-- core build target: default -->
  <targets xmi:id="coreBuild" name="coreBuild" description="Compile main sources and create jar">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="on"
           fork="false"
           optimize="off"
           deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/library-core.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- test compilation and docs generation -->
  <targets xmi:id="testAndDocs" name="testAndDocs" description="Compile tests and generate javadoc">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="build/test-classes"
           debug="on"
           fork="false"
           optimize="off"
           deprecation="false"/>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.library.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="Library API Documentation"/>
  </targets>

  <!-- cleanup target -->
  <targets xmi:id="cleanAll" name="cleanAll" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           includesfile=""
           excludes=""
           excludesfile=""
           defaultexcludes="true"/>
  </targets>

</Ant:Project>