<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Project with multiple targets and diverse predefined tasks"
    default="build-main">

  <targets xmi:id="build-main" name="build-main" description="Compile sources and create main jar">
    <tasks xsi:type="Ant:Mkdir">
      <target href="#build-main"/>
    </tasks>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="true">
      <target href="#build-main"/>
    </tasks>
    <tasks xsi:type="Ant:Jar" jarfile="dist/main-app.jar" basedir="build/classes" compress="true" encoding="UTF-8">
      <target href="#build-main"/>
    </tasks>
  </targets>

  <targets xmi:id="build-doc" name="build-doc" description="Generate API documentation">
    <tasks xsi:type="Ant:Mkdir" >
      <target href="#build-doc"/>
    </tasks>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="ComplexBuild API">
      <target href="#build-doc"/>
    </tasks>
  </targets>

  <targets xmi:id="clean-all" name="clean-all" description="Clean build outputs">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" defaultexcludes="true">
      <target href="#clean-all"/>
    </tasks>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true">
      <target href="#clean-all"/>
    </tasks>
  </targets>

</Ant:Project>