<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Project with multiple targets and diverse predefined tasks"
    default="buildTarget">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/classes"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="dist"/>
  <properties xsi:type="Ant:PropertyEnv" environment="env."/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>

  <!-- Task definition (unreferenced as required) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target: build -->
  <targets xmi:id="buildTarget" name="build" description="Compile and package">
    <!-- Ensure destination directories exist -->
    <tasks xsi:type="Ant:Mkdir">
      <target xsi:nil="true"/>
      <dir>build/classes</dir>
    </tasks>

    <!-- Compile Java sources -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="false">
      <target xsi:nil="true"/>
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**"/>
    </tasks>

    <!-- Create JAR -->
    <tasks xsi:type="Ant:Jar" jarfile="dist/complex-build.jar" basedir="build/classes" compress="true" encoding="UTF-8">
      <target xsi:nil="true"/>
    </tasks>
  </targets>

  <!-- Test target -->
  <targets xmi:id="testTarget" name="test" description="Run tests">
    <!-- Create test output directory -->
    <tasks xsi:type="Ant:Mkdir">
      <target xsi:nil="true"/>
      <dir>build/test-results</dir>
    </tasks>

    <!-- Copy test resources with filtering and mapping -->
    <tasks xsi:type="Ant:Copy" filtering="true" overwrite="true" includeEmptyDirs="false" flatten="false">
      <target xsi:nil="true"/>
      <fileset dir="src/test/resources">
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="**/*"/>
        </patternset>
        <include name="**/*.properties"/>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="env" value="dev"/>
      </filterset>
      <mapper type="glob" from="*.properties" to="*.conf"/>
      <todir>build/test-resources</todir>
    </tasks>
  </targets>

  <!-- Clean target -->
  <targets xmi:id="cleanTarget" name="clean" description="Remove build artifacts">
    <!-- Delete build directory -->
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" defaultexcludes="true"/>
    <!-- Delete distribution directory -->
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" includes="**/*"/>
  </targets>

  <!-- Docs target -->
  <targets xmi:id="docsTarget" name="docs" description="Generate API documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="dist/docs/api"
           packagenames="com.example.**"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="ComplexBuild API">
      <target xsi:nil="true"/>
    </tasks>
  </targets>

  <!-- Timestamp target -->
  <targets xmi:id="timestampTarget" name="timestamp" description="Stamp build time">
    <tasks xsi:type="Ant:Tstamp">
      <target xsi:nil="true"/>
      <format property="build.timestamp" pattern="yyyy-MM-dd HH:mm:ss" offset="0" unit="hour" locale="en_US"/>
    </tasks>
  </targets>

</Ant:Project>