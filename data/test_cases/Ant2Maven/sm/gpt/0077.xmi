<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build and package a small library"
    default="buildMain">

  <!-- Optional properties of different concrete kinds -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/classes"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.dir" location="config"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="env."/>

  <!-- Optional, unused task definition -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target with multiple different tasks -->
  <targets xmi:id="buildMain" name="build-main" description="Compile sources, create output dirs, and package jar">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           deprecation="true"
           fork="false"
           optimize="false"/>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="Example Library API"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/library.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Secondary target with cleanup and additional directory creation -->
  <targets xmi:id="prepareAndClean" name="prepare-and-clean" description="Prepare distribution directory and clean temp files">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/temp"
           verbose="true"
           quiet="false"
           failonerror="false"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           excludes="**/keep/**"
           includesfile="config/delete-includes.txt"
           excludesfile="config/delete-excludes.txt"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>