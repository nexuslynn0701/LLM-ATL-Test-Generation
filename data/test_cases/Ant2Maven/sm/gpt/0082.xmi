<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryManager"
    basedir="."
    description="Build and package a simple library with optional docs"
    default="buildTarget">

  <targets xmi:id="buildTarget" name="build" description="Compile sources and create output directories">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" optimize="false"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/docs"/>
  </targets>

  <targets xmi:id="packageTarget" name="package" description="Create a distributable JAR">
    <tasks xsi:type="Ant:Jar" jarfile="dist/library-manager.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>

  <targets xmi:id="cleanTarget" name="clean" description="Remove generated artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" includeEmptyDirs="true" defaultexcludes="true"/>
    <tasks xsi:type="Ant:Delete" file="dist/library-manager.jar" quiet="true" failonerror="false"/>
  </targets>

  <targets xmi:id="docsTarget" name="javadocs" description="Generate API documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.library.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Library Manager API"/>
  </targets>

</Ant:Project>