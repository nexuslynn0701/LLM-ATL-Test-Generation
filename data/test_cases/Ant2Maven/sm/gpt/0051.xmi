<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build and package the library module"
    default="buildTarget">

  <!-- Default build target -->
  <targets xmi:id="buildTarget" name="build" description="Compile, document and package the library">
    <!-- Create binary output directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <!-- Compile Java sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true">
      <!-- Include all Java sources in the main tree -->
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <!-- Exclude generated sources -->
      <inExcludes xsi:type="Ant:Excludes" name="**/generated/**"/>
    </tasks>
    <!-- Generate Javadoc -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/javadoc"
           packagenames="com.example.lib.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Example Library API"/>
    <!-- Package compiled classes into a jar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/example-lib.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Separate cleanup target -->
  <targets xmi:id="cleanTarget" name="clean" description="Remove build and dist artifacts">
    <!-- Delete build directory -->
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           defaultexcludes="true"/>
    <!-- Delete distribution jar directory -->
    <tasks xsi:type="Ant:Delete"
           dir="dist"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>