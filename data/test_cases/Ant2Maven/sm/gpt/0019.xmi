<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Project with multiple targets and various file-related tasks"
    default="t_build_main">

  <!-- Default build target -->
  <targets xmi:id="t_build_main" name="build-main" description="Compile, package and prepare directories">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/complexbuild-main.jar" basedir="build/classes" compress="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist/docs"/>
  </targets>

  <!-- Auxiliary clean target -->
  <targets xmi:id="t_clean" name="clean" description="Clean build outputs">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" includeEmptyDirs="true" defaultexcludes="false"/>
  </targets>

  <!-- Test preparation target -->
  <targets xmi:id="t_tests" name="prepare-tests" description="Prepare test structure">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="build/test-classes" debug="true" deprecation="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/complexbuild-tests.jar" basedir="build/test-classes" encoding="UTF-8"/>
  </targets>

</Ant:Project>