<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiStageBuild"
    basedir="."
    description="Project with separate build and packaging targets"
    default="buildTarget">

  <!-- Optional properties exercising different concrete Property types -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="env."/>

  <!-- Standalone task definition (not referenced by any task) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target: build class files -->
  <targets xmi:id="buildTarget" name="build" description="Compile main sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes"/>
  </targets>

  <!-- Secondary target: package compiled classes -->
  <targets xmi:id="packageTarget" name="package" description="Create application jar">
    <tasks xsi:type="Ant:Jar" jarfile="dist/app-1.0.jar" basedir="build/classes" compress="true"/>
  </targets>

  <!-- Cleanup target: remove build artifacts -->
  <targets xmi:id="cleanTarget" name="clean" description="Remove build outputs">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" includeEmptyDirs="true"/>
  </targets>

</Ant:Project>