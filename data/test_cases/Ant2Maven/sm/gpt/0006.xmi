<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiStageBuild"
    basedir="."
    description="Project with separate compile, test, and package targets"
    default="pkgTarget">

  <targets xmi:id="compileTarget" name="compile" description="Compile main sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
  </targets>

  <targets xmi:id="testTarget" name="test" description="Compile test sources and prepare tests">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="build/test-classes"
           debug="true"
           fork="false"
           optimize="false"
           deprecation="false"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/tmp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           excludes="**/*.keep"
           defaultexcludes="true"/>
  </targets>

  <targets xmi:id="pkgTarget" name="package" description="Create application JAR">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/multistage-app.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="MANIFEST.MF"/>
  </targets>

</Ant:Project>