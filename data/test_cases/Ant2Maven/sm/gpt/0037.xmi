<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuildProject"
    basedir="."
    description="Project exercising multiple predefined Ant tasks"
    default="compileTarget">

  <targets xmi:id="compileTarget" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes">
      <target xmi:idref="compileTarget"/>
    </tasks>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" optimize="false" deprecation="true">
      <target xmi:idref="compileTarget"/>
    </tasks>
  </targets>

  <targets xmi:id="docsTarget" name="javadoc" description="Generate API documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="ComplexBuildProject API">
      <target xmi:idref="docsTarget"/>
    </tasks>
  </targets>

  <targets xmi:id="packageTarget" name="package" description="Create distribution JAR">
    <tasks xsi:type="Ant:Jar" jarfile="dist/complexbuild.jar" basedir="build/classes" compress="true" encoding="UTF-8">
      <target xmi:idref="packageTarget"/>
    </tasks>
  </targets>

  <targets xmi:id="cleanupTarget" name="clean" description="Clean build output">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" defaultexcludes="yes">
      <target xmi:idref="cleanupTarget"/>
    </tasks>
  </targets>

</Ant:Project>