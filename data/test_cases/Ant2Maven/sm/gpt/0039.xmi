<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiStageBuild"
    basedir="."
    description="Project with separate build and packaging targets"
    default="buildTarget">

  <targets xmi:id="buildTarget" name="build" description="Compile sources and prepare classes">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/tmp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="false"
           includes="**/*.bak"
           excludes="**/keep/**"
           defaultexcludes="true"/>
  </targets>

  <targets xmi:id="packageTarget" name="package" description="Create distribution jar">
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/multistage-build.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Copy"
           file="README.md"
           presservelastmodified="true"
           tofile="dist/README.txt"
           todir="dist"
           overwrite="true"
           filtering="false"
           flatten="false"
           includeEmptyDirs="false"/>
  </targets>

</Ant:Project>