<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiStageBuild"
    basedir="."
    description="Build with compile, test, and packaging steps"
    default="compileTarget">

  <targets xmi:id="compileTarget" name="compile" description="Compile main sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           deprecation="false"
           fork="false"
           optimize="true"/>
  </targets>

  <targets xmi:id="testTarget" name="test" description="Run tests and clean temp">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="build/test-classes"
           debug="true"
           deprecation="true"
           fork="false"
           optimize="false"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/tmp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           excludes="**/keep/**"/>
  </targets>

  <targets xmi:id="packageTarget" name="package" description="Create distribution archive">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/multistage-app.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Copy"
           file="README.md"
           todir="dist"
           overwrite="true"
           includeEmptyDirs="false"
           flatten="false"
           filtering="false"
           presservelastmodified="true"/>
  </targets>

</Ant:Project>