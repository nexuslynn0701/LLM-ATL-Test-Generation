<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Project with multiple targets exercising various predefined tasks"
    default="compileTarget">

  <!-- Task definition not referenced by any task -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target: compilation and documentation -->
  <targets xmi:id="compileTarget" name="compile" description="Compile Java sources and generate Javadoc">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="ComplexBuild API"/>
  </targets>

  <!-- Secondary target: packaging -->
  <targets xmi:id="packageTarget" name="package" description="Create application JAR">
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/complexbuild-app.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Secondary target: filesystem operations -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Mkdir"
           dir="build/tmp"/>
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.class"
           includesfile="config/includes.txt"
           excludes="**/keep/**"
           excludesfile="config/excludes.txt"
           defaultexcludes="yes"/>
  </targets>

</Ant:Project>