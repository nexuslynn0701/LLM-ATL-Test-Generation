<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiStageBuild"
    basedir="."
    description="Project with compile, test, and packaging stages."
    default="compileTarget">

  <!-- Default compile target -->
  <targets xmi:id="compileTarget" name="compile" description="Compile main sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
  </targets>

  <!-- Separate test target -->
  <targets xmi:id="testTarget" name="test" description="Compile and execute tests">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="build/test-classes"
           debug="true"
           fork="false"
           optimize="false"
           deprecation="true"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"/>
  </targets>

  <!-- Packaging / cleanup target -->
  <targets xmi:id="packageTarget" name="package" description="Create distribution and clean temp files">
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/multi-stage-build.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Delete"
           file="build/old-artifact.jar"
           verbose="true"
           quiet="false"
           failonerror="false"
           includes="**/*.tmp"
           excludes="**/keep/**"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>