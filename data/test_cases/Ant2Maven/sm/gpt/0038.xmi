<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiStageBuild"
    basedir="."
    description="Project with multiple targets and various predefined file and archive tasks"
    default="build-main">
  <!-- Default build target -->
  <targets xmi:id="build-main" name="build-main" description="Compile, package and clean intermediate files">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/main-app.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Copy"
           file="config/app.properties"
           todir="dist/config"
           overwrite="true"
           filtering="false"
           flatten="false"
           includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="dist/logs"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/tmp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           excludes="**/keep/**"
           defaultexcludes="true"/>
  </targets>

  <!-- Auxiliary target: build only the documentation -->
  <targets xmi:id="build-docs" name="build-docs" description="Generate API documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="dist/javadoc"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Example Application API"/>
  </targets>

  <!-- Auxiliary target: prepare distribution directories -->
  <targets xmi:id="prepare-dist" name="prepare-dist" description="Prepare distribution structure">
    <tasks xsi:type="Ant:Mkdir"
           dir="dist"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="build/tmp"/>
  </targets>

  <!-- Standalone task definition not referenced by any task -->
  <taskdef name="customTask" classname="com.example.ant.CustomTaskImplementation"/>
</Ant:Project>