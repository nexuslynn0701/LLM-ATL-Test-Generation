<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiStageBuild"
    basedir="."
    description="Project with multiple targets and various predefined file and archive tasks."
    default="build-main">

  <!-- Default target: compiles sources and creates main jar -->
  <targets xmi:id="build-main" name="build-main" description="Compile sources and package main artifact">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           optimize="false"
           deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/multistage-main.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"/>
  </targets>

  <!-- Secondary target: builds test jar and cleans intermediate dirs -->
  <targets xmi:id="build-test" name="build-test" description="Compile test sources and package test artifact">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="build/test-classes"
           debug="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/multistage-tests.jar"
           basedir="build/test-classes"
           compress="true"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/test-classes"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           excludes="**/*.keep"
           defaultexcludes="true"/>
  </targets>

  <!-- Cleanup target: remove all build and dist outputs -->
  <targets xmi:id="clean-all" name="clean-all" description="Remove all generated artifacts">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="false"
           includeEmptyDirs="true"
           includes="**/*"
           excludes="**/.git/**"
           defaultexcludes="true"/>
    <tasks xsi:type="Ant:Delete"
           dir="dist"
           verbose="false"
           quiet="true"
           failonerror="false"
           includeEmptyDirs="true"
           includes="**/*"
           defaultexcludes="false"/>
  </targets>

</Ant:Project>