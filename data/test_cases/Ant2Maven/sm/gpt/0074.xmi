<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Build, test and package a Java project"
    default="compileTarget">

  <!-- Properties using different Property subclasses -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="env." />

  <!-- A standalone task definition (not referenced by tasks) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target with compile-related tasks -->
  <targets xmi:id="compileTarget" name="compile" description="Compile project sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
  </targets>

  <!-- Additional target with documentation and packaging tasks -->
  <targets xmi:id="packageTarget" name="package" description="Create jar and javadoc">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="Example API"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/example-app.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Cleanup target using file-oriented tasks -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean build output">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes=""
           includesfile=""
           excludesfile=""
           defaultexcludes="true"/>
    <tasks xsi:type="Ant:Delete"
           file="dist/example-app.jar"
           verbose="false"
           quiet="true"
           failonerror="false"
           includeEmptyDirs="false"
           includes=""
           includesfile=""
           excludes=""
           excludesfile=""
           defaultexcludes="false"/>
  </targets>

</Ant:Project>