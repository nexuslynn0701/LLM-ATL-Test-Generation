<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="AntSampleProject0029"
    basedir="."
    description="Project exercising multiple predefined tasks without cross-references."
    default="build-main">

  <!-- Default target: build-main -->
  <targets xmi:id="build-main" name="build-main" description="Compile sources and package into a jar">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/app-main.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"/>
  </targets>

  <!-- Additional target: docs -->
  <targets xmi:id="generate-docs" name="generate-docs" description="Generate Javadoc documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.app.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Example Application API"/>
  </targets>

  <!-- Additional target: clean -->
  <targets xmi:id="clean-all" name="clean-all" description="Clean all build outputs">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           defaultexcludes="false"/>
    <tasks xsi:type="Ant:Delete"
           dir="dist"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           defaullexcludes="false"/>
  </targets>

</Ant:Project>