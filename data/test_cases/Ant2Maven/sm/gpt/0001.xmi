<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntProject"
    basedir="."
    description="Ant project with multiple targets and varied tasks"
    default="buildTarget">

  <!-- Default build target -->
  <targets xmi:id="buildTarget" name="build" description="Compile sources and package jar">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample-app.jar" basedir="build/classes" compress="true"/>
  </targets>

  <!-- Separate clean target -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" includeEmptyDirs="true" verbose="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" quiet="true"/>
  </targets>

  <!-- Documentation target -->
  <targets xmi:id="docTarget" name="javadoc" description="Generate API documentation">
    <tasks xsi:type="Ant:Mkdir" dir="build/docs/api"/>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="Sample Application API"/>
  </targets>

</Ant:Project>