<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiStageBuild"
    basedir="."
    description="Project with separate compile, test, and dist targets"
    default="compileTarget">

  <targets xmi:id="compileTarget" name="compile" description="Compile main sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
  </targets>

  <targets xmi:id="testTarget" name="test" description="Prepare and run tests">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="build/test-classes"
           debug="true"
           fork="false"
           optimize="false"
           deprecation="false"/>
  </targets>

  <targets xmi:id="distTarget" name="dist" description="Package distribution">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/multistage-build.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Copy"
           file="README.md"
           tofile="dist/README.md"
           overwrite="true"
           filtering="false"
           flatten="false"
           includeEmptyDirs="false"/>
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes="**/.git/**"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>