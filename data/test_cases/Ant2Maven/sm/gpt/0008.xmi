<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build and test Java library"
    default="buildTarget">

  <targets xmi:id="buildTarget" name="build" description="Compile and package">
    <tasks xsi:type="Ant:Mkdir" dir="out/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="out/classes"/>
    <tasks xsi:type="Ant:Jar" jarfile="out/artifacts/library.jar" basedir="out/classes" compress="true"/>
  </targets>

  <targets xmi:id="cleanTarget" name="clean" description="Clean generated files">
    <tasks xsi:type="Ant:Delete" dir="out" verbose="true" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="out"/>
  </targets>

</Ant:Project>