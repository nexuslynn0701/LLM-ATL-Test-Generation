<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiPhaseBuild"
    basedir="."
    description="Project with separate compile, test, and packaging phases."
    default="compileTarget">

  <!-- Default compile target -->
  <targets xmi:id="compileTarget" name="compile" description="Compile main sources.">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" optimize="false"/>
  </targets>

  <!-- Test target -->
  <targets xmi:id="testTarget" name="test" description="Prepare and clean test workspace.">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-results"/>
    <tasks xsi:type="Ant:Delete" dir="build/tmp" includeEmptyDirs="true" verbose="true"/>
  </targets>

  <!-- Packaging target -->
  <targets xmi:id="packageTarget" name="package" description="Create application archive.">
    <tasks xsi:type="Ant:Jar" jarfile="dist/multiphase-app.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>

</Ant:Project>