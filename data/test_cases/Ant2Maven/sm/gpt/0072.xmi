<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiPhaseBuild"
    basedir="."
    description="Build with separate compile, docs, packaging, and cleanup phases."
    default="compilePhase">

  <!-- Default compile target -->
  <targets xmi:id="compilePhase" name="compilePhase" description="Compile project sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
  </targets>

  <!-- Documentation generation target -->
  <targets xmi:id="docsPhase" name="docsPhase" description="Generate Javadoc API documentation">
    <tasks xsi:type="Ant:Mkdir" dir="build/docs"/>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="MultiPhaseBuild API"/>
  </targets>

  <!-- Packaging target -->
  <targets xmi:id="packagePhase" name="packagePhase" description="Create application JAR">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/multiphase-build.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Cleanup target -->
  <targets xmi:id="cleanupPhase" name="cleanupPhase" description="Remove generated artifacts">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           includesfile=""
           excludes="**/.git/**"
           excludesfile=""
           defaultexcludes="true"/>
    <tasks xsi:type="Ant:Delete"
           file="dist/multiphase-build.jar"
           verbose="true"
           quiet="false"
           failonerror="false"
           includeEmptyDirs="false"
           includes=""
           includesfile=""
           excludes=""
           excludesfile=""
           defaultexcludes="false"/>
  </targets>

</Ant:Project>