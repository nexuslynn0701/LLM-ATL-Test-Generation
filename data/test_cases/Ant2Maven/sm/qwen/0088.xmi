<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildSystem"
    default="build-all"
    basedir="."
    description="Comprehensive build script for testing ATL transformation">
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="source"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="output"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="env"/>
  <targets xmi:id="init" name="init" description="Initialize directories">
    <tasks xsi:type="Ant:Mkdir" dir="${build.dir}"/>
    <tasks xsi:type="Ant:Mkdir" dir="${build.dir}/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="${build.dir}/docs"/>
    <tasks xsi:type="Ant:Mkdir" dir="${build.dir}/dist"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Javac" srcdir="${src.dir}" destdir="${build.dir}/classes" debug="true" deprecation="true"/>
  </targets>
  <targets xmi:id="doc" name="doc" description="Generate Javadoc">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="${src.dir}"
        destdir="${build.dir}/docs"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="Example API"/>
  </targets>
  <targets xmi:id="package" name="package" description="Create JAR archive">
    <tasks xsi:type="Ant:Jar"
        jarfile="${build.dir}/dist/app.jar"
        basedir="${build.dir}/classes"
        compress="true"
        manifest="manifest.mf"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="${build.dir}" includeEmptyDirs="true"/>
  </targets>
  <targets xmi:id="build-all" name="build-all" description="Full build cycle">
    <tasks xsi:type="Ant:Copy"
        todir="${build.dir}/resources"
        overwrite="true"
        filtering="true">
      <fileset dir="resources">
        <include name="**/*.properties"/>
        <exclude name="**/temp/*"/>
      </fileset>
      <filterset starttoken="@" endtoken="@">
        <filter token="VERSION" value="1.0.0"/>
        <filtersfile file="filters.txt"/>
      </filterset>
      <mapper type="glob" from="*.template" to="*"/>
    </tasks>
  </targets>
</Ant:Project>