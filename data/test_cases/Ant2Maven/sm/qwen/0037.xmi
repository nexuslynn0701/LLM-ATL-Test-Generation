<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildSystem"
    default="build"
    basedir="."
    description="Comprehensive build script for testing ATL transformation">
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/docs"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="build" name="build" description="Compile and package application">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="target/classes" debug="true" fork="true"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="target/docs" packagenames="com.example.*" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="My API"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="target/classes" compress="true" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Copy" todir="backup/src" flatten="false" includeEmptyDirs="true">
      <fileset dir="src">
        <include name="**/*.java"/>
        <exclude name="**/test/**"/>
      </fileset>
    </tasks>
    <tasks xsi:type="Ant:Delete" dir="temp" verbose="true" includeEmptyDirs="true" defaultexcludes="false"/>
  </targets>
</Ant:Project>