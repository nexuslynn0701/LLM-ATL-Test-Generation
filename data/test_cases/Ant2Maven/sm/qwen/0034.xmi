<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildSystem"
    default="build"
    basedir="."
    description="Comprehensive build script for testing ATL transformation">
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/docs"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/dist"/>
  </targets>
  <targets xmi:id="build" name="build" description="Compile and package application">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" fork="true"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src/main/java" destdir="target/docs" packagenames="com.example.*" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="My API"/>
    <tasks xsi:type="Ant:Jar" jarfile="target/dist/app.jar" basedir="target/classes" compress="true" manifest="src/main/resources/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Copy" todir="target/staging">
      <fileset dir="src/main/resources">
        <include name="**/*.properties"/>
        <exclude name="**/secret.properties"/>
      </fileset>
    </tasks>
    <tasks xsi:type="Ant:Delete" dir="temp" quiet="true" includeEmptyDirs="false"/>
  </targets>
  <properties>
    <PropertyValue name="build.version" value="1.0.0"/>
    <PropertyLocation name="config.dir" location="conf"/>
    <PropertyFile file="build.properties"/>
    <PropertyEnv environment="BUILD_ENV"/>
  </properties>
</Ant:Project>