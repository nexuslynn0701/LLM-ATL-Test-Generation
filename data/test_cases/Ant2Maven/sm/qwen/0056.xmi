<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildSystem"
    default="build"
    basedir=".">
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/docs"/>
  </targets>
  <targets xmi:id="build" name="build">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="target/classes" debug="true"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="target/docs" packagenames="com.example.*" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="My API Docs"/>
    <tasks xsi:type="Ant:Jar" jarfile="target/app.jar" basedir="target/classes" compress="true" manifest="MANIFEST.MF"/>
  </targets>
</Ant:Project>