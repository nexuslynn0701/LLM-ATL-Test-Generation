<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildSystem"
    default="build-all"
    basedir=".">
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/docs"/>
  </targets>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" deprecation="true"/>
  </targets>
  <targets xmi:id="doc" name="doc">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src/main/java"
        destdir="target/docs"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="My API Docs"/>
  </targets>
  <targets xmi:id="package" name="package">
    <tasks xsi:type="Ant:Jar"
        jarfile="target/app.jar"
        basedir="target/classes"
        compress="true"
        manifest="src/main/resources/MANIFEST.MF"/>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="target" includeEmptyDirs="true"/>
  </targets>
  <targets xmi:id="build-all" name="build-all">
    <tasks xsi:type="Ant:Copy"
        todir="target/resources"
        overwrite="true"
        filtering="true">
      <fileset dir="src/main/resources">
        <include name="**/*.properties"/>
        <exclude name="**/secret.*"/>
      </fileset>
      <filterset starttoken="@" endtoken="@">
        <filter token="VERSION" value="1.0.0"/>
        <filter token="BUILD_DATE" value="2024-06-15"/>
      </filterset>
    </tasks>
  </targets>
</Ant:Project>