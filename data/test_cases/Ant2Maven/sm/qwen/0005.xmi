<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildSystem"
    default="build"
    basedir="."
    description="Comprehensive build script for testing ATL transformation">
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/docs"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/dist"/>
  </targets>
  <targets xmi:id="build" name="build" description="Compile and package application">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="target/classes" debug="true" deprecation="true"/>
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="target/docs"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="My API Documentation"/>
    <tasks xsi:type="Ant:Jar"
        jarfile="target/dist/app.jar"
        basedir="target/classes"
        compress="true"
        manifest="META-INF/MANIFEST.MF"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Remove all generated files">
    <tasks xsi:type="Ant:Delete" dir="target" includeEmptyDirs="true"/>
  </targets>
</Ant:Project>