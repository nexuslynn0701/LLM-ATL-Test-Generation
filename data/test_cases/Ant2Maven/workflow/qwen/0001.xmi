<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComprehensiveBuild"
    basedir="."
    description="Full-featured build with multiple tasks and properties"
    default="build">
  <properties xsi:type="Ant:PropertyValue" name="src.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="target"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="mytask" classname="com.example.MyTask"/>
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyy-MM-dd HH:mm:ss"/>
    </tasks>
  </targets>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac"
        srcdir="src/main/java"
        destdir="target/classes"
        debug="true"
        fork="true">
      <classPath refid="compile.path">
        <pathElement path="lib/dep1.jar" location="lib"/>
        <fileset dir="lib">
          <include name="**/*.jar"/>
          <exclude name="**/*-test.jar"/>
        </fileset>
      </classPath>
    </tasks>
  </targets>
  <targets xmi:id="doc" name="doc">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src/main/java"
        destdir="target/docs"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="My API Docs"/>
  </targets>
  <targets xmi:id="package" name="package">
    <tasks xsi:type="Ant:Jar"
        jarfile="target/app.jar"
        basedir="target/classes"
        compress="true"
        manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Copy"
        todir="target/dist"
        filtering="true"
        flatten="false">
      <fileset dir="resources">
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="**/*.properties"/>
          <inexcludes xsi:type="Ant:Excludes" name="**/secret.properties"/>
        </patternset>
      </fileset>
      <filterset starttoken="@" endtoken="@">
        <filter token="version" value="1.0.0"/>
        <filtersfile file="filters.txt"/>
      </filterset>
    </tasks>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="target"/>
  </targets>
  <targets xmi:id="build" name="build"/>
</Ant:Project>