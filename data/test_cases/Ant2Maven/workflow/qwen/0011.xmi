<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="FullCoverageBuild"
    basedir="."
    description="Comprehensive build exercising multiple ATL rules"
    default="build-all">
  <properties xsi:type="Ant:PropertyValue" name="src.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="target"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customTask" classname="com.example.CustomTask"/>
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/dist"/>
  </targets>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac"
        srcdir="src/main/java"
        destdir="target/classes"
        debug="true"/>
  </targets>
  <targets xmi:id="package" name="package">
    <tasks xsi:type="Ant:Jar"
        jarfile="target/dist/app.jar"
        basedir="target/classes"/>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="target"/>
  </targets>
  <targets xmi:id="build-all" name="build-all">
    <tasks xsi:type="Ant:Copy"
        todir="target/resources"
        filtering="true">
      <fileset dir="src/main/resources">
        <include name="**/*.properties"/>
        <exclude name="**/*-dev.properties"/>
      </fileset>
      <filterset starttoken="@" endtoken="@">
        <filter token="VERSION" value="1.0.0"/>
        <filtersfile file="filters.txt"/>
      </filterset>
      <mapper type="glob" from="*.template" to="*"/>
    </tasks>
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src/main/java"
        destdir="target/docs"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="My API"/>
  </targets>
</Ant:Project>