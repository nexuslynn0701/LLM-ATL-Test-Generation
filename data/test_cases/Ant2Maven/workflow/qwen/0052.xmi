<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="FullBuild"
    basedir="."
    description="Comprehensive build with multiple tasks and properties"
    default="build">
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="mytask" classname="com.example.MyTask"/>
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="${build.dir}/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="${build.dir}/dist"/>
  </targets>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac"
        srcdir="${src.dir}"
        destdir="${build.dir}/classes"
        debug="true"
        fork="true"/>
  </targets>
  <targets xmi:id="doc" name="doc">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="${src.dir}"
        destdir="${build.dir}/docs"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="My API Documentation"/>
  </targets>
  <targets xmi:id="package" name="package">
    <tasks xsi:type="Ant:Jar"
        jarfile="${build.dir}/dist/app.jar"
        basedir="${build.dir}/classes"
        compress="true"
        manifest="MANIFEST.MF"/>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="${build.dir}"/>
  </targets>
  <targets xmi:id="build" name="build">
    <tasks xsi:type="Ant:Copy"
        todir="${build.dir}/resources"
        flatten="false"
        includeEmptyDirs="true"/>
  </targets>
</Ant:Project>