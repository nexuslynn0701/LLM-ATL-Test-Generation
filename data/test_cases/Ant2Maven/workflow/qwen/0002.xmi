<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="CoverageBuild"
    basedir="."
    default="run">
  <properties xsi:type="Ant:PropertyValue" name="main.class" value="com.example.Main"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="mytask" classname="com.example.MyTask"/>
  <path id="project.path">
    <pathElement path="lib/core.jar" location="lib"/>
    <fileset dir="resources">
      <include name="**/*.xml"/>
      <exclude name="**/*-test.xml"/>
      <includesfile name="includes.txt"/>
      <excludesfile name="excludes.txt"/>
    </fileset>
  </path>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Delete" dir="temp"/>
  </targets>
  <targets xmi:id="package" name="package">
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="classes"/>
    <tasks xsi:type="Ant:Copy" todir="backup">
      <fileset dir="dist">
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="**/*.jar"/>
          <inexcludes xsi:type="Ant:ExcludesFile" name="excludes-dist.txt"/>
        </patternset>
      </fileset>
      <filterset starttoken="@" endtoken="@">
        <filter token="VERSION" value="1.0.0"/>
        <filtersfile file="filters.properties"/>
      </filterset>
    </tasks>
  </targets>
  <targets xmi:id="run" name="run">
    <tasks xsi:type="Ant:Java" classname="com.example.Main" fork="true">
      <classPath refid="project.path"/>
    </tasks>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyy-MM-dd HH:mm:ss"/>
    </tasks>
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="docs"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="API Docs"/>
  </targets>
</Ant:Project>