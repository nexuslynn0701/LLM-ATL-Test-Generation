<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="FullLifecycleBuild"
    basedir="project-root"
    description="Demonstration Ant build covering compilation, packaging, and cleanup"
    default="build-all">
  <!-- Properties exercising all Property* rules -->
  <properties xsi:type="Ant:PropertyValue" name="source.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="build/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="BUILD_ENV"/>

  <!-- User-defined task definition (TaskDef rule) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target with multiple tasks -->
  <targets xmi:id="build-all" name="build-all" description="Compile, jar, and clean output">
    <!-- Compile task (Javac rule) -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false">
    </tasks>

    <!-- Documentation task (Javadoc rule) -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.project"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Project API Documentation">
    </tasks>

    <!-- Packaging task (Jar rule) -->
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/project-full.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF">
    </tasks>

    <!-- Directory creation task (Mkdir rule) -->
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/tmp"/>

    <!-- Cleanup task (Delete rule) -->
    <tasks xsi:type="Ant:Delete"
           dir="build/tmp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           excludes="**/keep/**"
           defaultexcludes="true">
    </tasks>

    <!-- Timestamp management task (Tstamp rule) -->
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp"
              pattern="yyyyMMdd-HHmmss"
              offset="0"
              unit="second"
              locale="en_US"/>
    </tasks>
  </targets>

  <!-- Secondary target with a different set of tasks -->
  <targets xmi:id="package-only" name="package-only" description="Package already-compiled classes">
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/project-binary.jar"
           basedir="build/classes"
           compress="true">
    </tasks>
    <tasks xsi:type="Ant:Mkdir" dir="reports"/>
    <tasks xsi:type="Ant:Delete" file="build/old-report.txt"/>
  </targets>
</Ant:Project>