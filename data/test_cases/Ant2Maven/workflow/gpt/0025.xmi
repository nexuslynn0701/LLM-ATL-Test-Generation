<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="project-root"
    description="Full build lifecycle: compile, package, and cleanup."
    default="buildAll">

  <!-- Properties exercising all Ant Property subtypes -->
  <properties xsi:type="Ant:PropertyValue" name="java.version" value="17"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="BUILD_ENV"/>

  <!-- User-defined task definition (not referenced by any task) -->
  <taskdef name="custom.task" classname="org.example.ant.CustomTask"/>

  <!-- Default target with multiple tasks -->
  <targets xmi:id="buildAll" name="buildAll">
    <tasks xsi:type="Ant:Mkdir" dir="target"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" optimize="true" deprecation="false">
      <!-- Local ClassPath with PathElement and FileSet to trigger path-related rules without external refs -->
      <classPath refid="">
        <pathElement path="libs/core.jar" location="libs"/>
        <fileset dir="libs">
          <patternset>
            <inexcludes xsi:type="Ant:Includes" name="**/*.jar"/>
            <inexcludes xsi:type="Ant:Excludes" name="**/*-tests.jar"/>
          </patternset>
        </fileset>
      </classPath>
    </tasks>
    <tasks xsi:type="Ant:Jar" jarfile="target/complex-build.jar" basedir="target/classes" compress="true"/>
  </targets>

  <!-- Additional target with documentation and file management tasks -->
  <targets xmi:id="docsAndCleanup" name="docsAndCleanup">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src/main/java"
        destdir="target/site/apidocs"
        packagenames="org.example.*"
        defaultexcludes="true"
        author="true"
        version="true"
        use="true"
        windowtitle="ComplexBuild API"/>
    <tasks xsi:type="Ant:Tstamp"/>
    <tasks xsi:type="Ant:Copy" todir="backup">
      <fileset dir="target">
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="**/*"/>
        </patternset>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="project.name" value="ComplexBuild"/>
      </filterset>
    </tasks>
    <tasks xsi:type="Ant:Delete" dir="temp"/>
  </targets>

</Ant:Project>