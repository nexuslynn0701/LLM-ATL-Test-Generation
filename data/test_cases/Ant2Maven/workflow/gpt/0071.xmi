<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="src"
    description="Build and package shared library"
    default="buildMain">
  <properties xsi:type="Ant:PropertyValue" name="source.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="build/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>
  <targets xmi:id="buildMain" name="buildMain">
    <tasks xsi:type="Ant:Javac"
        srcdir="src/main/java"
        destdir="build/classes"
        debug="true"
        fork="false"
        optimize="true"
        deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
        jarfile="dist/library.jar"
        basedir="build/classes"
        compress="true"
        encoding="UTF-8"
        manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir"
        dir="dist"/>
    <tasks xsi:type="Ant:Copy"
        todir="dist/resources"
        overwrite="true"
        flatten="false"
        includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete"
        dir="build/tmp"
        verbose="true"
        quiet="false"
        failonerror="true"
        includeEmptyDirs="false"/>
  </targets>
  <targets xmi:id="buildDocs" name="buildDocs">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src/main/java"
        destdir="dist/docs"
        packagenames="com.example.library.*"
        defaultexcludes="true"
        author="true"
        version="true"
        use="true"
        windowtitle="Library API Documentation"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
</Ant:Project>