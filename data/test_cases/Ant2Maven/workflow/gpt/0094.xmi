<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="FullBuildPipeline"
    basedir="project-root"
    description="End-to-end build, documentation, packaging, and cleanup"
    default="build-main">
  <!-- Properties exercising all Ant Property subtypes -->
  <properties xsi:type="Ant:PropertyValue" name="src.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="build/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <!-- A standalone TaskDef (not referenced by any task) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>
  <!-- Main build target with diverse tasks -->
  <targets xmi:id="build-main" name="build-main" description="Compile sources, generate docs, package jar, and ensure output directories exist">
    <!-- Mkdir task -->
    <tasks xsi:type="Ant:Mkdir" dir="build"/>
    <!-- Javac task -->
    <tasks xsi:type="Ant:Javac"
        srcdir="src/main/java"
        destdir="build/classes"
        debug="true"
        fork="false"
        optimize="true"
        deprecation="false"/>
    <!-- Javadoc task -->
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src/main/java"
        destdir="build/docs"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="FullBuildPipeline API"/>
    <!-- Jar task -->
    <tasks xsi:type="Ant:Jar"
        jarfile="dist/full-build.jar"
        basedir="build/classes"
        compress="true"
        encoding="UTF-8"
        manifest="META-INF/MANIFEST.MF"/>
    <!-- Copy task with simple attributes (no nested references) -->
    <tasks xsi:type="Ant:Copy"
        file="README.md"
        presservelastmodified="true"
        tofile="dist/README.md"
        overwrite="true"
        filtering="false"
        flatten="false"
        includeEmptyDirs="false"/>
  </targets>
  <!-- Auxiliary cleanup target -->
  <targets xmi:id="cleanup" name="cleanup" description="Remove generated build artifacts">
    <!-- Delete task -->
    <tasks xsi:type="Ant:Delete"
        dir="build"
        verbose="true"
        quiet="false"
        failonerror="true"
        includeEmptyDirs="true"
        includes="**/*"
        defaultexcludes="no"/>
  </targets>
</Ant:Project>