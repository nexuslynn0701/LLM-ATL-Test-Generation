<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="workspace"
    description="Build, package and manage files"
    default="buildTarget">
  <!-- Properties exercising all AntProperty subtypes -->
  <properties xsi:type="Ant:PropertyValue" name="source.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="build/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="BUILD_ENV"/>

  <!-- A TaskDef not referenced by any task -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target with mixed tasks -->
  <targets xmi:id="buildTarget" name="buildTarget" description="Compile and package">
    <tasks xsi:type="Ant:Javac"
        srcdir="src/main/java"
        destdir="build/classes"
        debug="true"
        fork="false"
        optimize="true"
        deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
        jarfile="dist/complex-build.jar"
        basedir="build/classes"
        compress="true"
        encoding="UTF-8"
        manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Delete"
        dir="build/tmp"
        verbose="true"
        quiet="false"
        failonerror="true"
        includeEmptyDirs="false"
        includes="**/*.tmp"
        includesfile="tmp.includes"
        excludes="**/keep/**"
        excludesfile="tmp.excludes"
        defaultexcludes="true"/>
  </targets>

  <!-- Secondary target with documentation and file copy tasks -->
  <targets xmi:id="docTarget" name="docTarget" description="Generate documentation">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src/main/java"
        destdir="build/docs"
        packagenames="com.example.*"
        defaultexcludes="true"
        author="true"
        version="true"
        use="true"
        windowtitle="Complex Build API"/>
    <tasks xsi:type="Ant:Copy"
        todir="dist/resources"
        overwrite="true"
        filtering="false"
        flatten="false"
        includeEmptyDirs="true"/>
  </targets>
</Ant:Project>