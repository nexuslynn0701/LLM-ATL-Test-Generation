<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="project-root"
    description="Full build lifecycle with archiving and cleanup"
    default="build-all">
  <!-- Properties exercising all property subtypes -->
  <properties xsi:type="Ant:PropertyValue" name="source.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="BUILD_ENV"/>

  <!-- User-defined task definition (not referenced by tasks) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target with a compile step and packaging -->
  <targets xmi:id="build-all" name="build-all" description="Compile, package and prepare distribution">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="target/complex-build.jar"
           basedir="target/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="target/distribution"/>
  </targets>

  <!-- Auxiliary target for cleaning artifacts -->
  <targets xmi:id="cleanup" name="cleanup" description="Remove generated artifacts">
    <tasks xsi:type="Ant:Delete"
           dir="target"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes="**/.gitignore"
           defaultexcludes="false"/>
  </targets>
</Ant:Project>