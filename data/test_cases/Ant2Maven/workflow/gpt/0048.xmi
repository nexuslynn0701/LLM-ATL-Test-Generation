<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="lib-src"
    description="Build and package shared library"
    default="build-main">
  <!-- Properties exercising all Ant Property subtypes -->
  <properties xsi:type="Ant:PropertyValue" name="compile.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="build/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- User-defined task definition (not referenced by any task) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target with several predefined tasks -->
  <targets xmi:id="build-main" name="build-main" description="Compile and jar main library">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/library-main.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"/>
  </targets>

  <!-- Additional target with management and file tasks -->
  <targets xmi:id="clean-dist" name="clean-dist" description="Clean distribution directory">
    <tasks xsi:type="Ant:Delete"
           dir="dist"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           defaultexcludes="false"/>
  </targets>

  <!-- Documentation target -->
  <targets xmi:id="generate-docs" name="generate-docs" description="Generate Javadoc for library">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="dist/docs"
           packagenames="com.example.lib.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Library API Documentation"/>
  </targets>

  <!-- Timestamp target (management property task) -->
  <targets xmi:id="stamp-build" name="stamp-build" description="Stamp build with current time">
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
</Ant:Project>