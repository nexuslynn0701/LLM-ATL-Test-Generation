<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="FullBuildPipeline"
    basedir="project-root"
    description="End-to-end build, package, and cleanup pipeline"
    default="build-main">
  <!-- Properties covering all four subclasses -->
  <properties xsi:type="Ant:PropertyValue" name="project.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="project-root/target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="project-root/config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="BUILD_ENV"/>

  <!-- Task definition (not referenced by any task, per safety rules) -->
  <taskdef name="custom.task" classname="com.example.build.CustomTask"/>

  <!-- Default target: main build -->
  <targets xmi:id="build-main" name="build-main" description="Compile, package, and prepare artifacts">
    <tasks xsi:type="Ant:Mkdir" dir="project-root/target/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="project-root/src/main/java"
           destdir="project-root/target/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="project-root/target/fullbuildpipeline.jar"
           basedir="project-root/target/classes"
           compress="true"
           encoding="UTF-8"
           manifest="project-root/config/manifest.mf"/>
  </targets>

  <!-- Secondary target: clean and prepare output directory -->
  <targets xmi:id="clean-output" name="clean-output" description="Clean and recreate output directories">
    <tasks xsi:type="Ant:Delete"
           dir="project-root/target"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes=""
           defaultexcludes="false"/>
    <tasks xsi:type="Ant:Mkdir" dir="project-root/target"/>
  </targets>

  <!-- Auxiliary target: documentation generation -->
  <targets xmi:id="generate-docs" name="generate-docs" description="Generate project documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="project-root/src/main/java"
           destdir="project-root/target/site/apidocs"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="FullBuildPipeline API"/>
  </targets>
</Ant:Project>