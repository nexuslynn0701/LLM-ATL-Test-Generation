<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="src"
    description="Build and package the library"
    default="build-main">
  <properties xsi:type="Ant:PropertyValue" name="build.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.output" location="output/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>
  <targets xmi:id="build-main" name="build-main">
    <tasks xsi:type="Ant:Javac"
        srcdir="src/main/java"
        destdir="output/classes"/>
    <tasks xsi:type="Ant:Jar"
        jarfile="dist/library.jar"
        basedir="output/classes"/>
    <tasks xsi:type="Ant:Mkdir"
        dir="dist"/>
    <tasks xsi:type="Ant:Delete"
        dir="output/temp"/>
    <tasks xsi:type="Ant:Tstamp"/>
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src/main/java"
        destdir="dist/javadoc"
        packagenames="com.example.library"
        defaultexcludes="true"
        author="Example Author"
        version="1.0"
        use="true"
        windowtitle="Library API"/>
  </targets>
  <targets xmi:id="cleanup" name="cleanup">
    <tasks xsi:type="Ant:Delete"
        dir="output/old"/>
  </targets>
</Ant:Project>