<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="src"
    description="Build and package the Library component"
    default="build-main">
  <!-- Properties exercising all Ant Property subtypes -->
  <properties xsi:type="Ant:PropertyValue" name="source.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <!-- User-defined task definition (TaskDef) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>
  <!-- Default target containing multiple predefined tasks -->
  <targets xmi:id="build-main" name="build-main">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Javac"
        srcdir="src/main/java"
        destdir="target/classes"
        debug="true"
        fork="false"
        optimize="true"
        deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
        jarfile="target/library.jar"
        basedir="target/classes"
        compress="true"
        encoding="UTF-8"
        manifest="META-INF/MANIFEST.MF"/>
  </targets>
  <!-- Secondary target using file management tasks -->
  <targets xmi:id="clean-artifacts" name="clean-artifacts">
    <tasks xsi:type="Ant:Delete"
        dir="target"
        verbose="true"
        quiet="false"
        failonerror="true"
        includeEmptyDirs="true"
        includes="**/*"
        includesfile=""
        excludes=""
        excludesfile=""
        defaultexcludes="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="target"/>
  </targets>
</Ant:Project>