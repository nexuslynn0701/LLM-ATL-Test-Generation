<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="libsrc"
    description="Build, package, and clean library artifacts"
    default="build-main">
  <!-- Properties covering all mapped subtypes -->
  <properties xsi:type="Ant:PropertyValue" name="source.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="build/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <!-- A standalone task definition (no taskName references) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>
  <!-- Default build target with several different mapped tasks -->
  <targets xmi:id="build-main" name="build-main">
    <tasks xsi:type="Ant:Javac"
        srcdir="src/main/java"
        destdir="build/classes"
        debug="true"
        fork="false"
        optimize="true"
        deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
        jarfile="dist/library-main.jar"
        basedir="build/classes"
        compress="true"
        encoding="UTF-8"
        manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir"
        dir="dist"/>
    <tasks xsi:type="Ant:Delete"
        dir="build/tmp"
        verbose="true"
        quiet="false"
        failonerror="true"
        includeEmptyDirs="false"
        includes="**/*.tmp"
        includesfile=""
        excludes=""
        excludesfile=""
        defaultexcludes="true"/>
  </targets>
  <!-- Additional target to exercise multiple Goal creation and task mapping -->
  <targets xmi:id="build-test" name="build-test">
    <tasks xsi:type="Ant:Javac"
        srcdir="src/test/java"
        destdir="build/test-classes"
        debug="false"
        fork="true"
        optimize="false"
        deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
        jarfile="dist/library-tests.jar"
        basedir="build/test-classes"
        compress="false"
        encoding="ISO-8859-1"
        manifest="META-INF/TEST-MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir"
        dir="build/reports"/>
    <tasks xsi:type="Ant:Delete"
        dir="dist/old"
        verbose="false"
        quiet="true"
        failonerror="false"
        includeEmptyDirs="true"
        includes="**/*.bak"
        includesfile=""
        excludes="**/*.keep"
        excludesfile=""
        defaultexcludes="false"/>
  </targets>
</Ant:Project>