<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="lib-src"
    description="Build, package, and clean library artifacts"
    default="mainTarget">
  <!-- Ant properties exercising PropertyValue, PropertyLocation, PropertyFile, PropertyEnv -->
  <properties xsi:type="Ant:PropertyValue" name="build.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="build/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="BUILD_ENV"/>
  <!-- User-defined task definition (TaskDef) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>
  <!-- Default target with multiple predefined tasks -->
  <targets xmi:id="mainTarget" name="mainTarget">
    <!-- Compile task: Javac -->
    <tasks xsi:type="Ant:Javac"
        srcdir="src/main/java"
        destdir="build/classes"
        debug="true"
        fork="false"
        optimize="true"
        deprecation="false"/>
    <!-- Documentation task: Javadoc -->
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src/main/java"
        destdir="build/docs"
        packagenames="com.example.lib"
        defaultexcludes="true"
        author="true"
        version="true"
        use="true"
        windowtitle="Library API Documentation"/>
    <!-- Archive task: Jar -->
    <tasks xsi:type="Ant:Jar"
        jarfile="dist/library.jar"
        basedir="build/classes"
        compress="true"
        encoding="UTF-8"
        manifest="META-INF/MANIFEST.MF"/>
    <!-- File task: Mkdir -->
    <tasks xsi:type="Ant:Mkdir" dir="build/temp"/>
    <!-- File task: Copy -->
    <tasks xsi:type="Ant:Copy"
        file="README.md"
        presservelastmodified="true"
        tofile="dist/README.md"
        todir="dist"
        overwrite="false"
        filtering="false"
        flatten="false"
        includeEmptyDirs="false"/>
    <!-- File task: Delete -->
    <tasks xsi:type="Ant:Delete"
        file="dist/old-library.jar"
        dir="build/temp"
        verbose="true"
        quiet="false"
        failonerror="true"
        includeEmptyDirs="true"
        includes="**/*.tmp"
        includesfile="config/delete-includes.txt"
        excludes="**/*.keep"
        excludesfile="config/delete-excludes.txt"
        defaultexcludes="true"/>
    <!-- Management properties task: Tstamp -->
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
  <!-- Second target with a different mix of tasks -->
  <targets xmi:id="testTarget" name="testTarget">
    <!-- Another Javac task to exercise multiple instances -->
    <tasks xsi:type="Ant:Javac"
        srcdir="src/test/java"
        destdir="build/test-classes"
        debug="false"
        fork="false"
        optimize="false"
        deprecation="true"/>
    <!-- Another Jar task -->
    <tasks xsi:type="Ant:Jar"
        jarfile="dist/library-tests.jar"
        basedir="build/test-classes"
        compress="true"
        encoding="UTF-8"
        manifest="META-INF/TEST-MANIFEST.MF"/>
    <!-- Another Mkdir task -->
    <tasks xsi:type="Ant:Mkdir" dir="build/reports"/>
    <!-- Another Delete task -->
    <tasks xsi:type="Ant:Delete"
        file="build/reports/old-report.txt"
        dir="build/reports"
        verbose="false"
        quiet="true"
        failonerror="false"
        includeEmptyDirs="false"
        includes="**/*.log"
        includesfile="config/reports-includes.txt"
        excludes="**/*.keep"
        excludesfile="config/reports-excludes.txt"
        defaultexcludes="false"/>
  </targets>
</Ant:Project>