<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="FullBuild"
    basedir="project-root"
    description="Build, package and clean project"
    default="buildTarget">

  <!-- Mixed property types -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="project.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- One user-defined task definition (not referenced by any task) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target with multiple tasks -->
  <targets xmi:id="buildTarget" name="build">
    <!-- Compile Java sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <!-- Package into jar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="target/fullbuild.jar"
           basedir="target/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Auxiliary target that creates directories and copies resources -->
  <targets xmi:id="resourcesTarget" name="prepare-resources">
    <!-- Create output directory -->
    <tasks xsi:type="Ant:Mkdir" dir="target/resources"/>
    <!-- Copy resources with simple attributes (no nested sets for safety) -->
    <tasks xsi:type="Ant:Copy"
           todir="target/resources"
           overwrite="true"
           includeEmptyDirs="false"
           flatten="false"
           filtering="false"/>
  </targets>

  <!-- Cleaning target with delete task -->
  <targets xmi:id="cleanTarget" name="clean">
    <tasks xsi:type="Ant:Delete"
           dir="target"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>