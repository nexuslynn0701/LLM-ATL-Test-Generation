<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="FullLifecycleBuild"
    basedir="project-root"
    description="Build, document, package and clean the project"
    default="build-all">
  <targets xmi:id="build-all" name="build-all" description="Compile, document and package">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/generated/**"/>
    </tasks>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="target/site/apidocs"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="FullLifecycleBuild API"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="target/full-lifecycle-build.jar"
           basedir="target/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/site"/>
    <tasks xsi:type="Ant:Copy"
           todir="target/site/resources"
           overwrite="true"
           includeEmptyDirs="false">
      <fileset dir="src/main/resources">
        <include name="**/*.properties"/>
        <exclude name="**/*.bak"/>
      </fileset>
    </tasks>
    <tasks xsi:type="Ant:Delete"
           dir="target/tmp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Remove build outputs">
    <tasks xsi:type="Ant:Delete"
           dir="target"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"/>
  </targets>
</Ant:Project>