<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="src"
    description="Build and package library"
    default="build">
  <properties xsi:type="Ant:PropertyValue" name="compiler.debug" value="on"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="build/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>
  <targets xmi:id="build" name="build">
    <tasks xsi:type="Ant:Javac"
        srcdir="src/main/java"
        destdir="build/classes"
        debug="true"
        fork="false"
        optimize="true"
        deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
        jarfile="dist/library.jar"
        basedir="build/classes"
        compress="true"
        encoding="UTF-8"
        manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir"
        dir="dist"/>
    <tasks xsi:type="Ant:Copy"
        todir="dist"
        overwrite="true"
        includeEmptyDirs="false"/>
    <tasks xsi:type="Ant:Delete"
        dir="build"
        verbose="true"
        quiet="false"
        failonerror="true"
        includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src/main/java"
        destdir="dist/javadoc"
        packagenames="com.example.lib.*"
        defaultexcludes="true"
        author="true"
        version="true"
        use="true"
        windowtitle="Example Library API"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete"
        dir="dist"
        verbose="true"
        quiet="false"
        failonerror="false"
        includeEmptyDirs="true"/>
  </targets>
</Ant:Project>