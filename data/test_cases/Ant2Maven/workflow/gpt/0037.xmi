<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComprehensiveBuild"
    basedir="project-root"
    default="build"
    description="">
  <properties xsi:type="Ant:PropertyValue" name="build.mode" value="release"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="output/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="BUILD_ENV"/>
  <taskdef name="custom.task" classname="com.example.tools.CustomTask"/>
  <targets xmi:id="build" name="build">
    <tasks xsi:type="Ant:Mkdir" dir="output"/>
    <tasks xsi:type="Ant:Javac"
        srcdir="src/main/java"
        destdir="output/classes"
        debug="false"
        fork="false"
        optimize="true"
        deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
        jarfile="dist/comprehensive-build.jar"
        basedir="output/classes"
        compress="true"
        encoding="UTF-8"
        manifest="META-INF/MANIFEST.MF"/>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete"
        file="dist/comprehensive-build.jar"
        dir="output"
        verbose="true"
        quiet="false"
        failonerror="true"
        includeEmptyDirs="true"
        includes="**/*"
        includesfile=""
        excludes=""
        excludesfile=""
        defaultexcludes="true"/>
  </targets>
</Ant:Project>