<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="src"
    description="Build and package shared library"
    default="build-main">
  <!-- Properties to exercise AntProperty* rules -->
  <properties xsi:type="Ant:PropertyValue" name="compile.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="build/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- User-defined task definition, not referenced by tasks -->
  <taskdef name="custom.clean" classname="com.example.ant.CustomCleanTask"/>

  <!-- Default target with multiple tasks -->
  <targets xmi:id="build-main" name="build-main">
    <tasks xsi:type="Ant:Mkdir" dir="build"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true">
      <!-- no classPath or inExcludes to avoid extra references -->
    </tasks>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/library.jar"
           basedir="build/classes"/>
  </targets>

  <!-- Secondary target to exercise Delete task rule -->
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="build"/>
  </targets>
</Ant:Project>