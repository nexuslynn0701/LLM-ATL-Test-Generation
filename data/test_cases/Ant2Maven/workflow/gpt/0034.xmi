<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="FullBuildPipeline"
    basedir="project-root"
    description="End-to-end build, documentation, packaging and cleanup"
    default="build-main">
  <!-- Properties to exercise all AntProperty* rules -->
  <properties xsi:type="Ant:PropertyValue" name="source.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="BUILD_ENV"/>

  <!-- Task definition to exercise AntTaskDef2MavenMavenTaskDef -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target with a rich set of tasks -->
  <targets xmi:id="build-main" name="build-main" description="Compile, document, package and prepare output">
    <!-- Compile task: AntJavac2MavenMavenJavac -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false">
      <!-- ClassPath with PathElement and FileSet to exercise path-related rules -->
      <classPath refid="">
        <pathElement path="libs/core.jar" location="libs"/>
        <pathElement path="libs/util.jar" location="libs"/>
        <fileset dir="libs">
          <patternset>
            <inexcludes xsi:type="Ant:Includes" name="**/*.jar" ifCondition="" unless=""/>
            <inexcludes xsi:type="Ant:Excludes" name="**/*-sources.jar" ifCondition="" unless=""/>
          </patternset>
          <include name="optional/*.jar" ifCondition="" unless=""/>
          <exclude name="legacy/*.jar" ifCondition="" unless=""/>
        </fileset>
      </classPath>
      <!-- InExcludes directly on Javac -->
      <inExcludes xsi:type="Ant:Includes" name="**/*.java" ifCondition="" unless=""/>
      <inExcludes xsi:type="Ant:Excludes" name="**/experimental/**" ifCondition="" unless=""/>
    </tasks>

    <!-- Documentation task: AntJavadoc2MavenMavenJavadoc -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="target/site/apidocs"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="FullBuildPipeline API"/>

    <!-- Archive task: AntJar2MavenMavenJar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="target/fullbuildpipeline.jar"
           basedir="target/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>

    <!-- File management tasks: Mkdir, Copy, Delete -->
    <tasks xsi:type="Ant:Mkdir" dir="target/distribution"/>
    <tasks xsi:type="Ant:Copy"
           file=""
           presservelastmodified="true"
           tofile=""
           todir="target/distribution"
           overwrite="true"
           filtering="false"
           flatten="false"
           includeEmptyDirs="true">
      <!-- FileSet and FilterSet to exercise corresponding rules -->
      <fileset dir="target">
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="classes/**" ifCondition="" unless=""/>
          <inexcludes xsi:type="Ant:Excludes" name="temp/**" ifCondition="" unless=""/>
        </patternset>
        <include name="site/**" ifCondition="" unless=""/>
        <exclude name="logs/**" ifCondition="" unless=""/>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="project.name" value="FullBuildPipeline"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
      <mapper type="glob" classname="" classpath="" classpathref="" from="*.txt" to="*.md"/>
    </tasks>

    <tasks xsi:type="Ant:Delete"
           file=""
           dir="target/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           includesfile=""
           excludes=""
           excludesfile=""
           defaultexcludes="true"/>

    <!-- Management properties task: Tstamp -->
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp" pattern="yyyy-MM-dd HH:mm:ss" offset="" unit="" locale=""/>
      <format property="release.date" pattern="yyyy-MM-dd" offset="" unit="" locale=""/>
    </tasks>

    <!-- Execution task: Java -->
    <tasks xsi:type="Ant:Java"
           classname="com.example.Main"
           jar="target/fullbuildpipeline.jar"
           fork="true">
      <classPath refid="">
        <pathElement path="target/fullbuildpipeline.jar" location="target"/>
        <fileset dir="libs">
          <patternset>
            <inexcludes xsi:type="Ant:Includes" name="runtime/*.jar" ifCondition="" unless=""/>
          </patternset>
        </fileset>
      </classPath>
    </tasks>
  </targets>

  <!-- Secondary target to exercise additional Goal mapping -->
  <targets xmi:id="cleanup" name="cleanup" description="Remove temporary build artifacts">
    <tasks xsi:type="Ant:Delete"
           file=""
           dir="target/work"
           verbose="false"
           quiet="true"
           failonerror="false"
           includeEmptyDirs="true"
           includes="**/*"
           includesfile=""
           excludes="keep/**"
           excludesfile=""
           defaultexcludes="true"/>
  </targets>
</Ant:Project>