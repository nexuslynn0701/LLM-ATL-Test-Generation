<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="FullPipelineBuild"
    basedir="project-root"
    description="End-to-end build, test, and package pipeline"
    default="build">
  <!-- Properties covering all subtypes -->
  <properties xsi:type="Ant:PropertyValue" name="source.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- User-defined task definition (unreferenced by tasks) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target with a variety of tasks -->
  <targets xmi:id="build" name="build" description="Compile sources, create jars, and prepare directories">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="target/fullpipeline-main.jar"
           basedir="target/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="target/site/apidocs"
           packagenames="com.example.pipeline.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Full Pipeline API"/>
  </targets>

  <!-- Secondary target exercising copy, delete, and tstamp -->
  <targets xmi:id="cleanup" name="cleanup" description="Clean temporary files and stamp build">
    <tasks xsi:type="Ant:Copy"
           todir="target/distribution"/>
    <tasks xsi:type="Ant:Delete"
           dir="target/tmp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="false"
           includes="**/*.log"
           includesfile="config/include-cleanup.txt"
           excludes="**/keep/**"
           excludesfile="config/exclude-cleanup.txt"
           defaultexcludes="true"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
</Ant:Project>