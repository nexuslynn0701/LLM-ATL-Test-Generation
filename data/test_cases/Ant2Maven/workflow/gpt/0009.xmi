<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="source"
    description="Build, test and package the application"
    default="build-main">
  <properties xsi:type="Ant:PropertyValue" name="source.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="build/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="BUILD_ENV"/>
  <taskdef name="custom.task" classname="com.example.build.CustomTask"/>
  <targets xmi:id="build-main" name="build-main">
    <tasks xsi:type="Ant:Mkdir" dir="build"/>
    <tasks xsi:type="Ant:Javac"
        srcdir="src/main/java"
        destdir="build/classes"
        debug="true"
        fork="false"
        optimize="true"
        deprecation="false">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/experimental/**"/>
    </tasks>
    <tasks xsi:type="Ant:Jar"
        jarfile="dist/complex-app.jar"
        basedir="build/classes"
        compress="true"
        encoding="UTF-8"
        manifest="META-INF/MANIFEST.MF"/>
  </targets>
  <targets xmi:id="cleanup" name="cleanup">
    <tasks xsi:type="Ant:Delete"
        dir="build"
        verbose="true"
        quiet="false"
        failonerror="true"
        includeEmptyDirs="true"
        includes="**/*"
        includesfile="config/includes.txt"
        excludes="**/*.bak"
        excludesfile="config/excludes.txt"
        defaultexcludes="true"/>
  </targets>
  <targets xmi:id="resources" name="resources">
    <tasks xsi:type="Ant:Copy"
        file="README.md"
        presservelastmodified="true"
        tofile="dist/README.txt"
        todir="dist/docs"
        overwrite="true"
        filtering="true"
        flatten="false"
        includeEmptyDirs="false">
      <fileset dir="src/main/resources">
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="**/*.properties"/>
          <inexcludes xsi:type="Ant:Excludes" name="**/secret/**"/>
        </patternset>
        <include name="**/*.xml"/>
        <exclude name="**/*.tmp"/>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="project.name" value="ComplexBuild"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
    </tasks>
  </targets>
</Ant:Project>