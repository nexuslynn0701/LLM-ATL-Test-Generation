<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="FullBuildPipeline"
    basedir="workspace"
    description="End-to-end build, package, and cleanup pipeline"
    default="build-all">
  <!-- Properties to exercise AntProperty* rules -->
  <properties xsi:type="Ant:PropertyValue" name="source.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="workspace/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="workspace/config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <!-- User-defined task definition -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>
  <!-- Default target with multiple tasks -->
  <targets xmi:id="build-all" name="build-all" description="Compile sources, package jar, and prepare output">
    <tasks xsi:type="Ant:Javac"
        srcdir="workspace/src"
        destdir="workspace/classes"
        debug="true"
        fork="false"
        optimize="true"
        deprecation="false"/>
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="workspace/src"
        destdir="workspace/docs"
        packagenames="com.example.*"
        defaultexcludes="true"
        author="Example Author"
        version="1.0"
        use="true"
        windowtitle="Example API"/>
    <tasks xsi:type="Ant:Jar"
        jarfile="workspace/dist/example-app.jar"
        basedir="workspace/classes"
        compress="true"
        encoding="UTF-8"
        manifest="workspace/META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir"
        dir="workspace/dist"/>
    <tasks xsi:type="Ant:Copy"
        file="workspace/resources/config.yml"
        presservelastmodified="true"
        tofile="workspace/dist/config.yml"
        todir="workspace/dist"
        overwrite="true"
        filtering="false"
        flatten="false"
        includeEmptyDirs="false"/>
    <tasks xsi:type="Ant:Delete"
        file="workspace/tmp/old-build.log"
        dir="workspace/tmp"
        verbose="true"
        quiet="false"
        failonerror="true"
        includeEmptyDirs="true"
        includes="**/*.bak"
        includesfile="workspace/config/delete-includes.txt"
        excludes="**/keep/**"
        excludesfile="workspace/config/delete-excludes.txt"
        defaultexcludes="true"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
  <!-- Additional target to exercise multi-goal mapping -->
  <targets xmi:id="clean-only" name="clean-only" description="Cleanup temporary and output directories">
    <tasks xsi:type="Ant:Delete"
        dir="workspace/dist"
        verbose="false"
        quiet="true"
        failonerror="false"
        includeEmptyDirs="true"
        defaultexcludes="false"/>
    <tasks xsi:type="Ant:Mkdir"
        dir="workspace/tmp"/>
  </targets>
</Ant:Project>