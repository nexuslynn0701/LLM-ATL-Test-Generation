<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="UtilityBuild"
    basedir="utility-src"
    description="Build, document, and package utility library"
    default="buildTarget">
  <!-- Properties exercising all property-mapping rules -->
  <properties xsi:type="Ant:PropertyValue" name="build.encoding" value="ISO-8859-1"/>
  <properties xsi:type="Ant:PropertyLocation" name="classes.dir" location="target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/utility.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- A standalone task definition (not referenced by any task) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target with a rich set of tasks -->
  <targets xmi:id="buildTarget" name="buildTarget" description="Compile, document, and package">
    <!-- Compile task exercising AntJavac2MavenMavenJavac -->
    <tasks xsi:type="Ant:Javac"
        srcdir="utility-src/main/java"
        destdir="target/classes"
        debug="true"
        fork="false"
        optimize="true"
        deprecation="false"/>

    <!-- Documentation task exercising AntJavadoc2MavenMavenJavadoc -->
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="utility-src/main/java"
        destdir="target/javadoc"
        packagenames="com.example.utility.*"
        defaultexcludes="true"
        author="true"
        version="true"
        use="true"
        windowtitle="Utility Library API"/>

    <!-- Archive task exercising AntJar2MavenMavenJar -->
    <tasks xsi:type="Ant:Jar"
        jarfile="target/utility-lib.jar"
        basedir="target/classes"
        compress="true"
        encoding="UTF-8"
        manifest="META-INF/MANIFEST.MF"/>

    <!-- File management tasks: Mkdir, Copy, Delete -->
    <tasks xsi:type="Ant:Mkdir" dir="target/temp"/>
    <tasks xsi:type="Ant:Copy"
        todir="target/distribution"/>
    <tasks xsi:type="Ant:Delete"
        dir="target/temp"/>
  </targets>

  <!-- Secondary target to increase Goal coverage -->
  <targets xmi:id="cleanTarget" name="cleanTarget" description="Clean all build outputs">
    <tasks xsi:type="Ant:Delete"
        dir="target"/>
  </targets>
</Ant:Project>