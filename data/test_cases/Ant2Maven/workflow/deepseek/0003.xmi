<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="AdvancedBuild"
    basedir="."
    description="Build with multiple targets and tasks"
    default="compile">
  <properties xsi:type="Ant:PropertyValue" name="build.compiler" value="javac1.8"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="target"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/dist"/>
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="target/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="target/dist/app.jar" basedir="target/classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="target/test-classes" debug="true"/>
    <tasks xsi:type="Ant:Delete" dir="target/test-results" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="false" includes="**/*.tmp" excludes="**/*.log"/>
  </targets>
</Ant:Project>