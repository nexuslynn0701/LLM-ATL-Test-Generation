<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="CustomBuild"
    basedir="."
    description="Build with custom tasks"
    default="deploy">
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="target"/>
  <properties xsi:type="Ant:PropertyLocation" name="src.dir" location="src"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customtask" classname="com.example.CustomTask"/>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes"/>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Mkdir" dir="test-results"/>
    <tasks xsi:type="Ant:Delete" dir="test-results" failonerror="false"/>
  </targets>
  <targets xmi:id="deploy" name="deploy">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="docs/api" packagenames="com.example.*" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="API"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyy-MM-dd HH:mm:ss"/>
    </tasks>
    <tasks xsi:type="Ant:Copy" todir="dist">
      <fileset dir="lib">
        <include name="**/*.jar"/>
        <exclude name="**/*-sources.jar"/>
      </fileset>
    </tasks>
    <tasks xsi:type="Ant:Java" classname="com.example.Main" fork="true">
      <classPath refid="runtime.classpath">
        <pathElement path="lib/core.jar" location="lib"/>
        <fileset dir="lib">
          <include name="**/*.jar"/>
        </fileset>
      </classPath>
    </tasks>
  </targets>
</Ant:Project>