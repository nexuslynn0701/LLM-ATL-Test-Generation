<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="CoverageBuild"
    basedir="."
    description="Build project covering multiple transformation rules"
    default="compile">
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="PATH"/>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/reports"/>
    <tasks xsi:type="Ant:Delete" dir="build/temp"/>
    <tasks xsi:type="Ant:Java" classname="com.example.Main" fork="true"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="build/docs" packagenames="com.example" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="API"/>
    <tasks xsi:type="Ant:Tstamp"/>
    <tasks xsi:type="Ant:Copy" todir="build/resources">
      <fileset dir="src/resources">
        <include name="**/*.properties"/>
        <exclude name="**/*.bak"/>
      </fileset>
      <filterset>
        <filter token="version" value="1.0"/>
        <filtersfile file="filters.properties"/>
      </filterset>
    </tasks>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="build/test-classes"/>
  </targets>
</Ant:Project>