<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="CustomBuild"
    basedir="."
    description="Build with custom tasks"
    default="deploy">
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="target"/>
  <properties xsi:type="Ant:PropertyLocation" name="src.dir" location="src"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="PATH"/>
  <taskdef name="customtask" classname="com.example.CustomTask"/>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="docs" packagenames="com.example" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="API"/>
  </targets>
  <targets xmi:id="package" name="package">
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
  <targets xmi:id="deploy" name="deploy">
    <tasks xsi:type="Ant:Mkdir" dir="deploy"/>
    <tasks xsi:type="Ant:Copy" todir="deploy">
      <fileset dir="dist">
        <include name="**/*.jar"/>
        <exclude name="**/*-sources.jar"/>
      </fileset>
    </tasks>
    <tasks xsi:type="Ant:Delete" dir="temp"/>
    <tasks xsi:type="Ant:Java" classname="com.example.Deployer" fork="true">
      <classPath refid="deploy.classpath">
        <pathElement path="lib/deploy.jar" location="lib"/>
      </classPath>
    </tasks>
  </targets>
</Ant:Project>