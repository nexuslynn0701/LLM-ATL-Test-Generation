<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="CoverageBuild"
    basedir="."
    description="Build with custom tasks"
    default="compile">
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="target"/>
  <properties xsi:type="Ant:PropertyLocation" name="src.dir" location="src"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customtask" classname="com.example.CustomTask"/>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="docs" packagenames="com.example" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="API"/>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Java" classname="com.example.TestRunner" fork="true"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
  <targets xmi:id="package" name="package">
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes" compress="true"/>
    <tasks xsi:type="Ant:Copy" todir="dist/lib">
      <fileset dir="lib">
        <include name="**/*.jar"/>
        <exclude name="**/*-sources.jar"/>
      </fileset>
      <filterset>
        <filter token="version" value="1.0"/>
        <filtersfile file="filters.properties"/>
      </filterset>
    </tasks>
  </targets>
  <targets xmi:id="deploy" name="deploy">
    <tasks xsi:type="Ant:Mkdir" dir="deploy"/>
    <tasks xsi:type="Ant:Delete" dir="deploy/old"/>
  </targets>
</Ant:Project>