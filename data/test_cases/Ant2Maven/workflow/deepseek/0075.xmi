<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="DeploymentBuild"
    basedir="."
    description="Build and deploy application"
    default="deploy">
  <properties xsi:type="Ant:PropertyValue" name="version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="dist.dir" location="dist"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customTask" classname="com.example.CustomTask"/>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="build/docs" packagenames="com.example.*" defaultexcludes="true" author="true" version="true" use="true" windowtitle="API"/>
  </targets>
  <targets xmi:id="package" name="package">
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyy-MM-dd HH:mm:ss" offset="0" unit="hour" locale="en_US"/>
    </tasks>
  </targets>
  <targets xmi:id="deploy" name="deploy">
    <tasks xsi:type="Ant:Mkdir" dir="deploy"/>
    <tasks xsi:type="Ant:Copy" file="dist/app.jar" todir="deploy" overwrite="true" filtering="false" flatten="false" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" dir="deploy/backup" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="false" includes="**/*.tmp" excludes="**/*.log" defaultexcludes="true"/>
  </targets>
</Ant:Project>