<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildApplication"
    description="Build and test the application"
    basedir="."
    default="deploy">
    
    <targets xmi:id="init" name="init" description="Initialize build directories">
        <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
        <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    </targets>
    
    <targets xmi:id="compile" name="compile" description="Compile Java sources" ifCondition="java.home">
        <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" optimize="true"/>
    </targets>
    
    <targets xmi:id="test" name="test" description="Run unit tests">
        <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="build/test-classes" deprecation="false"/>
    </targets>
    
    <targets xmi:id="package" name="package" description="Create distribution archive">
        <tasks xsi:type="Ant:Jar" jarfile="dist/application.jar" basedir="build/classes" compress="true"/>
    </targets>
    
    <targets xmi:id="deploy" name="deploy" description="Deploy the application">
        <tasks xsi:type="Ant:Copy" file="dist/application.jar" todir="/opt/app" overwrite="true"/>
        <tasks xsi:type="Ant:Mkdir" dir="/opt/app/config"/>
        <tasks xsi:type="Ant:Delete" dir="/opt/app/backup" verbose="true"/>
    </targets>
    
</Ant:Project>