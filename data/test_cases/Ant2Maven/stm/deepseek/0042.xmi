<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="build"
    basedir="."
    description="Main build project">
  <targets xmi:id="build" name="build" description="Build target">
    <tasks xsi:type="Ant:Javac" srcdir="src/main" destdir="target/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/myapp.jar" basedir="target/classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Delete" dir="temp" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean target">
    <tasks xsi:type="Ant:Delete" dir="target" failonerror="false"/>
    <tasks xsi:type="Ant:Delete" dir="dist" failonerror="false"/>
  </targets>
  <targets xmi:id="test" name="test" description="Test target">
    <tasks xsi:type="Ant:Javac" srcdir="src/test" destdir="target/test-classes" debug="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/test-reports"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="/usr/local/lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
</Ant:Project>