<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="build"
    basedir="."
    description="Main build project">
  <targets xmi:id="build" name="build" description="Compile and package">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="classes" debug="true" optimize="false" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/myapp.jar" basedir="classes" compress="true"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Remove build artifacts">
    <tasks xsi:type="Ant:Delete" dir="classes" failonerror="false"/>
    <tasks xsi:type="Ant:Delete" file="dist/myapp.jar" quiet="true"/>
  </targets>
  <targets xmi:id="init" name="init" description="Create directories">
    <tasks xsi:type="Ant:Mkdir" dir="classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="classes"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="dist"/>
  <properties xsi:type="Ant:PropertyLocation" name="src.dir" location="src"/>
</Ant:Project>