<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MyProject"
    default="build"
    basedir="."
    description="Build and test project">
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="/usr/lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <targets xmi:id="clean" name="clean" description="Clean build directory">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="build" taskname="init"/>
  </targets>
  <targets xmi:id="build" name="build" description="Build the project" ifCondition="build.dir">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build" debug="true" fork="false" optimize="false" deprecation="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Copy" file="README.txt" todir="build" overwrite="true" filtering="false" flatten="false" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Tstamp" taskname="timestamp">
      <format property="build.time" pattern="yyyy-MM-dd HH:mm" locale="en_US" offset="+1" unit="hour"/>
    </tasks>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run tests" unless="skip.tests">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="test-build" debug="false"/>
  </targets>
</Ant:Project>