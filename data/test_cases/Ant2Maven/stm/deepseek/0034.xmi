<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildApp"
    default="build"
    basedir="."
    description="Build application">
  <targets xmi:id="build" name="build" description="Main build target">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes" compress="true"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true"/>
    <tasks xsi:type="Ant:Delete" file="dist/app.jar" quiet="true"/>
  </targets>
  <targets xmi:id="deploy" name="deploy" description="Deploy to server">
    <tasks xsi:type="Ant:Copy" file="dist/app.jar" todir="/opt/deploy" overwrite="true"/>
  </targets>
</Ant:Project>