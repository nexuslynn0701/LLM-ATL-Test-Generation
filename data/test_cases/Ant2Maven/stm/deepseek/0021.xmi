<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="test"
    basedir=".">
  <targets xmi:id="test" name="test" description="Run tests">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="build/test" debug="true"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build dir">
    <tasks xsi:type="Ant:Mkdir" dir="build/cleanup"/>
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="true" failonerror="false"/>
  </targets>
</Ant:Project>