<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="TestProject"
    default="build"
    basedir="."
    description="Test model for ATL transformation">
  <targets xmi:id="build" name="build">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" optimize="false" deprecation="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/test.jar" basedir="build/classes" compress="true"/>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" failonerror="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" failonerror="true"/>
  </targets>
  <targets xmi:id="docs" name="generate-docs">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="docs/api" packagenames="com.example" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="Test API"/>
  </targets>
  <targets xmi:id="all" name="all">
    <tasks xsi:type="Ant:Mkdir" dir="build"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Copy" file="README.md" todir="dist" overwrite="false" flatten="true"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyy-MM-dd HH:mm" locale="en_US"/>
    </tasks>
  </targets>
</Ant:Project>