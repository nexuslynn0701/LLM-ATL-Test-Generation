<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    default="build"
    basedir="."
    description="Sample Ant project">
  <targets xmi:id="build" name="build" description="Build the project">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" fork="true" optimize="true"/>
    <tasks xsi:type="Ant:Copy" todir="target/classes" filtering="false" overwrite="true">
      <fileset dir="src/main/resources"/>
    </tasks>
  </targets>
  <targets xmi:id="test" name="test" description="Run tests">
    <tasks xsi:type="Ant:Delete" dir="target/test-reports" includeEmptyDirs="true"/>
  </targets>
  <targets xmi:id="package" name="package" description="Create JAR">
    <tasks xsi:type="Ant:Jar" jarfile="dist/myapp.jar" basedir="target/classes" compress="true" manifest="META-INF/MANIFEST.MF"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="target"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
</Ant:Project>