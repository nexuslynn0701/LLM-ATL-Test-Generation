<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="buildAll"
    basedir="."
    description="Main build project">
  <targets xmi:id="buildAll" name="buildAll" description="Build everything">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" optimize="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/myapp.jar" basedir="build/classes" compress="true"/>
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="true"/>
    <tasks xsi:type="Ant:Copy" file="src/config.xml" todir="build" overwrite="true"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="docs/api" packagenames="com.myapp" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="MyApp API"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyyMMdd-HHmmss"/>
    </tasks>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build">
    <tasks xsi:type="Ant:Delete" dir="build"/>
    <tasks xsi:type="Ant:Delete" dir="dist"/>
  </targets>
</Ant:Project>