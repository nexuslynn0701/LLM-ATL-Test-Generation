<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="build"
    basedir="."
    description="Main build project">
  <targets xmi:id="build" name="build" description="Build target">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="classes" debug="true" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="classes" compress="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Delete" dir="temp" verbose="true" failonerror="false"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean target">
    <tasks xsi:type="Ant:Delete" dir="classes" quiet="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" includeEmptyDirs="true"/>
  </targets>
  <targets xmi:id="test" name="test" description="Test target">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="test-classes" debug="true" fork="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/test.jar" basedir="test-classes"/>
  </targets>
</Ant:Project>