<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    basedir="/workspace"
    description="Main build project"
    default="build">
  <targets xmi:id="build" name="build" description="Build all modules">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="target/app.jar" basedir="target/classes" compress="true" encoding="UTF-8"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/reports"/>
    <tasks xsi:type="Ant:Copy" file="README.txt" todir="target/reports" overwrite="true" filtering="false" flatten="false" includeEmptyDirs="true"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="target" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.dir" location="/etc/app/config"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <path id="classpath.build">
    <pathElement path="/libs/tools.jar" location="/usr/local/lib/tools.jar"/>
  </path>
</Ant:Project>