<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="build"
    basedir="."
    description="Main build project">
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="/usr/local/lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <targets xmi:id="clean" name="clean" description="Clean build directory">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true"/>
    <tasks xsi:type="Ant:Delete" file="dist/app.jar"/>
  </targets>
  <targets xmi:id="build" name="build" description="Compile and package" ifCondition="src.dir">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
        srcdir="src"
        destdir="build/classes"
        debug="true"
        fork="false"
        optimize="true"
        deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
        jarfile="dist/app.jar"
        basedir="build/classes"
        compress="true"
        encoding="UTF-8"
        manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Copy"
        file="config.xml"
        todir="build"
        overwrite="true"
        filtering="false"
        flatten="false"
        includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyyMMdd-HHmmss" locale="en_US"/>
    </tasks>
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="docs/api"
        packagenames="com.example"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="My API"/>
  </targets>
</Ant:Project>