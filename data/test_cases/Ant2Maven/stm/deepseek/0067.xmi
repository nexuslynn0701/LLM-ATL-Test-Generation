<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="build"
    basedir="."
    description="Sample build project">
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyyMMdd-HHmmss"/>
    </tasks>
  </targets>
  <targets xmi:id="build" name="build">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Copy" file="src/application.properties" todir="build/classes" overwrite="true"/>
  </targets>
  <targets xmi:id="package" name="package">
    <tasks xsi:type="Ant:Jar" jarfile="dist/myapp.jar" basedir="build/classes" compress="true"/>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="build" failonerror="false"/>
    <tasks xsi:type="Ant:Delete" file="dist/myapp.jar" quiet="true"/>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="build/test-classes" debug="true"/>
  </targets>
</Ant:Project>