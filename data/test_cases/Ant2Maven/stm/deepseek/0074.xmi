<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="deploy"
    basedir="/workspace"
    description="Sample build project">
  <targets xmi:id="clean" name="clean" description="Remove build directory">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile source code">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" optimize="false"/>
  </targets>
  <targets xmi:id="package" name="package" description="Create JAR file">
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes" compress="true"/>
  </targets>
  <targets xmi:id="deploy" name="deploy" description="Deploy the package">
    <tasks xsi:type="Ant:Copy" file="dist/app.jar" todir="/deploy" overwrite="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="/deploy/backup"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="debug" value="true"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="/tmp/build"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
</Ant:Project>