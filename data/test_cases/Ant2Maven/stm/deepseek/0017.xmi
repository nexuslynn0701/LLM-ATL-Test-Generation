<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="buildAll"
    basedir="."
    description="Main build project">
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="/usr/local/lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <targets xmi:id="buildAll" name="buildAll" description="Build everything">
    <tasks xsi:type="Ant:Javac" srcdir="${src.dir}" destdir="${build.dir}" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="${build.dir}" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir" dir="reports"/>
    <tasks xsi:type="Ant:Delete" dir="temp" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Copy" file="config.xml" tofile="build/config.xml" overwrite="true" filtering="false" flatten="false" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyyMMdd-HHmmss" locale="en_US"/>
    </tasks>
    <tasks xsi:type="Ant:Java" classname="com.example.Main" jar="" fork="true"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts" unless="skip.clean">
    <tasks xsi:type="Ant:Delete" dir="${build.dir}" verbose="true" quiet="true"/>
  </targets>
  <targets xmi:id="docs" name="docs" description="Generate documentation" ifCondition="generate.docs">
    <tasks xsi:type="Ant:Javadoc" sourcepath="${src.dir}" destdir="docs/api" packagenames="com.example.*" defaultexcludes="true" author="true" version="true" use="true" windowtitle="MyApp API"/>
  </targets>
</Ant:Project>