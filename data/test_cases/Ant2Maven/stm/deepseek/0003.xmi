<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="TestProject"
    default="build"
    basedir="."
    description="Test model for ATL transformation">
  <targets xmi:id="build" name="build" description="Build the project">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="false" optimize="false" deprecation="true"/>
    <tasks xsi:type="Ant:Copy" file="src/README.txt" tofile="build/README.txt" overwrite="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/myapp.jar" basedir="build/classes" compress="true"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run unit tests">
    <tasks xsi:type="Ant:Delete" dir="test-reports" failonerror="false"/>
    <tasks xsi:type="Ant:Mkdir" dir="test-reports"/>
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="build/test-classes" debug="true" fork="false"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" failonerror="false"/>
    <tasks xsi:type="Ant:Delete" file="dist/myapp.jar" failonerror="false"/>
    <tasks xsi:type="Ant:Delete" dir="test-reports" failonerror="false"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build"/>
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src"/>
  <properties xsi:type="Ant:PropertyLocation" name="dist.dir" location="dist"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
</Ant:Project>