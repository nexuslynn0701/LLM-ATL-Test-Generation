<?xml version="1.0" encoding="ASCII"?>
<Ant:Project xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Ant="Ant" name="BuildProject" default="init" basedir="." description="Sample build project">
  <targets xmi:id="init" name="init" description="Initialize build directory">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile source code" unless="skip.compile">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" optimize="true" deprecation="false"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run tests" ifCondition="test.enabled">
    <tasks xsi:type="Ant:Delete" dir="build/test-results" failonerror="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/test-results"/>
  </targets>
  <targets xmi:id="package" name="package" description="Create distribution archive">
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="skip.compile" value="false"/>
  <properties xsi:type="Ant:PropertyValue" name="test.enabled" value="true"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
</Ant:Project>