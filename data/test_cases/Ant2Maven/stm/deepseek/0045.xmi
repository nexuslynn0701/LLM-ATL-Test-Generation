<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="GenerateDocumentation"
    default="docs"
    basedir="."
    description="Documentation generation project">
  <targets xmi:id="docs" name="docs" description="Generate project documentation">
    <tasks xsi:type="Ant:Javadoc" 
        sourcepath="src" 
        destdir="doc" 
        packagenames="com.example" 
        defaultexcludes="yes" 
        author="true" 
        version="true" 
        use="true" 
        windowtitle="API Documentation"/>
    <tasks xsi:type="Ant:Mkdir" dir="doc/images"/>
    <tasks xsi:type="Ant:Copy" file="README.md" todir="doc" overwrite="true"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="TIMESTAMP" pattern="yyyyMMdd-HHmm"/>
    </tasks>
  </targets>
  <targets xmi:id="clean" name="clean" description="Remove generated documentation">
    <tasks xsi:type="Ant:Delete" dir="doc" verbose="true" quiet="false"/>
  </targets>
</Ant:Project>