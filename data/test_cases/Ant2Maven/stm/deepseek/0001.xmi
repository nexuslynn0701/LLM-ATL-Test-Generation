<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    basedir="."
    description="Sample build project for testing"
    default="build">
  <targets xmi:id="build" name="build" description="Main build target" unless="skip.build">
    <tasks xsi:type="Ant:Javac" srcdir="src/main" destdir="target/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/docs"/>
    <tasks xsi:type="Ant:Copy" file="README.md" tofile="target/docs/README.md" overwrite="true"/>
  </targets>
  <targets xmi:id="test" name="test" description="Test target" ifCondition="run.tests" unless="skip.tests">
    <tasks xsi:type="Ant:Javac" srcdir="src/test" destdir="target/test-classes" debug="true"/>
    <tasks xsi:type="Ant:Delete" dir="target/test-results" failonerror="true"/>
  </targets>
  <targets xmi:id="package" name="package" description="Package target">
    <tasks xsi:type="Ant:Jar" jarfile="dist/myapp.jar" basedir="target/classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyyMMdd-HHmmss" locale="en_US"/>
    </tasks>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean target">
    <tasks xsi:type="Ant:Delete" dir="target" verbose="true" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" file="dist/myapp.jar" quiet="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="app.version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="target"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
</Ant:Project>