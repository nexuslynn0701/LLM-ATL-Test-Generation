<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="build"
    basedir="."
    description="Sample build project">
  <targets xmi:id="init" name="init" description="Initialize build directories">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="build" name="build" description="Compile source code" unless="skip.build">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" optimize="false" deprecation="true"/>
    <tasks xsi:type="Ant:Jar" destfile="dist/myapp.jar" compress="true">
      <basedir>build/classes</basedir>
    </tasks>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts" ifCondition="clean.enabled">
    <tasks xsi:type="Ant:Delete" dir="build/classes" failonerror="false"/>
    <tasks xsi:type="Ant:Delete" dir="dist" failonerror="false"/>
  </targets>
</Ant:Project>