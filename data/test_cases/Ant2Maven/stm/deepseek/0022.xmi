<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildDistribution"
    default="package"
    basedir="."
    description="Build and package distribution">
  <targets xmi:id="init" name="init" description="Initialize build directories">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/javadoc"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="compile" name="compile" ifCondition="javac.present" description="Compile source code">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" optimize="true" deprecation="false"/>
  </targets>
  <targets xmi:id="package" name="package" description="Create distribution archive">
    <tasks xsi:type="Ant:Jar" jarfile="dist/app-1.0.jar" basedir="build/classes" compress="true" manifest="MANIFEST.MF"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Remove build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="false" failonerror="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="false" failonerror="true"/>
  </targets>
</Ant:Project>