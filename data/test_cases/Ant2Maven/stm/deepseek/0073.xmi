<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MyProject"
    default="build"
    basedir="."
    description="Sample Ant project for transformation testing">
  <targets xmi:id="build" name="build" description="Main build target" ifCondition="debug">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Remove build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" failonerror="false" quiet="true"/>
    <tasks xsi:type="Ant:Delete" file="dist/app.jar" verbose="false"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run unit tests">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="build/test-classes" debug="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/test.jar" basedir="build/test-classes" compress="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="dist"/>
  <properties xsi:type="Ant:PropertyLocation" name="jdk.home" location="/usr/lib/jvm/java-11"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="PATH"/>
</Ant:Project>