<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="build-all"
    basedir="/home/project"
    description="Main build project">
  <targets xmi:id="build-all" name="build-all" description="Builds all components">
    <tasks xsi:type="Ant:Javac" srcdir="src/main" destdir="build/classes" debug="true" optimize="true"/>
    <tasks xsi:type="Ant:Jar" destfile="dist/app.jar" basedir="build/classes" compress="true"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Cleans build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" failonerror="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" failonerror="true"/>
  </targets>
  <targets xmi:id="test" name="test" description="Runs tests">
    <tasks xsi:type="Ant:Javac" srcdir="src/test" destdir="build/test-classes" debug="true"/>
    <tasks xsi:type="Ant:Copy" todir="build/test-reports" preservelastmodified="true"/>
  </targets>
  <targets xmi:id="docs" name="generate-docs" description="Generates documentation">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src/main" destdir="docs/api" packagenames="com.example" defaultexcludes="no" author="true" version="true" use="true" windowtitle="My API"/>
  </targets>
  <targets xmi:id="init" name="init" description="Initializes build directories">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Mkdir" dir="docs/api"/>
  </targets>
</Ant:Project>