<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    default="build"
    basedir="."
    description="Sample Ant project for testing">
  <targets xmi:id="build" name="build" description="Build target" unless="skip.build">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="classes" debug="true" deprecation="false"/>
    <tasks xsi:type="Ant:Copy" todir="dist" overwrite="true" flatten="true"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean target" ifCondition="do.clean">
    <tasks xsi:type="Ant:Delete" dir="classes" verbose="true" quiet="false" failonerror="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="classes"/>
  </targets>
  <targets xmi:id="package" name="package" description="Package target">
    <tasks xsi:type="Ant:Jar" destfile="dist/app.jar" compress="true" encoding="UTF-8"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyyMMdd-HHmm" offset="0" unit="hour"/>
    </tasks>
  </targets>
</Ant:Project>