<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="build"
    basedir="."
    description="Sample build project">
  <targets xmi:id="build" name="build" description="Main build target">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="classes" debug="true" optimize="false" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/myapp.jar" basedir="classes" compress="true"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="classes" failonerror="true"/>
    <tasks xsi:type="Ant:Delete" file="dist/myapp.jar" quiet="true"/>
  </targets>
  <targets xmi:id="init" name="init" description="Initialize build directories">
    <tasks xsi:type="Ant:Mkdir" dir="classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile source code">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="classes" debug="true"/>
  </targets>
  <targets xmi:id="package" name="package" description="Package the application">
    <tasks xsi:type="Ant:Jar" jarfile="dist/myapp.jar" basedir="classes" compress="true" manifest="MANIFEST.MF"/>
  </targets>
</Ant:Project>