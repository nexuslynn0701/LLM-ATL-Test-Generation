<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="build"
    basedir="."
    description="Main build project">
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="/usr/local/lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="mycustom" classname="com.example.MyCustomTask"/>
  <targets xmi:id="clean" name="clean" description="Clean build directory">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
  </targets>
  <targets xmi:id="build" name="build" description="Compile and package" ifCondition="javac.present">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/myapp.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Copy" file="README.txt" todir="dist" overwrite="true" filtering="false" flatten="false" includeEmptyDirs="false"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="TODAY" pattern="yyyy-MM-dd" locale="en_US"/>
      <format property="BUILD_TIME" pattern="HH:mm:ss" offset="0" unit="hour"/>
    </tasks>
    <tasks xsi:type="Ant:Java" classname="org.example.Main" jar="" fork="true"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run unit tests" unless="skip.tests">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="docs/api" packagenames="com.example.*" defaultexcludes="true" author="true" version="true" use="true" windowtitle="My API"/>
    <tasks xsi:type="Ant:Delete" file="test-results.xml" failonerror="false"/>
  </targets>
</Ant:Project>