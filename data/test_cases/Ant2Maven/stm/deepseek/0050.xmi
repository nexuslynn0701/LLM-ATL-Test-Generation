<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="build"
    basedir="."
    description="Main build project">
  <targets xmi:id="init" name="init" description="Initialize build">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile source code">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" optimize="false" deprecation="true"/>
  </targets>
  <targets xmi:id="build" name="build" description="Create JAR file">
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" failonerror="false"/>
    <tasks xsi:type="Ant:Delete" dir="dist" failonerror="false"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run tests">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="build/test-classes" debug="true"/>
    <tasks xsi:type="Ant:Copy" file="test/config.properties" todir="build/test-classes" overwrite="true"/>
  </targets>
  <targets xmi:id="docs" name="docs" description="Generate documentation">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="docs/api" packagenames="com.app.*" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="Application API"/>
  </targets>
  <targets xmi:id="archive" name="archive" description="Create archive">
    <tasks xsi:type="Ant:Tstamp">
      <format property="TODAY" pattern="yyyy-MM-dd"/>
    </tasks>
    <tasks xsi:type="Ant:Echo" message="Build completed on ${TODAY}" file="build.log" append="false"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/settings.xml"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
</Ant:Project>