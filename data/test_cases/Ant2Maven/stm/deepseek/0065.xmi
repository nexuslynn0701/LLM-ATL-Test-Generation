<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="build"
    basedir="."
    description="Sample build project">
  <targets xmi:id="build" name="build" description="Main build target">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="classes" debug="true" optimize="false" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="classes" compress="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="classes" verbose="true" failonerror="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" failonerror="true"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run tests">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="test-classes" debug="true"/>
    <tasks xsi:type="Ant:Copy" file="test/config.properties" todir="test-classes" overwrite="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="classes"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="dist"/>
  <properties xsi:type="Ant:PropertyLocation" name="java.home" location="/usr/lib/jvm/java-11"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="PATH"/>
</Ant:Project>