<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="build"
    basedir="."
    description="Sample build project">
  <targets xmi:id="init" name="init" description="Initialize build directory">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile source code" depends="">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" optimize="false"/>
  </targets>
  <targets xmi:id="package" name="package" description="Create JAR file">
    <tasks xsi:type="Ant:Jar" jarfile="dist/myapp.jar" basedir="build/classes" compress="true"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Remove build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" failonerror="false"/>
    <tasks xsi:type="Ant:Delete" dir="dist" failonerror="false"/>
  </targets>
  <targets xmi:id="build" name="build" description="Full build lifecycle">
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyyMMdd-HHmmss"/>
    </tasks>
    <tasks xsi:type="Ant:Copy" file="README.txt" todir="dist" overwrite="true"/>
    <tasks xsi:type="Ant:Delete" file="dist/temp.txt" quiet="true"/>
  </targets>
</Ant:Project>