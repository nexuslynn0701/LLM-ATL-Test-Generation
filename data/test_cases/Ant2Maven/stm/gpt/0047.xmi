<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build and package a small library"
    default="buildTarget">

  <targets xmi:id="buildTarget" name="build" description="Compile and package sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/library.jar" basedir="build/classes" compress="true"/>
  </targets>

  <targets xmi:id="cleanTarget" name="clean" description="Remove build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" quiet="true" failonerror="false"/>
  </targets>

</Ant:Project>