<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildAndPackage"
    basedir="."
    description="Compile sources, package jar, prepare test directory, and clean build output."
    default="mainTarget">

  <!-- Default target compiles and packages -->
  <targets xmi:id="mainTarget" name="main" description="Main build target">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/app-main.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"/>
  </targets>

  <!-- Auxiliary target prepares test area and cleans build output -->
  <targets xmi:id="prepareAndCleanTarget" name="prepare-and-clean" description="Prepare test dir and clean build output">
    <tasks xsi:type="Ant:Mkdir"
           dir="build/test-output"/>
    <tasks xsi:type="Ant:Copy"
           file="dist/app-main.jar"
           tofile="build/test-output/app-under-test.jar"
           overwrite="true"
           flatten="false"
           includeEmptyDirs="false"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/classes"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           excludes="**/keep/**"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>