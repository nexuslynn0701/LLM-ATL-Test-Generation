<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryManager"
    basedir="."
    description="Ant build for a small library application"
    default="compileTarget">

  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/library"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/library"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="dist/library"/>

  <targets xmi:id="compileTarget" name="compile" description="Compile the main sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/library/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/library"
           destdir="build/library/classes"
           debug="true"
           optimize="false"
           deprecation="true"
           fork="false"/>
  </targets>

  <targets xmi:id="packageTarget" name="package" description="Create distribution archive">
    <tasks xsi:type="Ant:Mkdir" dir="dist/library"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/library/library-app.jar"
           basedir="build/library/classes"
           compress="true"
           encoding="UTF-8"/>
  </targets>

  <targets xmi:id="cleanTarget" name="clean" description="Clean build and dist directories">
    <tasks xsi:type="Ant:Delete"
           dir="build/library"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           defaultexcludes="true"/>
    <tasks xsi:type="Ant:Delete"
           dir="dist/library"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>