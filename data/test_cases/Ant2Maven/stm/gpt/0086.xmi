<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Project with multiple targets and various predefined file and compile tasks"
    default="mainTarget">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/output"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="dist/package"/>

  <!-- Build path (unused by tasks but created without internal references) -->
  <path id="build.path">
    <fileset dir="lib"/>
  </path>

  <!-- Task definitions (not referenced by any task) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>
  <taskdef name="anotherTask" classname="com.example.ant.AnotherTask"/>

  <!-- Target: preparation -->
  <targets xmi:id="prepareTarget" name="prepare" description="Prepare build directories">
    <tasks xsi:type="Ant:Mkdir" dir="build/output/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/output/test-classes"/>
  </targets>

  <!-- Target: main compilation -->
  <targets xmi:id="compileTarget" name="compile" description="Compile main sources">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/output/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
  </targets>

  <!-- Target: documentation -->
  <targets xmi:id="javadocTarget" name="javadoc" description="Generate API documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/output/javadoc"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="ComplexBuild API"/>
  </targets>

  <!-- Target: packaging -->
  <targets xmi:id="packageTarget" name="package" description="Create distribution JAR">
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/package/complexbuild.jar"
           basedir="build/output/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Target: cleanup -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean build and dist directories">
    <tasks xsi:type="Ant:Delete"
           dir="build/output"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           defaultexcludes="false"/>
    <tasks xsi:type="Ant:Delete"
           dir="dist/package"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           defaultexcludes="false"/>
  </targets>

  <!-- Target: main entry point (default) -->
  <targets xmi:id="mainTarget" name="main" description="Default build sequence: prepare, compile, javadoc, package">
    <!-- No depends; just a marker target with no tasks -->
  </targets>

</Ant:Project>