<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryManager"
    basedir="."
    description="Build, test, and package a simple library."
    default="buildTarget">

  <targets xmi:id="buildTarget" name="build" description="Compile sources and create build directory">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes"/>
  </targets>

  <targets xmi:id="testTarget" name="test" description="Compile test sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="build/test-classes"/>
  </targets>

  <targets xmi:id="packageTarget" name="package" description="Create distributable jar">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/library-manager.jar" basedir="build/classes"/>
  </targets>

  <targets xmi:id="cleanTarget" name="clean" description="Clean build outputs">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="false"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" failonerror="false"/>
  </targets>

</Ant:Project>