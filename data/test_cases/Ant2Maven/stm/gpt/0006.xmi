<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiStageBuild"
    basedir="."
    description="Project with separate compile and package stages, plus cleanup."
    default="pkgTarget">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/classes"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="dist"/>

  <!-- A standalone taskdef, not referenced by any task -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target: package -->
  <targets xmi:id="pkgTarget" name="package" description="Create application jar from compiled classes.">
    <tasks xsi:type="Ant:Jar" jarfile="dist/app-1.0.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>

  <!-- Additional target: compile -->
  <targets xmi:id="compileTarget" name="compile" description="Compile main Java sources.">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" optimize="false" deprecation="true"/>
  </targets>

  <!-- Additional target: clean -->
  <targets xmi:id="cleanTarget" name="clean" description="Remove build and distribution directories.">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
  </targets>

</Ant:Project>