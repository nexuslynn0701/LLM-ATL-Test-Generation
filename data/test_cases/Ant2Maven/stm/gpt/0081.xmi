<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Ant project with multiple targets and various predefined tasks."
    default="build-main">

  <!-- Default build target -->
  <targets xmi:id="build-main" name="build-main" description="Compile sources and package them.">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" deprecation="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/complex-build-main.jar" basedir="build/classes" compress="true"/>
  </targets>

  <!-- Clean target -->
  <targets xmi:id="clean-all" name="clean-all" description="Remove all build outputs.">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" includeEmptyDirs="true" defaultexcludes="false"/>
    <tasks xsi:type="Ant:Delete" dir="dist" quiet="true" failonerror="false"/>
  </targets>

  <!-- Documentation target -->
  <targets xmi:id="doc" name="doc" description="Generate Javadoc documentation.">
    <tasks xsi:type="Ant:Mkdir" dir="build/docs"/>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Complex Build API"/>
  </targets>

</Ant:Project>