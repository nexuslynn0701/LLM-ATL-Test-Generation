<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiStageBuild"
    basedir="."
    description="Project with separate compile, test, and package targets"
    default="compileTarget">

  <!-- Default compile target with multiple task types -->
  <targets xmi:id="compileTarget" name="compile" description="Compile main sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
  </targets>

  <!-- Test target using Delete and Javac to cover additional task rules -->
  <targets xmi:id="testTarget" name="test" description="Compile test sources and clean old reports">
    <tasks xsi:type="Ant:Delete"
           dir="build/test-reports"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           excludes="**/keep/**"
           defaultexcludes="true"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="build/test-classes"
           debug="false"
           fork="true"
           optimize="false"
           deprecation="false"/>
  </targets>

  <!-- Packaging target with Jar and Copy to exercise archive and file tasks -->
  <targets xmi:id="packageTarget" name="package" description="Create application jar and copy it to dist">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/multistage-build.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Copy"
           file="dist/multistage-build.jar"
           todir="release"
           overwrite="true"
           filtering="false"
           flatten="false"
           includeEmptyDirs="false"/>
    <tasks xsi:type="Ant:Delete"
           file="dist/old-multistage-build.jar"
           verbose="false"
           quiet="true"
           failonerror="false"
           includeEmptyDirs="false"
           defaultexcludes="false"/>
  </targets>

</Ant:Project>