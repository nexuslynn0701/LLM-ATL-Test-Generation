<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build, test, and package a simple library."
    default="buildMain">
  <properties xsi:type="Ant:PropertyValue" name="src.main" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="src.test" value="src/test/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="dist"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="env."/>
  <targets xmi:id="initDirs" name="initDirs" description="Create initial build and dist directories.">
    <tasks xsi:type="Ant:Mkdir" dir="build"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/test"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="compileMain" name="compileMain" description="Compile main sources.">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/main" debug="true" optimize="false" deprecation="true" fork="false"/>
  </targets>
  <targets xmi:id="compileTest" name="compileTest" description="Compile test sources.">
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="build/test" debug="true" optimize="false" deprecation="false" fork="false"/>
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" defaultexcludes="true"/>
  </targets>
  <targets xmi:id="packageJar" name="packageJar" description="Create the distributable JAR.">
    <tasks xsi:type="Ant:Jar" jarfile="dist/library.jar" basedir="build/main" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
  </targets>
  <targets xmi:id="cleanup" name="cleanup" description="Remove intermediate build artifacts.">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="false" quiet="true" failonerror="false" includeEmptyDirs="true" includes="**/*" excludes="**/.keep" defaultexcludes="true"/>
  </targets>
  <targets xmi:id="buildMain" name="buildMain" description="Main build target combining compilation and packaging.">
    <tasks xsi:type="Ant:Mkdir" dir="build/main"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/main" debug="false" optimize="true" deprecation="false" fork="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/library-full.jar" basedir="build/main" compress="true" encoding="UTF-8" manifest="MANIFEST.FULL.MF"/>
  </targets>
</Ant:Project>