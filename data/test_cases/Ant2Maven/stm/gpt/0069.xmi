<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build and package a small library"
    default="buildMain">

  <!-- Default target: buildMain -->
  <targets xmi:id="buildMain" name="buildMain" description="Compile sources and create jar">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" deprecation="false" optimize="true" fork="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/library-main.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>

  <!-- Secondary target: cleanBuild -->
  <targets xmi:id="cleanBuild" name="cleanBuild" description="Clean build outputs">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" defaultexcludes="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" defaultexcludes="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>

</Ant:Project>