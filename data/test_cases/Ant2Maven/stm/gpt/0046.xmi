<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build and package a small library."
    default="buildTarget">

  <!-- Primary build target -->
  <targets xmi:id="buildTarget" name="build" description="Compile sources, create build dir, and package jar.">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/library-1.0.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>

  <!-- Secondary clean target -->
  <targets xmi:id="cleanTarget" name="clean" description="Remove build and dist outputs.">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
  </targets>

</Ant:Project>