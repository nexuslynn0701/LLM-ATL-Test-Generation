<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiPhaseBuild"
    basedir="."
    description="Ant project with separate compile and package targets"
    default="pkgTarget">

  <targets xmi:id="compileTarget" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" deprecation="true"/>
  </targets>

  <targets xmi:id="pkgTarget" name="package" description="Create application JAR">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/multiphase-app.jar" basedir="build/classes" compress="true"/>
    <tasks xsi:type="Ant:Delete" dir="build" includeEmptyDirs="true" verbose="true"/>
  </targets>

</Ant:Project>