<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiPhaseBuild"
    basedir="."
    description="Ant project with multiple targets and various predefined file and archive tasks."
    default="buildTarget">

  <!-- Default build target -->
  <targets xmi:id="buildTarget" name="build" description="Compile sources and package into a jar.">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/multiphase-build.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Secondary test target -->
  <targets xmi:id="testTarget" name="test" description="Prepare test output and clean temporary directories.">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-results"/>
    <tasks xsi:type="Ant:Copy"
           file="build/classes/app.properties"
           todir="build/test-resources"
           overwrite="true"
           flatten="false"
           includeEmptyDirs="false"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/tmp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           excludes="**/keep/**"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>