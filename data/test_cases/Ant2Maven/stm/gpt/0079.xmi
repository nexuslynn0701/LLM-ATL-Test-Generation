<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="CompositeBuild"
    basedir="."
    description="Project with multiple targets and various predefined file tasks."
    default="compileTarget">

  <targets xmi:id="compileTarget" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes"/>
  </targets>

  <targets xmi:id="packageTarget" name="package" description="Package compiled classes into a jar">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/composite-app.jar" basedir="build/classes" compress="true"/>
  </targets>

  <targets xmi:id="cleanTarget" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" failonerror="false" defaultexcludes="true"/>
  </targets>

</Ant:Project>