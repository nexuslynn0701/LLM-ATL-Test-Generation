<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="AntToMavenSample0068"
    basedir="."
    description="Project with separate compile and package targets"
    default="compileTarget">

  <!-- Default compile target -->
  <targets xmi:id="compileTarget" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" optimize="false"/>
  </targets>

  <!-- Secondary package target -->
  <targets xmi:id="packageTarget" name="package" description="Create application jar">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app-0068.jar" basedir="build/classes" compress="true"/>
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" includeEmptyDirs="true"/>
  </targets>

</Ant:Project>