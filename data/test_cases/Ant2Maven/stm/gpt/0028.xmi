<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build and package a small library"
    default="buildTarget">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="target/classes"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="target/dist"/>

  <!-- Targets -->
  <targets xmi:id="buildTarget" name="build" description="Compile sources and create jar">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="target/dist/library.jar" basedir="target/classes" compress="true" encoding="UTF-8"/>
  </targets>

  <targets xmi:id="cleanTarget" name="clean" description="Clean build output">
    <tasks xsi:type="Ant:Delete" dir="target" verbose="true" quiet="false" failonerror="true"/>
  </targets>

</Ant:Project>