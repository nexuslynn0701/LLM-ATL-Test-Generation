<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Ant project with multiple targets and various predefined file and compile tasks."
    default="build-main">

  <targets xmi:id="build-main" name="build-main" description="Main build target">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" optimize="false" deprecation="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/complex-app.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>

  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" defaultexcludes="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" defaultexcludes="true"/>
  </targets>

  <targets xmi:id="prepare-docs" name="prepare-docs" description="Prepare documentation directory">
    <tasks xsi:type="Ant:Mkdir" dir="build/docs"/>
  </targets>

  <targets xmi:id="javadoc" name="javadoc" description="Generate Javadoc documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Complex Application API"/>
  </targets>

</Ant:Project>