<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiStageBuild"
    basedir="."
    description="Ant build with separate compile, package, and clean targets."
    default="compileTarget">

  <!-- Optional project-level properties and taskdefs (unreferenced as required) -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/classes"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="dist"/>

  <taskdef name="extraTask" classname="com.example.ant.ExtraTask"/>

  <!-- Default target -->
  <targets xmi:id="compileTarget" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Mkdir">
      <target xsi:nil="true"/>
    </tasks>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="false">
      <target xsi:nil="true"/>
    </tasks>
  </targets>

  <!-- Packaging target with Jar -->
  <targets xmi:id="packageTarget" name="package" description="Create application JAR">
    <tasks xsi:type="Ant:Jar" jarfile="dist/app-1.0.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="META-INF/MANIFEST.MF">
      <target xsi:nil="true"/>
    </tasks>
  </targets>

  <!-- Clean target with Delete and Mkdir to recreate base dirs -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean and recreate output directories">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" defaultexcludes="true">
      <target xsi:nil="true"/>
    </tasks>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" defaultexcludes="true">
      <target xsi:nil="true"/>
    </tasks>
    <tasks xsi:type="Ant:Mkdir">
      <target xsi:nil="true"/>
    </tasks>
  </targets>

</Ant:Project>