<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Project with multiple targets and various predefined tasks."
    default="buildTarget">

  <!-- Global property definitions -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/classes"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="dist"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>

  <!-- Task definition (unused by any task, as required) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default build target -->
  <targets xmi:id="buildTarget" name="build" description="Compile sources and package into jar.">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/complexbuild.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Clean target -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean build and dist directories.">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes="**/.git/**"
           defaultexcludes="true"/>
    <tasks xsi:type="Ant:Delete"
           dir="dist"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes="**/.git/**"
           defaultexcludes="true"/>
  </targets>

  <!-- Documentation target -->
  <targets xmi:id="docTarget" name="doc" description="Generate Javadoc documentation.">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="dist/javadoc"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="ComplexBuild API"/>
  </targets>

</Ant:Project>