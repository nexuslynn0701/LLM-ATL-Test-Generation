<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiStageBuild"
    basedir="."
    description="Project with separate build and cleanup targets."
    default="buildTarget">

  <!-- Default build target -->
  <targets xmi:id="buildTarget" name="build" description="Compile sources, create output dir, package jar">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" optimize="false"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/dist"/>
    <tasks xsi:type="Ant:Jar" jarfile="build/dist/app-main.jar" basedir="build/classes" compress="true"/>
  </targets>

  <!-- Additional cleanup target (not default) -->
  <targets xmi:id="cleanTarget" name="clean" description="Remove build directories and artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
  </targets>

</Ant:Project>