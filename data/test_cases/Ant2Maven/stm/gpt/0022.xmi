<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiStageBuild"
    basedir="."
    description="Project with separate compile and package phases"
    default="pkgTarget">

  <!-- Default target: package -->
  <targets xmi:id="pkgTarget" name="package" description="Create distribution archive">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/multistage-app.jar" basedir="build/classes" compress="true"/>
  </targets>

  <!-- Additional target: compile -->
  <targets xmi:id="compileTarget" name="compile" description="Compile project sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="on" deprecation="off"/>
    <tasks xsi:type="Ant:Delete" dir="build/tmp" quiet="true" includeEmptyDirs="true"/>
  </targets>

</Ant:Project>