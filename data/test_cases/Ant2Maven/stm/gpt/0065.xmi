<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryManager"
    basedir="."
    description="Build and test tasks for a simple library project."
    default="buildTarget">

  <!-- Properties exercise PropertyValue and PropertyEnv -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/classes"/>
  <properties xsi:type="Ant:PropertyEnv" environment="env.settings"/>

  <!-- Task definition (not referenced by any task) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target: build -->
  <targets xmi:id="buildTarget" name="build" description="Compile sources and create jar.">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/library-manager.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>

  <!-- Secondary target: clean -->
  <targets xmi:id="cleanTarget" name="clean" description="Remove build output and temporary files.">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" defaultexcludes="true"/>
  </targets>

  <!-- Secondary target: javadoc -->
  <targets xmi:id="docTarget" name="javadoc" description="Generate project documentation.">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.library.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Library Manager API"/>
  </targets>

</Ant:Project>