<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryManager"
    basedir="."
    description="Build, test, and package the library."
    default="build-main">
  <targets xmi:id="build-main" name="build-main" description="Compile sources and create jar">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" optimize="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/library-main.jar" basedir="build/classes" compress="true"/>
  </targets>
  <targets xmi:id="clean-all" name="clean-all" description="Clean all generated artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" failonerror="false" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" quiet="true" defaultexcludes="true"/>
  </targets>
</Ant:Project>