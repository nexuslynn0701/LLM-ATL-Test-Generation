<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntProject"
    basedir="."
    description="Ant build with compile, package and clean targets"
    default="compileTarget">

  <targets xmi:id="compileTarget" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true"/>
  </targets>

  <targets xmi:id="packageTarget" name="package" description="Create distribution JAR">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample-app.jar" basedir="build/classes" compress="true"/>
  </targets>

  <targets xmi:id="cleanTarget" name="clean" description="Clean build outputs">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" quiet="true" failonerror="false"/>
  </targets>

</Ant:Project>