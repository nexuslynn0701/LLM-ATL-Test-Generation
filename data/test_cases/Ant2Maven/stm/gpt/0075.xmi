<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="Ant2MavenSample75"
    basedir="."
    description="Project with multiple targets and various predefined file and archive tasks"
    default="build-main">

  <!-- Default build target -->
  <targets xmi:id="build-main" name="build-main" description="Compile sources and create main jar">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" optimize="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/main-app.jar" basedir="build/classes" compress="true"/>
  </targets>

  <!-- Additional test target -->
  <targets xmi:id="run-tests" name="run-tests" description="Prepare test classes and package tests">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="build/test-classes" deprecation="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/test-app.jar" basedir="build/test-classes" encoding="UTF-8"/>
  </targets>

  <!-- Cleanup target exercising Copy and Delete tasks -->
  <targets xmi:id="cleanup" name="cleanup" description="Clean build artifacts and archive logs">
    <tasks xsi:type="Ant:Copy" file="logs/build.log" tofile="archive/build.log.bak" overwrite="true" flatten="true"/>
    <tasks xsi:type="Ant:Delete" dir="build" includeEmptyDirs="true" verbose="true" failonerror="false"/>
    <tasks xsi:type="Ant:Delete" file="dist/old-archive.jar" quiet="true"/>
  </targets>

</Ant:Project>