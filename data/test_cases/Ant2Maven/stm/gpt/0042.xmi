<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build and package a library"
    default="buildTarget">

  <targets xmi:id="buildTarget" name="build" description="Compile sources and create jar">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" optimize="false" deprecation="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/library.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>

  <targets xmi:id="distTarget" name="dist" description="Prepare distribution directory">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Copy" todir="dist" overwrite="true" flatten="false" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" dir="build" quiet="true" includeEmptyDirs="true" defaultexcludes="true"/>
  </targets>

</Ant:Project>