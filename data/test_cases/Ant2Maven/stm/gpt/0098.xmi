<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="CoverageProject0098"
    basedir="."
    description="Ant project exercising multiple predefined tasks"
    default="buildTarget">

  <!-- Default build target with multiple tasks -->
  <targets xmi:id="buildTarget" name="build" description="Compile, package and clean previous build">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/javadoc"
           packagenames="com.example.project.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="Project 0098 API"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/project-0098.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Copy"
           file="dist/project-0098.jar"
           tofile="backup/project-0098.jar"
           presservelastmodified="true"
           overwrite="true"
           filtering="false"
           flatten="false"
           includeEmptyDirs="false"/>
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           excludes="**/keep/**"
           defaultexcludes="true"/>
  </targets>

  <!-- Secondary target with simpler file operations -->
  <targets xmi:id="distCleanup" name="cleanup" description="Cleanup distribution artifacts">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Copy"
           file="README.md"
           tofile="dist/README.txt"
           presservelastmodified="false"
           overwrite="true"
           filtering="false"
           flatten="true"
           includeEmptyDirs="false"/>
    <tasks xsi:type="Ant:Delete"
           file="dist/old-archive.zip"
           verbose="false"
           quiet="true"
           failonerror="false"
           includeEmptyDirs="false"
           includes="**/*.bak"
           excludesfile="config/excludes.txt"
           defaultexcludes="false"/>
  </targets>

</Ant:Project>