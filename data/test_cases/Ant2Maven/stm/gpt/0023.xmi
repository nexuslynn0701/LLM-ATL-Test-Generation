<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntProject"
    basedir="."
    description="Ant project with multiple targets and various predefined file and compile tasks"
    default="build-main">

  <!-- Default build target -->
  <targets xmi:id="build-main" name="build-main" description="Compile sources, package jar, and prepare build directory">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" deprecation="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/dist"/>
    <tasks xsi:type="Ant:Jar" jarfile="build/dist/app-main.jar" basedir="build/classes" compress="true"/>
  </targets>

  <!-- Secondary target focusing on test compilation and clean-up -->
  <targets xmi:id="test-build" name="test-build" description="Compile test sources and clean temporary directories">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="build/test-classes" debug="false" optimize="true"/>
    <tasks xsi:type="Ant:Copy" todir="build/backup" overwrite="true" flatten="true"/>
    <tasks xsi:type="Ant:Delete" dir="build/tmp" verbose="true" failonerror="false" includeEmptyDirs="true"/>
  </targets>

</Ant:Project>