<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiPhaseBuild"
    basedir="."
    description="Ant project with separate build phases for coverage."
    default="build-main">

  <!-- Properties demonstrating different property types -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="test.src.dir" value="src/test/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="dist"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="env.build"/>

  <!-- Task definition not referenced by tasks (still exercises mapping) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target: main build pipeline -->
  <targets xmi:id="build-main" name="build-main" description="Compile, package and generate docs for main sources.">
    <!-- Ensure build and dist directories exist -->
    <tasks xsi:type="Ant:Mkdir" dir="build"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>

    <!-- Compile main sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>

    <!-- Package compiled classes into a jar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/app-main.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>

    <!-- Generate Javadoc for main sources -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="dist/javadoc"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Main API Documentation"/>
  </targets>

  <!-- Separate test build and cleanup target -->
  <targets xmi:id="build-and-clean-tests" name="build-and-clean-tests" description="Compile tests and then clean build directory.">
    <!-- Create a dedicated test build directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>

    <!-- Compile test sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="build/test-classes"
           debug="false"
           fork="false"
           optimize="false"
           deprecation="false"/>

    <!-- Copy resources into test build directory with some options set -->
    <tasks xsi:type="Ant:Copy"
           file="src/test/resources/config-test.properties"
           tofile="build/test-classes/config-test.properties"
           overwrite="true"
           filtering="false"
           flatten="true"
           includeEmptyDirs="false"/>

    <!-- Delete the entire build directory after tests to exercise Delete mapping -->
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           includesfile="build-includes.txt"
           excludes="**/*.keep"
           excludesfile="build-excludes.txt"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>