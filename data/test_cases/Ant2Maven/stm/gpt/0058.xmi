<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Ant project with multiple targets and diverse predefined tasks."
    default="build-main">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="dist"/>
  <properties xsi:type="Ant:PropertyValue" name="doc.dir" value="dist/javadoc"/>

  <!-- A standalone task definition (unused but valid) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default / main build target -->
  <targets xmi:id="build-main" name="build-main" description="Compile sources and create main jar.">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/complex-build.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>

  <!-- Test compilation target -->
  <targets xmi:id="build-test" name="build-test" description="Compile test sources only.">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="build/test-classes" debug="false" fork="false" optimize="false" deprecation="false"/>
  </targets>

  <!-- Documentation target -->
  <targets xmi:id="generate-docs" name="generate-docs" description="Generate Javadoc API documentation.">
    <tasks xsi:type="Ant:Mkdir" dir="dist/javadoc"/>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="dist/javadoc"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Complex Build API Documentation"/>
  </targets>

  <!-- Cleanup target -->
  <targets xmi:id="clean-all" name="clean-all" description="Clean all build, dist, and doc artifacts.">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
  </targets>

</Ant:Project>