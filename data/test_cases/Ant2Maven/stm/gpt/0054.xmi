<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleBuildProject"
    basedir="."
    description="Ant project with multiple targets and various predefined tasks"
    default="buildMain">

  <!-- Project-level properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="test.src.dir" value="src/test/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="dist"/>

  <!-- Task definition (not referenced by any task) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default build target -->
  <targets xmi:id="buildMain" name="build-main" description="Compile sources, create JAR and clean temp files">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample-app.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Delete" dir="build/tmp" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="false" includes="**/*.tmp" defaultexcludes="true"/>
  </targets>

  <!-- Separate test compilation target -->
  <targets xmi:id="compileTests" name="compile-tests" description="Compile unit tests">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="build/test-classes" debug="true" fork="false" optimize="false" deprecation="true"/>
  </targets>

  <!-- Cleanup target -->
  <targets xmi:id="cleanup" name="cleanup" description="Remove build and distribution artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="false" includeEmptyDirs="true" defaultexcludes="false"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" failonerror="false" includeEmptyDirs="true" defaultexcludes="false"/>
  </targets>

</Ant:Project>