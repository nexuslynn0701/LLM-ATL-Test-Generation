<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Ant project with multiple targets and varied predefined tasks"
    default="build_target">

  <!-- Default build target -->
  <targets xmi:id="build_target" name="build" description="Compile and package sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" optimize="false" deprecation="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/complexbuild.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>

  <!-- Secondary test target -->
  <targets xmi:id="test_target" name="test" description="Prepare and clean test environment">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="build/test-classes" debug="false"/>
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="true" failonerror="false" includeEmptyDirs="true" defaultexcludes="true"/>
  </targets>

</Ant:Project>