<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleBuild"
    basedir="."
    description="Ant build with multiple targets and various predefined tasks"
    default="compile-target">

  <!-- Default compile target -->
  <targets xmi:id="compile-target" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" optimize="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample-build.jar" basedir="build/classes" compress="true"/>
  </targets>

  <!-- Separate documentation target -->
  <targets xmi:id="docs-target" name="docs" description="Generate Javadoc">
    <tasks xsi:type="Ant:Mkdir" dir="build/docs"/>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Sample Build API"/>
  </targets>

  <!-- Cleanup target -->
  <targets xmi:id="clean-target" name="clean" description="Clean build outputs">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true"/>
    <tasks xsi:type="Ant:Delete" file="dist/sample-build.jar" quiet="true"/>
  </targets>

</Ant:Project>