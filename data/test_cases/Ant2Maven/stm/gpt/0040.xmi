<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Project with multiple targets and diverse predefined tasks"
    default="build-main">

  <!-- Properties exercising different property subclasses -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="test.src.dir" value="src/test/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="BUILD_ENV"/>

  <!-- Task definitions (not referenced by any task) -->
  <taskdef name="customTaskOne" classname="com.example.ant.CustomTaskOne"/>
  <taskdef name="customTaskTwo" classname="com.example.ant.CustomTaskTwo"/>

  <!-- Default target -->
  <targets xmi:id="build-main" name="build-main" description="Compile sources, package jar, and clean temp files">
    <!-- Create build and temp directories -->
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/temp"/>

    <!-- Compile main sources -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="false"/>

    <!-- Package compiled classes into a jar -->
    <tasks xsi:type="Ant:Jar" jarfile="dist/main-app.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="META-INF/MANIFEST.MF"/>

    <!-- Generate javadoc -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Example Application API"/>

    <!-- Copy resources into the build directory -->
    <tasks xsi:type="Ant:Copy"
           file="resources/config.yml"
           todir="build/classes"
           overwrite="true"
           filtering="false"
           flatten="false"
           includeEmptyDirs="true"/>

    <!-- Remove temporary directory -->
    <tasks xsi:type="Ant:Delete"
           dir="build/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes=""/>
  </targets>

  <!-- Separate target focusing on clean operations -->
  <targets xmi:id="clean-all" name="clean-all" description="Completely remove build and distribution artifacts">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes=""/>
    <tasks xsi:type="Ant:Delete"
           dir="dist"
           verbose="true"
           quiet="false"
           failonerror="false"
           includeEmptyDirs="true"
           defaultexcludes="false"/>
  </targets>

  <!-- Target for test compilation and documentation -->
  <targets xmi:id="build-tests" name="build-tests" description="Compile test sources and generate test documentation">
    <!-- Directory setup -->
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/docs/test-api"/>

    <!-- Compile test sources -->
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="build/test-classes" debug="false" fork="false" optimize="false" deprecation="true"/>

    <!-- Javadoc for test sources -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/test/java"
           destdir="build/docs/test-api"
           packagenames="com.example.tests.*"
           defaultexcludes="true"
           author="false"
           version="false"
           use="false"
           windowtitle="Example Tests API"/>
  </targets>

</Ant:Project>