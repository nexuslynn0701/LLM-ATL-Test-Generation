<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Ant project with multiple targets and various predefined tasks"
    default="build-target">

  <!-- Properties block using different Property subclasses -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/classes"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="dist"/>
  <properties xsi:type="Ant:PropertyLocation" name="java.home" location="/usr/lib/jvm/default-java"/>
  <properties xsi:type="Ant:PropertyEnv" environment="SYSTEM_ENV"/>

  <!-- One TaskDef, not referenced by any task -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default build target -->
  <targets xmi:id="build-target" name="build" description="Compile, jar, and prepare distribution">
    <!-- Make sure build and dist directories exist -->
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>

    <!-- Compile main sources with simple settings -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>

    <!-- Compile test sources with different flags -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="build/test-classes"
           debug="false"
           fork="true"
           optimize="false"
           deprecation="true"/>

    <!-- Package main classes into a jar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/app-main.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>

    <!-- Package test classes into a separate jar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/app-tests.jar"
           basedir="build/test-classes"
           compress="false"
           encoding="UTF-8"
           manifest="META-INF/TEST.MF"/>
  </targets>

  <!-- Secondary target exercising Copy and Delete with various attributes -->
  <targets xmi:id="cleanup-target" name="cleanup" description="Clean distribution and temp files">
    <!-- Copy a config file into dist with multiple attributes set -->
    <tasks xsi:type="Ant:Copy"
           file="config/app.properties"
           presservelastmodified="true"
           tofile="dist/app.properties"
           todir=""
           overwrite="true"
           filtering="false"
           flatten="false"
           includeEmptyDirs="true"/>

    <!-- Delete compiled and temporary artifacts using directory-based delete -->
    <tasks xsi:type="Ant:Delete"
           file=""
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           includesfile=""
           excludes="**/*.keep"
           excludesfile=""
           defaultexcludes="true"/>

    <!-- Delete a specific generated jar file using file-based delete -->
    <tasks xsi:type="Ant:Delete"
           file="dist/app-tests.jar"
           dir=""
           verbose="false"
           quiet="true"
           failonerror="false"
           includeEmptyDirs="false"
           includes=""
           includesfile=""
           excludes=""
           excludesfile=""
           defaultexcludes="false"/>
  </targets>

</Ant:Project>