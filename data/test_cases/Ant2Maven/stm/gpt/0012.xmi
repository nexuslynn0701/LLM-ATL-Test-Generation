<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Ant project exercising multiple predefined tasks"
    default="packageTarget">

  <!-- Properties demonstrating different property subclasses -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="env"/>

  <!-- Custom task definition (not referenced by tasks) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target: packageTarget -->
  <targets xmi:id="packageTarget" name="package" description="Compile, document and package the project">
    <!-- Create build and dist directories -->
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/docs"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>

    <!-- Compile Java sources with various optional attributes set -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>

    <!-- Generate Javadoc documentation -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="ComplexBuild API"/>

    <!-- Create application JAR -->
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/complexbuild-app.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Secondary target: clean -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean build outputs">
    <!-- Delete build directory tree -->
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes="**/.git/**"
           defaultexcludes="true"/>

    <!-- Delete distribution directory tree -->
    <tasks xsi:type="Ant:Delete"
           dir="dist"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>