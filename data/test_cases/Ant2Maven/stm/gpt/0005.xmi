<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntProject5"
    basedir="."
    description="Ant build with compile, test, and packaging targets"
    default="compileTarget">
  <targets xmi:id="compileTarget" name="compile" description="Compile main sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" optimize="false" deprecation="true"/>
  </targets>
  <targets xmi:id="testTarget" name="test" description="Clean and prepare test output">
    <tasks xsi:type="Ant:Delete" dir="build/test-results" verbose="true" quiet="false" failonerror="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/test-results"/>
  </targets>
  <targets xmi:id="packageTarget" name="package" description="Create distribution JAR">
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample5-app.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>
</Ant:Project>