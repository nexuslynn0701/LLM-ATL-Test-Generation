<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntBuild"
    basedir="."
    description="Ant project with multiple targets and various predefined file tasks"
    default="build-main">

  <!-- Default build target with several tasks -->
  <targets xmi:id="build-main" name="build-main" description="Main build sequence">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app-main.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>

  <!-- Auxiliary target for preparing distribution -->
  <targets xmi:id="dist-prepare" name="dist-prepare" description="Prepare distribution directory">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Copy" todir="dist/lib" overwrite="true" flatten="false" includeEmptyDirs="true"/>
  </targets>

  <!-- Cleanup target to remove build artifacts -->
  <targets xmi:id="clean-all" name="clean-all" description="Clean all generated artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
  </targets>

</Ant:Project>