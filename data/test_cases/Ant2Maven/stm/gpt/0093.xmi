<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="CompositeBuild"
    basedir="."
    description="Project with multiple targets and various predefined tasks."
    default="buildTarget">

  <!-- Properties to exercise different Property subtypes -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="SYSTEM_ENV"/>

  <!-- Task definition (unreferenced by any task, but present to cover TaskDef) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target: buildTarget -->
  <targets xmi:id="buildTarget" name="build" description="Compile, package and clean temporary files.">
    <!-- File preparation -->
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/jar"/>

    <!-- Java compilation -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>

    <!-- Javadoc generation -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="CompositeBuild API"/>

    <!-- Archive creation -->
    <tasks xsi:type="Ant:Jar"
           jarfile="build/jar/composite-build.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>

    <!-- Cleanup -->
    <tasks xsi:type="Ant:Delete"
           dir="build/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="false"
           includes="**/*~"
           includesfile="config/delete-includes.txt"
           excludes="**/*.keep"
           excludesfile="config/delete-excludes.txt"
           defaultexcludes="true"/>
  </targets>

  <!-- Secondary target: cleanTarget -->
  <targets xmi:id="cleanTarget" name="clean" description="Remove all build outputs.">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="false"
           includeEmptyDirs="true"
           includes="**/*"
           includesfile="config/clean-includes.txt"
           excludes=""
           excludesfile=""
           defaultexcludes="false"/>
  </targets>
</Ant:Project>