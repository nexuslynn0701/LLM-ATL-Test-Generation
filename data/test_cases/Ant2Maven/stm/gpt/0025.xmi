<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiTargetBuild"
    basedir="."
    description="Project with multiple targets and various predefined file tasks"
    default="build-main">

  <!-- Default target -->
  <targets xmi:id="build-main" name="build-main" description="Compile sources and package JAR">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" optimize="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/main-app.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>

  <!-- Secondary target, not default -->
  <targets xmi:id="clean-build" name="clean-build" description="Clean all build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" failonerror="true"/>
  </targets>

</Ant:Project>