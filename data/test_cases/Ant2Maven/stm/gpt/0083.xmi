<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryManager"
    basedir="."
    description="Ant build for a small library application"
    default="buildTarget">

  <!-- Properties exercising different Property subtypes -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/classes"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/app.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="env"/>

  <!-- A standalone task definition (not referenced by any NewTask) -->
  <taskdef name="custom.check" classname="com.example.build.CustomCheck"/>

  <!-- Default target: build -->
  <targets xmi:id="buildTarget" name="build" description="Compile and package the project">
    <!-- Create build directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <!-- Compile Java sources with a simple include and exclude pattern -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" optimize="false">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**"/>
    </tasks>
    <!-- Create a jar from compiled classes -->
    <tasks xsi:type="Ant:Jar" jarfile="dist/library-manager.jar" basedir="build/classes" compress="true"/>
  </targets>

  <!-- Additional target: clean -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean build artifacts">
    <!-- Delete build directory -->
    <tasks xsi:type="Ant:Delete" dir="build" includeEmptyDirs="true" verbose="true" quiet="false"/>
    <!-- Delete distribution directory -->
    <tasks xsi:type="Ant:Delete" dir="dist" includeEmptyDirs="true" verbose="true" quiet="false"/>
  </targets>

</Ant:Project>