<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build and package a small library"
    default="compileTarget">

  <targets xmi:id="compileTarget" name="compile" description="Compile project sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
  </targets>

  <targets xmi:id="packageTarget" name="package" description="Create binary jar">
    <tasks xsi:type="Ant:Jar" jarfile="dist/library.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <targets xmi:id="cleanupTarget" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" includes="**/*" defaultexcludes="true"/>
  </targets>
</Ant:Project>