<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="Ant2MavenSample84"
    basedir="."
    description="Ant build with multiple targets and various predefined tasks"
    default="build-main">

  <!-- Properties exercising different Property subtypes -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="env."/>

  <!-- A task definition, not referenced by any task -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target: build-main -->
  <targets xmi:id="build-main" name="build-main" description="Compile, package and clean temp">
    <!-- Create build directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build/main-classes"/>
    <!-- Compile Java sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/main-classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <!-- Package classes into a jar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/app-main.jar"
           basedir="build/main-classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <!-- Copy compiled classes to distribution directory -->
    <tasks xsi:type="Ant:Copy"
           todir="dist/classes"
           overwrite="true"
           flatten="false"
           includeEmptyDirs="true"/>
  </targets>

  <!-- Secondary target: build-test with documentation and deletion -->
  <targets xmi:id="build-test" name="build-test" description="Compile tests, generate javadoc and clean build outputs">
    <!-- Create test build directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <!-- Compile test sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="build/test-classes"
           debug="true"
           fork="false"
           optimize="false"
           deprecation="true"/>
    <!-- Generate Javadoc -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="dist/javadoc"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="Example Project API"/>
    <!-- Delete old distribution directory -->
    <tasks xsi:type="Ant:Delete"
           dir="dist/old"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="false"
           includes="**/*"
           excludes="**/*.keep"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>