<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiPhaseBuild"
    basedir="."
    description="Ant project with multiple targets and assorted predefined tasks."
    default="compileTarget">

  <!-- Default compile target -->
  <targets xmi:id="compileTarget" name="compile" description="Compile the main sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="true"/>
  </targets>

  <!-- Packaging target -->
  <targets xmi:id="packageTarget" name="package" description="Package compiled classes into a JAR">
    <tasks xsi:type="Ant:Jar" jarfile="dist/multiphase-build.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>

  <!-- Documentation target -->
  <targets xmi:id="docsTarget" name="javadoc" description="Generate project Javadoc">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="MultiPhase Build API"/>
  </targets>

  <!-- Cleanup target -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean build output">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="false" includeEmptyDirs="true"/>
  </targets>

</Ant:Project>