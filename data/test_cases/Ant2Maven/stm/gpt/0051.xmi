<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiStageBuild"
    basedir="."
    description="Ant project with separate compile and package targets"
    default="pkgTarget">

  <!-- Default target: package / jar -->
  <targets xmi:id="pkgTarget" name="package" description="Package compiled classes">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/multistage-app.jar" basedir="build" compress="true"/>
    <tasks xsi:type="Ant:Delete" dir="temp" verbose="true" quiet="false"/>
  </targets>

  <!-- Additional target: compile -->
  <targets xmi:id="compileTarget" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Mkdir" dir="build"/>
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build" debug="on" optimize="off" deprecation="true"/>
  </targets>

</Ant:Project>