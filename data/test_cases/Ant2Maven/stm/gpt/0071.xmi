<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build, test, and package a reusable library."
    default="build_main">

  <!-- Global properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="test.src.dir" value="src/test/java"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Custom task definition (not referenced by any task) -->
  <taskdef name="custom.report" classname="com.example.ant.CustomReportTask"/>

  <!-- Main build target (default) -->
  <targets xmi:id="build_main" name="build" description="Compile, package, and prepare distribution.">
    <!-- Ensure output directories exist -->
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/test-classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>

    <!-- Compile main sources -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="true"/>

    <!-- Compile test sources -->
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="build/test-classes" debug="true" fork="false" optimize="false" deprecation="false"/>

    <!-- Package main classes into a JAR -->
    <tasks xsi:type="Ant:Jar" jarfile="dist/library-1.0.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>

    <!-- Clean temporary test classes directory -->
    <tasks xsi:type="Ant:Delete" dir="build/test-classes" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
  </targets>

  <!-- Separate test target -->
  <targets xmi:id="run_tests" name="test" description="Compile and run tests (no dependencies).">
    <!-- Ensure only test output directory exists -->
    <tasks xsi:type="Ant:Mkdir" dir="build/test-output"/>

    <!-- Compile test sources to dedicated directory -->
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="build/test-output" debug="true" fork="false" optimize="false" deprecation="false"/>

    <!-- Remove stale build directory before next run -->
    <tasks xsi:type="Ant:Delete" dir="build/old" verbose="false" quiet="true" failonerror="false" includeEmptyDirs="false"/>
  </targets>

</Ant:Project>