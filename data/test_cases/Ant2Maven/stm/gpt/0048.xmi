<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Ant project with multiple targets and various predefined file and compile tasks"
    default="buildTarget">

  <!-- Properties demonstrating different Property subclasses -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build/main"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- A standalone TaskDef (not referenced by any task) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target: buildTarget -->
  <targets xmi:id="buildTarget" name="build" description="Compile, package and prepare build output">
    <!-- Ensure build directory exists -->
    <tasks xsi:type="Ant:Mkdir" dir="build/main/classes"/>
    <!-- Compile Java sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/main/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <!-- Package compiled classes into a jar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/complex-build.jar"
           basedir="build/main/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Additional target: cleanTarget -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean all generated artifacts">
    <!-- Delete build output and distribution directories -->
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes=""
           defaultexcludes="true"/>
    <tasks xsi:type="Ant:Delete"
           dir="dist"
           verbose="false"
           quiet="true"
           failonerror="false"
           includeEmptyDirs="true"
           includes="**/*.jar"
           excludes=""
           defaultexcludes="true"/>
  </targets>

  <!-- Additional target: distPrepTarget -->
  <targets xmi:id="distPrepTarget" name="prepareDist" description="Prepare distribution directory and copy artifacts">
    <!-- Create distribution directory -->
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <!-- Copy jar into distribution directory -->
    <tasks xsi:type="Ant:Copy"
           file="dist/complex-build.jar"
           todir="dist/release"
           overwrite="true"
           filtering="false"
           flatten="false"
           includeEmptyDirs="true"/>
  </targets>

</Ant:Project>