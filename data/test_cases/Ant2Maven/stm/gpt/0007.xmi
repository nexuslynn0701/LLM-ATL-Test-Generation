<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="."
    description="Build, test, and package a small library."
    default="compileTarget">

  <!-- Default compile target -->
  <targets xmi:id="compileTarget" name="compile" description="Compile source files">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes"/>
  </targets>

  <!-- Separate packaging target -->
  <targets xmi:id="packageTarget" name="package" description="Create distributable JAR">
    <tasks xsi:type="Ant:Jar" jarfile="dist/library.jar" basedir="build/classes" compress="true"/>
  </targets>

</Ant:Project>