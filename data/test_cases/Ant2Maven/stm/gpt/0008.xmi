<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="Ant2MavenSample08"
    basedir="."
    description="Ant project exercising multiple predefined tasks"
    default="build-target">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="target/classes"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="target/dist"/>

  <!-- Task definition (unreferenced, as required) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default build target -->
  <targets xmi:id="build-target" name="build" description="Compile sources and package jar">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="target/dist/app-0008.jar" basedir="target/classes" compress="true"/>
  </targets>

  <!-- Additional test target -->
  <targets xmi:id="cleanup-target" name="clean" description="Clean generated output">
    <tasks xsi:type="Ant:Delete" dir="target" verbose="true" quiet="false" failonerror="true"/>
  </targets>

</Ant:Project>