<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="."
    description="Ant project exercising multiple predefined tasks."
    default="build-main">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/classes"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="dist"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition (standalone, not referenced by any task) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Targets -->
  <targets xmi:id="build-main" name="build" description="Compile sources, package jar and generate javadoc">
    <!-- 1) Create output directories -->
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>

    <!-- 2) Compile Java sources with several optional attributes -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>

    <!-- 3) Package compiled classes into a jar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/app-main.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>

    <!-- 4) Copy additional resources into the dist directory with nested structures -->
    <tasks xsi:type="Ant:Copy"
           todir="dist/resources"
           overwrite="true"
           flatten="false"
           includeEmptyDirs="true">
      <fileset dir="src/main/resources"/>
    </tasks>

    <!-- 5) Generate Javadoc -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="dist/javadoc"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="ComplexBuild API"/>
  </targets>

  <targets xmi:id="clean-target" name="clean" description="Remove build and distribution artifacts">
    <!-- Delete build directory -->
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           defaultexcludes="yes"/>
    <!-- Delete dist directory -->
    <tasks xsi:type="Ant:Delete"
           dir="dist"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           defaultexcludes="yes"/>
  </targets>

  <targets xmi:id="resources-only" name="copy-resources" description="Copy only non-code resources">
    <tasks xsi:type="Ant:Mkdir" dir="build/resources-only"/>
    <tasks xsi:type="Ant:Copy"
           todir="build/resources-only"
           filtering="false"
           includeEmptyDirs="false">
      <fileset dir="src/shared/resources"/>
    </tasks>
  </targets>
</Ant:Project>