<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiPhaseBuild"
    basedir="."
    description="Project with separate compile, jar, and cleanup targets"
    default="compileTarget">

  <!-- Default compile target with Javac and Mkdir -->
  <targets xmi:id="compileTarget" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="on" fork="off" optimize="on" deprecation="off"/>
  </targets>

  <!-- Packaging target with Jar task -->
  <targets xmi:id="packageTarget" name="package" description="Package compiled classes into a jar">
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/multiphase-build.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>

  <!-- Cleanup target with Delete task -->
  <targets xmi:id="cleanTarget" name="clean" description="Remove build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" defaultexcludes="true"/>
  </targets>

</Ant:Project>