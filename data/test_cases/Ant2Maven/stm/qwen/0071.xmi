<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    default="build-all"
    basedir="."
    description="A comprehensive Ant project for testing ATL transformation">
  <targets xmi:id="init" name="init" description="Initialize directories">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile source code">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="true"/>
  </targets>
  <targets xmi:id="doc" name="doc" description="Generate documentation">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="docs/api"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="Sample Project API"/>
  </targets>
  <targets xmi:id="package" name="package" description="Package into JAR">
    <tasks xsi:type="Ant:Jar"
        jarfile="dist/app.jar"
        basedir="build/classes"
        compress="true"
        manifest="MANIFEST.MF"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" dir="docs" includeEmptyDirs="true"/>
  </targets>
  <targets xmi:id="build-all" name="build-all" description="Full build cycle">
    <tasks xsi:type="Ant:Copy"
        todir="build/resources"
        overwrite="true"
        filtering="true">
      <fileset dir="resources">
        <include name="**/*.properties"/>
        <exclude name="**/temp/**"/>
      </fileset>
      <filterset starttoken="@" endtoken="@">
        <filter token="VERSION" value="1.0.0"/>
        <filter token="BUILD_DATE" value="2024-06-15"/>
      </filterset>
      <mapper type="glob" from="*.template" to="*"/>
    </tasks>
  </targets>
</Ant:Project>