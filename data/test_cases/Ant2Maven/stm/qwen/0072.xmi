<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleBuild"
    default="build-all"
    basedir="."
    description="Comprehensive build script for testing ATL transformation">
  <targets xmi:id="init" name="init" description="Initialize directories">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/test-classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/site"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile main sources">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" deprecation="true"/>
  </targets>
  <targets xmi:id="test-compile" name="test-compile" description="Compile test sources">
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="target/test-classes" debug="true" classpath="target/classes"/>
  </targets>
  <targets xmi:id="jar" name="jar" description="Package main classes into JAR">
    <tasks xsi:type="Ant:Jar" jarfile="target/sample-1.0.jar" basedir="target/classes" manifest="src/main/resources/MANIFEST.MF"/>
  </targets>
  <targets xmi:id="javadoc" name="javadoc" description="Generate API documentation">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src/main/java" destdir="target/site/apidocs" packagenames="com.example.*" author="true" version="true" use="true" windowtitle="Sample API"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Remove all generated files">
    <tasks xsi:type="Ant:Delete" dir="target" includeEmptyDirs="true"/>
  </targets>
  <targets xmi:id="build-all" name="build-all" description="Full build cycle">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="target/sample-1.0.jar" basedir="target/classes"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src/main/java" destdir="target/site/apidocs" packagenames="com.example.*" author="true" version="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="project.version" value="1.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="target"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
</Ant:Project>