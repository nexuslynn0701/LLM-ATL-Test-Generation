<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    default="build"
    basedir="."
    description="A sample Ant project for transformation testing">
  <targets xmi:id="init" name="init" description="Initialize directories">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/docs"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/dist"/>
  </targets>
  <targets xmi:id="build" name="build" description="Compile and package">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="target/classes" debug="true" fork="true"/>
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="target/docs"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="Sample API"/>
    <tasks xsi:type="Ant:Jar"
        jarfile="target/dist/app.jar"
        basedir="target/classes"
        compress="true"
        manifest="MANIFEST.MF"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="target" includeEmptyDirs="true"/>
  </targets>
  <properties>
    <PropertyValue name="project.version" value="1.0.0"/>
    <PropertyLocation name="config.dir" location="conf"/>
    <PropertyFile file="build.properties"/>
    <PropertyEnv environment="BUILD_ENV"/>
  </properties>
</Ant:Project>