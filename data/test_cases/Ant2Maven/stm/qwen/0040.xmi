<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    default="build"
    basedir="."
    description="A sample project for testing ATL transformation">
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/test-classes"/>
  </targets>
  <targets xmi:id="build" name="build" description="Compiles source and packages JAR">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" fork="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="target/sample.jar" basedir="target/classes" manifest="src/main/resources/MANIFEST.MF"/>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="target" includeEmptyDirs="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="project.version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.dir" location="conf"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
</Ant:Project>