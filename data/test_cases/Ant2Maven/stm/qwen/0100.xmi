<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    default="build"
    basedir="."
    description="A sample Ant project for transformation testing">
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="target"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <targets xmi:id="init" name="init" description="Initialize directories">
    <tasks xsi:type="Ant:Mkdir" dir="${build.dir}"/>
    <tasks xsi:type="Ant:Mkdir" dir="${build.dir}/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="${build.dir}/docs"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile source code">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="${build.dir}/classes" debug="true" fork="true"/>
  </targets>
  <targets xmi:id="doc" name="doc" description="Generate documentation">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="${build.dir}/docs"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="Sample API Documentation"/>
  </targets>
  <targets xmi:id="package" name="package" description="Package compiled classes into JAR">
    <tasks xsi:type="Ant:Jar"
        jarfile="${build.dir}/sample.jar"
        basedir="${build.dir}/classes"
        compress="true"
        manifest="MANIFEST.MF"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="${build.dir}" includeEmptyDirs="true"/>
  </targets>
  <targets xmi:id="build" name="build" description="Full build lifecycle">
    <tasks xsi:type="Ant:Copy"
        todir="${build.dir}/resources"
        overwrite="true"
        filtering="true">
      <fileset dir="resources"/>
      <filterset starttoken="@" endtoken="@">
        <filter token="VERSION" value="1.0.0"/>
      </filterset>
    </tasks>
  </targets>
</Ant:Project>