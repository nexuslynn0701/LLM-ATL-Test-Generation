<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    default="build"
    basedir="."
    description="A sample Ant project for transformation testing">
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="${build.dir}"/>
  </targets>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="${src.dir}" destdir="${build.dir}" debug="true" fork="true"/>
  </targets>
  <targets xmi:id="doc" name="doc">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="${src.dir}"
        destdir="docs/api"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="Sample API"/>
  </targets>
  <targets xmi:id="package" name="package">
    <tasks xsi:type="Ant:Jar"
        jarfile="target/sample.jar"
        basedir="${build.dir}"
        compress="true"
        manifest="MANIFEST.MF"/>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="${build.dir}" quiet="true"/>
    <tasks xsi:type="Ant:Delete" dir="docs/api" quiet="true"/>
    <tasks xsi:type="Ant:Delete" file="target/sample.jar" quiet="true"/>
  </targets>
  <targets xmi:id="build" name="build" description="Main build target">
    <tasks xsi:type="Ant:Copy"
        todir="target/resources"
        overwrite="true"
        filtering="true">
      <fileset dir="src/main/resources"/>
      <filterset starttoken="@" endtoken="@">
        <filter token="VERSION" value="1.0.0"/>
      </filterset>
    </tasks>
  </targets>
</Ant:Project>