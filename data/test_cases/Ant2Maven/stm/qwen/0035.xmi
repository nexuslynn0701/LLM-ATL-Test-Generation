<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildSystem"
    default="package"
    basedir="."
    description="Comprehensive build script for testing ATL transformation">
  <targets xmi:id="init" name="init" description="Initialize directories">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="true"/>
  </targets>
  <targets xmi:id="doc" name="doc" description="Generate documentation">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="docs/api"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="My Project API"/>
  </targets>
  <targets xmi:id="package" name="package" description="Package into JAR">
    <tasks xsi:type="Ant:Jar"
        jarfile="dist/app.jar"
        basedir="build/classes"
        compress="true"
        manifest="MANIFEST.MF"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" includeEmptyDirs="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
</Ant:Project>