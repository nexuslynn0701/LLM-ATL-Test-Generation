<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    default="build-all"
    basedir="."
    description="A sample Ant project for transformation testing">
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="target/classes"/>
  <properties xsi:type="Ant:PropertyValue" name="dist.dir" value="target/dist"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="env"/>
  <path id="compile.classpath">
    <pathElement path="lib/commons-lang3.jar" location="lib/commons-lang3.jar"/>
    <fileset dir="lib">
      <include name="*.jar"/>
    </fileset>
  </path>
  <taskdef name="mytask" classname="com.example.MyTask"/>
  <targets xmi:id="init" name="init" description="Initialize directories">
    <tasks xsi:type="Ant:Mkdir" dir="${build.dir}"/>
    <tasks xsi:type="Ant:Mkdir" dir="${dist.dir}"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile source code">
    <tasks xsi:type="Ant:Javac" srcdir="${src.dir}" destdir="${build.dir}" debug="true" fork="true">
      <classPath refid="compile.classpath"/>
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/test/**/*.java"/>
    </tasks>
  </targets>
  <targets xmi:id="jar" name="jar" description="Package compiled classes into JAR">
    <tasks xsi:type="Ant:Jar" jarfile="${dist.dir}/sample.jar" basedir="${build.dir}" compress="true"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="${build.dir}" quiet="true"/>
    <tasks xsi:type="Ant:Delete" dir="${dist.dir}" quiet="true"/>
  </targets>
  <targets xmi:id="build-all" name="build-all" description="Full build cycle">
    <tasks xsi:type="Ant:Copy" todir="${build.dir}/resources">
      <fileset dir="src/main/resources"/>
    </tasks>
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="${src.dir}"
        destdir="${dist.dir}/apidocs"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="Sample API Documentation"/>
  </targets>
</Ant:Project>