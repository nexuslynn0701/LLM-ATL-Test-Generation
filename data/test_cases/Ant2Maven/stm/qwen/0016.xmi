<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    default="build"
    basedir="."
    description="A sample Ant project for transformation testing">
  <properties xsi:type="Ant:PropertyValue" name="version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="target"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <path id="compile.classpath">
    <pathElement path="lib/commons-lang3.jar" location="lib"/>
    <fileset dir="lib">
      <include name="*.jar"/>
    </fileset>
  </path>
  <targets xmi:id="init" name="init" description="Initialize directories">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/docs"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile source code">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="target/classes" debug="true" fork="true">
      <classPath refid="compile.classpath"/>
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/test/**"/>
    </tasks>
  </targets>
  <targets xmi:id="doc" name="doc" description="Generate documentation">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="target/docs"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="Sample API"/>
  </targets>
  <targets xmi:id="package" name="package" description="Package compiled classes into JAR">
    <tasks xsi:type="Ant:Jar"
        jarfile="target/sample-1.0.0.jar"
        basedir="target/classes"
        compress="true"
        manifest="MANIFEST.MF"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="target" includeEmptyDirs="true"/>
  </targets>
  <targets xmi:id="build" name="build" description="Full build lifecycle">
    <tasks xsi:type="Ant:Copy"
        todir="target/resources"
        overwrite="true"
        filtering="true">
      <fileset dir="src/main/resources">
        <include name="**/*.properties"/>
      </fileset>
      <filterset starttoken="@" endtoken="@">
        <filter token="VERSION" value="1.0.0"/>
        <filtersfile file="filters.txt"/>
      </filterset>
      <mapper type="glob" from="*.template" to="*"/>
    </tasks>
  </targets>
</Ant:Project>