<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="AntSample33"
    default="build"
    basedir="project-src"
    description="Ant to Maven transformation sample 0033">
  <!-- Properties: one of each concrete subtype -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- User-defined task definition (not referenced by tasks, per constraints) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Targets -->
  <targets xmi:id="build" name="build" description="Compile and package project">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="target/ant-sample33.jar"
           basedir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="target/site"/>
    <tasks xsi:type="Ant:Delete"
           dir="target/temp"/>
  </targets>

  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete"
           dir="target"/>
  </targets>

  <targets xmi:id="documentation" name="documentation" description="Generate Javadoc">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="target/site/apidocs"
           packagenames="com.example.antsample33.*"
           defaultexcludes="true"
           author="Example Author"
           version="1.0.0"
           use="true"
           windowtitle="Ant Sample 0033 API"/>
  </targets>
</Ant:Project>