<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntProject18"
    basedir="workspace/module18"
    description="Sample Ant project 18 for ATL Ant2Maven testing"
    default="buildTarget">
  <properties xsi:type="Ant:PropertyValue" name="compile.debug" value="true"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="workspace/module18/build"/>
  <properties xsi:type="Ant:PropertyFile" file="workspace/module18/config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="custom.task" classname="org.example.ant.CustomTask"/>
  <targets xmi:id="buildTarget" name="build-main" description="Main build target">
    <tasks xsi:type="Ant:Javac"
           srcdir="workspace/module18/src"
           destdir="workspace/module18/bin"
           debug="on"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="workspace/module18/dist/sample18.jar"
           basedir="workspace/module18/bin"
           compress="true"
           encoding="UTF-8"
           manifest="workspace/module18/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="workspace/module18/dist"/>
    <tasks xsi:type="Ant:Delete"
           dir="workspace/module18/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           excludes="**/keep/**"
           defaultexcludes="true"/>
  </targets>
  <targets xmi:id="docTarget" name="generate-docs" description="Generate Javadoc">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="workspace/module18/src"
           destdir="workspace/module18/docs/api"
           packagenames="org.example.sample18.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Sample 18 API Documentation"/>
  </targets>
</Ant:Project>