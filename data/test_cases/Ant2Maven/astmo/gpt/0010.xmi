<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="Ant2MavenDemoProj10"
    default="buildMain"
    basedir="project-root"
    description="Ant to Maven transformation demo project 10">
  <!-- Properties covering all subclasses -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition (will be mapped by AntTaskDef2MavenMavenTaskDef) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target with multiple tasks, exercising several task rules -->
  <targets xmi:id="buildMain" name="buildMain" description="Main build target">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="target/apidocs"
           packagenames="com.example.demo"
           defaultexcludes="true"
           author="true"
           version="1.0"
           use="true"
           windowtitle="Demo Project 10 API"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="target/demo10.jar"
           basedir="target/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="target/generated-sources"/>
    <tasks xsi:type="Ant:Copy"
           file="README.md"
           todir="target/package"
           overwrite="true"
           filtering="false"
           flatten="false"
           includeEmptyDirs="false">
      <fileset dir="resources/base"/>
      <filterset starttoken="@{" endtoken="}">
        <filter token="project.name" value="Ant2MavenDemoProj10"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
    </tasks>
    <tasks xsi:type="Ant:Delete"
           dir="target/tmp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           excludes="**/keep/**"
           defaultexcludes="true"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>

  <!-- Additional target with different tasks -->
  <targets xmi:id="cleanup" name="cleanup" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete"
           dir="target"
           verbose="true"
           quiet="false"
           failonerror="false"
           includeEmptyDirs="true"
           includes="**/*"
           excludes="logs/**"
           defaultexcludes="true"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="target/logs"/>
  </targets>
</Ant:Project>