<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="libraryProject"
    basedir="project-root"
    description="Ant to Maven migration sample"
    default="buildTarget">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/project.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition (user-defined task) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default Target 'buildTarget' -->
  <targets xmi:id="buildTarget" name="buildTarget" description="Compile sources and package jar">
    <tasks xsi:type="Ant:Mkdir" target="//@targets.0" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           target="//@targets.0"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
           target="//@targets.0"
           jarfile="dist/library.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Additional Target 'cleanTarget' -->
  <targets xmi:id="cleanTarget" name="cleanTarget" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete"
           target="//@targets.1"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.class"
           excludes="**/keep/**"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>