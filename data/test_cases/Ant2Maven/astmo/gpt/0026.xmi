<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ant2maven-sample-project"
    basedir="workspace"
    description="Ant project exercising multiple Ant2Maven rules"
    default="build-main">

  <!-- Properties of all subtypes -->
  <properties xsi:type="Ant:PropertyValue" name="compile.debug" value="true"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.output.dir" location="workspace/target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="workspace/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- User-defined task definition -->
  <taskdef name="custom.echo" classname="com.example.ant.CustomEchoTask"/>

  <!-- Targets -->
  <targets xmi:id="build-main" name="build-main" description="Main build target">
    <tasks xsi:type="Ant:Javac"
           srcdir="workspace/src/main/java"
           destdir="workspace/target/classes"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="workspace/target/app-main.jar"
           basedir="workspace/target/classes"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="workspace/target/test-output"/>
    <tasks xsi:type="Ant:Delete"
           dir="workspace/target/temp"/>
  </targets>

  <targets xmi:id="build-tests" name="build-tests" description="Test compilation target">
    <tasks xsi:type="Ant:Javac"
           srcdir="workspace/src/test/java"
           destdir="workspace/target/test-classes"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="workspace/target/app-tests.jar"
           basedir="workspace/target/test-classes"/>
  </targets>

</Ant:Project>