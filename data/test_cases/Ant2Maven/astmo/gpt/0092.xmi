<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuildProject"
    basedir="project-root"
    description="Complex Ant project to exercise multiple ATL rules"
    default="buildTarget">
  <!-- Properties of all four concrete kinds -->
  <properties xsi:type="Ant:PropertyValue" name="main.class" value="com.example.Main"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="lib/"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- A path with nested path element and fileset -->
  <path id="compile.classpath">
    <pathElement path="lib/*" location="lib/commons.jar"/>
    <fileset dir="lib">
      <patternset>
        <inexcludes xsi:type="Ant:Includes" name="**/*.jar"/>
      </patternset>
      <include name="**/*.jar"/>
      <exclude name="**/test-*.jar"/>
    </fileset>
  </path>

  <!-- A filterset with both filter and filtersfile -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>
  <taskdef name="another.task" classname="com.example.ant.AnotherTask"/>

  <targets xmi:id="initTarget" name="init" description="Initialize build directories">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/dist"/>
  </targets>

  <targets xmi:id="buildTarget" name="build" description="Compile and package">
    <!-- Compile task with inExcludes and classPath -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**"/>
      <classPath refid="compile.classpath">
        <pathElement path="build/classes" location="build/classes"/>
        <fileset dir="lib/optional">
          <include name="**/*.jar"/>
        </fileset>
      </classPath>
    </tasks>

    <!-- Javadoc task -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/javadoc"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Example API"/>

    <!-- Jar task -->
    <tasks xsi:type="Ant:Jar"
           jarfile="build/dist/example.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>

    <!-- Copy task using fileset, filterset and mapper -->
    <tasks xsi:type="Ant:Copy"
           todir="build/dist/resources"
           overwrite="true"
           includeEmptyDirs="false">
      <fileset dir="src/main/resources">
        <include name="**/*.*"/>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="project.name" value="ComplexBuildProject"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
      <mapper type="glob"
              from="*.properties"
              to="*.cfg"/>
    </tasks>

    <!-- Delete task -->
    <tasks xsi:type="Ant:Delete"
           dir="build/tmp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes="**/*.lock"
           defaultexcludes="true"/>
  </targets>

  <targets xmi:id="timestampTarget" name="timestamp" description="Generate build timestamp">
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp"
              pattern="yyyy-MM-dd'T'HH:mm:ss"
              offset="+0"
              unit="second"
              locale="en_US"/>
    </tasks>
  </targets>
</Ant:Project>