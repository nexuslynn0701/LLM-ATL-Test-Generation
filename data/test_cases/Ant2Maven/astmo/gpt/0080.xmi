<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="sample-ant-project"
    basedir="workspace"
    description="Sample Ant project for Ant2Maven transformation"
    default="buildTarget">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="project.name" value="SampleProject"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="workspace/build"/>
  <properties xsi:type="Ant:PropertyFile" file="workspace/config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition (user-defined task) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Targets -->

  <!-- Build target (default) -->
  <targets xmi:id="buildTarget" name="build" description="Full build including compile and packaging">
    <tasks xsi:type="Ant:Javac" srcdir="workspace/src" destdir="workspace/classes"/>
    <tasks xsi:type="Ant:Jar" jarfile="workspace/dist/sample.jar" basedir="workspace/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="workspace/logs"/>
    <tasks xsi:type="Ant:Delete" dir="workspace/temp"/>
  </targets>

  <!-- Test target -->
  <targets xmi:id="testTarget" name="test" description="Run tests">
    <tasks xsi:type="Ant:Javac" srcdir="workspace/test-src" destdir="workspace/test-classes"/>
  </targets>

</Ant:Project>