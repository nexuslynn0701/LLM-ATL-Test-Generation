<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="complexProject0066"
    basedir="workspace"
    description="Project with multiple targets and properties"
    default="buildMain">
  <!-- Path declared but kept simple (no nested references as required) -->
  <path id="mainPath"/>

  <!-- Properties of all four concrete kinds -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- One TaskDef, not referenced by any task -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target containing several different tasks to exercise rules -->
  <targets xmi:id="buildMain" name="buildMain" description="Main build target">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="target/app-0066.jar"
           basedir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="target/test-classes"/>
    <tasks xsi:type="Ant:Delete"
           dir="target/temp"/>
  </targets>

  <!-- Second target to increase Goal count, with different tasks -->
  <targets xmi:id="runTests" name="runTests" description="Execute unit tests">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="target/test-classes"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="target/reports"/>
    <tasks xsi:type="Ant:Delete"
           dir="target/old-reports"/>
  </targets>
</Ant:Project>