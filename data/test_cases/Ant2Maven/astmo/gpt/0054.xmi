<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntProject0054"
    basedir="project-root"
    description="Sample project for Ant2Maven test 0054"
    default="buildMain">
  <properties xsi:type="Ant:PropertyValue" name="compile.debug" value="true"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/project.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>
  <targets xmi:id="buildMain" name="buildMain" description="Main build target">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" fork="false" optimize="true">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/test/**"/>
    </tasks>
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample-0054.jar" basedir="build/classes" compress="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/temp"/>
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="true"/>
  </targets>
  <targets xmi:id="docs" name="docs" description="Generate Javadoc">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="Sample Ant2Maven Project 0054"/>
  </targets>
</Ant:Project>