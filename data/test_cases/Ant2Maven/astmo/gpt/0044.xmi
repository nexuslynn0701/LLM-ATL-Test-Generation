<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryManager"
    basedir="lib-src"
    description="Ant build for LibraryManager project"
    default="build-main">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="project.name" value="LibraryManager"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.dir" location="config"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition (standalone, not referenced by tasks) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Targets -->
  <targets xmi:id="build-main" name="build-main" description="Compile and package main artifacts">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="on"
           deprecation="off"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="build/lib/library-manager.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="build/lib"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="false"
           includes="**/*.tmp"
           includesfile="config/includes.txt"
           excludes="**/*.bak"
           excludesfile="config/excludes.txt"
           defaultexcludes="true"/>
  </targets>

  <targets xmi:id="docs" name="docs" description="Generate project documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.library.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="LibraryManager API"/>
  </targets>

  <!-- Path with nested elements and fileset -->
  <path id="compile.path">
    <pathElement path="lib/dependency1.jar" location="lib/dependency1.jar"/>
    <pathElement path="lib/dependency2.jar" location="lib/dependency2.jar"/>
    <fileset dir="lib/extra">
      <patternset>
        <inexcludes xsi:type="Ant:Includes" name="**/*.jar"/>
        <inexcludes xsi:type="Ant:Excludes" name="**/old/*"/>
      </patternset>
      <include name="**/*.zip"/>
      <exclude name="**/*.tmp"/>
    </fileset>
  </path>

</Ant:Project>