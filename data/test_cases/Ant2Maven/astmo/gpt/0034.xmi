<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntProject34"
    basedir="project-src"
    description="Ant project for ATL Ant2Maven test 34"
    default="buildTarget">
  <!-- Path used as dependency-like structure (no refid, no external refs) -->
  <path id="mainPath">
    <pathElement path="lib/sample.jar" location="lib/sample.jar"/>
    <fileset dir="resources">
      <patternset>
        <inexcludes xsi:type="Ant:Includes" name="**/*.properties"/>
        <inexcludes xsi:type="Ant:Excludes" name="**/temp/**"/>
      </patternset>
      <include name="config/*.xml"/>
      <exclude name="backup/**"/>
    </fileset>
  </path>

  <!-- Properties of all four concrete kinds -->
  <properties xsi:type="Ant:PropertyValue" name="build.mode" value="debug"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/app.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="config/global.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- One task definition not referenced by any NewTask -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target -->
  <targets xmi:id="buildTarget" name="buildTarget" description="Main build target">
    <!-- Compilation task with simple inExcludes and no classPath refs -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**"/>
    </tasks>

    <!-- Archive task -->
    <tasks xsi:type="Ant:Jar" jarfile="build/sample-project.jar" basedir="build/classes"/>

    <!-- File management tasks -->
    <tasks xsi:type="Ant:Mkdir" dir="build/output"/>
    <tasks xsi:type="Ant:Copy" todir="build/output">
      <fileset dir="resources">
        <include name="**/*.xml"/>
      </fileset>
      <filterset starttoken="@" endtoken="@">
        <filter token="projectName" value="SampleAntProject34"/>
      </filterset>
    </tasks>
    <tasks xsi:type="Ant:Delete" dir="build/temp"/>
  </targets>

  <!-- Additional target to exercise multiple Target → Goal mapping -->
  <targets xmi:id="docsTarget" name="docsTarget" description="Generate documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Sample Project 34 API"/>
    <!-- Timestamp management task -->
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp" pattern="yyyy-MM-dd HH:mm:ss" offset="0" unit="second" locale="en_US"/>
    </tasks>
  </targets>
</Ant:Project>