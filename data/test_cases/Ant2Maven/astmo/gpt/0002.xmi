<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntProject"
    basedir="workspace"
    description="Ant project with multiple tasks and properties"
    default="build">
  <!-- Properties of all four concrete kinds -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/app.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- One user-defined taskdef (not referenced by tasks) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target: build -->
  <targets xmi:id="build" name="build" description="Compile and package">
    <!-- Compile Java sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"/>
    <!-- Create jar from compiled classes -->
    <tasks xsi:type="Ant:Jar"
           jarfile="target/complex-ant-project.jar"
           basedir="target/classes"/>
    <!-- Prepare output directory -->
    <tasks xsi:type="Ant:Mkdir"
           dir="target/output"/>
    <!-- Clean temporary directory -->
    <tasks xsi:type="Ant:Delete"
           dir="target/tmp"/>
  </targets>

  <!-- Additional target: test (no depends) -->
  <targets xmi:id="test" name="test" description="Run tests">
    <!-- Compile test sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="target/test-classes"/>
    <!-- Package tests into a jar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="target/tests.jar"
           basedir="target/test-classes"/>
    <!-- Create reports directory -->
    <tasks xsi:type="Ant:Mkdir"
           dir="target/test-reports"/>
    <!-- Delete old reports -->
    <tasks xsi:type="Ant:Delete"
           dir="target/old-test-reports"/>
  </targets>
</Ant:Project>