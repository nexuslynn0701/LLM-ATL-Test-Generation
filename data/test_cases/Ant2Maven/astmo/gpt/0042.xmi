<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="AdvancedAntProject"
    basedir="project-root"
    description="Ant project exercising multiple tasks and properties"
    default="buildTarget">
  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/project.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task Definition -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default/Build Target -->
  <targets xmi:id="buildTarget" name="build" description="Compile sources and create jar">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="false"
           deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/advanced-app.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Secondary Target -->
  <targets xmi:id="cleanupTarget" name="cleanup" description="Prepare and clean build output">
    <tasks xsi:type="Ant:Mkdir" dir="build/temp"/>
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="true" quiet="false"/>
  </targets>
</Ant:Project>