<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="AntMavenSample9"
    basedir="workspace"
    description="Project for exercising Ant2Maven transformation rules."
    default="buildTarget">
  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="project.name" value="AntMavenSample9"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/project.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition (not referenced by tasks, to avoid forbidden taskName usage) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Targets -->
  <targets xmi:id="buildTarget" name="build" description="Compile and package">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="build/artifacts/app-sample9.jar"
           basedir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="build/logs"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/temp"/>
  </targets>

  <targets xmi:id="docTarget" name="doc" description="Generate Javadoc">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.sample9"
           defaultexcludes="true"
           author="Sample Author"
           version="1.0.0"
           use="true"
           windowtitle="Sample9 API"/>
  </targets>

  <!-- Path structure to exercise Path/FileSet/PatternSet/Includes/Excludes/FilterSet/Filter/FiltersFile/PathElement -->
  <path id="compile.path">
    <fileset dir="lib">
      <patternset>
        <inexcludes xsi:type="Ant:Includes" name="**/*.jar"/>
        <inexcludes xsi:type="Ant:Excludes" name="**/test-*.jar"/>
      </patternset>
      <include name="core/*.jar"/>
      <exclude name="old/*.jar"/>
    </fileset>
    <pathElement path="lib/extra.jar" location="lib/extra.jar"/>
  </path>
</Ant:Project>