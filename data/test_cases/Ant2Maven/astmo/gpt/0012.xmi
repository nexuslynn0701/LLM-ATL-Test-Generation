<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryManager"
    basedir="lib-src"
    description="Ant build for LibraryManager project"
    default="build-main">

  <!-- Properties: one of each subtype to exercise all property rules -->
  <properties xsi:type="Ant:PropertyValue" name="lib.output.dir" value="build/lib"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.config.path" location="config/library.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- A standalone TaskDef (no taskName references) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Targets: two distinct ones; default references build-main -->
  <targets xmi:id="build-main" name="build-main" description="Compile sources and create jar">
    <!-- Javac with minimal attributes -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes"/>
    <!-- Jar task using required jarfile attribute -->
    <tasks xsi:type="Ant:Jar" jarfile="dist/library-manager.jar" basedir="build/classes"/>
    <!-- Mkdir to prepare an output directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build/temp"/>
    <!-- Delete to clean a temporary directory -->
    <tasks xsi:type="Ant:Delete" dir="build/temp"/>
  </targets>

  <targets xmi:id="build-tests" name="build-tests" description="Compile test sources and package tests">
    <!-- Another Javac task to exercise multiple instances -->
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="build/test-classes"/>
    <!-- Another Jar task for tests -->
    <tasks xsi:type="Ant:Jar" jarfile="dist/library-manager-tests.jar" basedir="build/test-classes"/>
  </targets>

</Ant:Project>