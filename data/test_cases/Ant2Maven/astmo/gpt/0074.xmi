<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleBuild74"
    basedir="project-src"
    description="Sample Ant project for Ant2Maven testing"
    default="mainTarget">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="target/build"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="conf/app.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="conf/global.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition (not referenced by tasks, as required) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Targets -->
  <targets xmi:id="mainTarget" name="mainTarget" description="Main build target">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="target/samplebuild74.jar"
           basedir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="target/generated-resources"/>
    <tasks xsi:type="Ant:Delete"
           dir="target/tmp"/>
  </targets>

  <targets xmi:id="testTarget" name="testTarget" description="Test compilation target">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="target/test-classes"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="target/test-output"/>
  </targets>

</Ant:Project>