<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntProject"
    basedir="workspace"
    description="Ant build with multiple tasks and properties"
    default="build-main">
  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition (not referenced by tasks, per safety rules) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Targets -->
  <targets xmi:id="build-main" name="build-main" description="Main build target">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="target/complex-ant-project.jar"
           basedir="target/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="target/test-classes"/>
    <tasks xsi:type="Ant:Delete"
           dir="target/tmp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="false"
           includes="**/*.tmp"
           includesfile="config/includes.txt"
           excludes="**/*.bak"
           excludesfile="config/excludes.txt"
           defaultexcludes="true"/>
  </targets>

  <targets xmi:id="build-tests" name="build-tests" description="Compile test sources">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="target/test-classes"
           debug="true"
           fork="false"
           optimize="false"
           deprecation="true"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="target/reports"/>
  </targets>

  <!-- Path (contained, no external references) -->
  <path id="compile.path">
    <pathElement path="lib/dependency.jar" location="lib/dependency.jar"/>
  </path>
</Ant:Project>