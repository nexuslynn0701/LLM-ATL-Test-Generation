<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntProject"
    basedir="project-root"
    description="Ant project with multiple tasks and properties"
    default="buildMain">

  <!-- Properties of all four concrete kinds -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/app.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- A standalone TaskDef (not referenced by any task) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- First target: default build target, with various tasks -->
  <targets xmi:id="buildMain" name="buildMain" description="Main build target">
    <!-- Compile sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"/>
    <!-- Package into jar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="build/lib/app.jar"
           basedir="build/classes"/>
    <!-- Create output directory -->
    <tasks xsi:type="Ant:Mkdir"
           dir="build/output"/>
    <!-- Clean temporary files -->
    <tasks xsi:type="Ant:Delete"
           dir="build/temp"/>
  </targets>

  <!-- Second target: test build target, different tasks -->
  <targets xmi:id="buildTest" name="buildTest" description="Test build target">
    <!-- Compile test sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="build/test-classes"/>
    <!-- Package tests jar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="build/lib/tests.jar"
           basedir="build/test-classes"/>
    <!-- Create test reports directory -->
    <tasks xsi:type="Ant:Mkdir"
           dir="build/test-reports"/>
    <!-- Delete old reports -->
    <tasks xsi:type="Ant:Delete"
           dir="build/old-test-reports"/>
  </targets>

</Ant:Project>