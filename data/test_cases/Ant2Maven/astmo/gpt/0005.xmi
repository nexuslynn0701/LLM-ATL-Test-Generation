<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntBuild"
    basedir="project-root"
    description="Ant build with multiple tasks and properties"
    default="compileTarget">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition (user-defined task) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Targets -->
  <targets xmi:id="compileTarget" name="compileTarget" description="Compile Java sources">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false">
      <!-- simple in/excludes on Javac -->
      <inExcludes xsi:type="Ant:Includes" name="**/*.java" ifCondition="compileIf" unless=""/>
      <inExcludes xsi:type="Ant:Excludes" name="**/test/**" ifCondition="" unless="skipTests"/>
    </tasks>

    <tasks xsi:type="Ant:Jar"
           jarfile="build/libs/app.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>

    <tasks xsi:type="Ant:Mkdir" dir="build/docs"/>

    <tasks xsi:type="Ant:Delete"
           file="build/temp.tmp"
           dir="build/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="false"
           includes="**/*.log"
           includesfile="config/includes.txt"
           excludes="**/old/**"
           excludesfile="config/excludes.txt"
           defaultexcludes="true"/>

    <!-- Javadoc task -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Example API"/>
  </targets>

  <targets xmi:id="packageTarget" name="packageTarget" description="Package distribution">
    <!-- Copy with FileSet, PatternSet, FilterSet, Mapper, FiltersFile, Filter -->
    <tasks xsi:type="Ant:Copy"
           todir="dist"
           file=""
           presservelastmodified="true"
           tofile=""
           overwrite="true"
           filtering="true"
           flatten="false"
           includeEmptyDirs="true">
      <fileset dir="build/classes">
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="**/*.class" ifCondition="" unless=""/>
          <inexcludes xsi:type="Ant:Excludes" name="**/internal/**" ifCondition="" unless=""/>
        </patternset>
        <include name="**/*.class" ifCondition="" unless=""/>
        <exclude name="**/temp/**" ifCondition="" unless=""/>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="project.name" value="ComplexAntBuild"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
      <mapper type="glob" classname="" classpath="" classpathref="" from="*.class" to="*.bin"/>
    </tasks>

    <!-- Tstamp task with FormatTstamp -->
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp"
              pattern="yyyy-MM-dd HH:mm:ss"
              offset="0"
              unit="second"
              locale="en_US"/>
    </tasks>
  </targets>

</Ant:Project>