<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="DemoAntProject46"
    basedir="project-root"
    description="Ant build for DemoAntProject46"
    default="buildTarget">

  <!-- Properties: one of each subtype -->
  <properties xsi:type="Ant:PropertyValue" name="build.mode" value="release"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.dir" location="config"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition and attribute -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>
  <taskdef name="another.task" classname="com.example.ant.AnotherTask"/>
  <taskdef name="third.task" classname="com.example.ant.ThirdTask"/>

  <!-- Path structure with FileSet, PatternSet, Includes/Excludes, PathElement, FilterSet -->
  <path id="lib.path">
    <fileset dir="lib">
      <patternset>
        <inexcludes xsi:type="Ant:Includes" name="**/*.jar"/>
        <inexcludes xsi:type="Ant:Excludes" name="**/test-*.jar"/>
      </patternset>
      <include name="**/*.jar"/>
      <exclude name="**/old/*.jar"/>
    </fileset>
    <pathElement path="lib/special.jar" location="lib/special.jar"/>
  </path>

  <!-- A ClassPath using PathElement and FileSet -->
  <path>
    <fileset dir="ext-libs">
      <include name="**/*.jar"/>
    </fileset>
    <pathElement path="ext/tool.jar" location="ext/tool.jar"/>
  </path>

  <!-- Standalone FileSet and FilterSet with Filters -->
  <path>
    <fileset dir="resources">
      <patternset>
        <inexcludes xsi:type="Ant:IncludesFile" name="includes.txt"/>
      </patternset>
      <exclude name="**/temp/**"/>
    </fileset>
    <fileset dir="more-resources">
      <patternset>
        <inexcludes xsi:type="Ant:ExcludesFile" name="excludes.txt"/>
      </patternset>
    </fileset>
  </path>

  <path id="filter.path">
    <fileset dir="filtered">
      <include name="**/*.properties"/>
    </fileset>
    <pathElement path="filtered/config.properties" location="filtered/config.properties"/>
  </path>

  <!-- Targets -->
  <!-- Default build target -->
  <targets xmi:id="buildTarget" name="buildTarget" description="Main build target">
    <!-- Compile Java sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false">
      <classPath refid="lib.path">
        <pathElement path="build/classes" location="build/classes"/>
        <fileset dir="lib-extra">
          <include name="**/*.jar"/>
        </fileset>
      </classPath>
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**"/>
    </tasks>

    <!-- Create jar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/demo-46.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>

    <!-- Make distribution directory -->
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>

    <!-- Copy resources with filters and mapper -->
    <tasks xsi:type="Ant:Copy"
           todir="build/resources"
           overwrite="true"
           flatten="false"
           includeEmptyDirs="true">
      <fileset dir="src/main/resources">
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="**/*"/>
        </patternset>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="project.name" value="DemoAntProject46"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
      <mapper type="glob" from="*.txt" to="*.cfg" classname="com.example.Mapper" classpath="lib/mapper.jar"/>
    </tasks>

    <!-- Delete temporary build directory -->
    <tasks xsi:type="Ant:Delete"
           dir="build/tmp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="false"
           includes="**/*"
           excludes="**/keep/**"
           defaultexcludes="true"/>

    <!-- Timestamp task -->
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp" pattern="yyyy-MM-dd HH:mm:ss" offset="0" unit="second" locale="en_US"/>
    </tasks>

    <!-- Javadoc task -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="dist/javadoc"
           packagenames="com.example.demo.*"
           defaultexcludes="true"
           author="yes"
           version="yes"
           use="yes"
           windowtitle="DemoAntProject46 API"/>
  </targets>

  <!-- Test target -->
  <targets xmi:id="testTarget" name="testTarget" description="Run tests">
    <!-- Compile test sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="build/test-classes"
           debug="true">
      <classPath refid="lib.path">
        <pathElement path="build/test-classes" location="build/test-classes"/>
      </classPath>
      <inExcludes xsi:type="Ant:Includes" name="**/*Test.java"/>
    </tasks>

    <!-- Make test reports directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build/test-reports"/>

    <!-- Delete old test reports -->
    <tasks xsi:type="Ant:Delete"
           dir="build/test-reports"
           quiet="true"
           defaultexcludes="false"/>
  </targets>

</Ant:Project>