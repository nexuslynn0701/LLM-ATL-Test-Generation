<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiRuleProject"
    basedir="projectSrc"
    description="Ant project exercising multiple Ant2Maven rules"
    default="mainTarget">

  <!-- Properties of all four concrete kinds -->
  <properties xsi:type="Ant:PropertyValue"
      name="build.mode"
      value="release"/>
  <properties xsi:type="Ant:PropertyLocation"
      name="output.dir"
      location="build/output"/>
  <properties xsi:type="Ant:PropertyFile"
      file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv"
      environment="JAVA_HOME"/>

  <!-- A simple task definition (not referenced by any NewTask) -->
  <taskdef
      name="custom.task"
      classname="com.example.ant.CustomTask"/>

  <!-- Default target with several tasks -->
  <targets xmi:id="mainTarget" name="mainTarget" description="Main build target">
    <tasks xsi:type="Ant:Javac"
        srcdir="projectSrc"
        destdir="build/classes"
        debug="true"
        fork="false"
        optimize="true"
        deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
        jarfile="dist/MultiRuleProject.jar"
        basedir="build/classes"
        compress="true"
        encoding="UTF-8"/>
    <tasks xsi:type="Ant:Mkdir"
        dir="build/logs"/>
    <tasks xsi:type="Ant:Delete"
        dir="build/temp"
        verbose="true"
        quiet="false"
        failonerror="true"
        includeEmptyDirs="false"
        includes="**/*.tmp"
        excludes="**/keep/**"/>
  </targets>

  <!-- Secondary target with different tasks -->
  <targets xmi:id="docTarget" name="docTarget" description="Documentation generation target">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="projectSrc"
        destdir="build/docs"
        packagenames="com.example.*"
        defaultexcludes="true"
        author="true"
        version="true"
        use="true"
        windowtitle="MultiRule Project API"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>

</Ant:Project>