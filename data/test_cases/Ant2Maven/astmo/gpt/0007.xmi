<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntProject"
    basedir="workspace"
    description="Ant project with multiple targets and properties"
    default="build">
  <!-- Properties of all four concrete kinds -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/settings.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- A TaskDef that will be copied but not referenced by tasks -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default build target -->
  <targets xmi:id="build" name="build" description="Compile sources and package JAR">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java" ifCondition="" unless=""/>
      <inExcludes xsi:type="Ant:Excludes" name="**/test/**" ifCondition="" unless=""/>
    </tasks>
    <tasks xsi:type="Ant:Jar"
           jarfile="target/complex-ant-project.jar"
           basedir="target/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Auxiliary target creating and cleaning build directories -->
  <targets xmi:id="prepare" name="prepare" description="Prepare build directories">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/test-classes"/>
    <tasks xsi:type="Ant:Delete" dir="target/temp" verbose="true" quiet="false"
           failonerror="true" includeEmptyDirs="false"
           includes="**/*" includesfile="" excludes="" excludesfile=""
           defaultexcludes="true"/>
  </targets>
</Ant:Project>