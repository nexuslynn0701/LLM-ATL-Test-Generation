<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntProject"
    basedir="workspace"
    description="Ant project with multiple targets and tasks"
    default="buildTarget">

  <!-- Properties of all four concrete kinds -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/project.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- One simple TaskDef (unreferenced by tasks, as required) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Path with a PathElement and FileSet (no refid / external refs) -->
  <path id="compile.path">
    <pathElement path="lib/dependency.jar" location="lib/dependency.jar"/>
    <fileset dir="lib">
      <include name="**/*.jar"/>
      <exclude name="**/tests/**"/>
      <patternset>
        <inexcludes xsi:type="Ant:Includes" name="**/*.jar"/>
        <inexcludes xsi:type="Ant:Excludes" name="**/*-sources.jar"/>
      </patternset>
    </fileset>
  </path>

  <!-- Targets -->
  <targets xmi:id="buildTarget" name="build" description="Main build target">
    <!-- Compile Java sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**"/>
    </tasks>

    <!-- Create JAR from compiled classes -->
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/sample-project.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <targets xmi:id="prepareTarget" name="prepare" description="Prepare output directories">
    <!-- Create build directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <!-- Create distribution directory -->
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>

  <targets xmi:id="cleanTarget" name="clean" description="Clean build artifacts">
    <!-- Delete build directory -->
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           defaultexcludes="true"/>
    <!-- Delete distribution directory -->
    <tasks xsi:type="Ant:Delete"
           dir="dist"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>