<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="Ant2MavenDemo70"
    basedir="demo-src"
    description="Ant to Maven transformation demo project 0070"
    default="build-main">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="demo-src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="demo-target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/demo.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="DEMO_ENV"/>

  <!-- Task definition (user-defined task) -->
  <taskdef name="custom.task" classname="org.example.ant.CustomTask"/>

  <!-- Targets -->
  <targets xmi:id="build-main" name="build-main" description="Main build target">
    <tasks xsi:type="Ant:Javac"
           srcdir="demo-src/main/java"
           destdir="demo-target/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="demo-target/artifacts/demo-0070.jar"
           basedir="demo-target/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="demo-target/resources"/>
    <tasks xsi:type="Ant:Delete"
           dir="demo-target/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="false"
           includes="**/*.tmp"
           includesfile="config/includes.txt"
           excludes="**/*.keep"
           excludesfile="config/excludes.txt"
           defaultexcludes="true"/>
  </targets>

  <targets xmi:id="build-docs" name="build-docs" description="Generate documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="demo-src/main/java"
           destdir="demo-target/docs"
           packagenames="org.example.demo"
           defaultexcludes="true"
           author="Demo Author"
           version="1.0.70"
           use="true"
           windowtitle="Demo Project 0070 API"/>
  </targets>

</Ant:Project>