<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntProject"
    basedir="project-root"
    description="Sample Ant project for Ant2Maven testing"
    default="buildTarget">

  <!-- Properties of all supported kinds -->
  <properties xsi:type="Ant:PropertyValue" name="project.name" value="SampleAntProject"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- One task definition (not referenced by any task) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target with multiple tasks -->
  <targets xmi:id="buildTarget" name="build" description="Main build target">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/sample-project.jar"
           basedir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="dist"/>
    <tasks xsi:type="Ant:Delete"
           dir="temp"/>
  </targets>

  <!-- Additional target to increase goal coverage -->
  <targets xmi:id="docTarget" name="doc" description="Generate Javadoc">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="Sample Project API"/>
  </targets>

</Ant:Project>