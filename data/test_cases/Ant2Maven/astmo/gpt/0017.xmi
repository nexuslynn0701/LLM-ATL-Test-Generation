<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntBuild"
    basedir="project-src"
    description="Ant build with multiple tasks and properties"
    default="compileTarget">

  <!-- Properties: one of each concrete subtype -->
  <properties xsi:type="Ant:PropertyValue" name="build.mode" value="debug"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- One task definition, not referenced by tasks (per safety rules) -->
  <taskdef name="custom.task" classname="org.example.ant.CustomTask"/>

  <!-- First target: default, exercises Javac and Jar -->
  <targets xmi:id="compileTarget" name="compile" description="Compile and package classes">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="false"
           deprecation="true"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/complex-build.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Second target: exercises Mkdir and Delete -->
  <targets xmi:id="cleanupTarget" name="cleanup" description="Clean generated files">
    <tasks xsi:type="Ant:Mkdir"
           dir="temp"/>
    <tasks xsi:type="Ant:Delete"
           dir="temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           includesfile="config/includes.txt"
           excludes="**/keep/**"
           excludesfile="config/excludes.txt"
           defaultexcludes="false"/>
  </targets>

</Ant:Project>