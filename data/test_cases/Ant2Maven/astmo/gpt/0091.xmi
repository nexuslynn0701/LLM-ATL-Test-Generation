<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntProject"
    basedir="project-root"
    description="Ant project with multiple targets and properties"
    default="build-main">
  <!-- Properties: one of each subtype -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/app.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="BUILD_ENV"/>

  <!-- Task definition (not referenced by tasks, per safety rules) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target with several tasks -->
  <targets xmi:id="build-main" name="build-main" description="Main build target">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="target/app-main.jar"
           basedir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="target/generated-resources"/>
    <tasks xsi:type="Ant:Delete"
           dir="target/tmp"/>
  </targets>

  <!-- Additional target with different tasks -->
  <targets xmi:id="build-docs" name="build-docs" description="Generate project documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="target/site/apidocs"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="ComplexAntProject API"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
</Ant:Project>