<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    xmi:id="proj0090"
    name="ComplexAntProject0090"
    basedir="project-root"
    description="Ant project for ATL Ant2Maven testing 0090"
    default="buildTarget">

  <!-- Properties: one of each subtype -->
  <properties xsi:type="Ant:PropertyValue" name="compile.level" value="1.8"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="BUILD_ENV"/>

  <!-- Task definition, not referenced by tasks (per safety rules) -->
  <taskdef name="customTask0090" classname="org.example.ant.CustomTask0090"/>

  <!-- Default target with multiple tasks -->
  <targets xmi:id="buildTarget" name="buildTarget" description="Main build target">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/complex-ant-project-0090.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="build/logs"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.tmp"
           includesfile="config/includes.txt"
           excludes="**/*.keep"
           excludesfile="config/excludes.txt"
           defaultexcludes="true"/>
  </targets>

  <!-- Additional target with a different task mix -->
  <targets xmi:id="docsTarget" name="docsTarget" description="Generate project documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="org.example.project0090.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="ComplexAntProject0090 API"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="build/docs/site"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/docs/temp"
           verbose="false"
           quiet="true"
           failonerror="false"
           includeEmptyDirs="false"
           includes="**/*.bak"
           includesfile="config/docs-includes.txt"
           excludes="**/*.html"
           excludesfile="config/docs-excludes.txt"
           defaultexcludes="false"/>
  </targets>

</Ant:Project>