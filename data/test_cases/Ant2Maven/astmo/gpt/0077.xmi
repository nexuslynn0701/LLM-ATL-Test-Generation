<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntProject77"
    default="buildTarget"
    basedir="project-root"
    description="Ant project for ATL Ant2Maven rule coverage">
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>
  <path id="compile.classpath">
    <pathElement path="lib/commons-lang3.jar" location="lib/commons-lang3.jar"/>
    <pathElement path="lib/commons-io.jar" location="lib/commons-io.jar"/>
    <fileset dir="lib">
      <patternset>
        <inexcludes xsi:type="Ant:Includes" name="**/*.jar"/>
        <inexcludes xsi:type="Ant:Excludes" name="**/test-*.jar"/>
      </patternset>
      <include name="**/*.jar"/>
      <exclude name="**/deprecated/*.jar"/>
    </fileset>
  </path>
  <targets xmi:id="buildTarget" name="build" description="Compile and package sources">
    <tasks xsi:type="Ant:Mkdir" target="buildTarget" dir="target/classes"/>
    <tasks xsi:type="Ant:Javac" target="buildTarget" srcdir="src/main/java" destdir="target/classes">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <classPath refid="compile.classpath">
        <pathElement path="lib/additional.jar" location="lib/additional.jar"/>
      </classPath>
    </tasks>
    <tasks xsi:type="Ant:Jar" target="buildTarget" jarfile="target/sample-project-77.jar" basedir="target/classes" compress="true"/>
  </targets>
  <targets xmi:id="cleanTarget" name="clean" description="Clean build outputs">
    <tasks xsi:type="Ant:Delete" target="cleanTarget" dir="target" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" includes="**/*" defaultexcludes="false"/>
  </targets>
</Ant:Project>