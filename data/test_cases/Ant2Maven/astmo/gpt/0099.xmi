<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="Ant2MavenSample99"
    default="build"
    basedir="project-root"
    description="Ant to Maven transformation test project 0099">
  <!-- Properties: one of each subtype -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <!-- One user-defined task definition -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>
  <!-- Default target with multiple tasks -->
  <targets xmi:id="build" name="build" description="Compile and package">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="target/sample99.jar"
           basedir="target/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="target/test-output"/>
    <tasks xsi:type="Ant:Delete"
           dir="target/obsolete"/>
  </targets>
  <!-- Additional target to increase rule coverage -->
  <targets xmi:id="docs" name="docs" description="Generate Javadoc">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="target/site/apidocs"
           packagenames="com.example.ant2maven"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Ant2Maven Sample 99 API"/>
  </targets>
</Ant:Project>