<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntProject30"
    basedir="workspace"
    description="Ant project for ATL Ant2Maven testing #30"
    default="buildTarget">
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/project.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>
  <targets xmi:id="buildTarget" name="build" description="Main build target">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample30.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist/logs"/>
    <tasks xsi:type="Ant:Delete" dir="build/tmp" verbose="true" quiet="false" failonerror="true"/>
  </targets>
  <targets xmi:id="cleanTarget" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
  </targets>
</Ant:Project>