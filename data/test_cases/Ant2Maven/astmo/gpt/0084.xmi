<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="AntMavenSample84"
    basedir="project-root"
    description="Ant to Maven transformation coverage project"
    default="build-target">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="conf/app.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="conf/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="BUILD_ENV"/>

  <!-- Task definition (not referenced by any task) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Targets -->
  <targets xmi:id="build-target" name="build" description="Main build target">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app84.jar" basedir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist/logs"/>
    <tasks xsi:type="Ant:Delete" dir="build/tmp"/>
  </targets>

  <targets xmi:id="docs-target" name="docs" description="Documentation generation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src"
           destdir="dist/docs"
           packagenames="com.example"
           defaultexcludes="true"
           author="true"
           version="1.0"
           use="true"
           windowtitle="Ant2Maven Sample 84 API"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>

</Ant:Project>