<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MDEAntProject20"
    basedir="project-root"
    description="Ant build for MDE experiment 0020"
    default="build">
  <!-- Properties: one of each subtype -->
  <properties xsi:type="Ant:PropertyValue" name="source.encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.dir" location="config"/>
  <properties xsi:type="Ant:PropertyFile" file="env.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <!-- A task definition (not referenced by tasks) -->
  <taskdef name="customLogger" classname="org.example.ant.CustomLogger"/>
  <!-- Targets -->
  <targets xmi:id="build" name="build" description="Compile main sources">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="target/mde-ant20.jar"
           basedir="target/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="target/generated-resources"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build output">
    <tasks xsi:type="Ant:Delete"
           dir="target"/>
  </targets>
</Ant:Project>