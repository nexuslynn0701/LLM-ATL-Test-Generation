<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntBuild"
    basedir="project-root"
    description="Sample Ant build with multiple tasks and properties"
    default="buildTarget">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task Definition -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default Build Target -->
  <targets xmi:id="buildTarget" name="build" description="Compile, jar and prepare build">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="build/lib/sample-ant-build.jar"
           basedir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="build/logs"/>
    <tasks xsi:type="Ant:Delete"
           dir="build/temp"/>
  </targets>

  <!-- Additional Target -->
  <targets xmi:id="docTarget" name="generate-docs" description="Generate Javadoc">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="SampleAntBuild API"/>
  </targets>

</Ant:Project>