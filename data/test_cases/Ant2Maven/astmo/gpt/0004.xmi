<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntProject"
    basedir="workspace"
    description="Ant build for a multi-step Java application"
    default="build-main">

  <!-- Path with nested PathElement and FileSet -->
  <path id="main.path">
    <pathElement path="lib/app.jar" location="lib/app.jar"/>
    <fileset dir="lib">
      <include name="**/*.jar"/>
      <exclude name="**/test/**"/>
      <patternset>
        <inexcludes xsi:type="Ant:Includes" name="**/*.jar"/>
        <inexcludes xsi:type="Ant:Excludes" name="**/internal/**"/>
      </patternset>
    </fileset>
  </path>

  <!-- Properties of all four concrete types -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir.location" location="build"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition and attribute used by NewTask rule (though NewTask is forbidden, TaskDef and Attribut are allowed) -->
  <taskdef name="customTask" classname="org.example.ant.CustomTask"/>
  <taskdef name="loggingTask" classname="org.example.ant.LoggingTask"/>

  <!-- Targets -->
  <targets xmi:id="build-main" name="build-main" description="Compile, package, and prepare distribution">
    <!-- Compile task with classpath and includes/excludes -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="false">
      <classPath refid="javac.classpath">
        <pathElement path="lib/commons-lang3.jar" location="lib/commons-lang3.jar"/>
        <fileset dir="lib">
          <include name="**/*.jar"/>
        </fileset>
      </classPath>
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/experimental/**"/>
    </tasks>

    <!-- Jar packaging task -->
    <tasks xsi:type="Ant:Jar" jarfile="dist/app-main.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="manifest.mf"/>

    <!-- Directory creation -->
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>

    <!-- Copy with FileSet, FilterSet, Mapper, FiltersFile, Filter -->
    <tasks xsi:type="Ant:Copy" todir="dist/resources" overwrite="true" filtering="true" flatten="false" includeEmptyDirs="true">
      <fileset dir="resources">
        <include name="**/*.*"/>
        <exclude name="**/*.tmp"/>
        <patternset>
          <inexcludes xsi:type="Ant:IncludesFile" name="include.list" ifCondition="enabled" unless=""/>
          <inexcludes xsi:type="Ant:ExcludesFile" name="exclude.list" ifCondition="" unless="disabled"/>
        </patternset>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="projectName" value="ComplexAntProject"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
      <mapper type="glob" from="*.txt" to="*.cfg" classname="org.example.ant.CustomMapper" classpath="lib/mapper.jar" classpathref="mapper.classpath"/>
    </tasks>

    <!-- Delete old build directory -->
    <tasks xsi:type="Ant:Delete" dir="build/old" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="false"
           includes="**/*" includesfile="" excludes="**/keep/**" excludesfile="" defaultexcludes="true"/>
  </targets>

  <targets xmi:id="build-docs" name="build-docs" description="Generate Javadoc and timestamp">
    <!-- Javadoc generation -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="dist/docs"
           packagenames="org.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="ComplexAntProject API"/>

    <!-- Timestamp management -->
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp" pattern="yyyy-MM-dd HH:mm:ss" offset="+0" unit="second" locale="en_US"/>
    </tasks>
  </targets>

  <targets xmi:id="cleanup" name="cleanup" description="Remove temporary and output directories">
    <!-- Delete distribution directory -->
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" failonerror="false" includeEmptyDirs="true"
           includes="**/*" includesfile="" excludes="**/*.keep" excludesfile="" defaultexcludes="true"/>
    <!-- Delete build directory -->
    <tasks xsi:type="Ant:Delete" dir="build" verbose="false" quiet="true" failonerror="true" includeEmptyDirs="true"
           includes="**/*" includesfile="" excludes="" excludesfile="" defaultexcludes="false"/>
  </targets>

</Ant:Project>