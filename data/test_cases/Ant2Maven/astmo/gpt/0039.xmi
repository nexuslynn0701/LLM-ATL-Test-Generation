<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntProject39"
    basedir="project-root"
    description="Ant build for SampleAntProject39"
    default="mainTarget">

  <!-- Path with one PathElement and one FileSet (no refid, no nested path) -->
  <path xsi:type="Ant:Path" id="lib.path">
    <pathElement path="lib/sample.jar" location="lib/sample.jar"/>
    <fileset dir="lib">
      <patternset>
        <inexcludes xsi:type="Ant:Includes" name="**/*.jar"/>
      </patternset>
    </fileset>
  </path>

  <!-- Properties of all four concrete kinds -->
  <properties xsi:type="Ant:PropertyValue" name="build.mode" value="debug"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/build.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="config/global.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- A standalone TaskDef (not referenced by any NewTask) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target with several predefined tasks -->
  <targets xmi:id="mainTarget" name="mainTarget" description="Main build target">
    <!-- Compile task with classPath and includes/excludes -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="false" deprecation="false">
      <classPath refid="javac.classpath">
        <pathElement path="build/classes" location="build/classes"/>
        <fileset dir="lib">
          <patternset>
            <inexcludes xsi:type="Ant:IncludesFile" name="lib-includes.txt"/>
          </patternset>
          <include name="**/*.jar"/>
          <exclude name="**/test-*"/>
        </fileset>
      </classPath>
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/experimental/**"/>
    </tasks>

    <!-- Documentation task -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.sample39.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="SampleAntProject39 API"/>

    <!-- Archive task -->
    <tasks xsi:type="Ant:Jar" jarfile="build/artifacts/sample39.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="META-INF/MANIFEST.MF"/>

    <!-- File management tasks -->
    <tasks xsi:type="Ant:Mkdir" dir="build/output"/>
    <tasks xsi:type="Ant:Copy" file="build/artifacts/sample39.jar" todir="build/output" overwrite="true">
      <fileset dir="build/output">
        <include name="**/*"/>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="project.name" value="SampleAntProject39"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
    </tasks>
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="false" includes="**/*" defaultexcludes="true"/>

    <!-- Management properties task -->
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp" pattern="yyyyMMdd-HHmmss" offset="0" unit="second" locale="en_US"/>
    </tasks>
  </targets>

  <!-- Additional target to increase rule coverage -->
  <targets xmi:id="cleanupTarget" name="cleanupTarget" description="Cleanup target">
    <tasks xsi:type="Ant:Mkdir" dir="build/temp"/>
    <tasks xsi:type="Ant:Delete" file="build/old.log" quiet="true"/>
  </targets>

</Ant:Project>