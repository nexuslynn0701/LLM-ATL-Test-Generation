<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="AntMavenSampleProject"
    basedir="workspace"
    description="Sample Ant project for Ant2Maven transformation testing"
    default="buildTarget">

  <!-- PropertyValue -->
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/output"/>
  <!-- PropertyLocation -->
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="lib"/>
  <!-- PropertyFile -->
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <!-- PropertyEnv -->
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- TaskDef (standalone, no taskName references) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target with several tasks -->
  <targets xmi:id="buildTarget" name="build" description="Compile, jar and cleanup build">
    <!-- Javac task -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <!-- Jar task -->
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/ant-maven-sample.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="MANIFEST.MF"/>
    <!-- Mkdir task -->
    <tasks xsi:type="Ant:Mkdir"
           dir="build/logs"/>
    <!-- Delete task -->
    <tasks xsi:type="Ant:Delete"
           dir="build/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="false"
           includes="**/*.tmp"
           excludes="**/keep/**"
           defaultexcludes="true"/>
  </targets>

  <!-- Additional target to ensure multiple Goal creation -->
  <targets xmi:id="docsTarget" name="generate-docs" description="Generate project documentation">
    <!-- Javadoc task -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.sample.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Ant Maven Sample API"/>
  </targets>

</Ant:Project>