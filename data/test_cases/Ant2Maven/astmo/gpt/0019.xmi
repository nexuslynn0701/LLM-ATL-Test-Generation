<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleBuild"
    basedir="workspace"
    description="Sample Ant build with multiple tasks and properties"
    default="buildTarget">
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/output"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="conf/config.xml"/>
  <properties xsi:type="Ant:PropertyFile" file="conf/project.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>
  <targets xmi:id="buildTarget" name="build" description="Main build target">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample-app.jar" basedir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist/logs"/>
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="true"/>
  </targets>
  <targets xmi:id="docTarget" name="doc" description="Generate documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="Sample Project API"/>
  </targets>
</Ant:Project>