<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntProject"
    basedir="project-src"
    description="Ant project with multiple targets and properties"
    default="build-main">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/app.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition (not referenced by tasks, but transformed) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Targets -->
  <targets xmi:id="build-main" name="build-main" description="Main build target">
    <!-- Compile Java sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <!-- Package into jar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="target/app-main.jar"
           basedir="target/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <!-- Create output directory -->
    <tasks xsi:type="Ant:Mkdir" dir="target/output"/>
    <!-- Clean temporary directory -->
    <tasks xsi:type="Ant:Delete" dir="target/tmp"/>
  </targets>

  <targets xmi:id="build-tests" name="build-tests" description="Build test artifacts">
    <!-- Compile test sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="target/test-classes"
           debug="false"
           fork="false"
           optimize="false"
           deprecation="true"/>
    <!-- Package tests into jar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="target/app-tests.jar"
           basedir="target/test-classes"
           compress="false"
           encoding="ISO-8859-1"
           manifest="META-INF/TEST-MANIFEST.MF"/>
    <!-- Create test reports directory -->
    <tasks xsi:type="Ant:Mkdir" dir="target/test-reports"/>
    <!-- Delete old reports -->
    <tasks xsi:type="Ant:Delete" dir="target/old-reports"/>
  </targets>

</Ant:Project>