<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="AntMavenDemo"
    basedir="workspace"
    description="Ant to Maven integration demo project"
    default="buildMain">

  <!-- Properties of all four subtypes -->
  <properties xsi:type="Ant:PropertyValue" name="app.name" value="DemoApp"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.dir" location="conf"/>
  <properties xsi:type="Ant:PropertyFile" file="conf/app.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- A standalone TaskDef (not referenced by tasks) -->
  <taskdef name="custom.task" classname="org.example.ant.CustomTask"/>

  <!-- Default target with a variety of tasks -->
  <targets xmi:id="buildMain" name="buildMain" description="Main build target">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="target/demoapp.jar"
           basedir="target/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/test-reports"/>
    <tasks xsi:type="Ant:Delete" dir="target/temp" verbose="true"/>
  </targets>

  <!-- Additional target with documentation and management tasks -->
  <targets xmi:id="docsAndCleanup" name="docsAndCleanup" description="Generate docs and clean artifacts">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="target/site/apidocs"
           packagenames="org.example.demo.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Demo Application API"/>
    <tasks xsi:type="Ant:Tstamp"/>
    <tasks xsi:type="Ant:Copy"
           todir="backup/output"/>
  </targets>

</Ant:Project>