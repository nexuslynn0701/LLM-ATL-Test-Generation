<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntProject32"
    basedir="project-root32"
    description="Ant build with multiple property and file tasks"
    default="buildTarget32">
  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="source.dir" value="src32"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build32"/>
  <properties xsi:type="Ant:PropertyFile" file="config32.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- User-defined task definition -->
  <taskdef name="customTask32" classname="com.example.ant.CustomTask32"/>

  <!-- Targets -->
  <targets xmi:id="buildTarget32" name="buildTarget32" description="Main build target">
    <tasks xsi:type="Ant:Javac"
           srcdir="src32"
           destdir="build32/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false">
    </tasks>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist32/app32.jar"
           basedir="build32/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="build32/temp"/>
    <tasks xsi:type="Ant:Delete"
           dir="build32/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="false"
           includes="**/*.tmp"
           excludes="**/keep/**"
           defaultexcludes="true"/>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src32"
           destdir="docs32"
           packagenames="com.example.app32.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="App32 API Documentation"/>
    <tasks xsi:type="Ant:Tstamp"/>
    <tasks xsi:type="Ant:Copy"
           todir="dist32/resources"
           overwrite="true"
           filtering="false"
           flatten="false"
           includeEmptyDirs="true">
      <fileset dir="resources32"/>
      <filterset starttoken="@{" endtoken="}">
        <filter token="app.name" value="App32"/>
      </filterset>
    </tasks>
  </targets>

  <targets xmi:id="testTarget32" name="testTarget32" description="Test execution target">
    <tasks xsi:type="Ant:Javac"
           srcdir="test-src32"
           destdir="build32/test-classes"
           debug="true"
           fork="false"
           optimize="false"
           deprecation="true">
    </tasks>
    <tasks xsi:type="Ant:Mkdir"
           dir="build32/reports"/>
    <tasks xsi:type="Ant:Delete"
           dir="build32/reports"
           verbose="false"
           quiet="true"
           failonerror="false"
           includeEmptyDirs="true"
           includes="**/*.old"
           excludes=""
           defaultexcludes="false"/>
  </targets>
</Ant:Project>