<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntProject"
    basedir="project-src"
    description="Ant project with multiple targets and properties"
    default="build-main">

  <!-- Path definition (no cross refs used) -->
  <path id="mainPath">
    <pathElement path="lib/dependency.jar" location="lib/dependency.jar"/>
  </path>

  <!-- Properties of all four concrete kinds -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="target/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- One TaskDef (not referenced by tasks) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target with several tasks -->
  <targets xmi:id="build-main" name="build-main" description="Main build target">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="target/complex-project.jar"
           basedir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir"
           dir="target/test-classes"/>
    <tasks xsi:type="Ant:Delete"
           dir="target/temp"/>
  </targets>

  <!-- Secondary target with different tasks -->
  <targets xmi:id="build-docs" name="build-docs" description="Generate Javadoc">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="target/site/apidocs"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Complex Project API"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>

</Ant:Project>