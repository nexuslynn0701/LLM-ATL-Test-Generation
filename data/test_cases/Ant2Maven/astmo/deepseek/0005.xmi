<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleBuild"
    basedir="."
    description="Sample build project"
    default="build">
  <targets xmi:id="build" name="build" description="Main build target">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" fork="false" optimize="false" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="target/sample.jar" basedir="target/classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="target" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="false" defaultexcludes="true"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run tests">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src/main/java" destdir="target/docs" packagenames="com.example.*" defaultexcludes="true" author="true" version="true" use="true" windowtitle="Sample API"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="target"/>
  <properties xsi:type="Ant:PropertyLocation" name="basedir.location" location="."/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customtask" classname="com.example.CustomTask"/>
</Ant:Project>