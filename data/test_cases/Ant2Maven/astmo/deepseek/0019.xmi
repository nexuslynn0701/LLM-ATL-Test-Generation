<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="DataPipeline"
    description="Build and package the data processing pipeline"
    basedir="/opt/pipeline"
    default="package">
  <targets xmi:id="package" name="package" description="Package the application">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" fork="false" optimize="false" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/pipeline.jar" basedir="target/classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/reports"/>
    <tasks xsi:type="Ant:Delete" dir="target/temp" verbose="false" quiet="true" failonerror="false" includeEmptyDirs="false" includes="*.tmp" excludes="keep.txt" defaultexcludes="true"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run unit tests">
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="target/test-classes" debug="true" fork="true" optimize="false" deprecation="true"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src/main/java" destdir="target/docs" packagenames="com.example.*" defaultexcludes="true" author="true" version="true" use="true" windowtitle="Pipeline API"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Remove build artifacts">
    <tasks xsi:type="Ant:Delete" dir="target" verbose="false" quiet="false" failonerror="false" includeEmptyDirs="true" defaultexcludes="false"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.version" value="1.2.3"/>
  <properties xsi:type="Ant:PropertyValue" name="encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.dir" location="/etc/pipeline"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customtask" classname="com.example.CustomTask"/>
</Ant:Project>