<?xml version="1.0" encoding="ASCII"?>
<Ant:Project xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Ant="Ant" name="DataProcessingProject" basedir="/opt/data" description="Data processing pipeline" default="process">
  <properties xsi:type="Ant:PropertyValue" name="input.dir" value="/data/input"/>
  <properties xsi:type="Ant:PropertyValue" name="output.dir" value="/data/output"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="/etc/app/config.xml"/>
  <properties xsi:type="Ant:PropertyFile" file="/etc/app/default.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customtask" classname="com.example.CustomTask"/>
  <targets xmi:id="init" name="init" description="Initialize directories">
    <tasks xsi:type="Ant:Mkdir" dir="/data/input"/>
    <tasks xsi:type="Ant:Mkdir" dir="/data/output"/>
    <tasks xsi:type="Ant:Delete" dir="/data/temp"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile sources">
    <tasks xsi:type="Ant:Javac" srcdir="/opt/data/src" destdir="/opt/data/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
  </targets>
  <targets xmi:id="package" name="package" description="Package application">
    <tasks xsi:type="Ant:Jar" jarfile="/opt/data/dist/app.jar" basedir="/opt/data/classes" compress="true" encoding="UTF-8" manifest="/opt/data/MANIFEST.MF"/>
  </targets>
  <targets xmi:id="process" name="process" description="Process data">
    <tasks xsi:type="Ant:Copy" file="/opt/data/input/data.txt" todir="/opt/data/output" overwrite="true" filtering="false" flatten="false" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="/opt/data/src" destdir="/opt/data/docs" packagenames="com.example.*" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="Data Processing API"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyy-MM-dd HH:mm:ss" locale="en_US"/>
    </tasks>
  </targets>
</Ant:Project>