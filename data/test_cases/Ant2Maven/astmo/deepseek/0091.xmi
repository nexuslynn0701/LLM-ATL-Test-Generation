<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildSystem"
    basedir="/project"
    description="Main build configuration"
    default="build">
  <targets xmi:id="build" name="build" description="Compile and package">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="target/app.jar" basedir="target/classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Remove build artifacts">
    <tasks xsi:type="Ant:Delete" dir="target" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="false" includes="*.class" excludes="*.java" defaultexcludes="true"/>
  </targets>
  <targets xmi:id="init" name="init" description="Initialize directories">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/dist"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyValue" name="author" value="Development Team"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="/project/target"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customtask" classname="com.example.CustomTask"/>
</Ant:Project>