<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleBuild"
    basedir="."
    description="Sample build project for testing"
    default="main">
  <targets xmi:id="main" name="main" description="Main build target">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample.jar" basedir="classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/generated"/>
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="false" includes="*.tmp" excludes="keep.txt" defaultexcludes="true"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="classes" verbose="false" quiet="true" failonerror="false" includeEmptyDirs="true" defaultexcludes="false"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="false" quiet="true" failonerror="false" includeEmptyDirs="true" defaultexcludes="false"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run tests">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="test-classes" debug="true" fork="true" optimize="false" deprecation="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/test.jar" basedir="test-classes" compress="false" encoding="ISO-8859-1"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyValue" name="project.name" value="SampleBuild"/>
  <properties xsi:type="Ant:PropertyLocation" name="source.dir" location="src"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="classes"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customTask" classname="com.example.CustomTask"/>
</Ant:Project>