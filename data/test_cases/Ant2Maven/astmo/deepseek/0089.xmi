<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    default="build"
    basedir="."
    description="Sample Ant project for transformation testing">
  <targets xmi:id="build" name="build" description="Main build target">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="classes" debug="true" fork="false" optimize="false" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample.jar" basedir="classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/generated"/>
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="false" quiet="true" failonerror="false" includeEmptyDirs="false" includes="*.tmp" excludes="keep.txt" defaultexcludes="true"/>
    <tasks xsi:type="Ant:Copy" file="README.txt" todir="build/docs" overwrite="true" filtering="false" flatten="false" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="docs/api" packagenames="com.example.*" defaultexcludes="true" author="true" version="true" use="true" windowtitle="Sample API"/>
    <tasks xsi:type="Ant:Java" classname="com.example.Main" jar="lib/example.jar" fork="true"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyy-MM-dd HH:mm:ss" offset="1" unit="hour" locale="en_US"/>
    </tasks>
  </targets>
  <targets xmi:id="test" name="test" description="Test target">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="test-classes" debug="true" fork="true" optimize="false" deprecation="true"/>
    <tasks xsi:type="Ant:Delete" dir="test-output" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="false" includes="*.log" defaultexcludes="false"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="target"/>
  <properties xsi:type="Ant:PropertyLocation" name="home.dir" location="/home/user"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="PATH"/>
  <taskdef name="customTask" classname="com.example.CustomTask"/>
  <path id="compile.path">
    <pathElement path="lib/one.jar" location="lib"/>
    <pathElement path="lib/two.jar" location="lib"/>
  </path>
  <path id="resource.path">
    <fileset dir="resources">
      <include name="**/*.xml"/>
      <exclude name="**/*.bak"/>
    </fileset>
  </path>
</Ant:Project>