<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    description="A sample project for testing"
    basedir="src"
    default="build">
  <targets xmi:id="build" name="build" description="Build target">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="bin" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample.jar" basedir="bin" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="false" includes="*.tmp" excludes="*.log" defaultexcludes="true"/>
  </targets>
  <targets xmi:id="test" name="test" description="Test target">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="docs/api" packagenames="com.example.*" defaultexcludes="false" author="true" version="true" use="true" windowtitle="Sample API"/>
    <tasks xsi:type="Ant:Copy" file="README.md" todir="dist" overwrite="true" filtering="false" flatten="true" includeEmptyDirs="false"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyy-MM-dd HH:mm:ss" offset="1" unit="hour" locale="en_US"/>
    </tasks>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="home.dir" location="/home/user"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customTask" classname="com.example.CustomTask"/>
</Ant:Project>