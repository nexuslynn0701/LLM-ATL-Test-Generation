<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleBuild"
    default="deploy"
    basedir="/project"
    description="Sample build project">
  <properties xsi:type="Ant:PropertyValue" name="version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="/project/lib"/>
  <properties xsi:type="Ant:PropertyFile" file="/project/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customtask" classname="com.example.CustomTask"/>
  <targets xmi:id="clean" name="clean" description="Clean build directory">
    <tasks xsi:type="Ant:Delete" dir="/project/build"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile sources">
    <tasks xsi:type="Ant:Mkdir" dir="/project/build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="/project/src" destdir="/project/build/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
  </targets>
  <targets xmi:id="package" name="package" description="Create JAR">
    <tasks xsi:type="Ant:Jar" jarfile="/project/dist/app.jar" basedir="/project/build/classes" compress="true" encoding="UTF-8" manifest="/project/MANIFEST.MF"/>
  </targets>
  <targets xmi:id="deploy" name="deploy" description="Deploy application">
    <tasks xsi:type="Ant:Copy" file="/project/dist/app.jar" todir="/project/deploy" overwrite="true" filtering="false" flatten="false" includeEmptyDirs="false"/>
  </targets>
  <targets xmi:id="docs" name="docs" description="Generate documentation">
    <tasks xsi:type="Ant:Javadoc" sourcepath="/project/src" destdir="/project/docs" packagenames="com.example.*" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="Sample API"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run tests">
    <tasks xsi:type="Ant:Java" classname="com.example.TestRunner" jar="/project/lib/test.jar" fork="true"/>
  </targets>
  <targets xmi:id="timestamp" name="timestamp" description="Set timestamp">
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
</Ant:Project>