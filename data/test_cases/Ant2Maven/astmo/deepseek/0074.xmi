<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="DataPipeline"
    basedir="/opt/data"
    description="Build and package data processing pipeline">
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="build"/>
    <tasks xsi:type="Ant:Delete" dir="dist"/>
  </targets>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="false" optimize="false" deprecation="false"/>
  </targets>
  <targets xmi:id="package" name="package">
    <tasks xsi:type="Ant:Jar" jarfile="dist/pipeline.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-results"/>
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="build/test-classes" debug="true"/>
  </targets>
  <targets xmi:id="docs" name="docs">
    <tasks xsi:type="Ant:Mkdir" dir="build/docs"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="build/docs" packagenames="com.example.*" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="Pipeline API"/>
  </targets>
  <targets xmi:id="deploy" name="deploy">
    <tasks xsi:type="Ant:Copy" todir="/opt/deploy" overwrite="true" filtering="false" flatten="false" includeEmptyDirs="false"/>
    <tasks xsi:type="Ant:Delete" file="/tmp/old-pipeline.jar" quiet="true" failonerror="false"/>
  </targets>
  <targets xmi:id="all" name="all">
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyy-MM-dd HH:mm:ss" locale="en_US"/>
    </tasks>
    <tasks xsi:type="Ant:Java" classname="com.example.Main" fork="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="version" value="2.1.0"/>
  <properties xsi:type="Ant:PropertyValue" name="build.number" value="42"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.dir" location="/etc/pipeline"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customtask" classname="com.example.CustomTask"/>
  <path id="compile.path">
    <pathElement path="lib/commons.jar" location="lib/commons.jar"/>
    <pathElement path="lib/log4j.jar" location="lib/log4j.jar"/>
  </path>
  <path id="test.path">
    <pathElement path="lib/junit.jar" location="lib/junit.jar"/>
  </path>
</Ant:Project>