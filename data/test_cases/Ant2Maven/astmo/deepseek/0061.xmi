<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="DataProcessing"
    description="Data processing pipeline"
    default="process"
    basedir="data">
  <properties xsi:type="Ant:PropertyValue" name="input.dir" value="input"/>
  <properties xsi:type="Ant:PropertyValue" name="output.dir" value="output"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/settings.xml"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customTask" classname="com.example.CustomTask"/>
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/reports"/>
  </targets>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="false" optimize="false" deprecation="false">
      <inExcludes xsi:type="Ant:Includes" name="**/*Test.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/*.bak"/>
    </tasks>
  </targets>
  <targets xmi:id="process" name="process">
    <tasks xsi:type="Ant:Copy" todir="build/output" overwrite="true" filtering="false" flatten="false" includeEmptyDirs="true">
      <fileset dir="src/resources">
        <include name="**/*.xml"/>
        <exclude name="**/*.tmp"/>
      </fileset>
      <filterset starttoken="@" endtoken="@">
        <filter token="version" value="1.0"/>
        <filtersfile file="filters.properties"/>
      </filterset>
    </tasks>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="build" failonerror="false" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" file="dist/app.jar" quiet="true"/>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="build/docs" packagenames="com.example.*" defaultexcludes="true" author="true" version="true" use="true" windowtitle="API Documentation"/>
  </targets>
  <targets xmi:id="package" name="package">
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyyMMdd-HHmmss" locale="en_US"/>
    </tasks>
    <tasks xsi:type="Ant:Java" classname="com.example.Main" jar="lib/tools.jar" fork="true"/>
  </targets>
</Ant:Project>