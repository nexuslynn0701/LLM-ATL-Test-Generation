<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="DataPipeline"
    basedir="/opt/data"
    description="Build and package the data processing pipeline">
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="build"/>
    <tasks xsi:type="Ant:Delete" dir="dist"/>
  </targets>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" optimize="false" deprecation="true"/>
  </targets>
  <targets xmi:id="package" name="package">
    <tasks xsi:type="Ant:Jar" jarfile="dist/pipeline.jar" basedir="build/classes" compress="true"/>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Mkdir" dir="build/test-results"/>
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="build/test-classes" debug="true"/>
  </targets>
  <targets xmi:id="all" name="all">
    <tasks xsi:type="Ant:Copy" todir="dist/docs" file="README.md" overwrite="true"/>
    <tasks xsi:type="Ant:Delete" file="build/temp.log" quiet="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="version" value="1.2.3"/>
  <properties xsi:type="Ant:PropertyValue" name="build.number" value="42"/>
  <properties xsi:type="Ant:PropertyLocation" name="home.dir" location="/home/user"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customtask" classname="com.example.CustomTask"/>
  <path id="compile.path">
    <pathElement path="lib/commons.jar" location="/opt/libs/commons.jar"/>
    <pathElement path="lib/guava.jar" location="/opt/libs/guava.jar"/>
  </path>
  <path id="runtime.path">
    <pathElement path="lib/runtime.jar" location="/opt/libs/runtime.jar"/>
  </path>
  <default="all"/>
</Ant:Project>