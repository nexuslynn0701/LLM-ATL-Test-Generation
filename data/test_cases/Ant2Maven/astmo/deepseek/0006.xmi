<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleBuild"
    basedir="."
    description="Sample build project"
    default="build">
  <properties xsi:type="Ant:PropertyValue" name="version" value="1.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customtask" classname="com.example.CustomTask"/>
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/dist"/>
  </targets>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="false" optimize="false" deprecation="false"/>
  </targets>
  <targets xmi:id="build" name="build">
    <tasks xsi:type="Ant:Jar" jarfile="build/dist/app.jar" basedir="build/classes" compress="true"/>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="build" failonerror="false"/>
  </targets>
  <targets xmi:id="docs" name="docs">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="build/docs" packagenames="com.example.*" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="Sample API"/>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Copy" file="config.xml" todir="build/classes" overwrite="true"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyy-MM-dd HH:mm:ss"/>
    </tasks>
  </targets>
</Ant:Project>