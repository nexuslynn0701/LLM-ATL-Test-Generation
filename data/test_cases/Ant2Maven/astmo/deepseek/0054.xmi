<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    basedir="."
    description="A sample Ant project for transformation testing"
    default="build">
  <targets xmi:id="build" name="build" description="Main build target">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="target/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample.jar" basedir="target/classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="target" failonerror="false" quiet="true" verbose="false" includeEmptyDirs="true" defaultexcludes="true"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run tests">
    <tasks xsi:type="Ant:Mkdir" dir="target/test-classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="target/test-classes" debug="true" fork="true" optimize="false" deprecation="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src"/>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="target"/>
  <properties xsi:type="Ant:PropertyLocation" name="basedir.location" location="."/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customtask" classname="com.example.CustomTask"/>
</Ant:Project>