<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="DataProcessing"
    basedir="/opt/data"
    description="Data processing pipeline">
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/reports"/>
  </targets>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="false" optimize="false" deprecation="false"/>
  </targets>
  <targets xmi:id="package" name="package">
    <tasks xsi:type="Ant:Jar" jarfile="dist/data-processor.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="build" failonerror="false" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" file="dist/data-processor.jar" quiet="true"/>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="build/test-classes" debug="true"/>
    <tasks xsi:type="Ant:Delete" dir="build/test-results" failonerror="false"/>
  </targets>
  <targets xmi:id="docs" name="docs">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="build/docs" packagenames="com.example.*" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="Data Processing API"/>
  </targets>
  <targets xmi:id="archive" name="archive">
    <tasks xsi:type="Ant:Jar" jarfile="dist/data-processor-sources.jar" basedir="src" compress="false"/>
  </targets>
  <targets xmi:id="deploy" name="deploy">
    <tasks xsi:type="Ant:Copy" file="dist/data-processor.jar" todir="/opt/deploy" overwrite="true" filtering="false" flatten="false" includeEmptyDirs="false"/>
    <tasks xsi:type="Ant:Copy" file="dist/data-processor-sources.jar" todir="/opt/deploy" overwrite="true"/>
  </targets>
  <targets xmi:id="verify" name="verify">
    <tasks xsi:type="Ant:Delete" file="build/verify.log" failonerror="false"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/verify"/>
  </targets>
  <targets xmi:id="release" name="release">
    <tasks xsi:type="Ant:Jar" jarfile="dist/release/data-processor.jar" basedir="build/classes" compress="true"/>
    <tasks xsi:type="Ant:Copy" file="dist/release/data-processor.jar" todir="/opt/releases" overwrite="true"/>
  </targets>
  <targets xmi:id="backup" name="backup">
    <tasks xsi:type="Ant:Mkdir" dir="backup"/>
    <tasks xsi:type="Ant:Copy" file="dist/data-processor.jar" todir="backup" overwrite="true"/>
  </targets>
  <targets xmi:id="default" name="default">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/data-processor.jar" basedir="build/classes"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyValue" name="build.number" value="42"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.dir" location="/etc/data-processor"/>
  <properties xsi:type="Ant:PropertyLocation" name="log.dir" location="/var/log/data-processor"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <properties xsi:type="Ant:PropertyEnv" environment="PATH"/>
  <taskdef name="custom-task" classname="com.example.CustomTask"/>
  <taskdef name="another-task" classname="com.example.AnotherTask"/>
</Ant:Project>