<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    default="build"
    basedir="src/main"
    description="A sample project for testing ATL transformation">
  <properties xsi:type="Ant:PropertyValue" name="version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="target"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customTask" classname="com.example.CustomTask"/>
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Delete" dir="target"/>
  </targets>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes"/>
  </targets>
  <targets xmi:id="jar" name="jar">
    <tasks xsi:type="Ant:Jar" jarfile="target/sample.jar" basedir="target/classes"/>
  </targets>
  <targets xmi:id="build" name="build">
    <tasks xsi:type="Ant:Copy" todir="target/resources">
      <fileset dir="src/main/resources"/>
    </tasks>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyy-MM-dd HH:mm:ss"/>
    </tasks>
  </targets>
</Ant:Project>