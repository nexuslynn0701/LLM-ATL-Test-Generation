<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleApp"
    default="build"
    basedir="src/main/java"
    description="A sample Ant project for testing ATL transformation">
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="build" name="build">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes"/>
    <tasks xsi:type="Ant:Delete" dir="temp"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
</Ant:Project>