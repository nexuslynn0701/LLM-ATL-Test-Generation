<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="AntMavenTest0066"
    basedir="."
    description="Ant project with multiple targets and diverse predefined tasks."
    default="buildTarget">

  <!-- Properties to trigger AntProperty* rules -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build/classes"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- A standalone task definition (no NewTask uses it) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target with various tasks -->
  <targets xmi:id="buildTarget" name="build" description="Compile sources, package jar, and manage build directories.">
    <!-- Compile Java sources: AntJavac2MavenMavenJavac -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false">
    </tasks>

    <!-- Generate Javadoc: AntJavadoc2MavenMavenJavadoc -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="Example API Documentation">
    </tasks>

    <!-- Create Jar: AntJar2MavenMavenJar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="build/artifacts/example-1.0.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF">
    </tasks>

    <!-- Make directories: AntMkdir2MavenMavenMkdir -->
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/docs/api"/>

    <!-- Copy resources with fileset/filterset/mapper: AntCopy2MavenMavenCopy (+ FileSet/PatternSet/Includes/Excludes/FilterSet/Filter/FiltersFile/Mapper) -->
    <tasks xsi:type="Ant:Copy"
           todir="build/resources"
           overwrite="true"
           includeEmptyDirs="false"
           flatten="false">
      <fileset dir="src/main/resources">
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="**/*.properties" ifCondition="include.props" unless="skip.props"/>
          <inexcludes xsi:type="Ant:Excludes" name="**/secret/**" ifCondition="" unless=""/>
        </patternset>
        <include name="**/*.xml" ifCondition="" unless=""/>
        <exclude name="**/*.tmp" ifCondition="" unless=""/>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="project.name" value="AntMavenTest0066"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
      <mapper type="glob"
              classname=""
              classpath=""
              classpathref=""
              from="*.tpl"
              to="*.txt"/>
    </tasks>

    <!-- Tstamp task: AntTstamp2MavenMavenTstamp (no nested formats to keep references simple) -->
    <tasks xsi:type="Ant:Tstamp"/>

    <!-- Clean build directory: AntDelete2MavenMavenDelete -->
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           includesfile=""
           excludes=""
           excludesfile=""
           defaultexcludes="true"/>
  </targets>

  <!-- Additional target to trigger another Goal creation (no depends) -->
  <targets xmi:id="docsTarget" name="docs" description="Only generate documentation.">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/standalone"
           packagenames="com.example.docs.*"
           defaultexcludes="yes"
           author="false"
           version="true"
           use="false"
           windowtitle="Standalone Docs">
    </tasks>
  </targets>

</Ant:Project>