<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntProject0068"
    basedir="workspace"
    description="Ant project with multiple targets and various tasks"
    default="compileTarget">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- A simple path definition (no nested references) -->
  <path id="main.path"/>

  <!-- One user-defined task definition (not referenced by tasks) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Target 1: compile (default) -->
  <targets xmi:id="compileTarget" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample-0068.jar" basedir="build/classes"/>
  </targets>

  <!-- Target 2: clean -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean build directory">
    <tasks xsi:type="Ant:Delete" dir="build"/>
  </targets>

</Ant:Project>