<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntBuild"
    basedir="workspace"
    description="Ant project with multiple targets and tasks"
    default="buildTarget">

  <!-- Global properties to trigger AntProperty* rules -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/build.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="config/global.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="BUILD_ENV"/>

  <!-- A simple task definition (never referenced by tasks) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target with several handled tasks -->
  <targets xmi:id="buildTarget" name="build" description="Compile and package sources">
    <!-- Compile Java sources (Javac) -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="target/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <!-- Create output directory (Mkdir) -->
    <tasks xsi:type="Ant:Mkdir" dir="target/dist"/>
    <!-- Package into jar (Jar) -->
    <tasks xsi:type="Ant:Jar"
           jarfile="target/dist/app-main.jar"
           basedir="target/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Secondary target with various management tasks -->
  <targets xmi:id="cleanupTarget" name="cleanup" description="Clean generated artifacts">
    <!-- Timestamp task (Tstamp) -->
    <tasks xsi:type="Ant:Tstamp"/>
    <!-- Delete compiled classes directory -->
    <tasks xsi:type="Ant:Delete"
           dir="target/classes"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*.class"
           excludes="**/Test*.class"
           defaultexcludes="true"/>
    <!-- Delete distribution directory -->
    <tasks xsi:type="Ant:Delete"
           dir="target/dist"
           verbose="true"
           quiet="false"
           failonerror="false"
           includeEmptyDirs="true"/>
  </targets>

  <!-- Documentation target with Javadoc -->
  <targets xmi:id="docTarget" name="documentation" description="Generate API documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="target/site/apidocs"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Example Project API"/>
  </targets>

  <!-- Auxiliary target with a Copy task using FileSet, FilterSet, Mapper and patterns -->
  <targets xmi:id="resourcesTarget" name="process-resources" description="Copy and filter resources">
    <tasks xsi:type="Ant:Copy"
           todir="target/resources"
           overwrite="true"
           filtering="true"
           flatten="false"
           includeEmptyDirs="true">
      <!-- FileSet with nested PatternSet, Includes and Excludes -->
      <fileset dir="src/main/resources">
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="**/*.properties"/>
          <inexcludes xsi:type="Ant:Excludes" name="**/secret/*.properties"/>
        </patternset>
        <include name="**/*.xml"/>
        <exclude name="**/old/**"/>
      </fileset>
      <!-- FilterSet combining a Filter and FiltersFile -->
      <filterset starttoken="@{" endtoken="}">
        <filter token="app.name" value="ComplexAntBuild"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
      <!-- Mapper to adjust file names -->
      <mapper type="glob" from="*.template" to="*.cfg"/>
    </tasks>
  </targets>

</Ant:Project>