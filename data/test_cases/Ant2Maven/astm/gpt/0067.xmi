<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntBuild"
    basedir="project-src"
    description="Complex Ant build with various tasks and properties."
    default="buildTarget">

  <!-- Path definition (no internal references used) -->
  <path id="main.path">
    <fileset dir="lib">
      <include name="**/*.jar"/>
    </fileset>
  </path>

  <!-- Various properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="project-src"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- User-defined task (taskdef) -->
  <taskdef name="custom.task" classname="org.example.ant.CustomTask"/>

  <!-- Default target with many tasks to exercise rules -->
  <targets xmi:id="buildTarget" name="build" description="Compile, jar and copy artifacts">
    <!-- Compile Java sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="project-src"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true">
      <!-- InExcludes patterns -->
      <inExcludes xsi:type="Ant:Includes" name="**/*.java" ifCondition="include.sources" unless=""/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**" ifCondition="" unless="exclude.internal"/>
    </tasks>

    <!-- Generate Javadoc -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="project-src"
           destdir="build/docs"
           packagenames="org.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Example Project API"/>

    <!-- Create main jar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="build/dist/example-main.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>

    <!-- Create output directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build/dist"/>

    <!-- Copy resources using FileSet, FilterSet, Mapper -->
    <tasks xsi:type="Ant:Copy"
           file=""
           presservelastmodified="true"
           tofile=""
           todir="build/dist/resources"
           overwrite="true"
           filtering="true"
           flatten="false"
           includeEmptyDirs="true">
      <fileset dir="resources">
        <!-- Direct include/exclude -->
        <include name="**/*.properties" ifCondition="" unless=""/>
        <exclude name="**/secret/**" ifCondition="" unless=""/>
        <!-- PatternSet with its own inexcludes -->
        <patternset>
          <inexcludes xsi:type="Ant:IncludesFile" name="include.list" ifCondition="" unless=""/>
          <inexcludes xsi:type="Ant:ExcludesFile" name="exclude.list" ifCondition="" unless=""/>
        </patternset>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="project.name" value="ComplexAntBuild"/>
        <filtersfile file="filters.properties"/>
      </filterset>
      <mapper type="glob" classname="" classpath="" classpathref="" from="*.properties" to="*.cfg"/>
    </tasks>

    <!-- Delete temporary directory -->
    <tasks xsi:type="Ant:Delete"
           file=""
           dir="build/tmp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           includesfile=""
           excludes=""
           excludesfile=""
           defaultexcludes="true"/>
  </targets>

  <!-- Additional target with a Java task and Tstamp -->
  <targets xmi:id="runTarget" name="run" description="Run the application">
    <!-- Record timestamp -->
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp"
              pattern="yyyy-MM-dd HH:mm:ss"
              offset="0"
              unit="second"
              locale="en_US"/>
    </tasks>

    <!-- Run main class with ClassPath -->
    <tasks xsi:type="Ant:Java"
           classname="org.example.Main"
           jar=""
           fork="true">
      <classPath refid="cp.main">
        <pathElement path="build/classes" location="build/classes"/>
        <fileset dir="lib">
          <include name="**/*.jar" ifCondition="" unless=""/>
        </fileset>
      </classPath>
    </tasks>
  </targets>

</Ant:Project>