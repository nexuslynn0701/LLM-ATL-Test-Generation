<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="src/main/java"
    description="Comprehensive Ant project for ATL testing."
    default="buildTarget">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="project.name" value="ComplexBuildProject"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="BUILD_ENV"/>

  <!-- Standalone task definitions -->
  <taskdef name="customTaskOne" classname="com.example.ant.CustomTaskOne"/>
  <taskdef name="customTaskTwo" classname="com.example.ant.CustomTaskTwo"/>

  <!-- Targets -->
  <!-- Default target -->
  <targets xmi:id="buildTarget" name="build" description="Main build sequence">
    <!-- Compile sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <!-- Package into jar -->
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/complex-build.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <!-- Generate API documentation -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/javadoc"
           packagenames="com.example.complex.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Complex Build API"/>
    <!-- Manage properties (tstamp) -->
    <tasks xsi:type="Ant:Tstamp"/>
    <!-- Create output directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build/output"/>
    <!-- Copy distribution files -->
    <tasks xsi:type="Ant:Copy"
           file="build/classes/com/example/Main.class"
           presservelastmodified="true"
           tofile="build/output/Main.class"
           todir="build/output"
           overwrite="true"
           filtering="false"
           flatten="false"
           includeEmptyDirs="true"/>
    <!-- Clean temporary directory -->
    <tasks xsi:type="Ant:Delete"
           dir="build/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           includesfile="config/includes.txt"
           excludes="**/*.bak"
           excludesfile="config/excludes.txt"
           defaultexcludes="true"/>
  </targets>

  <!-- Auxiliary target with different tasks -->
  <targets xmi:id="cleanTarget" name="clean" description="Remove all generated artifacts">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           defaultexcludes="false"/>
    <tasks xsi:type="Ant:Mkdir" dir="build"/>
  </targets>

</Ant:Project>