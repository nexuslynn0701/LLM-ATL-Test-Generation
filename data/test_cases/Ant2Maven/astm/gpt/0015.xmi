<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="AntMavenDemo15"
    basedir="workspace"
    description="Demo project with multiple Ant targets and tasks"
    default="mainTarget">

  <!-- Properties to exercise AntProperty* rules -->
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/output"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/app.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="env/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="SYSTEM_ENV"/>

  <!-- One task definition (not referenced by any task, per constraints) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target with a mix of tasks -->
  <targets xmi:id="mainTarget" name="main" description="Main build target">
    <!-- Compile sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>

    <!-- Generate javadocs -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Example API"/>

    <!-- Create output directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build/distribution"/>

    <!-- Create JAR from compiled classes -->
    <tasks xsi:type="Ant:Jar"
           jarfile="build/distribution/demo15.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>

    <!-- Copy some resources (minimal, no extra references) -->
    <tasks xsi:type="Ant:Copy"
           file="resources/config.xml"
           todir="build/distribution/config"
           overwrite="true"
           filtering="false"
           flatten="false"
           includeEmptyDirs="true"/>

    <!-- Cleanup temporary directory -->
    <tasks xsi:type="Ant:Delete"
           dir="build/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes=""/>
  </targets>

  <!-- Secondary target to exercise additional task rules -->
  <targets xmi:id="initTarget" name="init" description="Initialization target">
    <!-- Timestamp task (no nested format, still triggers rule) -->
    <tasks xsi:type="Ant:Tstamp"/>

    <!-- Separate mkdir and delete in another target -->
    <tasks xsi:type="Ant:Mkdir" dir="build/temp"/>
    <tasks xsi:type="Ant:Delete" dir="build/old-output"/>
  </targets>

</Ant:Project>