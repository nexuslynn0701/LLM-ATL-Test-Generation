<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntProject58"
    basedir="src/main/java"
    description="Sample Ant build with multiple targets and management tasks."
    default="compileTarget">
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/output"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/build.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="config/global.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>
  <targets xmi:id="compileTarget" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample-project.jar" basedir="build/classes"/>
  </targets>
  <targets xmi:id="cleanTarget" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build"/>
    <tasks xsi:type="Ant:Delete" dir="dist"/>
  </targets>
  <targets xmi:id="docTarget" name="doc" description="Generate Javadoc">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src"
           destdir="build/javadoc"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="Sample Project 58 API"/>
  </targets>
  <targets xmi:id="timestampTarget" name="timestamp" description="Create build timestamp">
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
</Ant:Project>