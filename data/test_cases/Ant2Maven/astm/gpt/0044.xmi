<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildWithDescription"
    basedir="."
    description="A sample Ant project with multiple targets and tasks."
    default="mainTarget">

  <!-- Target used as default -->
  <targets xmi:id="mainTarget" name="mainTarget" description="Main build target">
    <!-- Javac task -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <!-- Jar task -->
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/app-main.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <!-- Mkdir task -->
    <tasks xsi:type="Ant:Mkdir"
           dir="build/generated-sources"/>
    <!-- Copy task -->
    <tasks xsi:type="Ant:Copy"
           todir="build/resources"
           overwrite="true"
           filtering="false"
           flatten="false"
           includeEmptyDirs="true"/>
    <!-- Delete task -->
    <tasks xsi:type="Ant:Delete"
           dir="build/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="false"
           includes="**/*.tmp"
           defaultexcludes="true"/>
  </targets>

  <!-- Second target without description -->
  <targets xmi:id="testTarget" name="testTarget">
    <!-- Java task -->
    <tasks xsi:type="Ant:Java"
           classname="com.example.tools.TestRunner"
           jar="lib/testrunner.jar"
           fork="true"/>
    <!-- Javadoc task -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/javadoc"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Example API"/>
    <!-- Tstamp task -->
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>

  <!-- Project-level properties -->
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build"/>
  <properties xsi:type="Ant:PropertyLocation" name="java.home" location="/usr/lib/jvm/default-java"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="SYSTEM_ENV"/>

  <!-- Task definition not referenced by any task -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

</Ant:Project>