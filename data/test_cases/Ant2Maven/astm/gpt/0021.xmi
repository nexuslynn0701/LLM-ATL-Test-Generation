<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="workspace"
    description="Comprehensive Ant build for transformation testing"
    default="buildTarget">

  <!-- Ant properties exercising Property* rules -->
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/output"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/build.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="config/global.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- User task definition (no references from tasks) -->
  <taskdef name="custom.task" classname="org.example.ant.CustomTask"/>

  <!-- Default target with multiple task types -->
  <targets xmi:id="buildTarget" name="build" description="Main build target">
    <!-- Compile with includes/excludes and a classpath -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="false">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**"/>
      <classPath>
        <pathElement path="lib/compile-lib.jar" location="lib/compile-lib.jar"/>
      </classPath>
    </tasks>

    <!-- Javadoc generation -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="org.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Example Project API"/>

    <!-- Jar creation -->
    <tasks xsi:type="Ant:Jar" jarfile="dist/example-app.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="META-INF/MANIFEST.MF"/>

    <!-- Directory creation -->
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>

    <!-- Copy with FileSet, FilterSet, and Mapper -->
    <tasks xsi:type="Ant:Copy" todir="dist/lib" overwrite="true" includeEmptyDirs="false">
      <fileset dir="lib">
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="**/*.jar"/>
          <inexcludes xsi:type="Ant:Excludes" name="**/unused/**"/>
        </patternset>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="app.name" value="ExampleApp"/>
      </filterset>
      <mapper type="glob" from="*.jar" to="lib-*.jar"/>
    </tasks>

    <!-- Delete temporary directory -->
    <tasks xsi:type="Ant:Delete" dir="build/tmp" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
  </targets>

  <!-- Secondary target without description to exercise general Target rule -->
  <targets xmi:id="cleanTarget" name="clean">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false"/>
  </targets>

  <!-- Shared Path definition -->
  <path id="compile.path">
    <pathElement path="lib/extra-lib.jar" location="lib/extra-lib.jar"/>
    <fileset dir="lib/optional">
      <include name="**/*.jar"/>
      <exclude name="**/experimental/**"/>
    </fileset>
  </path>

</Ant:Project>