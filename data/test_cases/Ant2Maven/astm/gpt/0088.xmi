<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntBuild"
    basedir="project-src"
    description="Ant build with various tasks and properties"
    default="buildTarget">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/output"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.dir" location="config/"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition (not referenced by tasks, to avoid forbidden taskName refs) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target -->
  <targets xmi:id="buildTarget" name="build" description="Compile, document and package">
    <!-- Compile task with include/exclude and classpath elements (no refid) -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="false">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**"/>
      <classPath>
        <pathElement path="lib/dependency1.jar" location="lib/dependency1.jar"/>
        <pathElement path="lib/dependency2.jar" location="lib/dependency2.jar"/>
      </classPath>
    </tasks>

    <!-- Javadoc task -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="Example API"/>

    <!-- Timestamp task with one format -->
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp" pattern="yyyy-MM-dd HH:mm:ss" offset="0" unit="hour" locale="en_US"/>
    </tasks>

    <!-- Jar task -->
    <tasks xsi:type="Ant:Jar" jarfile="dist/example-app.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="META-INF/MANIFEST.MF"/>

    <!-- Copy task with fileset, filterset, and mapper -->
    <tasks xsi:type="Ant:Copy" todir="build/resources" overwrite="true" includeEmptyDirs="false">
      <fileset dir="src/main/resources">
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="**/*.properties"/>
          <inexcludes xsi:type="Ant:Excludes" name="**/secret/**"/>
        </patternset>
        <include name="**/*.xml"/>
        <exclude name="**/*.bak"/>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="project.name" value="ComplexAntBuild"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
      <mapper type="glob" from="*.template" to="*.conf"/>
    </tasks>

    <!-- Delete task (directory cleanup) -->
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
  </targets>

  <!-- Second target without description to help distinguish behavior on targets -->
  <targets xmi:id="cleanTarget" name="clean">
    <!-- Delete generated artifacts -->
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="false" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" failonerror="false" includeEmptyDirs="true"/>
  </targets>

</Ant:Project>