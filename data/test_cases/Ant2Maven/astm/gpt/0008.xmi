<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildAndDocProject"
    basedir="./src"
    description="Project with compilation, packaging, docs and file management."
    default="t_compile">
  
  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.main" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition (not referenced by tasks) -->
  <taskdef name="custom.task" classname="com.example.build.CustomTask"/>

  <!-- Targets -->
  <targets xmi:id="t_compile" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes"/>
  </targets>

  <targets xmi:id="t_jar" name="package" description="Create application JAR">
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes"/>
  </targets>

  <targets xmi:id="t_javadoc" name="javadoc" description="Generate Java documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="Example API"/>
  </targets>

  <targets xmi:id="t_cleanup" name="clean" description="Clean build output">
    <tasks xsi:type="Ant:Delete" dir="build"/>
  </targets>

  <targets xmi:id="t_timestamp" name="tstampTarget" description="Record build timestamp">
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
</Ant:Project>