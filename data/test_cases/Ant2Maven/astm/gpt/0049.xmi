<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryManager"
    basedir="lib-src"
    description="Build and package the library module."
    default="buildTarget">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="lib.name" value="core-lib"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition (unused by tasks as required) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Targets -->
  <targets xmi:id="buildTarget" name="build" description="Compile, document and jar the library.">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.lib.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Core Library API"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/core-lib.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <targets xmi:id="cleanupTarget" name="clean" description="Clean build artifacts.">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           includesfile="config/clean-includes.txt"
           excludes="**/.git/**"
           excludesfile="config/clean-excludes.txt"
           defaultexcludes="true"/>
    <tasks xsi:type="Ant:Tstamp"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
  </targets>

</Ant:Project>