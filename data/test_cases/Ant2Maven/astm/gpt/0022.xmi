<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MixedDescriptionProject"
    basedir="workspace/core"
    description="Project with multiple Ant targets and tasks"
    default="buildTarget">

  <!-- properties -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir.loc" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- task definition (not referenced by tasks, to respect constraints) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- default target with various tasks -->
  <targets xmi:id="buildTarget" name="build" description="Full build target">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app-core.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="false" includes="**/*.tmp" excludes="**/keep/**"/>
  </targets>

  <!-- secondary target without description, to exercise goal rule on another target -->
  <targets xmi:id="docsTarget" name="generate-docs">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.core.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Core API Documentation"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>

</Ant:Project>