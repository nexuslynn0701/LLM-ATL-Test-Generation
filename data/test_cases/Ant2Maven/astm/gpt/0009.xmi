<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="workspace"
    description="Complex build with multiple targets and tasks."
    default="buildTarget">

  <!-- Properties to exercise AntProperty* rules -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition not referenced by any task (allowed) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target with several tasks -->
  <targets xmi:id="buildTarget" name="build" description="Main build target">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/complexbuild.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Secondary target to exercise other task rules -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes="**/.keep"
           defaultexcludes="true"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>

</Ant:Project>