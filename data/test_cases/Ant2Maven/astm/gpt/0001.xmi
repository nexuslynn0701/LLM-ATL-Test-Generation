<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="src/main/java"
    description="Comprehensive Ant project for ATL Ant2Maven testing"
    default="buildTarget">

  <!-- Properties exercising all Property* variants -->
  <properties xsi:type="Ant:PropertyValue" name="project.name" value="ComplexBuildProject"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- One simple taskdef (not referenced by any task, per constraints) -->
  <taskdef name="custom.task" classname="com.example.ant.tasks.CustomTask"/>

  <!-- Path with nested pathElement and fileset, all contained and without refs -->
  <path xsi:type="Ant:Path" id="compile.path">
    <pathElement path="lib/runtime.jar" location="lib/runtime.jar"/>
    <fileset dir="lib/">
      <patternset>
        <inexcludes xsi:type="Ant:Includes" name="**/*.jar"/>
        <inexcludes xsi:type="Ant:Excludes" name="**/test-*.jar" ifCondition="skip.tests"/>
      </patternset>
      <include name="core/*.jar"/>
      <exclude name="legacy/*.jar" unless="use.legacy"/>
    </fileset>
  </path>

  <!-- Default target with multiple task types -->
  <targets xmi:id="buildTarget" name="build" description="Compile sources, generate docs and package jar">
    <!-- Javac with inExcludes and empty ClassPath (no references set) -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes"
           debug="true" fork="false" optimize="true" deprecation="false">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/*Test.java" ifCondition="skip.tests"/>
      <classPath refid=""/>
    </tasks>

    <!-- Javadoc task -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.**"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="ComplexBuild API"/>
    <!-- Jar packaging -->
    <tasks xsi:type="Ant:Jar"
           jarfile="build/artifacts/complexbuild.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Secondary target using file-related tasks and filters -->
  <targets xmi:id="packageTarget" name="package" description="Prepare distribution and clean old artifacts">
    <!-- Mkdir -->
    <tasks xsi:type="Ant:Mkdir" dir="build/distribution"/>

    <!-- Copy with FileSet, FilterSet, Mapper, FiltersFile, Includes/Excludes -->
    <tasks xsi:type="Ant:Copy"
           file=""
           presservelastmodified="true"
           tofile=""
           todir="build/distribution"
           overwrite="true"
           filtering="true"
           flatten="false"
           includeEmptyDirs="true">
      <fileset dir="build/classes">
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="**/*.class"/>
          <inexcludes xsi:type="Ant:Excludes" name="**/internal/**" unless="include.internal"/>
        </patternset>
        <include name="**/*.properties"/>
        <exclude name="**/*.tmp"/>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="projectName" value="ComplexBuildProject"/>
        <filter token="buildEnv" value="integration"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
      <mapper type="glob" classname="" classpath="" classpathref="" from="*.class" to="*.bin"/>
    </tasks>

    <!-- Delete task -->
    <tasks xsi:type="Ant:Delete"
           file=""
           dir="build/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           includesfile=""
           excludes="**/*.keep"
           excludesfile=""
           defaultexcludes="true"/>
  </targets>

</Ant:Project>