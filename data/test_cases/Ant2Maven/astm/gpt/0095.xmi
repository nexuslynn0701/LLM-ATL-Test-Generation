<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiTaskProject"
    basedir="."
    description="Project with multiple Ant tasks for transformation testing"
    default="buildTarget">

  <!-- Properties of various specialized kinds -->
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/output"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/app.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="env/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="SYSTEM_ENV"/>

  <!-- A standalone user-defined task definition -->
  <taskdef name="custom.copy" classname="com.example.ant.CustomCopyTask"/>

  <!-- Default target with several predefined tasks -->
  <targets xmi:id="buildTarget" name="build" description="Main build target">
    <!-- Compile sources with includes and excludes -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="true">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java" ifCondition="compile.sources" unless="skip.sources"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**"/>
    </tasks>

    <!-- Generate Javadoc -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Example API Documentation"/>

    <!-- Create output directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build/output"/>

    <!-- Copy artifacts with a FileSet, FilterSet, and Mapper -->
    <tasks xsi:type="Ant:Copy" todir="build/output" overwrite="true">
      <fileset dir="build/classes">
        <include name="**/*.class"/>
        <exclude name="**/test/**"/>
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="**/public/**"/>
          <inexcludes xsi:type="Ant:Excludes" name="**/temp/**"/>
        </patternset>
      </fileset>
      <filterset starttoken="@@" endtoken="@@">
        <filter token="app.name" value="MultiTaskProject"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
      <mapper type="glob" from="*.class" to="*.bin"/>
    </tasks>

    <!-- Package into JAR -->
    <tasks xsi:type="Ant:Jar" jarfile="build/output/app.jar" basedir="build/classes" compress="true" encoding="UTF-8"/>
  </targets>

  <!-- Secondary target with management tasks -->
  <targets xmi:id="cleanupTarget" name="clean" description="Cleanup generated artifacts">
    <!-- Timestamp properties -->
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp" pattern="yyyyMMdd-HHmmss" offset="0" unit="second" locale="en_US"/>
    </tasks>

    <!-- Delete build directory -->
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" defaultexcludes="true"/>
  </targets>

</Ant:Project>