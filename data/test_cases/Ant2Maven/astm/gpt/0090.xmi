<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntBuild"
    basedir="project-src"
    description="Ant build with multiple targets and tasks"
    default="build-main">

  <!-- Ant properties to trigger property rules -->
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/output"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/build.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="config/common.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition to trigger AntTaskDef2MavenMavenTaskDef -->
  <taskdef name="custom.task" classname="org.example.ant.CustomTask"/>

  <!-- Default target with several tasks -->
  <targets xmi:id="build-main" name="build-main" description="Main build target">
    <!-- Compile with simple includes/excludes -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="false" deprecation="true">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**"/>
    </tasks>

    <!-- Create build directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>

    <!-- Package compiled classes into a jar -->
    <tasks xsi:type="Ant:Jar" jarfile="dist/complex-ant-build.jar" basedir="build/classes" compress="true"/>

    <!-- Copy resources with a fileset to trigger FileSet, PatternSet, Includes/Excludes, FilterSet, Filter, FiltersFile, Mapper -->
    <tasks xsi:type="Ant:Copy" todir="build/resources" overwrite="true" includeEmptyDirs="false" flatten="false">
      <fileset dir="src/main/resources">
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="**/*.properties"/>
          <inexcludes xsi:type="Ant:Excludes" name="**/secret/**"/>
        </patternset>
        <include name="**/*.xml"/>
        <exclude name="**/temp/**"/>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="project.name" value="ComplexAntBuild"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
      <mapper type="glob" from="*.properties" to="*.cfg"/>
    </tasks>

    <!-- Delete previous distribution directory -->
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" includeEmptyDirs="true" defaultexcludes="true"/>
  </targets>

  <!-- Secondary target without description to trigger AntProject2MavenWithoutDescription's goals handling -->
  <targets xmi:id="documentation" name="documentation">
    <!-- Generate JavaDoc -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="org.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="ComplexAntBuild API"/>
  </targets>

  <!-- Target dedicated to timestamps and additional file operations -->
  <targets xmi:id="prepare" name="prepare" description="Prepare build environment">
    <!-- Timestamp task -->
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp" pattern="yyyyMMdd-HHmmss"/>
    </tasks>

    <!-- Create distribution directory -->
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>

    <!-- Clean temporary directory -->
    <tasks xsi:type="Ant:Delete" dir="build/tmp" quiet="true" includeEmptyDirs="false"/>
  </targets>

</Ant:Project>