<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="workspace"
    description="Complex Ant build with multiple targets and tasks."
    default="t_build">
  
  <!-- Properties (exercise AntProperty* rules) -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition (exercise AntTaskDef2MavenMavenTaskDef, unused by tasks per constraints) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Single path with nested pathElement and fileset (exercise Path-related and pattern rules) -->
  <path id="main.path">
    <pathElement path="lib/dependency1.jar" location="lib"/>
    <fileset dir="lib">
      <patternset>
        <inexcludes xsi:type="Ant:Includes" name="**/*.jar" ifCondition="includeJars" unless=""/>
        <inexcludes xsi:type="Ant:Excludes" name="**/test-*.jar" ifCondition="" unless="keepAll"/>
      </patternset>
      <include name="**/*.zip" ifCondition="" unless="noZips"/>
      <exclude name="**/old/**" ifCondition="" unless=""/>
    </fileset>
  </path>

  <!-- Targets -->
  <!-- Default target: uses Javac, Jar, Tstamp -->
  <targets xmi:id="t_build" name="build" description="Compile, jar and timestamp build artifacts.">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java" ifCondition="" unless="noCompile"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**" ifCondition="excludeInternal" unless=""/>
    </tasks>
    <tasks xsi:type="Ant:Jar"
           jarfile="build/lib/app.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp"
              pattern="yyyy-MM-dd'T'HH:mm:ss"
              offset="+0"
              unit="second"
              locale="en_US"/>
    </tasks>
  </targets>

  <!-- Secondary target: uses Mkdir, Copy (with FileSet, FilterSet, Mapper), Delete -->
  <targets xmi:id="t_dist" name="dist" description="Prepare distribution directory.">
    <tasks xsi:type="Ant:Mkdir" dir="dist/release"/>

    <tasks xsi:type="Ant:Copy"
           file="build/lib/app.jar"
           presservelastmodified="true"
           tofile="dist/release/app.jar"
           todir=""
           overwrite="true"
           filtering="true"
           flatten="false"
           includeEmptyDirs="false">
      <fileset dir="resources">
        <patternset>
          <inexcludes xsi:type="Ant:IncludesFile" name="includes.list" ifCondition="" unless=""/>
          <inexcludes xsi:type="Ant:ExcludesFile" name="excludes.list" ifCondition="" unless=""/>
        </patternset>
        <include name="**/*" ifCondition="" unless=""/>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="app.name" value="ComplexBuildApp"/>
        <filter token="app.version" value="1.0.0"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
      <mapper type="glob" classname="" classpath="" classpathref="" from="*.txt" to="*.cfg"/>
    </tasks>

    <tasks xsi:type="Ant:Delete"
           file=""
           dir="dist/tmp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           includesfile=""
           excludes=""
           excludesfile=""
           defaultexcludes="true"/>
  </targets>
</Ant:Project>