<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="DemoAntProject0099"
    basedir="workspace"
    description="Demo project with multiple Ant tasks for ATL coverage"
    default="buildTarget">

  <!-- Properties to trigger AntProperty* rules -->
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="BUILD_ENV"/>

  <!-- Task definition to trigger AntTaskDef2MavenMavenTaskDef and attributes rule -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target with several different tasks -->
  <targets xmi:id="buildTarget" name="build" description="Compile, jar and clean build output">
    <!-- Compile task (Javac) -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false"/>
    <!-- Documentation task (Javadoc) -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="DemoProject API"/>
    <!-- Archive task (Jar) -->
    <tasks xsi:type="Ant:Jar"
           jarfile="build/artifacts/demo-0099.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
    <!-- Management properties task (Tstamp) -->
    <tasks xsi:type="Ant:Tstamp"/>
    <!-- File management tasks: Mkdir, Copy with FileSet/FilterSet/Mapper, Delete -->
    <tasks xsi:type="Ant:Mkdir" dir="build/distribution"/>
    <tasks xsi:type="Ant:Copy"
           todir="build/distribution"
           presservelastmodified="true"
           overwrite="true"
           includeEmptyDirs="false"
           filtering="true"
           flatten="false">
      <!-- FileSet with PatternSet, Includes, Excludes -->
      <fileset dir="build/classes">
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="**/*.class" ifCondition="includeClasses" unless="skipClasses"/>
          <inexcludes xsi:type="Ant:Excludes" name="**/*Test.class" ifCondition="" unless=""/>
        </patternset>
        <include name="**/*.properties" ifCondition="" unless=""/>
        <exclude name="**/temp/**" ifCondition="excludeTemp" unless=""/>
      </fileset>
      <!-- FilterSet with Filter and FiltersFile -->
      <filterset starttoken="${" endtoken="}">
        <filter token="project.name" value="DemoAntProject0099"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
      <!-- Mapper -->
      <mapper type="glob" classname="org.example.Mapper"
              classpath="lib/mappers.jar"
              classpathref=""
              from="*.class"
              to="*.bin"/>
    </tasks>
    <tasks xsi:type="Ant:Delete"
           dir="build/temp"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           includesfile="config/includes.txt"
           excludes="**/*.bak"
           excludesfile="config/excludes.txt"
           defaultexcludes="true"/>
  </targets>

  <!-- Secondary target with Java execution and path/classpath structures -->
  <targets xmi:id="runTarget" name="run" description="Run the packaged application">
    <!-- Path with nested PathElement and FileSet/PatternSet/IncludesFile/ExcludesFile -->
    <tasks xsi:type="Ant:Java"
           classname="com.example.app.Main"
           jar="build/artifacts/demo-0099.jar"
           fork="true">
      <classPath refid="runtime.classpath">
        <pathElement path="build/classes" location="build/classes"/>
        <pathElement path="lib/runtime-lib.jar" location="lib/runtime-lib.jar"/>
        <fileset dir="lib/optional">
          <patternset>
            <inexcludes xsi:type="Ant:IncludesFile" name="include-patterns.txt" ifCondition="" unless=""/>
            <inexcludes xsi:type="Ant:ExcludesFile" name="exclude-patterns.txt" ifCondition="" unless=""/>
          </patternset>
        </fileset>
      </classPath>
    </tasks>
    <!-- Additional supporting path definition not referenced elsewhere (still transformed) -->
    <tasks xsi:type="Ant:Mkdir" dir="logs"/>
    <tasks xsi:type="Ant:Delete" file="logs/old.log" quiet="true"/>
  </targets>

  <!-- Standalone Path and ClassPath elements (not referenced by tasks) -->
  <path id="build.path">
    <pathElement path="build/classes" location="build/classes"/>
    <fileset dir="lib">
      <include name="**/*.jar"/>
    </fileset>
  </path>
  <path id="test.path">
    <pathElement path="build/test-classes" location="build/test-classes"/>
  </path>

  <path>
    <pathElement path="resources" location="resources"/>
  </path>

  <path>
    <fileset dir="extras">
      <exclude name="**/tmp/**"/>
    </fileset>
  </path>

  <path>
    <fileset dir="config">
      <patternset>
        <inexcludes xsi:type="Ant:Includes" name="**/*.xml"/>
      </patternset>
    </fileset>
  </path>

  <path>
    <pathElement path="scripts" location="scripts"/>
    <fileset dir="scripts">
      <include name="**/*.sh"/>
    </fileset>
  </path>

  <path>
    <fileset dir="data">
      <patternset>
        <inexcludes xsi:type="Ant:Excludes" name="**/*.bak"/>
      </patternset>
    </fileset>
  </path>

  <path>
    <pathElement path="tools" location="tools"/>
  </path>

  <path>
    <fileset dir="tools">
      <include name="**/*.jar"/>
      <exclude name="**/old/**"/>
    </fileset>
  </path>

  <path>
    <pathElement path="temp" location="temp"/>
  </path>

</Ant:Project>