<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryBuild"
    basedir="src/main/java"
    description="Build and package the library."
    default="buildTarget">

  <!-- Properties covering all concrete Ant Property variants -->
  <properties xsi:type="Ant:PropertyValue" name="compile.debug" value="true"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="target/build"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- A standalone task definition (not referenced by any task) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- First target: default target with various file-related tasks -->
  <targets xmi:id="buildTarget" name="build" description="Compile sources and assemble jar.">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes"/>
    <tasks xsi:type="Ant:Jar" jarfile="target/library.jar" basedir="target/classes"/>
  </targets>

  <!-- Second target: clean target with delete task -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean build output.">
    <tasks xsi:type="Ant:Delete" dir="target"/>
  </targets>

</Ant:Project>