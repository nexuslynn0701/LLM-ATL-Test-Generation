<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntBuild"
    basedir="."
    description="Ant build with multiple targets and various predefined tasks."
    default="buildTarget">

  <!-- Properties to trigger AntProperty* rules -->
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/output"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/app.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="config/global.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- A simple path purely to exercise AntPath2MavenMavenPath (no nested refs) -->
  <path id="main.path"/>

  <!-- One taskdef to trigger AntTaskDef2MavenMavenTaskDef (not referenced by tasks) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Target 1: buildTarget (default) with several task types -->
  <targets xmi:id="buildTarget" name="build" description="Compile and package project">
    <!-- Compile Java sources with includes/excludes and classpath -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="true">
      <!-- inExcludes to trigger InExcludes/Includes/Excludes rules -->
      <inExcludes xsi:type="Ant:Includes" name="**/*.java" ifCondition="compile.sources" unless="skip.compile"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**" ifCondition="exclude.internal"/>
      <!-- simple ClassPath (no nested references) -->
      <classPath refid="compile.classpath"/>
    </tasks>

    <!-- Generate Javadoc -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/javadoc"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="Example API"/>

    <!-- Create build directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build"/>

    <!-- Create Jar archive -->
    <tasks xsi:type="Ant:Jar" jarfile="build/lib/example.jar" basedir="build/classes" compress="true"/>

    <!-- Copy resources with FileSet, FilterSet, Mapper, FiltersFile, Filter -->
    <tasks xsi:type="Ant:Copy" todir="build/resources" overwrite="true" includeEmptyDirs="false">
      <fileset dir="src/main/resources">
        <!-- PatternSet with IncludesFile and ExcludesFile -->
        <patternset>
          <inexcludes xsi:type="Ant:IncludesFile" name="includes.lst" ifCondition="use.includes.file"/>
          <inexcludes xsi:type="Ant:ExcludesFile" name="excludes.lst"/>
        </patternset>
        <!-- Additional direct include/exclude -->
        <include name="**/*.properties"/>
        <exclude name="**/secret/**" unless="include.secret"/>
      </fileset>
      <!-- FilterSet with FiltersFile and Filter -->
      <filterset starttoken="@{" endtoken="}">
        <filtersfile file="config/filters.properties"/>
        <filter token="version" value="1.0.0"/>
      </filterset>
      <!-- Mapper -->
      <mapper type="glob" from="*.properties" to="*.cfg"/>
    </tasks>

    <!-- Tstamp to exercise AntTstamp2MavenMavenTstamp and nested FormatTstamp -->
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp" pattern="yyyyMMdd-HHmmss" offset="0" unit="second" locale="en_US"/>
    </tasks>
  </targets>

  <!-- Target 2: cleanTarget with Delete and Mkdir -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean build output">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" defaultexcludes="yes"/>
    <tasks xsi:type="Ant:Mkdir" dir="build"/>
  </targets>

  <!-- Target 3: docsTarget with only Javadoc to show another independent goal -->
  <targets xmi:id="docsTarget" name="docs">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/site/javadoc"
           packagenames="com.example.docs.*"
           defaultexcludes="no"
           author="false"
           version="false"
           use="false"
           windowtitle="Example Project Documentation"/>
  </targets>

</Ant:Project>