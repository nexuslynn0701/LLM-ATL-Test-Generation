<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="Ant2MavenSample0055"
    basedir="src/main/java"
    description="Ant build with compile, docs, packaging and clean targets"
    default="t_compile">
    
  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="target"/>
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- A task definition (not referenced by any task, as required) -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Default target: compile -->
  <targets xmi:id="t_compile" name="compile" description="Compile Java sources">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes"/>
  </targets>

  <!-- Javadoc target -->
  <targets xmi:id="t_javadoc" name="javadoc" description="Generate Javadoc API">
    <tasks xsi:type="Ant:Mkdir" dir="target/site/apidocs"/>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="target/site/apidocs"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="Example API"/>
  </targets>

  <!-- Jar packaging target -->
  <targets xmi:id="t_jar" name="package" description="Create application JAR">
    <tasks xsi:type="Ant:Jar" jarfile="target/example-1.0.jar" basedir="target/classes"/>
  </targets>

  <!-- Clean target -->
  <targets xmi:id="t_clean" name="clean" description="Remove build output">
    <tasks xsi:type="Ant:Delete" dir="target"/>
  </targets>

</Ant:Project>