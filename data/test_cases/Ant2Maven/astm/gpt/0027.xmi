<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexBuild"
    basedir="src/main/java"
    description="Build and package the application"
    default="buildTarget">

  <!-- Global properties -->
  <properties xsi:type="Ant:PropertyValue" name="app.name" value="ComplexBuildApp"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- A standalone task definition (not referenced by any task) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target: build -->
  <targets xmi:id="buildTarget" name="build" description="Compile and jar the project">
    <!-- Compile Java sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false">
      <!-- include and exclude patterns for compilation -->
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**"/>
    </tasks>

    <!-- Create jar from compiled classes -->
    <tasks xsi:type="Ant:Jar"
           jarfile="build/libs/complexbuild.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Secondary target: prepare directories and clean old output -->
  <targets xmi:id="prepareTarget" name="prepare" description="Prepare output directories">
    <!-- Create output directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build/output"/>

    <!-- Delete previous output directory (if any) -->
    <tasks xsi:type="Ant:Delete"
           dir="build/old-output"
           verbose="true"
           quiet="false"
           failonerror="false"
           includeEmptyDirs="true"
           includes="**/*"
           excludes="**/*.bak"
           defaultexcludes="true"/>
  </targets>

  <!-- Documentation target: generate Javadoc -->
  <targets xmi:id="docsTarget" name="docs" description="Generate project documentation">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="ComplexBuild API Documentation"/>
  </targets>

  <!-- Timestamp target: register a build timestamp property -->
  <targets xmi:id="tstampTarget" name="tstamp" description="Record build timestamp">
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>

</Ant:Project>