<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiRuleProject"
    basedir="src/main/java"
    description="Ant build that compiles, documents, packages, and cleans."
    default="buildTarget">

  <!-- Properties to trigger property rules -->
  <properties xsi:type="Ant:PropertyValue" name="project.name" value="MultiRuleProject"/>
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Task definition to trigger AntTaskDef2MavenMavenTaskDef -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Path with nested PathElement and FileSet to trigger path-related rules -->
  <path xsi:type="Ant:Path" id="compile.path">
    <pathElement path="lib/deps.jar" location="lib/deps.jar"/>
    <fileset dir="lib">
      <patternset>
        <inexcludes xsi:type="Ant:Includes" name="**/*.jar"/>
        <inexcludes xsi:type="Ant:Excludes" name="**/test-*.jar" ifCondition="skip.tests"/>
      </patternset>
      <include name="**/*.jar"/>
      <exclude name="**/old/*.jar" unless="keep.old.libs"/>
    </fileset>
  </path>

  <!-- Default target with several different tasks -->
  <targets xmi:id="buildTarget" name="build" description="Compile and package">
    <!-- Compile task with inExcludes and classPath to exercise multiple rules -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="true">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**"/>
      <classPath refid="compile.path"/>
    </tasks>

    <!-- Documentation task -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="MultiRuleProject API"/>

    <!-- Create build directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build/output"/>

    <!-- Copy with FileSet, FilterSet, Mapper to trigger many rules -->
    <tasks xsi:type="Ant:Copy" todir="build/output" overwrite="true">
      <fileset dir="resources">
        <patternset>
          <inexcludes xsi:type="Ant:IncludesFile" name="includes.list"/>
          <inexcludes xsi:type="Ant:ExcludesFile" name="excludes.list"/>
        </patternset>
        <include name="**/*.properties"/>
        <exclude name="**/secret/**"/>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="projectName" value="MultiRuleProject"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
      <mapper type="glob" from="*.txt" to="*.cfg"/>
    </tasks>

    <!-- Archive task -->
    <tasks xsi:type="Ant:Jar" jarfile="build/output/multiruleproject.jar" basedir="build/classes" compress="true"/>

    <!-- Management properties task -->
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp" pattern="yyyy-MM-dd HH:mm:ss"/>
    </tasks>

    <!-- File deletion task -->
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="true" quiet="false" includeEmptyDirs="true" defaultexcludes="true"/>
  </targets>

  <!-- Additional target without description to show transformation independence -->
  <targets xmi:id="cleanTarget" name="clean">
    <tasks xsi:type="Ant:Delete" dir="build" quiet="true" includeEmptyDirs="true"/>
  </targets>

</Ant:Project>