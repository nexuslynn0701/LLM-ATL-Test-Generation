<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntBuild"
    basedir="project-root"
    description="Ant build with multiple targets and various tasks"
    default="mainTarget">

  <!-- Properties exercising all Ant property variants -->
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/output"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="config/build.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="config/common.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- One task definition, not referenced by tasks as required -->
  <taskdef name="custom.task" classname="com.example.ant.CustomTask"/>

  <!-- Single Path instance with nested PathElement and FileSet, all contained only -->
  <path id="compile.path">
    <pathElement path="lib/core.jar" location="lib/core.jar"/>
    <fileset dir="lib/opt">
      <!-- PatternSet with all InExcludes variants -->
      <patternset>
        <inexcludes xsi:type="Ant:Includes" name="**/*.jar"/>
        <inexcludes xsi:type="Ant:Excludes" name="**/old/*.jar" ifCondition="skip.old" unless="force.old"/>
        <inexcludes xsi:type="Ant:IncludesFile" name="includes.list"/>
        <inexcludes xsi:type="Ant:ExcludesFile" name="excludes.list"/>
      </patternset>
      <!-- Direct include/exclude entries -->
      <include name="**/*-runtime.jar"/>
      <exclude name="**/*-tests.jar"/>
    </fileset>
  </path>

  <!-- Default target with a wider variety of tasks -->
  <targets xmi:id="mainTarget" name="main" description="Main build workflow">
    <!-- Compile with includes/excludes and a simple ClassPath -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" fork="false" optimize="true" deprecation="true">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**"/>
      <classPath refid="cp.main">
        <pathElement path="target/classes" location="target/classes"/>
        <fileset dir="lib/runtime">
          <include name="**/*.jar"/>
        </fileset>
      </classPath>
    </tasks>

    <!-- Java execution task with nested ClassPath -->
    <tasks xsi:type="Ant:Java" classname="com.example.app.Main" jar="app-main.jar" fork="true">
      <classPath refid="cp.run">
        <pathElement path="lib/app.jar" location="lib/app.jar"/>
      </classPath>
    </tasks>

    <!-- Generate javadoc -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="target/site/apidocs"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Example API"/>

    <!-- Timestamp management -->
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp" pattern="yyyyMMdd-HHmmss" offset="0" unit="second" locale="en_US"/>
    </tasks>

    <!-- Archive creation -->
    <tasks xsi:type="Ant:Jar" jarfile="target/app-main.jar" basedir="target/classes" compress="true" encoding="UTF-8" manifest="META-INF/MANIFEST.MF"/>

    <!-- File-related tasks: mkdir, copy with filters and mapper, then delete -->
    <tasks xsi:type="Ant:Mkdir" dir="target/distribution"/>

    <tasks xsi:type="Ant:Copy" todir="target/distribution" overwrite="true" includeEmptyDirs="false">
      <fileset dir="target">
        <include name="app-main.jar"/>
      </fileset>
      <filterset starttoken="@{" endtoken="}">
        <filter token="project.name" value="ComplexAntBuild"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
      <mapper type="glob" from="*.jar" to="dist-*.jar" classname="org.apache.tools.ant.types.Mapper" classpath="lib/ant-mapper.jar"/>
    </tasks>

    <tasks xsi:type="Ant:Delete" dir="target/temp" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" includes="**/*" defaultexcludes="true"/>
  </targets>

  <!-- Secondary target, no depends as required -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean generated artifacts">
    <tasks xsi:type="Ant:Delete" dir="target" verbose="true" quiet="false" failonerror="false" includeEmptyDirs="true" includes="**/*" excludes="**/.git/**"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/empty"/>
  </targets>

  <!-- Third target with some tasks but still no depends -->
  <targets xmi:id="docsTarget" name="docs" description="Generate documentation only">
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="target/docs"
           packagenames="com.example.docs.*"
           defaultexcludes="false"
           author="false"
           version="true"
           use="false"
           windowtitle="Docs Only"/>
  </targets>

</Ant:Project>