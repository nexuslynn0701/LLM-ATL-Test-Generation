<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleAntProject40"
    basedir="workspace"
    description="Ant project with multiple targets and tasks for ATL testing"
    default="buildTarget">

  <!-- Properties to trigger AntProperty* rules -->
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build/output"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.file" location="conf/config.properties"/>
  <properties xsi:type="Ant:PropertyFile" file="conf/default.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- A standalone task definition (no references from tasks) -->
  <taskdef name="customTask" classname="com.example.ant.CustomTask"/>

  <!-- Default target with several different tasks -->
  <targets xmi:id="buildTarget" name="build" description="Main build target">
    <!-- Compile task with inExcludes to trigger Javac and InExcludes-related rules -->
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="true">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java" ifCondition="compile.enabled" unless="skip.compile"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**" ifCondition="exclude.internal" unless=""/>
    </tasks>

    <!-- Javadoc task -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/javadoc"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Sample API Documentation"/>

    <!-- Jar task -->
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample-040.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="META-INF/MANIFEST.MF"/>

    <!-- Mkdir task -->
    <tasks xsi:type="Ant:Mkdir" dir="build/temp"/>

    <!-- Copy task with FileSet, FilterSet, Mapper, Filter, FiltersFile, PatternSet, Includes, Excludes -->
    <tasks xsi:type="Ant:Copy" todir="build/distribution" overwrite="true" includeEmptyDirs="false">
      <fileset dir="resources">
        <patternset>
          <inexcludes xsi:type="Ant:Includes" name="**/*.xml" ifCondition="include.xml" unless=""/>
          <inexcludes xsi:type="Ant:Excludes" name="**/draft/**" ifCondition="" unless="exclude.drafts"/>
        </patternset>
        <include name="**/*.properties" ifCondition="" unless="skip.properties"/>
        <exclude name="**/secret/**" ifCondition="mask.secret" unless=""/>
      </fileset>
      <filterset starttoken="@(" endtoken=")">
        <filter token="project.name" value="SampleAntProject40"/>
        <filtersfile file="conf/filters.properties"/>
      </filterset>
      <mapper type="glob" classname="com.example.Mapper" classpath="" classpathref="" from="*.txt" to="*.cfg"/>
    </tasks>

    <!-- Delete task -->
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="false" includes="**/*" excludes="**/*.keep"/>

    <!-- Tstamp task with FormatTstamp child (FormatTstamp itself is not transformed but is valid Ant) -->
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.timestamp" pattern="yyyyMMdd-HHmmss" offset="0" unit="hour" locale="en_US"/>
    </tasks>
  </targets>

  <!-- Additional target with Java and path-related structures -->
  <targets xmi:id="runTarget" name="run" description="Execution target">
    <!-- Java task with ClassPath, PathElement and FileSet -->
    <tasks xsi:type="Ant:Java" classname="com.example.Main" jar="dist/sample-040.jar" fork="true">
      <classPath refid="cp-main">
        <pathElement path="lib/dependency1.jar" location="lib/dependency1.jar"/>
        <pathElement path="lib/dependency2.jar" location="lib/dependency2.jar"/>
        <fileset dir="lib/extra">
          <patternset>
            <inexcludes xsi:type="Ant:Includes" name="**/*.jar" ifCondition="" unless=""/>
          </patternset>
        </fileset>
      </classPath>
    </tasks>
  </targets>

  <!-- Path definition with nested PathElement, FileSet, PatternSet, IncludesFile and ExcludesFile -->
  <path id="runtime.path">
    <pathElement path="build/classes" location="build/classes"/>
    <fileset dir="lib">
      <patternset>
        <inexcludes xsi:type="Ant:IncludesFile" name="includes.list" ifCondition="" unless=""/>
        <inexcludes xsi:type="Ant:ExcludesFile" name="excludes.list" ifCondition="" unless=""/>
      </patternset>
    </fileset>
  </path>
</Ant:Project>