<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MultiPhaseBuild"
    basedir="source"
    description="Multi-phase build with compilation, documentation, packaging, and cleanup."
    default="build-main">
  <!-- Properties of various kinds -->
  <properties xsi:type="Ant:PropertyValue" name="project.name" value="MultiPhaseBuild"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- A user-defined task type (not referenced by any task) -->
  <taskdef name="custom.check" classname="com.example.ant.CustomCheck"/>

  <!-- Target used as default -->
  <targets xmi:id="build-main" name="build-main" description="Compile, document and package the project.">
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true"/>
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/javadoc"
           packagenames="com.example.*"
           defaultexcludes="yes"
           author="true"
           version="true"
           use="true"
           windowtitle="MultiPhaseBuild API"/>
    <tasks xsi:type="Ant:Jar"
           jarfile="dist/multiphasebuild.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>
  </targets>

  <!-- Auxiliary target for preparing directories -->
  <targets xmi:id="prepare" name="prepare" description="Create necessary directories.">
    <tasks xsi:type="Ant:Mkdir" dir="build"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>

  <!-- Cleanup target -->
  <targets xmi:id="cleanup" name="cleanup" description="Remove build directories.">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="false"/>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" failonerror="false"/>
  </targets>

  <!-- Timestamp management target -->
  <targets xmi:id="stamp-version" name="stamp-version" description="Generate build timestamp properties.">
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
</Ant:Project>