<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="LibraryManager"
    basedir="lib-src"
    description="Library management build"
    default="buildTarget">

  <!-- Ant properties -->
  <properties xsi:type="Ant:PropertyValue" name="project.name" value="LibraryManager"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build/output"/>
  <properties xsi:type="Ant:PropertyFile" file="config/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>

  <!-- Custom task definition (not referenced by tasks, but transformed) -->
  <taskdef name="customDocTask" classname="com.example.ant.CustomDocTask"/>

  <!-- Default target with multiple tasks -->
  <targets xmi:id="buildTarget" name="build" description="Compile sources and package jar">
    <!-- Compile with includes/excludes -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="true">
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/**"/>
    </tasks>

    <!-- Generate documentation -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs"
           packagenames="com.example.library.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="LibraryManager API"/>
  </targets>

  <!-- Secondary target with file, archive and management tasks -->
  <targets xmi:id="distTarget" name="dist" description="Prepare distribution">
    <!-- Prepare directories -->
    <tasks xsi:type="Ant:Mkdir" dir="build/dist"/>

    <!-- Copy compiled classes (simple copy, no nested sets) -->
    <tasks xsi:type="Ant:Copy"
           todir="build/dist/classes"
           overwrite="true"
           includeEmptyDirs="false"/>

    <!-- Create jar archive -->
    <tasks xsi:type="Ant:Jar"
           jarfile="build/dist/library-manager.jar"
           basedir="build/classes"
           compress="true"
           encoding="UTF-8"
           manifest="META-INF/MANIFEST.MF"/>

    <!-- Timestamp management -->
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>

  <!-- Cleanup target -->
  <targets xmi:id="cleanTarget" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="true"
           includeEmptyDirs="true"
           includes="**/*"
           excludes="**/.git/**"
           defaultexcludes="true"/>
  </targets>

</Ant:Project>