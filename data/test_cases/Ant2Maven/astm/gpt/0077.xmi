<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ComplexAntBuild"
    basedir="src/main/java"
    description="Ant build with multiple compilation and packaging steps."
    default="buildMain">

  <!-- Properties -->
  <properties xsi:type="Ant:PropertyValue" name="main.src" value="src/main/java"/>
  <properties xsi:type="Ant:PropertyValue" name="test.src" value="src/test/java"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>

  <!-- Task definition (not referenced by any task, as required) -->
  <taskdef name="customCheck" classname="com.example.ant.CustomCheckTask"/>

  <!-- Default target: main build -->
  <targets xmi:id="buildMain" name="buildMain" description="Compile main sources and create jar">
    <!-- Create output directories -->
    <tasks xsi:type="Ant:Mkdir" dir="build/classes/main"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/libs"/>

    <!-- Compile main sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/main/java"
           destdir="build/classes/main"
           debug="true"
           fork="false"
           optimize="true"
           deprecation="false">
      <inExcludes xsi:type="Ant:Includes" name="com/example/**"/>
      <inExcludes xsi:type="Ant:Excludes" name="com/example/internal/**"/>
    </tasks>

    <!-- Generate Javadoc -->
    <tasks xsi:type="Ant:Javadoc"
           sourcepath="src/main/java"
           destdir="build/docs/api"
           packagenames="com.example.*"
           defaultexcludes="true"
           author="true"
           version="true"
           use="true"
           windowtitle="Example API Documentation"/>

    <!-- Package compiled classes -->
    <tasks xsi:type="Ant:Jar"
           jarfile="build/libs/example-main.jar"
           basedir="build/classes/main"
           compress="true"
           encoding="UTF-8"
           manifest="build/MANIFEST.MF"/>
  </targets>

  <!-- Test build target -->
  <targets xmi:id="buildTest" name="buildTest" description="Compile test sources and run cleanup">
    <!-- Create test classes directory -->
    <tasks xsi:type="Ant:Mkdir" dir="build/classes/test"/>

    <!-- Compile test sources -->
    <tasks xsi:type="Ant:Javac"
           srcdir="src/test/java"
           destdir="build/classes/test"
           debug="false"
           fork="false"
           optimize="false"
           deprecation="true">
      <inExcludes xsi:type="Ant:IncludesFile" name="includes-tests.txt"/>
      <inExcludes xsi:type="Ant:ExcludesFile" name="excludes-tests.txt"/>
    </tasks>

    <!-- Temporary jar for tests -->
    <tasks xsi:type="Ant:Jar"
           jarfile="build/libs/example-tests.jar"
           basedir="build/classes/test"
           compress="false"
           encoding="UTF-8"/>

    <!-- Cleanup temporary test output -->
    <tasks xsi:type="Ant:Delete"
           dir="build/tmp"
           verbose="true"
           quiet="false"
           failonerror="false"
           includeEmptyDirs="true"
           includes="**/*"
           excludes="logs/**"
           defaultexcludes="false"/>
  </targets>

  <!-- Auxiliary cleanup target (not default) -->
  <targets xmi:id="cleanAll" name="cleanAll" description="Remove all build outputs and directories">
    <tasks xsi:type="Ant:Delete"
           dir="build"
           verbose="true"
           quiet="false"
           failonerror="false"
           includeEmptyDirs="true"
           includes="**/*"
           excludes=""
           defaultexcludes="false"/>
    <tasks xsi:type="Ant:Mkdir" dir="build"/>
  </targets>

</Ant:Project>