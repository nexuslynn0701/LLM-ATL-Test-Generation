<?xml version="1.0" encoding="ASCII"?>
<Ant:Project xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Ant="Ant" name="BuildProject" default="build" basedir="/project" description="Main build project">
  <targets xmi:id="build" name="build" description="Build everything">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src/main/java" destdir="target/docs" packagenames="com.example" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="My API"/>
    <tasks xsi:type="Ant:Jar" jarfile="target/app.jar" basedir="target/classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/generated"/>
    <tasks xsi:type="Ant:Copy" todir="target/dist" filtering="false" flatten="true"/>
    <tasks xsi:type="Ant:Delete" dir="target/temp" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run tests">
    <tasks xsi:type="Ant:Java" classname="org.junit.runner.JUnitCore" jar="" fork="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.version" value="2.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="workspace" location="/home/user/workspace"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="myTask" classname="com.custom.Task"/>
  <path id="classpath" refid="">
    <pathElement path="lib/tools.jar" location="lib"/>
  </path>
</Ant:Project>