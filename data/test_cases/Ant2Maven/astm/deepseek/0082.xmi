<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    default="build"
    basedir="src"
    description="Main build project">
  <targets xmi:id="build" name="build">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="bin" debug="true" optimize="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="bin" compress="true"/>
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="doc"
        packagenames="com.example"
        defaultexcludes="yes"
        author="John"
        version="1.0"
        use="true"
        windowtitle="API"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/temp"/>
    <tasks xsi:type="Ant:Delete" dir="build/old" verbose="true"/>
    <tasks xsi:type="Ant:Tstamp"/>
    <tasks xsi:type="Ant:Copy" todir="dist/lib" filtering="true"/>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Java" classname="com.example.TestRunner" fork="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="test-reports"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="version" value="2.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="home" location="/opt/app"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customTask" classname="com.example.CustomTask"/>
  <path id="compile.path">
    <pathElement path="lib/tools.jar" location="lib/tools.jar"/>
    <fileset dir="lib">
      <include name="*.jar"/>
      <exclude name="test.jar"/>
    </fileset>
    <patternset>
      <inexcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inexcludes xsi:type="Ant:Excludes" name="**/*Test.java"/>
    </patternset>
    <filterset starttoken="@" endtoken="@">
      <filter token="version" value="1.0"/>
      <filtersfile file="filter.properties"/>
    </filterset>
  </path>
</Ant:Project>