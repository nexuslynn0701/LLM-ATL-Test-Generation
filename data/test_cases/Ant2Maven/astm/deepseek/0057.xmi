<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    description="Main build configuration"
    default="build"
    basedir="src">
  <targets xmi:id="build" name="build" description="Compile and package">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="classes" debug="true" optimize="false" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="classes" compress="true"/>
    <tasks xsi:type="Ant:Tstamp"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Copy" todir="dist/lib">
      <fileset dir="lib"/>
    </tasks>
    <tasks xsi:type="Ant:Delete" dir="temp"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Remove build artifacts">
    <tasks xsi:type="Ant:Delete" dir="classes"/>
    <tasks xsi:type="Ant:Delete" dir="dist"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="config.dir" location="/etc/app"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customtask" classname="com.example.CustomTask"/>
  <path id="classpath">
    <pathElement path="/usr/lib/tools.jar" location="/usr/lib"/>
  </path>
</Ant:Project>