<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="TestProject"
    description="A test project for transformation"
    default="build"
    basedir="/home/user/project">
  <targets xmi:id="build" name="build">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="classes" debug="true" optimize="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="classes" compress="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Copy" todir="backup">
      <fileset dir="src"/>
    </tasks>
    <tasks xsi:type="Ant:Delete" dir="tmp"/>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="test-classes" debug="true"/>
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="docs"
        packagenames="com.example"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="false"
        windowtitle="Test API"/>
  </targets>
  <path id="main.path">
    <pathElement path="/lib/tools.jar" location="/usr/local/lib/tools.jar"/>
    <fileset dir="/lib">
      <include name="**/*.jar"/>
    </fileset>
  </path>
  <properties xsi:type="Ant:PropertyValue" name="app.version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="basedir" location="/home/user/project"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <filterset>
    <filter token="VERSION" value="1.0.0"/>
    <filtersfile file="default.properties"/>
  </filterset>
  <patternset>
    <inexcludes xsi:type="Ant:Includes" name="**/*.java" ifCondition="debug" unless="release"/>
    <inexcludes xsi:type="Ant:Excludes" name="**/*.class"/>
  </patternset>
</Ant:Project>