<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="TestProject"
    description="A test project for Ant2Maven transformation"
    default="build"
    basedir="/home/project">
    
    <targets xmi:id="build" name="build" description="Build the project">
        <tasks xsi:type="Ant:Javac" srcdir="src" destdir="classes" debug="true" optimize="true" deprecation="false"/>
        <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="docs" packagenames="com.example" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="Test API"/>
        <tasks xsi:type="Ant:Jar" jarfile="dist/test.jar" basedir="classes" compress="true"/>
    </targets>
    
    <targets xmi:id="clean" name="clean" description="Clean build artifacts">
        <tasks xsi:type="Ant:Delete" dir="classes"/>
        <tasks xsi:type="Ant:Delete" dir="docs"/>
        <tasks xsi:type="Ant:Delete" dir="dist"/>
    </targets>
    
    <targets xmi:id="prepare" name="prepare" description="Prepare directories">
        <tasks xsi:type="Ant:Mkdir" dir="classes"/>
        <tasks xsi:type="Ant:Mkdir" dir="docs"/>
        <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    </targets>
    
    <properties xsi:type="Ant:PropertyValue" name="build.version" value="1.0.0"/>
    <properties xsi:type="Ant:PropertyLocation" name="src.dir" location="/home/project/src"/>
    <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
    <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
    
    <path id="main.path">
        <pathElement path="/home/project/lib" location="/home/project/lib/util.jar"/>
    </path>
    
    <taskdef name="mytask" classname="com.example.MyTask"/>
    
</Ant:Project>