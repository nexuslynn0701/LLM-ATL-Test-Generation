<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    description="A sample project for testing"
    default="build"
    basedir="/home/project">
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="/home/project/build"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="/home/project/build" debug="true" fork="false" optimize="false" deprecation="false"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="/home/project/docs" packagenames="com.example" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="API"/>
  </targets>
  <targets xmi:id="build" name="build" description="Build the project">
    <tasks xsi:type="Ant:Jar" jarfile="/home/project/dist/app.jar" basedir="/home/project/build" compress="true" encoding="UTF-8" manifest="/home/project/META-INF/MANIFEST.MF"/>
    <tasks xsi:type="Ant:Copy" todir="/home/project/dist" filtering="true" flatten="false" includeEmptyDirs="true"/>
    <tasks xsi:type="Ant:Delete" dir="/home/project/temp"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="/home/project/lib"/>
  <properties xsi:type="Ant:PropertyFile" file="/home/project/build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="PATH"/>
  <path id="classpath" refid="">
    <pathElement path="/home/project/lib" location="/home/project/lib/commons.jar"/>
  </path>
  <taskdef name="customtask" classname="com.example.CustomTask"/>
</Ant:Project>