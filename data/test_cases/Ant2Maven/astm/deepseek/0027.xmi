<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    default="build"
    basedir="/home/project"
    description="A sample Ant project for transformation testing">
  <targets xmi:id="build" name="build" description="Build the project">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" optimize="true"/>
  </targets>
  <targets xmi:id="jar" name="jar" description="Create JAR">
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample.jar" basedir="build/classes"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Clean build artifacts">
    <tasks xsi:type="Ant:Delete" dir="build"/>
    <tasks xsi:type="Ant:Delete" dir="dist"/>
  </targets>
  <targets xmi:id="docs" name="docs" description="Generate documentation">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="docs/api"
        packagenames="com.example"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="Sample API"/>
  </targets>
  <targets xmi:id="prepare" name="prepare" description="Prepare directories">
    <tasks xsi:type="Ant:Mkdir" dir="build"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Mkdir" dir="docs"/>
  </targets>
  <targets xmi:id="all" name="all" description="Run all targets">
    <tasks xsi:type="Ant:Copy" todir="backup" fileset="//@path.0/@fileset.0"/>
  </targets>
  <property
      xsi:type="Ant:PropertyValue"
      name="build.dir"
      value="build"/>
  <property
      xsi:type="Ant:PropertyLocation"
      name="lib.dir"
      location="/usr/lib"/>
  <property
      xsi:type="Ant:PropertyFile"
      file="build.properties"/>
  <property
      xsi:type="Ant:PropertyEnv"
      environment="PATH"/>
  <taskdef name="custom" classname="com.example.CustomTask"/>
</Ant:Project>