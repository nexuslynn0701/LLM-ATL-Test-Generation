<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    basedir="/home/user/project"
    description="Main build project"
    default="compile">
  <targets xmi:id="compile" name="compile" description="Compiles the source code">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" optimize="false" deprecation="true"/>
    <tasks xsi:type="Ant:Copy" todir="build/classes/resources"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
  <targets xmi:id="jar" name="jar" description="Creates the JAR file">
    <tasks xsi:type="Ant:Jar" jarfile="dist/myapp.jar" basedir="build/classes" compress="true"/>
  </targets>
  <targets xmi:id="clean" name="clean" description="Cleans the build directory">
    <tasks xsi:type="Ant:Delete" dir="build"/>
    <tasks xsi:type="Ant:Mkdir" dir="build"/>
  </targets>
  <targets xmi:id="doc" name="doc" description="Generates Javadoc documentation">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="docs/api" packagenames="com.example" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="MyApp API"/>
  </targets>
  <targets xmi:id="run" name="run" description="Runs the application">
    <tasks xsi:type="Ant:Java" classname="com.example.Main" fork="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="/usr/lib/java"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="mycustomtask" classname="com.example.CustomTask"/>
</Ant:Project>