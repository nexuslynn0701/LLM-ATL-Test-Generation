<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="MyProject"
    description="A sample project"
    default="build"
    basedir=".">
  <targets xmi:id="build" name="build">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="classes" debug="true" optimize="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/myapp.jar" basedir="classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="output"/>
    <tasks xsi:type="Ant:Copy" todir="output">
      <fileset dir="resources">
        <include name="**/*.txt"/>
        <exclude name="**/temp.txt"/>
      </fileset>
    </tasks>
    <tasks xsi:type="Ant:Tstamp"/>
    <tasks xsi:type="Ant:Delete" dir="tempfiles"/>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="docs" packagenames="com.example" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="API"/>
    <tasks xsi:type="Ant:Mkdir" dir="testreports"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="app.version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="home.dir" location="/usr/local/app"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="PATH"/>
  <path id="classpath.id">
    <pathElement path="/lib/tools.jar" location="/usr/lib/tools.jar"/>
    <fileset dir="lib">
      <include name="*.jar"/>
    </fileset>
  </path>
</Ant:Project>