<?xml version="1.0" encoding="ASCII"?>
<Ant:Project xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Ant="Ant" name="BuildProject" description="Main build project" basedir="src" default="compile">
  <targets xmi:id="compile" name="compile" description="Compile all sources">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="bin" debug="true" optimize="false" deprecation="true"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="doc/api" packagenames="com.example" defaultexcludes="yes" author="yes" version="yes" use="yes" windowtitle="API"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Copy" todir="dist/lib">
      <fileset dir="lib"/>
    </tasks>
    <tasks xsi:type="Ant:Delete" dir="build/tmp"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
  <targets xmi:id="test" name="test" description="Run unit tests">
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="bin" compress="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="home" location="/usr/local"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <path id="classpath.id">
    <pathElement path="/usr/lib" location="/usr/lib"/>
  </path>
  <taskdef name="custom" classname="com.example.CustomTask"/>
</Ant:Project>