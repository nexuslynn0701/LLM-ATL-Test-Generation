<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="CoverageProject"
    description="A model covering many ATL rules"
    default="build"
    basedir="src">
  <targets xmi:id="build" name="build">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="classes" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="docs" packagenames="com.example" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="My API"/>
    <tasks xsi:type="Ant:Java" classname="com.example.Main" jar="" fork="no"/>
    <tasks xsi:type="Ant:Tstamp"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Copy" todir="backup"/>
    <tasks xsi:type="Ant:Delete" dir="temp"/>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Mkdir" dir="test-reports"/>
    <tasks xsi:type="Ant:Delete" dir="test-classes"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.version" value="1.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="/opt/libs"/>
  <properties xsi:type="Ant:PropertyFile" file="config.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
</Ant:Project>