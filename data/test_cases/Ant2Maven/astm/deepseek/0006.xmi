<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    description="A sample project for testing"
    default="build"
    basedir=".">
  <targets xmi:id="build" name="build">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="false"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/sample.jar" basedir="build/classes" compress="true"/>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="build"/>
    <tasks xsi:type="Ant:Delete" file="dist/sample.jar"/>
  </targets>
  <targets xmi:id="all" name="all">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="docs/api"
        packagenames="com.sample.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="Sample API"/>
    <tasks xsi:type="Ant:Tstamp"/>
    <tasks xsi:type="Ant:Copy"
        todir="build/resources"
        file="src/resources/config.xml"
        overwrite="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.dir" value="build"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="/usr/local/lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
</Ant:Project>