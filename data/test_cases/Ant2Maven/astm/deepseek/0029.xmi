<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    description="Main build project"
    default="compile"
    basedir="src">
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="bin" debug="true" optimize="true"/>
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="docs"
        packagenames="com.example"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="API"/>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Mkdir" dir="build/test"/>
    <tasks xsi:type="Ant:Copy" todir="build/test">
      <fileset dir="testdata"/>
    </tasks>
    <tasks xsi:type="Ant:Delete" dir="build/test"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="app.version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="src.dir" location="src/main"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="HOME"/>
  <taskdef name="customtask" classname="com.example.CustomTask"/>
</Ant:Project>