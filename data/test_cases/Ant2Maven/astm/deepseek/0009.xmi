<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ProjectWithProperties"
    description="This project has properties and various tasks"
    default="main"
    basedir=".">
  <properties xsi:type="Ant:PropertyValue" name="builddir" value="build"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="/usr/local/lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="${builddir}"/>
  </targets>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="${builddir}" debug="true" optimize="false" deprecation="false"/>
  </targets>
  <targets xmi:id="dist" name="dist">
    <tasks xsi:type="Ant:Jar" jarfile="dist/MyApplication.jar" basedir="${builddir}" compress="true"/>
  </targets>
  <targets xmi:id="javadoc" name="javadoc">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="doc"
        packagenames="com.example"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="My Application API"/>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="${builddir}"/>
  </targets>
  <targets xmi:id="copy-resources" name="copy-resources">
    <tasks xsi:type="Ant:Copy" todir="${builddir}/resources"/>
  </targets>
  <targets xmi:id="timestamp" name="timestamp">
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
</Ant:Project>