<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    description="A comprehensive build project"
    default="deploy"
    basedir="/home/project">
  <targets xmi:id="deploy" name="deploy">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" optimize="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/myapp.jar" basedir="build/classes" compress="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
    <tasks xsi:type="Ant:Copy" todir="dist/lib">
      <fileset dir="lib" />
      <filterset>
        <filter token="version" value="1.0"/>
        <filtersfile file="config/filters.properties"/>
      </filterset>
    </tasks>
    <tasks xsi:type="Ant:Delete" dir="tmp"/>
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="docs/api"
        packagenames="com.example"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="MyApp API"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="TODAY" pattern="yyyy-MM-dd" locale="en_US"/>
    </tasks>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="build/test-classes" deprecation="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.version" value="1.2.3"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="/usr/local/lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <path id="classpath" />
  <taskdef name="customtask" classname="com.example.CustomTask"/>
</Ant:Project>