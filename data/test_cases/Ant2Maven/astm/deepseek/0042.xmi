<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    description="A sample Ant project for testing"
    default="build"
    basedir="/home/user/project">
  <properties xsi:type="Ant:PropertyValue" name="app.version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="/home/user/libs"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="build"/>
    <tasks xsi:type="Ant:Delete" dir="dist"/>
  </targets>
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="build" name="build">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="false"/>
    <tasks xsi:type="Ant:Copy" todir="build/classes">
      <fileset dir="src/resources"/>
    </tasks>
  </targets>
  <targets xmi:id="package" name="package" description="Package the application">
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes" compress="true"/>
  </targets>
  <targets xmi:id="docs" name="docs">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="dist/javadoc" packagenames="com.example" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="Sample API"/>
  </targets>
  <targets xmi:id="test" name="test">
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
</Ant:Project>