<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    description="A sample project for testing"
    default="build"
    basedir="/home/project">
  <targets xmi:id="build" name="build" description="Main build target">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="bin" debug="true" optimize="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="bin" compress="true"/>
    <tasks xsi:type="Ant:Mkdir" dir="build/temp"/>
    <tasks xsi:type="Ant:Delete" dir="build/temp" verbose="true"/>
    <tasks xsi:type="Ant:Copy" todir="dist" flatten="true">
      <fileset dir="resources">
        <include name="*.xml"/>
        <exclude name="backup/**"/>
      </fileset>
    </tasks>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyyMMdd-HHmmss"/>
    </tasks>
  </targets>
  <targets xmi:id="test" name="test" description="Test target">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="docs"
        packagenames="com.example"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="API Documentation"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="build.version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="/usr/local/lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <path id="classpath">
    <pathElement path="/usr/lib/java" location="/usr/lib/java"/>
  </path>
  <taskdef name="customtask" classname="com.example.CustomTask"/>
</Ant:Project>