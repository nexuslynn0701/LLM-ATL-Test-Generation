<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="BuildProject"
    basedir="/home/project"
    description="Main build file"
    default="compile">
  <properties
      xsi:type="Ant:PropertyValue"
      name="app.version"
      value="1.0.0"/>
  <properties
      xsi:type="Ant:PropertyLocation"
      name="src.dir"
      location="/home/project/src"/>
  <properties
      xsi:type="Ant:PropertyFile"
      file="/home/project/build.properties"/>
  <properties
      xsi:type="Ant:PropertyEnv"
      environment="PATH"/>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="bin" debug="true" fork="false" optimize="true" deprecation="false">
      <inExcludes xsi:type="Ant:Includes" name="**/*Test.java" ifCondition="skip.tests" unless="run.tests"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/*.svn" ifCondition="clean.svn" unless="keep.svn"/>
    </tasks>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="bin" compress="true" encoding="UTF-8" manifest="MANIFEST.MF"/>
  </targets>
  <targets xmi:id="doc" name="doc" description="Generate documentation" ifCondition="generate.doc">
    <tasks xsi:type="Ant:Javadoc" sourcepath="src" destdir="docs/api" packagenames="com.example" defaultexcludes="yes" author="true" version="true" use="true" windowtitle="My API"/>
  </targets>
  <targets xmi:id="archive" name="archive">
    <tasks xsi:type="Ant:Mkdir" dir="dist/backup"/>
    <tasks xsi:type="Ant:Copy" todir="dist/backup">
      <fileset dir="dist">
        <include name="*.jar"/>
        <exclude name="old.jar"/>
      </fileset>
    </tasks>
    <tasks xsi:type="Ant:Delete" dir="dist/temp"/>
    <tasks xsi:type="Ant:Tstamp"/>
  </targets>
  <targets xmi:id="test" name="TestCoverage">
    <tasks xsi:type="Ant:Javac" srcdir="test" destdir="bin/test" debug="true"/>
  </targets>
</Ant:Project>