<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    default="build"
    basedir="."
    description="A sample project for testing ATL transformation">
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" fork="true">
      <classPath refid="project.classpath"/>
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/test/**"/>
    </tasks>
  </targets>
  <targets xmi:id="jar" name="jar">
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes" compress="true"/>
  </targets>
  <targets xmi:id="doc" name="doc">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="docs/api"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="Sample API"/>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="build"/>
    <tasks xsi:type="Ant:Delete" dir="dist"/>
  </targets>
  <targets xmi:id="build" name="build">
    <tasks xsi:type="Ant:Copy" todir="build/resources">
      <fileset dir="resources">
        <include name="**/*.properties"/>
        <exclude name="**/secret.properties"/>
      </fileset>
      <filterset starttoken="@" endtoken="@">
        <filter token="VERSION" value="1.0.0"/>
        <filtersfile file="filters.txt"/>
      </filterset>
    </tasks>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyy-MM-dd HH:mm:ss"/>
    </tasks>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="app.name" value="SampleApp"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <path id="project.classpath">
    <pathElement path="lib/commons-lang3.jar" location="lib"/>
    <fileset dir="lib">
      <include name="*.jar"/>
    </fileset>
  </path>
  <taskdef name="mytask" classname="com.example.MyTask"/>
</Ant:Project>