<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    default="build"
    basedir="."
    description="A sample project for testing ATL transformation">
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="build" name="build" description="Compiles and packages the application">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes" debug="true" deprecation="true"/>
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes"/>
    <tasks xsi:type="Ant:Copy" todir="backup">
      <fileset dir="src">
        <include name="**/*.java"/>
        <exclude name="**/test/**"/>
      </fileset>
      <filterset starttoken="@" endtoken="@">
        <filter token="VERSION" value="1.0.0"/>
      </filterset>
    </tasks>
    <tasks xsi:type="Ant:Delete" dir="temp" includeEmptyDirs="true"/>
  </targets>
  <properties xsi:type="Ant:PropertyValue" name="app.name" value="SampleApp"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="customTask" classname="com.example.CustomTask"/>
  <path id="compile.path">
    <pathElement path="lib/commons-lang3.jar" location="lib"/>
    <fileset dir="lib">
      <include name="*.jar"/>
    </fileset>
  </path>
</Ant:Project>