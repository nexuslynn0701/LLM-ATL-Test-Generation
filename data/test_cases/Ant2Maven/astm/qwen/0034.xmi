<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    basedir="."
    description="A sample project for testing ATL transformation"
    default="build">
  <properties xsi:type="Ant:PropertyValue" name="version" value="1.0.0"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="target"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <path id="compile.classpath">
    <pathElement path="lib/commons-lang3.jar" location="lib"/>
    <fileset dir="lib">
      <include name="*.jar"/>
      <exclude name="test-*.jar"/>
    </fileset>
  </path>
  <taskdef name="mytask" classname="com.example.MyTask"/>
  <targets xmi:id="init" name="init" description="Initialize directories">
    <tasks xsi:type="Ant:Mkdir" dir="target/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="target/test-classes"/>
  </targets>
  <targets xmi:id="compile" name="compile" description="Compile source code">
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="target/classes" debug="true">
      <classPath refid="compile.classpath"/>
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/internal/*.java"/>
    </tasks>
  </targets>
  <targets xmi:id="jar" name="jar" description="Package into JAR">
    <tasks xsi:type="Ant:Jar" jarfile="target/sample-1.0.0.jar" basedir="target/classes" manifest="MANIFEST.MF"/>
  </targets>
  <targets xmi:id="copy-resources" name="copy-resources">
    <tasks xsi:type="Ant:Copy" todir="target/classes">
      <fileset dir="src/main/resources">
        <include name="**/*.properties"/>
        <exclude name="**/secret.properties"/>
      </fileset>
      <filterset starttoken="@" endtoken="@">
        <filter token="version" value="1.0.0"/>
        <filtersfile file="filters.properties"/>
      </filterset>
    </tasks>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="target" includeEmptyDirs="true"/>
  </targets>
  <targets xmi:id="build" name="build" description="Full build process">
    <tasks xsi:type="Ant:Java" classname="com.example.Builder" fork="true">
      <classPath>
        <pathElement path="target/classes" location="."/>
        <fileset dir="lib">
          <include name="*.jar"/>
        </fileset>
      </classPath>
    </tasks>
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src/main/java"
        destdir="target/docs"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="Sample API"/>
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyy-MM-dd HH:mm:ss"/>
    </tasks>
  </targets>
</Ant:Project>