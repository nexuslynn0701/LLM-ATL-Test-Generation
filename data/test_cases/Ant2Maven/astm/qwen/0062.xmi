<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="SampleProject"
    default="build"
    basedir="."
    description="A sample project for testing ATL transformation">
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src"/>
  <properties xsi:type="Ant:PropertyLocation" name="lib.dir" location="lib"/>
  <properties xsi:type="Ant:PropertyFile" file="build.properties"/>
  <properties xsi:type="Ant:PropertyEnv" environment="JAVA_HOME"/>
  <taskdef name="mytask" classname="com.example.MyTask"/>
  <path id="compile.classpath">
    <pathElement path="lib/commons.jar" location="lib"/>
    <fileset dir="lib">
      <include name="*.jar"/>
      <exclude name="test-*.jar"/>
    </fileset>
  </path>
  <targets xmi:id="init" name="init">
    <tasks xsi:type="Ant:Mkdir" dir="build/classes"/>
    <tasks xsi:type="Ant:Mkdir" dir="dist"/>
  </targets>
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac" srcdir="src" destdir="build/classes">
      <classPath refid="compile.classpath"/>
      <inExcludes xsi:type="Ant:Includes" name="**/*.java"/>
      <inExcludes xsi:type="Ant:Excludes" name="**/Test*.java"/>
    </tasks>
  </targets>
  <targets xmi:id="jar" name="jar">
    <tasks xsi:type="Ant:Jar" jarfile="dist/app.jar" basedir="build/classes"/>
  </targets>
  <targets xmi:id="doc" name="doc">
    <tasks xsi:type="Ant:Javadoc"
        sourcepath="src"
        destdir="doc/api"
        packagenames="com.example.*"
        defaultexcludes="yes"
        author="true"
        version="true"
        use="true"
        windowtitle="My API"/>
  </targets>
  <targets xmi:id="clean" name="clean">
    <tasks xsi:type="Ant:Delete" dir="build"/>
    <tasks xsi:type="Ant:Delete" dir="dist"/>
  </targets>
  <targets xmi:id="copy-resources" name="copy-resources">
    <tasks xsi:type="Ant:Copy" todir="build/classes">
      <fileset dir="src">
        <include name="**/*.properties"/>
        <exclude name="**/test.properties"/>
      </fileset>
      <filterset starttoken="@" endtoken="@">
        <filter token="VERSION" value="1.0.0"/>
        <filtersfile file="filters.txt"/>
      </filterset>
      <mapper type="glob" from="*.properties" to="*.properties"/>
    </tasks>
  </targets>
  <targets xmi:id="timestamp" name="timestamp">
    <tasks xsi:type="Ant:Tstamp">
      <format property="build.time" pattern="yyyy-MM-dd HH:mm:ss"/>
    </tasks>
  </targets>
  <targets xmi:id="run" name="run">
    <tasks xsi:type="Ant:Java" classname="com.example.Main" fork="true">
      <classPath refid="compile.classpath"/>
    </tasks>
  </targets>
  <targets xmi:id="build" name="build" description="Main build target">
    <tasks xsi:type="Ant:NewTask" taskName="//@taskdef.0">
      <attributes name="outputDir" value="build/output"/>
      <attributes name="verbose" value="true"/>
    </tasks>
  </targets>
</Ant:Project>