<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <subActions id="action2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="user1@domain.com"/>
        <addresses is="user2@domain.com"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="action1"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="action2"/>
            </busy>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default contents="//@elements.4"/>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@domain.com" priority="1" clear="no"/>
  <elements xsi:type="CPL:Location" url="sip:primary@domain.com" priority="2" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="action1"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Location" url="sip:voicemail@domain.com" priority="1" clear="yes"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:SubCall" ref="action2"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
    </failure>
    <default>
      <contents xsi:type="CPL:TimeSwitch" dtstart="20240101T000000" interval="P1D" wkst="MO">
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="action1"/>
        </otherwise>
      </contents>
    </default>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="action2"/>
</CPL:CPLModel>