<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction"/>
    <outgoing/>
    <incoming/>
  </elements>
  <elements xsi:type="CPL:SubAction" id="mainAction">
    <contents xsi:type="CPL:AddressSwitch" field="destination">
      <addresses is="user@example.com" contains="@example.com" subDomainOf="example.com">
        <contents xsi:type="CPL:Location" url="sip:user@voip.example.com" priority="1" clear="no"/>
      </addresses>
      <addresses is="admin@example.com" contains="@example.com" subDomainOf="example.com"/>
      <notPresent>
        <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
          <default>
            <contents xsi:type="CPL:SubCall" ref="mainAction"/>
          </default>
        </contents>
      </notPresent>
      <otherwise>
        <contents xsi:type="CPL:Redirect" permanent="false"/>
      </otherwise>
    </contents>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="603" reason="Decline"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="mainAction"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="no"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="500" reason="Server Error"/>
    </failure>
    <default>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:user@example.com" contains="sip:" subDomainOf="example.com">
          <contents xsi:type="CPL:Location" url="sip:user@home.example.com" priority="1" clear="no"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:user@office.example.com" priority="1" clear="no"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </otherwise>
      </contents>
    </default>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent" contains="urgent"/>
    <strings is="spam" contains="spam"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:inbox@example.com" priority="1" clear="no"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="es"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="no"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="406" reason="Not Acceptable"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://example.com/tz.ics">
    <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
    <times dtstart="20240201T100000" dtend="20240215T180000" interval="2" wkst="TU"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:afterhours@example.com" priority="1" clear="no"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="3" greater="5" equal="4"/>
    <priorities less="1" greater="10"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:lowpriority@example.com" priority="1" clear="no"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
        <default>
          <contents xsi:type="CPL:SubCall" ref="mainAction"/>
        </default>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="mainAction"/>
</CPL:CPLModel>