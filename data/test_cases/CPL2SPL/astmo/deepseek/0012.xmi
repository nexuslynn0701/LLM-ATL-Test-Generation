<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <subActions id="action2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="destination">
        <addresses is="sip:user@domain.com"/>
        <notPresent>
          <contents xsi:type="CPL:SubCall" ref="action1"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="action2"/>
            </busy>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="603" reason="Decline"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="1" clear="yes"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Location" url="sip:noanswer@example.com" priority="1" clear="yes"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Location" url="sip:redirected@example.com" priority="1" clear="yes"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Location" url="sip:failure@example.com" priority="1" clear="yes"/>
    </failure>
    <default>
      <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="yes"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="sip:known@domain.com"/>
    <notPresent>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default/>
      </contents>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:default-language@example.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York">
    <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="action1"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
  <elements xsi:type="CPL:SubCall" ref="action2"/>
</CPL:CPLModel>