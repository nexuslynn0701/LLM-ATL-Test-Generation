<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <subActions id="sub2"/>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.1"/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="sub2"/>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="user-agent">
        <strings contains="MSIE"/>
        <notPresent>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </notPresent>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="false"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="false"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Location" url="sip:redirected@example.com" priority="1" clear="false"/>
    </redirection>
    <failure/>
    <default contents="//@elements.1"/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="sub2"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="603" reason="Decline"/>
  <elements xsi:type="CPL:TimeSwitch" dtstart="20250101T000000" interval="P1D" wkst="MO"/>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5"/>
  </elements>
</CPL:CPLModel>