<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <subActions id="sub2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com">
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="sub2"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="yes"/>
            </default>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="sub2"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="urgent"/>
        <notPresent>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
            </default>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:info@example.com" priority="1" clear="yes"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:alice@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:bob@example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:SubCall" ref="sub1"/>
  <elements xsi:type="CPL:SubCall" ref="sub2"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Reject" status="302" reason="Moved"/>
    </redirection>
    <failure/>
    <default>
      <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="yes"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="sip:carol@example.com">
      <contents xsi:type="CPL:SubCall" ref="sub2"/>
    </addresses>
    <notPresent>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
        </default>
      </contents>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="priority">
    <strings is="high" contains="high"/>
    <notPresent>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:SubCall" ref="sub2"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:Location" url="sip:lowpriority@example.com" priority="1" clear="yes"/>
        </default>
      </contents>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <notPresent>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:SubCall" ref="sub2"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:Location" url="sip:defaultlang@example.com" priority="1" clear="yes"/>
        </default>
      </contents>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" dtstart="20240101T000000" interval="P1D" wkst="MO">
    <times dtstart="20240101T080000" interval="PT1H" wkst="MO"/>
    <notPresent>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:Location" url="sip:timeout@example.com" priority="1" clear="yes"/>
        </default>
      </contents>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="sub2"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="10" equal="7"/>
    <notPresent>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:Location" url="sip:prioritydefault@example.com" priority="1" clear="yes"/>
        </default>
      </contents>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="sub2"/>
    </otherwise>
  </elements>
</CPL:CPLModel>