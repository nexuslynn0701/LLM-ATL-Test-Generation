<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <subActions id="action2"/>
    <outgoing/>
    <incoming/>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:test@example.com" priority="10" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="action1"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:SubCall" ref="action2"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Location" url="sip:redirect@test.com" priority="5" clear="no"/>
    </redirection>
    <failure/>
    <default/>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="user1@domain.com"/>
    <addresses is="user2@domain.com"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="subject"/>
  <elements xsi:type="CPL:SubAction" id="action1"/>
  <elements xsi:type="CPL:SubAction" id="action2"/>
</CPL:CPLModel>