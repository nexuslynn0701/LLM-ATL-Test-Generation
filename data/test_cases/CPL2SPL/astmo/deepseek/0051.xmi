<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="user@example.com">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </failure>
            <default>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </default>
          </contents>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:user@backup.com" priority="1" clear="false"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent" contains="meeting"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York">
    <times dtstart="20250101T000000" interval="1" wkst="MO"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="3" greater="5" equal="4"/>
    <notPresent/>
    <otherwise/>
  </elements>
</CPL:CPLModel>