<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <subActions id="action2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com">
          <contents xsi:type="CPL:SubCall" ref="action1"/>
        </addresses>
        <addresses is="sip:bob@example.com">
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="action2"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:SubCall" ref="action1"/>
            </default>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent">
          <contents xsi:type="CPL:Location" url="sip:urgent@example.com" priority="1" clear="yes"/>
        </strings>
        <strings is="normal">
          <contents xsi:type="CPL:SubCall" ref="action2"/>
        </strings>
        <notPresent>
          <contents xsi:type="CPL:Default">
            <contents xsi:type="CPL:Redirect" permanent="true"/>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="action1"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="action2"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="yes"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
            </failure>
            <default>
              <contents xsi:type="CPL:SubCall" ref="action1"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="action1"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:SubCall" ref="action2"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Location" url="sip:alt@example.com" priority="1" clear="yes"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="500" reason="Server Error"/>
    </failure>
    <default>
      <contents xsi:type="CPL:SubCall" ref="action1"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="sip:group@example.com">
      <contents xsi:type="CPL:Location" url="sip:member1@example.com" priority="1" clear="yes"/>
    </addresses>
    <notPresent>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="action2"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="priority">
    <strings is="high">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:SubCall" ref="action1"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:SubCall" ref="action2"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Location" url="sip:high@example.com" priority="1" clear="yes"/>
        </redirection>
        <failure>
          <contents xsi:type="CPL:Reject" status="503" reason="Unavailable"/>
        </failure>
        <default>
          <contents xsi:type="CPL:SubCall" ref="action1"/>
        </default>
      </contents>
    </strings>
    <notPresent>
      <contents xsi:type="CPL:Default">
        <contents xsi:type="CPL:SubCall" ref="action2"/>
      </contents>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
  <elements xsi:type="CPL:SubCall" ref="action2"/>
</CPL:CPLModel>