<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <subActions id="action2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com" contains="example.com" subDomainOf="example.com">
          <contents xsi:type="CPL:SubCall" ref="action1"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="action2"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Location" url="sip:bob@example.net" priority="1" clear="yes"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
            </default>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
            <busy/>
            <default>
              <contents xsi:type="CPL:SubCall" ref="action1"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="urgent"/>
        <strings is="normal" contains="normal"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="0" clear="no"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy/>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default/>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:alice@home.com" priority="10" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:bob@work.com" priority="5" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:SubCall" ref="action2"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
    </failure>
    <default>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default/>
      </contents>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="sip:carol@example.com" contains="example.com" subDomainOf="example.com">
      <contents xsi:type="CPL:Location" url="sip:carol@mobile.com" priority="1" clear="yes"/>
    </addresses>
    <notPresent>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="priority">
    <strings is="high" contains="high"/>
    <notPresent>
      <contents xsi:type="CPL:SubCall" ref="action1"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="action2"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="0" clear="no"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default/>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" dtstart="20240101T000000" interval="1" wkst="MO">
    <times dtstart="20240101T080000" interval="1" wkst="MO"/>
    <notPresent>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="486" reason="Busy"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="1" equal="3"/>
    <notPresent>
      <contents xsi:type="CPL:SubCall" ref="action1"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:operator@example.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
  <elements xsi:type="CPL:SubCall" ref="action2"/>
</CPL:CPLModel>