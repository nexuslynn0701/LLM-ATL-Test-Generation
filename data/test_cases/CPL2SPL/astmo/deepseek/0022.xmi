<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <subActions id="sub2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.1"/>
        <addresses is="10.0.0.1"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="sub2"/>
            </noAnswer>
            <redirection/>
            <failure/>
            <default>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent"/>
        <strings is="normal"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="true"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="false"/>
  <elements xsi:type="CPL:SubCall" ref="sub1"/>
  <elements xsi:type="CPL:SubCall" ref="sub2"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:SubCall" ref="sub2"/>
    </noAnswer>
    <redirection/>
    <failure/>
    <default>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="sip:alice@example.com"/>
    <addresses is="sip:bob@example.com"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default/>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="priority">
    <strings is="high"/>
    <strings is="low"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="true"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York">
    <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="1" equal="3"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </otherwise>
  </elements>
</CPL:CPLModel>