<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <subActions id="action2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.1"/>
        <addresses is="10.0.0.1"/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="action1"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:SubCall" ref="action2"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="false"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
        </default>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@domain.com" priority="2" clear="true"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent" contains="important"/>
    <notPresent/>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:Location" url="sip:voicemail@domain.com" priority="1" clear="true"/>
        </busy>
        <default>
          <contents xsi:type="CPL:SubCall" ref="action1"/>
        </default>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York">
    <times dtstart="20240101T000000" interval="1" wkst="MO"/>
    <notPresent/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="3"/>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="action2"/>
    </otherwise>
  </elements>
</CPL:CPLModel>