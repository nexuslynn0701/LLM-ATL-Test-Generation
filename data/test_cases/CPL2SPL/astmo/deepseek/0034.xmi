<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <subActions id="sub2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="destination">
        <addresses is="sip:alice@example.com">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="sub2"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Location" url="sip:bob@example.net" priority="1" clear="yes"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </default>
          </contents>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="sub2"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Location" url="sip:carol@example.org" priority="2" clear="yes"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent">
          <contents xsi:type="CPL:Location" url="sip:dave@example.com" priority="1" clear="yes"/>
        </strings>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="sub2"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Location" url="sip:eve@example.net" priority="3" clear="yes"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="sub1"/>
  <elements xsi:type="CPL:SubCall" ref="sub2"/>
  <elements xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:SubCall" ref="sub2"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Location" url="sip:proxy@example.org" priority="1" clear="yes"/>
    </redirection>
    <failure/>
    <default>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="sip:origin@example.com">
      <contents xsi:type="CPL:Location" url="sip:origin-target@example.net" priority="1" clear="yes"/>
    </addresses>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="404" reason="Origin Not Found"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:SubCall" ref="sub2"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Location" url="sip:otherwise-target@example.org" priority="2" clear="yes"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </default>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="priority">
    <strings is="high">
      <contents xsi:type="CPL:Location" url="sip:high-priority@example.com" priority="1" clear="yes"/>
    </strings>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="503" reason="No Priority"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:SubCall" ref="sub2"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Location" url="sip:low-priority@example.net" priority="3" clear="yes"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </default>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="406" reason="Not Acceptable"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:default-language@example.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York">
    <times dtstart="20240101T000000" interval="1" wkst="MO"/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="503" reason="Time Not Available"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:time-default@example.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5"/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="486" reason="Priority Not Set"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:priority-default@example.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
</CPL:CPLModel>