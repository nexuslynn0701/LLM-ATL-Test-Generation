<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <subActions id="action2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.1"/>
        <addresses is="10.0.0.1"/>
        <notPresent>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="action1"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="action2"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="false"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </default>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="meeting"/>
        <notPresent>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="2" clear="false"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Location" url="sip:assistant@example.com" priority="1" clear="true"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:SubCall" ref="action1"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
            </failure>
            <default>
              <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="false"/>
            </default>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="3" clear="true"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="1" clear="false"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Location" url="sip:noanswer@example.com" priority="1" clear="false"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Location" url="sip:redirected@example.com" priority="1" clear="false"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Location" url="sip:failure@example.com" priority="1" clear="false"/>
    </failure>
    <default>
      <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="false"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="user@domain.com" contains="domain"/>
    <addresses is="admin@domain.com" subDomainOf="domain.com"/>
    <notPresent>
      <contents xsi:type="CPL:SubCall" ref="action2"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:SubCall" ref="action1"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:SubCall" ref="action2"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Location" url="sip:alt@example.com" priority="1" clear="false"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </default>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York">
    <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:afterhours@example.com" priority="1" clear="false"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:businesshours@example.com" priority="1" clear="false"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="es"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:default-lang@example.com" priority="1" clear="false"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:other-lang@example.com" priority="1" clear="false"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="1"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:low-priority@example.com" priority="1" clear="false"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:high-priority@example.com" priority="1" clear="false"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
  <elements xsi:type="CPL:SubCall" ref="action2"/>
</CPL:CPLModel>