<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </default>
          </contents>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Reject" status="600" reason="Global Error"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="2" clear="no"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="urgent"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="sub1"/>
  <elements xsi:type="CPL:Location" url="sip:proxy@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Reject" status="486" reason="Busy"/>
    </redirection>
    <failure/>
    <default>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="sip:bob@example.com"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:other@example.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="priority">
    <strings is="high" contains="high"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Reject" status="486" reason="Busy"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </default>
      </contents>
    </otherwise>
  </elements>
</CPL:CPLModel>