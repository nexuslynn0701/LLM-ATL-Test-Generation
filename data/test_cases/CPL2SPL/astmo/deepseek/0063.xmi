<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <subActions id="action2"/>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="alice@example.com">
          <contents xsi:type="CPL:SubCall" ref="action1"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="action2"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Location" url="sip:forward@example.com" priority="1" clear="no"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:AddressSwitch" field="destination">
                <addresses is="bob@example.com">
                  <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
                    <default>
                      <contents xsi:type="CPL:Redirect" permanent="true"/>
                    </default>
                  </contents>
                </addresses>
                <otherwise>
                  <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
                </otherwise>
              </contents>
            </default>
          </contents>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings contains="urgent">
          <contents xsi:type="CPL:Location" url="sip:urgent@example.com" priority="1" clear="yes"/>
        </strings>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
            </noAnswer>
            <default/>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:location1@test.com" priority="5" clear="no"/>
  <elements xsi:type="CPL:Location" url="sip:location2@test.com" priority="10" clear="yes"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
</CPL:CPLModel>