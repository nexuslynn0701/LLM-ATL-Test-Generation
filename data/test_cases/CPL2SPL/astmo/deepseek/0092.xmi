<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <subActions id="action2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="destination">
        <addresses is="sip:alice@example.com" contains="alice"/>
        <addresses is="sip:bob@example.com" contains="bob"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="action1"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="action2"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="yes"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:proxy@example.com" priority="10" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="action1"/>
    </busy>
    <default>
      <contents xsi:type="CPL:Location" url="sip:fallback@example.com" priority="5" clear="yes"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="sip:carol@example.com" contains="carol"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:TimeSwitch" tzid="UTC">
        <times dtstart="20240101T000000" interval="1" wkst="MO"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5" greater="10" equal="7"/>
            <notPresent/>
            <otherwise>
              <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
                <busy>
                  <contents xsi:type="CPL:SubCall" ref="action2"/>
                </busy>
                <noAnswer>
                  <contents xsi:type="CPL:Redirect" permanent="false"/>
                </noAnswer>
                <redirection/>
                <failure/>
                <default/>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="User-Agent">
    <strings is="MySoftPhone" contains="softphone"/>
    <strings is="MyHardPhone" contains="hardphone"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="action1"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
  <elements xsi:type="CPL:SubCall" ref="action2"/>
</CPL:CPLModel>