<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="user@domain.com" contains="domain.com"/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="action1"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="action1"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:TimeSwitch" tzid="UTC" tzurl="http://tzurl.org">
        <times dtstart="20240101T000000" dtend="20241231T235959" interval="1" wkst="MO"/>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:user@domain.com" priority="1" clear="false"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <default>
      <contents xsi:type="CPL:Location" url="sip:backup@domain.com" priority="1" clear="false"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination" subField="user">
    <addresses is="admin@domain.com" contains="admin" subDomainOf="domain.com"/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent" contains="urgent"/>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="action1"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="3" greater="5" equal="4"/>
  </elements>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
</CPL:CPLModel>