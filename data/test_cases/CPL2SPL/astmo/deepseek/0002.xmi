<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <subActions id="sub2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com">
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </addresses>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="sub2"/>
            </busy>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default/>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Reject" status="603" reason="Decline"/>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent" contains="urgent"/>
    <strings is="normal" contains="normal"/>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York" dtstart="20240101T000000" interval="1" wkst="MO">
    <times dtstart="20240101T080000" dtend="20240101T170000" interval="1" wkst="MO"/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="1" equal="3"/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="sub1"/>
  <elements xsi:type="CPL:SubCall" ref="sub2"/>
</CPL:CPLModel>