<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <subActions id="action2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="destination">
        <addresses is="sip:user@domain.com"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="action1"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="action2"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:proxy@example.com" priority="0" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="action1"/>
    </busy>
    <default>
      <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="0" clear="yes"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="sip:alice@example.com"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:StringSwitch" field="User-Agent"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="Subject"/>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <otherwise>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York">
        <times dtstart="20250101T090000" interval="1" wkst="MO"/>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5"/>
            <otherwise>
              <contents xsi:type="CPL:SubCall" ref="action2"/>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/London">
    <times dtstart="20250101T000000" interval="1" wkst="MO"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities greater="3" equal="5"/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="action1"/>
        </otherwise>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="10" greater="1"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Reject" status="408" reason="Timeout"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:SubCall" ref="action2"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:Location" url="sip:final@example.com" priority="0" clear="no"/>
        </default>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
  <elements xsi:type="CPL:SubCall" ref="action2"/>
</CPL:CPLModel>