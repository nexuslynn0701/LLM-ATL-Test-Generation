<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <subActions id="sub2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com"/>
        <addresses is="sip:bob@example.com"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="sub2"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="meeting"/>
        <strings is="personal" contains="family"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="603" reason="Declined"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:proxy@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:SubCall" ref="sub2"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
    </redirection>
    <failure/>
    <default>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="sip:help@example.com"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tzurl.org">
        <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
        <times dtstart="20240101T000000" dtend="20240101T080000" duration="PT8H" freq="DAILY" interval="1" wkst="MO"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <languages matches="fr"/>
            <notPresent/>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="1" equal="3"/>
                <notPresent/>
                <otherwise>
                  <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
                    <busy>
                      <contents xsi:type="CPL:SubCall" ref="sub1"/>
                    </busy>
                    <noAnswer>
                      <contents xsi:type="CPL:SubCall" ref="sub2"/>
                    </noAnswer>
                    <redirection>
                      <contents xsi:type="CPL:Location" url="sip:final@example.com" priority="1" clear="yes"/>
                    </redirection>
                    <failure/>
                    <default>
                      <contents xsi:type="CPL:Redirect" permanent="true"/>
                    </default>
                  </contents>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </otherwise>
  </elements>
</CPL:CPLModel>