<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainSub">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.1" contains="example.com"/>
        <addresses is="10.0.0.1" subDomainOf="internal.org"/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="voicemailSub"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:SubCall" ref="redirectHandler"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
            </failure>
            <default>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
            </default>
          </contents>
        </otherwise>
        <notPresent>
          <contents xsi:type="CPL:SubCall" ref="notFoundHandler"/>
        </notPresent>
      </contents>
    </subActions>
    <subActions id="voicemailSub"/>
    <subActions id="redirectHandler"/>
    <subActions id="notFoundHandler"/>
    <outgoing>
      <contents xsi:type="CPL:SubCall" ref="mainSub"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="user-agent">
        <strings is="SIPPhone" contains="v1.0"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="15" recurse="no" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <default>
              <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="2" clear="no"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:entry@example.com" priority="1" clear="yes"/>
</CPL:CPLModel>