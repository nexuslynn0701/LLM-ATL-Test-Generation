<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">
  <!-- elements[0] -->
  <elements xsi:type="CPL:CPL">
    <subActions contents="//@elements.2"/>
    <outgoing contents="//@elements.1"/>
  </elements>
  <!-- elements[1] : Outgoing (method out, simple proxy content) -->
  <elements xsi:type="CPL:Outgoing">
    <contents xsi:type="CPL:Proxy" recurse="true" ordering="parallel">
      <!-- simple proxy: no handlers -->
      <busy/>
      <noAnswer/>
      <redirection/>
      <failure/>
      <default/>
    </contents>
  </elements>
  <!-- elements[2] : SubAction (simple proxy content) -->
  <elements xsi:type="CPL:SubAction" id="sa1">
    <contents xsi:type="CPL:Proxy" recurse="false" ordering="sequential">
      <!-- simple proxy: no handlers -->
      <busy/>
      <noAnswer/>
      <redirection/>
      <failure/>
      <default/>
    </contents>
  </elements>
</CPL:CPLModel>