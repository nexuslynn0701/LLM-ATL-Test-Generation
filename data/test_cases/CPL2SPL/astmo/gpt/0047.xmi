<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL with one SubAction, one Incoming, one Outgoing -->
  <elements xsi:type="CPL:CPL">
    <!-- SubAction sa1 with complex Proxy (not simple) as contents -->
    <subActions id="sa1">
      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
        <!-- all children present => notSimple -->
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <!-- default uses SubCall sc1 as its contents -->
        <default contents="//@elements.2"/>
      </contents>
    </subActions>

    <!-- Incoming method with simple Proxy as contents -->
    <incoming>
      <contents xsi:type="CPL:Proxy" timeout="20" recurse="no" ordering="sequential">
        <!-- no children => simple proxy -->
      </contents>
    </incoming>

    <!-- Outgoing method with AddressSwitch as contents -->
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="from-user">
        <!-- notPresent branch contains SubCall sc1 -->
        <notPresent contents="//@elements.2"/>
        <!-- otherwise branch contains Redirect r1 -->
        <otherwise contents="//@elements.3"/>
        <!-- one switched address with simple Proxy as contents -->
        <addresses is="user@example.com" contains="example.com" subDomainOf="example.com">
          <contents xsi:type="CPL:Proxy" timeout="10" recurse="yes" ordering="parallel">
            <!-- simple proxy: no children -->
          </contents>
        </addresses>
      </contents>
    </outgoing>
  </elements>

  <!-- 1: Location used by proxies and redirect (for URIConstant) -->
  <elements xsi:type="CPL:Location" url="sip:example.com" priority="1" clear="yes"/>

  <!-- 2: SubCall that refers to SubAction 'sa1' -->
  <elements xsi:type="CPL:SubCall" ref="sa1"/>

  <!-- 3: Redirect with permanent=false to exercise MOVED_TEMPORARILY branch -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

  <!-- 4: Standalone simple Proxy whose statement is a ReturnStat (via R7) -->
  <elements xsi:type="CPL:Proxy" timeout="15" recurse="yes" ordering="parallel">
    <!-- simple proxy: no outcome children -->
  </elements>

  <!-- 5: Standalone AddressSwitch (destination) using NotPresent/Otherwise without contents -->
  <elements xsi:type="CPL:AddressSwitch" field="destination" subField="to-user">
    <notPresent/>
    <otherwise/>
    <addresses is="other@example.org" contains="example.org" subDomainOf="example.org"/>
  </elements>

  <!-- 6: StringSwitch to exercise R16 -->
  <elements xsi:type="CPL:StringSwitch">
    <contents xsi:type="CPL:Location" url="sip:alt.example.net" priority="2" clear="no"/>
  </elements>

  <!-- 7: LanguageSwitch as SubAction contents bypassing statement creation -->
  <elements xsi:type="CPL:SubAction" id="sa2">
    <contents xsi:type="CPL:LanguageSwitch">
      <contents xsi:type="CPL:Location" url="sip:lang.example.net" priority="3" clear="yes"/>
    </contents>
  </elements>

  <!-- 8: PrioritySwitch as SubAction contents bypassing statement creation -->
  <elements xsi:type="CPL:SubAction" id="sa3">
    <contents xsi:type="CPL:PrioritySwitch">
      <contents xsi:type="CPL:Location" url="sip:prio.example.net" priority="4" clear="no"/>
    </contents>
  </elements>

</CPL:CPLModel>