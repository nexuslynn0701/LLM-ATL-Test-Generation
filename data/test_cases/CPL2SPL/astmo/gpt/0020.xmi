<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
              xmlns:xmi="http://www.omg.org/XMI"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:CPL="http://cpl/1.0">

  <!-- Root CPL -->
  <elements xsi:type="CPL:CPL">
    <!-- one SubAction -->
    <subActions id="sa1">
      <!-- SubAction contents: simple Proxy -->
      <contents xsi:type="CPL:Proxy" recurse="true" ordering="parallel">
        <!-- simple proxy: all handler refs undefined (no child Busy/NoAnswer/...) -->
      </contents>
    </subActions>

    <!-- one Outgoing using SubCall to sa1 -->
    <outgoing>
      <contents xsi:type="CPL:SubCall" ref="sa1"/>
    </outgoing>

    <!-- one Incoming using Redirect -->
    <incoming>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </incoming>
  </elements>

  <!-- Location used by Proxy and Redirect via locations helper -->
  <elements xsi:type="CPL:Location" url="sip:proxy@example.com" clear="true">
    <!-- no nested contents; acts as a leaf Location -->
  </elements>

</CPL:CPLModel>