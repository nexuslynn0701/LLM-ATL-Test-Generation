<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL with one SubAction, one Outgoing, no Incoming -->
  <elements xsi:type="CPL:CPL">
    <subActions id="saMain">
      <!-- SubAction contents: a simple Proxy -->
      <contents xsi:type="CPL:Proxy" timeout="30" recurse="true" ordering="parallel"/>
    </subActions>
    <outgoing>
      <!-- Outgoing contents: a non‑simple Proxy with all branches filled -->
      <contents xsi:type="CPL:Proxy" timeout="15" recurse="false" ordering="sequential">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default/>
      </contents>
    </outgoing>
  </elements>

  <!-- 1: Location used by Redirect -->
  <elements xsi:type="CPL:Location" url="sip:user1@example.com" priority="1" clear="yes"/>

  <!-- 2: Redirect (permanent=true) using Location 1 via locations helper -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 3: AddressSwitch with one SwitchedAddress, NotPresent and Otherwise -->
  <elements xsi:type="CPL:AddressSwitch" field="origin" subField="user">
    <!-- one SwitchedAddress (will create SelectCase + StringConstant) -->
    <addresses is="sip:alice@example.com" contains="alice" subDomainOf="example.com"/>
    <!-- notPresent and otherwise to exercise corresponding rules -->
    <notPresent/>
    <otherwise/>
  </elements>

  <!-- 4: SwitchedAddress whose contents is a SubCall, to trigger SubCall2Return through R17 -->
  <elements xsi:type="CPL:SwitchedAddress" is="sip:callee@example.org" contains="callee" subDomainOf="example.org">
    <contents xsi:type="CPL:SubCall" ref="saMain"/>
  </elements>

</CPL:CPLModel>