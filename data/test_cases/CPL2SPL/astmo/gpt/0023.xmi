<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- Root CPL with one Incoming, one Outgoing and one SubAction -->
  <elements xsi:type="CPL:CPL">
    <!-- SubAction referencing a complex Proxy (non-simple) -->
    <subActions id="saComplex">
      <contents xsi:type="CPL:Proxy" timeout="15" recurse="yes" ordering="parallel">
        <!-- all branches present => not simple -->
        <busy>
          <!-- Busy points to Redirect -->
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </busy>
        <noAnswer>
          <!-- NoAnswer points to SubCall -->
          <contents xsi:type="CPL:SubCall" ref="saComplex"/>
        </noAnswer>
        <redirection>
          <!-- Redirection points to AddressSwitch -->
          <contents xsi:type="CPL:AddressSwitch" field="origin">
            <!-- notPresent and otherwise empty; addresses filled -->
            <addresses is="addr1"/>
            <addresses is="addr2">
              <!-- SwitchedAddress with contents = Redirect -->
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </addresses>
            <notPresent/>
            <otherwise/>
          </contents>
        </redirection>
        <failure>
          <!-- Failure has no contents -->
        </failure>
        <default>
          <!-- Default points to a simple Proxy via contents reference -->
          <contents xsi:type="CPL:Proxy" timeout="5" recurse="no" ordering="serial">
            <!-- no branches => simple proxy -->
          </contents>
        </default>
      </contents>
    </subActions>

    <!-- Incoming using the same complex Proxy as contents -->
    <incoming>
      <contents xsi:type="CPL:Proxy" timeout="15" recurse="yes" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:SubCall" ref="saComplex"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:AddressSwitch" field="origin">
            <addresses is="addr1"/>
            <addresses is="addr2">
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </addresses>
            <notPresent/>
            <otherwise/>
          </contents>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:Proxy" timeout="5" recurse="no" ordering="serial"/>
        </default>
      </contents>
    </incoming>

    <!-- Outgoing using a simple Proxy as contents -->
    <outgoing>
      <contents xsi:type="CPL:Proxy" timeout="20" recurse="yes" ordering="parallel">
        <!-- simple proxy: no branches -->
      </contents>
    </outgoing>
  </elements>

  <!-- Location used by all Proxies and Redirects via locations helper (as ancestor) -->
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes"/>

</CPL:CPLModel>