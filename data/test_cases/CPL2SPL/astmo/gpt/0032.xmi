<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- e0: Root CPL with one SubAction, one Incoming, one Outgoing -->
  <elements xsi:type="CPL:CPL">
    <!-- SubAction sa1, contents = simple Proxy pSimple -->
    <subActions xsi:type="CPL:SubAction" id="sa1">
      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="serial">
        <!-- simple proxy: all outcomes undefined -->
      </contents>
    </subActions>

    <!-- Outgoing o1, contents = complex Proxy pComplex1 (with Busy, NoAnswer, Redirection, Failure, Default) -->
    <outgoing xsi:type="CPL:Outgoing">
      <contents xsi:type="CPL:Proxy" timeout="20" recurse="no" ordering="parallel">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default contents="//@elements.3"/>
      </contents>
    </outgoing>

    <!-- Incoming i1, contents = AddressSwitch as1 -->
    <incoming xsi:type="CPL:Incoming">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="user">
        <!-- SwitchedAddress saA1 -> SubCall sc1 -->
        <addresses is="alice@example.com" contains="a" subDomainOf="example.com"
                   contents="//@elements.1"/>
        <!-- SwitchedAddress saA2 -> complex Proxy pComplex2 -->
        <addresses is="bob@example.net" contains="b" subDomainOf="example.net"
                   contents="//@elements.4"/>
        <!-- NotPresent np1 -> Redirect r1 -->
        <notPresent contents="//@elements.2"/>
        <!-- Otherwise ow1 -> Redirect r2 -->
        <otherwise contents="//@elements.5"/>
      </contents>
    </incoming>
  </elements>

  <!-- e1: SubCall sc1 (refers to SubAction sa1) -->
  <elements xsi:type="CPL:SubCall" ref="sa1"/>

  <!-- e2: Redirect r1 (permanent=true) -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- e3: Location loc1, no contents (used as location for complex Proxy in Outgoing) -->
  <elements xsi:type="CPL:Location" url="sip:proxy1@example.com" clear="yes" priority="1"/>

  <!-- e4: complex Proxy pComplex2, with only Busy and Default; location list includes loc2 -->
  <elements xsi:type="CPL:Proxy" timeout="40" recurse="yes" ordering="parallel">
    <busy contents="//@elements.2"/>
    <default contents="//@elements.1"/>
    <!-- location for this proxy -->
    <contents xsi:type="CPL:Location" url="sip:proxy2@example.org" clear="no" priority="2"/>
  </elements>

  <!-- e5: Redirect r2 (permanent=false) -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

</CPL:CPLModel>