<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
              xmlns:xmi="http://www.omg.org/XMI"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:CPL="http://cpl/1.0">

  <!-- Root CPL -->
  <elements xsi:type="CPL:CPL">
    <subActions contents="//@elements.1"/>
    <outgoing contents="//@elements.2"/>
    <incoming contents="//@elements.3"/>
  </elements>

  <!-- SubAction referenced by SubCall -->
  <elements xsi:type="CPL:SubAction" id="saMain">
    <contents xsi:type="CPL:SubCall" ref="saMain"/>
  </elements>

  <!-- Outgoing with simple Proxy -->
  <elements xsi:type="CPL:Outgoing">
    <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
      <!-- simple proxy: no busy/noAnswer/redirection/failure/default -->
    </contents>
  </elements>

  <!-- Incoming with AddressSwitch -->
  <elements xsi:type="CPL:Incoming">
    <contents xsi:type="CPL:AddressSwitch" field="origin">
      <notPresent>
        <contents xsi:type="CPL:SubCall" ref="saMain"/>
      </notPresent>
      <otherwise>
        <contents xsi:type="CPL:Redirect" permanent="true"/>
      </otherwise>
      <addresses is="user@example.com"/>
      <addresses is="other@example.org"/>
    </contents>
  </elements>

</CPL:CPLModel>