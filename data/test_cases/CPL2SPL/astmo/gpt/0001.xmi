<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:CPL="http://cpl/1.0">

  <!-- Root CPL with one SubAction, one Incoming and one Outgoing -->
  <elements xsi:type="CPL:CPL">
    <subActions id="sa1">
      <!-- SubAction contents: complex Proxy (not simple) -->
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- All branches present so Proxy is notSimple -->
        <busy>
          <!-- Busy contents: SubCall -->
          <contents xsi:type="CPL:SubCall" ref="sa1"/>
        </busy>
        <noAnswer/>
        <redirection>
          <!-- Redirection contents: simple Proxy -->
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
            <!-- Simple Proxy: no busy/noAnswer/redirection/failure/default -->
          </contents>
        </redirection>
        <failure/>
        <default>
          <!-- Default contents: AddressSwitch -->
          <contents xsi:type="CPL:AddressSwitch" field="origin">
            <!-- AddressSwitch contents: SwitchedAddress, NotPresent and Otherwise -->
            <addresses is="user@example.com"/>
            <notPresent/>
            <otherwise>
              <!-- Otherwise contents: Redirect (permanent) -->
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </otherwise>
          </contents>
        </default>
      </contents>
    </subActions>
    <!-- Incoming method, contents: Reject (to be ignored in statements) -->
    <incoming>
      <contents xsi:type="CPL:Reject" status="486" reason="Busy"/>
    </incoming>
    <!-- Outgoing method, contents: Location (to be ignored in statements but used as URI for Proxies/Redirects) -->
    <outgoing>
      <contents xsi:type="CPL:Location" url="sip:callee@example.com" clear="yes"/>
    </outgoing>
  </elements>

</CPL:CPLModel>