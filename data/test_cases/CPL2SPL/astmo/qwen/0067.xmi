<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction"/>
    <subActions id="fallbackAction"/>
    <outgoing>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="30">
        <busy>
          <contents xsi:type="CPL:SubCall" ref="fallbackAction"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Reject" status="408" reason="No answer"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:AddressSwitch" field="destination">
            <addresses is="user@example.com"/>
            <otherwise>
              <contents xsi:type="CPL:SubCall" ref="mainAction"/>
            </otherwise>
          </contents>
        </default>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="user-agent">
        <strings is="mobile"/>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:primary@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
</CPL:CPLModel>