<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" incoming="//@elements.5" outgoing="//@elements.6">
    <subActions id="mainAction"/>
    <subActions id="helperAction"/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="helperAction"/>
  <elements xsi:type="CPL:Location" url="sip:user@example.com" clear="true"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="30">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default contents="//@elements.1"/>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="sip:alice@example.com"/>
    <addresses contains="example.org"/>
    <notPresent/>
    <otherwise contents="//@elements.3"/>
  </elements>
  <elements xsi:type="CPL:Incoming"/>
  <elements xsi:type="CPL:Outgoing"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
</CPL:CPLModel>