<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmi:id="cpl1">
    <subActions id="action1" contents="//@elements.4"/>
    <subActions id="action2" contents="//@elements.5"/>
    <outgoing contents="//@elements.6"/>
    <incoming contents="//@elements.7"/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
  <elements xsi:type="CPL:Location" url="sip:user1@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:user2@example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default contents="//@elements.1"/>
  </elements>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="sip:alice@example.com" contents="//@elements.2"/>
    <notPresent/>
    <otherwise contents="//@elements.3"/>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="user-agent">
    <strings is="AcmeClient/1.0"/>
  </elements>
</CPL:CPLModel>