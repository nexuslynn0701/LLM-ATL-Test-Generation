<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction"/>
    <subActions id="helperAction"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="destination">
        <addresses is="user@example.com"/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="serial">
            <busy>
              <contents xsi:type="CPL:SubCall" ref="helperAction"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Reject" status="408" reason="No Answer"/>
            </noAnswer>
            <redirection/>
            <failure/>
            <default>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="user-agent">
        <strings is="SIP-client/1.0"/>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="medium" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:primary@example.com" priority="high" clear="no"/>
</CPL:CPLModel>