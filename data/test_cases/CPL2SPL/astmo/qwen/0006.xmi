<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <CPL:CPLModel>
    <elements xsi:type="CPL:CPL">
      <subActions id="mainAction"/>
      <subActions id="helperAction"/>
      <outgoing>
        <contents xsi:type="CPL:AddressSwitch" field="destination">
          <addresses is="user@example.com"/>
          <otherwise>
            <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
              <busy/>
              <noAnswer/>
              <redirection/>
              <failure/>
              <default contents="//@elements.1"/>
            </contents>
          </otherwise>
        </contents>
      </outgoing>
      <incoming>
        <contents xsi:type="CPL:StringSwitch" field="subject">
          <strings is="urgent"/>
        </contents>
      </incoming>
    </elements>
    <elements xsi:type="CPL:SubCall" ref="helperAction"/>
    <elements xsi:type="CPL:Location" url="sip:backup@example.com" clear="true"/>
    <elements xsi:type="CPL:Redirect" permanent="true"/>
    <elements xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
  </CPL:CPLModel>
</xmi:XMI>