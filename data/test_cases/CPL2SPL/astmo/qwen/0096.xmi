<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmi:id="cpl1">
    <subActions id="action1" xmi:id="sub1">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="30" xmi:id="proxy1">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default contents="//@elements.4"/>
      </contents>
    </subActions>
    <subActions id="action2" xmi:id="sub2">
      <contents xsi:type="CPL:SubCall" ref="action1" xmi:id="subcall1"/>
    </subActions>
    <outgoing xmi:id="out1">
      <contents xsi:type="CPL:AddressSwitch" field="destination" xmi:id="addrSwitch1">
        <addresses is="user@example.com" xmi:id="addr1"/>
        <notPresent/>
        <otherwise contents="//@elements.5"/>
      </contents>
    </outgoing>
    <incoming xmi:id="in1">
      <contents xsi:type="CPL:Redirect" permanent="true" xmi:id="redirect1"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="true" xmi:id="loc1"/>
  <elements xsi:type="CPL:Reject" status="403" reason="Forbidden" xmi:id="reject1"/>
</CPL:CPLModel>