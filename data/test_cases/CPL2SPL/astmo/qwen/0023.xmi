<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <subActions id="mainAction"/>
    <outgoing>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:SubCall" ref="fallback"/>
        </busy>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </default>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="user@example.com"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ref="mainAction"/>
  <elements xsi:type="CPL:Location" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" url="sip:backup@example.com" clear="true"/>
  <elements xsi:type="CPL:SubAction" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="fallback">
    <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
      <default>
        <contents xsi:type="CPL:Redirect" permanent="false"/>
      </default>
    </contents>
  </elements>
</CPL:CPLModel>