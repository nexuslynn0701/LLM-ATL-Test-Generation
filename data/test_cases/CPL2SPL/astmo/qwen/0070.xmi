<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <subActions id="action1"/>
    <subActions id="action2"/>
    <outgoing>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:SubCall" ref="action1"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Reject" status="408" reason="No answer"/>
        </noAnswer>
        <redirection/>
        <failure/>
        <default>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </default>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="user@example.com">
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="serial">
            <default>
              <contents xsi:type="CPL:SubCall" ref="action2"/>
            </default>
          </contents>
        </addresses>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="404" reason="Not found"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" clear="true"/>
  <elements xsi:type="CPL:Location" url="sip:main@example.com" clear="false"/>
</CPL:CPLModel>