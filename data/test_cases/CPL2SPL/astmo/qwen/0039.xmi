<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <subActions id="mainAction"/>
    <subActions id="helperAction"/>
    <outgoing>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:SubCall" ref="helperAction"/>
        </busy>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default>
          <contents xsi:type="CPL:Redirect" permanent="true">
            <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="normal" clear="yes"/>
          </contents>
        </default>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:user@example.com">
          <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="serial">
            <default>
              <contents xsi:type="CPL:SubCall" ref="mainAction"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:busy@example.com" priority="high" clear="no"/>
  <elements xsi:type="CPL:Location" url="sip:noanswer@example.com" priority="low" clear="yes"/>
</CPL:CPLModel>