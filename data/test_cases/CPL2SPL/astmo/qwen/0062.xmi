<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmi:id="cpl_root">
    <subActions id="action1" contents="//@elements.5"/>
    <subActions id="action2" contents="//@elements.6"/>
    <outgoing contents="//@elements.7"/>
    <incoming contents="//@elements.8"/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
  <elements xsi:type="CPL:Location" url="sip:user1@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:user2@example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="true" locations="//@elements.2"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="30" locations="//@elements.3">
    <busy contents="//@elements.1"/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default contents="//@elements.4"/>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="sip:alice@example.com" contents="//@elements.0"/>
    <notPresent/>
    <otherwise contents="//@elements.5"/>
  </elements>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="serial" locations="//@elements.2"/>
  <elements xsi:type="CPL:StringSwitch" field="user-agent">
    <strings is="Cisco-IPPhone"/>
  </elements>
</CPL:CPLModel>