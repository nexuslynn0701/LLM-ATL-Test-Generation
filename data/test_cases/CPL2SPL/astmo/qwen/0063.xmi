<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <subActions id="mainAction"/>
    <outgoing>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="30">
        <busy>
          <contents xsi:type="CPL:SubCall" ref="fallback"/>
        </busy>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default>
          <contents xsi:type="CPL:AddressSwitch" field="origin">
            <addresses is="sip:user@example.com"/>
            <otherwise>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </otherwise>
          </contents>
        </default>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="user">
        <strings is="admin"/>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ref="mainAction"/>
  <elements xsi:type="CPL:Location" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" url="sip:backup@example.com" priority="normal" clear="yes"/>
  <elements xsi:type="CPL:SubAction" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="fallback">
    <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
  </elements>
</CPL:CPLModel>