<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmi:id="cpl_root">
    <subActions id="mainAction"/>
    <outgoing/>
    <incoming/>
  </elements>
  <elements xsi:type="CPL:SubAction" xmi:id="subAction1" id="mainAction">
    <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
      <busy>
        <contents xsi:type="CPL:SubCall" ref="helperAction"/>
      </busy>
      <noAnswer/>
      <redirection/>
      <failure/>
      <default>
        <contents xsi:type="CPL:AddressSwitch" field="origin">
          <addresses is="user@example.com"/>
          <otherwise>
            <contents xsi:type="CPL:Redirect" permanent="true"/>
          </otherwise>
        </contents>
      </default>
    </contents>
  </elements>
  <elements xsi:type="CPL:SubAction" xmi:id="subAction2" id="helperAction">
    <contents xsi:type="CPL:Reject" status="486" reason="Busy"/>
  </elements>
  <elements xsi:type="CPL:Location" xmi:id="loc1" url="sip:user@example.com" priority="1" clear="yes"/>
</CPL:CPLModel>