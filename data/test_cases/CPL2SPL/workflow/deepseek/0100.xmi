<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <outgoing>
      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default contents="//@elements.2"/>
      </contents>
    </outgoing>
    <incoming/>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="sip:alice@example.com" contains="alice" subDomainOf="example.com"/>
    <notPresent/>
    <otherwise contents="//@elements.1"/>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="User-Agent">
    <strings is="Cisco" contains="Cisco"/>
    <notPresent/>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <notPresent/>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tzurl.org">
    <times dtstart="20240101T000000" dtend="20241231T235959" duration="P1D" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
    <notPresent/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="1" equal="3"/>
    <notPresent/>
  </elements>
</CPL:CPLModel>