<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <subActions id="sub2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com"/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy/>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default contents="//@elements.2"/>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default contents="//@elements.2"/>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="anyStringValue"/>
  <elements xsi:type="CPL:Location" url="sip:user@host.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <notPresent/>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <notPresent/>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="UTC" tzurl="http://timezone.example.com">
    <times dtstart="20250101T000000" interval="1" wkst="MO"/>
    <notPresent/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="3" equal="4"/>
    <notPresent/>
  </elements>
</CPL:CPLModel>