<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <outgoing>
      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
        <busy/>
        <default contents="//@elements.1"/>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <noAnswer/>
    <default contents="//@elements.2"/>
  </elements>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="192.168.1.1" contains="example" subDomainOf="com"/>
    <notPresent/>
    <otherwise contents="//@elements.3"/>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="User-Agent">
    <strings is="Mozilla" contains="5.0"/>
    <notPresent/>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="UTC" tzurl="http://timezone.example.com">
    <times dtstart="20230101T000000" dtend="20231231T235959" duration="P1D" freq="DAILY" until="20231231T235959" count="365" interval="1" wkst="MO"/>
    <notPresent/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="3" equal="4"/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
</CPL:CPLModel>