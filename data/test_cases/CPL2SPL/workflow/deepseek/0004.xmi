<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions xsi:type="CPL:SubAction" id="sub1">
      <contents xsi:type="CPL:Location" url="sip:user1@domain.com" clear="yes" priority="1">
        <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel"/>
      </contents>
    </subActions>
    <subActions xsi:type="CPL:SubAction" id="sub2">
      <contents xsi:type="CPL:Location" url="sip:user2@domain.com" clear="yes" priority="2">
        <contents xsi:type="CPL:Redirect" permanent="true"/>
      </contents>
    </subActions>
    <outgoing/>
    <incoming/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="sub1"/>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses xsi:type="CPL:SwitchedAddress" is="sip:user3@domain.com" contains="test" subDomainOf="domain.com">
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </addresses>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="myField"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:SubCall" ref="sub2"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </redirection>
    <default>
      <contents xsi:type="CPL:SubCall" ref="sub2"/>
    </default>
  </elements>
</CPL:CPLModel>