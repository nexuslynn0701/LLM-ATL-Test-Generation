<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions xsi:type="CPL:SubAction" id="act1">
      <contents/>
    </subActions>
    <subActions xsi:type="CPL:SubAction" id="act2">
      <contents/>
    </subActions>
    <incoming xsi:type="CPL:Incoming">
      <contents/>
    </incoming>
    <outgoing xsi:type="CPL:Outgoing">
      <contents/>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="act1"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
    <busy>
      <contents/>
    </busy>
    <noAnswer>
      <contents/>
    </noAnswer>
    <redirection>
      <contents/>
    </redirection>
    <failure/>
    <default>
      <contents/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses xsi:type="CPL:SwitchedAddress" is="user@domain"/>
    <notPresent/>
    <otherwise>
      <contents/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="myfield"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
</CPL:CPLModel>