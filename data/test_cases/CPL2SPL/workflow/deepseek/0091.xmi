<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <subActions id="action2"/>
    <outgoing>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <default>
          <contents xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes"/>
        </default>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SubCall" ref="action1"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubAction" id="action1">
    <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
      <busy/>
      <noAnswer/>
      <redirection/>
      <failure/>
      <default contents="//@elements.3"/>
    </contents>
  </elements>
  <elements xsi:type="CPL:SubAction" id="action2">
    <contents xsi:type="CPL:AddressSwitch" field="origin">
      <addresses is="sip:alice@example.com"/>
      <addresses is="sip:bob@example.com"/>
      <notPresent/>
      <otherwise>
        <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="yes"/>
      </otherwise>
    </contents>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:proxy-target@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:StringSwitch" field="testField">
    <strings is="value1"/>
    <strings is="value2"/>
    <notPresent/>
  </elements>
</CPL:CPLModel>