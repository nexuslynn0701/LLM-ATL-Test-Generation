<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1" contents="//@elements.7"/>
    <subActions id="sub2">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default contents="//@elements.3"/>
      </contents>
    </subActions>
    <incoming contents="//@elements.4"/>
    <outgoing contents="//@elements.5"/>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:user@domain" clear="yes">
    <contents xsi:type="CPL:Redirect" permanent="true"/>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses xsi:type="CPL:SwitchedAddress" is="user@example.com"/>
    <notPresent/>
    <otherwise contents="//@elements.6"/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy"/>
</CPL:CPLModel>