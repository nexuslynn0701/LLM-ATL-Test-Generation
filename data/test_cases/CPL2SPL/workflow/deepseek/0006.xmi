<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default/>
      </contents>
    </subActions>
    <subActions id="sub2">
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential"/>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential"/>
    </outgoing>
    <incoming/>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:user@domain.com" priority="1" clear="yes">
    <contents xsi:type="CPL:Redirect" permanent="true"/>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </otherwise>
    <addresses is="alice@example.com"/>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="someField"/>
</CPL:CPLModel>