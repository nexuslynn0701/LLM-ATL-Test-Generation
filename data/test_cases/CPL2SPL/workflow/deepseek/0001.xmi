<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sa1" contents="//@elements.1"/>
    <incoming contents="//@elements.2"/>
    <outgoing contents="//@elements.3"/>
  </elements>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential" timeout="10">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="myFunction"/>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="sip:alice@example.com"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="someField"/>
</CPL:CPLModel>