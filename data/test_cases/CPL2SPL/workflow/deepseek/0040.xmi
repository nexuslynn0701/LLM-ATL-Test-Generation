<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <outgoing>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default/>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:proxy@example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default/>
  </elements>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="sip:alice@example.com" contains="alice" subDomainOf="example.com"/>
    <addresses is="sip:bob@example.com" contains="bob" subDomainOf="example.com"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="User-Agent">
    <strings is="Cisco" contains="Cisco"/>
    <strings is="Polycom" contains="Polycom"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezones.example.com">
    <times dtstart="20250101T090000" dtend="20250101T170000" duration="PT8H" freq="DAILY" until="20251231T235959" count="365" interval="1" wkst="MO"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="1" equal="3"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
</CPL:CPLModel>