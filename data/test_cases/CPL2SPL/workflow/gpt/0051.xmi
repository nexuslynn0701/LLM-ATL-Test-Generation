<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0"
              xmlns:xmi="http://www.omg.org/XMI"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL -->
  <elements xsi:type="CPL:CPL">
    <!-- One SubAction -->
    <subActions id="sa1">
      <!-- contents is a Proxy (simple) -->
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- simple proxy: no busy/noAnswer/redirection/failure/default -->
      </contents>
    </subActions>

    <!-- One Outgoing whose contents is the same simple Proxy -->
    <outgoing>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- simple proxy -->
      </contents>
    </outgoing>

    <!-- One Incoming whose contents is the same simple Proxy -->
    <incoming>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- simple proxy -->
      </contents>
    </incoming>
  </elements>

  <!-- 1: Location used by the complex Proxy and Redirect (for Location2URIConstant) -->
  <elements xsi:type="CPL:Location" url="sip:user@example.com" clear="true" priority="1"/>

  <!-- 2: SwitchedAddress inside AddressSwitch.selectCases -->
  <elements xsi:type="CPL:SwitchedAddress" is="addr1">
    <!-- contents is a SubCall -->
    <contents xsi:type="CPL:SubCall" ref="sa1"/>
  </elements>

  <!-- 3: Default-handling Proxy (non-simple) used from Default and Busy -->
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default/>
  </elements>

  <!-- 4: Redirect that uses Location #1 (triggers Location2URIConstant through Redirect2Return) -->
  <elements xsi:type="CPL:Redirect" permanent="true">
    <contents xsi:type="CPL:Location" url="sip:redir@example.com" clear="true" priority="2"/>
  </elements>

  <!-- 5: AddressSwitch with one SwitchedAddress, NotPresent and Otherwise;
           contents of Otherwise is SubCall to sa1 -->
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses>
      <!-- reference SwitchedAddress at index 2 -->
      <contents xsi:type="CPL:SwitchedAddress" is="addr1">
        <contents xsi:type="CPL:SubCall" ref="sa1"/>
      </contents>
    </addresses>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="sa1"/>
    </otherwise>
  </elements>

  <!-- 6: StringSwitch (just to use the rule, with no statements) -->
  <elements xsi:type="CPL:StringSwitch">
    <strings is="hdrField" contains="value">
      <contents xsi:type="CPL:Reject" status="400" reason="Bad string"/>
    </strings>
  </elements>

  <!-- 7: LanguageSwitch with NotPresent (for NotPresent2ErrorResponse) -->
  <elements xsi:type="CPL:LanguageSwitch">
    <notPresent/>
  </elements>

  <!-- 8: TimeSwitch with minimal required attributes, used as contents in Busy/NoAnswer/Redirection -->
  <elements xsi:type="CPL:TimeSwitch" dtstart="20250101T000000Z" interval="1" wkst="MO"/>

  <!-- 9: PrioritySwitch, unused as contents but present as allowed top-level -->
  <elements xsi:type="CPL:PrioritySwitch"/>

  <!-- 10: Complex Proxy (non-simple) that uses Location #1 and all outcomes;
            Busy uses SubCall to sa1; NoAnswer uses TimeSwitch #8;
            Redirection uses SubCall; Failure uses Reject; Default uses complex Proxy #3 -->
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <!-- Busy: contents SubCall -->
    <busy>
      <contents xsi:type="CPL:SubCall" ref="sa1"/>
    </busy>
    <!-- NoAnswer: contents TimeSwitch -->
    <noAnswer>
      <contents xsi:type="CPL:TimeSwitch" dtstart="20250101T000000Z" interval="1" wkst="MO"/>
    </noAnswer>
    <!-- Redirection: contents SubCall -->
    <redirection>
      <contents xsi:type="CPL:SubCall" ref="sa1"/>
    </redirection>
    <!-- Failure: contents Reject -->
    <failure>
      <contents xsi:type="CPL:Reject" status="405" reason="Method Not Allowed"/>
    </failure>
    <!-- Default: contents Proxy #3 -->
    <default contents="//@elements.3"/>
    <!-- Location used for Proxy2Select (select + forward) -->
    <contents xsi:type="CPL:Location" url="sip:proxy@example.com" clear="true" priority="3"/>
  </elements>

  <!-- 11: SubCall that references sa1 (for SubCall2Return) -->
  <elements xsi:type="CPL:SubCall" ref="sa1"/>

</CPL:CPLModel>