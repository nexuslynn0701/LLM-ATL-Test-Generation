<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0"
              xmlns:xmi="http://www.omg.org/XMI"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:CPL="http://cpl/1.0">
  <!-- Root CPL with one SubAction and one Outgoing -->
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <!-- SubAction contents: simple Proxy using a Location (triggers Proxy2Return and Location2URIConstant) -->
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- simple proxy: no busy/noAnswer/redirection/failure/default -->
      </contents>
    </subActions>
    <!-- Outgoing referencing the same simple Proxy -->
    <outgoing>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- simple proxy -->
      </contents>
    </outgoing>
  </elements>

  <!-- Location used as location of the simple Proxy (for Location2URIConstant) -->
  <elements xsi:type="CPL:Location" url="sip:example@provider.com" clear="true" priority="1.0"/>

</CPL:CPLModel>