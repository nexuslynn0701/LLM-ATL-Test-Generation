<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- elements[0]: main CPL with subActions, incoming, outgoing -->
  <elements xsi:type="CPL:CPL">
    <!-- SubActions -->
    <subActions id="sa_main">
      <!-- contents: complex Proxy inside SubAction -->
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- all branches present so Proxy is non-simple -->
        <busy>
          <!-- Busy contents: SubCall, will trigger SubCall2Return -->
          <contents xsi:type="CPL:SubCall" ref="sa_main"/>
        </busy>
        <noAnswer/>
        <redirection/>
        <failure/>
        <!-- default references Redirect in elements[6] -->
        <default contents="//@elements.6"/>
      </contents>
    </subActions>

    <!-- Outgoing (to trigger Outgoing2Method, with simple Proxy using Location) -->
    <outgoing>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
        <!-- simple Proxy: no branches; its location from elements[1] -->
      </contents>
    </outgoing>

    <!-- Incoming (to trigger Incoming2Method, with AddressSwitch) -->
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="fromField">
        <!-- SwitchedAddress child -->
        <addresses is="addr_case_1" contains="c1" subDomainOf="sd1">
          <!-- contents: SubCall to sa_main -->
          <contents xsi:type="CPL:SubCall" ref="sa_main"/>
        </addresses>
        <!-- NotPresent and Otherwise children -->
        <notPresent/>
        <otherwise>
          <!-- contents: simple Proxy (uses Location) -->
          <contents xsi:type="CPL:Proxy" recurse="once" ordering="sequential">
            <!-- no branches => simple proxy -->
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>

  <!-- elements[1]: Location used as location for proxies (triggers Location2URIConstant) -->
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes">
    <!-- contents: SubCall with plain string ref -->
    <contents xsi:type="CPL:SubCall" ref="sa_main"/>
  </elements>

  <!-- elements[2]: StringSwitch (top-level, independent of rules but allowed) -->
  <elements xsi:type="CPL:StringSwitch" field="headerField">
    <!-- no nested strings; this still triggers StringSwitch2SelectStat -->
  </elements>

  <!-- elements[3]: LanguageSwitch with NotPresent (to reuse ErrorResponse rules) -->
  <elements xsi:type="CPL:LanguageSwitch">
    <notPresent/>
  </elements>

  <!-- elements[4]: TimeSwitch (unused as contents, but allowed top-level) -->
  <elements xsi:type="CPL:TimeSwitch" tzid="tz1" tzurl="http://tz">
    <!-- minimal attributes for SwitchedTime if needed later; left empty -->
  </elements>

  <!-- elements[5]: PrioritySwitch (unused, top-level) -->
  <elements xsi:type="CPL:PrioritySwitch"/>

  <!-- elements[6]: Redirect used as Default.contents in complex Proxy -->
  <elements xsi:type="CPL:Redirect" permanent="true">
    <!-- no nested contents; its location will still come from Location via Proxy's locations helper -->
  </elements>

</CPL:CPLModel>