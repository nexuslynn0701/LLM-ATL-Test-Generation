<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0"
              xmlns:xmi="http://www.omg.org/XMI"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:CPL="http://cpl/1.0">

  <!-- Top-level CPL root -->
  <elements xsi:type="CPL:CPL">
    <!-- One SubAction with id 'sa1' -->
    <subActions id="sa1">
      <!-- Contents is the simple Proxy at elements[2] -->
      <contents xsi:nil="true"/>
    </subActions>

    <!-- One Outgoing whose contents is a complex Proxy at elements[3] -->
    <outgoing>
      <contents xsi:nil="true"/>
    </outgoing>

    <!-- One Incoming whose contents is the simple Proxy at elements[2] -->
    <incoming>
      <contents xsi:nil="true"/>
    </incoming>
  </elements>

  <!-- Top-level Location providing URI for Proxies and Redirect -->
  <elements xsi:type="CPL:Location" url="sip:example@domain.com" clear="yes">
    <!-- No contents: acts purely as a location node -->
  </elements>

  <!-- Simple Proxy triggering Proxy2Return and Location2URIConstant -->
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <!-- No busy/noAnswer/redirection/failure/default => isSimple = true -->
  </elements>

  <!-- Complex Proxy triggering Proxy2Select and using all handlers -->
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default/>
  </elements>

  <!-- Top-level Redirect using same Location for URI -->
  <elements xsi:type="CPL:Redirect" permanent="true">
    <!-- No explicit contents; only uses locations helper -->
  </elements>

  <!-- Top-level SubCall referring to SubAction 'sa1' -->
  <elements xsi:type="CPL:SubCall" ref="sa1"/>
</CPL:CPLModel>