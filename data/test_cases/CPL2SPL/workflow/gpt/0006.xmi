<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL with one SubAction and one Outgoing -->
  <elements xsi:type="CPL:CPL">
    <!-- SubAction SA1 with id "sa1" -->
    <subActions id="sa1">
      <!-- contents: Proxy P1 (simple) -->
      <contents xsi:type="CPL:Proxy" recurse="r1" ordering="parallel">
        <!-- simple proxy: no busy/noAnswer/redirection/failure/default -->
      </contents>
    </subActions>
    <!-- Outgoing O1 with contents = same simple Proxy P1 via XMI path -->
    <outgoing>
      <contents xsi:type="CPL:Proxy" recurse="r1" ordering="parallel">
        <!-- this proxy shares the same structure; locations resolved via Location L0 -->
      </contents>
    </outgoing>
  </elements>

  <!-- 1: Location L0 used by Proxy P1 to trigger Location2URIConstant -->
  <elements xsi:type="CPL:Location" url="sip:user@example.com" clear="yes" priority="1"/>

  <!-- 2: Redirect R1 (permanent=false) to also use Location2URIConstant via its locations -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

</CPL:CPLModel>