<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:CPL="http://cpl/1.0">

  <!-- Root CPL with one SubAction and one Outgoing using a Location -->
  <elements xsi:type="CPL:CPL">
    <subActions id="sa1">
      <!-- SubAction contents is a simple Proxy using a Location -->
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- simple proxy: no busy/noAnswer/redirection/failure/default -->
      </contents>
    </subActions>
    <outgoing>
      <!-- Outgoing contents is a simple Proxy using the same Location -->
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- simple proxy -->
      </contents>
    </outgoing>
  </elements>

  <!-- Location used by the simple proxies to trigger Location2URIConstant -->
  <elements xsi:type="CPL:Location" url="sip:user@example.com" clear="true"/>

  <!-- Redirect (permanent=false) also using the Location -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

  <!-- Top-level SubCall that refers to SubAction id "sa1" -->
  <elements xsi:type="CPL:SubCall" ref="sa1"/>

</CPL:CPLModel>