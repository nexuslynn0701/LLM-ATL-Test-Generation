<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0"
              xmlns:xmi="http://www.omg.org/XMI"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:CPL="http://cpl/1.0">

  <!-- elements[0]: CPL root with one SubAction, one Incoming, one Outgoing -->
  <elements xsi:type="CPL:CPL">
    <subActions>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- complex proxy (non-simple) with all branches, using Location so Location2URIConstant is triggered -->
        <busy>
          <contents xsi:type="CPL:SubCall" ref="sa1"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:SubCall" ref="sa1"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:SubCall" ref="sa1"/>
        </default>
      </contents>
    </subActions>
    <incoming>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="serial">
        <!-- simple proxy (no branches) with Location to trigger Location2URIConstant again -->
        <contents xsi:type="CPL:Location" url="sip:incoming@example.com" clear="yes"/>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- simple proxy (no branches) with Location to trigger Location2URIConstant -->
        <contents xsi:type="CPL:Location" url="sip:outgoing@example.com" clear="yes"/>
      </contents>
    </outgoing>
  </elements>

  <!-- elements[1]: Location contributing to locations of subsequent elements -->
  <elements xsi:type="CPL:Location" url="sip:global@example.com" clear="yes"/>

  <!-- elements[2]: SubCall pointing to SubAction id -->
  <elements xsi:type="CPL:SubCall" ref="sa1"/>

  <!-- elements[3]: Redirect using locations (Location2URIConstant via Redirect2Return) -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

  <!-- elements[4]: Proxy (simple) whose default contents references elements[2] (SubCall) -->
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <default contents="//@elements.2"/>
  </elements>

  <!-- elements[5]: Proxy (complex) with busy, noAnswer, redirection; default references elements[3] (Redirect) -->
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="serial">
    <busy/>
    <noAnswer/>
    <redirection/>
    <default contents="//@elements.3"/>
  </elements>

  <!-- elements[6]: AddressSwitch with SwitchedAddress, NotPresent, Otherwise -->
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="addr1"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- simple proxy under otherwise, again using Location -->
        <contents xsi:type="CPL:Location" url="sip:otherwise@example.com" clear="yes"/>
      </contents>
    </otherwise>
  </elements>

  <!-- elements[7]: StringSwitch (to exercise StringSwitch2SelectStat) -->
  <elements xsi:type="CPL:StringSwitch" field="hdrField">
    <strings is="val1"/>
  </elements>

</CPL:CPLModel>