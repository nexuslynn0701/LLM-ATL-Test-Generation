<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- elements[0]: CPL root with one SubAction and one Outgoing -->
  <elements xsi:type="CPL:CPL">
    <subActions id="sa1">
      <!-- SubAction contents: complex Proxy (non-simple) using Location -->
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- all branches present so proxy is non-simple -->
        <busy>
          <!-- Busy contents: SubCall -->
          <contents xsi:type="CPL:SubCall" ref="sa1"/>
        </busy>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default contents="//@elements.2"/>
      </contents>
    </subActions>
    <outgoing>
      <!-- Outgoing contents: simple Proxy using same Location -->
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
        <!-- no branches => simple proxy -->
      </contents>
    </outgoing>
  </elements>

  <!-- elements[1]: Location used by both proxies (for Location2URIConstant) -->
  <elements xsi:type="CPL:Location" url="sip:user@example.com" clear="true"/>

  <!-- elements[2]: SubCall used from Busy.default and referring to sa1 (string ref, not object) -->
  <elements xsi:type="CPL:SubCall" ref="sa1"/>

  <!-- elements[3]: Redirect, also using the Location -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

</CPL:CPLModel>