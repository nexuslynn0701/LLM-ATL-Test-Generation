<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0"
              xmlns:xmi="http://www.omg.org/XMI"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:CPL="http://cpl/1.0">

  <!-- elements[0]: root CPL with one SubAction and one Outgoing -->
  <elements xsi:type="CPL:CPL">
    <subActions id="sa1">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- simple proxy inside SubAction; no handlers -->
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="serial">
        <!-- non-simple proxy inside Outgoing using Location (to trigger Location2URIConstant) -->
        <busy>
          <contents xsi:type="CPL:Location" url="sip:busy@example.com" clear="true"/>
        </busy>
      </contents>
    </outgoing>
  </elements>

  <!-- elements[1]: Location used by Redirect (also triggers Location2URIConstant) -->
  <elements xsi:type="CPL:Location" url="sip:redirect@example.com" clear="true"/>

  <!-- elements[2]: Redirect using the external Location via locations helper -->
  <elements xsi:type="CPL:Redirect" permanent="true">
    <contents xsi:type="CPL:SubCall" ref="sa1"/>
  </elements>

</CPL:CPLModel>