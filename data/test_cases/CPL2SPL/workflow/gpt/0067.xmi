<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0"
              xmlns:xmi="http://www.omg.org/XMI"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:CPL="http://cpl/1.0">
  <!-- Root CPL -->
  <elements xsi:type="CPL:CPL">
    <!-- One SubAction inside CPL -->
    <subActions id="sa1">
      <!-- SubAction contents: a simple Proxy (will create statements in LocalFunctionDeclaration) -->
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- simple Proxy: all outcome branches undefined -->
      </contents>
    </subActions>
    <!-- One Outgoing inside CPL whose contents is the same simple Proxy -->
    <outgoing>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- simple Proxy again -->
      </contents>
    </outgoing>
  </elements>

  <!-- Location used by the simple Proxy (to trigger Location2URIConstant) -->
  <elements xsi:type="CPL:Location" url="sip:user@example.com" clear="true"/>

</CPL:CPLModel>