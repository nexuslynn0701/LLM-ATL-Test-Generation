<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0"
              xmlns:xmi="http://www.omg.org/XMI"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:CPL="http://cpl/1.0">

  <!-- Root CPL with one subAction, one incoming, one outgoing -->
  <elements xsi:type="CPL:CPL">
    <!-- SubAction whose contents is a simple Proxy using a Location -->
    <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
      <!-- simple proxy: no busy/noAnswer/redirection/failure/default -->
    </contents>

    <!-- Incoming whose contents is a simple Proxy using same Location -->
    <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
      <!-- simple proxy -->
    </contents>

    <!-- Outgoing whose contents is a complex Proxy:
         busy, noAnswer, redirection, failure, default -->
    <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
      <busy/>
      <noAnswer/>
      <redirection/>
      <failure/>
      <!-- default uses SubCall (index 2) as contents -->
      <default contents="//@elements.2"/>
    </contents>
  </elements>

  <!-- SubCall referring to SubAction sa1 (by id string) -->
  <elements xsi:type="CPL:SubCall" ref="sa1"/>

  <!-- Location used as first location for all proxies:
       triggers Location2URIConstant via helpers -->
  <elements xsi:type="CPL:Location" url="sip:example@domain.com" clear="true"/>

  <!-- Redirect, with permanent=false, also using the Location -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

  <!-- AddressSwitch with one SwitchedAddress, NotPresent and Otherwise,
       all delegating to the same simple Proxy (index 6) -->
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="addr1">
      <contents contents="//@elements.6"/>
    </addresses>
    <notPresent>
      <contents contents="//@elements.6"/>
    </notPresent>
    <otherwise>
      <contents contents="//@elements.6"/>
    </otherwise>
  </elements>

  <!-- Simple Proxy whose first location is the Location (index 3) -->
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel"/>

  <!-- Complex Proxy with explicit busy / noAnswer / redirection / failure / default
       whose contents is the simple Proxy above (index 6) -->
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="serial">
    <busy>
      <contents contents="//@elements.6"/>
    </busy>
    <noAnswer>
      <contents contents="//@elements.6"/>
    </noAnswer>
    <redirection>
      <contents contents="//@elements.6"/>
    </redirection>
    <failure>
      <contents contents="//@elements.6"/>
    </failure>
    <default>
      <contents contents="//@elements.6"/>
    </default>
  </elements>

</CPL:CPLModel>