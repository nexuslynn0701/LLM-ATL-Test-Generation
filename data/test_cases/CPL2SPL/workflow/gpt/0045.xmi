<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- elements.0: main CPL root with subActions, incoming, outgoing -->
  <elements xsi:type="CPL:CPL">
    <!-- one SubAction referencing a Proxy (elements.3) as its contents -->
    <subActions id="sa1">
      <contents xsi:type="CPL:Proxy" timeout="t1" recurse="rec1" ordering="parallel">
        <!-- complex (non-simple) Proxy: all outcome branches present -->
        <busy>
          <!-- busy.contents is a SubCall -->
          <contents xsi:type="CPL:SubCall" ref="sa1"/>
        </busy>
        <noAnswer>
          <!-- noAnswer.contents is a Redirect -->
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </noAnswer>
        <redirection>
          <!-- redirection.contents is a SubCall -->
          <contents xsi:type="CPL:SubCall" ref="sa1"/>
        </redirection>
        <failure>
          <!-- failure.contents is a SubCall -->
          <contents xsi:type="CPL:SubCall" ref="sa1"/>
        </failure>
        <default>
          <!-- default.contents is a SubCall -->
          <contents xsi:type="CPL:SubCall" ref="sa1"/>
        </default>
      </contents>
    </subActions>

    <!-- Incoming whose contents is a simple Proxy (uses Location elements.1) -->
    <incoming>
      <contents xsi:type="CPL:Proxy" timeout="t2" recurse="rec2" ordering="parallel">
        <!-- simple Proxy: no outcome branches -->
        <!-- locations helper will find Location elements.1 -->
      </contents>
    </incoming>

    <!-- Outgoing whose contents is a complex Proxy (inline) -->
    <outgoing>
      <contents xsi:type="CPL:Proxy" timeout="t3" recurse="rec3" ordering="sequential">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default/>
      </contents>
    </outgoing>
  </elements>

  <!-- elements.1: top-level Location used by the simple Proxy (incoming.contents) -->
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="true">
    <!-- no contents, acts purely as a location -->
  </elements>

  <!-- elements.2: AddressSwitch with one SwitchedAddress, NotPresent, Otherwise -->
  <elements xsi:type="CPL:AddressSwitch" field="origin" subField="subF">
    <addresses is="addr1" contains="cont1" subDomainOf="subD">
      <!-- SwitchedAddress contents is a SubCall -->
      <contents xsi:type="CPL:SubCall" ref="sa1"/>
    </addresses>
    <notPresent>
      <!-- NotPresent.contents is a SubCall -->
      <contents xsi:type="CPL:SubCall" ref="sa1"/>
    </notPresent>
    <otherwise>
      <!-- Otherwise.contents is a Redirect -->
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </otherwise>
  </elements>

  <!-- elements.3: top-level Proxy used as SubAction contents (via path in elements.0) -->
  <elements xsi:type="CPL:Proxy" timeout="t4" recurse="rec4" ordering="parallel">
    <!-- complex Proxy: only some branches present -->
    <busy>
      <!-- busy.contents is a SubCall -->
      <contents xsi:type="CPL:SubCall" ref="sa1"/>
    </busy>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default/>
  </elements>

  <!-- elements.4: simple Proxy whose default.contents points to AddressSwitch (elements.2) -->
  <elements xsi:type="CPL:Proxy" timeout="t5" recurse="rec5" ordering="sequential">
    <!-- simple Proxy: no outcome children except default -->
    <default contents="//@elements.2"/>
  </elements>

  <!-- elements.5: Redirect used independently (no locations) -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

  <!-- elements.6: StringSwitch just to trigger its rule -->
  <elements xsi:type="CPL:StringSwitch" field="hdrField">
    <!-- no contents required -->
  </elements>

  <!-- elements.7: PrioritySwitch present but never used as contents (statements empty) -->
  <elements xsi:type="CPL:PrioritySwitch">
    <!-- no children -->
  </elements>

</CPL:CPLModel>