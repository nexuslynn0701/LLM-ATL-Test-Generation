<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0"
              xmlns:xmi="http://www.omg.org/XMI"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:CPL="http://cpl/1.0">

  <!-- Root CPL with one SubAction, one Incoming and one Outgoing -->
  <elements xsi:type="CPL:CPL">
    <subActions id="sa_main">
      <!-- SubAction contents: simple Proxy using a Location (to trigger Location2URIConstant) -->
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <!-- simple proxy: all branches undefined -->
      </contents>
    </subActions>
    <incoming>
      <!-- Incoming contents: same simple Proxy (by containment) -->
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel"/>
    </incoming>
    <outgoing>
      <!-- Outgoing contents: same simple Proxy (by containment) -->
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel"/>
    </outgoing>
  </elements>

  <!-- Location used by the simple Proxy via locations helper -->
  <elements xsi:type="CPL:Location" url="sip:user@example.com" clear="true">
    <!-- no nested contents -->
  </elements>

</CPL:CPLModel>