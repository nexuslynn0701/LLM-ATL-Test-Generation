<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <subActions id="action2"/>
    <outgoing/>
    <incoming/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
  <elements xsi:type="CPL:SubCall" ref="action2"/>
  <elements xsi:type="CPL:Location" url="sip:user1@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:user2@example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default contents="//@elements.1"/>
  </elements>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="sequential"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="sip:alice@example.com"/>
    <addresses contains="example.com"/>
    <notPresent/>
    <otherwise contents="//@elements.2"/>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="user-agent">
    <strings is="Softphone"/>
    <strings contains="mobile"/>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <notPresent/>
  </elements>
</CPL:CPLModel>