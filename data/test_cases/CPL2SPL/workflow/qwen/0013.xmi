<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction"/>
    <outgoing/>
    <incoming/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="helperFunc"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default contents="//@elements.4"/>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="sip:alice@example.com"/>
    <notPresent/>
    <otherwise contents="//@elements.2"/>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="low" clear="no"/>
</CPL:CPLModel>