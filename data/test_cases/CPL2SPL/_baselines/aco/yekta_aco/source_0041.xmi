<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:SwitchedPriority" contents="//@elements.5" less="chaum" greater="davinci" equal="cray"/>
  <elements xsi:type="CPL:SwitchedString" contents="//@elements.5" is="shtern" contains="lamarr"/>
  <elements xsi:type="CPL:Proxy" timeout="bhabha" recurse="sanderson" ordering="napier">
    <default contents="//@elements.5"/>
  </elements>
  <elements xsi:type="CPL:NoAnswer" contents="//@elements.2"/>
  <elements xsi:type="CPL:Busy" contents="//@elements.5"/>
  <elements xsi:type="CPL:Location" contents="//@elements.2" url="napier" priority="hugle" clear="nightingale"/>
  <elements xsi:type="CPL:SwitchedLanguage" contents="//@elements.5" matches="sinoussi"/>
  <elements xsi:type="CPL:Redirection" contents="//@elements.2"/>
</CPL:CPLModel>
