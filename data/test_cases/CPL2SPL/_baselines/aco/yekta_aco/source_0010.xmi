<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:NoAnswer" contents="//@elements.1"/>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages contents="//@elements.1" matches="ardinghelli"/>
  </elements>
  <elements xsi:type="CPL:CPL">
    <outgoing contents="//@elements.1"/>
    <incoming contents="//@elements.1"/>
  </elements>
  <elements xsi:type="CPL:Redirection" contents="//@elements.1"/>
  <elements xsi:type="CPL:SubAction" contents="//@elements.1" id="thompson"/>
  <elements xsi:type="CPL:Otherwise" contents="//@elements.1"/>
</CPL:CPLModel>
