<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:NotPresent" contents="//@elements.1"/>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages contents="//@elements.5" matches="feistel"/>
  </elements>
  <elements xsi:type="CPL:Proxy" timeout="einstein" recurse="hofstadter" ordering="zhukovsky"/>
  <elements xsi:type="CPL:Outgoing" contents="//@elements.5"/>
  <elements xsi:type="CPL:Default" contents="//@elements.2"/>
  <elements xsi:type="CPL:SubCall" ref="villani"/>
  <elements xsi:type="CPL:Incoming" contents="//@elements.5"/>
  <elements xsi:type="CPL:Redirection" contents="//@elements.2"/>
</CPL:CPLModel>
