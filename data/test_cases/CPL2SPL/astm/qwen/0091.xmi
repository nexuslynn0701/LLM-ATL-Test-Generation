<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="30">
        <busy>
          <contents xsi:type="CPL:Reject" status="486" reason="Busy"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:SubCall" ref="fallbackAction"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:Location" url="sip:default@example.com" clear="true"/>
        </default>
      </contents>
    </subActions>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:user1@example.com">
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
            <default>
              <contents xsi:type="CPL:Location" url="sip:handler1@example.com" clear="false"/>
            </default>
          </contents>
        </addresses>
        <addresses contains="example.org">
          <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
        </addresses>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="Softphone"/>
            <strings contains="Mobile"/>
          </strings>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:TimeSwitch" tzid="UTC">
        <times dtstart="20240101T000000Z" interval="1" wkst="MO"/>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities greater="5"/>
            <otherwise>
              <contents xsi:type="CPL:SubCall" ref="lowPriorityAction"/>
            </otherwise>
          </prioritySwitch>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="fallbackAction"/>
  <elements xsi:type="CPL:Location" url="sip:fallback@example.com" clear="true"/>
  <elements xsi:type="CPL:SubCall" ref="lowPriorityAction"/>
  <elements xsi:type="CPL:SubAction" id="fallbackAction">
    <contents xsi:type="CPL:Redirect" permanent="true"/>
  </elements>
  <elements xsi:type="CPL:SubAction" id="lowPriorityAction">
    <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  </elements>
</CPL:CPLModel>