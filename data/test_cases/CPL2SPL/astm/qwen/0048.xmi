<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <subActions id="mainAction">
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Reject" status="486" reason="User Busy"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:SubCall" ref="fallbackAction"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:Location" url="sip:default@example.com" clear="true"/>
        </default>
      </contents>
    </subActions>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <default>
              <contents xsi:type="CPL:Location" url="sip:alice@work.com" clear="false"/>
            </default>
          </contents>
        </addresses>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="user-agent">
        <strings is="MobileClient"/>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:desktop@example.com" clear="true"/>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubCall" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ref="fallbackAction"/>
  <elements xsi:type="CPL:Location" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" url="sip:fallback@example.net" clear="true"/>
  <elements xsi:type="CPL:Reject" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" status="600" reason="Busy Everywhere"/>
</CPL:CPLModel>