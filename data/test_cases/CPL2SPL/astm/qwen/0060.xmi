<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="30">
        <busy>
          <contents xsi:type="CPL:Reject" status="486" reason="User Busy"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:SubCall" ref="fallbackAction"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:AddressSwitch" field="destination">
            <addresses is="user@example.com">
              <contents xsi:type="CPL:Location" url="sip:primary@example.com" clear="true"/>
            </addresses>
            <notPresent>
              <contents xsi:type="CPL:Reject" status="404" reason="Not Present"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:default@example.com" clear="false"/>
            </otherwise>
          </contents>
        </default>
      </contents>
    </subActions>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="user-agent">
        <strings is="MobileApp">
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential"/>
        </strings>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:TimeSwitch" tzid="UTC">
        <times dtstart="20240101T090000" wkst="MO" interval="1">
          <contents xsi:type="CPL:Location" url="sip:business@example.com" clear="true"/>
        </times>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="true"/>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="fallbackAction"/>
  <elements xsi:type="CPL:Location" url="sip:fallback@example.com" clear="true"/>
  <elements xsi:type="CPL:SubAction" id="fallbackAction">
    <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  </elements>
</CPL:CPLModel>