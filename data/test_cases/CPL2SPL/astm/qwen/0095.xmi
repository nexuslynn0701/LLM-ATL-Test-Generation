<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="user@example.com"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Now"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:SubCall" ref="fallbackAction"/>
            </redirection>
            <failure/>
            <default>
              <contents xsi:type="CPL:StringSwitch" field="subject">
                <strings is="meeting"/>
              </strings>
            </default>
          </contents>
        </otherwise>
      </contents>
    </subActions>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch">
        <times dtstart="20240101T090000" interval="1" wkst="MO"/>
      </times>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities equal="5"/>
      </priorities>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="fallbackAction"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" clear="yes"/>
  <elements xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
</CPL:CPLModel>