<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <subActions id="mainAction">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="30">
        <busy>
          <contents xsi:type="CPL:Reject" status="486" reason="User Busy"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:SubCall" ref="fallbackAction"/>
        </redirection>
        <failure/>
        <default>
          <contents xsi:type="CPL:AddressSwitch" field="destination">
            <addresses is="user@example.com">
              <contents xsi:type="CPL:Location" url="sip:primary@example.com" clear="yes" priority="1"/>
            </addresses>
            <addresses contains="example.org">
              <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="20">
                <default>
                  <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
                </default>
              </contents>
            </addresses>
            <notPresent/>
            <otherwise>
              <contents xsi:type="CPL:StringSwitch" field="user-agent">
                <strings is="mobile"/>
              </strings>
            </otherwise>
          </contents>
        </default>
      </contents>
    </subActions>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="UTC">
        <times dtstart="20240101T090000" interval="1" wkst="MO"/>
      </times>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities greater="5"/>
      </priorities>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubCall" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ref="fallbackAction"/>
  <elements xsi:type="CPL:Location" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" url="sip:fallback@example.com" clear="yes" priority="2"/>
</CPL:CPLModel>