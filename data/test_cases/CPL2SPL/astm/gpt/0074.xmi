<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL -->
  <elements xsi:type="CPL:CPL">
    <!-- Root subActions, incoming, outgoing are contained here by reference from model-level elements -->
  </elements>

  <!-- 1: SubAction 'actSimpleProxy' with simple Proxy contents -->
  <elements xsi:type="CPL:SubAction" id="actSimpleProxy">
    <contents xsi:type="CPL:Proxy" timeout="15" recurse="yes" ordering="parallel">
      <!-- Simple proxy: no busy/noAnswer/redirection/failure/default -->
    </contents>
  </elements>

  <!-- 2: SubAction 'actComplexProxy' with complex Proxy contents -->
  <elements xsi:type="CPL:SubAction" id="actComplexProxy">
    <contents xsi:type="CPL:Proxy" timeout="30" recurse="no" ordering="serial">
      <!-- Complex proxy: has all outcome branches -->
      <busy contents="//@elements.6"/>
      <noAnswer contents="//@elements.7"/>
      <redirection contents="//@elements.8"/>
      <failure/>
      <default contents="//@elements.1"/>
    </contents>
  </elements>

  <!-- 3: Incoming node using a Redirect -->
  <elements xsi:type="CPL:Incoming">
    <contents xsi:type="CPL:Redirect" permanent="false"/>
  </elements>

  <!-- 4: Outgoing node using a SubCall -->
  <elements xsi:type="CPL:Outgoing">
    <contents xsi:type="CPL:SubCall" ref="actSimpleProxy"/>
  </elements>

  <!-- 5: Location top-level (will contribute to locations for following nodes) -->
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes">
    <!-- No contents; acts purely as a location -->
  </elements>

  <!-- 6: Busy branch with SubCall contents (for Proxy2Select / Busy2SelectCase) -->
  <elements xsi:type="CPL:Busy">
    <contents xsi:type="CPL:SubCall" ref="actSimpleProxy"/>
  </elements>

  <!-- 7: NoAnswer branch with simple Proxy contents (nested) -->
  <elements xsi:type="CPL:NoAnswer">
    <contents xsi:type="CPL:Proxy" timeout="10" recurse="yes" ordering="parallel">
      <!-- simple nested proxy -->
    </contents>
  </elements>

  <!-- 8: Redirection branch with Redirect contents -->
  <elements xsi:type="CPL:Redirection">
    <contents xsi:type="CPL:Redirect" permanent="true"/>
  </elements>

  <!-- 9: AddressSwitch with SwitchedAddress cases, NotPresent and Otherwise -->
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="sip:alice@example.com" contains="alice" subDomainOf="example.com" contents="//@elements.1"/>
    <addresses is="sip:bob@example.net" contains="bob" subDomainOf="example.net" contents="//@elements.2"/>
    <notPresent contents="//@elements.11"/>
    <otherwise contents="//@elements.10"/>
  </elements>

  <!-- 10: Otherwise branch with SubCall contents -->
  <elements xsi:type="CPL:Otherwise">
    <contents xsi:type="CPL:SubCall" ref="actComplexProxy"/>
  </elements>

  <!-- 11: Default branch with Reject contents (also used by NotPresent through AddressSwitch) -->
  <elements xsi:type="CPL:Default">
    <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  </elements>

  <!-- 12: StringSwitch to trigger StringSwitch2SelectStat -->
  <elements xsi:type="CPL:StringSwitch" field="callId">
    <!-- no strings; only declaration generation is relevant -->
  </elements>

</CPL:CPLModel>