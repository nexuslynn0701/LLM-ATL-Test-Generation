<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- Root CPL with incoming/outgoing and a subaction -->
  <elements xsi:type="CPL:CPL">
    <subActions id="sa_main">
      <!-- SubAction contents: complex Proxy (not simple) so Proxy2Select (R8) and Location2URIConstant (R19) -->
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
        <!-- Make it complex by defining at least one of these -->
        <busy/>
        <default/>
      </contents>
    </subActions>

    <!-- Incoming method: contents is a simple Proxy so Proxy2Return (R7) used as statement -->
    <incoming>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
        <!-- Simple proxy: no busy/noAnswer/redirection/failure/default -->
      </contents>
    </incoming>

    <!-- Outgoing method: contents is a SubCall so SubCall2Return (R13) used as statement -->
    <outgoing>
      <contents xsi:type="CPL:SubCall" ref="sa_main"/>
    </outgoing>
  </elements>

  <!-- Location used by complex Proxy (via locations helper) and also directly by Redirect -->
  <elements xsi:type="CPL:Location" url="sip:user@example.com" clear="true" priority="1"/>

  <!-- Redirect with permanent="true" so Redirect2Return (R14) with MOVED_PERMANENTLY -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- AddressSwitch exercising SwitchedAddress, NotPresent, Otherwise and Nested Proxy/Redirect -->
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <!-- SwitchedAddress 0: contents is a simple Proxy (Proxy2Return via statement) -->
    <addresses is="sip:alice@example.com" contains="user" subDomainOf="example.com">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel"/>
    </addresses>

    <!-- SwitchedAddress 1: contents is Redirect (filtered out as statement by guards) -->
    <addresses is="sip:bob@example.com" contains="user" subDomainOf="example.net">
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </addresses>

    <!-- SwitchedAddress 2: contents is SubCall to sa_main (SubCall2Return as statement) -->
    <addresses is="sip:carol@example.org" contains="user" subDomainOf="example.org">
      <contents xsi:type="CPL:SubCall" ref="sa_main"/>
    </addresses>

    <!-- NotPresent triggers NotPresent2ErrorResponse (R6), but has contents filtered out -->
    <notPresent>
      <contents xsi:type="CPL:TimeSwitch"/>
    </notPresent>

    <!-- Otherwise default branch, contents is SubCall (SubCall2Return as statement) -->
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="sa_main"/>
    </otherwise>
  </elements>

  <!-- StringSwitch only needs field to trigger StringSwitch2SelectStat (R16) -->
  <elements xsi:type="CPL:StringSwitch">
    <contents xsi:type="CPL:Reject" status="603" reason="Decline"/>
  </elements>

  <!-- LanguageSwitch (used only to be filtered in guards) -->
  <elements xsi:type="CPL:LanguageSwitch">
    <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
  </elements>

  <!-- TimeSwitch (for guard coverage, also can be the contents of NotPresent above) -->
  <elements xsi:type="CPL:TimeSwitch" dtstart="20260101T000000Z" interval="60" wkst="MO"/>

  <!-- PrioritySwitch (for guard coverage) -->
  <elements xsi:type="CPL:PrioritySwitch">
    <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
  </elements>

  <!-- Top-level simple Proxy used as contents of Incoming via contents reference if desired -->
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="sequential"/>

</CPL:CPLModel>