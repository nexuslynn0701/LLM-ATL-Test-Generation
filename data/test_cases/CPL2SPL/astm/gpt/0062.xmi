<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL, references most other elements via contents -->
  <elements xsi:type="CPL:CPL">
    <subActions contents="//@elements.1"/>
    <subActions contents="//@elements.2"/>
    <outgoing contents="//@elements.3"/>
    <incoming contents="//@elements.7"/>
  </elements>

  <!-- 1: SubAction saA -> SubAction2Function (contents = Proxy simple) -->
  <elements xsi:type="CPL:SubAction" id="saA">
    <contents xsi:type="CPL:Proxy" timeout="10" recurse="yes" ordering="sequential">
      <!-- simple proxy: no busy/noAnswer/redirection/failure/default -->
    </contents>
  </elements>

  <!-- 2: SubAction saB -> SubAction2Function (contents = Proxy complex) -->
  <elements xsi:type="CPL:SubAction" id="saB">
    <contents xsi:type="CPL:Proxy" timeout="20" recurse="no" ordering="parallel">
      <busy contents="//@elements.8"/>
      <noAnswer/>
      <redirection contents="//@elements.9"/>
      <failure/>
      <default contents="//@elements.10"/>
    </contents>
  </elements>

  <!-- 3: Outgoing -> Outgoing2Method (contents = AddressSwitch) -->
  <elements xsi:type="CPL:Outgoing">
    <contents xsi:type="CPL:AddressSwitch" field="origin" subField="user">
      <addresses contents="//@elements.11"/>
      <addresses contents="//@elements.12"/>
      <notPresent/>
      <otherwise contents="//@elements.6"/>
    </contents>
  </elements>

  <!-- 4: Location loc1 used by Proxy (simple) and Redirect -->
  <elements xsi:type="CPL:Location" url="sip:user1@example.com" priority="1" clear="yes"/>

  <!-- 5: Location loc2 used by complex Proxy -->
  <elements xsi:type="CPL:Location" url="sip:user2@example.com" priority="2" clear="no"/>

  <!-- 6: Redirect (used as Otherwise.contents) -> Redirect2Return -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

  <!-- 7: Incoming -> Incoming2Method (contents = SubCall) -->
  <elements xsi:type="CPL:Incoming">
    <contents xsi:type="CPL:SubCall" ref="saA"/>
  </elements>

  <!-- 8: Redirect (used as Busy.contents) -> Redirect2Return -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 9: SubCall used inside Redirection.selectCase (via complex Proxy) -->
  <elements xsi:type="CPL:SubCall" ref="saB"/>

  <!-- 10: Reject used as Default.contents (but filtered out as statement) -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>

  <!-- 11: SwitchedAddress case 1 -> SwitchedAddress2SelectCase -->
  <elements xsi:type="CPL:SwitchedAddress" is="alice@example.com" contains="local" subDomainOf="example.com">
    <!-- contents = Redirect (index 6) -->
    <contents xsi:type="CPL:Redirect" permanent="true"/>
  </elements>

  <!-- 12: SwitchedAddress case 2 -> SwitchedAddress2SelectCase, contents = Proxy simple -->
  <elements xsi:type="CPL:SwitchedAddress" is="bob@example.com" contains="remote" subDomainOf="other.org">
    <contents xsi:type="CPL:Proxy" timeout="5" recurse="yes" ordering="parallel"/>
  </elements>

  <!-- 13: Proxy simple at top level, uses loc1 -> Proxy2Return -->
  <elements xsi:type="CPL:Proxy" timeout="15" recurse="yes" ordering="parallel">
    <contents xsi:type="CPL:Location" url="sip:proxy-simple@example.com" priority="3" clear="yes"/>
  </elements>

  <!-- 14: Proxy complex at top level, uses loc2 -> Proxy2Select, Busy/NoAnswer/Redirection/Failure/Default rules -->
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="no" ordering="sequential">
    <busy contents="//@elements.4"/>
    <noAnswer contents="//@elements.6"/>
    <redirection contents="//@elements.8"/>
    <failure/>
    <default contents="//@elements.9"/>
  </elements>

</CPL:CPLModel>