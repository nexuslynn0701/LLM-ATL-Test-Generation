<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:CPL="http://cpl/1.0">

  <!-- Root CPL, with one SubAction, Incoming and Outgoing -->
  <elements xsi:type="CPL:CPL">
    <subActions xsi:type="CPL:SubAction" id="subA">
      <!-- SubAction contents is a complex Proxy (triggers Proxy2Select) -->
      <contents xsi:type="CPL:Proxy" timeout="20" recurse="no" ordering="sequential">
        <!-- Attach a Location so Proxy.locations is non-empty -->
        <contents xsi:type="CPL:Location" url="sip:subA@example.com" priority="1" clear="yes"/>
        <!-- All branches present, referencing top-level nodes via contents -->
        <busy contents="//@elements.3"/>
        <noAnswer contents="//@elements.4"/>
        <redirection contents="//@elements.5"/>
        <failure/>
        <default contents="//@elements.6"/>
      </contents>
    </subActions>

    <!-- Incoming method whose contents is a Redirect (triggers Redirect2Return) -->
    <incoming xsi:type="CPL:Incoming">
      <contents xsi:type="CPL:Redirect" permanent="true">
        <!-- Location for Redirect.locations -->
        <contents xsi:type="CPL:Location" url="sip:redirect@example.net" priority="5" clear="true"/>
      </contents>
    </incoming>

    <!-- Outgoing method whose contents is a simple Proxy (triggers Proxy2Return) -->
    <outgoing xsi:type="CPL:Outgoing">
      <contents xsi:type="CPL:Proxy" timeout="15" recurse="yes" ordering="parallel">
        <!-- Simple Proxy: no branches, only a Location child -->
        <contents xsi:type="CPL:Location" url="sip:notify@example.org" priority="10" clear="clearAll"/>
      </contents>
    </outgoing>
  </elements>

  <!-- Top-level Location used as a statement via its contents (SubCall) -->
  <elements xsi:type="CPL:Location" url="sip:loc-top@example.com" priority="3" clear="clear">
    <!-- contents points to top-level SubCall (elements.2) -->
    <contents xsi:type="CPL:SubCall" ref="subA"/>
  </elements>

  <!-- Top-level Reject, used inside busy (elements.0.subActions[0].contents.busy.contents) -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy here"/>

  <!-- Top-level TimeSwitch, used inside noAnswer -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Berlin" tzurl="http://tz.example.org">
    <!-- One SwitchedTime child so rule coverage is not empty -->
    <times dtstart="20250101T080000Z" interval="30" wkst="MO"/>
  </elements>

  <!-- Top-level PrioritySwitch, used inside redirection -->
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities/>
  </elements>

  <!-- Top-level AddressSwitch to trigger AddressSwitch2SelectStat and SwitchedAddress2SelectCase, NotPresent2ErrorResponse, Otherwise2SelectDefault -->
  <elements xsi:type="CPL:AddressSwitch" field="origin" subField="user">
    <!-- SwitchedAddress with contents = simple Proxy -->
    <addresses is="sip:alice@example.com" contains="alice" subDomainOf="example.com">
      <contents xsi:type="CPL:Proxy" timeout="5" recurse="yes" ordering="parallel">
        <!-- Simple Proxy: only Location child, no branches -->
        <contents xsi:type="CPL:Location" url="sip:alice-device@example.com" priority="2" clear="yes"/>
      </contents>
    </addresses>
    <!-- notPresent branch (triggers NotPresent2ErrorResponse) with contents = Reject -->
    <notPresent contents="//@elements.3"/>
    <!-- otherwise branch (triggers Otherwise2SelectDefault) with contents = SubCall -->
    <otherwise contents="//@elements.2"/>
  </elements>

  <!-- Top-level StringSwitch to trigger StringSwitch2SelectStat -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent" contains="URGENT">
      <!-- contents = Location (should yield empty statements in rules) -->
      <contents xsi:type="CPL:Location" url="sip:string@example.com" priority="4" clear="no"/>
    </strings>
    <strings is="normal" contains="NORMAL"/>
  </elements>

  <!-- Top-level LanguageSwitch to appear in contents tests (will produce empty statements) -->
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en-US"/>
  </elements>

  <!-- Top-level TimeSwitch used only via contents from elsewhere (already have one, add another for variety) -->
  <elements xsi:type="CPL:TimeSwitch" tzid="UTC" tzurl="http://tz2.example.org">
    <times dtstart="20250101T000000Z" interval="60" wkst="SU"/>
  </elements>

  <!-- Top-level PrioritySwitch for contents condition paths -->
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities/>
  </elements>

  <!-- Top-level Redirect with permanent="false" to exercise else branch in Redirect2Return -->
  <elements xsi:type="CPL:Redirect" permanent="false">
    <contents xsi:type="CPL:Location" url="sip:temp-redirect@example.net" priority="7" clear="yes"/>
  </elements>

</CPL:CPLModel>