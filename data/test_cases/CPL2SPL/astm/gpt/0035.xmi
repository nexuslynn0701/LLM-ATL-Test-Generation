<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:CPL="http://cpl/1.0">

  <!-- Root CPL: triggers CPL2Program, Incoming2Method, Outgoing2Method -->
  <elements xsi:type="CPL:CPL">
    <subActions contents="//@elements.1" id="sa1"/>
    <subActions contents="//@elements.4" id="sa2"/>
    <incoming contents="//@elements.2"/>
    <outgoing contents="//@elements.6"/>
  </elements>

  <!-- sa1 body: simple Proxy => Proxy2Return, Location2URIConstant -->
  <elements xsi:type="CPL:Proxy" recurse="true" ordering="parallel">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default/>
  </elements>

  <!-- Incoming contents: SubCall => SubCall2Return -->
  <elements xsi:type="CPL:SubCall" ref="sa1"/>

  <!-- Location used by simple Proxy (via locations helper) -->
  <elements xsi:type="CPL:Location" url="sip:user1@example.com" priority="1" clear="yes"/>

  <!-- sa2 body: complex Proxy => Proxy2Select, Busy/NoAnswer/Redirection/Default cases, Failure2ErrorResponse, NotPresent2ErrorResponse, Location2URIConstant -->
  <elements xsi:type="CPL:Proxy" recurse="false" ordering="sequential">
    <busy contents="//@elements.7"/>
    <noAnswer contents="//@elements.8"/>
    <redirection contents="//@elements.9"/>
    <failure/>
    <default contents="//@elements.3"/>
  </elements>

  <!-- Outgoing contents: AddressSwitch => AddressSwitch2SelectStat, SwitchedAddress2SelectCase, Otherwise2SelectDefault -->
  <elements xsi:type="CPL:AddressSwitch" field="origin" subField="user">
    <addresses contents="//@elements.10"/>
    <notPresent/>
    <otherwise contents="//@elements.5"/>
  </elements>

  <!-- Busy branch contents: Reject => Reject2Return -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>

  <!-- NoAnswer branch contents: Redirect => Redirect2Return, Location2URIConstant -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

  <!-- Redirection branch contents: StringSwitch => StringSwitch2SelectStat -->
  <elements xsi:type="CPL:StringSwitch" field="subject"/>

  <!-- SwitchedAddress inside AddressSwitch -->
  <elements xsi:type="CPL:SwitchedAddress" is="alice@example.com" contains="alice" subDomainOf="example.com"/>

</CPL:CPLModel>