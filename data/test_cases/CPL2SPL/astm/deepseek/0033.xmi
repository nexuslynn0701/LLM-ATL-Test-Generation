<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="callForward"/>
    <outgoing/>
    <incoming/>
  </elements>
  <elements xsi:type="CPL:SubAction" id="callForward"/>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="user1@example.com" contains="example.com"/>
    <addresses is="user2@example.org"/>
    <notPresent/>
  </AddressSwitch>
  <elements xsi:type="CPL:TimeSwitch dtstart="20240101T000000" interval="60" wkst="MO">
    <times dtstart="20250101T000000" dtend="20251231T235959" duration="P1M" freq="DAILY" until="20251231T000000" count="10" interval="1440" wkst="SU"/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="3" greater="7" equal="5"/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:StringSwitch field="user-agent">
    <strings is="MySoftPhone" contains="SoftPhone"/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:user@voip.example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Proxy" timeout="10" recurse="yes" ordering="parallel">
    <busy/>
    <noAnswer>
      <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
    </noAnswer>
    <redirection/>
    <failure>
      <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
    </failure>
    <default/>
  </elements>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:SubCall" ref="callForward"/>
</CPL:CPLModel>