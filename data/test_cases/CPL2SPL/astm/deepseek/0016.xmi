<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="processCall"/>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com">
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:SubCall" ref="processCall"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:TimeSwitch" dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
            </failure>
            <default>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="1" equal="3"/>
              </contents>
            </default>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="softphone">
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
              </contents>
            </strings>
          </contents>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="10" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:SubCall" ref="processCall"/>
</CPL:CPLModel>