<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="search"/>
    <subActions id="forward"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="destination">
        <addresses is="sip:bob@example.com">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy/>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default>
              <contents xsi:type="CPL:SubCall" ref="search"/>
            </default>
          </contents>
        </addresses>
        <addresses is="sip:alice@example.com">
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:operator@example.com" priority="0" clear="yes"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="help">
          <contents xsi:type="CPL:Location" url="sip:helpdesk@example.com" priority="1" clear="no"/>
        </strings>
        <notPresent/>
        <otherwise/>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="search"/>
  <elements xsi:type="CPL:SubCall" ref="forward"/>
  <elements xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="0" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default/>
  </elements>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <notPresent/>
    <otherwise/>
  </elements>
</CPL:CPLModel>