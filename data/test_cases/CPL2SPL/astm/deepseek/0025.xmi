<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="greeting"/>
    <subActions id="forwarding"/>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com">
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </addresses>
        <addresses is="sip:bob@example.com">
          <contents xsi:type="CPL:TimeSwitch" dtstart="20250101T000000" interval="3600" wkst="MO">
            <times matches="en"/>
          </contents>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:operator@example.com" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings contains="urgent">
          <contents xsi:type="CPL:Location" url="sip:urgent@example.com" clear="yes"/>
        </strings>
        <notPresent>
          <contents xsi:type="CPL:Busy"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="3">
              <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                <busy>
                  <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
                </busy>
                <noAnswer>
                  <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="no"/>
                </noAnswer>
                <redirection>
                  <contents xsi:type="CPL:SubCall" ref="forwarding"/>
                </redirection>
                <failure>
                  <contents xsi:type="CPL:Redirect" permanent="true"/>
                </failure>
                <default>
                  <contents xsi:type="CPL:Location" url="sip:default@example.com" clear="yes"/>
                </default>
              </contents>
            </priorities>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en">
                  <contents xsi:type="CPL:Location" url="sip:en_support@example.com" clear="yes"/>
                </languages>
                <languages matches="fr">
                  <contents xsi:type="CPL:Reject" status="503" reason="French unavailable"/>
                </languages>
                <notPresent>
                  <contents xsi:type="CPL:NoAnswer"/>
                </notPresent>
                <otherwise>
                  <contents xsi:type="CPL:SubCall" ref="greeting"/>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
</CPL:CPLModel>