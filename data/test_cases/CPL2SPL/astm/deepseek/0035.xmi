<?xml version="1.0" encoding="UTF-8"?>
<cp l:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="handleCall"/>
    <incoming>
      <contents xsi:type="CPL:Proxy" timeout="10" recurse="yes" ordering="parallel">
        <busy/>
        <noAnswer/>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="user@example.com"/>
        <addresses is="admin@example.com"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubAction" id="handleCall">
    <contents xsi:type="CPL:PrioritySwitch">
      <priorities less="5" greater="1"/>
      <notPresent/>
      <otherwise>
        <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
      </otherwise>
    </contents>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:StringSwitch" field="user-agent">
    <strings is="Cisco-Phone"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <notPresent/>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" dtstart="20240101T000000" interval="1" wkst="MO">
    <times dtstart="20240101T000000" interval="1" wkst="MO"/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="voicemailHandler"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
</cp l:CPLModel>