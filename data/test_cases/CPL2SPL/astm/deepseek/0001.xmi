<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="loginCheck"/>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com">
          <contents xsi:type="CPL:Redirect" permanent="true">
            <location url="sip:alice@backup.com" clear="yes" priority="1"/>
          </contents>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="loginCheck"/>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="user-agent">
        <strings is="SIPPhoneV1">
          <contents xsi:type="CPL:Reject" status="488" reason="Not Acceptable Here"/>
        </strings>
        <strings is="SIPPhoneV2">
          <contents xsi:type="CPL:Location" url="sip:gateway@company.com" clear="yes" priority="1"/>
        </strings>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Proxy" timeout="15" recurse="no" ordering="parallel">
                <failure>
                  <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
                </failure>
                <default/>
              </contents>
            </redirection>
            <failure>
              <contents xsi:type="CPL:SubCall" ref="errorHandler"/>
            </failure>
            <default>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="yes" priority="0"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="loginCheck"/>
  <elements xsi:type="CPL:SubCall" ref="errorHandler"/>
  <elements xsi:type="CPL:Location" url="sip:alice@backup.com" clear="yes" priority="1"/>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Proxy" timeout="20" recurse="yes" ordering="parallel">
    <busy/>
    <noAnswer>
      <contents xsi:type="CPL:Location" url="sip:backup@voicemail.com" clear="yes" priority="0"/>
    </noAnswer>
    <redirection/>
    <failure/>
    <default/>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York">
    <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="486" reason="After Hours"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:support@company.com" clear="yes" priority="1"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr">
      <contents xsi:type="CPL:Location" url="sip:french-support@company.com" clear="yes" priority="1"/>
    </languages>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5">
      <contents xsi:type="CPL:Reject" status="486" reason="Low Priority"/>
    </priorities>
    <priorities greater="8">
      <contents xsi:type="CPL:Location" url="sip:urgent@company.com" clear="yes" priority="1"/>
    </priorities>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
        <default/>
      </contents>
    </otherwise>
  </elements>
</CPL:CPLModel>