<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="handleIncoming"/>
    <subActions id="handleOutgoing"/>
    <outgoing>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="handleIncoming"/>
        </otherwise>
        <addresses is="sip:alice@example.com">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy/>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default/>
          </contents>
        </addresses>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="handleIncoming"/>
  <elements xsi:type="CPL:SubCall" ref="handleOutgoing"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:StringSwitch" field="user-agent">
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:TimeSwitch" tzid="UTC">
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy/>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default/>
          </contents>
        </otherwise>
        <times dtstart="20240101T000000" interval="1" wkst="MO"/>
      </contents>
    </otherwise>
    <strings is="UserAgentXYZ"/>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:PrioritySwitch">
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="yes"/>
        </otherwise>
        <priorities less="5" greater="10" equal="7"/>
      </contents>
    </otherwise>
    <languages matches="en"/>
  </elements>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default/>
  </elements>
</CPL:CPLModel>