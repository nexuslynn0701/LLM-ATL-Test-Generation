<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="greeting">
      <contents xsi:type="CPL:Proxy" timeout="10" recurse="yes" ordering="parallel">
        <failure>
          <contents xsi:type="CPL:SubCall" ref="handleFailure"/>
        </failure>
        <default>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </default>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="user">
        <addresses is="alice@example.com" contains="alice" subDomainOf="example.com">
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
            <busy/>
            <noAnswer>
              <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
            </noAnswer>
          </contents>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="yes"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
</CPL:CPLModel>