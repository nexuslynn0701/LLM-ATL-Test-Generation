<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <subActions id="sub2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com">
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </addresses>
        <addresses is="sip:bob@example.com">
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Location" url="sip:secretary@example.com" priority="2" clear="no"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:SubCall" ref="sub2"/>
            </redirection>
            <failure/>
            <default/>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent">
          <contents xsi:type="CPL:Location" url="sip:manager@example.com" priority="1" clear="yes"/>
        </strings>
        <strings is="spam">
          <contents xsi:type="CPL:Reject" status="603" reason="Declined"/>
        </strings>
        <notPresent>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy/>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default/>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="yes"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="3" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default/>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="sip:help@example.com">
      <contents xsi:type="CPL:SubCall" ref="sub2"/>
    </addresses>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="user-agent">
    <strings is="CustomPhone">
      <contents xsi:type="CPL:Location" url="sip:special@example.com" priority="1" clear="yes"/>
    </strings>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="sub1"/>
  <elements xsi:type="CPL:SubCall" ref="sub2"/>
</CPL:CPLModel>