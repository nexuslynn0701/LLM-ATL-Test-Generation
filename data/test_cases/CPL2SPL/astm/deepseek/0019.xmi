<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="checkCaller"/>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com">
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
            <busy/>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default contents="//@elements.2"/>
          </contents>
        </addresses>
        <addresses is="sip:bob@example.com">
          <contents xsi:type="CPL:Redirect" permanent="false">
            <contents xsi:type="CPL:Location" url="sip:carol@other.com" priority="1" clear="yes"/>
          </contents>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:TimeSwitch" dtstart="20240101T000000" interval="3600" wkst="MO">
        <times dtstart="20240101T080000" interval="28800" wkst="MO"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy/>
            <default contents="//@elements.0"/>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubAction" id="checkCaller">
    <contents xsi:type="CPL:AddressSwitch" field="destination">
      <addresses is="sip:unknown@example.com">
        <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
      </addresses>
      <notPresent>
        <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
          <default contents="//@elements.3"/>
        </contents>
      </notPresent>
      <otherwise>
        <contents xsi:type="CPL:SubCall" ref="forwardToVoicemail"/>
      </otherwise>
    </contents>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:SubAction" id="forwardToVoicemail">
    <contents xsi:type="CPL:PrioritySwitch">
      <priorities less="5">
        <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
      </priorities>
      <priorities greater="5">
        <contents xsi:type="CPL:Reject" status="600" reason="Declined"/>
      </priorities>
      <notPresent>
        <contents xsi:type="CPL:Redirect" permanent="true"/>
      </notPresent>
      <otherwise>
        <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="3" clear="no"/>
      </otherwise>
    </contents>
  </elements>
  <elements xsi:type="CPL:SubAction" id="logCall">
    <contents xsi:type="CPL:LanguageSwitch">
      <languages matches="en">
        <contents xsi:type="CPL:Location" url="sip:english@example.com" priority="1" clear="yes"/>
      </languages>
      <languages matches="fr">
        <contents xsi:type="CPL:Location" url="sip:french@example.com" priority="1" clear="yes"/>
      </languages>
      <notPresent>
        <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="no"/>
      </notPresent>
    </contents>
  </elements>
</CPL:CPLModel>