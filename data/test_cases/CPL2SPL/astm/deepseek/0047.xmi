<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="checkAddress"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="destination">
        <addresses is="sip:bob@example.com">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="voicemail"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="false"/>
            </failure>
            <default>
              <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="0" clear="true"/>
            </default>
          </contents>
        </addresses>
        <addresses is="sip:alice@example.com">
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5">
              <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
                <default>
                  <contents xsi:type="CPL:Location" url="sip:low@example.com" priority="1" clear="false"/>
                </default>
              </contents>
            </priorities>
            <priorities greater="5">
              <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel"/>
            </priorities>
          </contents>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:unknown@example.com" priority="0" clear="true"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel"/>
        </strings>
        <strings is="spam">
          <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
        </strings>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:normal@example.com" priority="0" clear="false"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
            <default>
              <contents xsi:type="CPL:SubCall" ref="defaultHandler"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubAction" id="checkAddress"/>
  <elements xsi:type="CPL:SubAction" id="voicemail"/>
  <elements xsi:type="CPL:SubAction" id="defaultHandler"/>
  <elements xsi:type="CPL:Location" url="sip:first@example.com" priority="0" clear="true"/>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential"/>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="sip:trusted@example.com">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel"/>
    </addresses>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="403" reason="Unauthorized"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="user-agent">
    <strings is="Softphone">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential"/>
    </strings>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:other@example.com" priority="1" clear="false"/>
    </otherwise>
  </elements>
</CPL:CPLModel>