<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0"
    xsi:schemaLocation="http://cpl/1.0 CPL.ecore" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default/>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="user@domain.com"/>
        <notPresent/>
        <otherwise/>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="User-Agent">
        <strings is="Cisco"/>
        <notPresent/>
        <otherwise/>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="sub1"/>
  <elements xsi:type="CPL:Location" url="sip:test@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="600" reason="Global Busy"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default/>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="sip:help@domain.com" contains="help"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" dtstart="20240101T000000" interval="PT1H" wkst="MO">
    <times dtstart="20240101T080000" interval="PT8H" wkst="MO"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="10"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:voicemail@domain.com" priority="1" clear="yes"/>
    </busy>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default/>
  </elements>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </default>
  </elements>
</CPL:CPLModel>