<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="user">
        <addresses is="alice@example.com">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy/>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default contents="//@elements.3"/>
          </contents>
        </addresses>
        <addresses is="bob@example.com">
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </addresses>
        <notPresent/>
        <otherwise contents="//@elements.4"/>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent">
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
            <default contents="//@elements.5"/>
          </contents>
        </strings>
        <notPresent/>
        <otherwise/>
      </contents>
    </outgoing>
    <subActions>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en">
          <contents xsi:type="CPL:Location" url="sip:en.support@example.com" priority="1" clear="yes"/>
        </languages>
        <notPresent/>
        <otherwise/>
      </contents>
    </subActions>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="subAction1"/>
  <elements xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="30">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default contents="//@elements.1"/>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
</CPL:CPLModel>