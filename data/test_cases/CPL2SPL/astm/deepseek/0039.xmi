<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="handleCall"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="destination" subField="user">
        <addresses is="alice@example.com"/>
        <notPresent>
          <contents xsi:type="CPL:SubCall" ref="handleCall"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Reject" status="408" reason="No Answer"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Location" url="sip:bob@backup.com" priority="1" clear="yes"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </failure>
            <default>
              <contents xsi:type="CPL:Location" url="sip:default@voicemail.com" priority="1" clear="yes"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent"/>
        <strings is="normal"/>
        <notPresent>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="handleCall"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:proxy@main.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default contents="//@elements.3"/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="handleCall"/>
  <elements xsi:type="CPL:AddressSwitch" field="origin" subField="host">
    <addresses is="sip:trusted.com"/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:gateway@external.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="user-agent">
    <strings is="UserAgentX"/>
    <notPresent>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default contents="//@elements.2"/>
      </contents>
    </otherwise>
  </elements>
</CPL:CPLModel>