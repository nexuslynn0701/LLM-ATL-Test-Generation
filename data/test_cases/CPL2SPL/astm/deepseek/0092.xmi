<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="checkAvailability"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="destination">
        <addresses is="sip:alice@example.com">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:SubCall" ref="checkAvailability"/>
            </failure>
            <default>
              <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="yes"/>
            </default>
          </contents>
        </addresses>
        <addresses is="sip:bob@example.com">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy/>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default>
              <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
            </default>
          </contents>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent">
          <contents xsi:type="CPL:Location" url="sip:urgent@example.com" priority="1" clear="yes"/>
        </strings>
        <strings is="private">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy"/>
            </busy>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default>
              <contents xsi:type="CPL:Location" url="sip:private@example.com" priority="1" clear="yes"/>
            </default>
          </contents>
        </strings>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:general@example.com" priority="1" clear="yes"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="checkAvailability"/>
  <elements xsi:type="CPL:Location" url="sip:main@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="1" clear="yes"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Location" url="sip:noanswer@example.com" priority="1" clear="yes"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Location" url="sip:redirected@example.com" priority="1" clear="yes"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Location" url="sip:failure@example.com" priority="1" clear="yes"/>
    </failure>
    <default>
      <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="yes"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="sip:trusted@example.com">
      <contents xsi:type="CPL:Location" url="sip:trusted-forward@example.com" priority="1" clear="yes"/>
    </addresses>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York">
    <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO">
      <contents xsi:type="CPL:Location" url="sip:office@example.com" priority="1" clear="yes"/>
    </times>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:home@example.com" priority="1" clear="yes"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="480" reason="Outside Business Hours"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5">
      <contents xsi:type="CPL:Location" url="sip:low-priority@example.com" priority="1" clear="yes"/>
    </priorities>
    <priorities greater="8">
      <contents xsi:type="CPL:Location" url="sip:high-priority@example.com" priority="1" clear="yes"/>
    </priorities>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:normal-priority@example.com" priority="1" clear="yes"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en">
      <contents xsi:type="CPL:Location" url="sip:english@example.com" priority="1" clear="yes"/>
    </languages>
    <languages matches="fr">
      <contents xsi:type="CPL:Location" url="sip:french@example.com" priority="1" clear="yes"/>
    </languages>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="406" reason="Not Acceptable"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:default-language@example.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
</CPL:CPLModel>