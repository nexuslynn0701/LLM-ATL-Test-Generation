<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="authCheck"/>
    <subActions id="logCall"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="destination">
        <addresses is="sip:boss@company.com">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@company.com" clear="yes"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Location" url="sip:secretary@company.com" clear="yes"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:SubCall" ref="logCall"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
            </failure>
            <default>
              <contents xsi:type="CPL:Location" url="sip:default@company.com" clear="no"/>
            </default>
          </contents>
        </addresses>
        <addresses is="sip:client@company.com">
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:operator@company.com" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
            <default>
              <contents xsi:type="CPL:Location" url="sip:pool@company.com" clear="no"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent">
          <contents xsi:type="CPL:Location" url="sip:urgent@company.com" clear="yes"/>
        </strings>
        <strings is="spam">
          <contents xsi:type="CPL:Reject" status="603" reason="Declined"/>
        </strings>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:inbox@company.com" clear="no"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:general@company.com" clear="no"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="authCheck"/>
  <elements xsi:type="CPL:SubCall" ref="logCall"/>
  <elements xsi:type="CPL:Location" url="sip:voicemail@company.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:secretary@company.com" priority="2" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:default@company.com" priority="3" clear="no"/>
  <elements xsi:type="CPL:Location" url="sip:operator@company.com" priority="4" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:pool@company.com" priority="5" clear="no"/>
  <elements xsi:type="CPL:Location" url="sip:urgent@company.com" priority="6" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:inbox@company.com" priority="7" clear="no"/>
  <elements xsi:type="CPL:Location" url="sip:general@company.com" priority="8" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Reject" status="603" reason="Declined"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="30">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:backup@company.com" clear="yes"/>
    </busy>
    <default>
      <contents xsi:type="CPL:Location" url="sip:main@company.com" clear="no"/>
    </default>
  </elements>
</CPL:CPLModel>