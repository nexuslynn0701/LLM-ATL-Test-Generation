<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="handleIncoming"/>
    <subActions id="handleOutgoing"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com"/>
        <addresses is="sip:bob@example.com"/>
        <notPresent>
          <contents xsi:type="CPL:SubCall" ref="handleIncoming"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="no"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" dtstart="20240101T000000" interval="1" wkst="MO">
        <times dtstart="20240101T080000" interval="1" wkst="MO" dtend="20240101T180000"/>
        <times dtstart="20240101T180000" interval="1" wkst="MO" dtend="20240102T080000"/>
        <notPresent>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="handleIncoming"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="handleIncoming"/>
  <elements xsi:type="CPL:SubCall" ref="handleOutgoing"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" timeout="5" recurse="yes" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:Reject" status="486" reason="Busy"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="no"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </redirection>
    <failure/>
    <default>
      <contents xsi:type="CPL:SubCall" ref="handleIncoming"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="sip:carol@example.com"/>
    <addresses is="sip:dave@example.com"/>
    <notPresent>
      <contents xsi:type="CPL:Proxy" timeout="10" recurse="yes" ordering="parallel">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure>
          <contents xsi:type="CPL:Location" url="sip:error@example.com" priority="1" clear="no"/>
        </failure>
        <default/>
      </contents>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="Subject">
    <strings is="urgent"/>
    <strings is="normal"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:spam@example.com" priority="3" clear="yes"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="488" reason="Not Acceptable Here"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="handleOutgoing"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="3"/>
    <priorities greater="7"/>
    <notPresent>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:lowpriority@example.com" priority="5" clear="no"/>
    </otherwise>
  </elements>
</CPL:CPLModel>