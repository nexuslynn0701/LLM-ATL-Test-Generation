<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="authCheck"/>
    <subActions id="logCall"/>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:boss@company.com">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy/>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default contents="//@elements.1"/>
          </contents>
        </addresses>
        <addresses is="sip:colleague@company.com">
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="authCheck"/>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
        <times dtstart="20240101T170000" dtend="20240102T090000" interval="1" wkst="MO"/>
        <notPresent>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <default contents="//@elements.2"/>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="logCall"/>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:boss-mobile@company.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:voicemail@company.com" priority="2" clear="yes"/>
  <elements xsi:type="CPL:SubCall" ref="authCheck"/>
  <elements xsi:type="CPL:SubCall" ref="logCall"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Reject" status="486" reason="Busy"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Location" url="sip:backup@company.com" priority="1" clear="yes"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:SubCall" ref="logCall"/>
    </failure>
    <default>
      <contents xsi:type="CPL:AddressSwitch" field="destination">
        <addresses is="sip:support@company.com">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <default contents="//@elements.1"/>
          </contents>
        </addresses>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="404" reason="No Support"/>
        </otherwise>
      </contents>
    </default>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent">
      <contents xsi:type="CPL:Location" url="sip:urgent@company.com" priority="1" clear="yes"/>
    </strings>
    <strings is="normal">
      <contents xsi:type="CPL:SubCall" ref="logCall"/>
    </strings>
    <notPresent>
      <contents xsi:type="CPL:Default"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <notPresent>
      <contents xsi:type="CPL:Default"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="488" reason="Not Acceptable Here"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5"/>
    <priorities greater="3"/>
    <priorities equal="4"/>
    <notPresent>
      <contents xsi:type="CPL:Default"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="authCheck"/>
    </otherwise>
  </elements>
</CPL:CPLModel>