<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="subA"/>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="user1@example.com">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy/>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default>
              <contents xsi:type="CPL:SubCall" ref="subA"/>
            </default>
          </contents>
        </addresses>
        <notPresent/>
        <otherwise/>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent">
          <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="no"/>
        </strings>
        <notPresent/>
        <otherwise/>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubAction" id="subA">
    <contents xsi:type="CPL:Redirect" permanent="false"/>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:main@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Proxy" timeout="10" recurse="yes" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </noAnswer>
    <redirection/>
    <failure>
      <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="2" clear="yes"/>
    </failure>
    <default/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="subA"/>
  <elements xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="sip:boss@example.com">
      <contents xsi:type="CPL:TimeSwitch" dtstart="20240101T000000" interval="1" wkst="MO">
        <times dtstart="20240101T090000" interval="1" wkst="MO"/>
        <notPresent/>
        <otherwise/>
      </contents>
    </addresses>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en">
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="3" greater="5"/>
        <notPresent/>
        <otherwise/>
      </contents>
    </languages>
    <notPresent/>
    <otherwise/>
  </elements>
</CPL:CPLModel>