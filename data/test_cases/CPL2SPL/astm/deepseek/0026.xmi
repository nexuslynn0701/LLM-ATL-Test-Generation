<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0" xmi:id="_model1">
  <elements xsi:type="CPL:CPL" xmi:id="_cpl1">
    <subActions xmi:id="_sub1" id="subAction1">
      <contents xsi:type="CPL:SubCall" ref="subAction1"/>
    </subActions>
    <incoming xmi:id="_inc1">
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses xmi:id="_addr1" is="192.168.1.1"/>
        <notPresent xmi:id="_np1"/>
        <otherwise xmi:id="_ow1">
          <contents xsi:type="CPL:Redirection"/>
        </otherwise>
      </contents>
    </incoming>
    <outgoing xmi:id="_out1">
      <contents xsi:type="CPL:StringSwitch" field="user-agent">
        <strings xmi:id="_str1" is="SIPPhone"/>
        <notPresent xmi:id="_np2"/>
        <otherwise xmi:id="_ow2">
          <contents xsi:type="CPL:NoAnswer"/>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:Proxy" xmi:id="_proxy1" timeout="30" recurse="yes" ordering="sequential">
    <busy xmi:id="_busy1">
      <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
    </busy>
    <noAnswer xmi:id="_noAns1">
      <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
    </noAnswer>
    <redirection xmi:id="_redir1"/>
    <failure xmi:id="_fail1"/>
    <default xmi:id="_def1">
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </default>
  </elements>
  <elements xsi:type="CPL:Location" xmi:id="_loc1" url="sip:admin@example.com" priority="0" clear="yes"/>
  <elements xsi:type="CPL:Redirect" xmi:id="_redir2" permanent="true"/>
  <elements xsi:type="CPL:Reject" xmi:id="_rej1" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:SubCall" xmi:id="_subCall1" ref="subAction1"/>
  <elements xsi:type="CPL:AddressSwitch" xmi:id="_addrSwitch1" field="destination">
    <addresses xmi:id="_addr2" is="10.0.0.1"/>
    <addresses xmi:id="_addr3" is="10.0.0.2"/>
    <notPresent xmi:id="_np3">
      <contents xsi:type="CPL:Busy"/>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch" xmi:id="_langSwitch1">
    <languages xmi:id="_lang1" matches="en"/>
    <languages xmi:id="_lang2" matches="fr"/>
    <otherwise xmi:id="_ow3">
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
        <busy xmi:id="_busy2">
          <contents xsi:type="CPL:Default"/>
        </busy>
        <default xmi:id="_def2">
          <contents xsi:type="CPL:Failure"/>
        </default>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch" xmi:id="_prioSwitch1">
    <priorities xmi:id="_prio1" less="10"/>
    <priorities xmi:id="_prio2" greater="20"/>
    <otherwise xmi:id="_ow4"/>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" xmi:id="_timeSwitch1" tzid="America/New_York">
    <times xmi:id="_time1" dtstart="20250101T000000" dtend="20251231T235959" interval="1" wkst="MO"/>
    <times xmi:id="_time2" dtstart="20250601T080000" duration="PT1H" interval="1" wkst="MO"/>
    <otherwise xmi:id="_ow5"/>
  </elements>
</CPL:CPLModel>