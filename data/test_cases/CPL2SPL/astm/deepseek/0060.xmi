<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="checkPriority"/>
    <subActions id="handleBusy"/>
    <incoming>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:SubCall" ref="handleBusy"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Reject" status="408" reason="Timeout"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </redirection>
        <failure>
          <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
        </failure>
        <default>
          <contents xsi:type="CPL:SubCall" ref="checkPriority"/>
        </default>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="destination">
        <addresses is="sip:alice@example.com">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <default/>
          </contents>
        </addresses>
        <addresses is="sip:bob@example.com">
          <contents xsi:type="CPL:Reject" status="486" reason="Busy"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="checkPriority"/>
  <elements xsi:type="CPL:SubCall" ref="handleBusy"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy"/>
  <elements xsi:type="CPL:Reject" status="408" reason="Timeout"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy/>
    <default contents="//@elements.1"/>
  </elements>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
    <default/>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="sip:alice@example.com">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
        <default/>
      </contents>
    </addresses>
    <addresses is="sip:bob@example.com">
      <contents xsi:type="CPL:Reject" status="486" reason="Busy"/>
    </addresses>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en">
      <contents xsi:type="CPL:Location" url="sip:en-support@example.com" priority="1" clear="yes"/>
    </languages>
    <languages matches="fr">
      <contents xsi:type="CPL:Location" url="sip:fr-support@example.com" priority="1" clear="yes"/>
    </languages>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" dtstart="20240101T000000" interval="1" wkst="MO">
    <times dtstart="20240101T080000" interval="1" wkst="MO"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="3"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:SubAction" id="checkPriority">
    <contents xsi:type="CPL:PrioritySwitch">
      <priorities less="3">
        <contents xsi:type="CPL:Location" url="sip:high-priority@example.com" priority="1" clear="yes"/>
      </priorities>
      <otherwise>
        <contents xsi:type="CPL:Location" url="sip:normal@example.com" priority="1" clear="yes"/>
      </otherwise>
    </contents>
  </elements>
  <elements xsi:type="CPL:SubAction" id="handleBusy">
    <contents xsi:type="CPL:Location" url="sip:busy-queue@example.com" priority="1" clear="yes"/>
  </elements>
</CPL:CPLModel>