<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="checkPriority"/>
    <outgoing>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="3" greater="5" equal="4"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:SubCall" ref="checkPriority"/>
            </failure>
            <default>
              <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="2" clear="no"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="user">
        <addresses is="sip:alice@example.com" contains="alice" subDomainOf="example.com">
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
            <busy/>
            <default>
              <contents xsi:type="CPL:Location" url="sip:alice-mobile@example.com" priority="1" clear="yes"/>
            </default>
          </contents>
        </addresses>
        <addresses is="sip:bob@example.com" contains="bob" subDomainOf="example.com">
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="checkPriority"/>
  <elements xsi:type="CPL:Location" url="sip:high-priority@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:low-priority@example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Proxy" timeout="60" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy-announce@example.com" priority="1" clear="yes"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Location" url="sip:noanswer-announce@example.com" priority="1" clear="yes"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="500" reason="Server Error"/>
    </failure>
    <default>
      <contents xsi:type="CPL:Location" url="sip:default-target@example.com" priority="1" clear="yes"/>
    </default>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="User-Agent">
    <strings is="Cisco" contains="Cisco"/>
    <strings is="Polycom" contains="Polycom"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:generic@example.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:default-language@example.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezones.example.com/ny">
    <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:after-hours@example.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
</CPL:CPLModel>