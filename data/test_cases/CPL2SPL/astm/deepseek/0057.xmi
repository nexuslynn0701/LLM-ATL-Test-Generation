<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="handleCall"/>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="alice@example.com">
          <contents xsi:type="CPL:Location" url="sip:bob@example.com" priority="1" clear="no"/>
        </addresses>
        <addresses is="bob@example.com">
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <languages matches="fr">
              <contents xsi:type="CPL:Location" url="sip:fr-operator@example.com" priority="1" clear="yes"/>
            </languages>
            <notPresent>
              <contents xsi:type="CPL:SubCall" ref="defaultHandler"/>
            </notPresent>
          </contents>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="5">
          <contents xsi:type="CPL:StringSwitch" field="subject">
            <strings is="urgent">
              <contents xsi:type="CPL:Proxy" timeout="10" recurse="yes" ordering="sequential">
                <busy/>
                <noAnswer/>
                <default>
                  <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
                </default>
              </contents>
            </strings>
            <otherwise>
              <contents xsi:type="CPL:Reject" status="603" reason="Declined"/>
            </otherwise>
          </contents>
        </priorities>
        <otherwise>
          <contents xsi:type="CPL:TimeSwitch" dtstart="20250101T000000" dtend="20251231T235959" interval="1" wkst="MO"/>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:SubCall" ref="defaultHandler"/>
</CPL:CPLModel>