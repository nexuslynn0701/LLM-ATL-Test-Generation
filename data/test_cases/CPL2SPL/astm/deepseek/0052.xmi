<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1">
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </subActions>
    <subActions id="sub2">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default contents="//@elements.3"/>
      </contents>
    </subActions>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="destination" subField="user">
        <addresses is="alice">
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
            <default contents="//@elements.1"/>
          </contents>
        </addresses>
        <addresses is="bob">
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="yes"/>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="user-agent">
        <strings is="softphone"/>
        <notPresent>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <failure/>
            <default contents="//@elements.5"/>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:redirected@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:SubCall" ref="sub2"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential" timeout="30">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="1" clear="yes"/>
    </busy>
    <default contents="//@elements.4"/>
  </elements>
</CPL:CPLModel>