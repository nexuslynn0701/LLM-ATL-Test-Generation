<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="action1"/>
    <incoming>
      <contents xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes"/>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:Location" url="sip:other@test.com" priority="2" clear="no"/>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="user@example.com"/>
    <notPresent/>
  </AddressSwitch>
  <elements xsi:type="CPL:StringSwitch" field="testField">
    <strings is="value1" contains="val"/>
  </StringSwitch>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential" timeout="30">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </default>
  </elements>
  <elements xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
  <elements xsi:type="CPL:SubCall" ref="action1"/>
</CPL:CPLModel>