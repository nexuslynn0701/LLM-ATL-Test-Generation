<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <incoming>
      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
        <busy/>
        <noAnswer/>
        <redirection/>
        <failure/>
        <default contents="//@elements.2"/>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.1" contains="example.com" subDomainOf="test.org">
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <default contents="//@elements.3"/>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="hello" contains="world"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en-US"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="10" equal="7"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:TimeSwitch tzid="UTC" tzurl="http://timezone.example.com">
    <times dtstart="20240101T000000" dtend="20241231T235959" duration="P1D" freq="DAILY" until="20240601T000000" count="10" interval="1" wkst="MO"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
</CPL:CPLModel>