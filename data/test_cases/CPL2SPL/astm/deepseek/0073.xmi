<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="subOne"/>
    <subActions id="subTwo"/>
    <incoming>
      <contents xsi:type="CPL:SubCall" ref="subOne"/>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:test@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:AddressSwitch" field="origin">
    <addresses is="192.168.1.1">
      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
        <noAnswer>
          <contents xsi:type="CPL:SubCall" ref="subTwo"/>
        </noAnswer>
        <failure/>
      </proxy>
    </addresses>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="user-agent">
    <strings is="softphone"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Busy"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York">
    <times dtstart="20240101T000000" interval="1" wkst="MO"/>
    <notPresent/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities greater="50"/>
  </elements>
</CPL:CPLModel>