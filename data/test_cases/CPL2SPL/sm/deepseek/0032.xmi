<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="main">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.100" contains="192.168"/>
        <addresses is="10.0.0.1" subDomainOf="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T000000" dtend="20241231T235959" duration="P1D" freq="DAILY" until="20241231T235959" count="365" interval="1" bySecond="0" byMinute="0" byHour="12" byDay="MO,TU,WE,TH,FR" byMonthDay="1" byYearDay="1" byWeekNo="1" byMonth="1" wkst="MO" bySetPos="1"/>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="3" equal="4"/>
                <notPresent>
                  <contents xsi:type="CPL:LanguageSwitch">
                    <languages matches="en"/>
                    <languages matches="fr"/>
                    <otherwise>
                      <contents xsi:type="CPL:StringSwitch" field="subject">
                        <strings is="urgent" contains="important"/>
                        <notPresent>
                          <contents xsi:type="CPL:Location" url="sip:user@backup.example.com" priority="1" clear="yes"/>
                        </notPresent>
                      </contents>
                    </otherwise>
                  </contents>
                </notPresent>
              </contents>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:Redirect" permanent="no"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:SubCall" ref="voicemail"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Location" url="sip:admin@failover.example.com" priority="2" clear="no"/>
            </failure>
            <default>
              <contents xsi:type="CPL:Location" url="sip:user@primary.example.com" priority="1" clear="yes"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="destination">
        <addresses is="+1234567890"/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
            <default>
              <contents xsi:type="CPL:Location" url="sip:gateway.example.com" priority="1" clear="yes"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="UTC">
        <times dtstart="20240101T000000" interval="1" wkst="MO"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="voicemail"/>
  <elements xsi:type="CPL:Location" url="sip:admin@failover.example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy/>
    <default contents="//@elements.1"/>
  </elements>
</CPL:CPLModel>