<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.1" contains="192.168."/>
        <addresses is="10.0.0.1" subDomainOf="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <languages matches="fr"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
        <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
        <times dtstart="20240201T000000" freq="WEEKLY" interval="2" byDay="MO,WE,FR" byHour="9,10,11" wkst="MO"/>
        <notPresent>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="CiscoPhone" contains="Cisco"/>
            <strings is="Polycom"/>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="1"/>
                <priorities equal="3"/>
                <otherwise>
                  <contents xsi:type="CPL:Redirect" permanent="no"/>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="no"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:SubCall" ref="sub1"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
            </failure>
            <default contents="//@elements.2"/>
          </proxy>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubAction" id="sub1">
    <outgoing>
      <contents xsi:type="CPL:Location" url="sip:operator@example.com" priority="1" clear="yes"/>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <busy/>
    <default contents="//@elements.0"/>
  </elements>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="603" reason="Declined"/>
  <elements xsi:type="CPL:SubCall" ref="anotherAction"/>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="sip:test@example.com" contains="@example.com"/>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="from">
    <strings is="anonymous"/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="10" clear="no"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="de"/>
    <notPresent>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential"/>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:TimeSwitch">
    <times dtstart="20240101T000000" interval="1" wkst="SU"/>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="no"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="10" greater="0"/>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
    </otherwise>
  </elements>
</CPL:CPLModel>