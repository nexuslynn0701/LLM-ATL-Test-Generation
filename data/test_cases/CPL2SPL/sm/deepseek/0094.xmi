<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="main"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com" contains="alice"/>
        <addresses is="sip:bob@example.com" subDomainOf="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <languages matches="fr"/>
            <notPresent>
              <contents xsi:type="CPL:Redirect" permanent="no"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="3" equal="4"/>
                <otherwise>
                  <contents xsi:type="CPL:StringSwitch" field="subject">
                    <strings contains="urgent"/>
                    <strings is="meeting"/>
                    <notPresent>
                      <contents xsi:type="CPL:SubCall" ref="defaultHandler"/>
                    </notPresent>
                  </contents>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Location" url="sip:assistant@example.com" priority="2" clear="no"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Redirect" permanent="yes"/>
        </redirection>
        <failure>
          <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
        </failure>
        <default contents="//@elements.1"/>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="defaultHandler"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="3" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="no"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
</CPL:CPLModel>