<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <subActions id="sub2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100"/>
        <addresses contains="10.0.0."/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5"/>
                <priorities greater="3" equal="4"/>
                <otherwise>
                  <contents xsi:type="CPL:Location" url="sip:user@backup.com" priority="1" clear="yes"/>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="subject">
            <strings contains="urgent"/>
            <strings is="meeting"/>
            <notPresent>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <otherwise>
                  <contents xsi:type="CPL:SubCall" ref="voicemail"/>
                </otherwise>
              </contents>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
                <busy/>
                <noAnswer/>
                <redirection/>
                <failure/>
                <default contents="//@elements.0/@subActions.0"/>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Redirect" permanent="no"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Location" url="sip:admin@company.com" priority="10" clear="no"/>
</CPL:CPLModel>