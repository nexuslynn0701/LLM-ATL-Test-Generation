<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="main"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100" contains="192.168"/>
        <addresses is="10.0.0.1" subDomainOf="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <languages matches="fr"/>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="3" equal="4"/>
                <notPresent>
                  <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                    <busy/>
                    <noAnswer/>
                    <redirection/>
                    <failure/>
                    <default contents="//@elements.2"/>
                  </contents>
                </notPresent>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="meeting"/>
        <strings is="spam"/>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="no"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="voicemail"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Location" url="sip:admin@company.com" priority="10" clear="no"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <default contents="//@elements.3"/>
  </elements>
</CPL:CPLModel>