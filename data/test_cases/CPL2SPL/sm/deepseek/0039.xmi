<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <subActions id="sub1"/>
    <subActions id="sub2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com" contains="example.com"/>
        <addresses is="sip:bob@example.org" subDomainOf="example.org"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5" greater="3" equal="4"/>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <otherwise>
                  <contents xsi:type="CPL:StringSwitch" field="subject">
                    <strings contains="urgent"/>
                    <strings is="meeting"/>
                    <notPresent>
                      <contents xsi:type="CPL:SubCall" ref="defaultHandler"/>
                    </notPresent>
                  </contents>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:Redirect" permanent="no"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Reject" status="486" reason="Busy"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Location" url="sip:redirect@example.com" priority="2" clear="no"/>
        </redirection>
        <failure>
          <contents xsi:type="CPL:SubCall" ref="failureHandler"/>
        </failure>
        <default>
          <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="yes"/>
        </default>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="sub1"/>
  <elements xsi:type="CPL:SubCall" ref="sub2"/>
  <elements xsi:type="CPL:Location" url="sip:fallback@example.com" priority="3" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
    <default>
      <contents xsi:type="CPL:Location" url="sip:final@example.com" priority="1" clear="yes"/>
    </default>
  </elements>
</CPL:CPLModel>