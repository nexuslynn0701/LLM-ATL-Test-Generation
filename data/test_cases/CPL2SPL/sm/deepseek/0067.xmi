<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="main"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100" contains="example.com"/>
        <otherwise>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
            <notPresent/>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="to">
        <strings is="support" contains="help"/>
        <notPresent>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <otherwise/>
          </contents>
        </notPresent>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="voicemail"/>
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes">
    <contents xsi:type="CPL:SubCall" ref="backup"/>
  </elements>
  <elements xsi:type="CPL:Redirect" permanent="no"/>
  <elements xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <busy/>
    <noAnswer/>
    <failure>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="5" greater="3" equal="4"/>
      </contents>
    </failure>
    <default contents="//@elements.1"/>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination" subField="user">
    <addresses is="*" contains="voip" subDomainOf="company.com"/>
    <notPresent>
      <contents xsi:type="CPL:SwitchedAddress" is="10.0.0.1"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SwitchedPriority" less="10"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzurl="http://timezone.example.com">
    <times dtstart="20240101T000000" interval="1" wkst="SU" byDay="MO,WE,FR" byHour="9,17"/>
    <otherwise>
      <contents xsi:type="CPL:Busy"/>
    </otherwise>
  </elements>
</CPL:CPLModel>