<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <subActions id="sub2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100" contains="192.168"/>
        <addresses is="10.0.0.1" subDomainOf="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T000000" dtend="20241231T235959" duration="P1D" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <notPresent>
                  <contents xsi:type="CPL:PrioritySwitch">
                    <priorities less="5" greater="3" equal="4"/>
                    <otherwise>
                      <contents xsi:type="CPL:StringSwitch" field="user-agent">
                        <strings is="Mozilla" contains="Firefox"/>
                        <otherwise>
                          <contents xsi:type="CPL:Location" url="sip:user@backup.example.com" priority="2" clear="yes"/>
                        </otherwise>
                      </contents>
                    </otherwise>
                  </contents>
                </notPresent>
              </contents>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Redirect" permanent="no"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:SubCall" ref="sub2"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Location" url="sip:admin@failover.example.com" priority="1" clear="no"/>
            </failure>
            <default contents="//@elements.0//@subActions.0"/>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="10" clear="yes"/>
        </busy>
        <default contents="//@elements.0//@subActions.1"/>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="sub1"/>
  <elements xsi:type="CPL:SubCall" ref="sub2"/>
  <elements xsi:type="CPL:Location" url="sip:user@primary.example.com" priority="1" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
</CPL:CPLModel>