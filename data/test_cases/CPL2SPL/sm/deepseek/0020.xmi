<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="user">
        <notPresent>
          <contents xsi:type="CPL:Default"/>
        </notPresent>
        <addresses is="192.168.1.*" contains="example.com"/>
        <addresses is="10.*" subDomainOf="internal.net"/>
        <otherwise>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York">
            <times dtstart="20240101T090000" dtend="20250101T170000" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
                <busy/>
                <noAnswer/>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </subActions>
    <incoming>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="5" greater="3"/>
        <priorities equal="10"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
        </notPresent>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="sub1"/>
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings contains="urgent"/>
    <strings is="spam"/>
    <notPresent>
      <contents xsi:type="CPL:Default"/>
    </notPresent>
  </elements>
</CPL:CPLModel>