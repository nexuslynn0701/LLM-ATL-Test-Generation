<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="main">
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:user@domain.com" contains="domain.com" subDomainOf="com"/>
        <addresses is="sip:admin@example.org" contains="example.org"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO" freq="DAILY" byDay="MO,TU,WE,TH,FR"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5" greater="3" equal="4"/>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <otherwise>
                  <contents xsi:type="CPL:StringSwitch" field="subject">
                    <strings is="urgent" contains="urgent"/>
                    <notPresent>
                      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                        <busy>
                          <contents xsi:type="CPL:Redirect" permanent="no"/>
                        </busy>
                        <noAnswer>
                          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
                        </noAnswer>
                        <default>
                          <contents xsi:type="CPL:Location" url="sip:assistant@company.com" priority="2" clear="no"/>
                        </default>
                      </contents>
                    </notPresent>
                  </contents>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </addresses>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:SubCall" ref="main"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SubCall" ref="main"/>
    </incoming>
  </elements>
</CPL:CPLModel>