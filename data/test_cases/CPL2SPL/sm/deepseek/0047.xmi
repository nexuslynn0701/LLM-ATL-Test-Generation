<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <subActions id="sub2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100" contains="192.168" subDomainOf="example.com"/>
        <addresses is="10.0.0.1" subDomainOf="internal.net"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tzurl.org">
            <times dtstart="20240101T000000" dtend="20241231T235959" duration="PT1H" freq="DAILY" until="20241231T000000" count="365" interval="1" bySecond="0" byMinute="0" byHour="0" byDay="MO,TU,WE,TH,FR" byMonthDay="1" byYearDay="1" byWeekNo="1" byMonth="1" wkst="MO" bySetPos="1"/>
            <notPresent>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:primary@example.com" priority="0" clear="no"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5" greater="3" equal="4"/>
            <priorities less="10" equal="10"/>
            <notPresent>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="meeting"/>
        <strings is="spam"/>
        <notPresent>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <languages matches="fr"/>
            <notPresent>
              <contents xsi:type="CPL:SubCall" ref="defaultHandler"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                <busy>
                  <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
                </busy>
                <noAnswer>
                  <contents xsi:type="CPL:Location" url="sip:assistant@example.com" priority="2" clear="no"/>
                </noAnswer>
                <redirection>
                  <contents xsi:type="CPL:Redirect" permanent="true"/>
                </redirection>
                <failure>
                  <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
                </failure>
                <default contents="//@elements.0"/>
              </contents>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="0" clear="no"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="sub1"/>
  <elements xsi:type="CPL:SubCall" ref="sub2"/>
  <elements xsi:type="CPL:Location" url="sip:admin@example.com" priority="5" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" timeout="60" recurse="no" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
    </busy>
    <default contents="//@elements.4"/>
  </elements>
</CPL:CPLModel>