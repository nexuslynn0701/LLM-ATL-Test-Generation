<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="main"/>
    <subActions id="backup"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100" contains="192.168" subDomainOf="example.com"/>
        <addresses is="10.0.0.1" contains="10.0" subDomainOf="internal.net"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tzurl.org">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" bySecond="0" byMinute="0" byHour="9" byDay="MO,TU,WE,TH,FR" byMonthDay="" byYearDay="" byWeekNo="" byMonth="1" wkst="MO" bySetPos=""/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Redirect" permanent="no"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:SubCall" ref="backup"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="2" clear="no"/>
            </failure>
            <default>
              <contents xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <languages matches="de"/>
        <notPresent>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="3" greater="1" equal="2"/>
            <otherwise>
              <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="display-name">
            <strings is="VIP" contains="VIP"/>
            <strings is="Manager" contains="Manager"/>
            <otherwise>
              <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
                <default>
                  <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="yes"/>
                </default>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="main"/>
  <elements xsi:type="CPL:Location" url="sip:admin@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="1" clear="no"/>
    </busy>
    <default>
      <contents xsi:type="CPL:Location" url="sip:final@example.com" priority="1" clear="yes"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="sip:test@domain.com" contains="domain.com" subDomainOf="domain.com"/>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="main"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="UTC">
    <times dtstart="20240101T000000" dtend="20241231T235959" duration="PT8760H" freq="YEARLY" interval="1" byMonth="1" wkst="MO" bySetPos=""/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="3" equal="4"/>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="no"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="user-agent">
    <strings is="Cisco" contains="Cisco"/>
    <strings is="Polycom" contains="Polycom"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:unknown@example.com" priority="1" clear="yes"/>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="es"/>
    <languages matches="pt"/>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
        <default>
          <contents xsi:type="CPL:Location" url="sip:international@example.com" priority="1" clear="yes"/>
        </default>
      </contents>
    </otherwise>
  </elements>
</CPL:CPLModel>