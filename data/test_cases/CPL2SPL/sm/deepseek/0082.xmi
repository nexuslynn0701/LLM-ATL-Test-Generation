<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1">
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </subActions>
    <subActions id="sub2">
      <contents xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="no"/>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="user">
        <addresses is="sip:alice@example.com" contains="alice" subDomainOf="example.com"/>
        <addresses is="sip:bob@example.com" contains="bob"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="480" reason="Not available"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
        <times dtstart="20250101T090000" dtend="20250101T170000" duration="PT8H" freq="DAILY" until="20251231T235959" count="365" interval="1" wkst="MO" byDay="MO,TU,WE,TH,FR"/>
        <times dtstart="20250101T000000" dtend="20250101T080000" duration="PT8H" freq="DAILY" interval="1" wkst="MO"/>
        <notPresent>
          <contents xsi:type="CPL:Default"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Reject" status="410" reason="Gone"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:SubCall" ref="sub2"/>
            </failure>
            <default>
              <contents xsi:type="CPL:Location" url="sip:assistant@example.com" priority="2" clear="no"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent" contains="urgent"/>
    <strings is="private" contains="confidential"/>
    <notPresent>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="603" reason="Decline"/>
        </otherwise>
      </contents>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="3" greater="7" equal="5"/>
        <priorities less="1" equal="2"/>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </otherwise>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="3" clear="yes"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </busy>
    <default contents="//@elements.3"/>
  </elements>
</CPL:CPLModel>