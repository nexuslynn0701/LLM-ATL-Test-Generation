<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="main">
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100" contains="192.168.1"/>
        <addresses is="10.0.0.1" subDomainOf="10.0.0.0/8"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:backup@voip.com" priority="1" clear="no"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tzurl.org">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="WEEKLY" until="20241231T235959" count="52" interval="1" byDay="MO,TU,WE,TH,FR" wkst="MO"/>
            <notPresent>
              <contents xsi:type="CPL:Redirect" permanent="no"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                <busy>
                  <contents xsi:type="CPL:Reject" status="486" reason="Busy here"/>
                </busy>
                <noAnswer>
                  <contents xsi:type="CPL:SubCall" ref="voicemail"/>
                </noAnswer>
              </Proxy>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="destination">
        <strings is="+1234567890" contains="1234"/>
        <strings is="+0987654321" contains="0987"/>
        <notPresent>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="10" greater="50" equal="25"/>
            <notPresent>
              <contents xsi:type="CPL:Location" url="sip:default@company.com" priority="1" clear="yes"/>
            </notPresent>
          </contents>
        </notPresent>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="yes"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="voicemail"/>
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
</CPL:CPLModel>