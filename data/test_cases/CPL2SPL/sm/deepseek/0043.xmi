<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="main"/>
    <subActions id="backup"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com" contains="alice"/>
        <addresses is="sip:bob@example.com" subDomainOf="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tzurl.org">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" bySecond="0" byMinute="0" byHour="9" byDay="MO,TU,WE,TH,FR" byMonthDay="1" byYearDay="1" byWeekNo="1" byMonth="1" wkst="MO" bySetPos="1"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="3" greater="5" equal="4"/>
            <priorities less="1" equal="2"/>
            <notPresent>
              <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                <busy>
                  <contents xsi:type="CPL:Redirect" permanent="no"/>
                </busy>
                <noAnswer>
                  <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
                </noAnswer>
                <default>
                  <contents xsi:type="CPL:SubCall" ref="backup"/>
                </default>
              </contents>
            </notPresent>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="emergency"/>
        <strings is="meeting"/>
        <notPresent>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <languages matches="fr"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="0" clear="no"/>
            </otherwise>
          </contents>
        </notPresent>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="main"/>
  <elements xsi:type="CPL:Location" url="sip:operator@example.com" priority="10" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <failure>
      <contents xsi:type="CPL:Location" url="sip:failover@example.com" priority="5" clear="yes"/>
    </failure>
    <redirection>
      <contents xsi:type="CPL:SubCall" ref="main"/>
    </redirection>
  </elements>
</CPL:CPLModel>