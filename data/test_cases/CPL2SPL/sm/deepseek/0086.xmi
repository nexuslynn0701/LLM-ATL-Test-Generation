<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York">
        <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" interval="1" wkst="MO"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="3" greater="5" equal="4"/>
            <notPresent/>
            <otherwise/>
          </contents>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="from">
        <strings is="alice" contains="bob"/>
        <notPresent/>
        <otherwise/>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en-US"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
            <addresses is="sip.example.com" contains="sip" subDomainOf="example.com"/>
            <notPresent/>
            <otherwise/>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:SubCall" ref="mainAction"/>
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default contents="//@elements.1"/>
  </elements>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
</CPL:CPLModel>