<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainFlow"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.100" contains="office" subDomainOf="example.com"/>
        <addresses is="10.0.0.1" contains="vpn"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezones.example.com/ny">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" bySecond="0" byMinute="0" byHour="9" byDay="MO,TU,WE,TH,FR" byMonthDay="1" byYearDay="1" byWeekNo="1" byMonth="1" wkst="MO" bySetPos="1"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:backup@voicemail.example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5" greater="3" equal="4"/>
            <priorities less="10" equal="10"/>
            <notPresent>
              <contents xsi:type="CPL:Redirect" permanent="no"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="display-name">
        <strings is="VIP" contains="Gold"/>
        <strings is="Support" contains="Tech"/>
        <notPresent>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en-US"/>
            <languages matches="fr-FR"/>
            <otherwise>
              <contents xsi:type="CPL:SubCall" ref="internationalHandler"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:busy@voicemail.example.com" priority="2" clear="no"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Location" url="sip:noanswer@voicemail.example.com" priority="3" clear="yes"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Redirect" permanent="yes"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
            </failure>
            <default contents="//@elements.2"/>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="internationalHandler"/>
  <elements xsi:type="CPL:Location" url="sip:default@main.example.com" priority="0" clear="yes"/>
</CPL:CPLModel>