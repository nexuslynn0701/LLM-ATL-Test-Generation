<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <subActions id="sub2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100" contains="192.168" subDomainOf="example.com"/>
        <addresses is="10.0.0.1" contains="10.0" subDomainOf="internal.net"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" bySecond="0" byMinute="0" byHour="9" byDay="MO,TU,WE,TH,FR" byMonthDay="1" byYearDay="1" byWeekNo="1" byMonth="1" wkst="MO" bySetPos="1"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:backup@voip.example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="CiscoPhone" contains="Cisco"/>
            <strings is="PolycomVVX" contains="Polycom"/>
            <notPresent>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="3" equal="4"/>
                <priorities less="10" greater="8" equal="9"/>
                <otherwise>
                  <contents xsi:type="CPL:LanguageSwitch">
                    <languages matches="en"/>
                    <languages matches="fr"/>
                    <otherwise>
                      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                        <busy>
                          <contents xsi:type="CPL:Redirect" permanent="no"/>
                        </busy>
                        <noAnswer>
                          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
                        </noAnswer>
                        <redirection>
                          <contents xsi:type="CPL:SubCall" ref="redirectHandler"/>
                        </redirection>
                        <failure>
                          <contents xsi:type="CPL:Location" url="sip:failover@backup.com" priority="2" clear="no"/>
                        </failure>
                        <default>
                          <contents xsi:type="CPL:Location" url="sip:default@main.com" priority="1" clear="yes"/>
                        </default>
                      </contents>
                    </otherwise>
                  </contents>
                </otherwise>
              </contents>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:SubCall" ref="genericHandler"/>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="Europe/London">
        <times dtstart="20240101T080000" dtend="20240101T180000" duration="PT10H" interval="1" wkst="MO"/>
        <times dtstart="20240101T000000" dtend="20240101T235959" duration="PT24H" interval="1" wkst="MO"/>
        <notPresent>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
            <default>
              <contents xsi:type="CPL:Location" url="sip:nightshift@company.com" priority="1" clear="yes"/>
            </default>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:dayshift@company.com" priority="1" clear="yes"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="redirectHandler"/>
  <elements xsi:type="CPL:SubCall" ref="genericHandler"/>
  <elements xsi:type="CPL:Location" url="sip:nightshift@company.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:dayshift@company.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:backup@voip.example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:failover@backup.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Location" url="sip:default@main.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="no"/>
  <elements xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel"/>
  <elements xsi:type="CPL:AddressSwitch" field="origin"/>
  <elements xsi:type="CPL:StringSwitch" field="user-agent"/>
  <elements xsi:type="CPL:PrioritySwitch"/>
  <elements xsi:type="CPL:LanguageSwitch"/>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com"/>
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/London"/>
</CPL:CPLModel>