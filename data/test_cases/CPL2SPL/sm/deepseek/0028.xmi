<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="main">
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com" contains="example.com"/>
        <addresses is="sip:bob@example.org" subDomainOf="example.org"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
            <times dtstart="20240102T090000" duration="PT8H" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5" greater="3" equal="4"/>
            <priorities less="10" equal="10"/>
            <notPresent>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </notPresent>
          </contents>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Location" url="sip:assistant@example.com" priority="2" clear="no"/>
            </noAnswer>
            <default>
              <contents xsi:type="CPL:SubCall" ref="main"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="meeting"/>
        <strings contains="project"/>
        <notPresent>
          <contents xsi:type="CPL:Failure">
            <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
          </contents>
        </notPresent>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="main"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="0" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
</CPL:CPLModel>