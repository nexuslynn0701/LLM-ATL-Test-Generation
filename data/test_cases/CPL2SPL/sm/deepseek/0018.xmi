<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="main">
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100"/>
        <addresses contains="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <languages matches="fr"/>
            <notPresent>
              <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tz.com">
                <times dtstart="20240101T000000" dtend="20241231T235959" duration="PT1H" interval="1" wkst="MO"/>
                <times dtstart="20230101T000000" interval="1" wkst="SU"/>
                <notPresent>
                  <contents xsi:type="CPL:PrioritySwitch">
                    <priorities less="5"/>
                    <priorities greater="10" equal="7"/>
                    <otherwise>
                      <contents xsi:type="CPL:StringSwitch" field="user-agent">
                        <strings is="Mozilla"/>
                        <strings contains="Chrome"/>
                        <otherwise>
                          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                            <busy>
                              <contents xsi:type="CPL:Redirect" permanent="false"/>
                            </busy>
                            <noAnswer>
                              <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
                            </noAnswer>
                            <redirection>
                              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
                            </redirection>
                            <failure>
                              <contents xsi:type="CPL:SubCall" ref="emergency"/>
                            </failure>
                            <default>
                              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="2" clear="no"/>
                            </default>
                          </contents>
                        </otherwise>
                      </contents>
                    </otherwise>
                  </contents>
                </notPresent>
              </contents>
            </notPresent>
          </contents>
        </notPresent>
      </addresses>
    </subActions>
    <subActions id="emergency">
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel"/>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:SubCall" ref="main"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="0" clear="yes"/>
    </incoming>
  </elements>
</CPL:CPLModel>