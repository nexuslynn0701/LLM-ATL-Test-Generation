<?xml version="1.0" encoding="ISO-8859-1"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100" contains="office" subDomainOf="example.com"/>
        <addresses is="10.0.0.1"/>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="PolycomSoundpoint" contains="Polycom"/>
            <strings contains="Cisco"/>
            <notPresent/>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:default@voip.example.com" priority="1" clear="yes"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubAction" id="subRouting">
    <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tz.example.com/ny">
      <times dtstart="20240101T090000" dtend="20241231T170000" duration="PT8H" freq="WEEKLY" until="20241231T235959" count="48" interval="1" wkst="MO"/>
      <times dtstart="20240101T000000" interval="1" wkst="SU"/>
    </contents>
  </elements>
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Redirect" permanent="no"/>
    </noAnswer>
    <failure>
      <contents xsi:type="CPL:SubCall" ref="fallbackAction"/>
    </failure>
    <default contents="//@elements.2"/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="3" greater="8" equal="5"/>
    <priorities less="1"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:operator@backup.com" priority="10" clear="no"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:default@main.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:reception@company.com" priority="5" clear="yes"/>
</CPL:CPLModel>