<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainFlow"/>
    <subActions id="backupFlow"/>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.*" contains="true" subDomainOf="false"/>
        <otherwise>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <notPresent>
                  <contents xsi:type="CPL:PrioritySwitch">
                    <priorities less="3" greater="5" equal="4"/>
                    <otherwise>
                      <contents xsi:type="CPL:StringSwitch" field="user-agent">
                        <strings is="Mozilla" contains="true"/>
                        <notPresent>
                          <contents xsi:type="CPL:SubCall" ref="backupFlow"/>
                        </notPresent>
                      </contents>
                    </otherwise>
                  </contents>
                </notPresent>
              </contents>
            </otherwise>
            <notPresent>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </notPresent>
          </contents>
        </otherwise>
        <notPresent>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
            <busy/>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default contents="//@elements.1"/>
          </contents>
        </notPresent>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes"/>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="mainFlow"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Location" url="sip:backup@domain.com" priority="2" clear="yes"/>
</CPL:CPLModel>