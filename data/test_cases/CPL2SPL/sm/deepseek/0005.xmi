<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100" contains="192.168.1"/>
        <addresses subDomainOf="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezones.example.com/ny">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <languages matches="fr"/>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="3" greater="7" equal="5"/>
                <notPresent>
                  <contents xsi:type="CPL:SubCall" ref="backupHandler"/>
                </notPresent>
                <otherwise>
                  <contents xsi:type="CPL:StringSwitch" field="subject">
                    <strings is="urgent" contains="emergency"/>
                    <otherwise>
                      <contents xsi:type="CPL:Location" url="sip:user@voicemail.example.com" priority="1" clear="false"/>
                    </otherwise>
                  </contents>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </subActions>
    <incoming/>
    <outgoing/>
  </elements>
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:SubCall" ref="redirectHandler"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Location" url="sip:failover@backup.example.com" priority="2" clear="true"/>
    </failure>
    <default contents="//@elements.2"/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="emergencyProcedure"/>
  <elements xsi:type="CPL:Location" url="sip:reception@company.com" priority="10" clear="false"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
</CPL:CPLModel>