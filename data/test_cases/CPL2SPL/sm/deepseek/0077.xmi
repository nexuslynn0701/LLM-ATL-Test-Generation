<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="subMain"/>
    <outgoing>
      <contents xsi:type="CPL:Location" url="sip:reception@company.com" priority="1" clear="yes"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:boss@company.com" contains="boss"/>
        <addresses is="sip:client@external.com" subDomainOf="external.com"/>
        <notPresent>
          <contents xsi:type="CPL:StringSwitch" field="subject">
            <strings is="urgent" contains="urgent"/>
            <strings is="meeting" contains="meeting"/>
            <otherwise>
              <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
                <busy>
                  <contents xsi:type="CPL:Location" url="sip:voicemail@company.com" priority="1" clear="no"/>
                </busy>
                <default>
                  <contents xsi:type="CPL:Location" url="sip:operator@company.com" priority="2" clear="no"/>
                </default>
              </contents>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <languages matches="fr"/>
            <otherwise>
              <contents xsi:type="CPL:Redirect" permanent="no"/>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York">
    <times dtstart="20240101T090000" interval="1" wkst="MO" duration="PT8H" freq="DAILY" until="20241231T170000"/>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="3"/>
    <priorities greater="5"/>
    <priorities equal="4"/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:backup@company.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="subMain"/>
  <elements xsi:type="CPL:Proxy" timeout="PT30S" recurse="yes" ordering="parallel">
    <noAnswer>
      <contents xsi:type="CPL:Redirect" permanent="yes"/>
    </noAnswer>
    <failure>
      <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
    </failure>
  </elements>
</CPL:CPLModel>