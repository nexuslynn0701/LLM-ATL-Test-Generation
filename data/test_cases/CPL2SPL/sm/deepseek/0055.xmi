<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="main"/>
    <subActions id="backup"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com" contains="alice"/>
        <addresses is="sip:bob@example.com" subDomainOf="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5" greater="3" equal="4"/>
            <notPresent>
              <contents xsi:type="CPL:SubCall" ref="backup"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <otherwise>
                  <contents xsi:type="CPL:StringSwitch" field="subject">
                    <strings is="urgent" contains="meeting"/>
                    <strings is="spam" contains="viagra"/>
                    <notPresent>
                      <contents xsi:type="CPL:Redirect" permanent="false"/>
                    </notPresent>
                    <otherwise>
                      <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
                    </otherwise>
                  </contents>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="1" clear="no"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Location" url="sip:noanswer@example.com" priority="2" clear="yes"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Location" url="sip:redirected@example.com" priority="3" clear="no"/>
        </redirection>
        <failure>
          <contents xsi:type="CPL:Location" url="sip:failure@example.com" priority="4" clear="yes"/>
        </failure>
        <default contents="//@elements.0"/>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="main"/>
  <elements xsi:type="CPL:Location" url="sip:default@example.com" priority="0" clear="yes"/>
</CPL:CPLModel>