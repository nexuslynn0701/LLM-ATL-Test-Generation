<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <subActions id="main"/>
    <subActions id="backup"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com" contains="alice"/>
        <addresses is="sip:bob@example.com" contains="bob"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:default@voicemail.com" clear="yes" priority="1"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
            <times dtstart="20240102T090000" dtend="20240102T170000" interval="1" wkst="TU"/>
            <notPresent>
              <contents xsi:type="CPL:SubCall" ref="backup"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential" timeout="30">
                <busy>
                  <contents xsi:type="CPL:Redirect" permanent="no"/>
                </busy>
                <noAnswer>
                  <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
                </noAnswer>
                <default>
                  <contents xsi:type="CPL:Location" url="sip:assistant@office.com" clear="no" priority="2"/>
                </default>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <notPresent>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5"/>
            <priorities greater="8"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:info@company.com" clear="yes" priority="3"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="subject">
            <strings contains="urgent"/>
            <strings contains="meeting"/>
            <otherwise>
              <contents xsi:type="CPL:SubCall" ref="main"/>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="main"/>
  <elements xsi:type="CPL:SubCall" ref="backup"/>
  <elements xsi:type="CPL:Location" url="sip:emergency@backup.com" clear="yes" priority="10"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel" timeout="60">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="yes" priority="1"/>
    </busy>
    <failure>
      <contents xsi:type="CPL:Reject" status="500" reason="Server Error"/>
    </failure>
    <default contents="//@elements.4"/>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses subDomainOf="example.com"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:operator@company.com" clear="yes" priority="5"/>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:TimeSwitch">
    <times dtstart="20240101T000000" interval="1" wkst="SU" freq="DAILY" count="365"/>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="backup"/>
    </otherwise>
  </elements>
</CPL:CPLModel>