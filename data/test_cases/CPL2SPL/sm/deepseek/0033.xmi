<?xml version="1.0" encoding="ASCII"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="main"/>
    <subActions id="backup"/>
    <outgoing>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="no"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities equal="5"/>
        <notPresent>
          <contents xsi:type="CPL:SubCall" ref="backup"/>
        </notPresent>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="origin" subField="host">
    <addresses is="192.168.1.1" contains=".example.com"/>
    <addresses subDomainOf="test.org"/>
    <notPresent>
      <contents xsi:type="CPL:Busy"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:NoAnswer"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="user-agent">
    <strings is="Mozilla" contains="Firefox"/>
    <otherwise>
      <contents xsi:type="CPL:Failure"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://time.example.com">
    <times dtstart="20240101T000000" dtend="20241231T235959" duration="PT1H" freq="DAILY" interval="1" wkst="MO"/>
    <times dtstart="20240601T000000" duration="P30D" freq="WEEKLY" count="4" interval="2" wkst="SU" byDay="MO,WE,FR"/>
    <notPresent>
      <contents xsi:type="CPL:Redirection"/>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Redirection"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Redirect" permanent="yes"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Default"/>
    </failure>
    <default contents="//@elements.1"/>
  </elements>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:SubCall" ref="main"/>
</CPL:CPLModel>