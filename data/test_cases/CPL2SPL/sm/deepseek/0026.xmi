<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.100" contains=".internal"/>
        <addresses contains="10.0.0." subDomainOf="local"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="WEEKLY" until="20241231T235959" count="52" interval="1" wkst="MO" byDay="MO,TU,WE,TH,FR"/>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="3" greater="1"/>
                <otherwise>
                  <contents xsi:type="CPL:LanguageSwitch">
                    <languages matches="en"/>
                    <otherwise>
                      <contents xsi:type="CPL:StringSwitch" field="user-agent">
                        <strings contains="iPhone"/>
                        <otherwise>
                          <contents xsi:type="CPL:Location" url="sip:backup@company.com" priority="2" clear="no"/>
                        </otherwise>
                      </contents>
                    </otherwise>
                  </contents>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
            <busy/>
            <noAnswer/>
            <redirection/>
            <default contents="//@elements.0/@subActions.0"/>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Redirection"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:SubCall" ref="voicemailHandler"/>
  <elements xsi:type="CPL:Location" url="sip:admin@company.com" priority="1" clear="yes"/>
</CPL:CPLModel>