<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="main"/>
    <subActions id="backup"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100"/>
        <addresses contains="example.com"/>
        <addresses subDomainOf="test.org"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="UTC" tzurl="http://timezone.example.com">
            <times dtstart="20240101T000000" dtend="20241231T235959" duration="P1D" freq="DAILY" until="20241231T235959" count="365" interval="1" bySecond="0" byMinute="0" byHour="12" byDay="MO,TU,WE,TH,FR" byMonthDay="1" byYearDay="1" byWeekNo="1" byMonth="1" wkst="MO" bySetPos="1"/>
            <notPresent>
              <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                <busy>
                  <contents xsi:type="CPL:Redirect" permanent="no"/>
                </busy>
                <noAnswer>
                  <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
                </noAnswer>
                <default>
                  <contents xsi:type="CPL:Location" url="sip:user@backup.example.com" priority="1" clear="yes"/>
                </default>
              </contents>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:SubCall" ref="backup"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <languages matches="fr"/>
            <notPresent>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="3" equal="4"/>
                <notPresent>
                  <contents xsi:type="CPL:StringSwitch" field="user-agent">
                    <strings is="Mozilla"/>
                    <strings contains="Chrome"/>
                    <notPresent>
                      <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
                        <failure>
                          <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
                        </failure>
                        <redirection>
                          <contents xsi:type="CPL:Redirect" permanent="yes"/>
                        </redirection>
                      </contents>
                    </notPresent>
                    <otherwise>
                      <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="10" clear="no"/>
                    </otherwise>
                  </strings>
                </notPresent>
                <otherwise>
                  <contents xsi:type="CPL:SubCall" ref="main"/>
                </otherwise>
              </priorities>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:international@example.com" priority="5" clear="yes"/>
            </otherwise>
          </languages>
        </otherwise>
      </addresses>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SwitchedAddress" is="10.0.0.1"/>
      <contents xsi:type="CPL:SwitchedString" contains="sip"/>
      <contents xsi:type="CPL:SwitchedLanguage" matches="de"/>
      <contents xsi:type="CPL:SwitchedTime" dtstart="20240101T000000" interval="1" wkst="MO"/>
      <contents xsi:type="CPL:SwitchedPriority" less="100" greater="50" equal="75"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="no"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
</CPL:CPLModel>