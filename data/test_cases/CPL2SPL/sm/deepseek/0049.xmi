<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="main"/>
    <subActions id="backup"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100" contains="192.168"/>
        <addresses is="10.0.0.1" subDomainOf="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tz.example.com">
            <times dtstart="20240101T000000" dtend="20241231T235959" duration="P1D" freq="DAILY" until="20241231T000000" count="365" interval="1" bySecond="0" byMinute="0" byHour="12" byDay="MO,TU,WE,TH,FR" byMonthDay="1" byYearDay="1" byWeekNo="1" byMonth="1" wkst="MO" bySetPos="1"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <languages matches="fr"/>
            <notPresent>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="3" equal="4"/>
                <otherwise>
                  <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                    <busy>
                      <contents xsi:type="CPL:Redirect" permanent="no"/>
                    </busy>
                    <noAnswer>
                      <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
                    </noAnswer>
                    <default>
                      <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="2" clear="no"/>
                    </default>
                  </contents>
                </otherwise>
              </contents>
            </notPresent>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="emergency"/>
        <strings is="meeting"/>
        <notPresent>
          <contents xsi:type="CPL:SubCall" ref="backup"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
            <redirection>
              <contents xsi:type="CPL:Location" url="sip:redirect@example.com" priority="1" clear="yes"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
            </failure>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="main"/>
  <elements xsi:type="CPL:Location" url="sip:default@example.com" priority="0" clear="yes"/>
</CPL:CPLModel>