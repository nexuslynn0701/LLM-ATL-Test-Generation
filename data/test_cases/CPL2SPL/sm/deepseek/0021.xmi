<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1"/>
    <subActions id="sub2"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100" contains="192.168" subDomainOf="example.com"/>
        <addresses is="10.0.0.1" contains="10.0" subDomainOf="internal.net"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="3" equal="4"/>
                <priorities less="10" greater="8" equal="9"/>
                <otherwise>
                  <contents xsi:type="CPL:Location" url="sip:user@backup.example.com" priority="2" clear="yes"/>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="Mozilla" contains="Firefox"/>
            <strings is="Chrome" contains="Google"/>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <otherwise>
                  <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                    <busy>
                      <contents xsi:type="CPL:Redirect" permanent="no"/>
                    </busy>
                    <noAnswer>
                      <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
                    </noAnswer>
                    <redirection>
                      <contents xsi:type="CPL:SubCall" ref="sub2"/>
                    </redirection>
                    <failure>
                      <contents xsi:type="CPL:Location" url="sip:admin@example.com" priority="1" clear="yes"/>
                    </failure>
                    <default>
                      <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="3" clear="no"/>
                    </default>
                  </contents>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="emergencyHandler"/>
  <elements xsi:type="CPL:Location" url="sip:default@example.com" priority="5" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Proxy" timeout="60" recurse="no" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="1" clear="yes"/>
    </busy>
    <default>
      <contents xsi:type="CPL:SubCall" ref="emergencyHandler"/>
    </default>
  </elements>
</CPL:CPLModel>