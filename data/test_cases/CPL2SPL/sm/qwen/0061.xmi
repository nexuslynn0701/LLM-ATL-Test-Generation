<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainSub">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="user">
        <addresses is="alice@example.com" contains="example" subDomainOf="com"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="30">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="yes" priority="normal"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </noAnswer>
            <default contents="//@elements.1"/>
          </otherwise>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="Meeting" contains="Urgent"/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="fallbackAction"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" clear="no" priority="low"/>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <otherwise>
      <contents xsi:type="CPL:Failure">
        <contents xsi:type="CPL:Reject" status="415" reason="Unsupported Language"/>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="1" equal="3"/>
    <notPresent>
      <contents xsi:type="CPL:Default">
        <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
          <redirection>
            <contents xsi:type="CPL:Location" url="sip:redirect@example.com" clear="yes" priority="high"/>
          </redirection>
          <failure contents="//@elements.3"/>
        </contents>
      </notPresent>
    </notPresent>
  </elements>
</CPL:CPLModel>