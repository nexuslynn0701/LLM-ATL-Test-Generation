<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="user">
        <addresses is="alice@example.com"/>
        <addresses contains="bob"/>
        <addresses subDomainOf="example.net"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="30">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="yes" priority="normal"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </noAnswer>
            <redirection/>
            <failure/>
            <default contents="//@elements.1"/>
          </otherwise>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="Meeting"/>
        <strings contains="Urgent"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="fallbackAction"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tz.example.com/ny">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="603" reason="Decline"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5" greater="1" equal="3"/>
            <notPresent>
              <contents xsi:type="CPL:Location" url="sip:lowprio@example.com" clear="no" priority="low"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
                <default contents="//@elements.2"/>
              </otherwise>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:default@example.com" clear="yes" priority="high"/>
  <elements xsi:type="CPL:SubCall" ref="fallbackAction"/>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="415" reason="Unsupported Language"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </otherwise>
  </elements>
</CPL:CPLModel>