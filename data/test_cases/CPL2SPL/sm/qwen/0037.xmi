<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainSub">
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="user@example.com" contains="example" subDomainOf="com"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="serial" timeout="30">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:busy@example.com" clear="yes" priority="medium"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </noAnswer>
            <default contents="//@elements.1"/>
          </Proxy>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="meeting" contains="urgent"/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="fallbackAction"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York">
        <times dtstart="20240101T090000" interval="1" wkst="MO" byHour="9,17"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </notPresent>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:default@example.com" clear="no" priority="low"/>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="406" reason="Not Acceptable"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="1" equal="3"/>
    <notPresent>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <failure>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </failure>
        <default contents="//@elements.1"/>
      </Proxy>
    </notPresent>
  </elements>
</CPL:CPLModel>