<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="alice@example.com"/>
        <addresses contains="bob"/>
        <addresses subDomainOf="example.org"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="30">
            <busy/>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default contents="//@elements.1"/>
          </default>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="Meeting"/>
        <strings contains="Urgent"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tz.example.com">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:backup@example.com" clear="yes" priority="medium"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="fallbackAction"/>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5"/>
    <priorities greater="8"/>
    <priorities equal="7"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:default@example.com" clear="no" priority="low"/>
    </otherwise>
  </elements>
</CPL:CPLModel>