<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
              xmlns:xmi="http://www.omg.org/XMI"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL with nested SubActions and routing -->
  <elements xsi:type="CPL:CPL">
    <subActions>
      <id>subA</id>
      <!-- SubAction A contents: Location (1) and AddressSwitch (4) -->
      <contents>//@elements.1</contents>
      <contents>//@elements.4</contents>
    </subActions>
    <subActions>
      <id>subB</id>
      <!-- SubAction B contents: Proxy (3) and TimeSwitch (6) -->
      <contents>//@elements.3</contents>
      <contents>//@elements.6</contents>
    </subActions>
    <!-- Outgoing container with a LanguageSwitch (7) and PrioritySwitch (8) -->
    <outgoing>
      <contents>//@elements.7</contents>
      <contents>//@elements.8</contents>
    </outgoing>
    <!-- Incoming container with a StringSwitch (5) -->
    <incoming>
      <contents>//@elements.5</contents>
    </incoming>
  </elements>

  <!-- 1: Location node, referenced by SubAction A and Proxy default -->
  <elements xsi:type="CPL:Location" url="sip:alice@example.com" clear="yes" priority="1">
    <!-- Location contents: SubCall (2) -->
    <contents>//@elements.2</contents>
  </elements>

  <!-- 2: SubCall ref to SubAction B (name only, not object ref) -->
  <elements xsi:type="CPL:SubCall" ref="subB"/>

  <!-- 3: Proxy with all continuation branches and inner Location (9) -->
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential" timeout="30">
    <busy>
      <!-- Busy branch leads to Redirect (10) -->
      <contents>//@elements.10</contents>
    </busy>
    <noAnswer>
      <!-- NoAnswer branch leads to Reject (11) -->
      <contents>//@elements.11</contents>
    </noAnswer>
    <redirection>
      <!-- Redirection branch leads back to Location (1) -->
      <contents>//@elements.1</contents>
    </redirection>
    <failure>
      <!-- Failure branch leads to LanguageSwitch (7) -->
      <contents>//@elements.7</contents>
    </failure>
    <default>
      <!-- Default branch leads to nested Location (9) -->
      <contents>//@elements.9</contents>
    </default>
  </elements>

  <!-- 4: AddressSwitch with NotPresent, Otherwise, and two SwitchedAddress cases -->
  <elements xsi:type="CPL:AddressSwitch" field="to" subField="user">
    <notPresent>
      <!-- If address field not present, go to proxy (3) -->
      <contents>//@elements.3</contents>
    </notPresent>
    <otherwise>
      <!-- Otherwise fall back to Location (1) -->
      <contents>//@elements.1</contents>
    </otherwise>
    <addresses is="bob" contains="example.com" subDomainOf="example.com">
      <!-- Case bob@example.com -> SubCall (2) -->
      <contents>//@elements.2</contents>
    </addresses>
    <addresses is="support" contains="helpdesk" subDomainOf="support.example.com">
      <!-- Case support address -> PrioritySwitch (8) -->
      <contents>//@elements.8</contents>
    </addresses>
  </elements>

  <!-- 5: StringSwitch on subject with NotPresent, Otherwise, and SwitchedString -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <notPresent>
      <!-- No subject -> Reject (11) -->
      <contents>//@elements.11</contents>
    </notPresent>
    <otherwise>
      <!-- Otherwise -> Location (1) -->
      <contents>//@elements.1</contents>
    </otherwise>
    <strings is="[TEST]" contains="test-flag">
      <!-- Test flag in subject -> Redirect (10) -->
      <contents>//@elements.10</contents>
    </strings>
  </elements>

  <!-- 6: TimeSwitch with two SwitchedTime cases -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
    <notPresent>
      <!-- If no time info -> LanguageSwitch (7) -->
      <contents>//@elements.7</contents>
    </notPresent>
    <otherwise>
      <!-- Otherwise -> Location (1) -->
      <contents>//@elements.1</contents>
    </otherwise>
    <times dtstart="20260101T080000" interval="1" wkst="MO" freq="DAILY" byHour="8" byMinute="0">
      <!-- Morning hours -> Location (1) -->
      <contents>//@elements.1</contents>
    </times>
    <times dtstart="20260101T180000" dtend="20260101T235959" interval="1" wkst="MO" freq="DAILY" byHour="18" byMinute="0">
      <!-- Evening hours -> Proxy (3) -->
      <contents>//@elements.3</contents>
    </times>
  </elements>

  <!-- 7: LanguageSwitch with two SwitchedLanguage cases -->
  <elements xsi:type="CPL:LanguageSwitch">
    <notPresent>
      <!-- No language -> Default Location (1) -->
      <contents>//@elements.1</contents>
    </notPresent>
    <otherwise>
      <!-- Any other language -> Reject (11) -->
      <contents>//@elements.11</contents>
    </otherwise>
    <languages matches="en">
      <!-- English -> Location (1) -->
      <contents>//@elements.1</contents>
    </languages>
    <languages matches="fr">
      <!-- French -> SubCall (2) -->
      <contents>//@elements.2</contents>
    </languages>
  </elements>

  <!-- 8: PrioritySwitch with SwitchedPriority cases -->
  <elements xsi:type="CPL:PrioritySwitch">
    <notPresent>
      <!-- No priority -> Location (9) -->
      <contents>//@elements.9</contents>
    </notPresent>
    <otherwise>
      <!-- Otherwise -> Proxy (3) -->
      <contents>//@elements.3</contents>
    </otherwise>
    <priorities less="0.3" equal="0.5" greater="0.7">
      <!-- Priorities mapped to different continuations -->
      <contents>//@elements.1</contents>
      <contents>//@elements.2</contents>
      <contents>//@elements.10</contents>
    </priorities>
  </elements>

  <!-- 9: Secondary Location used in Proxy default and PrioritySwitch -->
  <elements xsi:type="CPL:Location" url="sip:backup@example.net" clear="no" priority="0.5">
    <!-- Backup location leads to StringSwitch (5) -->
    <contents>//@elements.5</contents>
  </elements>

  <!-- 10: Redirect action -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 11: Reject action -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>

</CPL:CPLModel>