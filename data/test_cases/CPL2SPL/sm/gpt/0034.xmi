<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL element with subActions, outgoing, incoming -->
  <elements xsi:type="CPL:CPL">
    <subActions xsi:type="CPL:SubAction" id="subA">
      <contents>//@elements.1</contents>
      <contents>//@elements.3</contents>
    </subActions>
    <subActions xsi:type="CPL:SubAction" id="subB">
      <contents>//@elements.4</contents>
      <contents>//@elements.6</contents>
      <contents>//@elements.7</contents>
    </subActions>
    <outgoing>
      <contents>//@elements.2</contents>
      <contents>//@elements.5</contents>
    </outgoing>
    <incoming>
      <contents>//@elements.3</contents>
    </incoming>
  </elements>

  <!-- 1: Location, also used inside SubAction subA -->
  <elements xsi:type="CPL:Location" url="sip:user1@example.com" priority="1" clear="yes">
    <contents>//@elements.8</contents>
  </elements>

  <!-- 2: Redirect in outgoing -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 3: SubCall referenced by CPL.incoming and SubAction subA -->
  <elements xsi:type="CPL:SubCall" ref="handleCallX"/>

  <!-- 4: Proxy with all outcomes and a Location in default -->
  <elements xsi:type="CPL:Proxy" timeout="60" recurse="yes" ordering="sequential">
    <busy>
      <contents>//@elements.1</contents>
    </busy>
    <noAnswer>
      <contents>//@elements.3</contents>
    </noAnswer>
    <redirection>
      <contents>//@elements.2</contents>
    </redirection>
    <failure>
      <contents>//@elements.6</contents>
    </failure>
    <default>
      <contents>//@elements.1</contents>
    </default>
  </elements>

  <!-- 5: Reject used only from model roots (not via contents) -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>

  <!-- 6: AddressSwitch with all variants and nested NotPresent/Otherwise -->
  <elements xsi:type="CPL:AddressSwitch" field="from" subField="user">
    <notPresent>
      <contents>//@elements.5</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.1</contents>
    </otherwise>
    <addresses is="sip:vip@example.com" contains="vip" subDomainOf="example.com">
      <contents>//@elements.1</contents>
      <contents>//@elements.7</contents>
    </addresses>
    <addresses is="sip:blocked@example.com" contains="blk" subDomainOf="blocked.com">
      <contents>//@elements.5</contents>
    </addresses>
  </elements>

  <!-- 7: StringSwitch testing different branch coverage -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <notPresent>
      <contents>//@elements.3</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.2</contents>
    </otherwise>
    <strings is="support" contains="help">
      <contents>//@elements.4</contents>
    </strings>
    <strings is="sales" contains="buy">
      <contents>//@elements.1</contents>
    </strings>
  </elements>

  <!-- 8: TimeSwitch with rich SwitchedTime rule -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
    <notPresent>
      <contents>//@elements.5</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.1</contents>
    </otherwise>
    <times dtstart="20240101T080000" dtend="20240101T180000"
           duration="PT10H" freq="DAILY" until="20241231T235959"
           count="10" interval="1" bySecond="0" byMinute="0"
           byHour="8,9,10" byDay="MO,TU,WE,TH,FR" byMonthDay="1,15"
           byYearDay="100" byWeekNo="1" byMonth="1,2,3" wkst="MO"
           bySetPos="1">
      <contents>//@elements.4</contents>
    </times>
    <times dtstart="20240101T000000" interval="2" wkst="SU">
      <contents>//@elements.2</contents>
    </times>
  </elements>

  <!-- 9: LanguageSwitch with SwitchedLanguage -->
  <elements xsi:type="CPL:LanguageSwitch">
    <notPresent>
      <contents>//@elements.5</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.1</contents>
    </otherwise>
    <languages matches="en">
      <contents>//@elements.4</contents>
    </languages>
    <languages matches="fr">
      <contents>//@elements.7</contents>
    </languages>
  </elements>

  <!-- 10: PrioritySwitch with SwitchedPriority branches -->
  <elements xsi:type="CPL:PrioritySwitch">
    <notPresent>
      <contents>//@elements.3</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.5</contents>
    </otherwise>
    <priorities less="0.3" greater="0.7" equal="0.5">
      <contents>//@elements.1</contents>
      <contents>//@elements.2</contents>
    </priorities>
  </elements>

</CPL:CPLModel>