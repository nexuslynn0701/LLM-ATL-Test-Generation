<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL with incoming/outgoing and subActions -->
  <elements xsi:type="CPL:CPL">
    <subActions xsi:type="CPL:SubAction" id="sa-main">
      <contents>//@elements.2</contents>
      <contents>//@elements.3</contents>
    </subActions>
    <subActions xsi:type="CPL:SubAction" id="sa-alt">
      <contents>//@elements.4</contents>
    </subActions>
    <outgoing>
      <contents>//@elements.5</contents>
      <contents>//@elements.6</contents>
    </outgoing>
    <incoming>
      <contents>//@elements.7</contents>
    </incoming>
  </elements>

  <!-- 1: Location that also contains inner nodes -->
  <elements xsi:type="CPL:Location" url="sip:outer@example.com" priority="1" clear="no">
    <contents>//@elements.8</contents>
    <contents>//@elements.9</contents>
  </elements>

  <!-- 2: AddressSwitch with multiple addresses and handlers -->
  <elements xsi:type="CPL:AddressSwitch" field="from" subField="user">
    <addresses is="alice" contains="domainA" subDomainOf="example.com">
      <contents>//@elements.10</contents>
    </addresses>
    <addresses is="bob" contains="domainB" subDomainOf="example.org">
      <contents>//@elements.11</contents>
    </addresses>
    <notPresent>
      <contents>//@elements.12</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.13</contents>
    </otherwise>
  </elements>

  <!-- 3: StringSwitch -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent" contains="project">
      <contents>//@elements.14</contents>
    </strings>
    <strings is="info" contains="newsletter">
      <contents>//@elements.15</contents>
    </strings>
    <notPresent>
      <contents>//@elements.16</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.17</contents>
    </otherwise>
  </elements>

  <!-- 4: LanguageSwitch -->
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en">
      <contents>//@elements.18</contents>
    </languages>
    <languages matches="fr">
      <contents>//@elements.19</contents>
    </languages>
    <notPresent>
      <contents>//@elements.20</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.21</contents>
    </otherwise>
  </elements>

  <!-- 5: TimeSwitch with rich SwitchedTime -->
  <elements xsi:type="CPL:TimeSwitch" tzid="UTC" tzurl="http://tz.example/utc">
    <times dtstart="20240101T080000Z" dtend="20240101T170000Z" duration="PT9H"
           freq="DAILY" until="20241231T235959Z" count="10" interval="1"
           bySecond="0" byMinute="0" byHour="8" byDay="MO,TU,WE,TH,FR"
           byMonthDay="1,15" byYearDay="10" byWeekNo="1" byMonth="1,6"
           wkst="MO" bySetPos="1">
      <contents>//@elements.22</contents>
    </times>
    <times dtstart="20240101T170000Z" interval="2" wkst="SU">
      <contents>//@elements.23</contents>
    </times>
    <notPresent>
      <contents>//@elements.24</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.25</contents>
    </otherwise>
  </elements>

  <!-- 6: PrioritySwitch -->
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="0.3" greater="0.0" equal="">
      <contents>//@elements.26</contents>
    </priorities>
    <priorities less="" greater="0.7" equal="0.5">
      <contents>//@elements.27</contents>
    </priorities>
    <notPresent>
      <contents>//@elements.28</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.29</contents>
    </otherwise>
  </elements>

  <!-- 7: Proxy with all outcome branches -->
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <busy>
      <contents>//@elements.30</contents>
    </busy>
    <noAnswer>
      <contents>//@elements.31</contents>
    </noAnswer>
    <redirection>
      <contents>//@elements.32</contents>
    </redirection>
    <failure>
      <contents>//@elements.33</contents>
    </failure>
    <default>
      <contents>//@elements.34</contents>
    </default>
  </elements>

  <!-- 8: SubCall referenced from Location contents -->
  <elements xsi:type="CPL:SubCall" ref="sa-main"/>

  <!-- 9: Reject referenced from Location contents -->
  <elements xsi:type="CPL:Reject" status="603" reason="Declined by user"/>

  <!-- 10: Location used inside first SwitchedAddress -->
  <elements xsi:type="CPL:Location" url="sip:alice@example.com" priority="0.5" clear="yes"/>

  <!-- 11: Redirect used inside second SwitchedAddress -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 12: Proxy used in AddressSwitch.notPresent -->
  <elements xsi:type="CPL:Proxy" timeout="10" recurse="no" ordering="parallel">
    <busy>
      <contents>//@elements.35</contents>
    </busy>
    <default>
      <contents>//@elements.36</contents>
    </default>
  </elements>

  <!-- 13: Location used in AddressSwitch.otherwise -->
  <elements xsi:type="CPL:Location" url="sip:fallback@example.net" priority="0.9" clear="yes"/>

  <!-- 14: Redirect used in StringSwitch first string -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

  <!-- 15: Location used in StringSwitch second string -->
  <elements xsi:type="CPL:Location" url="sip:info@example.org" priority="0.2" clear="no"/>

  <!-- 16: SubCall used in StringSwitch.notPresent -->
  <elements xsi:type="CPL:SubCall" ref="sa-alt"/>

  <!-- 17: Reject used in StringSwitch.otherwise -->
  <elements xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>

  <!-- 18: Location for LanguageSwitch 'en' -->
  <elements xsi:type="CPL:Location" url="sip:english@example.com" priority="0.6" clear="yes"/>

  <!-- 19: Location for LanguageSwitch 'fr' -->
  <elements xsi:type="CPL:Location" url="sip:french@example.fr" priority="0.6" clear="yes"/>

  <!-- 20: Reject for LanguageSwitch.notPresent -->
  <elements xsi:type="CPL:Reject" status="488" reason="Language Not Acceptable"/>

  <!-- 21: Redirect for LanguageSwitch.otherwise -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 22: Location for first SwitchedTime -->
  <elements xsi:type="CPL:Location" url="sip:business-hours@example.com" priority="0.4" clear="yes"/>

  <!-- 23: Reject for second SwitchedTime -->
  <elements xsi:type="CPL:Reject" status="486" reason="After Hours Busy"/>

  <!-- 24: Redirect for TimeSwitch.notPresent -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

  <!-- 25: Location for TimeSwitch.otherwise -->
  <elements xsi:type="CPL:Location" url="sip:time-fallback@example.com" priority="0.3" clear="no"/>

  <!-- 26: Location for first SwitchedPriority -->
  <elements xsi:type="CPL:Location" url="sip:low-priority@example.com" priority="0.1" clear="no"/>

  <!-- 27: Location for second SwitchedPriority -->
  <elements xsi:type="CPL:Location" url="sip:high-priority@example.com" priority="0.9" clear="yes"/>

  <!-- 28: Reject for PrioritySwitch.notPresent -->
  <elements xsi:type="CPL:Reject" status="500" reason="Priority Not Set"/>

  <!-- 29: Redirect for PrioritySwitch.otherwise -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

  <!-- 30: Location for Proxy.busy -->
  <elements xsi:type="CPL:Location" url="sip:busy-handler@example.com" priority="0.7" clear="yes"/>

  <!-- 31: SubCall for Proxy.noAnswer -->
  <elements xsi:type="CPL:SubCall" ref="noAnswerFlow"/>

  <!-- 32: Redirect for Proxy.redirection -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 33: Reject for Proxy.failure -->
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>

  <!-- 34: Location for Proxy.default -->
  <elements xsi:type="CPL:Location" url="sip:default-handler@example.com" priority="0.8" clear="yes"/>

  <!-- 35: Location for nested Proxy.busy -->
  <elements xsi:type="CPL:Location" url="sip:nested-busy@example.com" priority="0.5" clear="no"/>

  <!-- 36: Reject for nested Proxy.default -->
  <elements xsi:type="CPL:Reject" status="410" reason="Gone"/>

</CPL:CPLModel>