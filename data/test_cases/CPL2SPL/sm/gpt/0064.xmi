<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL with outgoing/incoming and subActions -->
  <elements xsi:type="CPL:CPL">
    <subActions id="subMain">
      <contents xsi:type="CPL:Location" url="sip:submain@example.com" clear="no" priority="5"/>
      <contents xsi:type="CPL:SubCall" ref="nestedSub"/>
    </subActions>
    <subActions id="subAlt">
      <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
      <contents xsi:type="CPL:SubCall" ref="outHandler"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Location" url="sip:incoming@example.net" clear="yes" priority="1"/>
    </incoming>
  </elements>

  <!-- 1: Location that points (via contents) to another element -->
  <elements xsi:type="CPL:Location" url="sip:main@example.com" clear="yes" priority="10">
    <contents xsi:type="CPL:SubCall" ref="followUpCall"/>
    <contents xsi:type="CPL:Redirect" permanent="false"/>
  </elements>

  <!-- 2: Simple SubCall -->
  <elements xsi:type="CPL:SubCall" ref="handleDefault"/>

  <!-- 3: Redirect with mandatory attribute -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

  <!-- 4: Reject with status and reason -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>

  <!-- 5: Proxy with all outcome branches and contents links -->
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential" timeout="30">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="busyHandler"/>
      <contents xsi:type="CPL:Location" url="sip:voicemail@example.org" clear="no" priority="3"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:SubCall" ref="altRoute"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="500" reason="Server Failure"/>
    </failure>
    <default>
      <contents xsi:type="CPL:Location" url="sip:default@example.com" clear="yes" priority="0"/>
      <contents xsi:type="CPL:SubCall" ref="finalFallback"/>
    </default>
  </elements>

  <!-- 6: AddressSwitch with notPresent, otherwise, and multiple addresses -->
  <elements xsi:type="CPL:AddressSwitch" field="user" subField="host">
    <notPresent>
      <contents xsi:type="CPL:Reject" status="404" reason="Address Missing"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="addressDefault"/>
    </otherwise>
    <addresses is="sip:alice@example.com" contains="alice" subDomainOf="example.com">
      <contents xsi:type="CPL:Location" url="sip:alice@example.com" clear="yes" priority="1"/>
    </addresses>
    <addresses is="sip:bob@example.org" contains="bob" subDomainOf="example.org">
      <contents xsi:type="CPL:Location" url="sip:bob@example.org" clear="no" priority="2"/>
      <contents xsi:type="CPL:SubCall" ref="bobHandler"/>
    </addresses>
  </elements>

  <!-- 7: StringSwitch with strings and otherwise -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <notPresent>
      <contents xsi:type="CPL:SubCall" ref="noSubjectHandler"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </otherwise>
    <strings is="urgent" contains="urgent">
      <contents xsi:type="CPL:Location" url="sip:priority@example.com" clear="yes" priority="9"/>
    </strings>
    <strings is="info" contains="info">
      <contents xsi:type="CPL:SubCall" ref="infoHandler"/>
    </strings>
  </elements>

  <!-- 8: LanguageSwitch with languages but no otherwise -->
  <elements xsi:type="CPL:LanguageSwitch">
    <notPresent>
      <contents xsi:type="CPL:Reject" status="488" reason="Language Not Supported"/>
    </notPresent>
    <languages matches="en">
      <contents xsi:type="CPL:Location" url="sip:english@example.com" clear="yes" priority="4"/>
    </languages>
    <languages matches="fr">
      <contents xsi:type="CPL:Location" url="sip:french@example.fr" clear="no" priority="4"/>
      <contents xsi:type="CPL:SubCall" ref="frenchSupport"/>
    </languages>
  </elements>

  <!-- 9: TimeSwitch with several SwitchedTime entries -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
    <notPresent>
      <contents xsi:type="CPL:SubCall" ref="timeUnknownHandler"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:afterhours@example.com" clear="yes" priority="2"/>
    </otherwise>
    <times dtstart="20260101T080000" dtend="20260101T180000" duration="PT10H"
           freq="DAILY" until="20261231T000000" count="10" interval="1"
           bySecond="0" byMinute="0" byHour="8" byDay="MO,TU,WE,TH,FR"
           byMonthDay="1" byYearDay="1" byWeekNo="1" byMonth="1" wkst="MO"
           bySetPos="1">
      <contents xsi:type="CPL:Location" url="sip:officehours@example.com" clear="no" priority="7"/>
    </times>
    <times dtstart="20260101T180000" interval="1" wkst="MO">
      <contents xsi:type="CPL:Location" url="sip:evening@example.com" clear="yes" priority="6"/>
      <contents xsi:type="CPL:SubCall" ref="eveningHandler"/>
    </times>
  </elements>

  <!-- 10: PrioritySwitch with SwitchedPriority entries -->
  <elements xsi:type="CPL:PrioritySwitch">
    <notPresent>
      <contents xsi:type="CPL:SubCall" ref="priorityMissingHandler"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </otherwise>
    <priorities less="0.5" greater="" equal="">
      <contents xsi:type="CPL:Location" url="sip:lowprio@example.com" clear="yes" priority="1"/>
    </priorities>
    <priorities less="" greater="0.8" equal="">
      <contents xsi:type="CPL:Location" url="sip:highprio@example.com" clear="no" priority="10"/>
      <contents xsi:type="CPL:SubCall" ref="highPriorityHandler"/>
    </priorities>
    <priorities less="" greater="" equal="0.7">
      <contents xsi:type="CPL:Reject" status="603" reason="Decline Equal Priority"/>
    </priorities>
  </elements>

</CPL:CPLModel>