<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:CPL="http://cpl/1.0">

  <!-- 0: main CPL root with all three container kinds -->
  <elements xsi:type="CPL:CPL">
    <subActions>
      <contents>//@elements.2</contents>
      <contents>//@elements.3</contents>
    </subActions>
    <subActions id="subAlpha">
      <contents>//@elements.4</contents>
    </subActions>
    <outgoing>
      <contents>//@elements.1</contents>
      <contents>//@elements.5</contents>
    </outgoing>
    <incoming>
      <contents>//@elements.6</contents>
    </incoming>
  </elements>

  <!-- 1: SubCall referenced via NodeContainer.contents -->
  <elements xsi:type="CPL:SubCall" ref="invokeAlpha"/>

  <!-- 2: Location also referenced from subActions[0] -->
  <elements xsi:type="CPL:Location" url="sip:alpha@example.com" clear="true" priority="10"/>

  <!-- 3: Redirect signalling action -->
  <elements xsi:type="CPL:Redirect" permanent="no"/>

  <!-- 4: Reject signalling action in subAlpha -->
  <elements xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>

  <!-- 5: Proxy with all outcome branches, some branches referencing other top elements -->
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential" timeout="30">
    <busy>
      <contents>//@elements.2</contents>
    </busy>
    <noAnswer>
      <contents>//@elements.3</contents>
    </noAnswer>
    <redirection>
      <contents>//@elements.1</contents>
      <contents>//@elements.4</contents>
    </redirection>
    <failure>
      <contents>//@elements.6</contents>
    </failure>
    <default>
      <contents>//@elements.7</contents>
    </default>
  </elements>

  <!-- 6: AddressSwitch with multiple SwitchedAddress cases and full notPresent/otherwise -->
  <elements xsi:type="CPL:AddressSwitch" field="from" subField="host">
    <notPresent>
      <contents>//@elements.3</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.2</contents>
      <contents>//@elements.5</contents>
    </otherwise>
    <addresses is="sip:vip@example.com" contains="vip" subDomainOf="example.com">
      <contents>//@elements.4</contents>
    </addresses>
    <addresses is="sip:guest@example.org" contains="guest" subDomainOf="example.org">
      <contents>//@elements.1</contents>
      <contents>//@elements.7</contents>
    </addresses>
  </elements>

  <!-- 7: StringSwitch with several SwitchedString children -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <notPresent>
      <contents>//@elements.4</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.2</contents>
    </otherwise>
    <strings is="support" contains="ticket">
      <contents>//@elements.5</contents>
    </strings>
    <strings is="sales" contains="offer">
      <contents>//@elements.1</contents>
      <contents>//@elements.6</contents>
    </strings>
  </elements>

  <!-- 8: LanguageSwitch with multiple languages -->
  <elements xsi:type="CPL:LanguageSwitch">
    <notPresent>
      <contents>//@elements.2</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.3</contents>
      <contents>//@elements.5</contents>
    </otherwise>
    <languages matches="en">
      <contents>//@elements.1</contents>
    </languages>
    <languages matches="fr">
      <contents>//@elements.4</contents>
      <contents>//@elements.7</contents>
    </languages>
  </elements>

  <!-- 9: TimeSwitch with a complex SwitchedTime rule -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
    <notPresent>
      <contents>//@elements.1</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.2</contents>
    </otherwise>
    <times dtstart="20240601T080000" dtend="20240601T180000"
           duration="PT2H" freq="DAILY" until="20241231T235959"
           count="10" interval="1" bySecond="0"
           byMinute="0,30" byHour="9,10,11,14,15"
           byDay="MO,TU,WE,TH,FR" byMonthDay="1,15"
           byYearDay="100,200" byWeekNo="10,20"
           byMonth="6,7,8" wkst="MO" bySetPos="1,-1">
      <contents>//@elements.5</contents>
      <contents>//@elements.6</contents>
    </times>
  </elements>

  <!-- 10: PrioritySwitch with multiple SwitchedPriority cases -->
  <elements xsi:type="CPL:PrioritySwitch">
    <notPresent>
      <contents>//@elements.3</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.2</contents>
    </otherwise>
    <priorities less="0.3" greater="0.0" equal="">
      <contents>//@elements.1</contents>
    </priorities>
    <priorities less="" greater="0.8" equal="">
      <contents>//@elements.4</contents>
      <contents>//@elements.5</contents>
    </priorities>
    <priorities less="" greater="" equal="0.5">
      <contents>//@elements.6</contents>
      <contents>//@elements.7</contents>
    </priorities>
  </elements>

</CPL:CPLModel>