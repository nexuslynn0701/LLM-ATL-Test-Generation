<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:CPL="http://cpl/1.0">

  <!-- 0: Main CPL root with various node containers -->
  <elements xsi:type="CPL:CPL">
    <!-- SubActions referencing nodes via contents -->
    <subActions id="subA">
      <contents href="//@elements.2"/>
      <contents href="//@elements.4"/>
    </subActions>
    <subActions id="subB">
      <contents href="//@elements.3"/>
      <contents href="//@elements.6"/>
      <contents href="//@elements.7"/>
    </subActions>

    <!-- Outgoing and Incoming containers -->
    <outgoing>
      <contents href="//@elements.1"/>
      <contents href="//@elements.5"/>
    </outgoing>
    <incoming>
      <contents href="//@elements.2"/>
      <contents href="//@elements.8"/>
    </incoming>
  </elements>

  <!-- 1: Location acting as a node and container -->
  <elements xsi:type="CPL:Location" url="sip:office@example.com" priority="5" clear="yes">
    <contents href="//@elements.3"/>
    <contents href="//@elements.9"/>
  </elements>

  <!-- 2: AddressSwitch with multiple addresses, notPresent, otherwise -->
  <elements xsi:type="CPL:AddressSwitch" field="from" subField="host">
    <notPresent>
      <contents href="//@elements.1"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.5"/>
      <contents href="//@elements.10"/>
    </otherwise>
    <addresses is="sip:vip@example.com" contains="vip" subDomainOf="example.com">
      <contents href="//@elements.4"/>
      <contents href="//@elements.6"/>
    </addresses>
    <addresses is="sip:sales@example.org" contains="sales" subDomainOf="example.org">
      <contents href="//@elements.7"/>
    </addresses>
  </elements>

  <!-- 3: StringSwitch with multiple strings -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <notPresent>
      <contents href="//@elements.9"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.4"/>
    </otherwise>
    <strings is="promo" contains="sale">
      <contents href="//@elements.5"/>
    </strings>
    <strings is="support" contains="ticket">
      <contents href="//@elements.1"/>
      <contents href="//@elements.10"/>
    </strings>
  </elements>

  <!-- 4: LanguageSwitch -->
  <elements xsi:type="CPL:LanguageSwitch">
    <notPresent>
      <contents href="//@elements.6"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.2"/>
    </otherwise>
    <languages matches="en">
      <contents href="//@elements.8"/>
    </languages>
    <languages matches="fr">
      <contents href="//@elements.1"/>
    </languages>
  </elements>

  <!-- 5: TimeSwitch with different SwitchedTime entries -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.org/europe-paris">
    <notPresent>
      <contents href="//@elements.7"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.3"/>
    </otherwise>
    <times dtstart="20260101T080000Z" dtend="20260101T170000Z" duration="PT9H"
           freq="DAILY" until="20261231T235959Z" count="10" interval="1"
           bySecond="0" byMinute="0" byHour="8,17" byDay="MO,TU,WE,TH,FR"
           byMonthDay="1-31" byYearDay="1-365" byWeekNo="1-52" byMonth="1-12"
           wkst="MO" bySetPos="1">
      <contents href="//@elements.1"/>
    </times>
    <times dtstart="20260102T000000Z" interval="2" wkst="SU">
      <contents href="//@elements.9"/>
      <contents href="//@elements.10"/>
    </times>
  </elements>

  <!-- 6: PrioritySwitch with multiple priorities -->
  <elements xsi:type="CPL:PrioritySwitch">
    <notPresent>
      <contents href="//@elements.8"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.1"/>
    </otherwise>
    <priorities less="0.3" greater="0.0" equal="">
      <contents href="//@elements.2"/>
    </priorities>
    <priorities less="" greater="0.7" equal="0.7">
      <contents href="//@elements.5"/>
      <contents href="//@elements.9"/>
    </priorities>
  </elements>

  <!-- 7: Proxy with all outcome branches and nested contents -->
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
    <busy>
      <contents href="//@elements.1"/>
    </busy>
    <noAnswer>
      <contents href="//@elements.4"/>
      <contents href="//@elements.9"/>
    </noAnswer>
    <redirection>
      <contents href="//@elements.8"/>
    </redirection>
    <failure>
      <contents href="//@elements.3"/>
    </failure>
    <default>
      <contents href="//@elements.10"/>
    </default>
  </elements>

  <!-- 8: Redirect signalling action -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 9: Reject signalling action -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>

  <!-- 10: SubCall referencing some sub-action by name -->
  <elements xsi:type="CPL:SubCall" ref="subRoutineMain"/>
</CPL:CPLModel>