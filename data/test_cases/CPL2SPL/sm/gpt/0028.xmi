<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL script with incoming/outgoing and multiple subActions -->
  <elements xsi:type="CPL:CPL">
    <subActions xsi:type="CPL:SubAction" id="salesFlow">
      <contents xsi:type="CPL:Location" url="sip:sales@example.com" clear="no" priority="1"/>
      <contents xsi:type="CPL:SubCall" ref="supportSequence"/>
    </subActions>
    <subActions xsi:type="CPL:SubAction" id="supportFlow">
      <contents xsi:type="CPL:Redirect" permanent="true"/>
      <contents xsi:type="CPL:Reject" status="404" reason="NotFound"/>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Reject" status="486" reason="BusyHere"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="yes" priority="5"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </redirection>
        <failure>
          <contents xsi:type="CPL:Reject" status="500" reason="ServerError"/>
        </failure>
        <default>
          <contents xsi:type="CPL:Location" url="sip:operator@example.com" clear="yes" priority="2"/>
        </default>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="user" subField="host">
        <addresses is="alice@example.com" contains="alice" subDomainOf="example.com">
          <contents xsi:type="CPL:Location" url="sip:alice-mobile@example.com" clear="no" priority="1"/>
        </addresses>
        <addresses is="bob@example.com" contains="bob" subDomainOf="example.com">
          <contents xsi:type="CPL:SubCall" ref="bobFlow"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="400" reason="NoUserField"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:default@example.com" clear="yes" priority="10"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>

  <!-- 1: SubCall referencing salesFlow (by plain string) -->
  <elements xsi:type="CPL:SubCall" ref="salesFlow"/>

  <!-- 2: Location used as a generic endpoint -->
  <elements xsi:type="CPL:Location" url="sip:main@example.com" clear="yes" priority="3"/>

  <!-- 3: Proxy with only some branches populated, default pointing to Location (2) -->
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:backup@example.com" clear="no" priority="2"/>
    </busy>
    <default>
      <contents xsi:type="CPL:Location" url="sip:main@example.com" clear="yes" priority="3"/>
    </default>
  </elements>

  <!-- 4: AddressSwitch with multiple addresses and default behavior -->
  <elements xsi:type="CPL:AddressSwitch" field="to" subField="domain">
    <addresses is="sales@example.com" contains="sales" subDomainOf="example.com">
      <contents xsi:type="CPL:SubCall" ref="salesFlow"/>
    </addresses>
    <addresses is="support@example.com" contains="support" subDomainOf="example.com">
      <contents xsi:type="CPL:SubCall" ref="supportFlow"/>
    </addresses>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="488" reason="AddressMissing"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:unknown@example.com" clear="yes" priority="9"/>
    </otherwise>
  </elements>

  <!-- 5: StringSwitch with several patterns -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="sales" contains="sale">
      <contents xsi:type="CPL:SubCall" ref="salesFlow"/>
    </strings>
    <strings is="support" contains="help">
      <contents xsi:type="CPL:SubCall" ref="supportFlow"/>
    </strings>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="420" reason="NoSubject"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:generic@example.com" clear="no" priority="6"/>
    </otherwise>
  </elements>

  <!-- 6: LanguageSwitch -->
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en">
      <contents xsi:type="CPL:Location" url="sip:english@example.com" clear="yes" priority="1"/>
    </languages>
    <languages matches="fr">
      <contents xsi:type="CPL:Location" url="sip:french@example.com" clear="yes" priority="1"/>
    </languages>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:default-lang@example.com" clear="yes" priority="4"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="406" reason="LangNotAcceptable"/>
    </otherwise>
  </elements>

  <!-- 7: TimeSwitch with complex SwitchedTime rules -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
    <times dtstart="20240101T080000" dtend="20240101T170000" duration="PT9H" freq="DAILY"
           until="20241231T170000" count="0" interval="1" bySecond="0" byMinute="0"
           byHour="8" byDay="MO,TU,WE,TH,FR" byMonthDay="" byYearDay=""
           byWeekNo="" byMonth="" wkst="MO" bySetPos="">
      <contents xsi:type="CPL:Location" url="sip:office-hours@example.com" clear="no" priority="1"/>
    </times>
    <times dtstart="20240101T170001" dtend="20240102T075959" duration="PT15H" freq="DAILY"
           until="" count="" interval="1" bySecond="" byMinute=""
           byHour="18" byDay="MO,TU,WE,TH,FR" byMonthDay="" byYearDay=""
           byWeekNo="" byMonth="" wkst="MO" bySetPos="">
      <contents xsi:type="CPL:Location" url="sip:after-hours@example.com" clear="yes" priority="8"/>
    </times>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="489" reason="NoTimeInfo"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:anytime@example.com" clear="no" priority="5"/>
    </otherwise>
  </elements>

  <!-- 8: PrioritySwitch based on priority header -->
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="0.2" greater="" equal="">
      <contents xsi:type="CPL:Location" url="sip:low-priority@example.com" clear="no" priority="10"/>
    </priorities>
    <priorities less="" greater="0.8" equal="">
      <contents xsi:type="CPL:Location" url="sip:high-priority@example.com" clear="no" priority="1"/>
    </priorities>
    <priorities less="" greater="" equal="0.5">
      <contents xsi:type="CPL:Location" url="sip:medium-priority@example.com" clear="yes" priority="5"/>
    </priorities>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:prio-unknown@example.com" clear="yes" priority="7"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="430" reason="PriorityUnexpected"/>
    </otherwise>
  </elements>

  <!-- 9: Redirect action -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

  <!-- 10: Reject action -->
  <elements xsi:type="CPL:Reject" status="603" reason="Decline"/>

  <!-- 11: Proxy whose default branch routes to another Location (2) and uses internal switch -->
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="vip@example.com" contains="vip" subDomainOf="example.com">
          <contents xsi:type="CPL:Location" url="sip:vip-agent@example.com" clear="no" priority="1"/>
        </addresses>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:standard-agent@example.com" clear="no" priority="2"/>
        </otherwise>
      </contents>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Reject" status="408" reason="Timeout"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="500" reason="InternalError"/>
    </failure>
    <default>
      <contents xsi:type="CPL:Location" url="sip:main@example.com" clear="yes" priority="3"/>
    </default>
  </elements>

</CPL:CPLModel>