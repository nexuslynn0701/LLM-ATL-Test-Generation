<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL with subActions and incoming/outgoing -->
  <elements xsi:type="CPL:CPL">
    <subActions xsi:type="CPL:SubAction" id="subMain">
      <contents>//@elements.2</contents>
      <contents>//@elements.4</contents>
    </subActions>
    <subActions xsi:type="CPL:SubAction" id="subAlt">
      <contents>//@elements.1</contents>
      <contents>//@elements.5</contents>
    </subActions>
    <outgoing>
      <contents>//@elements.3</contents>
    </outgoing>
    <incoming>
      <contents>//@elements.6</contents>
    </incoming>
  </elements>

  <!-- 1: Location used from subAlt and Proxy outcomes -->
  <elements xsi:type="CPL:Location" url="sip:user1@example.com" priority="1" clear="yes">
    <contents>//@elements.7</contents>
  </elements>

  <!-- 2: AddressSwitch inside subMain -->
  <elements xsi:type="CPL:AddressSwitch" field="address-field" subField="user-part">
    <notPresent>
      <contents>//@elements.8</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.9</contents>
    </otherwise>
    <addresses is="userA@example.com" contains="userA" subDomainOf="example.com">
      <contents>//@elements.10</contents>
    </addresses>
    <addresses is="userB@example.org">
      <contents>//@elements.1</contents>
    </addresses>
  </elements>

  <!-- 3: TimeSwitch referenced from CPL.outgoing -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Berlin" tzurl="http://tz.example.com/berlin">
    <notPresent>
      <contents>//@elements.1</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.11</contents>
    </otherwise>
    <times dtstart="20260101T080000Z" dtend="20260101T170000Z" duration="P1D"
           freq="DAILY" until="20261231T235959Z" count="10" interval="1"
           bySecond="0" byMinute="0" byHour="8" byDay="MO,TU,WE,TH,FR"
           byMonthDay="1,15" byYearDay="10" byWeekNo="1" byMonth="1"
           wkst="MO" bySetPos="1">
      <contents>//@elements.1</contents>
    </times>
    <times dtstart="20260102T180000Z" interval="2" wkst="SU">
      <contents>//@elements.12</contents>
    </times>
  </elements>

  <!-- 4: StringSwitch inside subMain -->
  <elements xsi:type="CPL:StringSwitch" field="display-name">
    <notPresent>
      <contents>//@elements.13</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.1</contents>
    </otherwise>
    <strings is="Alice" contains="Ali">
      <contents>//@elements.6</contents>
    </strings>
    <strings is="Bob" contains="Bo">
      <contents>//@elements.14</contents>
    </strings>
  </elements>

  <!-- 5: LanguageSwitch inside subAlt -->
  <elements xsi:type="CPL:LanguageSwitch">
    <notPresent>
      <contents>//@elements.15</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.16</contents>
    </otherwise>
    <languages matches="en">
      <contents>//@elements.6</contents>
    </languages>
    <languages matches="fr">
      <contents>//@elements.17</contents>
    </languages>
  </elements>

  <!-- 6: Proxy used from CPL.incoming and some switches -->
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
    <busy>
      <contents>//@elements.18</contents>
    </busy>
    <noAnswer>
      <contents>//@elements.19</contents>
    </noAnswer>
    <redirection>
      <contents>//@elements.20</contents>
    </redirection>
    <failure>
      <contents>//@elements.21</contents>
    </failure>
    <default>
      <contents>//@elements.1</contents>
    </default>
  </elements>

  <!-- 7: PrioritySwitch inside Location -->
  <elements xsi:type="CPL:PrioritySwitch">
    <notPresent>
      <contents>//@elements.22</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.23</contents>
    </otherwise>
    <priorities less="0.3" greater="0.1" equal="0.2">
      <contents>//@elements.24</contents>
    </priorities>
    <priorities less="0.8">
      <contents>//@elements.6</contents>
    </priorities>
  </elements>

  <!-- 8: Location used from AddressSwitch.notPresent -->
  <elements xsi:type="CPL:Location" url="sip:nopresent@example.com" priority="0.5" clear="no"/>

  <!-- 9: Reject used from AddressSwitch.otherwise -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>

  <!-- 10: SubCall used from first SwitchedAddress -->
  <elements xsi:type="CPL:SubCall" ref="subMain"/>

  <!-- 11: Redirect used from TimeSwitch.otherwise -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 12: Location used from second SwitchedTime -->
  <elements xsi:type="CPL:Location" url="sip:evening@example.com" priority="0.7" clear="yes"/>

  <!-- 13: Redirect used from StringSwitch.notPresent -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

  <!-- 14: Reject used from second SwitchedString -->
  <elements xsi:type="CPL:Reject" status="403" reason="Forbidden Name"/>

  <!-- 15: Location used from LanguageSwitch.notPresent -->
  <elements xsi:type="CPL:Location" url="sip:unknownlang@example.com" clear="yes"/>

  <!-- 16: SubCall used from LanguageSwitch.otherwise -->
  <elements xsi:type="CPL:SubCall" ref="fallbackProcedure"/>

  <!-- 17: Redirect used from SwitchedLanguage(fr) -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 18: Location used from Proxy.busy -->
  <elements xsi:type="CPL:Location" url="sip:busy@example.com" priority="0.9" clear="yes"/>

  <!-- 19: Redirect used from Proxy.noAnswer -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 20: SubCall used from Proxy.redirection -->
  <elements xsi:type="CPL:SubCall" ref="redirectHandler"/>

  <!-- 21: Reject used from Proxy.failure -->
  <elements xsi:type="CPL:Reject" status="500" reason="Server Error"/>

  <!-- 22: Reject used from PrioritySwitch.notPresent -->
  <elements xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>

  <!-- 23: Location used from PrioritySwitch.otherwise -->
  <elements xsi:type="CPL:Location" url="sip:defaultprio@example.com" clear="no"/>

  <!-- 24: SubCall used from first SwitchedPriority -->
  <elements xsi:type="CPL:SubCall" ref="priorityRoute"/>

</CPL:CPLModel>