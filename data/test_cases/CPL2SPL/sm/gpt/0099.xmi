<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- 0: Main CPL script with subActions, incoming, outgoing -->
  <elements xsi:type="CPL:CPL">
    <subActions xsi:type="CPL:SubAction" id="subMain">
      <contents>//@elements.4</contents>
      <contents>//@elements.5</contents>
    </subActions>
    <subActions xsi:type="CPL:SubAction" id="subAlt">
      <contents>//@elements.6</contents>
    </subActions>
    <incoming/>
    <outgoing>
      <contents>//@elements.2</contents>
      <contents>//@elements.3</contents>
    </outgoing>
  </elements>

  <!-- 1: Location node used by several containers -->
  <elements xsi:type="CPL:Location" url="sip:primary@example.com" priority="10" clear="yes">
    <contents>//@elements.7</contents>
  </elements>

  <!-- 2: Redirect action -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 3: Reject action -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>

  <!-- 4: AddressSwitch with complex children -->
  <elements xsi:type="CPL:AddressSwitch" field="to" subField="user">
    <addresses is="userA" contains="domA" subDomainOf="example.com">
      <contents>//@elements.8</contents>
    </addresses>
    <addresses is="userB" contains="domB" subDomainOf="example.org">
      <contents>//@elements.1</contents>
    </addresses>
    <notPresent>
      <contents>//@elements.3</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.1</contents>
    </otherwise>
  </elements>

  <!-- 5: StringSwitch -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="support" contains="ticket">
      <contents>//@elements.2</contents>
    </strings>
    <strings is="sales" contains="offer">
      <contents>//@elements.9</contents>
    </strings>
    <notPresent>
      <contents>//@elements.10</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.1</contents>
    </otherwise>
  </elements>

  <!-- 6: Proxy with full set of branches -->
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <busy>
      <contents>//@elements.3</contents>
    </busy>
    <noAnswer>
      <contents>//@elements.9</contents>
    </noAnswer>
    <redirection>
      <contents>//@elements.2</contents>
    </redirection>
    <failure>
      <contents>//@elements.10</contents>
    </failure>
    <default>
      <contents>//@elements.1</contents>
    </default>
  </elements>

  <!-- 7: SubCall -->
  <elements xsi:type="CPL:SubCall" ref="subAlt"/>

  <!-- 8: LanguageSwitch -->
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en">
      <contents>//@elements.1</contents>
    </languages>
    <languages matches="fr">
      <contents>//@elements.2</contents>
    </languages>
    <notPresent>
      <contents>//@elements.10</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.3</contents>
    </otherwise>
  </elements>

  <!-- 9: TimeSwitch -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
    <times dtstart="20240101T080000" dtend="20240101T180000" duration="PT1H" freq="DAILY"
           until="20241231T180000" count="10" interval="2" bySecond="0"
           byMinute="0,30" byHour="8,9,10" byDay="MO,TU,WE,TH,FR"
           byMonthDay="1,15" byYearDay="100,200" byWeekNo="10,20" byMonth="1,6,12"
           wkst="MO" bySetPos="1">
      <contents>//@elements.1</contents>
    </times>
    <times dtstart="20240101T000000" interval="1" wkst="SU">
      <contents>//@elements.3</contents>
    </times>
    <notPresent>
      <contents>//@elements.2</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.10</contents>
    </otherwise>
  </elements>

  <!-- 10: PrioritySwitch -->
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="0.3" greater="0.0" equal="0.1">
      <contents>//@elements.1</contents>
    </priorities>
    <priorities less="0.6" greater="0.4" equal="0.5">
      <contents>//@elements.2</contents>
    </priorities>
    <notPresent>
      <contents>//@elements.3</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.1</contents>
    </otherwise>
  </elements>

</CPL:CPLModel>