<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL with incoming/outgoing and two subActions -->
  <elements xsi:type="CPL:CPL">
    <subActions id="sa_main">
      <contents xsi:type="CPL:Location" url="sip:main@example.com" clear="no" priority="1"/>
      <contents xsi:type="CPL:AddressSwitch" field="To" subField="host">
        <addresses is="sip:vip@example.com" contains="vip" subDomainOf="example.com">
          <contents xsi:type="CPL:Redirect" permanent="yes"/>
        </addresses>
        <addresses is="sip:nonvip@example.com" contains="nonvip" subDomainOf="example.org">
          <contents xsi:type="CPL:Reject" status="404" reason="No route"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="400" reason="Missing address"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy here"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="yes"/>
            </noAnswer>
            <failure>
              <contents xsi:type="CPL:Reject" status="500" reason="Server failure"/>
            </failure>
            <default>
              <contents xsi:type="CPL:SubCall" ref="sa_fallback"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </subActions>

    <subActions id="sa_fallback">
      <contents xsi:type="CPL:TimeSwitch" tzid="UTC" tzurl="http://tz.example.com/utc">
        <times dtstart="20250101T000000Z" dtend="20250101T080000Z" duration="PT8H"
               freq="DAILY" until="20251231T235959Z" count="10" interval="1"
               bySecond="0" byMinute="0" byHour="0" byDay="MO,TU,WE,TH,FR"
               byMonthDay="1" byYearDay="10" byWeekNo="1" byMonth="1" wkst="MO"
               bySetPos="1">
          <contents xsi:type="CPL:Location" url="sip:morning@example.com" priority="3" clear="yes"/>
        </times>
        <times dtstart="20250101T080001Z" dtend="20250101T170000Z" duration="PT9H"
               freq="DAILY" until="20251231T235959Z" count="20" interval="1"
               bySecond="0" byMinute="0" byHour="1" byDay="MO,WE,FR"
               byMonthDay="15" byYearDay="20" byWeekNo="2" byMonth="2" wkst="SU"
               bySetPos="2">
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:queue@example.com" priority="4" clear="no"/>
            </busy>
            <redirection>
              <contents xsi:type="CPL:Redirect" permanent="no"/>
            </redirection>
            <default>
              <contents xsi:type="CPL:Reject" status="480" reason="Temporarily unavailable"/>
            </default>
          </contents>
        </times>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="408" reason="No time info"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:evening@example.com" priority="5" clear="yes"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="0.3" greater="0.0" equal="">
          <contents xsi:type="CPL:Location" url="sip:lowprio@example.com" priority="0.2" clear="no"/>
        </priorities>
        <priorities less="" greater="0.7" equal="">
          <contents xsi:type="CPL:Location" url="sip:highprio@example.com" priority="0.9" clear="yes"/>
        </priorities>
        <priorities less="" greater="" equal="0.5">
          <contents xsi:type="CPL:Reject" status="603" reason="Decline medium priority"/>
        </priorities>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="sa_language_branch"/>
        </otherwise>
      </contents>
    </subActions>

    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="Subject">
        <strings is="promo" contains="discount">
          <contents xsi:type="CPL:Location" url="sip:marketing@example.com" priority="1" clear="no"/>
        </strings>
        <strings is="support" contains="issue">
          <contents xsi:type="CPL:SubCall" ref="sa_support_flow"/>
        </strings>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="400" reason="Subject missing"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:overflow@example.com" priority="2" clear="yes"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="no"/>
            </noAnswer>
            <default>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy elsewhere"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </incoming>

    <outgoing>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en">
          <contents xsi:type="CPL:Location" url="sip:en@example.com" priority="1" clear="yes"/>
        </languages>
        <languages matches="fr">
          <contents xsi:type="CPL:Location" url="sip:fr@example.com" priority="1" clear="yes"/>
        </languages>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="406" reason="Language required"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="sa_language_branch"/>
        </otherwise>
      </contents>
    </outgoing>
  </elements>

  <!-- 1: Standalone SubCall used by switches -->
  <elements xsi:type="CPL:SubCall" ref="sa_support_flow"/>

  <!-- 2: Location referenced from Proxy.default in subAction sa_main -->
  <elements xsi:type="CPL:Location" url="sip:helpdesk@example.com" priority="1" clear="yes"/>

  <!-- 3: Redirect as a top-level action -->
  <elements xsi:type="CPL:Redirect" permanent="yes"/>

  <!-- 4: Reject as a top-level action -->
  <elements xsi:type="CPL:Reject" status="603" reason="Declined by user"/>

  <!-- 5: Proxy with all condition branches and cross-reference to element 2 -->
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:proxybusy@example.com" priority="3" clear="no"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Reject" status="480" reason="No response"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Redirect" permanent="no"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="500" reason="Proxy internal error"/>
    </failure>
    <default>
      <contents xsi:type="CPL:Location" url="sip:fallback@example.com" priority="2" clear="yes"/>
    </default>
  </elements>

  <!-- 6: AddressSwitch with notPresent/otherwise, referencing element 2 via contents -->
  <elements xsi:type="CPL:AddressSwitch" field="From" subField="user">
    <addresses is="alice" contains="ali" subDomainOf="example.com">
      <contents xsi:type="CPL:Location" url="sip:alice@example.com" priority="1" clear="yes"/>
    </addresses>
    <addresses is="bob" contains="bo" subDomainOf="example.net">
      <contents xsi:type="CPL:Location" url="sip:bob@example.net" priority="1" clear="no"/>
    </addresses>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="403" reason="Anonymous not allowed"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:generic@example.org" priority="5" clear="yes"/>
    </otherwise>
  </elements>

  <!-- 7: StringSwitch testing multiple strings and default SubCall -->
  <elements xsi:type="CPL:StringSwitch" field="Alert-Info">
    <strings is="ring1" contains="">
      <contents xsi:type="CPL:Location" url="sip:ring1@example.com" priority="1" clear="no"/>
    </strings>
    <strings is="ring2" contains="urgent">
      <contents xsi:type="CPL:Location" url="sip:ring2@example.com" priority="2" clear="yes"/>
    </strings>
    <notPresent>
      <contents xsi:type="CPL:SubCall" ref="default_ring_plan"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:standard@example.com" priority="3" clear="yes"/>
    </otherwise>
  </elements>

  <!-- 8: LanguageSwitch as standalone with default Reject -->
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="de">
      <contents xsi:type="CPL:Location" url="sip:de@example.com" priority="1" clear="yes"/>
    </languages>
    <languages matches="es">
      <contents xsi:type="CPL:Location" url="sip:es@example.com" priority="1" clear="yes"/>
    </languages>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="415" reason="Unsupported language"/>
    </otherwise>
  </elements>

  <!-- 9: TimeSwitch as standalone, minimal attributes plus branches -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
    <times dtstart="20250101T090000" interval="1" wkst="MO">
      <contents xsi:type="CPL:Location" url="sip:paris-office@example.com" priority="1" clear="yes"/>
    </times>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="503" reason="Time service down"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="10" clear="no"/>
    </otherwise>
  </elements>

  <!-- 10: PrioritySwitch standalone -->
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="0.5" greater="" equal="">
      <contents xsi:type="CPL:Location" url="sip:low@example.com" priority="0.3" clear="no"/>
    </priorities>
    <priorities less="" greater="0.5" equal="">
      <contents xsi:type="CPL:Location" url="sip:high@example.com" priority="0.8" clear="yes"/>
    </priorities>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="488" reason="Not acceptable priority"/>
    </otherwise>
  </elements>

</CPL:CPLModel>