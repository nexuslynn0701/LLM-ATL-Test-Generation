<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL script with multiple subActions and incoming/outgoing -->
  <elements xsi:type="CPL:CPL">
    <!-- Incoming leg with chained nodes -->
    <incoming>
      <!-- SubCall followed by a Proxy -->
      <contents xsi:type="CPL:SubCall" ref="handleIncomingCall"/>
      <contents xsi:type="CPL:Proxy" timeout="20" recurse="yes" ordering="serial">
        <busy>
          <!-- Busy case forwards to Location #2 -->
          <contents contents="//@elements.2"/>
        </busy>
        <noAnswer>
          <!-- NoAnswer case goes to Reject #4 -->
          <contents contents="//@elements.4"/>
        </noAnswer>
        <redirection>
          <!-- Redirection case goes to Redirect #3 -->
          <contents contents="//@elements.3"/>
        </redirection>
        <failure>
          <!-- Failure case goes to PrioritySwitch #7 -->
          <contents contents="//@elements.7"/>
        </failure>
        <default>
          <!-- Default case reuses top-level Location #1 -->
          <contents contents="//@elements.1"/>
        </default>
      </contents>
    </incoming>

    <!-- Outgoing leg with a Switch and Location -->
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="From" subField="user">
        <addresses is="userA" contains="example.com" subDomainOf="corp.example.com">
          <!-- Address A routes to Location #1 then to SubCall #5 -->
          <contents contents="//@elements.1"/>
          <contents contents="//@elements.5"/>
        </addresses>
        <addresses is="userB" contains="example.org">
          <!-- Address B routes to TimeSwitch #6 -->
          <contents contents="//@elements.6"/>
        </addresses>
        <notPresent>
          <!-- No From header: go directly to Reject #4 -->
          <contents contents="//@elements.4"/>
        </notPresent>
        <otherwise>
          <!-- Any other address: go to Proxy #8 -->
          <contents contents="//@elements.8"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:Location" url="sip:backup@example.net" clear="no" priority="5"/>
    </outgoing>

    <!-- SubActions declared in this CPL -->
    <subActions>
      <contents xsi:type="CPL:Location" url="sip:primary@example.com" clear="yes" priority="1"/>
    </subActions>
    <subActions id="subActionA">
      <!-- Simple subaction that just uses Location #2 -->
      <contents contents="//@elements.2"/>
    </subActions>
    <subActions id="subActionB">
      <!-- Subaction that uses a StringSwitch -->
      <contents xsi:type="CPL:StringSwitch" field="Subject">
        <strings is="support" contains="ticket">
          <contents contents="//@elements.1"/>
        </strings>
        <strings is="sales">
          <contents contents="//@elements.2"/>
        </strings>
        <notPresent>
          <contents contents="//@elements.3"/>
        </notPresent>
        <otherwise>
          <contents contents="//@elements.4"/>
        </otherwise>
      </contents>
    </subActions>
  </elements>

  <!-- 1: Reusable Location -->
  <elements xsi:type="CPL:Location" url="sip:agent1@example.com" clear="yes" priority="10"/>

  <!-- 2: Another Location used from switches and proxy -->
  <elements xsi:type="CPL:Location" url="sip:agent2@example.com" clear="no" priority="20"/>

  <!-- 3: Redirect action -->
  <elements xsi:type="CPL:Redirect" permanent="yes"/>

  <!-- 4: Reject action -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>

  <!-- 5: SubCall referring to subActionB -->
  <elements xsi:type="CPL:SubCall" ref="subActionB"/>

  <!-- 6: TimeSwitch with several SwitchedTime entries -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
    <times dtstart="20260101T080000" dtend="20260101T180000" duration="PT10H"
           freq="DAILY" until="20261231T000000" count="365" interval="1"
           bySecond="0" byMinute="0" byHour="8"
           byDay="MO,TU,WE,TH,FR" byMonthDay="1,15" byYearDay="10"
           byWeekNo="1" byMonth="1" wkst="MO" bySetPos="1">
      <contents contents="//@elements.1"/>
    </times>
    <times dtstart="20260101T180001" dtend="20260101T235959" interval="2" wkst="MO">
      <contents contents="//@elements.2"/>
    </times>
    <notPresent>
      <contents contents="//@elements.3"/>
    </notPresent>
    <otherwise>
      <contents contents="//@elements.4"/>
    </otherwise>
  </elements>

  <!-- 7: PrioritySwitch with SwitchedPriority cases -->
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5">
      <contents contents="//@elements.1"/>
    </priorities>
    <priorities equal="10">
      <contents contents="//@elements.2"/>
    </priorities>
    <priorities greater="10">
      <contents contents="//@elements.3"/>
    </priorities>
    <notPresent>
      <contents contents="//@elements.4"/>
    </notPresent>
    <otherwise>
      <contents contents="//@elements.5"/>
    </otherwise>
  </elements>

  <!-- 8: Proxy with full set of branches and nested switches -->
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="no" ordering="parallel">
    <busy>
      <!-- For busy, use a LanguageSwitch -->
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en">
          <contents contents="//@elements.1"/>
        </languages>
        <languages matches="fr">
          <contents contents="//@elements.2"/>
        </languages>
        <notPresent>
          <contents contents="//@elements.3"/>
        </notPresent>
        <otherwise>
          <contents contents="//@elements.4"/>
        </otherwise>
      </contents>
    </busy>
    <noAnswer>
      <!-- For no answer, fallback to PrioritySwitch -->
      <contents contents="//@elements.7"/>
    </noAnswer>
    <redirection>
      <!-- For redirection, go to AddressSwitch inside the main CPL (top-level 0) -->
      <contents contents="//@elements.0/outgoing/contents.0"/>
    </redirection>
    <failure>
      <!-- For failure, invoke SubCall #5 -->
      <contents contents="//@elements.5"/>
    </failure>
    <default>
      <!-- Default falls back to Location #2 -->
      <contents contents="//@elements.2"/>
    </default>
  </elements>

</CPL:CPLModel>