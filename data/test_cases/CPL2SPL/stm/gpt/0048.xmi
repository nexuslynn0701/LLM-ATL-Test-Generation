<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL script with switches and initial locations -->
  <elements xsi:type="CPL:CPL">
    <!-- Main outgoing decisions -->
    <outgoing contents="//@elements.5 //@elements.6 //@elements.7"/>
    <!-- Incoming could reuse some nodes -->
    <incoming contents="//@elements.3 //@elements.4"/>
    <!-- Two referenced subactions -->
    <subActions id="subAlpha" contents="//@elements.2 //@elements.4"/>
    <subActions id="subBeta" contents="//@elements.1"/>
  </elements>

  <!-- 1: Location used as a terminal node and as content in several containers -->
  <elements xsi:type="CPL:Location" url="sip:user1@example.com" priority="1" clear="yes"/>

  <!-- 2: Another Location to create multiple targets -->
  <elements xsi:type="CPL:Location" url="sip:user2@example.org" priority="2" clear="no"/>

  <!-- 3: SubCall referencing subAlpha -->
  <elements xsi:type="CPL:SubCall" ref="subAlpha"/>

  <!-- 4: SubCall referencing subBeta -->
  <elements xsi:type="CPL:SubCall" ref="subBeta"/>

  <!-- 5: AddressSwitch with multiple SwitchedAddress branches and NotPresent/Otherwise -->
  <elements xsi:type="CPL:AddressSwitch" field="from" subField="user">
    <addresses is="alice" contains="example.com" subDomainOf="example.com"
               contents="//@elements.1"/>
    <addresses is="bob" contains="sales.example.com" subDomainOf="example.com"
               contents="//@elements.2"/>
    <notPresent contents="//@elements.3"/>
    <otherwise contents="//@elements.4"/>
  </elements>

  <!-- 6: StringSwitch driving to locations and subcalls -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent" contains="call" contents="//@elements.1 //@elements.3"/>
    <strings is="info" contains="newsletter" contents="//@elements.2"/>
    <notPresent contents="//@elements.4"/>
    <otherwise contents="//@elements.1 //@elements.2"/>
  </elements>

  <!-- 7: TimeSwitch with several SwitchedTime cases -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Berlin" tzurl="http://tz.example.com/eu">
    <times dtstart="20240601T080000Z" dtend="20240601T170000Z"
           duration="PT9H" freq="DAILY" until="20241231T000000Z"
           count="10" interval="1" byHour="8,9,10,11,12,13,14,15,16"
           wkst="MO" contents="//@elements.1"/>
    <times dtstart="20240601T170000Z" duration="PT15H"
           freq="DAILY" interval="1" byHour="17,18,19,20,21,22,23"
           byDay="MO,TU,WE,TH,FR" wkst="MO"
           contents="//@elements.2 //@elements.3"/>
    <times dtstart="20240601T000000Z"
           freq="WEEKLY" interval="1" byDay="SA,SU" wkst="MO"
           contents="//@elements.4"/>
    <notPresent contents="//@elements.2"/>
    <otherwise contents="//@elements.1 //@elements.4"/>
  </elements>

  <!-- 8: LanguageSwitch -->
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en" contents="//@elements.1"/>
    <languages matches="es" contents="//@elements.2"/>
    <languages matches="de" contents="//@elements.3 //@elements.4"/>
    <notPresent contents="//@elements.2"/>
    <otherwise contents="//@elements.1 //@elements.4"/>
  </elements>

  <!-- 9: PrioritySwitch -->
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="0.3" greater="0.0" equal="0.1"
                contents="//@elements.1"/>
    <priorities less="0.7" greater="0.3" equal="0.5"
                contents="//@elements.2 //@elements.3"/>
    <priorities less="1.0" greater="0.7" equal="0.9"
                contents="//@elements.4"/>
    <notPresent contents="//@elements.2"/>
    <otherwise contents="//@elements.1 //@elements.2 //@elements.3"/>
  </elements>

  <!-- 10: Proxy with all response branches and internal flows -->
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <busy contents="//@elements.8"/>
    <noAnswer contents="//@elements.6 //@elements.1"/>
    <redirection contents="//@elements.5"/>
    <failure contents="//@elements.9 //@elements.3"/>
    <default contents="//@elements.2 //@elements.4"/>
  </elements>

  <!-- 11: Redirect action -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 12: Reject action with both status and reason -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>

</CPL:CPLModel>