<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL element with various subActions and in/outgoing containers -->
  <elements xsi:type="CPL:CPL">
    <subActions id="subA">
      <contents xsi:type="CPL:Location" url="sip:subA_loc@example.com" priority="1" clear="no"/>
      <contents xsi:type="CPL:SubCall" ref="subB"/>
    </subActions>
    <subActions id="subB">
      <contents xsi:type="CPL:Redirect" permanent="true"/>
      <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:Location" url="sip:out_loc1@example.com" priority="5" clear="yes"/>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Location" url="sip:busy_out@example.com" priority="2" clear="no"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:SubCall" ref="noAnswerHandler"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </redirection>
        <failure>
          <contents xsi:type="CPL:Reject" status="500" reason="ServerError"/>
        </failure>
        <default>
          <contents xsi:type="CPL:Location" url="sip:default_out@example.com" priority="10" clear="yes"/>
        </default>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="From" subField="user">
        <notPresent>
          <contents xsi:type="CPL:Reject" status="400" reason="MissingFrom"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:incoming_default@example.com" priority="3" clear="no"/>
        </otherwise>
        <addresses is="alice@example.com" contains="alice" subDomainOf="example.com">
          <contents xsi:type="CPL:SubCall" ref="aliceScript"/>
        </addresses>
        <addresses is="bob@example.net" contains="bob" subDomainOf="example.net">
          <contents xsi:type="CPL:Location" url="sip:bob_location@example.net" priority="2" clear="yes"/>
        </addresses>
      </contents>
    </incoming>
  </elements>

  <!-- 1: Top-level Location -->
  <elements xsi:type="CPL:Location" url="sip:top1@example.com" priority="1" clear="yes"/>

  <!-- 2: Top-level SubCall -->
  <elements xsi:type="CPL:SubCall" ref="externalService"/>

  <!-- 3: Top-level Redirect -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

  <!-- 4: Top-level Reject -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>

  <!-- 5: Top-level Proxy with nested node containers referencing other elements -->
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel" timeout="30">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="4" clear="yes"/>
      <contents xsi:type="CPL:SubCall" ref="busyHandler"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Location" url="sip:noanswer@example.com" priority="6" clear="no"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="503" reason="ServiceUnavailable"/>
    </failure>
    <default>
      <!-- reference the top-level Location at index 1 -->
      <contents xsi:type="CPL:Location" url="sip:fallback@example.com" priority="10" clear="yes"/>
    </default>
  </elements>

  <!-- 6: AddressSwitch exercising SwitchedAddress, NotPresent and Otherwise -->
  <elements xsi:type="CPL:AddressSwitch" field="To" subField="domain">
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:no_to_header@example.com" priority="8" clear="yes"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="genericToHandler"/>
    </otherwise>
    <addresses is="vip.example.com" contains="vip" subDomainOf="example.com">
      <contents xsi:type="CPL:Location" url="sip:vip@example.com" priority="1" clear="no"/>
    </addresses>
  </elements>

  <!-- 7: StringSwitch exercising SwitchedString -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <notPresent>
      <contents xsi:type="CPL:Reject" status="480" reason="NoSubject"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:subject_default@example.com" priority="7" clear="yes"/>
    </otherwise>
    <strings is="promo" contains="promo"/>
    <strings is="support" contains="support">
      <contents xsi:type="CPL:SubCall" ref="supportFlow"/>
    </strings>
  </elements>

  <!-- 8: LanguageSwitch exercising SwitchedLanguage -->
  <elements xsi:type="CPL:LanguageSwitch">
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:lang_default@example.com" priority="5" clear="no"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="langFallback"/>
    </otherwise>
    <languages matches="en">
      <contents xsi:type="CPL:Location" url="sip:english@example.com" priority="1" clear="yes"/>
    </languages>
    <languages matches="fr">
      <contents xsi:type="CPL:Location" url="sip:french@example.com" priority="2" clear="yes"/>
    </languages>
  </elements>

  <!-- 9: TimeSwitch exercising SwitchedTime with many attributes -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
    <notPresent>
      <contents xsi:type="CPL:Reject" status="488" reason="TimeMissing"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="timeDefaultFlow"/>
    </otherwise>
    <times dtstart="20240101T080000" dtend="20240101T180000" duration="PT10H" freq="DAILY"
           until="20241231T235959" count="365" interval="1"
           bySecond="0" byMinute="0" byHour="8"
           byDay="MO,TU,WE,TH,FR" byMonthDay="1-31" byYearDay="" byWeekNo="" byMonth="1-12"
           wkst="MO" bySetPos="1">
      <contents xsi:type="CPL:Location" url="sip:business_hours@example.com" priority="1" clear="yes"/>
    </times>
    <times dtstart="20240101T000000" interval="2" wkst="SU">
      <contents xsi:type="CPL:Location" url="sip:night_service@example.com" priority="9" clear="no"/>
    </times>
  </elements>

  <!-- 10: PrioritySwitch exercising SwitchedPriority -->
  <elements xsi:type="CPL:PrioritySwitch">
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:no_priority@example.com" priority="10" clear="yes"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="priorityDefault"/>
    </otherwise>
    <priorities less="0.3" greater="0.0" equal="">
      <contents xsi:type="CPL:Location" url="sip:low_priority@example.com" priority="9" clear="no"/>
    </priorities>
    <priorities less="" greater="0.7" equal="">
      <contents xsi:type="CPL:Location" url="sip:high_priority@example.com" priority="1" clear="yes"/>
    </priorities>
    <priorities less="" greater="" equal="0.5">
      <contents xsi:type="CPL:SubCall" ref="exactPriorityHandler"/>
    </priorities>
  </elements>

  <!-- 11: Another Proxy combining Location and SubCall in nested containers -->
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="60">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="proxyBusyRoutine"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Location" url="sip:proxy_noanswer@example.com" priority="6" clear="yes"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
      <contents xsi:type="CPL:Location" url="sip:proxy_redirect@example.com" priority="2" clear="no"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="500" reason="ProxyFailure"/>
    </failure>
    <default>
      <contents xsi:type="CPL:Location" url="sip:proxy_default@example.com" priority="3" clear="yes"/>
    </default>
  </elements>

</CPL:CPLModel>