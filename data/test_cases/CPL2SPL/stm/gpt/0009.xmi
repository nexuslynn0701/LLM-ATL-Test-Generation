<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL with incoming/outgoing and several subActions -->
  <elements xsi:type="CPL:CPL">
    <!-- Incoming container with a Location and an AddressSwitch -->
    <incoming>
      <contents xsi:type="CPL:Location"
                url="sip:incoming@example.com"
                priority="1"
                clear="yes"/>
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="alice@example.com" contains="alice" subDomainOf="example.com">
          <contents xsi:type="CPL:SubCall" ref="subWelcome"/>
        </addresses>
        <addresses is="bob@example.org" contains="bob" subDomainOf="example.org">
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="20">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="0"/>
            </noAnswer>
            <default>
              <contents xsi:type="CPL:Location"
                        url="sip:fallback@example.org"
                        priority="5"
                        clear="no"/>
            </default>
          </contents>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="400" reason="Missing From"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="subUnknownCaller"/>
        </otherwise>
      </contents>
    </incoming>

    <!-- Outgoing container referencing various top-level nodes -->
    <outgoing>
      <!-- references ProxyA -->
      <contents xsi:type="CPL:Proxy">
        <busy>
          <contents xsi:type="CPL:SubCall" ref="handleBusyOutgoing"/>
        </busy>
        <default contents="//@elements.2"/>
      </contents>
    </outgoing>

    <!-- SubActions defined at top level and referenced by SubCalls -->
    <subActions id="subWelcome">
      <contents xsi:type="CPL:Location"
                url="sip:welcome@example.com"
                priority="1"
                clear="yes"/>
      <contents xsi:type="CPL:Redirect" permanent="1"/>
    </subActions>

    <subActions id="subUnknownCaller">
      <contents xsi:type="CPL:Reject" status="403" reason="Forbidden caller"/>
    </subActions>
  </elements>

  <!-- 1: Simple Location used as a shared leaf -->
  <elements xsi:type="CPL:Location"
            url="sip:shared@example.net"
            priority="3"
            clear="no"/>

  <!-- 2: ProxyA with multiple child containers and references to other elements -->
  <elements xsi:type="CPL:Proxy"
            timeout="30"
            recurse="yes"
            ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location"
                url="sip:busy-alt@example.net"
                priority="2"
                clear="yes"/>
    </busy>
    <noAnswer>
      <!-- reference the shared Location (index 1) -->
      <contents xsi:type="CPL:Location"
                url="sip:noanswer@example.net"
                priority="4"
                clear="no"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Redirect" permanent="0"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="500" reason="Server failure"/>
    </failure>
    <default>
      <!-- reference the simple Location at index 1 -->
      <contents xsi:type="CPL:Location"
                url="sip:shared@example.net"
                priority="3"
                clear="no"/>
    </default>
  </elements>

  <!-- 3: AddressSwitch at top level with notPresent/otherwise -->
  <elements xsi:type="CPL:AddressSwitch" field="to" subField="host">
    <addresses is="sales.example.com" contains="sales" subDomainOf="example.com">
      <contents xsi:type="CPL:Location"
                url="sip:sales@example.com"
                priority="1"
                clear="yes"/>
    </addresses>
    <addresses is="support.example.com" contains="support" subDomainOf="example.com">
      <contents xsi:type="CPL:SubCall" ref="subSupportFlow"/>
    </addresses>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="404" reason="No destination"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="15">
        <busy>
          <contents xsi:type="CPL:Location"
                    url="sip:queue@example.com"
                    priority="7"
                    clear="no"/>
        </busy>
        <default>
          <contents xsi:type="CPL:Redirect" permanent="1"/>
        </default>
      </contents>
    </otherwise>
  </elements>

  <!-- 4: StringSwitch exercising SwitchedString and Otherwise -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="promo" contains="discount">
      <contents xsi:type="CPL:Location"
                url="sip:promo@example.com"
                priority="1"
                clear="yes"/>
    </strings>
    <strings is="vip" contains="gold">
      <contents xsi:type="CPL:SubCall" ref="subVipHandler"/>
    </strings>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="480" reason="Not acceptable topic"/>
    </otherwise>
  </elements>

  <!-- 5: LanguageSwitch with SwitchedLanguage and default branch -->
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en">
      <contents xsi:type="CPL:Location"
                url="sip:english@example.com"
                priority="1"
                clear="yes"/>
    </languages>
    <languages matches="fr">
      <contents xsi:type="CPL:Location"
                url="sip:french@example.com"
                priority="1"
                clear="yes"/>
    </languages>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="subDefaultLanguage"/>
    </otherwise>
  </elements>

  <!-- 6: TimeSwitch with complex SwitchedTime and wkst/interval -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
    <times dtstart="20240101T080000Z"
           dtend="20240101T180000Z"
           duration="PT10H"
           freq="DAILY"
           until="20241231T235959Z"
           count="10"
           interval="1"
           bySecond="0"
           byMinute="0"
           byHour="8,9,10"
           byDay="MO,TU,WE,TH,FR"
           byMonthDay="1-31"
           byYearDay="1-365"
           byWeekNo="1-52"
           byMonth="1-12"
           wkst="MO"
           bySetPos="1">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="25">
        <busy>
          <contents xsi:type="CPL:Location"
                    url="sip:busy-time@example.com"
                    priority="2"
                    clear="no"/>
        </busy>
        <default>
          <contents xsi:type="CPL:SubCall" ref="subWorkingHours"/>
        </default>
      </contents>
    </times>
    <times dtstart="20240101T180000Z"
           interval="1"
           wkst="MO">
      <contents xsi:type="CPL:Reject" status="486" reason="Closed"/>
    </times>
    <otherwise>
      <contents xsi:type="CPL:Location"
                url="sip:backup-time@example.com"
                priority="9"
                clear="yes"/>
    </otherwise>
  </elements>

  <!-- 7: PrioritySwitch with SwitchedPriority -->
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="0.3">
      <contents xsi:type="CPL:Location"
                url="sip:lowprio@example.com"
                priority="9"
                clear="no"/>
    </priorities>
    <priorities equal="0.5">
      <contents xsi:type="CPL:SubCall" ref="subMediumPriority"/>
    </priorities>
    <priorities greater="0.7">
      <contents xsi:type="CPL:Location"
                url="sip:highprio@example.com"
                priority="1"
                clear="yes"/>
    </priorities>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="488" reason="Priority mismatch"/>
    </otherwise>
  </elements>

  <!-- 8: SubCall that refers to a name not tied to a SubAction (allowed, plain string) -->
  <elements xsi:type="CPL:SubCall" ref="subExternalFlow"/>

  <!-- 9: Redirect top-level -->
  <elements xsi:type="CPL:Redirect" permanent="1"/>

  <!-- 10: Reject top-level -->
  <elements xsi:type="CPL:Reject" status="603" reason="Declined by policy"/>

  <!-- 11: Another Proxy that references an earlier top-level Location via contents semantics -->
  <elements xsi:type="CPL:Proxy" timeout="40" recurse="no" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:SubCall" ref="subBusyHandlerAlt"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Location"
                url="sip:voicemail@example.com"
                priority="10"
                clear="yes"/>
    </noAnswer>
    <default>
      <contents xsi:type="CPL:Location"
                url="sip:shared@example.net"
                priority="3"
                clear="no"/>
    </default>
  </elements>

</CPL:CPLModel>