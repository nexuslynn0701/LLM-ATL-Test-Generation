<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL script with incoming/outgoing and a subAction -->
  <elements xsi:type="CPL:CPL">
    <subActions id="subA">
      <contents xsi:type="CPL:Location" url="sip:subA_primary@example.com" clear="yes" priority="5"/>
      <contents xsi:type="CPL:SubCall" ref="nestedSubCallRefInSubA"/>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="to" subField="user">
        <addresses is="alice" contains="example.com" subDomainOf="corp.example.com">
          <contents xsi:type="CPL:Location" url="sip:alice_out@example.com" clear="no" priority="1"/>
        </addresses>
        <addresses is="bob" contains="example.net" subDomainOf="dept.example.net">
          <contents xsi:type="CPL:SubCall" ref="subFlowForBob"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="No To header"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="20">
            <busy>
              <contents xsi:type="CPL:Redirect" permanent="yes"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Reject" status="480" reason="No answer on outgoing"/>
            </noAnswer>
            <default>
              <contents xsi:type="CPL:Location" url="sip:fallback_out@example.org" clear="yes" priority="10"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="Europe/Berlin" tzurl="http://tz.example.com/berlin">
        <times dtstart="20260101T090000Z" dtend="20260101T170000Z" duration="PT8H" freq="DAILY"
               until="20261231T235959Z" count="10" interval="1" bySecond="0" byMinute="0"
               byHour="9" byDay="MO,TU,WE,TH,FR" byMonthDay="1,2,3" byYearDay="10"
               byWeekNo="1" byMonth="1" wkst="MO" bySetPos="1">
          <contents xsi:type="CPL:Location" url="sip:office@example.com" clear="yes" priority="1"/>
        </times>
        <times dtstart="20260101T170000Z" duration="PT14H" interval="1" wkst="MO">
          <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="no" priority="50"/>
        </times>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="500" reason="Time header missing"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="15">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy during incoming"/>
            </busy>
            <failure>
              <contents xsi:type="CPL:Redirect" permanent="no"/>
            </failure>
            <default>
              <contents xsi:type="CPL:Location" url="sip:incoming_fallback@example.net" clear="yes" priority="100"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>

  <!-- 1: Standalone SubCall referenced only by string -->
  <elements xsi:type="CPL:SubCall" ref="externalFlowStart"/>

  <!-- 2: Standalone Location, referenced from two different containers via contents -->
  <elements xsi:type="CPL:Location" url="sip:shared@example.com" priority="20" clear="yes"/>

  <!-- 3: Proxy with all event branches and shared Location by reference -->
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="30">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy_alt@example.com" clear="no" priority="2"/>
      <contents xsi:type="CPL:SubCall" ref="busySubCallFlow"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Reject" status="408" reason="No answer on proxy"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Redirect" permanent="no"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="500" reason="Server failure"/>
    </failure>
    <default>
      <contents xsi:type="CPL:Location" url="sip:default_proxy@example.org" clear="yes" priority="30"/>
      <contents xsi:type="CPL:Location" url="sip:backup_proxy@example.org" clear="no" priority="40"/>
      <!-- reference shared top-level Location at index 2 -->
      <contents xsi:type="CPL:Location" url="sip:shared@example.com" clear="yes" priority="20"/>
    </default>
  </elements>

  <!-- 4: AddressSwitch with multiple SwitchedAddress and nested switches -->
  <elements xsi:type="CPL:AddressSwitch" field="from" subField="domain">
    <addresses is="vip.example.com" contains="vip" subDomainOf="example.com">
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="25">
        <default>
          <contents xsi:type="CPL:Location" url="sip:vip_agent@example.com" clear="yes" priority="1"/>
        </default>
      </contents>
    </addresses>
    <addresses is="guest.example.com" contains="guest" subDomainOf="example.com">
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="promo" contains="offer">
          <contents xsi:type="CPL:Location" url="sip:promo_handler@example.com" clear="yes" priority="5"/>
        </strings>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="400" reason="Subject missing for guest"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="genericGuestHandler"/>
        </otherwise>
      </contents>
    </addresses>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="403" reason="Unknown source domain"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:misc@example.net" clear="no" priority="60"/>
    </otherwise>
  </elements>

  <!-- 5: StringSwitch only -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="support" contains="ticket">
      <contents xsi:type="CPL:Location" url="sip:support@example.com" clear="yes" priority="3"/>
    </strings>
    <strings is="sales" contains="quote">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="10">
        <busy>
          <contents xsi:type="CPL:Location" url="sip:sales_queue@example.com" clear="no" priority="70"/>
        </busy>
        <default>
          <contents xsi:type="CPL:SubCall" ref="salesWorkflow"/>
        </default>
      </contents>
    </strings>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="489" reason="Bad subject"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:general@example.com" clear="yes" priority="8"/>
    </otherwise>
  </elements>

  <!-- 6: LanguageSwitch with multiple SwitchedLanguage -->
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en">
      <contents xsi:type="CPL:Location" url="sip:english_support@example.com" clear="yes" priority="2"/>
    </languages>
    <languages matches="fr">
      <contents xsi:type="CPL:Location" url="sip:french_support@example.fr" clear="yes" priority="2"/>
    </languages>
    <languages matches="es">
      <contents xsi:type="CPL:SubCall" ref="spanishSupportFlow"/>
    </languages>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="488" reason="Language not specified"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:multilingual@example.com" clear="no" priority="9"/>
    </otherwise>
  </elements>

  <!-- 7: TimeSwitch only -->
  <elements xsi:type="CPL:TimeSwitch" tzid="UTC" tzurl="http://tz.example.org/utc">
    <times dtstart="20260101T000000Z" dtend="20261231T235959Z" duration="P1Y" freq="YEARLY"
           until="20261231T235959Z" count="3" interval="1" bySecond="0"
           byMinute="0" byHour="0" byDay="MO,TU,WE,TH,FR" byMonthDay="1"
           byYearDay="1" byWeekNo="1" byMonth="1" wkst="MO" bySetPos="1">
      <contents xsi:type="CPL:Location" url="sip:newyear@example.org" clear="yes" priority="1"/>
    </times>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="503" reason="Time condition missing"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:anytime@example.org" clear="no" priority="99"/>
    </otherwise>
  </elements>

  <!-- 8: PrioritySwitch with multiple SwitchedPriority -->
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="0.3" greater="0.0" equal="">
      <contents xsi:type="CPL:Location" url="sip:low_priority@example.com" clear="yes" priority="90"/>
    </priorities>
    <priorities less="0.7" greater="0.3" equal="">
      <contents xsi:type="CPL:Location" url="sip:medium_priority@example.com" clear="yes" priority="50"/>
    </priorities>
    <priorities less="" greater="0.7" equal="">
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="5">
        <default>
          <contents xsi:type="CPL:Location" url="sip:high_priority@example.com" clear="yes" priority="10"/>
        </default>
      </contents>
    </priorities>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="500" reason="No priority information"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:default_priority@example.com" clear="no" priority="100"/>
    </otherwise>
  </elements>

  <!-- 9: Standalone Redirect -->
  <elements xsi:type="CPL:Redirect" permanent="yes"/>

  <!-- 10: Standalone Reject -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy here"/>

  <!-- 11: Standalone Location not referenced by others (edge/unreached) -->
  <elements xsi:type="CPL:Location" url="sip:orphan@example.com" clear="no" priority="200"/>

</CPL:CPLModel>