<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL element -->
  <elements xsi:type="CPL:CPL">
    <subActions xsi:type="CPL:SubAction" id="welcomeFlow">
      <contents xsi:type="CPL:Location" url="sip:welcome@example.com" priority="1" clear="no"/>
      <contents xsi:type="CPL:AddressSwitch" field="To" subField="user">
        <addresses is="alice" contains="example.com" subDomainOf="corp.example.com">
          <contents xsi:type="CPL:Location" url="sip:alice@example.com" priority="0.5" clear="yes"/>
        </addresses>
        <addresses is="bob" contains="example.net" subDomainOf="sales.example.net">
          <contents xsi:type="CPL:SubCall" ref="handleBobCall"/>
        </addresses>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="400" reason="Missing To header"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="User Busy"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="no"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Location" url="sip:fallback@example.com" priority="0.8" clear="yes"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Reject" status="500" reason="Server Error"/>
            </failure>
            <default>
              <contents xsi:type="CPL:SubCall" ref="finalAttempt"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </subActions>

    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="support" contains="ticket">
          <contents xsi:type="CPL:Proxy" timeout="45" recurse="no" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:support-queue@example.com" priority="0.7" clear="no"/>
            </busy>
            <default>
              <contents xsi:type="CPL:Redirect" permanent="yes"/>
            </default>
          </contents>
        </strings>
        <strings is="marketing" contains="newsletter">
          <contents xsi:type="CPL:Location" url="sip:marketing@example.org" priority="0.9" clear="yes"/>
        </strings>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="480" reason="No Subject"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:general@example.com" priority="0.6" clear="no"/>
        </otherwise>
      </contents>
    </outgoing>

    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="UTC" tzurl="http://tz.example.com/utc">
        <times dtstart="20240101T080000Z" dtend="20240101T170000Z" duration="9h" freq="DAILY"
               until="20241231T235959Z" count="365" interval="1" bySecond="0" byMinute="0"
               byHour="8" byDay="MO,TU,WE,TH,FR" byMonthDay="" byYearDay="" byWeekNo=""
               byMonth="" wkst="MO" bySetPos="">
          <contents xsi:type="CPL:Location" url="sip:business-hours@example.com" priority="0.4" clear="yes"/>
        </times>
        <times dtstart="20240101T170000Z" dtend="20240102T075959Z" duration="16h" freq="DAILY"
               until="" count="" interval="1" bySecond="" byMinute="" byHour=""
               byDay="MO,TU,WE,TH,FR" byMonthDay="" byYearDay="" byWeekNo=""
               byMonth="" wkst="MO" bySetPos="">
          <contents xsi:type="CPL:Location" url="sip:after-hours@example.com" priority="0.2" clear="no"/>
        </times>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="403" reason="Time Not Specified"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:default-time@example.com" priority="0.3" clear="yes"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>

  <!-- 1: SubCall referenced from within subActions -->
  <elements xsi:type="CPL:SubCall" ref="handleBobCall"/>

  <!-- 2: Location referenced from a Proxy default via contents path -->
  <elements xsi:type="CPL:Location" url="sip:final@example.com" priority="0.1" clear="yes"/>

  <!-- 3: Additional SubCall used by Proxy default in welcomeFlow -->
  <elements xsi:type="CPL:SubCall" ref="finalAttempt"/>

  <!-- 4: Top-level AddressSwitch using various switched nodes -->
  <elements xsi:type="CPL:AddressSwitch" field="From" subField="domain">
    <addresses is="vip.example.com" contains="" subDomainOf="">
      <contents xsi:type="CPL:Proxy" timeout="20" recurse="yes" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:Location" url="sip:vip-busy@example.com" priority="0.3" clear="no"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Reject" status="408" reason="VIP No Answer"/>
        </noAnswer>
        <default>
          <contents xsi:type="CPL:Location" url="sip:vip-default@example.com" priority="0.2" clear="yes"/>
        </default>
      </contents>
    </addresses>
    <addresses is="" contains="partner.example.org" subDomainOf="example.org">
      <contents xsi:type="CPL:Location" url="sip:partner-gateway@example.org" priority="0.5" clear="yes"/>
    </addresses>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="401" reason="From header required"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:generic-inbound@example.net" priority="0.6" clear="no"/>
    </otherwise>
  </elements>

  <!-- 5: Top-level StringSwitch -->
  <elements xsi:type="CPL:StringSwitch" field="user-agent">
    <strings is="softphone" contains="">
      <contents xsi:type="CPL:Location" url="sip:softphone-support@example.com" priority="0.3" clear="yes"/>
    </strings>
    <strings is="" contains="mobile">
      <contents xsi:type="CPL:Proxy" timeout="25" recurse="no" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Redirect" permanent="no"/>
        </busy>
        <default>
          <contents xsi:type="CPL:Reject" status="503" reason="Mobile Service Unavailable"/>
        </default>
      </contents>
    </strings>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:unknown-device@example.com" priority="0.9" clear="no"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="488" reason="Unsupported User Agent"/>
    </otherwise>
  </elements>

  <!-- 6: Top-level LanguageSwitch -->
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en">
      <contents xsi:type="CPL:Location" url="sip:en-support@example.com" priority="0.4" clear="yes"/>
    </languages>
    <languages matches="fr">
      <contents xsi:type="CPL:Location" url="sip:fr-support@example.fr" priority="0.4" clear="yes"/>
    </languages>
    <languages matches="es">
      <contents xsi:type="CPL:Location" url="sip:es-support@example.es" priority="0.4" clear="yes"/>
    </languages>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="406" reason="Language Not Acceptable"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:multi-lang@example.com" priority="0.5" clear="no"/>
    </otherwise>
  </elements>

  <!-- 7: Top-level TimeSwitch -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Berlin" tzurl="">
    <times dtstart="20240101T000000" dtend="" duration="P1D" freq="WEEKLY"
           until="" count="" interval="1" bySecond="" byMinute="" byHour="10"
           byDay="SA,SU" byMonthDay="" byYearDay="" byWeekNo="" byMonth=""
           wkst="MO" bySetPos="">
      <contents xsi:type="CPL:Location" url="sip:weekend@example.com" priority="0.2" clear="yes"/>
    </times>
    <times dtstart="20240101T000000" dtend="" duration="" freq=""
           until="" count="" interval="2" bySecond="" byMinute="" byHour=""
           byDay="" byMonthDay="" byYearDay="" byWeekNo="" byMonth=""
           wkst="MO" bySetPos="">
      <contents xsi:type="CPL:Location" url="sip:biweekly@example.com" priority="0.2" clear="no"/>
    </times>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="482" reason="Time Rules Missing"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:time-fallback@example.com" priority="0.1" clear="yes"/>
    </otherwise>
  </elements>

  <!-- 8: Top-level PrioritySwitch -->
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="0.3" greater="" equal="">
      <contents xsi:type="CPL:Location" url="sip:low-priority@example.com" priority="0.1" clear="no"/>
    </priorities>
    <priorities less="" greater="0.8" equal="">
      <contents xsi:type="CPL:Proxy" timeout="15" recurse="yes" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:Reject" status="486" reason="High Priority Busy"/>
        </busy>
        <default>
          <contents xsi:type="CPL:Location" url="sip:high-priority@example.com" priority="1.0" clear="yes"/>
        </default>
      </contents>
    </priorities>
    <priorities less="" greater="" equal="0.5">
      <contents xsi:type="CPL:Location" url="sip:medium-priority@example.com" priority="0.5" clear="no"/>
    </priorities>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="500" reason="Priority Unknown"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:priority-fallback@example.com" priority="0.4" clear="yes"/>
    </otherwise>
  </elements>

  <!-- 9: Top-level Proxy referencing top-level Location via contents path -->
  <elements xsi:type="CPL:Proxy" timeout="60" recurse="no" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy-handler@example.net" priority="0.6" clear="no"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Reject" status="480" reason="No Answer Global"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Redirect" permanent="no"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="503" reason="Global Failure"/>
    </failure>
    <default>
      <contents xsi:type="CPL:Location" url="sip:final@example.com" priority="0.1" clear="yes"/>
    </default>
  </elements>

  <!-- 10: Top-level Redirect -->
  <elements xsi:type="CPL:Redirect" permanent="yes"/>

  <!-- 11: Top-level Reject -->
  <elements xsi:type="CPL:Reject" status="603" reason="Decline"/>

  <!-- 12: Top-level Location used standalone -->
  <elements xsi:type="CPL:Location" url="sip:standalone@example.com" priority="0.7" clear="no"/>

  <!-- 13: Another SubCall to exercise plain-string refs -->
  <elements xsi:type="CPL:SubCall" ref="logCallDetails"/>

</CPL:CPLModel>