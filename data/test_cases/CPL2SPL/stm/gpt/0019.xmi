<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL script referencing switches and actions -->
  <elements xsi:type="CPL:CPL">
    <!-- SubActions defined inside CPL -->
    <subActions id="mainFlow">
      <contents href="//@elements.2"/>
      <contents href="//@elements.3"/>
      <contents href="//@elements.4"/>
    </subActions>
    <subActions id="backupFlow">
      <contents href="//@elements.5"/>
      <contents href="//@elements.10"/>
    </subActions>

    <!-- Outgoing and Incoming containers referencing locations and switches -->
    <outgoing>
      <contents href="//@elements.2"/>
      <contents href="//@elements.6"/>
    </outgoing>
    <incoming>
      <contents href="//@elements.7"/>
      <contents href="//@elements.8"/>
    </incoming>
  </elements>

  <!-- 1: SubCall to backupFlow -->
  <elements xsi:type="CPL:SubCall" ref="backupFlow"/>

  <!-- 2: Location used in several containers -->
  <elements xsi:type="CPL:Location" url="sip:primary@example.com" priority="1" clear="yes">
    <!-- Location also acts as a NodeContainer, pointing to a switch -->
    <contents href="//@elements.3"/>
  </elements>

  <!-- 3: TimeSwitch with various SwitchedTime entries and NotPresent/Otherwise blocks -->
  <elements xsi:type="CPL:TimeSwitch" tzid="UTC" tzurl="http://tz.example.com/UTC">
    <times dtstart="20260101T080000Z" dtend="20260101T170000Z"
           duration="PT9H" freq="DAILY" until="20261231T235959Z"
           count="100" interval="1" bySecond="0,30" byMinute="0,30"
           byHour="8,9,10,11,12,13,14,15,16"
           byDay="MO,TU,WE,TH,FR" byMonthDay="1,15"
           byYearDay="10,200" byWeekNo="1,2"
           byMonth="1,6" wkst="MO" bySetPos="1,-1">
      <contents href="//@elements.5"/>
    </times>
    <times dtstart="20260101T170000Z" interval="2" wkst="SU">
      <contents href="//@elements.6"/>
    </times>
    <notPresent>
      <contents href="//@elements.10"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.4"/>
    </otherwise>
  </elements>

  <!-- 4: PrioritySwitch with SwitchedPriority entries -->
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="0.3" equal="0.5" greater="0.7">
      <contents href="//@elements.2"/>
    </priorities>
    <priorities less="0.1" greater="0.2">
      <contents href="//@elements.7"/>
    </priorities>
    <notPresent>
      <contents href="//@elements.8"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.9"/>
    </otherwise>
  </elements>

  <!-- 5: Redirect signalling action -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 6: Proxy with all outcome branches and nested contents -->
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <busy>
      <contents href="//@elements.7"/>
      <contents href="//@elements.2"/>
    </busy>
    <noAnswer>
      <contents href="//@elements.8"/>
    </noAnswer>
    <redirection>
      <contents href="//@elements.9"/>
      <contents href="//@elements.5"/>
    </redirection>
    <failure>
      <contents href="//@elements.10"/>
    </failure>
    <default>
      <contents href="//@elements.1"/>
    </default>
  </elements>

  <!-- 7: AddressSwitch using multiple SwitchedAddress cases -->
  <elements xsi:type="CPL:AddressSwitch" field="from" subField="host">
    <addresses is="vip.example.com" contains="vip" subDomainOf="example.com">
      <contents href="//@elements.2"/>
    </addresses>
    <addresses is="guest.example.org" contains="guest" subDomainOf="example.org">
      <contents href="//@elements.6"/>
    </addresses>
    <notPresent>
      <contents href="//@elements.5"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.9"/>
    </otherwise>
  </elements>

  <!-- 8: StringSwitch with multiple SwitchedString cases -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="support" contains="support">
      <contents href="//@elements.10"/>
    </strings>
    <strings is="sales" contains="sale">
      <contents href="//@elements.2"/>
    </strings>
    <notPresent>
      <contents href="//@elements.3"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.6"/>
    </otherwise>
  </elements>

  <!-- 9: LanguageSwitch with multiple SwitchedLanguage entries -->
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en">
      <contents href="//@elements.2"/>
    </languages>
    <languages matches="fr">
      <contents href="//@elements.5"/>
    </languages>
    <languages matches="es">
      <contents href="//@elements.6"/>
    </languages>
    <notPresent>
      <contents href="//@elements.10"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.1"/>
    </otherwise>
  </elements>

  <!-- 10: Reject signalling action with status and reason -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>

</CPL:CPLModel>