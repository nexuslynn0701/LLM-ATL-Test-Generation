<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL with subactions and incoming/outgoing -->
  <elements xsi:type="CPL:CPL">
    <subActions id="sa-main">
      <!-- SubAction contents reference top-level elements 1,2,3,4,5 -->
      <contents href="//@elements.1"/>
      <contents href="//@elements.2"/>
      <contents href="//@elements.3"/>
      <contents href="//@elements.4"/>
      <contents href="//@elements.5"/>
    </subActions>
    <subActions id="sa-secondary">
      <!-- SubAction contents reference Location and SubCall -->
      <contents href="//@elements.6"/>
      <contents href="//@elements.7"/>
    </subActions>
    <outgoing>
      <contents href="//@elements.2"/>
      <contents href="//@elements.3"/>
    </outgoing>
    <incoming>
      <contents href="//@elements.1"/>
      <contents href="//@elements.5"/>
    </incoming>
  </elements>

  <!-- 1: AddressSwitch with NotPresent, Otherwise and two SwitchedAddress entries -->
  <elements xsi:type="CPL:AddressSwitch" field="from" subField="user">
    <notPresent>
      <contents href="//@elements.6"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.7"/>
    </otherwise>
    <addresses is="alice" contains="example.com" subDomainOf="example.org">
      <contents href="//@elements.3"/>
    </addresses>
    <addresses is="bob" contains="example.net" subDomainOf="example.net">
      <contents href="//@elements.4"/>
    </addresses>
  </elements>

  <!-- 2: StringSwitch with NotPresent, Otherwise and two SwitchedString entries -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <notPresent>
      <contents href="//@elements.5"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.6"/>
    </otherwise>
    <strings is="promo" contains="sale">
      <contents href="//@elements.1"/>
    </strings>
    <strings is="support" contains="ticket">
      <contents href="//@elements.7"/>
    </strings>
  </elements>

  <!-- 3: LanguageSwitch with languages -->
  <elements xsi:type="CPL:LanguageSwitch">
    <notPresent>
      <contents href="//@elements.6"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.5"/>
    </otherwise>
    <languages matches="en">
      <contents href="//@elements.4"/>
    </languages>
    <languages matches="fr">
      <contents href="//@elements.6"/>
    </languages>
  </elements>

  <!-- 4: TimeSwitch with complex SwitchedTime entries -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.org/paris">
    <notPresent>
      <contents href="//@elements.7"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.6"/>
    </otherwise>
    <times dtstart="20240101T080000" dtend="20240101T180000" duration="PT10H"
           freq="DAILY" until="20241231T235959" count="365"
           interval="1" bySecond="0" byMinute="0"
           byHour="8,9,10" byDay="MO,TU,WE,TH,FR" byMonthDay="1,2,3"
           byYearDay="10,20" byWeekNo="1,2" byMonth="1,2,3" wkst="MO">
      <contents href="//@elements.5"/>
    </times>
    <times dtstart="20240101T000000" duration="PT24H"
           interval="2" wkst="SU">
      <contents href="//@elements.1"/>
    </times>
  </elements>

  <!-- 5: PrioritySwitch with SwitchedPriority entries -->
  <elements xsi:type="CPL:PrioritySwitch">
    <notPresent>
      <contents href="//@elements.6"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.7"/>
    </otherwise>
    <priorities less="0.3" greater="0.0" equal="">
      <contents href="//@elements.3"/>
    </priorities>
    <priorities less="" greater="0.7" equal="0.7">
      <contents href="//@elements.4"/>
    </priorities>
  </elements>

  <!-- 6: Location as both Node and NodeContainer -->
  <elements xsi:type="CPL:Location" url="sip:alice@example.com" priority="0.5" clear="no">
    <!-- Location contents reference some switches and actions -->
    <contents href="//@elements.2"/>
    <contents href="//@elements.8"/>
  </elements>

  <!-- 7: SubCall referencing a subaction by name (string only) -->
  <elements xsi:type="CPL:SubCall" ref="sa-secondary"/>

  <!-- 8: Proxy with all failure cases and contents in child containers -->
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <busy>
      <contents href="//@elements.9"/>
    </busy>
    <noAnswer>
      <contents href="//@elements.10"/>
    </noAnswer>
    <redirection>
      <contents href="//@elements.6"/>
    </redirection>
    <failure>
      <contents href="//@elements.11"/>
    </failure>
    <default>
      <contents href="//@elements.7"/>
    </default>
  </elements>

  <!-- 9: Redirect action -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 10: Reject with status and reason -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>

  <!-- 11: Another Location used from Proxy.failure -->
  <elements xsi:type="CPL:Location" url="sip:backup@example.net" priority="0.8" clear="yes">
    <contents href="//@elements.10"/>
  </elements>

</CPL:CPLModel>