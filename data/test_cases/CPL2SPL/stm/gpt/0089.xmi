<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL element with incoming/outgoing and subActions -->
  <elements xsi:type="CPL:CPL">
    <subActions xsi:type="CPL:SubAction" id="sa-main">
      <contents>//@elements.1</contents>
      <contents>//@elements.2</contents>
    </subActions>
    <subActions xsi:type="CPL:SubAction" id="sa-secondary">
      <contents>//@elements.4</contents>
    </subActions>
    <outgoing>
      <contents>//@elements.5</contents>
      <contents>//@elements.6</contents>
    </outgoing>
    <incoming>
      <contents>//@elements.7</contents>
    </incoming>
  </elements>

  <!-- 1: Location used by subAction sa-main and by switches -->
  <elements xsi:type="CPL:Location" url="sip:user1@example.com" priority="1" clear="yes">
    <contents>//@elements.3</contents>
  </elements>

  <!-- 2: SubCall referenced by Proxy.default and by a SubAction -->
  <elements xsi:type="CPL:SubCall" ref="call-handler-01"/>

  <!-- 3: Redirect signalling action -->
  <elements xsi:type="CPL:Redirect" permanent="no"/>

  <!-- 4: Reject signalling action -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>

  <!-- 5: Proxy with all child containers and contents -->
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <busy>
      <contents>//@elements.1</contents>
    </busy>
    <noAnswer>
      <contents>//@elements.4</contents>
    </noAnswer>
    <redirection>
      <contents>//@elements.3</contents>
    </redirection>
    <failure>
      <contents>//@elements.6</contents>
    </failure>
    <default>
      <contents>//@elements.2</contents>
    </default>
  </elements>

  <!-- 6: AddressSwitch using NotPresent, Otherwise and several SwitchedAddress -->
  <elements xsi:type="CPL:AddressSwitch" field="from" subField="user">
    <addresses is="alice" contains="example.com" subDomainOf="corp.example.com">
      <contents>//@elements.1</contents>
    </addresses>
    <addresses is="bob" contains="example.org" subDomainOf="sales.example.org">
      <contents>//@elements.3</contents>
    </addresses>
    <notPresent>
      <contents>//@elements.4</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.5</contents>
    </otherwise>
  </elements>

  <!-- 7: StringSwitch with two SwitchedString branches -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent" contains="support">
      <contents>//@elements.1</contents>
    </strings>
    <strings is="info" contains="general">
      <contents>//@elements.2</contents>
    </strings>
    <notPresent>
      <contents>//@elements.3</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.4</contents>
    </otherwise>
  </elements>

  <!-- 8: LanguageSwitch with multiple SwitchedLanguage options -->
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en">
      <contents>//@elements.5</contents>
    </languages>
    <languages matches="fr">
      <contents>//@elements.6</contents>
    </languages>
    <languages matches="es">
      <contents>//@elements.7</contents>
    </languages>
    <notPresent>
      <contents>//@elements.1</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.4</contents>
    </otherwise>
  </elements>

  <!-- 9: TimeSwitch with rich SwitchedTime configuration -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
    <times dtstart="20260101T080000" dtend="20260101T180000" duration="PT10H"
           freq="DAILY" until="20261231T235959" count="10" interval="1"
           bySecond="0" byMinute="0" byHour="8,18" byDay="MO,TU,WE,TH,FR"
           byMonthDay="1-31" byYearDay="1-365" byWeekNo="1-52" byMonth="1-12"
           wkst="MO" bySetPos="1">
      <contents>//@elements.1</contents>
    </times>
    <times dtstart="20260102T090000" interval="2" wkst="SU">
      <contents>//@elements.2</contents>
    </times>
    <notPresent>
      <contents>//@elements.3</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.4</contents>
    </otherwise>
  </elements>

  <!-- 10: PrioritySwitch with several SwitchedPriority entries -->
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="0.3" equal="0.3" greater="0.3">
      <contents>//@elements.1</contents>
    </priorities>
    <priorities less="0.5" equal="0.5" greater="0.5">
      <contents>//@elements.3</contents>
    </priorities>
    <notPresent>
      <contents>//@elements.2</contents>
    </notPresent>
    <otherwise>
      <contents>//@elements.4</contents>
    </otherwise>
  </elements>

</CPL:CPLModel>