<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL script with various sub-containers -->
  <elements xsi:type="CPL:CPL">
    <!-- SubActions -->
    <subActions id="welcomeFlow">
      <!-- reference to proxy at elements[3] -->
      <contents href="//@elements.3"/>
      <!-- reference to location at elements[2] -->
      <contents href="//@elements.2"/>
    </subActions>
    <subActions id="voicemailFlow">
      <!-- reference to TimeSwitch at elements[6] -->
      <contents href="//@elements.6"/>
    </subActions>

    <!-- Outgoing scenario: contains Redirect and Proxy -->
    <outgoing>
      <!-- reference to redirect at elements[4] -->
      <contents href="//@elements.4"/>
      <!-- reference to proxy at elements[3] -->
      <contents href="//@elements.3"/>
    </outgoing>

    <!-- Incoming scenario: contains an AddressSwitch -->
    <incoming>
      <!-- reference to AddressSwitch at elements[5] -->
      <contents href="//@elements.5"/>
    </incoming>
  </elements>

  <!-- 1: SubCall referencing a sub-action by name -->
  <elements xsi:type="CPL:SubCall" ref="welcomeFlow"/>

  <!-- 2: Location node used as a terminal action -->
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="5" clear="yes"/>

  <!-- 3: Proxy with all sub-containers and contents links -->
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
    <busy>
      <!-- on busy, send to voicemailFlow TimeSwitch at elements[6] -->
      <contents href="//@elements.6"/>
    </busy>
    <noAnswer>
      <!-- on no answer, go to Reject at elements[7] -->
      <contents href="//@elements.7"/>
    </noAnswer>
    <redirection>
      <!-- on redirection, go directly to Location at elements[2] -->
      <contents href="//@elements.2"/>
    </redirection>
    <failure>
      <!-- on failure, call SubCall at elements[1] -->
      <contents href="//@elements.1"/>
    </failure>
    <default>
      <!-- default branch goes to AddressSwitch at elements[5] -->
      <contents href="//@elements.5"/>
    </default>
  </elements>

  <!-- 4: Redirect signalling action -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 5: AddressSwitch with multiple SwitchedAddress entries -->
  <elements xsi:type="CPL:AddressSwitch" field="To" subField="user">
    <!-- specific address 1 -->
    <addresses is="alice" contains="" subDomainOf="">
      <!-- goes to Location at elements[2] -->
      <contents href="//@elements.2"/>
    </addresses>
    <!-- specific address 2 -->
    <addresses is="bob" contains="" subDomainOf="">
      <!-- goes to Proxy at elements[3] -->
      <contents href="//@elements.3"/>
    </addresses>
    <!-- domain-based rule -->
    <addresses is="" contains="support" subDomainOf="example.com">
      <!-- goes to TimeSwitch at elements[6] -->
      <contents href="//@elements.6"/>
    </addresses>

    <!-- notPresent and otherwise branches -->
    <notPresent>
      <!-- if header absent, go to Redirect at elements[4] -->
      <contents href="//@elements.4"/>
    </notPresent>
    <otherwise>
      <!-- otherwise, go to Reject at elements[7] -->
      <contents href="//@elements.7"/>
    </otherwise>
  </elements>

  <!-- 6: TimeSwitch with multiple SwitchedTime entries and wkst/dtstart/interval set -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
    <!-- business hours rule -->
    <times dtstart="20240101T090000" dtend="20240101T180000" duration="" freq="DAILY" until="" count="" interval="1"
           bySecond="" byMinute="" byHour="9,10,11,12,13,14,15,16,17" byDay="MO,TU,WE,TH,FR" byMonthDay=""
           byYearDay="" byWeekNo="" byMonth="" wkst="MO" bySetPos="">
      <!-- during business hours, send to Location at elements[2] -->
      <contents href="//@elements.2"/>
    </times>
    <!-- off-hours rule -->
    <times dtstart="20240101T180001" dtend="20240102T085959" duration="" freq="DAILY" until="" count="" interval="1"
           bySecond="" byMinute="" byHour="" byDay="MO,TU,WE,TH,FR,SA,SU" byMonthDay="" byYearDay=""
           byWeekNo="" byMonth="" wkst="MO" bySetPos="">
      <!-- off-hours go to SubCall at elements[1] -->
      <contents href="//@elements.1"/>
    </times>

    <!-- notPresent and otherwise branches -->
    <notPresent>
      <!-- no time info: proxy again -->
      <contents href="//@elements.3"/>
    </notPresent>
    <otherwise>
      <!-- otherwise, reject -->
      <contents href="//@elements.7"/>
    </otherwise>
  </elements>

  <!-- 7: Reject signalling action -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
</CPL:CPLModel>