<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL with incoming/outgoing and multiple subActions -->
  <elements xsi:type="CPL:CPL">
    <subActions xsi:type="CPL:SubAction" id="subAlpha">
      <!-- SubAction contents reference various top-level nodes -->
      <contents href="//@elements.3"/>
      <contents href="//@elements.4"/>
      <contents href="//@elements.5"/>
    </subActions>
    <subActions xsi:type="CPL:SubAction" id="subBeta">
      <contents href="//@elements.6"/>
      <contents href="//@elements.7"/>
    </subActions>
    <outgoing>
      <contents href="//@elements.2"/>
      <contents href="//@elements.3"/>
    </outgoing>
    <incoming>
      <contents href="//@elements.1"/>
      <contents href="//@elements.8"/>
    </incoming>
  </elements>

  <!-- 1: TimeSwitch with complex SwitchedTime and both notPresent/otherwise -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="tzdb://europe/paris">
    <notPresent>
      <contents href="//@elements.4"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.5"/>
      <contents href="//@elements.6"/>
    </otherwise>
    <times dtstart="20240101T090000" dtend="20240101T170000"
           duration="PT8H" freq="DAILY" until="20241231T235959"
           count="365" interval="1"
           bySecond="0" byMinute="0" byHour="9,10,11,12,13,14,15,16"
           byDay="MO,TU,WE,TH,FR" byMonthDay="1-31" byYearDay="1-365"
           byWeekNo="1-52" byMonth="1-12" wkst="MO" bySetPos="1">
      <contents href="//@elements.2"/>
      <contents href="//@elements.3"/>
    </times>
    <times dtstart="20240101T000000" interval="2" wkst="SU">
      <contents href="//@elements.7"/>
    </times>
  </elements>

  <!-- 2: AddressSwitch with multiple SwitchedAddress, notPresent, otherwise -->
  <elements xsi:type="CPL:AddressSwitch" field="from" subField="user">
    <notPresent>
      <contents href="//@elements.8"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.5"/>
    </otherwise>
    <addresses is="alice" contains="example.com" subDomainOf="corp.example.com">
      <contents href="//@elements.4"/>
    </addresses>
    <addresses is="bob" contains="sales" subDomainOf="sales.example.com">
      <contents href="//@elements.6"/>
    </addresses>
    <addresses contains="support">
      <contents href="//@elements.3"/>
    </addresses>
  </elements>

  <!-- 3: StringSwitch with several SwitchedString -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <notPresent>
      <contents href="//@elements.7"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.4"/>
      <contents href="//@elements.6"/>
    </otherwise>
    <strings is="urgent">
      <contents href="//@elements.5"/>
    </strings>
    <strings contains="[test]">
      <contents href="//@elements.8"/>
    </strings>
  </elements>

  <!-- 4: PrioritySwitch with SwitchedPriority -->
  <elements xsi:type="CPL:PrioritySwitch">
    <notPresent>
      <contents href="//@elements.6"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.7"/>
    </otherwise>
    <priorities less="0.3">
      <contents href="//@elements.5"/>
    </priorities>
    <priorities greater="0.8">
      <contents href="//@elements.3"/>
    </priorities>
    <priorities equal="0.5">
      <contents href="//@elements.2"/>
    </priorities>
  </elements>

  <!-- 5: LanguageSwitch with multiple SwitchedLanguage -->
  <elements xsi:type="CPL:LanguageSwitch">
    <notPresent>
      <contents href="//@elements.2"/>
    </notPresent>
    <otherwise>
      <contents href="//@elements.8"/>
    </otherwise>
    <languages matches="en">
      <contents href="//@elements.6"/>
    </languages>
    <languages matches="fr">
      <contents href="//@elements.7"/>
    </languages>
  </elements>

  <!-- 6: Proxy with all child branches and several contents uses -->
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <busy>
      <contents href="//@elements.8"/>
      <contents href="//@elements.9"/>
    </busy>
    <noAnswer>
      <contents href="//@elements.10"/>
    </noAnswer>
    <redirection>
      <contents href="//@elements.7"/>
    </redirection>
    <failure>
      <contents href="//@elements.11"/>
    </failure>
    <default>
      <contents href="//@elements.3"/>
      <contents href="//@elements.4"/>
    </default>
  </elements>

  <!-- 7: Location also as NodeContainer, chaining to others -->
  <elements xsi:type="CPL:Location" url="sip:agent1@example.com" priority="0.7" clear="no">
    <contents href="//@elements.8"/>
    <contents href="//@elements.2"/>
  </elements>

  <!-- 8: Location with different attributes -->
  <elements xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="0.2" clear="yes">
    <contents href="//@elements.9"/>
  </elements>

  <!-- 9: SubCall referring to a SubAction via string id -->
  <elements xsi:type="CPL:SubCall" ref="subAlpha"/>

  <!-- 10: Redirect signalling action -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 11: Reject signalling action -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>

</CPL:CPLModel>