<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
              xmlns:xmi="http://www.omg.org/XMI"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:CPL="http://cpl/1.0">

  <!-- 0: Main CPL script with various node containers -->
  <elements xsi:type="CPL:CPL">
    <!-- A SubAction containing a switch node -->
    <subActions id="subA">
      <contents xsi:type="CPL:AddressSwitch" field="To" subField="user">
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:nopresent@example.com" clear="yes" priority="0.5"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:otherwise@example.com" clear="no" priority="0.7"/>
        </otherwise>
        <addresses is="user1" contains="example.com" subDomainOf="example.org">
          <contents xsi:type="CPL:SubCall" ref="subSequence1"/>
        </addresses>
        <addresses is="user2" contains="sub.example.com" subDomainOf="example.net">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential" timeout="40">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="yes" priority="1.0"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Reject" status="500" reason="Server Failure"/>
            </failure>
            <default>
              <contents xsi:type="CPL:SubCall" ref="fallbackRoute"/>
            </default>
          </contents>
        </addresses>
      </contents>
    </subActions>

    <!-- Outgoing node container referencing top-level nodes via contents -->
    <outgoing>
      <contents xsi:type="CPL:Location" url="sip:out1@example.com" clear="yes" priority="0.3"/>
      <contents xsi:type="CPL:SubCall" ref="subRouteOutgoing"/>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel" timeout="25">
        <busy>
          <contents xsi:type="CPL:Location" url="sip:backup@example.com" clear="yes" priority="0.2"/>
        </busy>
        <default>
          <contents xsi:type="CPL:Reject" status="480" reason="No Answer"/>
        </default>
      </contents>
    </outgoing>

    <!-- Incoming node container using a TimeSwitch -->
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
        <notPresent>
          <contents xsi:type="CPL:Reject" status="400" reason="Bad Time"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:desk@example.com" clear="yes" priority="0.1"/>
        </otherwise>
        <times dtstart="20260101T080000" dtend="20260101T170000" duration="PT9H"
               freq="DAILY" until="20261231T235959" count="10" interval="1"
               bySecond="0" byMinute="0" byHour="8" byDay="MO,TU,WE,TH,FR"
               byMonthDay="*" byYearDay="*" byWeekNo="*" byMonth="*" wkst="MO"
               bySetPos="1">
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="20">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:assistant@example.com" clear="no" priority="0.4"/>
            </busy>
            <default>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </default>
          </contents>
        </times>
      </contents>
    </incoming>
  </elements>

  <!-- 1: Standalone SubCall -->
  <elements xsi:type="CPL:SubCall" ref="subSequence1"/>

  <!-- 2: Standalone Location (referenced via contents from node containers) -->
  <elements xsi:type="CPL:Location" url="sip:mobile@example.com" clear="yes" priority="0.9"/>

  <!-- 3: Standalone Proxy with all result branches filled -->
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="15">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@example.com" clear="no" priority="0.6"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Reject" status="408" reason="Request Timeout"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
    </failure>
    <default>
      <contents xsi:type="CPL:SubCall" ref="defaultProxyPath"/>
    </default>
  </elements>

  <!-- 4: AddressSwitch at top level -->
  <elements xsi:type="CPL:AddressSwitch" field="From" subField="domain">
    <notPresent>
      <contents xsi:type="CPL:Reject" status="404" reason="Unknown Caller"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:operator@example.com" clear="yes" priority="0.8"/>
    </otherwise>
    <addresses is="vip" contains="vip.example.com" subDomainOf="example.com">
      <contents xsi:type="CPL:Location" url="sip:vipdesk@example.com" clear="yes" priority="0.1"/>
    </addresses>
  </elements>

  <!-- 5: StringSwitch at top level -->
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:nosubject@example.com" clear="no" priority="0.5"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="subjectFallback"/>
    </otherwise>
    <strings is="support" contains="ticket">
      <contents xsi:type="CPL:Location" url="sip:support@example.com" clear="yes" priority="0.2"/>
    </strings>
    <strings is="sales" contains="offer">
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="30">
        <busy>
          <contents xsi:type="CPL:Location" url="sip:sales-queue@example.com" clear="yes" priority="0.3"/>
        </busy>
        <default>
          <contents xsi:type="CPL:Location" url="sip:sales-vm@example.com" clear="yes" priority="0.9"/>
        </default>
      </contents>
    </strings>
  </elements>

  <!-- 6: LanguageSwitch at top level -->
  <elements xsi:type="CPL:LanguageSwitch">
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:default-lang@example.com" clear="yes" priority="0.5"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="langDefaultFlow"/>
    </otherwise>
    <languages matches="en">
      <contents xsi:type="CPL:Location" url="sip:english@example.com" clear="yes" priority="0.3"/>
    </languages>
    <languages matches="fr">
      <contents xsi:type="CPL:Location" url="sip:french@example.com" clear="yes" priority="0.3"/>
    </languages>
  </elements>

  <!-- 7: TimeSwitch at top level -->
  <elements xsi:type="CPL:TimeSwitch" tzid="UTC" tzurl="">
    <notPresent>
      <contents xsi:type="CPL:Reject" status="489" reason="Bad Time Condition"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="anytimeFlow"/>
    </otherwise>
    <times dtstart="20260101T000000" dtend="20261231T235959" duration="" freq="WEEKLY"
           until="" count="" interval="1" bySecond="" byMinute="" byHour="9"
           byDay="MO,TU,WE,TH,FR" byMonthDay="" byYearDay="" byWeekNo=""
           byMonth="" wkst="MO" bySetPos="">
      <contents xsi:type="CPL:Location" url="sip:business-hours@example.com" clear="yes" priority="0.4"/>
    </times>
  </elements>

  <!-- 8: PrioritySwitch at top level -->
  <elements xsi:type="CPL:PrioritySwitch">
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:nopriority@example.com" clear="yes" priority="0.5"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="priorityDefault"/>
    </otherwise>
    <priorities less="0.3" greater="" equal="">
      <contents xsi:type="CPL:Location" url="sip:lowprio@example.com" clear="yes" priority="0.2"/>
    </priorities>
    <priorities less="" greater="0.7" equal="">
      <contents xsi:type="CPL:Location" url="sip:highprio@example.com" clear="yes" priority="0.9"/>
    </priorities>
    <priorities less="" greater="" equal="0.5">
      <contents xsi:type="CPL:Location" url="sip:midprio@example.com" clear="yes" priority="0.5"/>
    </priorities>
  </elements>

  <!-- 9: Standalone Redirect -->
  <elements xsi:type="CPL:Redirect" permanent="false"/>

  <!-- 10: Standalone Reject -->
  <elements xsi:type="CPL:Reject" status="603" reason="Decline"/>
</CPL:CPLModel>