<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0"
              xmlns:xmi="http://www.omg.org/XMI"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:CPL="http://cpl/1.0">

  <!-- 0: Root CPL script with incoming/outgoing sections and a Location inside -->
  <elements xsi:type="CPL:CPL">
    <incoming contents="//@elements.3 //@elements.4"/>
    <outgoing contents="//@elements.1 //@elements.2"/>
    <subActions>
      <contents xsi:type="CPL:Location" url="sip:rootloc@example.com" priority="1" clear="yes"/>
    </subActions>
  </elements>

  <!-- 1: Location referenced by CPL.outgoing -->
  <elements xsi:type="CPL:Location" url="sip:alice@example.com" priority="10" clear="no"/>

  <!-- 2: Location referenced by CPL.outgoing and by Proxy/branches -->
  <elements xsi:type="CPL:Location" url="sip:bob@example.org" priority="5" clear="yes"/>

  <!-- 3: SubCall referenced by CPL.incoming and by Switches/Proxy -->
  <elements xsi:type="CPL:SubCall" ref="subActionAlpha"/>

  <!-- 4: SubCall referenced by CPL.incoming and Proxy -->
  <elements xsi:type="CPL:SubCall" ref="subActionBeta"/>

  <!-- 5: Redirect action -->
  <elements xsi:type="CPL:Redirect" permanent="true"/>

  <!-- 6: Reject action -->
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>

  <!-- 7: Proxy with all response sections, some containing Nodes -->
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@example.net" priority="3" clear="yes"/>
      <contents xsi:type="CPL:SubCall" ref="busyHandler"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:SubCall" ref="noAnswerHandler"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Location" url="sip:redirect@example.net" priority="2" clear="no"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:SubCall" ref="failureHandler"/>
      <contents xsi:type="CPL:Location" url="sip:failover@example.com" priority="8" clear="yes"/>
    </failure>
    <default>
      <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="7" clear="no"/>
      <contents xsi:type="CPL:SubCall" ref="defaultHandler"/>
    </default>
  </elements>

  <!-- 8: AddressSwitch with NotPresent/Otherwise and two SwitchedAddress cases -->
  <elements xsi:type="CPL:AddressSwitch" field="From" subField="host">
    <notPresent>
      <contents xsi:type="CPL:Reject" status="400" reason="Address Missing"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Proxy" timeout="15" recurse="no" ordering="parallel">
        <busy/>
        <default>
          <contents xsi:type="CPL:Location" url="sip:otherwise@example.com" priority="4" clear="yes"/>
        </default>
      </contents>
    </otherwise>
    <addresses is="example.com" contains="corp" subDomainOf="example.com">
      <contents xsi:type="CPL:Location" url="sip:sales@example.com" priority="1" clear="yes"/>
    </addresses>
    <addresses is="partners.example.org" contains="partner" subDomainOf="example.org">
      <contents xsi:type="CPL:SubCall" ref="partnerHandler"/>
    </addresses>
  </elements>

  <!-- 9: StringSwitch with NotPresent/Otherwise and two SwitchedString cases -->
  <elements xsi:type="CPL:StringSwitch" field="Subject">
    <notPresent>
      <contents xsi:type="CPL:Proxy" timeout="20" recurse="yes" ordering="parallel">
        <busy/>
        <noAnswer/>
        <default>
          <contents xsi:type="CPL:Location" url="sip:noSubject@example.com" priority="6" clear="no"/>
        </default>
      </contents>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </otherwise>
    <strings is="urgent" contains="URGENT">
      <contents xsi:type="CPL:SubCall" ref="urgentHandler"/>
    </strings>
    <strings is="support" contains="help">
      <contents xsi:type="CPL:Location" url="sip:support@example.com" priority="9" clear="yes"/>
    </strings>
  </elements>

  <!-- 10: LanguageSwitch with NotPresent/Otherwise and two SwitchedLanguage cases -->
  <elements xsi:type="CPL:LanguageSwitch">
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:default-lang@example.com" priority="2" clear="yes"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="genericLangHandler"/>
    </otherwise>
    <languages matches="en">
      <contents xsi:type="CPL:Location" url="sip:english@example.com" priority="1" clear="yes"/>
    </languages>
    <languages matches="fr">
      <contents xsi:type="CPL:Location" url="sip:french@example.fr" priority="1" clear="yes"/>
    </languages>
  </elements>

  <!-- 11: TimeSwitch with complex SwitchedTime and NotPresent/Otherwise -->
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
    <notPresent>
      <contents xsi:type="CPL:Reject" status="500" reason="Time Not Available"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Proxy" timeout="25" recurse="no" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Location" url="sip:busy-time@example.com" priority="4" clear="no"/>
        </busy>
        <default>
          <contents xsi:type="CPL:SubCall" ref="fallbackTimeHandler"/>
        </default>
      </contents>
    </otherwise>
    <times dtstart="20250101T080000" dtend="20250101T180000" duration="10h"
           freq="DAILY" until="20251231T235959" count="365" interval="1"
           bySecond="0" byMinute="0" byHour="8;18" byDay="MO,TU,WE,TH,FR"
           byMonthDay="1-31" byYearDay="1-365" byWeekNo="1-52"
           byMonth="1-12" wkst="MO" bySetPos="1">
      <contents xsi:type="CPL:Location" url="sip:business-hours@example.com" priority="1" clear="yes"/>
    </times>
    <times dtstart="20250101T000000" interval="1" wkst="MO">
      <contents xsi:type="CPL:Location" url="sip:offhours@example.com" priority="3" clear="no"/>
    </times>
  </elements>

  <!-- 12: PrioritySwitch with SwitchedPriority cases and Otherwise -->
  <elements xsi:type="CPL:PrioritySwitch">
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:priority-missing@example.com" priority="6" clear="yes"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="priorityDefaultHandler"/>
    </otherwise>
    <priorities less="0.3" greater="0.0" equal="0.1">
      <contents xsi:type="CPL:Location" url="sip:lowprio@example.com" priority="9" clear="yes"/>
    </priorities>
    <priorities less="0.7" greater="0.3" equal="0.5">
      <contents xsi:type="CPL:Location" url="sip:medprio@example.com" priority="5" clear="yes"/>
    </priorities>
    <priorities greater="0.7" equal="1.0">
      <contents xsi:type="CPL:SubCall" ref="highPriorityHandler"/>
    </priorities>
  </elements>

</CPL:CPLModel>