<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="alice" contains="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="30">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:busy@example.com" clear="true" priority="medium"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </noAnswer>
            <default>
              <contents xsi:type="CPL:SubCall" ref="fallbackAction"/>
            </default>
          </Proxy>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="meeting" contains="urgent"/>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:default@example.com" clear="false" priority="low"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="UTC" tzurl="http://tz.example.com/utc">
        <times dtstart="20240101T090000Z" dtend="20240101T170000Z" interval="1" wkst="MO"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <priorities less="5" greater="1" equal="3"/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:prioritized@example.com" clear="true" priority="high"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <languages matches="en"/>
    <languages matches="fr"/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="406" reason="Not Acceptable"/>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="fallbackAction" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/>
</CPL:CPLModel>