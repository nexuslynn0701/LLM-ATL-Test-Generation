<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmi:id="_cplRoot">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="alice" contains="example.com"/>
        <addresses subDomainOf="company.org"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="403" reason="Sender not present"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="30">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="yes" priority="medium"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </noAnswer>
            <redirection/>
            <failure/>
            <default contents="//@elements.1"/>
          </proxy>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="meeting" contains="urgent"/>
        <strings contains="reminder"/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="handleDefault"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
        <times freq="WEEKLY" byDay="MO,WE,FR" interval="1" wkst="MO"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="480" reason="Outside business hours"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:reception@office.com" clear="no" priority="high"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="fallbackHandler"/>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="1"/>
    <priorities equal="3"/>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="406" reason="Priority not acceptable"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="406" reason="No supported language"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <default contents="//@elements.1"/>
      </proxy>
    </otherwise>
  </elements>
</CPL:CPLModel>