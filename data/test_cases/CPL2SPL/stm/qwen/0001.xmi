<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainSub">
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <notPresent>
          <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="user">
            <strings is="admin" contains="root"/>
            <otherwise>
              <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="30">
                <busy>
                  <contents xsi:type="CPL:Location" url="sip:busy@example.com" clear="true" priority="medium"/>
                </busy>
                <noAnswer>
                  <contents xsi:type="CPL:Redirect" permanent="true"/>
                </noAnswer>
                <default contents="//@elements.1"/>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
        <addresses is="sip:trusted@example.com" subDomainOf="example.com"/>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:TimeSwitch" tzid="UTC" tzurl="http://tz.example.com/utc">
        <times dtstart="20240101T000000Z" interval="1" wkst="MO" byHour="9,17"/>
        <otherwise>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <languages matches="fr"/>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities greater="5" less="10"/>
                <otherwise>
                  <contents xsi:type="CPL:Location" url="sip:fallback@example.com" clear="false" priority="low"/>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="fallbackHandler"/>
  <elements xsi:type="CPL:Location" url="sip:default@example.com" clear="true" priority="high"/>
</CPL:CPLModel>