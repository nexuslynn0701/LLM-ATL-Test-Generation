<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainSub">
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="alice" contains="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="30">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="yes" priority="normal"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="yes"/>
            </noAnswer>
            <default contents="//@elements.1"/>
          </proxy>
        </otherwise>
      </contents>
    </subActions>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="meeting" contains="urgent"/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="fallbackAction"/>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:TimeSwitch" tzid="UTC" tzurl="http://tz.example.com/utc">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
        <notPresent>
          <contents xsi:type="CPL:Failure"/>
        </notPresent>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:default@example.com" clear="no" priority="high"/>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="406" reason="Not Acceptable"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="1" equal="3"/>
    <notPresent>
      <contents xsi:type="CPL:Busy"/>
    </notPresent>
  </elements>
</CPL:CPLModel>