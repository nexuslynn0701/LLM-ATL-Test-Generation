<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="alice" contains="example.com"/>
        <addresses subDomainOf="company.org"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="no" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="true" priority="medium"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="fallbackHandler"/>
            </noAnswer>
            <redirection/>
            <failure/>
            <default contents="//@elements.1"/>
          </proxy>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="meeting" contains="urgent"/>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="415" reason="Unsupported Language"/>
        </notPresent>
      </contents>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tz.example.com/ny">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:afterhours@example.com" clear="false" priority="low"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="5" greater="1"/>
        <priorities equal="3"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </notPresent>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:Location" url="sip:primary@example.com" clear="true" priority="high"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <default contents="//@elements.0/@subActions.0"/>
      </proxy>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ref="fallbackHandler"/>
</CPL:CPLModel>