<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmi:id="cpl_root">
    <subActions id="main_action">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="user">
        <addresses is="alice@example.com"/>
        <addresses contains="bob"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="30">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="true" priority="medium"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="yes"/>
            </noAnswer>
            <default contents="//@elements.1"/>
          </Proxy>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="meeting"/>
        <strings contains="urgent"/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="fallback_handler"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="415" reason="Unsupported Language"/>
        </notPresent>
      </contents>
      <contents xsi:type="CPL:TimeSwitch" tzid="Europe/Paris">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:afterhours@example.com" clear="false" priority="low"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="5" greater="1"/>
        <priorities equal="3"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="480" reason="Priority Missing"/>
        </notPresent>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:Location" url="sip:outbound@example.com" clear="true" priority="high"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <redirection>
          <contents xsi:type="CPL:Redirect" permanent="no"/>
        </redirection>
        <failure>
          <contents xsi:type="CPL:Reject" status="500" reason="Internal Error"/>
        </failure>
      </Proxy>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="fallback_handler"/>
  <elements xsi:type="CPL:Location" url="sip:default@example.com" clear="true" priority="normal"/>
</CPL:CPLModel>