<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="user">
        <addresses is="alice@example.com"/>
        <addresses contains="bob"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="30">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="yes" priority="medium"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="yes"/>
            </noAnswer>
            <default contents="//@elements.1"/>
          </proxy>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent"/>
        <strings contains="meeting"/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="handleNormalCall"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="415" reason="Unsupported Language"/>
        </notPresent>
      </contents>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:afterhours@example.com" clear="no" priority="low"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities greater="5" less="10"/>
        <priorities equal="1"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </notPresent>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:Location" url="sip:outbound@example.com" clear="yes" priority="high"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <redirection>
          <contents xsi:type="CPL:Redirect" permanent="no"/>
        </redirection>
        <failure>
          <contents xsi:type="CPL:Reject" status="500" reason="Internal Error"/>
        </failure>
        <default contents="//@elements.2"/>
      </proxy>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" clear="yes" priority="normal"/>
  <elements xsi:type="CPL:SubCall" ref="fallbackAction"/>
</CPL:CPLModel>