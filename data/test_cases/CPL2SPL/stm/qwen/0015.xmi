<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="alice" contains="example.com" subDomainOf="com"/>
        <addresses is="bob" contains="test.org" subDomainOf="org"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="30">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="medium" clear="true"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </noAnswer>
            <default contents="//@elements.1"/>
          </Proxy>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="meeting" contains="urgent"/>
        <strings is="reminder"/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="fallbackAction"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
        <times dtstart="20240101T180000" duration="PT2H" freq="DAILY" interval="1" wkst="MO" byDay="MO,WE,FR"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </notPresent>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" url="sip:default@example.com" priority="low" clear="false"/>
  <elements xsi:type="CPL:PrioritySwitch" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <priorities less="5" greater="1" equal="3"/>
    <priorities less="10" equal="7"/>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <failure>
          <contents xsi:type="CPL:Reject" status="500" reason="Internal Error"/>
        </failure>
        <default contents="//@elements.1"/>
      </Proxy>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <languages matches="en"/>
    <languages matches="fr"/>
    <notPresent>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </notPresent>
  </elements>
</CPL:CPLModel>