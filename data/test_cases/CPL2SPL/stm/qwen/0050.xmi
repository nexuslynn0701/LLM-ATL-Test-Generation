<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmi:id="cpl_root">
    <subActions id="main_action">
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="alice" contains="example.com" subDomainOf="com"/>
        <addresses is="bob" contains="test.org" subDomainOf="org"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="no" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="medium" clear="true"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="fallback_handler"/>
            </noAnswer>
            <redirection/>
            <failure/>
            <default contents="//@elements.1"/>
          </Proxy>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="meeting" contains="urgent"/>
        <strings is="reminder"/>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="415" reason="Unsupported Language"/>
        </notPresent>
      </contents>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tz.example.com/ny">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
        <times freq="WEEKLY" byDay="MO,WE,FR" interval="1" wkst="MO"/>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:afterhours@example.com" priority="low" clear="false"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="5" greater="1" equal="3"/>
        <priorities equal="10"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </notPresent>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:Location" url="sip:outbound@example.com" priority="high" clear="true"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SubCall" ref="incoming_handler"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="fallback_handler"/>
  <elements xsi:type="CPL:Location" url="sip:default@example.com" priority="normal" clear="true"/>
  <elements xsi:type="CPL:Reject" status="603" reason="Decline"/>
</CPL:CPLModel>