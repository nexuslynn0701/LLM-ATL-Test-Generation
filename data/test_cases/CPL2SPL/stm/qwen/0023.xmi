<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainSub">
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="alice" contains="example.com"/>
        <addresses subDomainOf="company.org"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="User not found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="30">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@company.org" clear="true" priority="medium"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </noAnswer>
            <default contents="//@elements.1"/>
          </proxy>
        </otherwise>
      </contents>
    </subActions>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="meeting" contains="urgent"/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="handleDefault"/>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
        <notPresent>
          <contents xsi:type="CPL:Failure"/>
        </notPresent>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@company.org" clear="false" priority="low"/>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="406" reason="Language not supported"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="1"/>
    <priorities equal="3"/>
    <notPresent>
      <contents xsi:type="CPL:NoAnswer"/>
    </notPresent>
  </elements>
</CPL:CPLModel>