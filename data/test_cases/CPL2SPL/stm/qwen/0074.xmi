<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="alice" contains="example.com" subDomainOf="com"/>
        <addresses is="bob" contains="test.org" subDomainOf="org"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="no" ordering="sequential">
            <busy/>
            <noAnswer/>
            <redirection/>
            <failure/>
            <default contents="//@elements.1"/>
          </default>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="meeting" contains="urgent"/>
        <strings is="reminder"/>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="normal" clear="yes"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <notPresent>
          <contents xsi:type="CPL:Redirect" permanent="yes"/>
        </notPresent>
      </contents>
      <contents xsi:type="CPL:TimeSwitch" tzid="UTC" tzurl="http://tz.example.com/utc">
        <times dtstart="20240101T090000Z" dtend="20240101T170000Z" interval="1" wkst="MO"/>
        <times freq="DAILY" until="20241231T235959Z" byHour="9,17" interval="1" wkst="SU"/>
      </contents>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="5" greater="1" equal="3"/>
        <priorities equal="10"/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="fallbackAction"/>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:Location" url="sip:out@example.com" priority="high" clear="no"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="fallbackAction"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.net" priority="low" clear="yes"/>
</CPL:CPLModel>