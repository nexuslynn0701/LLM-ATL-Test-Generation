<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="alice" contains="example.com"/>
        <addresses subDomainOf="company.org"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="30">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="true" priority="medium"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="fallbackHandler"/>
            </noAnswer>
            <default contents="//@elements.1"/>
          </proxy>
        </otherwise>
      </contents>
    </subActions>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="meeting" contains="urgent"/>
        <strings contains="reminder"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO" byDay="MO,TU,WE,TH,FR"/>
        <notPresent>
          <contents xsi:type="CPL:Redirect" permanent="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:office@example.com" clear="false" priority="high"/>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:default@example.com" clear="true" priority="low"/>
  <elements xsi:type="CPL:SubCall" ref="fallbackHandler"/>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="1" equal="3"/>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="486" reason="Busy"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="415" reason="Unsupported Language"/>
    </notPresent>
  </elements>
</CPL:CPLModel>