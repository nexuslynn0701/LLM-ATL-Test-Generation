<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="user@example.com"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="30">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="yes" priority="medium"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="fallbackHandler"/>
            </noAnswer>
            <default>
              <contents xsi:type="CPL:StringSwitch" field="subject">
                <strings contains="urgent"/>
                <otherwise>
                  <contents xsi:type="CPL:Redirect" permanent="true"/>
                </otherwise>
              </contents>
            </default>
          </Proxy>
        </otherwise>
      </contents>
    </subActions>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="Europe/Paris">
        <times dtstart="20240101T090000" interval="1" wkst="MO" byHour="9,17"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities greater="5" less="10"/>
        <otherwise>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:intl-support@example.com" clear="no" priority="high"/>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="fallbackHandler"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" clear="yes" priority="low"/>
</CPL:CPLModel>