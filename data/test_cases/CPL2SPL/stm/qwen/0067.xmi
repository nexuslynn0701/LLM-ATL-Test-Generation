<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmi:id="cpl_root">
    <subActions id="main_sub">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="user">
        <addresses is="alice@example.com"/>
        <addresses contains="bob"/>
        <addresses subDomainOf="example.net"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="no" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="medium" clear="true"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="fallback_action"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Redirect" permanent="yes"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Reject" status="500" reason="Internal Error"/>
            </failure>
            <default>
              <contents xsi:type="CPL:StringSwitch" field="subject">
                <strings is="Meeting"/>
                <strings contains="Urgent"/>
                <otherwise>
                  <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="low" clear="false"/>
                </otherwise>
              </contents>
            </default>
          </contents>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5" greater="1" equal="3"/>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <notPresent>
                  <contents xsi:type="CPL:Reject" status="406" reason="Not Acceptable"/>
                </notPresent>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SubCall" ref="handle_incoming"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:fallback@example.com" priority="high" clear="true"/>
  <elements xsi:type="CPL:SubCall" ref="fallback_action"/>
  <elements xsi:type="CPL:SubCall" ref="handle_incoming"/>
</CPL:CPLModel>