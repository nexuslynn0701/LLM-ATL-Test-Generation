<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="alice" contains="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="30">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="true" priority="medium"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="fallbackHandler"/>
            </noAnswer>
          </proxy>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="meeting" contains="urgent"/>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="true"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="Europe/Paris">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="480" reason="Outside business hours"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ref="fallbackHandler"/>
  <elements xsi:type="CPL:Location" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" url="sip:backup@example.com" clear="false" priority="low"/>
  <elements xsi:type="CPL:PrioritySwitch" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <priorities greater="5" less="10" equal="7"/>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
        <default contents="//@elements.2"/>
      </proxy>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <languages matches="en"/>
    <languages matches="fr"/>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="406" reason="Language not supported"/>
    </otherwise>
  </elements>
</CPL:CPLModel>