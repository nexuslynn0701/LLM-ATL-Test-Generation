<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="user">
        <addresses is="alice@example.com"/>
        <addresses contains="bob"/>
        <addresses subDomainOf="company.com"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="30">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@company.com" clear="true" priority="medium"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="yes"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:SubCall" ref="fallbackAction"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Reject" status="500" reason="Internal Error"/>
            </failure>
            <default>
              <contents xsi:type="CPL:Location" url="sip:default@company.com" clear="false" priority="low"/>
            </default>
          </Proxy>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="meeting"/>
        <strings contains="urgent"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:multilingual@company.com" clear="true" priority="high"/>
        </notPresent>
      </contents>
      <contents xsi:type="CPL:TimeSwitch" tzid="Europe/Paris" tzurl="http://tz.example.com/paris">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
        <times freq="WEEKLY" byDay="MO,WE,FR" interval="1" wkst="MO"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="5"/>
        <priorities greater="8"/>
        <priorities equal="7"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:normal@company.com" clear="true" priority="normal"/>
        </notPresent>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:SubCall" ref="outgoingHandler"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Location" url="sip:incoming@company.com" clear="false" priority="high"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="fallbackAction"/>
  <elements xsi:type="CPL:SubCall" ref="outgoingHandler"/>
</CPL:CPLModel>