<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="alice" contains="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential" timeout="30">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="yes" priority="medium"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="yes"/>
            </noAnswer>
            <default contents="//@elements.1"/>
          </proxy>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="ASAP"/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="fallbackHandler"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York">
        <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:support-multilingual@example.com" clear="no" priority="low"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities greater="5" less="10"/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <redirection>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" clear="yes" priority="high"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Reject" status="500" reason="Internal Error"/>
            </failure>
          </proxy>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:Location" url="sip:primary@example.com" clear="yes" priority="normal"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SubCall" ref="preprocess"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:default@example.com" clear="yes" priority="low"/>
</CPL:CPLModel>