<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.100" contains="sip" subDomainOf="example.com"/>
        <addresses is="10.0.0.1" subDomainOf="internal.net"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:backup@voicemail.com" priority="1" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="no"/>
            </noAnswer>
            <failure>
              <contents xsi:type="CPL:Location" url="sip:failover@backup.com" priority="2" clear="no"/>
            </failure>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezones.example.com/ny">
        <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
        <times dtstart="20240101T000000" interval="1" wkst="SU"/>
        <notPresent>
          <contents xsi:type="CPL:Default"/>
        </notPresent>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent" contains="meeting"/>
    <strings is="personal"/>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="voicemailHandler"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <languages matches="de"/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:default@ivr.com" priority="0" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="1" equal="3"/>
    <priorities less="10" equal="7"/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <redirection>
      <contents xsi:type="CPL:Location" url="sip:redirected@newdomain.com" priority="1" clear="yes"/>
    </redirection>
    <default contents="//@elements.1"/>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:user@voip.com" priority="3" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:SubCall" ref="emergencyRouting"/>
</CPL:CPLModel>