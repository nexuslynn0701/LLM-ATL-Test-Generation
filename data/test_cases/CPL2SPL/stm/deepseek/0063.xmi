<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com" contains="alice" subDomainOf="example.com"/>
        <addresses is="sip:bob@example.com" contains="bob" subDomainOf="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tzurl.org">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="no"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5" greater="1" equal="3"/>
            <notPresent>
              <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
                <busy/>
                <noAnswer/>
                <redirection/>
                <failure/>
                <default/>
              </contents>
            </notPresent>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="emergency"/>
        <strings is="normal" contains="general"/>
        <notPresent>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="603" reason="Declined"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="mainRouting"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
  <elements xsi:type="CPL:Proxy" timeout="60" recurse="no" ordering="sequential">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default/>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="contact" subField="user">
    <addresses is="sip:carol@example.com" contains="carol" subDomainOf="example.com"/>
    <addresses is="sip:dave@example.com" contains="dave" subDomainOf="example.com"/>
    <notPresent>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="0" clear="no"/>
        </otherwise>
      </contents>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="mainRouting"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="priority">
    <strings is="high" contains="critical"/>
    <notPresent>
      <contents xsi:type="CPL:Proxy" timeout="10" recurse="yes" ordering="parallel">
        <busy/>
        <default/>
      </contents>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/London">
    <times dtstart="20240101T080000" dtend="20240101T180000" duration="PT10H" freq="WEEKLY" until="20241231T235959" count="52" interval="1" byDay="MO,TU,WE,TH,FR" wkst="MO"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:nightshift@example.com" priority="3" clear="yes"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="10" greater="5" equal="7"/>
    <notPresent>
      <contents xsi:type="CPL:Proxy" timeout="45" recurse="yes" ordering="parallel">
        <busy/>
        <noAnswer/>
        <default/>
      </contents>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="mainRouting"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="de"/>
    <languages matches="es"/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="606" reason="Not Acceptable"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:support@example.com" priority="1" clear="no"/>
    </otherwise>
  </elements>
</CPL:CPLModel>