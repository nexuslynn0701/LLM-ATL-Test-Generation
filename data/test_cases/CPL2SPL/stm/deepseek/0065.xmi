<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.100" contains="sip" subDomainOf="example.com"/>
        <addresses is="10.0.0.1" contains="tel"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezones.example.com/ny">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="1" equal="3"/>
                <priorities less="10" greater="7"/>
                <notPresent>
                  <contents xsi:type="CPL:LanguageSwitch">
                    <languages matches="en"/>
                    <languages matches="fr"/>
                    <otherwise>
                      <contents xsi:type="CPL:StringSwitch" field="subject">
                        <strings is="urgent" contains="meeting"/>
                        <strings is="important"/>
                        <notPresent>
                          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                            <busy>
                              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
                            </busy>
                            <noAnswer>
                              <contents xsi:type="CPL:Redirect" permanent="no"/>
                            </noAnswer>
                            <redirection>
                              <contents xsi:type="CPL:Reject" status="603" reason="Declined"/>
                            </redirection>
                            <failure>
                              <contents xsi:type="CPL:SubCall" ref="errorHandler"/>
                            </failure>
                            <default>
                              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="2" clear="no"/>
                            </default>
                          </contents>
                        </notPresent>
                        <otherwise>
                          <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="0" clear="yes"/>
                        </otherwise>
                      </contents>
                    </otherwise>
                  </contents>
                </notPresent>
              </contents>
            </otherwise>
          </times>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
            <busy/>
            <default>
              <contents xsi:type="CPL:Location" url="sip:operator@example.com" priority="1" clear="yes"/>
            </default>
          </contents>
        </otherwise>
      </addresses>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SwitchedAddress" is="sip:reception@company.com" contains="sip" subDomainOf="company.com"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="emergencyRouting"/>
  <elements xsi:type="CPL:Location" url="sip:admin@example.com" priority="5" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" timeout="60" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="1" clear="yes"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Redirect" permanent="no"/>
    </noAnswer>
    <default>
      <contents xsi:type="CPL:SubCall" ref="finalHandler"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination" subField="user">
    <addresses is="john" contains="sip" subDomainOf="example.org"/>
    <addresses is="jane" contains="sip"/>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="method">
    <strings is="INVITE"/>
    <strings is="MESSAGE"/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="405" reason="Method Not Allowed"/>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="de"/>
    <languages matches="es"/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:support@example.com" priority="3" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/London">
    <times dtstart="20240101T080000" interval="1" wkst="MO"/>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
        <default>
          <contents xsi:type="CPL:Location" url="sip:nightshift@example.com" priority="1" clear="yes"/>
        </default>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="100" greater="50" equal="75"/>
    <notPresent>
      <contents xsi:type="CPL:Redirect" permanent="no"/>
    </notPresent>
  </elements>
</CPL:CPLModel>