<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.100" contains="sip" subDomainOf="example.com"/>
        <addresses is="10.0.0.1" contains="tel"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <times dtstart="20240101T000000" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="1" equal="3"/>
                <priorities less="10" equal="7"/>
              </PrioritySwitch>
            </otherwise>
          </TimeSwitch>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="Cisco" contains="IP Phone"/>
            <strings is="Polycom"/>
            <notPresent>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <otherwise>
                  <contents xsi:type="CPL:Location" url="sip:default@voip.example.com" priority="1" clear="yes"/>
                </otherwise>
              </LanguageSwitch>
            </notPresent>
          </StringSwitch>
        </otherwise>
      </AddressSwitch>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:Redirect" permanent="no"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:SubCall" ref="voicemailHandler"/>
        </redirection>
        <failure>
          <contents xsi:type="CPL:Location" url="sip:backup@failover.example.com" priority="2" clear="no"/>
        </failure>
        <default contents="//@elements.2"/>
      </Proxy>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Proxy" timeout="60" recurse="no" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Location" url="sip:busy@announce.example.com" priority="1" clear="yes"/>
        </busy>
        <default contents="//@elements.3"/>
      </Proxy>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="voicemailHandler"/>
  <elements xsi:type="CPL:Location" url="sip:operator@company.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy/>
    <default contents="//@elements.4"/>
  </elements>
</CPL:CPLModel>