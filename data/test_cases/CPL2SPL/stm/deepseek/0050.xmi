<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainHandler"/>
    <outgoing>
      <contents xsi:type="CPL:LanguageSwitch">
        <notPresent/>
        <otherwise/>
        <languages matches="en"/>
        <languages matches="fr"/>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezones.example.com">
        <notPresent/>
        <otherwise/>
        <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" interval="1" wkst="MO"/>
        <times dtstart="20240101T000000" dtend="20240101T080000" duration="PT8H" freq="DAILY" interval="1" wkst="MO"/>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="origin" subField="user">
    <notPresent/>
    <otherwise/>
    <addresses is="alice" contains="example" subDomainOf="test.com"/>
    <addresses is="bob" contains="sample" subDomainOf="demo.org"/>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <notPresent/>
    <otherwise/>
    <strings is="urgent" contains="important"/>
    <strings is="normal" contains="standard"/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <notPresent/>
    <otherwise/>
    <priorities less="5" greater="3" equal="4"/>
    <priorities less="2" greater="1" equal="0"/>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default contents="//@elements.4"/>
  </elements>
  <elements xsi:type="CPL:Proxy" timeout="0" recurse="no" ordering="parallel">
    <busy/>
    <default contents="//@elements.8"/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="mainHandler"/>
  <elements xsi:type="CPL:SubCall" ref="secondaryHandler"/>
</CPL:CPLModel>