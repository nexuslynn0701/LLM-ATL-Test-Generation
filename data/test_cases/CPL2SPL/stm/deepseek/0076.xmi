<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:bob@example.com" contains="test" subDomainOf="example.com"/>
        <addresses is="sip:alice@example.com"/>
        <notPresent>
          <contents xsi:type="CPL:StringSwitch" field="subject">
            <strings is="urgent" contains="important"/>
            <otherwise>
              <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="30">
                <busy/>
                <default contents="//@elements.4"/>
              </contents>
            </otherwise>
          </strings>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tzurl.org">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <notPresent>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="3" equal="4"/>
                <notPresent>
                  <contents xsi:type="CPL:LanguageSwitch">
                    <languages matches="en-US"/>
                    <languages matches="fr-FR"/>
                  </contents>
                </notPresent>
              </contents>
            </otherwise>
          </times>
        </otherwise>
      </addresses>
    </outgoing>
    <incoming/>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="voicemail"/>
  <elements xsi:type="CPL:Location" url="sip:user@voicemail.example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
    <noAnswer/>
    <failure>
      <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
    </failure>
    <default contents="//@elements.2"/>
  </elements>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
</CPL:CPLModel>