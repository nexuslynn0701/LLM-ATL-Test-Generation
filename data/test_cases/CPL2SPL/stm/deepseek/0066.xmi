<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:user@domain.com" contains="domain.com" subDomainOf="com"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="subject">
            <strings is="urgent" contains="emergency"/>
            <notPresent>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="3" greater="1" equal="2"/>
                <otherwise>
                  <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                    <busy>
                      <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
                    </busy>
                    <noAnswer>
                      <contents xsi:type="CPL:Redirect" permanent="no"/>
                    </noAnswer>
                    <default>
                      <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
                    </default>
                  </contents>
                </otherwise>
              </contents>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <otherwise>
                  <contents xsi:type="CPL:SubCall" ref="defaultHandler"/>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
        <redirection>
          <contents xsi:type="CPL:Location" url="sip:redirected@example.com" priority="1" clear="yes"/>
        </redirection>
        <failure>
          <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
        </failure>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="defaultHandler"/>
  <elements xsi:type="CPL:Location" url="sip:main@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
    <busy/>
    <noAnswer/>
    <default contents="//@elements.2"/>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="sip:test@test.com" contains="test.com" subDomainOf="test.com"/>
    <otherwise>
      <contents xsi:type="CPL:TimeSwitch">
        <times dtstart="20240101T000000" dtend="20241231T235959" interval="1" wkst="SU"/>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5" greater="3" equal="4"/>
            <otherwise>
              <contents xsi:type="CPL:StringSwitch" field="user-agent">
                <strings is="softphone" contains="softphone"/>
                <otherwise>
                  <contents xsi:type="CPL:LanguageSwitch">
                    <languages matches="fr"/>
                    <otherwise>
                      <contents xsi:type="CPL:Location" url="sip:final@example.com" priority="1" clear="yes"/>
                    </otherwise>
                  </contents>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </otherwise>
  </elements>
</CPL:CPLModel>