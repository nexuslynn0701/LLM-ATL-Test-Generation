<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainFlow"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.100" contains=".example.com"/>
        <addresses is="10.0.0.0" subDomainOf="internal.net"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:backup@voicemail.com" priority="1" clear="no"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </noAnswer>
            <default contents="//@elements.1"/>
          </Proxy>
        </otherwise>
      </addresses>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="503" reason="Language not supported"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="mainFlow"/>
  <elements xsi:type="CPL:Location" url="sip:user@voicemail.com" priority="2" clear="yes"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <redirection>
      <contents xsi:type="CPL:Location" url="sip:forward@newdomain.com" priority="3" clear="no"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Location" url="sip:admin@failover.net" clear="yes"/>
    </failure>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="User-Agent">
    <strings is="Cisco" contains="IPPhone"/>
    <notPresent>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="5" greater="3"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="603" reason="Declined"/>
        </otherwise>
      </PrioritySwitch>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
    <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
    <times dtstart="20240101T000000" duration="PT12H" freq="WEEKLY" interval="2" byDay="SA,SU" wkst="SU"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:afterhours@support.com" clear="no"/>
    </notPresent>
  </elements>
</CPL:CPLModel>