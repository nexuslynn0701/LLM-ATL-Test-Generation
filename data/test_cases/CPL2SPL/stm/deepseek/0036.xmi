<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainFlow"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:user@domain.com" contains="example.com" subDomainOf="domain.com"/>
        <addresses is="sip:admin@test.org" contains="test.org"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:backup@domain.com" priority="1" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="secondaryFlow"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="emergency"/>
        <strings is="normal"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="603" reason="Declined"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="secondaryFlow"/>
  <elements xsi:type="CPL:Location" url="sip:voicemail@domain.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@domain.com" priority="1" clear="yes"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:SubCall" ref="redirectHandler"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="500" reason="Server Error"/>
    </failure>
    <default contents="//@elements.2"/>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="en"/>
    <languages matches="fr"/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:default@domain.com" priority="3" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezones.example.com/ny">
    <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
    <times dtstart="20240101T000000" interval="1" wkst="MO"/>
    <notPresent>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
        <default contents="//@elements.3"/>
      </contents>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="3" equal="4"/>
    <priorities less="10" equal="10"/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:priority@domain.com" priority="5" clear="no"/>
    </otherwise>
  </elements>
</CPL:CPLModel>