<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100" contains="sip" subDomainOf="example.com"/>
        <addresses is="10.0.0.1" contains="tel"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="softphone" contains="3CX"/>
            <strings is="hardphone" contains="Cisco"/>
            <notPresent>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <otherwise>
                  <contents xsi:type="CPL:PrioritySwitch">
                    <priorities less="5" greater="1" equal="3"/>
                    <otherwise>
                      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                        <busy>
                          <contents xsi:type="CPL:Redirect" permanent="no"/>
                        </busy>
                        <noAnswer>
                          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
                        </noAnswer>
                        <default>
                          <contents xsi:type="CPL:SubCall" ref="voicemail"/>
                        </default>
                      </contents>
                    </otherwise>
                  </contents>
                </otherwise>
              </contents>
            </notPresent>
          </contents>
        </otherwise>
      </addresses>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SwitchedTime" dtstart="20240101T000000" interval="1" wkst="MO"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="voicemail"/>
  <elements xsi:type="CPL:Location" url="sip:operator@example.com" priority="2" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="603" reason="Declined"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <redirection>
      <contents xsi:type="CPL:Location" url="sip:redirected@example.com" priority="1" clear="no"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="500" reason="Server Error"/>
    </failure>
  </elements>
</CPL:CPLModel>