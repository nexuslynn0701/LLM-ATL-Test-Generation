<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.100" contains="sip" subDomainOf="example.com"/>
        <addresses is="10.0.0.1" contains="tel"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:backup@voicemail.com" priority="1" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="softphone" contains="3CX"/>
            <strings is="hardphone" contains="Cisco"/>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <notPresent>
                  <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezones.example.com/ny">
                    <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
                    <notPresent>
                      <contents xsi:type="CPL:PrioritySwitch">
                        <priorities less="5" greater="1" equal="3"/>
                        <priorities less="10" greater="5"/>
                        <otherwise>
                          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                            <busy>
                              <contents xsi:type="CPL:Redirect" permanent="no"/>
                            </busy>
                            <noAnswer>
                              <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
                            </noAnswer>
                            <redirection>
                              <contents xsi:type="CPL:Location" url="sip:redirected@example.com" priority="2" clear="no"/>
                            </redirection>
                            <failure>
                              <contents xsi:type="CPL:SubCall" ref="failureHandler"/>
                            </failure>
                            <default>
                              <contents xsi:type="CPL:Location" url="sip:default@voicemail.com" priority="3" clear="yes"/>
                            </default>
                          </contents>
                        </otherwise>
                      </contents>
                    </notPresent>
                  </times>
                </notPresent>
              </contents>
            </otherwise>
          </strings>
        </otherwise>
      </addresses>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:SubCall" ref="outgoingHandler"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SwitchedAddress" is="sip:incoming@example.com" contains="sip" subDomainOf="example.com"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="failureHandler"/>
  <elements xsi:type="CPL:SubCall" ref="outgoingHandler"/>
  <elements xsi:type="CPL:Location" url="sip:standalone@example.com" priority="5" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <busy/>
    <default contents="//@elements.3"/>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination" subField="user">
    <addresses is="bob" contains="sip" subDomainOf="company.com"/>
    <addresses is="alice" contains="sip"/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:operator@company.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent" contains="emergency"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:normal@queue.com" priority="2" clear="no"/>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="de"/>
    <languages matches="es"/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:english@support.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/London">
    <times dtstart="20240101T080000" dtend="20240101T180000" interval="1" wkst="MO"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:afterhours@voicemail.com" priority="1" clear="yes"/>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="100" greater="50" equal="75"/>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
    </otherwise>
  </elements>
</CPL:CPLModel>