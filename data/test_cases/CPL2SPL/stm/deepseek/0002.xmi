<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.100" contains="sip" subDomainOf="example.com"/>
        <addresses is="10.0.0.1" contains="sips"/>
        <notPresent>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="CiscoPhone" contains="7960"/>
            <strings is="Polycom" contains="VVX"/>
            <otherwise>
              <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezones.example.com/ny">
                <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
                <times dtstart="20240101T000000" interval="1" wkst="SU"/>
                <notPresent>
                  <contents xsi:type="CPL:PrioritySwitch">
                    <priorities less="5" greater="1" equal="3"/>
                    <priorities less="10" greater="7"/>
                    <otherwise>
                      <contents xsi:type="CPL:Location" url="sip:user@backup.example.com" priority="2" clear="no"/>
                    </otherwise>
                  </contents>
                </notPresent>
                <otherwise>
                  <contents xsi:type="CPL:LanguageSwitch">
                    <languages matches="en"/>
                    <languages matches="fr"/>
                    <notPresent>
                      <contents xsi:type="CPL:Redirect" permanent="false"/>
                    </notPresent>
                  </contents>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:SubCall" ref="handleRedirect"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
            </failure>
            <default>
              <contents xsi:type="CPL:Location" url="sip:admin@example.com" priority="3" clear="no"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:SubCall" ref="outgoingHandler"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="destination">
        <addresses is="sip:support@company.com"/>
        <addresses is="sip:sales@company.com" contains="sip" subDomainOf="company.com"/>
        <notPresent>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
            <default>
              <contents xsi:type="CPL:Location" url="sip:reception@company.com" priority="1" clear="yes"/>
            </default>
          </contents>
        </notPresent>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="handleRedirect"/>
  <elements xsi:type="CPL:SubCall" ref="outgoingHandler"/>
  <elements xsi:type="CPL:Location" url="sip:user@home.example.com" priority="1" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="yes"/>
    </busy>
    <default>
      <contents xsi:type="CPL:SubCall" ref="handleRedirect"/>
    </default>
  </elements>
</CPL:CPLModel>