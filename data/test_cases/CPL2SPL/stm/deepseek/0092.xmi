<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100" contains="office" subDomainOf="example.com"/>
        <addresses is="10.0.0.1" contains="home"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="softphone" contains="Zoiper"/>
            <strings is="hardphone" contains="Cisco"/>
            <otherwise>
              <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
                <busy>
                  <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
                </busy>
                <noAnswer>
                  <contents xsi:type="CPL:Redirect" permanent="no"/>
                </noAnswer>
                <default>
                  <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="3" clear="yes"/>
                </default>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <notPresent>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5" greater="1" equal="3"/>
            <otherwise>
              <contents xsi:type="CPL:SubCall" ref="mainRouting"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="603" reason="Language not supported"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:admin@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy here"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <failure>
      <contents xsi:type="CPL:Location" url="sip:failover@example.com" priority="5" clear="yes"/>
    </failure>
    <redirection>
      <contents xsi:type="CPL:Redirect" permanent="no"/>
    </redirection>
  </elements>
</CPL:CPLModel>