<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1">
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.1"/>
        <addresses contains="example.com"/>
        <addresses subDomainOf="org"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </otherwise>
      </contents>
    </subActions>
    <subActions id="sub2">
      <contents xsi:type="CPL:StringSwitch" field="user-agent">
        <strings is="MySoftPhone"/>
        <notPresent/>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en-US"/>
        <languages matches="fr-FR"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="603" reason="Language not supported"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="">
        <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" interval="1" wkst="MO"/>
        <times dtstart="20240601T000000" until="20240831T235959" freq="WEEKLY" interval="1" wkst="MO"/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="sub1"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="sub2"/>
  <elements xsi:type="CPL:Location" url="sip:main@office.com" priority="2" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="488" reason="Not acceptable here"/>
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
        <default contents="//@elements.1"/>
      </busy>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="500" reason="Server error"/>
    </failure>
    <default contents="//@elements.3"/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="3" equal="4"/>
    <priorities less="10" greater="8"/>
    <notPresent>
      <contents xsi:type="CPL:SubCall" ref="sub1"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:sales@company.com" priority="1" clear="no"/>
    </otherwise>
  </elements>
</CPL:CPLModel>