<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.100" contains="sip" subDomainOf="example.com"/>
        <addresses is="10.0.0.1" contains="sips"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO" freq="DAILY" byHour="9,10,11,12,13,14,15,16"/>
            <times dtstart="20240101T000000" interval="1" wkst="MO" freq="WEEKLY" byDay="SA,SU" byHour="10,11,12,13,14"/>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="1" equal="3"/>
                <priorities less="10" equal="7"/>
                <notPresent>
                  <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="no"/>
                </notPresent>
                <otherwise>
                  <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
                    <busy>
                      <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
                    </busy>
                    <noAnswer>
                      <contents xsi:type="CPL:Redirect" permanent="no"/>
                    </noAnswer>
                    <redirection>
                      <contents xsi:type="CPL:Reject" status="603" reason="Decline"/>
                    </redirection>
                    <failure>
                      <contents xsi:type="CPL:SubCall" ref="emergencyRouting"/>
                    </failure>
                    <default>
                      <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="2" clear="no"/>
                    </default>
                  </contents>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="CiscoPhone" contains="Cisco"/>
            <strings is="Polycom" contains="Poly"/>
            <notPresent>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <otherwise>
                  <contents xsi:type="CPL:Location" url="sip:international@example.com" priority="1" clear="no"/>
                </otherwise>
              </contents>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
                <busy>
                  <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
                </busy>
                <default>
                  <contents xsi:type="CPL:Location" url="sip:unknown@example.com" priority="1" clear="yes"/>
                </default>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:SubCall" ref="outgoingHandler"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="to" subField="user">
        <addresses is="support" contains="@" subDomainOf="example.com"/>
        <addresses is="sales" contains="@"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:operator@example.com" priority="1" clear="no"/>
        </notPresent>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="emergencyRouting"/>
  <elements xsi:type="CPL:SubCall" ref="outgoingHandler"/>
  <elements xsi:type="CPL:Location" url="sip:test@example.com" priority="5" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel" timeout="15">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="1" clear="no"/>
    </busy>
    <default>
      <contents xsi:type="CPL:Location" url="sip:proxydefault@example.com" priority="1" clear="yes"/>
    </default>
  </elements>
</CPL:CPLModel>