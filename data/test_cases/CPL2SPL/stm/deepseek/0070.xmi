<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com" contains="alice" subDomainOf="example.com"/>
        <addresses is="sip:bob@example.com"/>
        <notPresent>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <languages matches="fr"/>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="3" greater="8"/>
                <otherwise>
                  <contents xsi:type="CPL:Location" url="sip:fallback@example.com" priority="1" clear="yes"/>
                </otherwise>
              </contents>
            </otherwise>
          </CPL:LanguageSwitch>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="softphone" contains="Windows"/>
            <strings contains="Linux"/>
            <otherwise>
              <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
                <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" interval="1" wkst="MO"/>
                <notPresent>
                  <contents xsi:type="CPL:Redirect" permanent="false"/>
                </notPresent>
              </contents>
            </otherwise>
          </CPL:StringSwitch>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SubCall" ref="mainRouting"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential" timeout="10">
    <busy>
      <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="no"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Redirect" permanent="true"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
    </failure>
    <default contents="//@elements.3"/>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:operator@example.com" priority="2" clear="yes"/>
  <elements xsi:type="CPL:SubCall" ref="incomingHandler"/>
</CPL:CPLModel>