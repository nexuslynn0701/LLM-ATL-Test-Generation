<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmlns:CPL="http://cpl/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <elements xsi:type="CPL:CPL">
    <subActions id="main"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:user@domain.com"/>
        <addresses contains="example.com"/>
        <addresses subDomainOf="test.org"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T000000" dtend="20241231T235959" duration="PT1H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <times dtstart="20250101T000000" interval="1" wkst="SU"/>
            <notPresent>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5"/>
                <priorities greater="3"/>
                <priorities equal="4"/>
                <otherwise>
                  <contents xsi:type="CPL:LanguageSwitch">
                    <languages matches="en"/>
                    <languages matches="fr"/>
                    <notPresent>
                      <contents xsi:type="CPL:StringSwitch" field="user-agent">
                        <strings is="Mozilla"/>
                        <strings contains="Chrome"/>
                        <otherwise>
                          <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
                        </otherwise>
                      </contents>
                    </notPresent>
                  </contents>
                </otherwise>
              </contents>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
                <busy/>
                <noAnswer/>
                <redirection/>
                <failure/>
                <default/>
              </contents>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="no"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="voicemail"/>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="10"/>
    <priorities greater="10"/>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Location" url="sip:secretary@example.com" priority="2" clear="no"/>
        </busy>
        <default>
          <contents xsi:type="CPL:Location" url="sip:assistant@example.com" priority="3" clear="yes"/>
        </default>
      </contents>
    </otherwise>
  </elements>
</CPL:CPLModel>