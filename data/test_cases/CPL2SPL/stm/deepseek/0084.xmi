<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1">
      <contents xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="false"/>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
        <times dtstart="20240101T000000" dtend="20241231T235959" duration="P1D" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
        <notPresent/>
        <otherwise>
          <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
            <addresses is="alice" contains="@example.com" subDomainOf="example.com"/>
            <notPresent/>
            <otherwise/>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming/>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent" contains="meeting"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <notPresent/>
        <otherwise/>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="5" greater="1" equal="3"/>
    <notPresent/>
    <otherwise/>
  </elements>
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
    <busy/>
    <noAnswer/>
    <redirection/>
    <failure/>
    <default contents="//@elements.5"/>
  </elements>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="603" reason="Decline"/>
  <elements xsi:type="CPL:SubCall" ref="sub1"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.net" priority="2" clear="true"/>
</CPL:CPLModel>