<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.100" contains="sip" subDomainOf="example.com"/>
        <addresses is="10.0.0.1" contains="tel"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezones.example.com/ny">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
            <times dtstart="20240102T090000" dtend="20240102T170000" interval="1" wkst="TU"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="Cisco" contains="IP Phone"/>
            <strings is="Polycom" contains="VVX"/>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <notPresent>
                  <contents xsi:type="CPL:PrioritySwitch">
                    <priorities less="5" greater="1" equal="3"/>
                    <priorities less="10" greater="7"/>
                    <otherwise>
                      <contents xsi:type="CPL:SubCall" ref="defaultHandler"/>
                    </otherwise>
                  </contents>
                </notPresent>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:Redirect" permanent="no"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
        </redirection>
        <failure>
          <contents xsi:type="CPL:SubCall" ref="failureHandler"/>
        </failure>
        <default contents="//@elements.2"/>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="to" subField="user">
        <addresses is="support" contains="sip" subDomainOf="company.com"/>
        <addresses is="info" contains="mailto"/>
        <otherwise>
          <contents xsi:type="CPL:TimeSwitch" tzid="UTC" interval="1" wkst="MO">
            <times dtstart="20240101T000000" duration="PT8H" interval="1" wkst="MO"/>
            <notPresent>
              <contents xsi:type="CPL:Location" url="sip:nightshift@example.com" priority="1" clear="yes"/>
            </notPresent>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="defaultHandler"/>
  <elements xsi:type="CPL:SubCall" ref="failureHandler"/>
  <elements xsi:type="CPL:Location" url="sip:operator@example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
    <busy/>
    <default contents="//@elements.4"/>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="from">
    <addresses is="admin" contains="sip"/>
    <otherwise>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="emergency"/>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="defaultHandler"/>
        </otherwise>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="de"/>
    <languages matches="es"/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:international@example.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="100" greater="50" equal="75"/>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
    </otherwise>
  </elements>
</CPL:CPLModel>