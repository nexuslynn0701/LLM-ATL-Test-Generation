<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="sub1">
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="bob" contains="sip" subDomainOf="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="no"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="subject">
            <strings is="urgent" contains="meeting"/>
            <otherwise>
              <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tzurl.org">
                <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="daily" until="20241231T235959" count="365" interval="1" wkst="MO" bySecond="0" byMinute="0" byHour="9" byDay="MTWHF" byMonthDay="*" byYearDay="*" byWeekNo="*" byMonth="*" bySetPos="*"/>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </subActions>
    <subActions id="sub2">
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="5" greater="3" equal="4"/>
        <notPresent>
          <contents xsi:type="CPL:Redirect" permanent="no"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="serial">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:SubCall" ref="sub2"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Location" url="sip:redirected@example.com" priority="0" clear="yes"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </failure>
            <default>
              <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="2" clear="no"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </subActions>
    <incoming>
      <contents xsi:type="CPL:SwitchedLanguage" matches="fr"/>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:SwitchedTime" dtstart="20240101T000000" dtend="20241231T235959" duration="P1Y" interval="1" wkst="MO"/>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="sub1"/>
  <elements xsi:type="CPL:Location" url="sip:main@example.com" priority="10" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <busy/>
    <default contents="//@elements.3"/>
  </elements>
</CPL:CPLModel>