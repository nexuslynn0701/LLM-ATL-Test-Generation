<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.100" contains="example.com" subDomainOf="test.org"/>
        <addresses is="10.0.0.1" contains="internal.net"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:backup@fallback.com" priority="1" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="softphone" contains="3.0"/>
            <strings is="hardphone"/>
            <notPresent>
              <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                <busy>
                  <contents xsi:type="CPL:Redirect" permanent="no"/>
                </busy>
                <noAnswer>
                  <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="2" clear="no"/>
                </noAnswer>
                <default>
                  <contents xsi:type="CPL:SubCall" ref="mainRouting"/>
                </default>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <languages matches="de"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezones.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <times dtstart="20240101T000000" dtend="20240101T080000" interval="1" wkst="MO"/>
            <notPresent>
              <contents xsi:type="CPL:Location" url="sip:nightshift@example.com" priority="3" clear="yes"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="1" equal="3"/>
                <priorities less="10" greater="7"/>
                <notPresent>
                  <contents xsi:type="CPL:Redirect" permanent="yes"/>
                </notPresent>
                <otherwise>
                  <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
                    <redirection>
                      <contents xsi:type="CPL:Location" url="sip:redirected@example.com" priority="4" clear="yes"/>
                    </redirection>
                    <failure>
                      <contents xsi:type="CPL:Reject" status="500" reason="Server Error"/>
                    </failure>
                  </contents>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="emergencyRouting"/>
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="5" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" timeout="60" recurse="yes" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="6" clear="no"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:SubCall" ref="emergencyRouting"/>
    </noAnswer>
    <default>
      <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="7" clear="yes"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination" subField="user">
    <addresses is="admin" contains="admin.example.com"/>
    <notPresent>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
        <default>
          <contents xsi:type="CPL:Location" url="sip:operator@example.com" priority="8" clear="yes"/>
        </default>
      </contents>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="mainRouting"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent" contains="important"/>
    <notPresent>
      <contents xsi:type="CPL:Redirect" permanent="no"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="es"/>
    <languages matches="pt"/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:international@example.com" priority="9" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="Europe/London">
    <times dtstart="20240101T080000" duration="PT12H" freq="WEEKLY" interval="1" wkst="MO"/>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Redirect" permanent="no"/>
        </busy>
        <default>
          <contents xsi:type="CPL:Location" url="sip:afterhours@example.com" priority="10" clear="yes"/>
        </default>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="100" greater="50" equal="75"/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="mainRouting"/>
    </otherwise>
  </elements>
</CPL:CPLModel>