<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com" contains="alice" subDomainOf="example.com"/>
        <addresses is="sip:bob@example.com" contains="bob"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="defaultHandler"/>
        </otherwise>
      </contents>
    </subActions>
    <subActions id="defaultHandler">
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="urgent"/>
        <strings is="meeting" contains="meeting"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezones.example.com/ny">
        <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" interval="1" wkst="MO"/>
        <times dtstart="20240101T000000" dtend="20240101T080000" duration="PT8H" freq="WEEKLY" interval="1" wkst="MO"/>
        <notPresent>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </notPresent>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="5" greater="1" equal="3"/>
        <priorities less="10" greater="6"/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="1" clear="no"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Location" url="sip:noanswer@example.com" priority="2" clear="no"/>
            </noAnswer>
            <default>
              <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="3" clear="yes"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch" field="language">
    <languages matches="en"/>
    <languages matches="fr"/>
    <languages matches="de"/>
    <notPresent>
      <contents xsi:type="CPL:Location" url="sip:support@example.com" priority="1" clear="yes"/>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Location" url="sip:operator@example.com" priority="10" clear="yes"/>
</CPL:CPLModel>