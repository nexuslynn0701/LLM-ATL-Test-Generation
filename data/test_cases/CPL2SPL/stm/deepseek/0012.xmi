<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.100" contains="sip" subDomainOf="example.com"/>
        <addresses is="10.0.0.1" contains="tel"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="no"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="softphone" contains="3.0"/>
            <strings is="hardphone" contains="2.1"/>
            <notPresent>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en-US"/>
                <languages matches="fr-FR"/>
                <otherwise>
                  <contents xsi:type="CPL:PrioritySwitch">
                    <priorities less="5" greater="10" equal="7"/>
                    <notPresent>
                      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
                        <busy/>
                        <noAnswer/>
                        <redirection/>
                        <failure/>
                        <default contents="//@elements.1"/>
                      </contents>
                    </notPresent>
                  </contents>
                </otherwise>
              </contents>
            </notPresent>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Redirect" permanent="false"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="voicemail"/>
  <elements xsi:type="CPL:Location" url="sip:operator@company.com" priority="2" clear="yes"/>
  <elements xsi:type="CPL:Reject" status="603" reason="Declined"/>
  <elements xsi:type="CPL:Proxy" timeout="60" recurse="no" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy-announce@example.com" priority="1" clear="yes"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:SubCall" ref="noAnswerHandler"/>
    </noAnswer>
    <default contents="//@elements.2"/>
  </elements>
</CPL:CPLModel>