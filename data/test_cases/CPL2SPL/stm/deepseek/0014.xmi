<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:user@domain.com" contains="example.com" subDomainOf="domain.com"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="subject">
            <strings is="urgent" contains="emergency"/>
            <notPresent>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="3" equal="4"/>
                <otherwise>
                  <contents xsi:type="CPL:LanguageSwitch">
                    <languages matches="en"/>
                    <otherwise>
                      <contents xsi:type="CPL:Redirect" permanent="false"/>
                    </otherwise>
                  </contents>
                </otherwise>
              </contents>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                <busy>
                  <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
                </busy>
                <noAnswer>
                  <contents xsi:type="CPL:Location" url="sip:assistant@example.com" priority="2" clear="no"/>
                </noAnswer>
                <redirection>
                  <contents xsi:type="CPL:SubCall" ref="followRedirect"/>
                </redirection>
                <failure>
                  <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
                </failure>
                <default contents="//@elements.2"/>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </addresses>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SwitchedAddress" is="sip:incoming@domain.com" contains="domain.com" subDomainOf="domain.com"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="3" clear="yes"/>
  <elements xsi:type="CPL:SubCall" ref="followRedirect"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <busy/>
    <default contents="//@elements.1"/>
  </elements>
</CPL:CPLModel>