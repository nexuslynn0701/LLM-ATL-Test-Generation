<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:user@domain.com" contains="domain.com" subDomainOf="com"/>
        <addresses is="sip:admin@company.org" contains="company.org"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="subject">
            <strings is="urgent" contains="urgent"/>
            <strings is="meeting" contains="meeting"/>
            <notPresent>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="3" greater="5" equal="4"/>
                <otherwise>
                  <contents xsi:type="CPL:LanguageSwitch">
                    <languages matches="en"/>
                    <languages matches="fr"/>
                    <otherwise>
                      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                        <busy>
                          <contents xsi:type="CPL:Redirect" permanent="no"/>
                        </busy>
                        <noAnswer>
                          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
                        </noAnswer>
                        <redirection>
                          <contents xsi:type="CPL:SubCall" ref="handleRedirection"/>
                        </redirection>
                        <failure>
                          <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
                        </failure>
                        <default>
                          <contents xsi:type="CPL:SubCall" ref="defaultHandler"/>
                        </default>
                      </contents>
                    </otherwise>
                  </contents>
                </otherwise>
              </contents>
            </notPresent>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SwitchedTime" dtstart="20240101T000000" interval="1" wkst="MO"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="handleRedirection"/>
  <elements xsi:type="CPL:SubCall" ref="defaultHandler"/>
  <elements xsi:type="CPL:Location" url="sip:emergency@example.com" priority="10" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <busy/>
    <default contents="//@elements.4"/>
  </elements>
</CPL:CPLModel>