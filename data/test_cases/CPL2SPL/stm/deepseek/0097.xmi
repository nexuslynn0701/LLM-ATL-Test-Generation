<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com" contains="alice" subDomainOf="example.com"/>
        <addresses is="sip:bob@example.com" contains="bob" subDomainOf="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tzurl.org">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" interval="1" wkst="MO"/>
            <times dtstart="20240101T000000" dtend="20240101T235959" duration="PT24H" freq="WEEKLY" interval="1" wkst="SU"/>
            <notPresent>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
                <busy>
                  <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
                </busy>
                <noAnswer>
                  <contents xsi:type="CPL:Location" url="sip:secretary@example.com" priority="2" clear="no"/>
                </noAnswer>
                <redirection>
                  <contents xsi:type="CPL:SubCall" ref="handleRedirection"/>
                </redirection>
                <failure>
                  <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
                </failure>
                <default>
                  <contents xsi:type="CPL:Location" url="sip:user@example.com" priority="1" clear="yes"/>
                </default>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="urgent"/>
        <strings is="meeting" contains="meeting"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:spam@example.com" priority="0" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="3" greater="5" equal="4"/>
            <priorities less="1" greater="2" equal="2"/>
            <notPresent>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <notPresent>
                  <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="1" clear="yes"/>
                </notPresent>
                <otherwise>
                  <contents xsi:type="CPL:SubCall" ref="languageHandler"/>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="handleRedirection"/>
  <elements xsi:type="CPL:SubCall" ref="languageHandler"/>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="3" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" timeout="60" recurse="no" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="1" clear="yes"/>
    </busy>
    <default>
      <contents xsi:type="CPL:SubCall" ref="finalHandler"/>
    </default>
  </elements>
</CPL:CPLModel>