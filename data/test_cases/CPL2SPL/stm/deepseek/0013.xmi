<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainFlow"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:user@domain.com" contains="domain.com"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:backup@domain.com" priority="0.5" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="subject">
            <strings is="urgent" contains="urgent"/>
            <otherwise>
              <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezones.example.com">
                <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
                <otherwise>
                  <contents xsi:type="CPL:PrioritySwitch">
                    <priorities less="5" greater="1" equal="3"/>
                    <otherwise>
                      <contents xsi:type="CPL:LanguageSwitch">
                        <languages matches="en"/>
                        <otherwise>
                          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                            <busy>
                              <contents xsi:type="CPL:Redirect" permanent="no"/>
                            </busy>
                            <noAnswer>
                              <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
                            </noAnswer>
                            <redirection>
                              <contents xsi:type="CPL:SubCall" ref="voicemail"/>
                            </redirection>
                            <failure>
                              <contents xsi:type="CPL:Location" url="sip:admin@domain.com" priority="1.0" clear="yes"/>
                            </failure>
                            <default>
                              <contents xsi:type="CPL:SubCall" ref="assistant"/>
                            </default>
                          </contents>
                        </otherwise>
                      </contents>
                    </otherwise>
                  </contents>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SwitchedAddress" is="sip:info@domain.com" contains="info"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="voicemail"/>
  <elements xsi:type="CPL:SubCall" ref="assistant"/>
  <elements xsi:type="CPL:Location" url="sip:emergency@domain.com" priority="0.9" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@domain.com" priority="0.3" clear="no"/>
    </busy>
    <default>
      <contents xsi:type="CPL:SubCall" ref="voicemail"/>
    </default>
  </elements>
</CPL:CPLModel>