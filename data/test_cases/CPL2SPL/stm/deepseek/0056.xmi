<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="workflow1"/>
    <subActions id="voicemail"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://time.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="WEEKLY" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential" timeout="30">
            <busy>
              <contents xsi:type="CPL:Redirect" permanent="no"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="2" clear="no"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Reject" status="603" reason="Declined"/>
            </redirection>
            <default contents="//@elements.2"/>
          </contents>
        </otherwise>
        <addresses is="sip:user@example.com" contains="@example.com"/>
        <addresses is="sip:admin@example.com" subDomainOf="example.com"/>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:PrioritySwitch">
        <notPresent>
          <contents xsi:type="CPL:StringSwitch" field="subject">
            <notPresent>
              <contents xsi:type="CPL:SubAction" id="voicemail"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <otherwise>
                  <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
                    <failure>
                      <contents xsi:type="CPL:Location" url="sip:error@example.com" priority="1" clear="yes"/>
                    </failure>
                    <default contents="//@elements.4"/>
                  </contents>
                </otherwise>
              </contents>
            </otherwise>
            <strings is="urgent" contains="important"/>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:SubCall" ref="workflow1"/>
        </otherwise>
        <priorities less="5" greater="1" equal="3"/>
        <priorities less="10" greater="8"/>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="voicemail"/>
  <elements xsi:type="CPL:Location" url="sip:proxy@example.com" priority="3" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="sip:support@example.com" contains="support"/>
    <addresses subDomainOf="example.com" is="sip:info@example.com"/>
    <otherwise>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
        <default contents="//@elements.2"/>
      </contents>
    </otherwise>
  </elements>
</CPL:CPLModel>