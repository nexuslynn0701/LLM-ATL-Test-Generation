<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="processCall"/>
    <outgoing>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities greater="5" equal="3" less="1"/>
            <priorities greater="10" equal="7"/>
            <notPresent>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Redirect" permanent="no"/>
            </otherwise>
          </contents>
        </otherwise>
        <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO" byDay="MO,TU,WE,TH,FR"/>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <languages matches="de"/>
        <notPresent>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Location" url="sip:secretary@example.com" priority="2" clear="no"/>
            </noAnswer>
            <default>
              <contents xsi:type="CPL:SubCall" ref="processCall"/>
            </default>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="603" reason="Decline"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="origin" subField="host">
    <addresses is="sip:office@example.com" contains="example" subDomainOf="example.com"/>
    <addresses is="sip:home@example.com" contains="home"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Proxy" timeout="15" recurse="no" ordering="sequential">
        <failure>
          <contents xsi:type="CPL:Redirect" permanent="yes"/>
        </failure>
        <redirection>
          <contents xsi:type="CPL:Location" url="sip:redirected@example.com" priority="1" clear="yes"/>
        </redirection>
      </contents>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="Subject">
    <strings is="urgent" contains="ASAP"/>
    <strings is="meeting" contains="conference"/>
    <notPresent/>
    <otherwise>
      <contents xsi:type="CPL:Reject" status="404" reason="Not Found"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="processCall"/>
  <elements xsi:type="CPL:Location" url="sip:user@voip.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="false"/>
  <elements xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
  <elements xsi:type="CPL:Proxy" timeout="60" recurse="yes" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="1" clear="yes"/>
    </busy>
    <default contents="//@elements.5"/>
  </elements>
</CPL:CPLModel>