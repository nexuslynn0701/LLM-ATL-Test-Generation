<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainFlow"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com" contains="alice"/>
        <addresses is="sip:bob@example.com" subDomainOf="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:backup@example.com" clear="yes" priority="1"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="subject">
            <strings is="urgent" contains="urgent"/>
            <strings is="meeting" contains="meeting"/>
            <otherwise>
              <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential" timeout="30">
                <busy>
                  <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" clear="no" priority="2"/>
                </busy>
                <noAnswer>
                  <contents xsi:type="CPL:Location" url="sip:assistant@example.com" clear="yes" priority="1"/>
                </noAnswer>
                <default>
                  <contents xsi:type="CPL:SubCall" ref="finalHandler"/>
                </default>
              </contents>
            </otherwise>
          </strings>
        </otherwise>
      </addresses>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezones.example.com/ny">
        <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" interval="1" wkst="MO"/>
        <times dtstart="20240101T000000" dtend="20240101T080000" duration="PT8H" freq="DAILY" interval="1" wkst="MO"/>
        <notPresent>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5" greater="1" equal="3"/>
            <priorities less="10" greater="5" equal="7"/>
            <notPresent>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <otherwise>
                  <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
                    <redirection>
                      <contents xsi:type="CPL:Location" url="sip:redirect@example.com" clear="yes" priority="1"/>
                    </redirection>
                    <failure>
                      <contents xsi:type="CPL:SubCall" ref="errorHandler"/>
                    </failure>
                    <default>
                      <contents xsi:type="CPL:Location" url="sip:default@example.com" clear="yes" priority="0"/>
                    </default>
                  </contents>
                </otherwise>
              </languages>
            </otherwise>
          </priorities>
        </otherwise>
      </times>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="finalHandler"/>
  <elements xsi:type="CPL:SubCall" ref="errorHandler"/>
  <elements xsi:type="CPL:Location" url="sip:standby@example.com" clear="yes" priority="5"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential" timeout="60">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busyqueue@example.com" clear="no" priority="3"/>
    </busy>
    <default>
      <contents xsi:type="CPL:SubCall" ref="finalHandler"/>
    </default>
  </elements>
</CPL:CPLModel>