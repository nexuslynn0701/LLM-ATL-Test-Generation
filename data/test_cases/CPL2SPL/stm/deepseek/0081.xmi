<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.100" contains="sip" subDomainOf="example.com"/>
        <addresses is="10.0.0.1" contains="sips"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <times dtstart="20240201T000000" interval="1" wkst="SU"/>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="1" equal="3"/>
                <priorities less="10" equal="7"/>
              </contents>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="user-agent">
            <strings is="Mozilla" contains="Firefox"/>
            <strings is="Chrome"/>
            <notPresent>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en-US"/>
                <languages matches="fr-FR"/>
                <otherwise>
                  <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="1" clear="yes"/>
                </otherwise>
              </contents>
            </notPresent>
          </contents>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:SubCall" ref="voicemailHandler"/>
        </redirection>
        <failure>
          <contents xsi:type="CPL:Location" url="sip:error@example.com" priority="0" clear="yes"/>
        </failure>
        <default>
          <contents xsi:type="CPL:Location" url="sip:default@example.com" priority="5" clear="no"/>
        </default>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="destination">
        <addresses is="sip:support@company.com"/>
        <addresses is="sip:sales@company.com" subDomainOf="company.com"/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <default>
              <contents xsi:type="CPL:Redirect" permanent="true"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="voicemailHandler"/>
  <elements xsi:type="CPL:Location" url="sip:admin@example.com" priority="10" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
    <busy/>
    <default contents="//@elements.2"/>
  </elements>
</CPL:CPLModel>