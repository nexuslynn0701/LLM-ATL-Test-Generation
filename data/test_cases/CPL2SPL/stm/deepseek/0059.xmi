<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting">
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="sip:alice@example.com" contains="alice"/>
        <addresses is="sip:bob@example.com" subDomainOf="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <languages matches="fr"/>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="3" equal="4"/>
                <priorities less="10" greater="7"/>
                <notPresent>
                  <contents xsi:type="CPL:StringSwitch" field="user-agent">
                    <strings is="Cisco" contains="Cisco"/>
                    <otherwise>
                      <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
                        <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
                        <times dtstart="20240201T080000" interval="1" wkst="WE"/>
                        <otherwise>
                          <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
                        </otherwise>
                        <notPresent>
                          <contents xsi:type="CPL:SubCall" ref="emergencyRouting"/>
                        </notPresent>
                      </contents>
                    </otherwise>
                  </contents>
                </notPresent>
              </contents>
            </otherwise>
          </contents>
        </notPresent>
      </contents>
    </subActions>
    <subActions id="emergencyRouting">
      <contents xsi:type="CPL:Location" url="sip:operator@example.com" priority="0" clear="no"/>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:SubCall" ref="mainRouting"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Location" url="sip:busy-announce@example.com" priority="1" clear="yes"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Reject" status="302" reason="Moved Temporarily"/>
        </redirection>
        <failure>
          <contents xsi:type="CPL:Location" url="sip:failure-notify@example.com" priority="0" clear="no"/>
        </failure>
        <default contents="//@elements.7"/>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="fallbackRouting"/>
  <elements xsi:type="CPL:Location" url="sip:user@voip.example.com" priority="2" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
  <elements xsi:type="CPL:AddressSwitch" field="to" subField="host">
    <addresses contains="voip"/>
    <addresses is="sip:conference@example.com"/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:default-gateway@example.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings contains="urgent"/>
    <strings is="meeting"/>
    <notPresent>
      <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
        <default contents="//@elements.2"/>
      </contents>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="UTC">
    <times dtstart="20240101T000000" interval="1" wkst="SU">
      <byMonth value="1"/>
      <byMonthDay value="1"/>
    </times>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="normalRouting"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="de"/>
    <languages matches="es"/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:english-operator@example.com" priority="1" clear="yes"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="100" greater="50" equal="75"/>
    <notPresent>
      <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
    </notPresent>
  </elements>
</CPL:CPLModel>