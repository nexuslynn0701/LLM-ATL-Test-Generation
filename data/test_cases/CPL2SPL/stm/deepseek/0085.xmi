<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainFlow"/>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="from">
        <addresses is="sip:bob@example.com"/>
        <notPresent>
          <contents xsi:type="CPL:LanguageSwitch">
            <languages matches="en"/>
            <otherwise>
              <contents xsi:type="CPL:SubCall" ref="fallback"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
            <times dtstart="20240102T090000" interval="2" wkst="TU" byDay="MO,TU,WE"/>
            <notPresent>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="3" greater="1"/>
                <notPresent>
                  <contents xsi:type="CPL:Busy"/>
                </notPresent>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </incoming>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings contains="urgent"/>
        <notPresent>
          <contents xsi:type="CPL:NoAnswer"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential" timeout="30">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="no"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </noAnswer>
            <redirection>
              <contents xsi:type="CPL:Default"/>
            </redirection>
            <failure>
              <contents xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="yes"/>
            </failure>
            <default>
              <contents xsi:type="CPL:Redirection"/>
            </default>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="fallback"/>
  <elements xsi:type="CPL:Location" url="sip:emergency@example.com" priority="10" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" recurse="false" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:backup2@example.com" priority="5" clear="yes"/>
    </busy>
    <default>
      <contents xsi:type="CPL:Failure"/>
    </default>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="to" subField="user">
    <addresses is="sip:admin@" contains="@example.com"/>
    <addresses subDomainOf="example.org"/>
    <notPresent>
      <contents xsi:type="CPL:SwitchedString" contains="test"/>
      <contents xsi:type="CPL:SwitchedLanguage" matches="fr"/>
    </notPresent>
    <otherwise>
      <contents xsi:type="CPL:SwitchedTime" dtstart="20240201T080000" interval="1" wkst="MO" byMonth="1"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="de"/>
    <languages matches="es"/>
    <notPresent>
      <contents xsi:type="CPL:SwitchedPriority" less="5"/>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzurl="http://timezone.example.com">
    <times dtstart="20240301T000000" interval="1" wkst="SU" freq="MONTHLY"/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities equal="7"/>
    <priorities greater="10"/>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="priority">
    <strings is="high"/>
    <strings contains="low"/>
  </elements>
</CPL:CPLModel>