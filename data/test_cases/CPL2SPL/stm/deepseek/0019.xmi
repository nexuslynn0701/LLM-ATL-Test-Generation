<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:user@domain.com" contains="domain.com"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:voicemail@domain.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="subject">
            <strings is="urgent" contains="urgent"/>
            <notPresent>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="1"/>
                <otherwise>
                  <contents xsi:type="CPL:LanguageSwitch">
                    <languages matches="en"/>
                    <otherwise>
                      <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
                        <busy>
                          <contents xsi:type="CPL:Location" url="sip:busy@domain.com" priority="1" clear="yes"/>
                        </busy>
                        <noAnswer>
                          <contents xsi:type="CPL:Redirect" permanent="no"/>
                        </noAnswer>
                        <redirection>
                          <contents xsi:type="CPL:Location" url="sip:redirected@domain.com" priority="2" clear="no"/>
                        </redirection>
                        <failure>
                          <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
                        </failure>
                        <default>
                          <contents xsi:type="CPL:Location" url="sip:default@domain.com" priority="1" clear="yes"/>
                        </default>
                      </contents>
                    </otherwise>
                  </contents>
                </otherwise>
              </contents>
            </notPresent>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SubCall" ref="mainRouting"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:alternate@domain.com" priority="3" clear="no"/>
  <elements xsi:type="CPL:SubCall" ref="emergencyRouting"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:proxybusy@domain.com" priority="1" clear="yes"/>
    </busy>
    <default>
      <contents xsi:type="CPL:Location" url="sip:proxydefault@domain.com" priority="1" clear="yes"/>
    </default>
  </elements>
</CPL:CPLModel>