<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <subActions id="mainRouting">
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com" contains="alice"/>
        <addresses is="sip:bob@example.com" subDomainOf="example.com"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="subject">
            <strings is="urgent" contains="urgent"/>
            <notPresent>
              <contents xsi:type="CPL:Proxy" timeout="10" recurse="yes" ordering="sequential">
                <busy>
                  <contents xsi:type="CPL:Location" url="sip:busyqueue@example.com" priority="1" clear="no"/>
                </busy>
                <noAnswer>
                  <contents xsi:type="CPL:Reject" status="480" reason="Temporarily Unavailable"/>
                </noAnswer>
                <redirection>
                  <contents xsi:type="CPL:Redirect" permanent="false"/>
                </redirection>
                <failure>
                  <contents xsi:type="CPL:Location" url="sip:errorhandler@example.com" priority="2" clear="yes"/>
                </failure>
                <default>
                  <contents xsi:type="CPL:SubCall" ref="defaultHandling"/>
                </default>
              </contents>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <notPresent>
                  <contents xsi:type="CPL:PrioritySwitch">
                    <priorities less="5" greater="3" equal="4"/>
                    <otherwise>
                      <contents xsi:type="CPL:Location" url="sip:support@example.com" priority="1" clear="yes"/>
                    </otherwise>
                  </contents>
                </notPresent>
                <otherwise>
                  <contents xsi:type="CPL:Location" url="sip:international@example.com" priority="1" clear="yes"/>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:SwitchedAddress" is="sip:outbound@example.com" contains="outbound"/>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SwitchedString" is="incoming" contains="call"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="defaultHandling"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <busy/>
    <default contents="//@elements.1"/>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:fallback@example.com" priority="3" clear="yes"/>
  <elements xsi:type="CPL:Location" url="sip:emergency@example.com" priority="1" clear="yes"/>
</CPL:CPLModel>