<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="sip:alice@example.com" contains="example.com" subDomainOf="example.com"/>
        <addresses is="sip:bob@example.org"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:default@voicemail.com" priority="0.5" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tzurl.org">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" interval="1" wkst="MO"/>
            <times dtstart="20240101T000000" freq="WEEKLY" count="52" interval="1" wkst="SU" byDay="SA,SU"/>
          </TimeSwitch>
        </otherwise>
      </AddressSwitch>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <notPresent>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </notPresent>
      </LanguageSwitch>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="3" greater="7" equal="5"/>
        <priorities less="1"/>
        <otherwise>
          <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
            <busy>
              <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Location" url="sip:assistant@example.com" priority="0.8" clear="no"/>
            </noAnswer>
          </Proxy>
        </otherwise>
      </PrioritySwitch>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="voicemailHandler"/>
  <elements xsi:type="CPL:Location" url="sip:user@example.com" priority="1.0" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="603" reason="Decline"/>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent" contains="emergency"/>
    <strings is="meeting"/>
    <otherwise>
      <contents xsi:type="CPL:Location" url="sip:archive@example.com" priority="0.3" clear="no"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="first">
    <redirection>
      <contents xsi:type="CPL:SubCall" ref="redirectHandler"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Reject" status="500" reason="Server Error"/>
    </failure>
    <default contents="//@elements.2"/>
  </elements>
  <elements xsi:type="CPL:SubAction" id="helperAction">
    <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
      <busy>
        <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="0.0" clear="yes"/>
      </busy>
      <noAnswer>
        <contents xsi:type="CPL:Location" url="sip:noanswer@example.com" priority="0.5" clear="yes"/>
      </noAnswer>
    </Proxy>
  </elements>
</CPL:CPLModel>