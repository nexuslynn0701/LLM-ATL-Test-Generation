<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:user@domain.com" contains="domain.com" subDomainOf="com"/>
        <addresses is="sip:admin@company.org" contains="company.org"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:voicemail@default.com" clear="yes" priority="1"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:TimeSwitch" dtstart="20240101T000000" interval="daily" wkst="MO">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="hourly" wkst="MO" freq="weekly" count="52"/>
            <times dtstart="20240101T170000" dtend="20240102T090000" interval="hourly" wkst="MO"/>
            <notPresent>
              <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential" timeout="30">
                <busy/>
                <noAnswer/>
                <redirection/>
                <failure/>
                <default contents="//@elements.2"/>
              </contents>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Redirect" permanent="false"/>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings is="urgent" contains="urgent"/>
        <strings is="meeting" contains="meeting"/>
        <notPresent>
          <contents xsi:type="CPL:PrioritySwitch">
            <priorities less="5" greater="1" equal="3"/>
            <priorities less="10" greater="7"/>
            <notPresent>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <notPresent>
                  <contents xsi:type="CPL:SubCall" ref="defaultHandler"/>
                </notPresent>
                <otherwise>
                  <contents xsi:type="CPL:Reject" status="603" reason="Language not supported"/>
                </otherwise>
              </contents>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:priority@queue.com" clear="no" priority="10"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Proxy" recurse="no" ordering="parallel" timeout="60">
            <busy>
              <contents xsi:type="CPL:Location" url="sip:busy@handler.com" clear="yes" priority="5"/>
            </busy>
            <noAnswer>
              <contents xsi:type="CPL:Location" url="sip:noanswer@handler.com" clear="yes" priority="5"/>
            </noAnswer>
            <default contents="//@elements.3"/>
          </contents>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="voicemailHandler"/>
  <elements xsi:type="CPL:Location" url="sip:fallback@default.com" clear="yes" priority="1"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" recurse="yes" ordering="sequential" timeout="45">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy2@handler.com" clear="yes" priority="2"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Location" url="sip:noanswer2@handler.com" clear="yes" priority="2"/>
    </noAnswer>
    <redirection>
      <contents xsi:type="CPL:Location" url="sip:redirected@handler.com" clear="yes" priority="2"/>
    </redirection>
    <failure>
      <contents xsi:type="CPL:Location" url="sip:failure@handler.com" clear="yes" priority="2"/>
    </failure>
    <default contents="//@elements.4"/>
  </elements>
</CPL:CPLModel>