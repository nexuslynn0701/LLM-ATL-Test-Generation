<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="initialAction"/>
    <subActions id="timeBasedAction"/>
    <outgoing>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <languages matches="fr"/>
        <notPresent>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="488" reason="NotAcceptableHere"/>
        </otherwise>
      </contents>
      <contents xsi:type="CPL:PrioritySwitch">
        <priorities less="5" greater="10"/>
        <notPresent>
          <contents xsi:type="CPL:Proxy" recurse="yes" ordering="parallel">
            <busy/>
            <noAnswer/>
            <failure/>
            <default contents="//@elements.7"/>
          </contents>
        </notPresent>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:AddressSwitch" field="from" subField="user">
        <addresses is="sip:admin@example.com"/>
        <addresses contains="sales" subDomainOf="example.net"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="403" reason="Forbidden"/>
        </notPresent>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubAction" id="timeBasedAction">
    <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tzurl.example.com">
      <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
      <times dtstart="20240101T000000" dtend="20240101T080000" interval="1" wkst="SU"/>
      <notPresent>
        <contents xsi:type="CPL:Default"/>
      </notPresent>
    </contents>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="timeBasedAction"/>
  <elements xsi:type="CPL:Location" url="sip:user@voicemail.example.com" priority="1" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
    <redirection/>
    <default contents="//@elements.2"/>
  </elements>
  <elements xsi:type="CPL:Reject" status="486" reason="BusyHere"/>
  <elements xsi:type="CPL:SubCall" ref="initialAction"/>
  <elements xsi:type="CPL:StringSwitch" field="subject">
    <strings is="urgent"/>
    <strings contains="meeting"/>
    <otherwise>
      <contents xsi:type="CPL:Busy"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:backup@example.com" priority="2" clear="no"/>
</CPL:CPLModel>