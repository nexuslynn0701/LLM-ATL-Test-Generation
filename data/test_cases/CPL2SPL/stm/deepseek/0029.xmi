<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainAction">
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.100" contains="example.com" subDomainOf="test.org"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:backup@test.org" priority="1" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <notPresent>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="1" equal="3"/>
                <otherwise>
                  <contents xsi:type="CPL:Redirect" permanent="false"/>
                </otherwise>
              </contents>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
                <busy>
                  <contents xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
                </busy>
                <noAnswer>
                  <contents xsi:type="CPL:Location" url="sip:voicemail@test.org" priority="2" clear="no"/>
                </noAnswer>
                <redirection>
                  <contents xsi:type="CPL:SubCall" ref="redirectHandler"/>
                </redirection>
                <failure>
                  <contents xsi:type="CPL:Reject" status="503" reason="Service Unavailable"/>
                </failure>
                <default contents="//@elements.2"/>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="method">
        <strings is="INVITE" contains="INVITE"/>
        <notPresent>
          <contents xsi:type="CPL:Reject" status="405" reason="Method Not Allowed"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:proxy@test.org" priority="1" clear="yes"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:support@test.org" priority="1" clear="yes"/>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:english@test.org" priority="2" clear="no"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="redirectHandler"/>
  <elements xsi:type="CPL:Location" url="sip:default@test.org" priority="0" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@test.org" priority="1" clear="yes"/>
    </busy>
    <default contents="//@elements.2"/>
  </elements>
</CPL:CPLModel>