<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="firstAction">
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="192.168.1.100"/>
        <notPresent>
          <contents xsi:type="CPL:Location" url="sip:backup@example.com" clear="no"/>
        </notPresent>
      </contents>
    </subActions>
    <outgoing>
      <contents xsi:type="CPL:StringSwitch" field="subject">
        <strings contains="urgent"/>
        <otherwise>
          <contents xsi:type="CPL:Reject" status="603" reason="Not Important"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:LanguageSwitch">
        <languages matches="en-US"/>
        <otherwise>
          <contents xsi:type="CPL:Redirect" permanent="yes"/>
        </otherwise>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch" field="priority">
    <priorities less="3"/>
    <notPresent>
      <contents xsi:type="CPL:SubCall" ref="defaultHandler"/>
    </notPresent>
  </elements>
  <elements xsi:type="CPL:TimeSwitch" tzid="America/New_York">
    <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
  </elements>
  <elements xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:busy@voicemail.com" clear="yes"/>
    </busy>
    <noAnswer>
      <contents xsi:type="CPL:Redirect" permanent="no"/>
    </noAnswer>
    <failure contents="//@elements.1"/>
  </elements>
  <elements xsi:type="CPL:Location" url="sip:user@domain.com" priority="high" clear="no">
    <contents xsi:type="CPL:SubAction" id="nestedAction"/>
  </elements>
</CPL:CPLModel>