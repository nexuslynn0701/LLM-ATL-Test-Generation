<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:alice@example.com" contains="example.com" subDomainOf="example.com"/>
        <addresses is="sip:bob@example.org" contains="example.org"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://tzurl.org">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="subject">
            <strings is="urgent" contains="urgent"/>
            <strings is="meeting" contains="meeting"/>
            <notPresent>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="3" greater="5" equal="4"/>
                <otherwise>
                  <contents xsi:type="CPL:Proxy" recurse="yes" ordering="sequential">
                    <busy>
                      <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="1" clear="no"/>
                    </busy>
                    <noAnswer>
                      <contents xsi:type="CPL:Redirect" permanent="no"/>
                    </noAnswer>
                    <default>
                      <contents xsi:type="CPL:SubCall" ref="mainRouting"/>
                    </default>
                  </contents>
                </otherwise>
              </contents>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <languages matches="fr"/>
                <otherwise>
                  <contents xsi:type="CPL:Reject" status="603" reason="Decline"/>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:SwitchedAddress" is="sip:incoming@example.com" contains="example.com"/>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="mainRouting"/>
  <elements xsi:type="CPL:Location" url="sip:default@example.com" priority="10" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="486" reason="Busy Here"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel" timeout="30">
    <busy>
      <contents xsi:type="CPL:Location" url="sip:alt@example.com" priority="2" clear="no"/>
    </busy>
    <failure>
      <contents xsi:type="CPL:Reject" status="500" reason="Server Error"/>
    </failure>
  </elements>
  <elements xsi:type="CPL:AddressSwitch" field="destination">
    <addresses is="sip:support@example.com" contains="support"/>
    <addresses is="sip:sales@example.com" contains="sales"/>
    <otherwise>
      <contents xsi:type="CPL:SubCall" ref="mainRouting"/>
    </otherwise>
  </elements>
  <elements xsi:type="CPL:StringSwitch" field="user-agent">
    <strings is="softphone" contains="softphone"/>
    <strings is="hardphone" contains="hardphone"/>
  </elements>
  <elements xsi:type="CPL:LanguageSwitch">
    <languages matches="de"/>
    <languages matches="es"/>
  </elements>
  <elements xsi:type="CPL:TimeSwitch">
    <times dtstart="20240101T000000" interval="1" wkst="MO"/>
    <times dtstart="20240101T080000" dtend="20240101T180000" interval="1" wkst="MO"/>
  </elements>
  <elements xsi:type="CPL:PrioritySwitch">
    <priorities less="1" greater="9" equal="5"/>
    <priorities less="2" equal="3"/>
  </elements>
</CPL:CPLModel>