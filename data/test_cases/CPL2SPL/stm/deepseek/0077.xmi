<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin">
        <addresses is="sip:user@domain.com" contains="domain.com"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York">
            <times dtstart="20240101T090000" dtend="20240101T170000" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:Location" url="sip:voicemail@example.com" priority="1" clear="yes"/>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:StringSwitch" field="subject">
            <strings is="urgent" contains="urgent"/>
            <notPresent>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="1"/>
                <otherwise>
                  <contents xsi:type="CPL:SubCall" ref="secondaryRouting"/>
                </otherwise>
              </contents>
            </notPresent>
            <otherwise>
              <contents xsi:type="CPL:LanguageSwitch">
                <languages matches="en"/>
                <notPresent>
                  <contents xsi:type="CPL:Redirect" permanent="false"/>
                </notPresent>
                <otherwise>
                  <contents xsi:type="CPL:Reject" status="603" reason="Language not supported"/>
                </otherwise>
              </contents>
            </otherwise>
          </contents>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="parallel">
        <busy>
          <contents xsi:type="CPL:Location" url="sip:busy@example.com" priority="1" clear="yes"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:Redirect" permanent="false"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:SubCall" ref="redirectHandler"/>
        </redirection>
        <failure>
          <contents xsi:type="CPL:Reject" status="500" reason="Server Error"/>
        </failure>
        <default contents="//@elements.2"/>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="secondaryRouting"/>
  <elements xsi:type="CPL:Location" url="sip:default@example.com" priority="10" clear="no"/>
  <elements xsi:type="CPL:Redirect" permanent="true"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="sequential">
    <busy/>
    <default contents="//@elements.3"/>
  </elements>
</CPL:CPLModel>