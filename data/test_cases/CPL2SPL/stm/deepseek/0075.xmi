<?xml version="1.0" encoding="UTF-8"?>
<CPL:CPLModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:CPL="http://cpl/1.0">
  <elements xsi:type="CPL:CPL">
    <subActions id="mainRouting"/>
    <outgoing>
      <contents xsi:type="CPL:AddressSwitch" field="origin" subField="host">
        <addresses is="192.168.1.100" contains="example.com" subDomainOf="test.org"/>
        <notPresent>
          <contents xsi:type="CPL:TimeSwitch" tzid="America/New_York" tzurl="http://timezone.example.com">
            <times dtstart="20240101T090000" dtend="20240101T170000" duration="PT8H" freq="DAILY" until="20241231T235959" count="365" interval="1" wkst="MO"/>
            <otherwise>
              <contents xsi:type="CPL:PrioritySwitch">
                <priorities less="5" greater="1" equal="3"/>
                <notPresent>
                  <contents xsi:type="CPL:LanguageSwitch">
                    <languages matches="en"/>
                    <otherwise>
                      <contents xsi:type="CPL:StringSwitch" field="user-agent">
                        <strings is="Mozilla" contains="Firefox"/>
                      </contents>
                    </otherwise>
                  </contents>
                </notPresent>
              </contents>
            </otherwise>
          </contents>
        </notPresent>
        <otherwise>
          <contents xsi:type="CPL:Location" url="sip:user@backup.example.com" priority="1" clear="yes"/>
        </otherwise>
      </contents>
    </outgoing>
    <incoming>
      <contents xsi:type="CPL:Proxy" timeout="30" recurse="yes" ordering="sequential">
        <busy>
          <contents xsi:type="CPL:Redirect" permanent="no"/>
        </busy>
        <noAnswer>
          <contents xsi:type="CPL:SubCall" ref="voicemailHandler"/>
        </noAnswer>
        <redirection>
          <contents xsi:type="CPL:Reject" status="603" reason="Declined"/>
        </redirection>
        <failure>
          <contents xsi:type="CPL:Location" url="sip:admin@failover.com" priority="2" clear="no"/>
        </failure>
        <default>
          <contents xsi:type="CPL:Location" url="sip:default@main.com" priority="0" clear="yes"/>
        </default>
      </contents>
    </incoming>
  </elements>
  <elements xsi:type="CPL:SubCall" ref="voicemailHandler"/>
  <elements xsi:type="CPL:Location" url="sip:user@main.example.com" priority="0" clear="yes"/>
  <elements xsi:type="CPL:Redirect" permanent="yes"/>
  <elements xsi:type="CPL:Reject" status="404" reason="Not Found"/>
  <elements xsi:type="CPL:Proxy" recurse="no" ordering="parallel">
    <busy/>
    <default contents="//@elements.2"/>
  </elements>
</CPL:CPLModel>