<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="Library">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Chapter" superClasses="//@ownedElements.0">
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Encyclopedia" superClasses="//@ownedElements.0 //@ownedElements.3">
    <ownedProperty name="volume" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="editor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>