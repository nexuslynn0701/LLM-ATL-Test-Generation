<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="library" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Library">
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Magazine" superClasses="//@ownedElements.0">
    <ownedProperty name="issueNumber" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="publisher" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ReferenceBook" superClasses="//@ownedElements.0">
    <ownedProperty name="edition" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>