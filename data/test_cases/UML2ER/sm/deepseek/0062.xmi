<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="joinedDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="birthYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="nationality" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="foundedYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="LibraryBranch" superClasses="//@ownedElements.0">
    <ownedProperty name="branchCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managerName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ReferenceBook" superClasses="//@ownedElements.1 //@ownedElements.2">
    <ownedProperty name="libraryUseOnly" primitiveType="Boolean" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>