<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.1">
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="syllabus" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="startDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="endDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="tasks" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Task">
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="priority" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="assignedTo" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>