<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="Library">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="chapters" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Chapter">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="subsections" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Subsection">
    <ownedProperty name="text" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="PrintedBook" superClasses="//@ownedElements.0">
    <ownedProperty name="weight" primitiveType="Float" isContainment="false"/>
  </ownedElements>
  <ownedElements name="EBook" superClasses="//@ownedElements.0">
    <ownedProperty name="fileSize" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="format" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>