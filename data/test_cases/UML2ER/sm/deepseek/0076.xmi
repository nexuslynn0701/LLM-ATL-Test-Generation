<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course" superClasses="//@ownedElements.4">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="syllabus" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="offerings" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Person">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.2">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="rank" primitiveType="String" isContainment="false"/>
    <ownedProperty name="office" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="DepartmentHead" superClasses="//@ownedElements.3">
    <ownedProperty name="department" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="startDate" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Syllabus">
    <ownedProperty name="topics" primitiveType="String" isContainment="false"/>
    <ownedProperty name="textbook" primitiveType="String" isContainment="false"/>
    <ownedProperty name="gradingPolicy" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="CourseOffering">
    <ownedProperty name="semester" primitiveType="String" isContainment="false"/>
    <ownedProperty name="year" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="capacity" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="enrolledStudents" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>