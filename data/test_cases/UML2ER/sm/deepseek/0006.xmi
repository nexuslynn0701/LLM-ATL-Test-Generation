<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.1">
    <ownedProperty name="courses" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="researchArea" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="syllabus" primitiveType="String" isContainment="false"/>
    <ownedProperty name="projects" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="topic" primitiveType="String" isContainment="false"/>
    <ownedProperty name="maxStudents" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="gpa" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="enrolledIn" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="assignedProject" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="GraduateStudent" superClasses="//@ownedElements.5">
    <ownedProperty name="thesisTopic" primitiveType="String" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>