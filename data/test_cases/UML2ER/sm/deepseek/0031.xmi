<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="chapter" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="born" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Chapter">
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="content" primitiveType="Text" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Encyclopedia" superClasses="//@ownedElements.0">
    <ownedProperty name="volume" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="topic" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>