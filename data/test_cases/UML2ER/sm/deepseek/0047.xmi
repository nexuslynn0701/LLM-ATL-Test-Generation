<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="loans" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="phone" primitiveType="String" isContainment="false"/>
    <ownedProperty name="loans" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="biography" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="yearFounded" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Loan">
    <ownedProperty name="loanDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="returnDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isReturned" primitiveType="Boolean" isContainment="false"/>
    <ownedProperty name="book" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="member" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person" superClasses="//@ownedElements.3 //@ownedElements.2">
    <ownedProperty name="dateOfBirth" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="PrintedBook" superClasses="//@ownedElements.1">
    <ownedProperty name="coverType" primitiveType="String" isContainment="false"/>
    <ownedProperty name="weight" primitiveType="Float" isContainment="false"/>
  </ownedElements>
  <ownedElements name="EBook" superClasses="//@ownedElements.1">
    <ownedProperty name="fileSize" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="format" primitiveType="String" isContainment="false"/>
    <ownedProperty name="downloadUrl" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="AudioBook" superClasses="//@ownedElements.1">
    <ownedProperty name="duration" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="narratorName" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>