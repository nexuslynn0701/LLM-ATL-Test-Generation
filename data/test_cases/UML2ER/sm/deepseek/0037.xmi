<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="Library">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="books" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="catalogue" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>