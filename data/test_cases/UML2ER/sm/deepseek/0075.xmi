<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="AcmeSystem">
  <ownedElements name="Component">
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Interface" superClasses="//@ownedElements.0">
    <ownedProperty name="operations" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Class" superClasses="//@ownedElements.1">
    <ownedProperty name="attributes" primitiveType="String" isContainment="false"/>
    <ownedProperty name="methods" primitiveType="String" isContainment="false"/>
    <ownedProperty name="inner" isContainment="true" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="AbstractClass" superClasses="//@ownedElements.2">
    <ownedProperty name="isAbstract" primitiveType="Boolean" isContainment="false"/>
  </ownedElements>
  <ownedElements name="FinalClass" superClasses="//@ownedElements.2">
    <ownedProperty name="isFinal" primitiveType="Boolean" isContainment="false"/>
    <ownedProperty name="constant" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="DataType">
    <ownedProperty name="defaultValue" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>