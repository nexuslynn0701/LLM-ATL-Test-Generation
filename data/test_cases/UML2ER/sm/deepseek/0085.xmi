<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Course"/>
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.1">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="enrolledCourses" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="teaches" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="head" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Enrollment">
    <ownedProperty name="student" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="course" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="grade" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>