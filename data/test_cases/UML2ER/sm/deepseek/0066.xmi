<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="int" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="double" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.1">
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="gpa" primitiveType="double" isContainment="false"/>
    <ownedProperty name="enrolledCourses" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="int" isContainment="false"/>
    <ownedProperty name="teacher" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="students" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="ResearchProject">
    <ownedProperty name="projectId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="double" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>