<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Person"/>
  <ownedElements name="Author" superClasses="//@ownedElements.0"/>
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="manager" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.0"/>
  <ownedElements name="Professor" superClasses="//@ownedElements.4"/>
  <ownedElements name="Student" superClasses="//@ownedElements.0"/>
</SimpleUml:Package>