<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibraryModel">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="birthYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="PrintedBook" superClasses="//@ownedElements.0">
    <ownedProperty name="coverType" primitiveType="String" isContainment="false"/>
    <ownedProperty name="weight" primitiveType="Double" isContainment="false"/>
  </ownedElements>
  <ownedElements name="EBook" superClasses="//@ownedElements.0">
    <ownedProperty name="fileSize" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="format" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>