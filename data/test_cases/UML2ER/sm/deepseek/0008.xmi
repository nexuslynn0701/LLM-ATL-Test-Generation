<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="enrolledCourses" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
    <ownedProperty name="teachesCourses" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="syllabus" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignments" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Assignment">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="maxScore" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="submissions" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Submission">
    <ownedProperty name="submitter" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="score" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="isLate" primitiveType="Boolean" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>