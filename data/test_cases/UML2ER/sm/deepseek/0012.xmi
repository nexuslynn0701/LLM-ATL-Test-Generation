<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="ECommerce">
  <ownedElements name="Order">
    <ownedProperty name="orderId" primitiveType="int" isContainment="false"/>
    <ownedProperty name="totalAmount" primitiveType="double" isContainment="false"/>
    <ownedProperty name="items" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="customer" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="OrderItem">
    <ownedProperty name="quantity" primitiveType="int" isContainment="false"/>
    <ownedProperty name="productName" primitiveType="string" isContainment="false"/>
    <ownedProperty name="price" primitiveType="double" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Customer">
    <ownedProperty name="name" primitiveType="string" isContainment="false"/>
    <ownedProperty name="email" primitiveType="string" isContainment="false"/>
    <ownedProperty name="address" primitiveType="string" isContainment="false"/>
    <ownedProperty name="orders" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="PremiumCustomer" superClasses="//@ownedElements.2">
    <ownedProperty name="discountRate" primitiveType="double" isContainment="false"/>
    <ownedProperty name="loyaltyPoints" primitiveType="int" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Invoice" superClasses="//@ownedElements.0">
    <ownedProperty name="invoiceDate" primitiveType="string" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="string" isContainment="false"/>
    <ownedProperty name="paid" primitiveType="boolean" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>