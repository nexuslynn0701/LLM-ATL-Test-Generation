<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Hardcover" superClasses="//@ownedElements.0">
    <ownedProperty name="coverMaterial" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="EBook" superClasses="//@ownedElements.0">
    <ownedProperty name="fileSizeMB" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="downloadLink" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Library">
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <ownedProperty name="collection" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>