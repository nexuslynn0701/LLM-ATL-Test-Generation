<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="authors" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="birthYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="booksWritten" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
    <ownedProperty name="foundedYear" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Member" superClasses="//@ownedElements.0">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="joinedDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Librarian" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="shift" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="EBook" superClasses="//@ownedElements.1">
    <ownedProperty name="fileSize" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="format" primitiveType="String" isContainment="false"/>
    <ownedProperty name="downloadUrl" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="PrintedBook" superClasses="//@ownedElements.1">
    <ownedProperty name="weight" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="coverType" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>