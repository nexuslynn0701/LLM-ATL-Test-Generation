<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Member">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="EBook" superClasses="//@ownedElements.1">
    <ownedProperty name="fileSize" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="format" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="PrintedBook" superClasses="//@ownedElements.1">
    <ownedProperty name="weight" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="coverType" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>