<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Person"/>
  <ownedElements name="Employee" superClasses="//@ownedElements.0"/>
  <ownedElements name="Professor" superClasses="//@ownedElements.1">
    <ownedProperty name="teaches" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="mentees" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="enrolledIn" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="syllabus" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Syllabus">
    <ownedProperty name="content" primitiveType="String" isContainment="false"/>
    <ownedProperty name="version" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>