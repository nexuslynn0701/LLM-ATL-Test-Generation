<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person"/>
  <ownedElements name="Employee" superClasses="//@ownedElements.0"/>
  <ownedElements name="Professor" superClasses="//@ownedElements.1"/>
  <ownedElements name="Student" superClasses="//@ownedElements.0"/>
  <ownedElements name="GraduateStudent" superClasses="//@ownedElements.3"/>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="enrolledStudents" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.5" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="ResearchProject">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="leadResearcher" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="participants" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>