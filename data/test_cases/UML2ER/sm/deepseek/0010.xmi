<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="TestLibrary">
  <ownedElements name="Library">
    <ownedProperty name="catalog" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Loan">
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="returned" primitiveType="Boolean" isContainment="false"/>
    <ownedProperty name="book" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="librarian" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Librarian" superClasses="//@ownedElements.4">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="DVD">
    <ownedProperty name="duration" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="director" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="BorrowingRecord">
    <ownedProperty name="startDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="endDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="loan" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>