<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="TestPackage">
  <ownedElements name="Person"/>
  <ownedElements name="Address"/>
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="empId" primitiveType="int" isContainment="false"/>
    <ownedProperty name="employer" primitiveType="string" isContainment="false"/>
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="string" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Company" superClasses="//@ownedElements.4">
    <ownedProperty name="companyName" primitiveType="string" isContainment="false"/>
    <ownedProperty name="mainOffice" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="departments" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>