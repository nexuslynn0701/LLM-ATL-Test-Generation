<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Person"/>
  <ownedElements name="Faculty" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeID" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentID" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="gpa" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="GraduateStudent" superClasses="//@ownedElements.2 //@ownedElements.1">
    <ownedProperty name="thesisTitle" primitiveType="String" isContainment="false"/>
    <ownedProperty name="supervisor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>