<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Department" superClasses=""/>
  <ownedElements name="Course" superClasses=""/>
  <ownedElements name="Student" superClasses="//@ownedElements.0"/>
  <ownedElements name="Professor" superClasses="//@ownedElements.0"/>
  <ownedElements name="LabSession" superClasses="//@ownedElements.1">
    <ownedProperty name="capacity" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Enrollment" superClasses="">
    <ownedProperty name="student" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="course" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="grade" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ResearchProject" superClasses="">
    <ownedProperty name="leader" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="participants" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>