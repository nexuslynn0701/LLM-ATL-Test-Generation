<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Department" superClasses="//@ownedElements.1"/>
  <ownedElements name="Organization"/>
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.2">
    <ownedProperty name="salary" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.3">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="researchProject" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <ownedElements name="ResearchProject">
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="PhDStudent" superClasses="//@ownedElements.2 //@ownedElements.3">
    <ownedProperty name="thesisTopic" primitiveType="String" isContainment="false"/>
    <ownedProperty name="supervisor" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>