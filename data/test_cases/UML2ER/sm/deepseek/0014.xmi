<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibraryExample">
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="publisherName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publishedBooks" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="chapters" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="author" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Chapter">
    <ownedProperty name="chapterTitle" primitiveType="String" isContainment="false"/>
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="sections" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Section">
    <ownedProperty name="sectionTitle" primitiveType="String" isContainment="false"/>
    <ownedProperty name="sectionNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Library" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <ownedProperty name="foundingYear" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="DigitalBook" superClasses="//@ownedElements.2">
    <ownedProperty name="fileFormat" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fileSizeMB" primitiveType="Float" isContainment="false"/>
  </ownedElements>
  <ownedElements name="PrintedBook" superClasses="//@ownedElements.2">
    <ownedProperty name="coverType" primitiveType="String" isContainment="false"/>
    <ownedProperty name="weight" primitiveType="Float" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>