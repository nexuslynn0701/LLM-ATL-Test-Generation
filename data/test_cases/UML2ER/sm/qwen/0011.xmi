<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="TestModel_0011">
  <ownedElements name="Vehicle">
    <ownedProperty name="brand" primitiveType="String" isContainment="false"/>
    <ownedProperty name="engine" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Engine">
    <ownedProperty name="horsepower" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="manufacturer" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Car" superClasses="//@ownedElements.0">
    <ownedProperty name="seats" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="trunk" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Trunk">
    <ownedProperty name="capacity" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="isOpen" primitiveType="Boolean" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ElectricCar" superClasses="//@ownedElements.2">
    <ownedProperty name="battery" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Battery">
    <ownedProperty name="kwh" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="cells" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>