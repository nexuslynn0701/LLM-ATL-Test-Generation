<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="TestModel_0100">
  <ownedElements name="Vehicle">
    <ownedProperty name="engineType" primitiveType="String" isContainment="false"/>
    <ownedProperty name="wheels" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Car" superClasses="//@ownedElements.0">
    <ownedProperty name="brand" primitiveType="String" isContainment="false"/>
    <ownedProperty name="driver" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Wheel">
    <ownedProperty name="diameter" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>