<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="TestModel_0062">
  <ownedElements name="Vehicle">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
