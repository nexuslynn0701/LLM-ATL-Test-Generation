<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="TestModel_0045">
  <ownedElements name="Vehicle">
    <ownedProperty name="engineType" primitiveType="String" isContainment="false"/>
    <ownedProperty name="wheels" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Wheel">
    <ownedProperty name="diameter" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="material" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Car" superClasses="//@ownedElements.0">
    <ownedProperty name="brand" primitiveType="String" isContainment="false"/>
    <ownedProperty name="trunk" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Trunk">
    <ownedProperty name="capacity" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="isOpen" primitiveType="Boolean" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ElectricCar" superClasses="//@ownedElements.2">
    <ownedProperty name="batteryLevel" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="charger" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>