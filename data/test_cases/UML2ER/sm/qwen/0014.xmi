<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="TestModel_0014">
  <ownedElements name="Vehicle">
    <ownedProperty name="id" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="engine" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Engine">
    <ownedProperty name="horsepower" primitiveType="EInt" isContainment="false"/>
    <ownedProperty name="manufacturer" primitiveType="EString" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Car" superClasses="//@ownedElements.0">
    <ownedProperty name="brand" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="trunk" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Trunk">
    <ownedProperty name="capacity" primitiveType="EDouble" isContainment="false"/>
    <ownedProperty name="isOpen" primitiveType="EBoolean" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ElectricCar" superClasses="//@ownedElements.2">
    <ownedProperty name="batteryLevel" primitiveType="EInt" isContainment="false"/>
    <ownedProperty name="charger" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Charger">
    <ownedProperty name="voltage" primitiveType="EInt" isContainment="false"/>
    <ownedProperty name="type" primitiveType="EString" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>