<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">

  <!-- Index 0 -->
  <ownedElements name="NamedEntity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="OrganizationUnit" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="subUnits" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Department" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="budget" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="teams" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="employer" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Team" superClasses="//@ownedElements.1">
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="ownerTeam" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="sponsorDepartment" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements name="Program" superClasses="//@ownedElements.5">
    <ownedProperty name="programCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="projects" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>