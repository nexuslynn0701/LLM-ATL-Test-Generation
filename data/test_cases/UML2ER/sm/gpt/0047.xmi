<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Address" superClasses="//@ownedElements.0">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="secondaryAddress" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Member" superClasses="//@ownedElements.2">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.2">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="loanDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="loanedBook" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>