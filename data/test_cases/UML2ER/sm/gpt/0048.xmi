<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">
  <ownedElements name="Entity"
                 superClasses="">
    <ownedProperty name="id"
                   primitiveType="String"
                   isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person"
                 superClasses="//@ownedElements.0">
    <ownedProperty name="firstName"
                   primitiveType="String"
                   isContainment="false"/>
    <ownedProperty name="lastName"
                   primitiveType="String"
                   isContainment="false"/>
    <ownedProperty name="primaryAddress"
                   complexType="//@ownedElements.3"
                   isContainment="true"/>
    <ownedProperty name="secondaryAddresses"
                   complexType="//@ownedElements.3"
                   isContainment="true"/>
  </ownedElements>
  <ownedElements name="Employee"
                 superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="salary"
                   primitiveType="Integer"
                   isContainment="false"/>
    <ownedProperty name="manager"
                   complexType="//@ownedElements.2"
                   isContainment="false"/>
    <ownedProperty name="assignedProjects"
                   complexType="//@ownedElements.4"
                   isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address"
                 superClasses="">
    <ownedProperty name="street"
                   primitiveType="String"
                   isContainment="false"/>
    <ownedProperty name="city"
                   primitiveType="String"
                   isContainment="false"/>
    <ownedProperty name="country"
                   primitiveType="String"
                   isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project"
                 superClasses="">
    <ownedProperty name="code"
                   primitiveType="String"
                   isContainment="false"/>
    <ownedProperty name="title"
                   primitiveType="String"
                   isContainment="false"/>
    <ownedProperty name="lead"
                   complexType="//@ownedElements.2"
                   isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department"
                 superClasses="//@ownedElements.0">
    <ownedProperty name="name"
                   primitiveType="String"
                   isContainment="false"/>
    <ownedProperty name="head"
                   complexType="//@ownedElements.2"
                   isContainment="false"/>
    <ownedProperty name="employees"
                   complexType="//@ownedElements.2"
                   isContainment="true"/>
  </ownedElements>
  <ownedElements name="Contractor"
                 superClasses="//@ownedElements.1">
    <ownedProperty name="dailyRate"
                   primitiveType="Real"
                   isContainment="false"/>
    <ownedProperty name="assignedDepartment"
                   complexType="//@ownedElements.5"
                   isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>