<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Timestamped">
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="updatedAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>
  <ownedElements name="User" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Member" superClasses="//@ownedElements.2">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedLoans" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Librarian" superClasses="//@ownedElements.2">
    <ownedProperty name="employeeCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publishedYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="copies" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Loan" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="loanDate" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="returnedDate" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="book" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="member" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Reservation" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="reservationDate" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="reservedBook" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="requestingMember" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Category">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentCategory" complexType="//@ownedElements.9" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>