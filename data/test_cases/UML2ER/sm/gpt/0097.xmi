<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="birthDate" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="projectId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="customer" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Contract" superClasses="//@ownedElements.0">
    <ownedProperty name="contractNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="customerName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="relatedProject" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="postalCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Office" superClasses="//@ownedElements.6">
    <ownedProperty name="floor" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="ownerDepartment" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="MeetingRoom" superClasses="//@ownedElements.7">
    <ownedProperty name="capacity" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="hasProjector" primitiveType="Boolean" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>