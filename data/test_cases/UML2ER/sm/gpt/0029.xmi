<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseSystem">
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdAt" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <ownedElements name="User" superClasses="//@ownedElements.0">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="profile" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="organization" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Organization" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="UserProfile">
    <ownedProperty name="displayName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="avatarUrl" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project" superClasses="//@ownedElements.0 //@ownedElements.2">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Task" superClasses="//@ownedElements.0">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="parentProject" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="subTasks" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>
  <ownedElements name="SubTask" superClasses="//@ownedElements.0">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="relatedTask" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <ownedElements name="AuditLog" superClasses="//@ownedElements.0">
    <ownedProperty name="action" primitiveType="String" isContainment="false"/>
    <ownedProperty name="actor" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="targetProject" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>