<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">
  <ownedElements name="Entity" />
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="subProjects" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Team" superClasses="//@ownedElements.2 //@ownedElements.3">
    <ownedProperty name="members" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Company">
    <ownedProperty name="hqAddress" complexType="//@ownedElements.6" isContainment="true"/>
    <ownedProperty name="legalName" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>