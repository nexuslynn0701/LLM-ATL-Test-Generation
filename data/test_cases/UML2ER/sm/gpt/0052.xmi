<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">

  <!-- 0 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Organization" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Department" superClasses="//@ownedElements.2">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="subDepartment" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Employee" superClasses="//@ownedElements.1 //@ownedElements.3">
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="primaryDepartment" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Task">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="details" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignedTo" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="parentTask" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Office" superClasses="//@ownedElements.7">
    <ownedProperty name="floor" primitiveType="String" isContainment="false"/>
    <ownedProperty name="roomNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Meeting">
    <ownedProperty name="subject" primitiveType="String" isContainment="false"/>
    <ownedProperty name="host" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="location" complexType="//@ownedElements.8" isContainment="false"/>
    <ownedProperty name="scheduledBy" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>