<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Author" superClasses="//@ownedElements.1">
    <ownedProperty name="biography" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="coAuthors" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="LibraryBranch" superClasses="//@ownedElements.0">
    <ownedProperty name="branchName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="loanDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="loanedBook" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Index 7 -->
  <ownedElements name="Reservation" superClasses="//@ownedElements.0">
    <ownedProperty name="reservationDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="reservedBook" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="requester" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 8 -->
  <ownedElements name="Catalog" superClasses="//@ownedElements.0">
    <ownedProperty name="catalogName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="entries" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Index 9 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedBranch" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>