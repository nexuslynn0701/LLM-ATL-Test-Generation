<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="Entity"/>

  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Author" superClasses="//@ownedElements.1">
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipNo" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedLoans" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="ReferenceBook" superClasses="//@ownedElements.4">
    <ownedProperty name="section" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Loan">
    <ownedProperty name="loanDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="item" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="loans" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>