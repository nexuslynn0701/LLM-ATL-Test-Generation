<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Member" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Librarian" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Shelf">
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="startDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="endDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="item" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="shelves" complexType="//@ownedElements.5" isContainment="true"/>
    <ownedProperty name="loans" complexType="//@ownedElements.6" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="librarians" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>