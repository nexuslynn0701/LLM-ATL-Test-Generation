<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="Entity"/>

  <!-- Index 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Author" superClasses="//@ownedElements.1">
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publishedBooks" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedItems" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="loanDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="book" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- Index 7 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedLoans" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>

  <!-- Index 8 -->
  <ownedElements name="LibraryBranch" superClasses="//@ownedElements.0">
    <ownedProperty name="branchName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>