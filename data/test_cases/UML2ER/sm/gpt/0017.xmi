<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="NamedEntity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Author" superClasses="//@ownedElements.1">
    <ownedProperty name="biography" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 7 -->
  <ownedElements name="EBook" superClasses="//@ownedElements.6">
    <ownedProperty name="downloadUrl" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 8 -->
  <ownedElements name="PrintedBook" superClasses="//@ownedElements.6">
    <ownedProperty name="shelfCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 9 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="borrowedBook" complexType="//@ownedElements.6" isContainment="false"/>
    <ownedProperty name="borrowingMember" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="loanDate" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 10 -->
  <ownedElements name="Reservation" superClasses="//@ownedElements.0">
    <ownedProperty name="reservedBook" complexType="//@ownedElements.6" isContainment="false"/>
    <ownedProperty name="requestingMember" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>