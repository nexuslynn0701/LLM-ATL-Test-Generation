<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- ownedElements index 0 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Entity"/>

  <!-- ownedElements index 1 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Person"
                 superClasses="//@ownedElements.0">
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- ownedElements index 2 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Staff"
                 superClasses="//@ownedElements.1">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- ownedElements index 3 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Member"
                 superClasses="//@ownedElements.1">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- ownedElements index 4 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Category"/>

  <!-- ownedElements index 5 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Book"
                 superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="category" isContainment="false" complexType="//@ownedElements.4"/>
  </ownedElements>

  <!-- ownedElements index 6 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Loan"
                 superClasses="//@ownedElements.0">
    <ownedProperty name="borrower" isContainment="false" complexType="//@ownedElements.3"/>
    <ownedProperty name="item" isContainment="false" complexType="//@ownedElements.5"/>
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
  </ownedElements>

  <!-- ownedElements index 7 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" isContainment="true" complexType="//@ownedElements.5"/>
    <ownedProperty name="members" isContainment="true" complexType="//@ownedElements.3"/>
    <ownedProperty name="loans" isContainment="true" complexType="//@ownedElements.6"/>
    <ownedProperty name="staff" isContainment="true" complexType="//@ownedElements.2"/>
  </ownedElements>

</SimpleUml:Package>