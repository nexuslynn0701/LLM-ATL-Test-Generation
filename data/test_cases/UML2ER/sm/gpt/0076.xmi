<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">
  <ownedElements name="Entity" />
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Author" superClasses="//@ownedElements.1">
    <ownedProperty name="biography" primitiveType="String" isContainment="false"/>
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Loan">
    <ownedProperty name="loanDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="loanedBook" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="loans" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>