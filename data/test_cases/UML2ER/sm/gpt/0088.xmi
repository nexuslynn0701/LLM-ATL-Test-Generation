<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Author" superClasses="//@ownedElements.1">
    <ownedProperty name="biography" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="postalCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainAddress" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryAuthor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="startDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBook" complexType="//@ownedElements.6" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Reservation" superClasses="//@ownedElements.0 //@ownedElements.7">
    <ownedProperty name="reservationDate" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>