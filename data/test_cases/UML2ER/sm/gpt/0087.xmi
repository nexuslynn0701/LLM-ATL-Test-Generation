<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="ComplexDomainModel">

  <!-- 0 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Timestamped" superClasses="//@ownedElements.0">
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="updatedAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements xmi:type="SimpleUml:Class" name="User" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="profile" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Profile" superClasses="//@ownedElements.1">
    <ownedProperty name="displayName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="bio" primitiveType="String" isContainment="false"/>
    <ownedProperty name="avatarUrl" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Project" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="tasks" complexType="//@ownedElements.6" isContainment="true"/>
    <ownedProperty name="contributors" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Comment" superClasses="//@ownedElements.1">
    <ownedProperty name="text" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Task" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="status" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="project" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="subTasks" complexType="//@ownedElements.7" isContainment="true"/>
    <ownedProperty name="comments" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements xmi:type="SimpleUml:Class" name="SubTask" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="completed" primitiveType="Boolean" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Tag">
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <ownedProperty name="color" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements xmi:type="SimpleUml:Class" name="TaggedItem">
    <ownedProperty name="tags" complexType="//@ownedElements.8" isContainment="false"/>
  </ownedElements>

  <!-- 10 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Milestone" superClasses="//@ownedElements.0 //@ownedElements.1 //@ownedElements.9">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>