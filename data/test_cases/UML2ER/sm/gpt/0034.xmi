<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="UniversitySystem">

  <ownedElements name="NamedEntity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <ownedElements name="Student" superClasses="//@ownedElements.1">
    <ownedProperty name="matriculationNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <ownedElements name="Professor" superClasses="//@ownedElements.1">
    <ownedProperty name="office" primitiveType="String" isContainment="false"/>
    <ownedProperty name="supervisor" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <ownedElements name="Course" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="teacher" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="enrolledStudents" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <ownedElements name="ResearchGroup" superClasses="//@ownedElements.0">
    <ownedProperty name="groupName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="leader" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>