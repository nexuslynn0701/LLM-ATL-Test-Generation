<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="parentDepartment" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project" superClasses="//@ownedElements.0 //@ownedElements.2">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Task" superClasses="//@ownedElements.0 //@ownedElements.3">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="subTasks" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Client" superClasses="//@ownedElements.0">
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contactPerson" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="mainProject" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Office" superClasses="//@ownedElements.6">
    <ownedProperty name="roomNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="resident" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>