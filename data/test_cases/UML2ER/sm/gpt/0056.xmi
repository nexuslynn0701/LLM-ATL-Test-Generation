<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">
  <ownedElements name="NamedEntity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdOn" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Organization" superClasses="//@ownedElements.0">
    <ownedProperty name="legalName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="departments" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.3">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="worksIn" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="subordinates" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Contractor" superClasses="//@ownedElements.3">
    <ownedProperty name="contractId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignedDepartment" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="participants" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>