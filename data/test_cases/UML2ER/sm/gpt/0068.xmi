<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="ECommerceDomain">

  <!-- 0 -->
  <ownedElements name="Entity">
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Timestamped" superClasses="//@ownedElements.0">
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="updatedAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="User" superClasses="//@ownedElements.0">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="passwordHash" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Customer" superClasses="//@ownedElements.2 //@ownedElements.1">
    <ownedProperty name="shippingAddress" primitiveType="String" isContainment="false"/>
    <ownedProperty name="billingAddress" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Admin" superClasses="//@ownedElements.2 //@ownedElements.1">
    <ownedProperty name="role" primitiveType="String" isContainment="false"/>
    <ownedProperty name="permissions" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Category" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentCategory" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Product" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="sku" primitiveType="String" isContainment="false"/>
    <ownedProperty name="price" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="mainCategory" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Order" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="orderNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="totalAmount" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="customer" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="OrderItem" superClasses="//@ownedElements.0">
    <ownedProperty name="quantity" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="unitPrice" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="product" complexType="//@ownedElements.6" isContainment="false"/>
    <ownedProperty name="order" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements name="ShoppingCart" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="owner" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="createdByAdmin" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 10 -->
  <ownedElements name="CartItem" superClasses="//@ownedElements.0">
    <ownedProperty name="quantity" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="product" complexType="//@ownedElements.6" isContainment="false"/>
    <ownedProperty name="cart" complexType="//@ownedElements.9" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>