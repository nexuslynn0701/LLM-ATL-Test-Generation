<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">

  <!-- Index 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="projectCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="teamMembers" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="Customer" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="customerId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryContact" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="assignedAccountManager" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 7 -->
  <ownedElements name="Office" superClasses="//@ownedElements.6 //@ownedElements.0">
    <ownedProperty name="officeCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headOfOffice" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>