<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- 0 -->
  <ownedElements name="NamedEntity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="PhysicalItem" superClasses="//@ownedElements.0">
    <ownedProperty name="locationCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="DigitalItem" superClasses="//@ownedElements.0">
    <ownedProperty name="url" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fileSizeMB" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Book" superClasses="//@ownedElements.1 //@ownedElements.2">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Journal" superClasses="//@ownedElements.2">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="impactFactor" primitiveType="Double" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Shelf" superClasses="//@ownedElements.1">
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <ownedProperty name="containedItem" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="libraryName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainShelf" complexType="//@ownedElements.6" isContainment="true"/>
    <ownedProperty name="featuredDigital" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>