<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="AcademicModel">

  <!-- 0 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Course" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Student" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="studentNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="enrolledCourses" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Professor" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="teaches" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Enrollment" superClasses="//@ownedElements.0">
    <ownedProperty name="grade" primitiveType="String" isContainment="false"/>
    <ownedProperty name="enrolledStudent" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="enrolledCourse" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements xmi:type="SimpleUml:Class" name="GraduateStudent" superClasses="//@ownedElements.3">
    <ownedProperty name="thesisTitle" primitiveType="String" isContainment="false"/>
    <ownedProperty name="supervisor" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements xmi:type="SimpleUml:Class" name="ResearchProject" superClasses="//@ownedElements.0">
    <ownedProperty name="projectName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="leadProfessor" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="participants" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>