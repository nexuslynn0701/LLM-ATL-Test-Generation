<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="UniversityModel">
  <ownedElements name="NamedEntity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.1">
    <ownedProperty name="enrollmentNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="University" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainDepartment" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>