<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">

  <!-- 0 -->
  <ownedElements name="BaseEntity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="User" superClasses="//@ownedElements.0">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Task" superClasses="//@ownedElements.0 //@ownedElements.2">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="subTasks" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Comment" superClasses="//@ownedElements.0">
    <ownedProperty name="text" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="parentTask" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Attachment" superClasses="//@ownedElements.0">
    <ownedProperty name="fileName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fileSize" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="linkedTask" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="linkedComment" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>