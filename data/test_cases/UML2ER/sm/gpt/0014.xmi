<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="UniversityModel">

  <!-- Index 0 -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Course">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 2: subclass of Person, references Course and Department -->
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="matriculationNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="enrolledIn" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="majorDepartment" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 3: Department, contains Courses and references Teacher -->
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="offeredCourse" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="head" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Index 4: Teacher subclass of Person, containment of Course and ref to Department -->
  <ownedElements name="Teacher" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="teaches" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="worksIn" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 5: Program subclass of Department, multiple inheritance and mixed properties -->
  <ownedElements name="Program" superClasses="//@ownedElements.3 //@ownedElements.0">
    <ownedProperty name="programCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="coreCourse" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Index 6: Dormitory unrelated class with only primitive properties -->
  <ownedElements name="Dormitory">
    <ownedProperty name="buildingName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="capacity" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>