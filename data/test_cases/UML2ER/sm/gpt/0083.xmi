<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseDomain">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Organization" superClasses="//@ownedElements.0">
    <ownedProperty name="legalName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="registrationNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="employer" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Department" superClasses="//@ownedElements.2">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="subDepartments" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="projectCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="ownerDepartment" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Client" superClasses="//@ownedElements.1">
    <ownedProperty name="clientId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="accountManager" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="primaryOrganization" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Intern" superClasses="//@ownedElements.3">
    <ownedProperty name="schoolName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mentor" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>