<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Staff" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipId" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="startDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="endDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="borrowedBook" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Reservation" superClasses="//@ownedElements.0 //@ownedElements.5">
    <ownedProperty name="reservedBy" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="reservedBook" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="notes" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="ownedBooks" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="registeredMembers" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>