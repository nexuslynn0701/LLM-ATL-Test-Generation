<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">
  <ownedElements name="NamedEntity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Project" superClasses="//@ownedElements.0 //@ownedElements.3">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="ownerDepartment" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="postalCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Customer" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="customerId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="billingAddress" complexType="//@ownedElements.5" isContainment="true"/>
    <ownedProperty name="shippingAddress" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Supplier" superClasses="//@ownedElements.0">
    <ownedProperty name="supplierCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contactPerson" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>