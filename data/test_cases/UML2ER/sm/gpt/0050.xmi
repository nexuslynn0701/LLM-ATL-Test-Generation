<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="AcademicModel">

  <!-- Index 0 -->
  <ownedElements name="NamedEntity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Teacher" superClasses="//@ownedElements.1">
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Student" superClasses="//@ownedElements.1">
    <ownedProperty name="matriculationNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="Course" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="teacher" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="enrolledStudents" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements name="Classroom" superClasses="//@ownedElements.0">
    <ownedProperty name="roomNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="capacity" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- Index 7 -->
  <ownedElements name="ScheduleEntry" superClasses="//@ownedElements.0">
    <ownedProperty name="dayOfWeek" primitiveType="String" isContainment="false"/>
    <ownedProperty name="startTime" primitiveType="String" isContainment="false"/>
    <ownedProperty name="endTime" primitiveType="String" isContainment="false"/>
    <ownedProperty name="course" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="room" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>