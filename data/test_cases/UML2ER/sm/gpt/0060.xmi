<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">

  <!-- Index 0 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Organization" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Department" superClasses="//@ownedElements.2">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentOrganization" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Employee" superClasses="//@ownedElements.1 //@ownedElements.3">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="homeAddress" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="ownerDepartment" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="leadEmployee" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Index 7 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Contractor" superClasses="//@ownedElements.1">
    <ownedProperty name="contractId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="agency" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>