<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseSystem">
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="NamedEntity" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department" superClasses="//@ownedElements.1">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.1 //@ownedElements.4">
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="supervisor" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Manager" superClasses="//@ownedElements.3">
    <ownedProperty name="officeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="team" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Task" superClasses="//@ownedElements.0">
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="subTask" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Meeting" superClasses="//@ownedElements.0">
    <ownedProperty name="topic" primitiveType="String" isContainment="false"/>
    <ownedProperty name="organizer" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="relatedProject" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>