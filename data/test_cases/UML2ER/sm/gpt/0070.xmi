<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <ownedElements name="User" superClasses="//@ownedElements.0">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <ownedElements name="Librarian" superClasses="//@ownedElements.1">
    <ownedProperty name="staffId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedBranch" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <ownedElements name="EBook" superClasses="//@ownedElements.4">
    <ownedProperty name="fileFormat" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fileSizeMB" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="startDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="item" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <ownedElements name="Review" superClasses="//@ownedElements.0">
    <ownedProperty name="rating" primitiveType="String" isContainment="false"/>
    <ownedProperty name="comment" primitiveType="String" isContainment="false"/>
    <ownedProperty name="reviewer" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="reviewedBook" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <ownedElements name="LibraryBranch" superClasses="//@ownedElements.0">
    <ownedProperty name="branchName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <ownedElements name="Reservation" superClasses="//@ownedElements.0">
    <ownedProperty name="reservationDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="reservedBy" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="reservedItem" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>