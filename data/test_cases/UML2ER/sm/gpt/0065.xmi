<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="AuditedEntity" superClasses="//@ownedElements.0">
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="updatedAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>
  <ownedElements name="User" superClasses="//@ownedElements.1">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Group" superClasses="//@ownedElements.1">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project" superClasses="//@ownedElements.1">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" isContainment="false" complexType="//@ownedElements.2"/>
    <ownedProperty name="subProjects" isContainment="true" complexType="//@ownedElements.4"/>
  </ownedElements>
  <ownedElements name="Task" superClasses="//@ownedElements.1">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignee" isContainment="false" complexType="//@ownedElements.2"/>
    <ownedProperty name="parentProject" isContainment="false" complexType="//@ownedElements.4"/>
    <ownedProperty name="subTasks" isContainment="true" complexType="//@ownedElements.5"/>
  </ownedElements>
  <ownedElements name="Organization">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="members" isContainment="true" complexType="//@ownedElements.2"/>
    <ownedProperty name="groups" isContainment="true" complexType="//@ownedElements.3"/>
    <ownedProperty name="activeProject" isContainment="false" complexType="//@ownedElements.4"/>
  </ownedElements>
</SimpleUml:Package>