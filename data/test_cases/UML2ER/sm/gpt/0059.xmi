<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EducationalPlatform">
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="User" superClasses="//@ownedElements.0">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Instructor" superClasses="//@ownedElements.1">
    <ownedProperty name="bio" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Learner" superClasses="//@ownedElements.1">
    <ownedProperty name="enrollmentDate" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Module" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="course" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Lesson" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="module" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Assessment" superClasses="//@ownedElements.0">
    <ownedProperty name="maxScore" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="course" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Submission" superClasses="//@ownedElements.0">
    <ownedProperty name="score" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="assessment" complexType="//@ownedElements.7" isContainment="false"/>
    <ownedProperty name="learner" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="DiscussionThread" superClasses="//@ownedElements.0">
    <ownedProperty name="topic" primitiveType="String" isContainment="false"/>
    <ownedProperty name="course" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="creator" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Message" superClasses="//@ownedElements.0">
    <ownedProperty name="content" primitiveType="String" isContainment="false"/>
    <ownedProperty name="thread" complexType="//@ownedElements.9" isContainment="true"/>
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>