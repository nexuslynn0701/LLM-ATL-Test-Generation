<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- Index 0 -->
  <ownedElements xsi:type="SimpleUml:Class" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      name="Item">
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements xsi:type="SimpleUml:Class"
      name="Book"
      superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publicationYear" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements xsi:type="SimpleUml:Class"
      name="Magazine"
      superClasses="//@ownedElements.0">
    <ownedProperty name="issueNumber" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements xsi:type="SimpleUml:Class"
      name="Author">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements xsi:type="SimpleUml:Class"
      name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements xsi:type="SimpleUml:Class"
      name="Library">
    <ownedProperty name="books" isContainment="true" complexType="//@ownedElements.1"/>
    <ownedProperty name="magazines" isContainment="true" complexType="//@ownedElements.2"/>
    <ownedProperty name="mainPublisher" isContainment="false" complexType="//@ownedElements.4"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements xsi:type="SimpleUml:Class"
      name="DigitalLibrary"
      superClasses="//@ownedElements.5">
    <ownedProperty name="url" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 7 -->
  <ownedElements xsi:type="SimpleUml:Class"
      name="Contributor">
    <ownedProperty name="person" isContainment="false" complexType="//@ownedElements.3"/>
    <ownedProperty name="role" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 8 -->
  <ownedElements xsi:type="SimpleUml:Class"
      name="Review">
    <ownedProperty name="rating" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="text" primitiveType="String" isContainment="false"/>
    <ownedProperty name="forItem" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>

  <!-- Index 9 -->
  <ownedElements xsi:type="SimpleUml:Class"
      name="SpecialEdition"
      superClasses="//@ownedElements.1 //@ownedElements.2">
    <ownedProperty name="extraContent" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>