<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="UniversityModel">

  <!-- 0 -->
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Student" superClasses="//@ownedElements.1">
    <ownedProperty name="matriculationNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Professor" superClasses="//@ownedElements.1">
    <ownedProperty name="office" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Course" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Enrollment" superClasses="//@ownedElements.0">
    <ownedProperty name="student" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="course" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="grade" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Transcript" superClasses="//@ownedElements.0">
    <ownedProperty name="owner" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="entries" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Program" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="requiredCourse" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="director" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>