<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- Index 0 -->
  <ownedElements name="Entity" />
  <!-- Index 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Index 2 -->
  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Index 3 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Index 4 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="authorName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Index 5 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="loanDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="returnDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="book" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- Index 6 -->
  <ownedElements name="Reservation" superClasses="//@ownedElements.0 //@ownedElements.5">
    <ownedProperty name="reservedOn" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="reservedBook" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="reservedFor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- Index 7 -->
  <ownedElements name="Shelf" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Index 8 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="loans" complexType="//@ownedElements.5" isContainment="true"/>
    <ownedProperty name="reservations" complexType="//@ownedElements.6" isContainment="true"/>
    <ownedProperty name="shelves" complexType="//@ownedElements.7" isContainment="true"/>
    <ownedProperty name="librarians" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <!-- Index 9 -->
  <ownedElements name="DigitalResource" superClasses="//@ownedElements.0">
    <ownedProperty name="url" primitiveType="String" isContainment="false"/>
    <ownedProperty name="format" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Index 10 -->
  <ownedElements name="EBook" superClasses="//@ownedElements.4 //@ownedElements.9">
    <ownedProperty name="fileSizeMB" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>