<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="authors" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Author" superClasses="//@ownedElements.1">
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="librarians" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="DigitalLibrary" superClasses="//@ownedElements.6">
    <ownedProperty name="url" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="BranchLibrary" superClasses="//@ownedElements.6">
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentLibrary" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements name="Review" superClasses="//@ownedElements.0">
    <ownedProperty name="rating" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="comment" primitiveType="String" isContainment="false"/>
    <ownedProperty name="book" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="reviewer" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>