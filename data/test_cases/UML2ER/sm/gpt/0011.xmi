<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contactAddress" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="salary" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="assignedProjects" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Contractor" superClasses="//@ownedElements.1">
    <ownedProperty name="hourlyRate" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="primaryProject" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>