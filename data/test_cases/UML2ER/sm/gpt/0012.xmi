<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="CompanyModel">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="teams" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="employeeNumber" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="projects" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Team" superClasses="//@ownedElements.0">
    <ownedProperty name="teamName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="projectCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="customerName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="participatingTeams" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Office" superClasses="//@ownedElements.6 //@ownedElements.0">
    <ownedProperty name="buildingName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="floor" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="MeetingRoom" superClasses="//@ownedElements.7">
    <ownedProperty name="roomNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="capacity" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements name="Company" superClasses="//@ownedElements.0">
    <ownedProperty name="legalName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="registrationNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="hqAddress" complexType="//@ownedElements.6" isContainment="true"/>
    <ownedProperty name="departments" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="offices" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>