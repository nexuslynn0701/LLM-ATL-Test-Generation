<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Author" superClasses="//@ownedElements.1">
    <ownedProperty name="biography" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publicationYear" primitiveType="Integer" isContainment="false"/>
    <!-- non-containment association to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Library">
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <!-- containment of Book -->
    <ownedProperty name="books" complexType="//@ownedElements.4" isContainment="true"/>
    <!-- non-containment to Member -->
    <ownedProperty name="registeredMembers" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Loan">
    <ownedProperty name="loanDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
    <!-- association to Book -->
    <ownedProperty name="book" complexType="//@ownedElements.4" isContainment="false"/>
    <!-- association to Member -->
    <ownedProperty name="borrower" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 7 -->
  <ownedElements xmi:type="SimpleUml:Class" name="PremiumMember" superClasses="//@ownedElements.3 //@ownedElements.1">
    <ownedProperty name="discountRate" primitiveType="Double" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>