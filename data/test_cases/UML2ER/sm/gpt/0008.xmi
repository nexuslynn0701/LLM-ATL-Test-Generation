<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Auditable" superClasses="//@ownedElements.0">
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="updatedAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.2 //@ownedElements.3">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="subordinates" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="department" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Address" superClasses="//@ownedElements.0">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Office" superClasses="//@ownedElements.6">
    <ownedProperty name="floor" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="occupants" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Customer" superClasses="//@ownedElements.2 //@ownedElements.1">
    <ownedProperty name="customerId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="accountManager" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>