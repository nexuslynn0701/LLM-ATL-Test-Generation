<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">

  <!-- Index 0 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Address" superClasses="//@ownedElements.0">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Employee" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="salary" primitiveType="String" isContainment="false"/>
    <!-- non-containment association to Address -->
    <ownedProperty name="officeAddress" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- containment association to Address -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Manager" superClasses="//@ownedElements.3 //@ownedElements.1">
    <ownedProperty name="level" primitiveType="String" isContainment="false"/>
    <!-- self-association to Manager (e.g., mentor) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <!-- containment association to Employee -->
    <ownedProperty name="employees" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- head is a non-containment reference to Manager -->
    <ownedProperty name="head" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements xsi:type="SimpleUml:Class" name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- many-to-many like: non-containment association to Employee -->
    <ownedProperty name="teamMembers" complexType="//@ownedElements.3" isContainment="false"/>
    <!-- containment association to Department (e.g., primary owning department) -->
    <ownedProperty name="owningDepartment" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>