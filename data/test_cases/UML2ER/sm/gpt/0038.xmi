<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="NamedElementBase"/>

  <!-- 1 -->
  <ownedElements name="Item">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Book" superClasses="//@ownedElements.1">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="chapters" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="booksWritten" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Chapter">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Member" superClasses="//@ownedElements.0">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contactInfo" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="ContactInfo">
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="phone" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="PremiumMember" superClasses="//@ownedElements.5 //@ownedElements.8">
    <ownedProperty name="loyaltyPoints" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Account">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="passwordHash" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements name="Loan">
    <ownedProperty name="loanDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="borrowedItem" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 10 -->
  <ownedElements name="Reservation">
    <ownedProperty name="reservedOn" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="reservedBy" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="reservedItem" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 11 -->
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.5" isContainment="true"/>
    <ownedProperty name="premiumMembers" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>