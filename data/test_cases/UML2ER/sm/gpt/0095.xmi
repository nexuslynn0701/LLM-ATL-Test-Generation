<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="User" superClasses="//@ownedElements.0">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Member" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Librarian" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="loanId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="loanDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="book" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Reservation" superClasses="//@ownedElements.0">
    <ownedProperty name="requestDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="reservedBook" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="requestingMember" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="LibraryBranch" superClasses="//@ownedElements.0">
    <ownedProperty name="branchName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Shelf" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="locatedIn" complexType="//@ownedElements.7" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Copy" superClasses="//@ownedElements.0">
    <ownedProperty name="copyNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="condition" primitiveType="String" isContainment="false"/>
    <ownedProperty name="originalBook" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="storedOn" complexType="//@ownedElements.8" isContainment="false"/>
  </ownedElements>
  <ownedElements name="LibrarySystemRoot">
    <ownedProperty name="mainBranch" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>