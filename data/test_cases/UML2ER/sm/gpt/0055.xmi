<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Librarian" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Address" superClasses="//@ownedElements.0">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="loanDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="returnDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="item" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Catalog" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>