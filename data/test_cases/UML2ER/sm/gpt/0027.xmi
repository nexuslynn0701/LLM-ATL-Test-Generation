<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibraryDomain">
  <ownedElements name="Entity" />
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Staff" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managesBranch" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedLoans" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <ownedElements name="LibraryBranch" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.6" isContainment="true"/>
    <ownedProperty name="loans" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="loanDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="returnDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="bookCopy" complexType="//@ownedElements.7" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.8" isContainment="false"/>
    <ownedProperty name="copies" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>
  <ownedElements name="BookCopy" superClasses="//@ownedElements.0">
    <ownedProperty name="copyNumber" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="condition" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Author" superClasses="//@ownedElements.1">
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>