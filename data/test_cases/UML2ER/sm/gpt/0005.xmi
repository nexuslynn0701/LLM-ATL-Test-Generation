<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="DomainModel">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Company" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headOffice" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employer" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="officeAddress" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="location" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Project">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="client" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Contract" superClasses="//@ownedElements.0">
    <ownedProperty name="reference" primitiveType="String" isContainment="false"/>
    <ownedProperty name="customer" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="supplier" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Intern" superClasses="//@ownedElements.4 //@ownedElements.1">
    <ownedProperty name="university" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>