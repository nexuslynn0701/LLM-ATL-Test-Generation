<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversityModel">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="birthDate" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="offeredBy" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="enrolledCourses" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="teaches" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="affiliation" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>