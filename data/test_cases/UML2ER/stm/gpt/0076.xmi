<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EducationAndPublishing">
  <!-- 0 -->
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Teacher" superClasses="//@ownedElements.1">
    <ownedProperty name="salary" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Student" superClasses="//@ownedElements.1">
    <ownedProperty name="registrationNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Course" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainTeacher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Enrollment">
    <ownedProperty name="student" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="course" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.9" isContainment="false"/>
  </ownedElements>
  <!-- 9 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 10 -->
  <ownedElements name="LibraryHolding">
    <ownedProperty name="library" complexType="//@ownedElements.7" isContainment="false"/>
    <ownedProperty name="book" complexType="//@ownedElements.8" isContainment="false"/>
    <ownedProperty name="copies" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <!-- 11 -->
  <ownedElements name="Program" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- 12 -->
  <ownedElements name="Thesis">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="student" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="supervisor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- 13 -->
  <ownedElements name="ResearchGroup" superClasses="//@ownedElements.0">
    <ownedProperty name="groupName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="leader" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>