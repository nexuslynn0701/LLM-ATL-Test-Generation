<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseDomain">

  <!-- 0 -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Customer" superClasses="//@ownedElements.0">
    <ownedProperty name="customerNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="shippingAddress" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="billingAddress" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="officeAddress" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Product">
    <ownedProperty name="sku" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Order">
    <ownedProperty name="orderNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="customer" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="billingAddress" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="OrderLine">
    <ownedProperty name="quantity" primitiveType="int" isContainment="false"/>
    <ownedProperty name="product" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="order" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="PremiumCustomer" superClasses="//@ownedElements.2 //@ownedElements.0">
    <ownedProperty name="loyaltyLevel" primitiveType="String" isContainment="false"/>
    <ownedProperty name="accountManager" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>