<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Member" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="membershipNo" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <!-- Strong-ish reference to Member (non containment) -->
    <ownedProperty name="borrower" complexType="//@ownedElements.3" isContainment="false"/>
    <!-- Strong-ish reference to Book (non containment) -->
    <ownedProperty name="item" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="startDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Branch" superClasses="//@ownedElements.0">
    <ownedProperty name="branchName" primitiveType="String" isContainment="false"/>
    <!-- Aggregation-like association to Book (non containment) -->
    <ownedProperty name="availableBooks" complexType="//@ownedElements.4" isContainment="false"/>
    <!-- Composition-like association to Loan (containment) -->
    <ownedProperty name="activeLoans" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Reservation" superClasses="//@ownedElements.0">
    <!-- Non-containment reference to Member -->
    <ownedProperty name="requestor" complexType="//@ownedElements.3" isContainment="false"/>
    <!-- Non-containment reference to Book -->
    <ownedProperty name="requestedItem" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="requestDate" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>