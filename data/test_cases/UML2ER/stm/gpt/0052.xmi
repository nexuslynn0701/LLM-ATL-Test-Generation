<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="CompanyDomain">
  <!-- 0 -->
  <ownedElements name="NamedEntity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdAt" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="assignedProjects" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="ownerDepartment" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Task" superClasses="//@ownedElements.0 //@ownedElements.3">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="estimateHours" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="subTasks" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Organization">
    <ownedProperty name="headquarters" primitiveType="String" isContainment="false"/>
    <ownedProperty name="departments" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="employees" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="projects" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="topLevelTasks" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>