<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <!-- 0 -->
  <ownedElements name="Item">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publicationYear" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Journal" superClasses="//@ownedElements.0">
    <ownedProperty name="issueNumber" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Loan">
    <ownedProperty name="loanDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
    <!-- containment to represent line items or similar -->
    <ownedProperty name="loanItems" complexType="//@ownedElements.6" isContainment="true"/>
    <!-- strong reference to member -->
    <ownedProperty name="borrower" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="LoanItem">
    <ownedProperty name="quantity" primitiveType="Integer" isContainment="false"/>
    <!-- reference to abstract superclass Item -->
    <ownedProperty name="item" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- containment of books and journals -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="journals" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- non-containment references to authors and members -->
    <ownedProperty name="registeredAuthors" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="registeredMembers" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="EBook" superClasses="//@ownedElements.1">
    <ownedProperty name="fileFormat" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fileSizeMB" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>