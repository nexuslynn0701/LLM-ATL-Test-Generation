<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0: Base class with primitive attributes -->
  <ownedElements name="IdentifiedElement">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
  </ownedElements>

  <!-- Index 1: User, inherits from IdentifiedElement -->
  <ownedElements name="User" superClasses="//@ownedElements.0">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="passwordHash" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 2: Address, containment from LibraryBranch and UserProfile -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 3: LibraryBranch, inherits from IdentifiedElement, contains Address -->
  <ownedElements name="LibraryBranch" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Index 4: Person, base for Member and Librarian -->
  <ownedElements name="Person">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 5: Member, multiple inheritance from Person and User -->
  <ownedElements name="Member" superClasses="//@ownedElements.4 //@ownedElements.1">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 6: Librarian, inherits from Person and User -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.4 //@ownedElements.1">
    <ownedProperty name="employeeCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 7: UserProfile, contains Address and refers to Member -->
  <ownedElements name="UserProfile">
    <ownedProperty name="phoneNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="shippingAddress" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="owner" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- Index 8: Book, references LibraryBranch and Member (borrower) -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="heldByBranch" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="borrowedBy" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- Index 9: Magazine, shares base IdentifiedElement and LibraryBranch reference -->
  <ownedElements name="Magazine" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="issueNumber" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="availableAt" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>