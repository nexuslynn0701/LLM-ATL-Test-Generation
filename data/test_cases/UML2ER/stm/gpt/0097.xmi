<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="EnterpriseModel">
  <!-- 0 -->
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Timestamped">
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="updatedAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Company" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="departments" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="headquarters" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="worksIn" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="assignedProjects" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="office" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Office" superClasses="//@ownedElements.0">
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <ownedProperty name="capacity" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Task" superClasses="//@ownedElements.0">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="estimatedHours" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="assignedTo" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="relatedProject" complexType="//@ownedElements.6" isContainment="false"/>
    <ownedProperty name="subTasks" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="Client" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryContact" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="mainProject" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>