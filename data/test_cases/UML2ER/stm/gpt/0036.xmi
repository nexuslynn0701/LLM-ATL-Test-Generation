<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">

  <!-- 0 -->
  <ownedElements name="Company">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="departments" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="headOffice" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="manager" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.4">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="office" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Person">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Project">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="tasks" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Task" superClasses="//@ownedElements.7">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="WorkItem">
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Meeting">
    <ownedProperty name="subject" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="organizer" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="participants" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>