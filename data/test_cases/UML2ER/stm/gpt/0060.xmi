<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="PublishingSystem">

  <!-- 0 -->
  <ownedElements name="NamedEntity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Author" superClasses="//@ownedElements.1">
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <!-- non-containment reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="false"/>
    <!-- containment of chapters -->
    <ownedProperty name="chapters" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Chapter">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- containment of pages -->
    <ownedProperty name="pages" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Page">
    <ownedProperty name="pageNumber" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="content" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Review" superClasses="//@ownedElements.0">
    <ownedProperty name="rating" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="comment" primitiveType="String" isContainment="false"/>
    <!-- non-containment reference to Book -->
    <ownedProperty name="reviewedBook" complexType="//@ownedElements.4" isContainment="false"/>
    <!-- non-containment reference to Person (reviewer) -->
    <ownedProperty name="reviewer" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <!-- containment of books -->
    <ownedProperty name="collection" complexType="//@ownedElements.4" isContainment="true"/>
    <!-- non-containment reference to Publisher -->
    <ownedProperty name="mainPublisher" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>