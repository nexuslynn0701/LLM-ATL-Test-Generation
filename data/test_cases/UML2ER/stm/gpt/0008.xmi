<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Reader" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipId" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="BookCopy" superClasses="//@ownedElements.0">
    <ownedProperty name="copyNumber" primitiveType="Integer" isContainment="false"/>
    <!-- Non-containment reference to Book -->
    <ownedProperty name="book" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="startDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
    <!-- Containment reference to BookCopy -->
    <ownedProperty name="loanedCopy" complexType="//@ownedElements.5" isContainment="true"/>
    <!-- Non-containment reference to Reader -->
    <ownedProperty name="borrower" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Containment reference to Librarian -->
    <ownedProperty name="headLibrarian" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Non-containment association to Reader -->
    <ownedProperty name="registeredReaders" complexType="//@ownedElements.3" isContainment="false"/>
    <!-- Containment association to Book -->
    <ownedProperty name="collection" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>