<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="BusinessDomain">
  <!-- 0 -->
  <ownedElements name="Organization">
    <ownedProperty name="orgName" primitiveType="EString" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="deptName" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="parentOrganization" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Team" superClasses="//@ownedElements.1">
    <ownedProperty name="teamName" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="empId" primitiveType="EInt" isContainment="false"/>
    <ownedProperty name="firstName" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="EString" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Manager" superClasses="//@ownedElements.3">
    <ownedProperty name="managedTeams" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Project" superClasses="//@ownedElements.1">
    <ownedProperty name="code" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="EDouble" isContainment="false"/>
    <ownedProperty name="ownerDept" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Client">
    <ownedProperty name="clientName" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="industry" primitiveType="EString" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Contract">
    <ownedProperty name="contractId" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="client" complexType="//@ownedElements.6" isContainment="false"/>
    <ownedProperty name="mainProject" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="OfficeLocation">
    <ownedProperty name="city" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="country" primitiveType="EString" isContainment="false"/>
  </ownedElements>
  <!-- 9 -->
  <ownedElements name="Asset">
    <ownedProperty name="assetTag" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="assignedTo" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="locatedAt" complexType="//@ownedElements.8" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>