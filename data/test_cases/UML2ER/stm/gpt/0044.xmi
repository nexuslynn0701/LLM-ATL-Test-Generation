<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">

  <!-- 0 -->
  <ownedElements name="NamedElement"/>

  <!-- 1 -->
  <ownedElements name="DomainObject" superClasses="//@ownedElements.0"/>

  <!-- 2 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.1">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Department" superClasses="//@ownedElements.1">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Project" superClasses="//@ownedElements.1">
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="ownerDepartment" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="team" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="postalCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Company" superClasses="//@ownedElements.1">
    <ownedProperty name="legalName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="registrationId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="hqAddress" complexType="//@ownedElements.5" isContainment="true"/>
    <ownedProperty name="departments" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>