<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterprisePackage">

  <!-- 0 -->
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="EString" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="OrganizationUnit">
    <ownedProperty name="code" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="name" primitiveType="EString" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Department" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="manager" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="teams" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Team" superClasses="//@ownedElements.1">
    <ownedProperty name="lead" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="email" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="employer" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="city" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="EString" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="ownerDepartment" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="assignedTeams" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="sponsor" complexType="//@ownedElements.7" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Client" superClasses="//@ownedElements.0">
    <ownedProperty name="clientName" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="billingAddress" complexType="//@ownedElements.5" isContainment="true"/>
    <ownedProperty name="contactPerson" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Contract" superClasses="//@ownedElements.0">
    <ownedProperty name="referenceNumber" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="client" complexType="//@ownedElements.7" isContainment="false"/>
    <ownedProperty name="project" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements name="Meeting">
    <ownedProperty name="subject" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="organizer" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="participants" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="location" primitiveType="EString" isContainment="false"/>
  </ownedElements>

  <!-- 10 -->
  <ownedElements name="Asset" superClasses="//@ownedElements.0">
    <ownedProperty name="serialNumber" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="assignedDepartment" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>