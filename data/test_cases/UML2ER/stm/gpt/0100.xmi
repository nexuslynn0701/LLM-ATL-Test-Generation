<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="NamedElement">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Member" superClasses="//@ownedElements.2">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.2">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedBranch" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publisher" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="LibraryBranch">
    <ownedProperty name="branchName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="books" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Reservation">
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="reservedBook" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="reservingMember" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Loan">
    <ownedProperty name="startDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="loanedBook" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="borrowingMember" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements name="LibrarySystemRoot">
    <ownedProperty name="branches" complexType="//@ownedElements.6" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="librarians" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="loans" complexType="//@ownedElements.8" isContainment="true"/>
    <ownedProperty name="reservations" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>