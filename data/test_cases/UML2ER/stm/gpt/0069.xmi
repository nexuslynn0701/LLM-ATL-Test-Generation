<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="UniversitySystem">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Student" superClasses="//@ownedElements.1">
    <ownedProperty name="matriculationNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="enrollments" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Professor" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="coursesTaught" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Course">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Enrollment">
    <ownedProperty name="year" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="course" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="student" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="programs" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Program">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="students" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Building">
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="rooms" complexType="//@ownedElements.9" isContainment="true"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements name="Room">
    <ownedProperty name="number" primitiveType="String" isContainment="false"/>
    <ownedProperty name="capacity" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>