<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="PublishingSystem">
  <!-- 0 -->
  <ownedElements name="NamedEntity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Author" superClasses="//@ownedElements.1">
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryAffiliation" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Editor" superClasses="//@ownedElements.1">
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="editor" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Chapter" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="book" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="section" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Section" superClasses="//@ownedElements.0">
    <ownedProperty name="heading" primitiveType="String" isContainment="false"/>
    <ownedProperty name="content" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="Journal" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="issn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- 9 -->
  <ownedElements name="Article" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="String" isContainment="false"/>
    <ownedProperty name="journal" complexType="//@ownedElements.8" isContainment="false"/>
    <ownedProperty name="correspondingAuthor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- 10 -->
  <ownedElements name="Conference" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 11 -->
  <ownedElements name="Proceedings" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="year" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="conference" complexType="//@ownedElements.10" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- 12 -->
  <ownedElements name="ConferencePaper" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="String" isContainment="false"/>
    <ownedProperty name="proceedings" complexType="//@ownedElements.11" isContainment="false"/>
    <ownedProperty name="speaker" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>