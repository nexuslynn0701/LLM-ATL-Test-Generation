<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <!-- 0 -->
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Category">
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentCategory" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.6" isContainment="false"/>
    <ownedProperty name="primaryCategory" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="chapters" complexType="//@ownedElements.8" isContainment="true"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="Chapter">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <!-- 9 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="loanDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="bookCopy" complexType="//@ownedElements.10" isContainment="false"/>
  </ownedElements>
  <!-- 10 -->
  <ownedElements name="BookCopy" superClasses="//@ownedElements.0">
    <ownedProperty name="copyNumber" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="condition" primitiveType="String" isContainment="false"/>
    <ownedProperty name="forBook" complexType="//@ownedElements.7" isContainment="false"/>
  </ownedElements>
  <!-- 11 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="postalCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 12 -->
  <ownedElements name="LibraryBranch" superClasses="//@ownedElements.0">
    <ownedProperty name="branchName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" complexType="//@ownedElements.11" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>