<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="EnterpriseModel">
  <!-- 0 -->
  <ownedElements name="Company">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="departments" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="headquartersAddress" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.1">
    <ownedProperty name="salary" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="officeAddress" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="currentProject" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Contractor" superClasses="//@ownedElements.1">
    <ownedProperty name="hourlyRate" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="agencyName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignedDepartment" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Project">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="teamMembers" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="SecurityGroup">
    <ownedProperty name="groupName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>