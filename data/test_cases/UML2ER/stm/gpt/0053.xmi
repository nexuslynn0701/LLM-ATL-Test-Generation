<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Organization" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="departments" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="projects" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="worksIn" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="sponsor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Client" superClasses="//@ownedElements.0">
    <ownedProperty name="clientName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainContact" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 6: subclass with multiple inheritance -->
  <ownedElements name="Contractor" superClasses="//@ownedElements.3 //@ownedElements.5">
    <ownedProperty name="hourlyRate" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>