<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="EnterpriseModel">
  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="hireDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="projects" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="subordinates" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="tasks" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Task" superClasses="//@ownedElements.0">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="parentProject" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="subTasks" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="postalCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Office" superClasses="//@ownedElements.6">
    <ownedProperty name="locationCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="departments" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="Customer" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="customerNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="billingAddress" complexType="//@ownedElements.6" isContainment="true"/>
    <ownedProperty name="shippingAddress" complexType="//@ownedElements.6" isContainment="true"/>
    <ownedProperty name="primaryContact" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>