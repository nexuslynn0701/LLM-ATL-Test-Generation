<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="EnterpriseModel">
  <!-- 0 -->
  <ownedElements name="Organization">
    <ownedProperty name="orgId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="deptCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="parentOrg" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Employee">
    <ownedProperty name="empId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Manager" superClasses="//@ownedElements.2">
    <ownedProperty name="bonusRate" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="team" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Project">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="ownerDept" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Task">
    <ownedProperty name="taskId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="project" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="subTasks" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="postalCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Office" superClasses="//@ownedElements.6">
    <ownedProperty name="officeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="Client">
    <ownedProperty name="clientId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryContact" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- 9 -->
  <ownedElements name="Contract">
    <ownedProperty name="contractId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="value" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="client" complexType="//@ownedElements.8" isContainment="false"/>
    <ownedProperty name="responsibleDept" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>