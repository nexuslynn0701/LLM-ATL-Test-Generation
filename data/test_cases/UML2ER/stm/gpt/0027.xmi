<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">

  <!-- 0 -->
  <ownedElements name="Organization">
    <ownedProperty name="orgName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="departments" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="mainAddress" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Department" superClasses="//@ownedElements.2">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="OrganizationalUnit">
    <ownedProperty name="unitCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.6">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="homeAddress" complexType="//@ownedElements.5" isContainment="true"/>
    <ownedProperty name="currentProject" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Project">
    <ownedProperty name="projectName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="deadline" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="ownerDepartment" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="tasks" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Person">
    <ownedProperty name="birthDate" primitiveType="Date" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Task">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="status" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="subTasks" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>