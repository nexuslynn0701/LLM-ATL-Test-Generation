<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <!-- 0 -->
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="LibraryBranch" superClasses="//@ownedElements.0">
    <ownedProperty name="branchName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="loanDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="item" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>