<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="NamedEntity">
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="branches" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="mainCatalog" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Branch" superClasses="//@ownedElements.0">
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="manager" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Catalog">
    <ownedProperty name="entries" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="authors" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.7" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="booksWritten" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="worksAt" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.0">
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publishedBooks" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="EBook" superClasses="//@ownedElements.4">
    <ownedProperty name="fileFormat" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fileSizeMB" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements name="PrintedBook" superClasses="//@ownedElements.4">
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="hardcover" primitiveType="Boolean" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>