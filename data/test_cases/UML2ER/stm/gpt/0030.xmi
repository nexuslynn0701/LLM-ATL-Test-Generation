<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="CompanyModel">
  <!-- 0 -->
  <ownedElements name="BaseEntity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="createdAt" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="projects" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Manager" superClasses="//@ownedElements.2 //@ownedElements.0">
    <ownedProperty name="level" primitiveType="String" isContainment="false"/>
    <ownedProperty name="teamMembers" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="tasks" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Task" superClasses="//@ownedElements.0">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="estimateHours" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="subTasks" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Office" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" complexType="//@ownedElements.6" isContainment="true"/>
    <ownedProperty name="departments" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>