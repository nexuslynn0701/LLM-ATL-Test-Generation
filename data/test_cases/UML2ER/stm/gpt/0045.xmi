<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="OnlineStoreModel">

  <!-- Index 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Customer" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="orders" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Product" superClasses="//@ownedElements.0">
    <ownedProperty name="sku" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="unitPrice" primitiveType="Float" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="postalCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Order" superClasses="//@ownedElements.0">
    <ownedProperty name="orderNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="orderDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="billingAddress" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="shippingAddress" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="items" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="OrderItem">
    <ownedProperty name="quantity" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="lineTotal" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="product" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements name="Supplier" superClasses="//@ownedElements.0">
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contactEmail" primitiveType="String" isContainment="false"/>
    <ownedProperty name="catalogProducts" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 7 -->
  <ownedElements name="AdminUser" superClasses="//@ownedElements.0">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="passwordHash" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 8 -->
  <ownedElements name="PremiumCustomer" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="membershipLevel" primitiveType="String" isContainment="false"/>
    <ownedProperty name="rewardPoints" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>