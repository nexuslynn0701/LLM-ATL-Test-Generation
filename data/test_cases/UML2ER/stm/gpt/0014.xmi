<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="BusinessDomain">

  <!-- 0 -->
  <ownedElements name="Organization">
    <ownedProperty name="orgName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="departments" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="headquartersAddress" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Department" superClasses="//@ownedElements.3">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.3">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="secondaryAddress" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Party">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Project">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="ownerDepartment" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Task">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="details" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignedTo" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="relatedProject" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="subTasks" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>