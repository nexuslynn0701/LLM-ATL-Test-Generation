<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- 0 -->
  <ownedElements name="NamedElementBase">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <!-- complex, non-containment reference -->
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- complex, containment reference -->
    <ownedProperty name="secondaryAddress" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Author" superClasses="//@ownedElements.2">
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Member" superClasses="//@ownedElements.2">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isActive" primitiveType="Boolean" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headquarters" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <!-- multiple complex references -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="coAuthor" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Loan">
    <ownedProperty name="loanDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="returned" primitiveType="Boolean" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="item" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 8: class with no properties -->
  <ownedElements name="EmptyMetaInfo"/>

  <!-- 9: subclass of a subclass (deeper hierarchy) -->
  <ownedElements name="PremiumMember" superClasses="//@ownedElements.4">
    <ownedProperty name="discountRate" primitiveType="Float" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>