<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="BloggingSystem">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="User" superClasses="//@ownedElements.0">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Author" superClasses="//@ownedElements.1">
    <ownedProperty name="bio" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Admin" superClasses="//@ownedElements.1">
    <ownedProperty name="permissions" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Category">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentCategory" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Tag">
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Post" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="content" primitiveType="String" isContainment="false"/>
    <!-- strong reference to Author (non-containment complex type) -->
    <ownedProperty name="author" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- strong reference to Category -->
    <ownedProperty name="category" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Comment" superClasses="//@ownedElements.0">
    <ownedProperty name="text" primitiveType="String" isContainment="false"/>
    <!-- containment to nested replies -->
    <ownedProperty name="replies" complexType="//@ownedElements.7" isContainment="true"/>
    <!-- non-containment reference to the commented Post -->
    <ownedProperty name="onPost" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Blog" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- containment to Posts -->
    <ownedProperty name="posts" complexType="//@ownedElements.6" isContainment="true"/>
    <!-- containment to Comments not attached to a specific post yet -->
    <ownedProperty name="orphanComments" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>