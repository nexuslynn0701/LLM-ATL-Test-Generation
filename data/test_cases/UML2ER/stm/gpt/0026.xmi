<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseSystem">

  <!-- 0 -->
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Customer" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="billingAddress" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="shippingAddress" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="PremiumCustomer" superClasses="//@ownedElements.2 //@ownedElements.0">
    <ownedProperty name="membershipLevel" primitiveType="String" isContainment="false"/>
    <ownedProperty name="rewardPoints" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Category">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentCategory" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Product">
    <ownedProperty name="sku" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="price" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="category" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Order" superClasses="//@ownedElements.0">
    <ownedProperty name="orderNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="date" primitiveType="String" isContainment="false"/>
    <ownedProperty name="customer" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="OrderLine">
    <ownedProperty name="quantity" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="unitPrice" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="product" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="parentOrder" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Invoice" superClasses="//@ownedElements.0">
    <ownedProperty name="invoiceNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="amount" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="relatedOrder" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>