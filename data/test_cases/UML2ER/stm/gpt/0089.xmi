<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="CompanyModel">

  <!-- 0 -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Office">
    <ownedProperty name="location" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="capacity" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="homeAddress" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="office" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Project">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="InternalProject" superClasses="//@ownedElements.5">
    <ownedProperty name="budget" primitiveType="Float" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="ExternalProject" superClasses="//@ownedElements.5">
    <ownedProperty name="clientName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Company">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headquarters" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="departments" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="projects" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>