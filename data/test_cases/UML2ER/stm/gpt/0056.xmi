<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="RetailSystem">

  <!-- Index 0 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Customer" superClasses="//@ownedElements.1">
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="defaultShippingAddress" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.1">
    <ownedProperty name="role" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Product">
    <ownedProperty name="sku" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="price" primitiveType="Float" isContainment="false"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="Order">
    <ownedProperty name="orderNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="customer" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="billingAddress" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="shippingAddress" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements name="OrderLine">
    <ownedProperty name="quantity" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="product" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="parentOrder" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- Index 7 -->
  <ownedElements name="PremiumCustomer" superClasses="//@ownedElements.2 //@ownedElements.1">
    <ownedProperty name="loyaltyPoints" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="accountManager" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 8 -->
  <ownedElements name="Store">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 9 -->
  <ownedElements name="OnlineOrder" superClasses="//@ownedElements.5">
    <ownedProperty name="paymentMethod" primitiveType="String" isContainment="false"/>
    <ownedProperty name="deliveryEmail" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>