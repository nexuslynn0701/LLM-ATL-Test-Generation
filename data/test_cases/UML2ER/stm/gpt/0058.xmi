<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <!-- 0 -->
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Member" superClasses="//@ownedElements.3">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="shippingAddress" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.3">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="workLibrary" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Author" superClasses="//@ownedElements.3">
    <ownedProperty name="biography" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="BookCopy" superClasses="//@ownedElements.0">
    <ownedProperty name="copyNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="originalBook" complexType="//@ownedElements.6" isContainment="false"/>
    <ownedProperty name="currentLibrary" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- 9 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="borrowedCopy" complexType="//@ownedElements.8" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="processedBy" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="loanDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="returnDate" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>