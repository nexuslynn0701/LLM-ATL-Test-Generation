<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <!-- 0 -->
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Member" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedItems" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="authors" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="startDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="item" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Reservation" superClasses="//@ownedElements.0">
    <ownedProperty name="reservedBy" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="reservedItem" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="createdOn" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Shelf">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>