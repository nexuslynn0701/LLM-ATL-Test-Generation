<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterprisePackage">

  <!-- Index 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="User" superClasses="//@ownedElements.0">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="profile" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="UserProfile" superClasses="//@ownedElements.0">
    <ownedProperty name="bio" primitiveType="String" isContainment="false"/>
    <ownedProperty name="avatarUrl" primitiveType="String" isContainment="false"/>
    <ownedProperty name="preferences" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Preferences">
    <ownedProperty name="language" primitiveType="String" isContainment="false"/>
    <ownedProperty name="timezone" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="tasks" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="Task" superClasses="//@ownedElements.0">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="subTasks" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements name="Comment" superClasses="//@ownedElements.0">
    <ownedProperty name="content" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="onTask" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- Index 7 -->
  <ownedElements name="AuditLog">
    <ownedProperty name="action" primitiveType="String" isContainment="false"/>
    <ownedProperty name="actor" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="targetProject" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="targetTask" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>