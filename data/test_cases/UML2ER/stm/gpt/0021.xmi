<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseExample">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="User" superClasses="//@ownedElements.0">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="profile" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="UserProfile" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="birthDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="tasks" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Task" superClasses="//@ownedElements.0">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="estimateHours" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="subTasks" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Comment" superClasses="//@ownedElements.0">
    <ownedProperty name="content" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="inReplyTo" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Tag">
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Repository" superClasses="//@ownedElements.0">
    <ownedProperty name="url" primitiveType="String" isContainment="false"/>
    <ownedProperty name="maintainer" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="projects" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="tags" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Organization" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="primaryRepository" complexType="//@ownedElements.7" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>