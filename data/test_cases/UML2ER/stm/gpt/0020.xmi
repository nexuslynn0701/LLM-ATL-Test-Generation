<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="NamedEntity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedLoans" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="copies" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="startDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="loanedBook" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="handledBy" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Branch" superClasses="//@ownedElements.0">
    <ownedProperty name="branchName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" complexType="//@ownedElements.6" isContainment="true"/>
    <ownedProperty name="books" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>