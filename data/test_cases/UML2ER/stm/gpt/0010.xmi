<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- Index 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>
  <!-- Index 1 -->
  <ownedElements name="AuditableEntity" superClasses="//@ownedElements.0">
    <ownedProperty name="lastModifiedAt" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="version" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <!-- Index 2 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <!-- Index 3 -->
  <ownedElements name="Book" superClasses="//@ownedElements.1">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publishedYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="authors" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>
  <!-- Index 4 -->
  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="cardNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <!-- Index 5 -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Index 6 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryBook" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <!-- Index 7 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.4">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedLibrary" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>