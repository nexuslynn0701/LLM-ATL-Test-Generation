<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="UniversityDomain">

  <!-- 0 -->
  <ownedElements name="NamedEntity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdAt" primitiveType="Date" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Course" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="prerequisite" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="students" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Student" superClasses="//@ownedElements.3">
    <ownedProperty name="matriculationNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="majorDepartment" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Professor" superClasses="//@ownedElements.3">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="office" primitiveType="String" isContainment="false"/>
    <ownedProperty name="homeDepartment" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="advisees" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Enrollment" superClasses="//@ownedElements.0">
    <ownedProperty name="year" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="grade" primitiveType="String" isContainment="false"/>
    <ownedProperty name="course" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="student" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Program">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="requiredCourses" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>