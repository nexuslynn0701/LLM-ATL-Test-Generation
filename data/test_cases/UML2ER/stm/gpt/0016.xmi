<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Author" superClasses="//@ownedElements.1">
    <ownedProperty name="biography" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <!-- reference to Author (non-containment) -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- containment of Books published -->
    <ownedProperty name="publishedBooks" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="LibraryBranch" superClasses="//@ownedElements.0">
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <!-- containment of Librarians working here -->
    <ownedProperty name="staff" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <!-- non-containment reference to Member -->
    <ownedProperty name="borrower" complexType="//@ownedElements.4" isContainment="false"/>
    <!-- non-containment reference to Book -->
    <ownedProperty name="loanedBook" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="startDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>