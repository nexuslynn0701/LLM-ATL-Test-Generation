<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <!-- containment complex type -->
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Member" superClasses="//@ownedElements.2">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="active" primitiveType="Boolean" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.2">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="role" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Category">
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <!-- self reference non-containment -->
    <ownedProperty name="parentCategory" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="website" primitiveType="String" isContainment="false"/>
    <!-- non-containment to Address -->
    <ownedProperty name="headOffice" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publicationYear" primitiveType="Integer" isContainment="false"/>
    <!-- non-containment to Category -->
    <ownedProperty name="mainCategory" complexType="//@ownedElements.5" isContainment="false"/>
    <!-- non-containment to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Copy" superClasses="//@ownedElements.0">
    <ownedProperty name="barcode" primitiveType="String" isContainment="false"/>
    <!-- non-containment to Book -->
    <ownedProperty name="book" complexType="//@ownedElements.7" isContainment="false"/>
    <ownedProperty name="condition" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements name="Loan">
    <!-- non-containment to Member and Copy -->
    <ownedProperty name="borrower" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="item" complexType="//@ownedElements.8" isContainment="false"/>
    <ownedProperty name="loanDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 10 -->
  <ownedElements name="Reservation">
    <!-- non-containment to Member and Book -->
    <ownedProperty name="requester" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="requestedBook" complexType="//@ownedElements.7" isContainment="false"/>
    <ownedProperty name="requestDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="priority" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>