<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">
  <!-- 0 -->
  <ownedElements name="NamedElement">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Company" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="foundedYear" primitiveType="Integer" isContainment="false"/>
    <!-- containment complex type -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Integer" isContainment="false"/>
    <!-- non‑containment complex type -->
    <ownedProperty name="locatedAt" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="birthDate" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.4 //@ownedElements.0">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Float" isContainment="false"/>
    <!-- containment to Address -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- non‑containment to Department -->
    <ownedProperty name="worksIn" complexType="//@ownedElements.3" isContainment="false"/>
    <!-- non‑containment to Company -->
    <ownedProperty name="employer" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Manager" superClasses="//@ownedElements.5 //@ownedElements.4">
    <ownedProperty name="level" primitiveType="Integer" isContainment="false"/>
    <!-- self‑reference style hierarchy: manager manages employees (non‑containment) -->
    <ownedProperty name="assistant" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- containment of Department that owns the project -->
    <ownedProperty name="owningDepartment" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="Meeting" superClasses="//@ownedElements.0">
    <ownedProperty name="subject" primitiveType="String" isContainment="false"/>
    <ownedProperty name="scheduledAt" primitiveType="DateTime" isContainment="false"/>
    <!-- non‑containment references to participants -->
    <ownedProperty name="organizer" complexType="//@ownedElements.6" isContainment="false"/>
    <ownedProperty name="primaryParticipant" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>