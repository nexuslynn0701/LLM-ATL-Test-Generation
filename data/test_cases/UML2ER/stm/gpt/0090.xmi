<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">
  <ownedElements name="Organization">
    <ownedProperty name="orgName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="departments" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee">
    <ownedProperty name="empId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="currentProjects" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="pastProjects" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Manager" superClasses="//@ownedElements.2">
    <ownedProperty name="bonus" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="managedDepartments" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="teamMembers" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ExternalConsultant" superClasses="//@ownedElements.2">
    <ownedProperty name="company" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>