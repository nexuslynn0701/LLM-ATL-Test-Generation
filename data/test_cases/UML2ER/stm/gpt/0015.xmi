<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="CompanyModel">
  <!-- Index 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Index 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Index 2 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <!-- Index 3 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="participants" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <!-- Index 4 -->
  <ownedElements name="Manager" superClasses="//@ownedElements.1">
    <ownedProperty name="officeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedDepartment" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- Index 5 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Index 6 -->
  <ownedElements name="OfficeLocation">
    <ownedProperty name="roomNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="building" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <!-- Index 7 -->
  <ownedElements name="Company">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headquarters" complexType="//@ownedElements.6" isContainment="true"/>
    <ownedProperty name="departments" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="projects" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>