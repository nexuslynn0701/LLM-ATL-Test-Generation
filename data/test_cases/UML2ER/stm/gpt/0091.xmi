<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="AcademicLibraryModel">

  <!-- 0 -->
  <ownedElements name="NamedElement">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Entity">
    <ownedProperty name="eid" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Publication" superClasses="//@ownedElements.1">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="year" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Book" superClasses="//@ownedElements.2">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Journal" superClasses="//@ownedElements.2">
    <ownedProperty name="impactFactor" primitiveType="Float" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Author" superClasses="//@ownedElements.1">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryAffiliation" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Institution" superClasses="//@ownedElements.1">
    <ownedProperty name="instName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Library" superClasses="//@ownedElements.6">
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <!-- containment of books and journals -->
    <ownedProperty name="holdings" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Membership" superClasses="//@ownedElements.1">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="memberOf" complexType="//@ownedElements.7" isContainment="false"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.1">
    <ownedProperty name="loanDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.8" isContainment="false"/>
    <ownedProperty name="item" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 10 -->
  <ownedElements name="Review" superClasses="//@ownedElements.1">
    <ownedProperty name="rating" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="comment" primitiveType="String" isContainment="false"/>
    <ownedProperty name="reviewedPublication" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="reviewer" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- 11 -->
  <ownedElements name="Editor" superClasses="//@ownedElements.5">
    <ownedProperty name="isChiefEditor" primitiveType="Boolean" isContainment="false"/>
    <ownedProperty name="edits" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 12 -->
  <ownedElements name="Conference" superClasses="//@ownedElements.6">
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 13 -->
  <ownedElements name="Proceedings" superClasses="//@ownedElements.2">
    <ownedProperty name="event" complexType="//@ownedElements.12" isContainment="false"/>
  </ownedElements>

  <!-- 14 -->
  <ownedElements name="ProceedingsPaper" superClasses="//@ownedElements.2">
    <ownedProperty name="pages" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publishedIn" complexType="//@ownedElements.13" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>