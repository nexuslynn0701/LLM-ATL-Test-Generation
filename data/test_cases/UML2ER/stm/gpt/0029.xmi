<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="Item">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="authorName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Magazine" superClasses="//@ownedElements.0">
    <ownedProperty name="issueNumber" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="publisher" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="magazines" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="User">
    <ownedProperty name="userId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Member" superClasses="//@ownedElements.4">
    <ownedProperty name="membershipDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedItem" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Staff" superClasses="//@ownedElements.4">
    <ownedProperty name="employeeNumber" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="managedLibrary" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>