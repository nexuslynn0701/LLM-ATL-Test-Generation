<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="librarian" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="authors" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="managedLibrary" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryAffiliation" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.0">
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="University" superClasses="//@ownedElements.0">
    <ownedProperty name="universityName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="departments" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="departmentName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.8" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="professorId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="homeDepartment" complexType="//@ownedElements.7" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>