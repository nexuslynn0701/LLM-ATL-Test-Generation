<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">
  <ownedElements name="Organization">
    <ownedProperty name="orgName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="departments" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Person">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.2">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="worksIn" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="assignedAssets" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Asset">
    <ownedProperty name="assetTag" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Contractor" superClasses="//@ownedElements.2">
    <ownedProperty name="contractId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignedDepartment" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="projectCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainDepartment" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="leadEmployee" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="externalPartners" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>