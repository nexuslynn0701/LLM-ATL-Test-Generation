<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="CompanyModel">

  <!-- 0 -->
  <ownedElements name="NamedElementBase">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Company" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="departments" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="headquarters" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.3 //@ownedElements.1">
    <ownedProperty name="employeeNumber" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Manager" superClasses="//@ownedElements.4">
    <ownedProperty name="level" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="teamMembers" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="participants" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Address" superClasses="//@ownedElements.0">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Office" superClasses="//@ownedElements.7">
    <ownedProperty name="officeCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements name="Meeting" superClasses="//@ownedElements.0">
    <ownedProperty name="topic" primitiveType="String" isContainment="false"/>
    <ownedProperty name="room" primitiveType="String" isContainment="false"/>
    <ownedProperty name="organizer" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="attendees" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>