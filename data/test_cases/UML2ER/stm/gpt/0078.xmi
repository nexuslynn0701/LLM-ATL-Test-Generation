<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="books" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="coAuthors" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Librarian" superClasses="//@ownedElements.4">
    <ownedProperty name="employeeNumber" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="managedLibrary" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Member" superClasses="//@ownedElements.4">
    <ownedProperty name="memberSince" primitiveType="String" isContainment="false"/>
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="BorrowRecord">
    <ownedProperty name="borrowDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="returnDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBy" complexType="//@ownedElements.6" isContainment="false"/>
    <ownedProperty name="book" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>