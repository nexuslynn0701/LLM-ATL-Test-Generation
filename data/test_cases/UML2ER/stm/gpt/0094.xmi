<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="SocialNetworkPackage">

  <!-- Index 0 -->
  <ownedElements name="User">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="profile" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Profile">
    <ownedProperty name="bio" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="homeCity" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Post">
    <ownedProperty name="content" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Comment">
    <ownedProperty name="text" primitiveType="String" isContainment="false"/>
    <ownedProperty name="postedOn" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="post" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="City">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="Admin" superClasses="//@ownedElements.0">
    <ownedProperty name="permissions" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedCity" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements name="Group">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="discussions" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>

  <!-- Index 7 -->
  <ownedElements name="Discussion">
    <ownedProperty name="topic" primitiveType="String" isContainment="false"/>
    <ownedProperty name="starter" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="relatedGroup" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- Index 8 -->
  <ownedElements name="Moderator" superClasses="//@ownedElements.0 //@ownedElements.5">
    <ownedProperty name="level" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>