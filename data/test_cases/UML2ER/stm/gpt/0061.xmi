<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="EnterpriseModel">
  <!-- 0 -->
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Auditable" superClasses="//@ownedElements.0">
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="updatedAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Address" superClasses="//@ownedElements.0">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="ContactInfo">
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="phoneNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="contact" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="ownerDepartment" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Client" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="billingAddress" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="contactPerson" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="Task" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="estimatedHours" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="project" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>