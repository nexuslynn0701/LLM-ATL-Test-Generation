<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="PublishingDomain">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Timestamped">
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="updatedAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="User" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Author" superClasses="//@ownedElements.2">
    <ownedProperty name="bio" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Category">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Self reference to test complexType pointing to same class -->
    <ownedProperty name="parentCategory" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Tag">
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Article" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="content" primitiveType="String" isContainment="false"/>
    <!-- Non-containment reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.3" isContainment="false"/>
    <!-- Containment reference to Category -->
    <ownedProperty name="primaryCategory" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Comment" superClasses="//@ownedElements.0">
    <ownedProperty name="text" primitiveType="String" isContainment="false"/>
    <!-- Non-containment reference to Article -->
    <ownedProperty name="article" complexType="//@ownedElements.6" isContainment="false"/>
    <!-- Non-containment reference to User -->
    <ownedProperty name="author" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Publication">
    <!-- Containment reference to Article -->
    <ownedProperty name="article" complexType="//@ownedElements.6" isContainment="true"/>
    <!-- Non-containment reference to Category -->
    <ownedProperty name="section" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements name="EditorialBoard">
    <!-- Containment reference to User -->
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Non-containment reference to Tag -->
    <ownedProperty name="focusTag" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>