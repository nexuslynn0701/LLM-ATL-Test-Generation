<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="UniversityDomain">

  <!-- Index 0 -->
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="officeLocation" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="secondaryAddress" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Student" superClasses="//@ownedElements.3 //@ownedElements.0">
    <ownedProperty name="matriculationNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="majorDepartment" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="Professor" superClasses="//@ownedElements.3">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="homeDepartment" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="courseTitle" primitiveType="String" isContainment="false"/>
    <ownedProperty name="responsibleDepartment" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 7 -->
  <ownedElements name="Enrollment">
    <ownedProperty name="enrolledStudent" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="course" complexType="//@ownedElements.6" isContainment="false"/>
    <ownedProperty name="grade" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 8 -->
  <ownedElements name="ResearchProject">
    <ownedProperty name="projectName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="leadProfessor" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="fundingAmount" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>