<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">

  <!-- 0 -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="hireDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Manager" superClasses="//@ownedElements.2 //@ownedElements.0">
    <ownedProperty name="bonus" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="team" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Project">
    <ownedProperty name="projectId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Office">
    <ownedProperty name="roomNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" complexType="//@ownedElements.5" isContainment="true"/>
    <ownedProperty name="occupant" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Company">
    <ownedProperty name="registrationNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headquarters" complexType="//@ownedElements.5" isContainment="true"/>
    <ownedProperty name="departments" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="mainContact" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>