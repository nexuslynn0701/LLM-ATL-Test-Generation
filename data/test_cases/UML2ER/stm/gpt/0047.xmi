<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="BusinessDomain">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Customer" superClasses="//@ownedElements.1">
    <ownedProperty name="customerNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="orders" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Order" superClasses="//@ownedElements.0">
    <ownedProperty name="orderNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="totalAmount" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="placedBy" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="items" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="OrderItem">
    <ownedProperty name="quantity" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="unitPrice" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="product" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Product" superClasses="//@ownedElements.0">
    <ownedProperty name="sku" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="category" complexType="//@ownedElements.7" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Category">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentCategory" complexType="//@ownedElements.7" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedCustomers" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>