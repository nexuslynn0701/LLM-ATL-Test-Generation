<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="BusinessDomain">
  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Customer" superClasses="//@ownedElements.1">
    <ownedProperty name="customerNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="accounts" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="primarySalesRep" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Account" superClasses="//@ownedElements.0">
    <ownedProperty name="accountNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="balance" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="transactions" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Transaction" superClasses="//@ownedElements.0">
    <ownedProperty name="amount" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="timestamp" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="account" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="counterpartyAccount" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Branch" superClasses="//@ownedElements.0">
    <ownedProperty name="branchCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" complexType="//@ownedElements.6" isContainment="true"/>
    <ownedProperty name="employees" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="loanNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="principal" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="interestRate" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="guarantor" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>