<SimpleUml:Package xmi:version="2.0"
                  xmlns:xmi="http://www.omg.org/XMI"
                  xmlns:SimpleUml="http://SimpleUML"
                  name="CommerceModel">
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ContactInfo">
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="phone" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address" superClasses="//@ownedElements.1">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Customer" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="secondaryAddress" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="customerSince" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Supplier" superClasses="//@ownedElements.0">
    <ownedProperty name="headquarters" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="contactEmail" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Category">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentCategory" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Product" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="price" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="category" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="supplier" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Order" superClasses="//@ownedElements.0">
    <ownedProperty name="orderNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="placedBy" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="shippingAddress" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="billingAddress" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="OrderLine">
    <ownedProperty name="quantity" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="product" complexType="//@ownedElements.6" isContainment="false"/>
    <ownedProperty name="order" complexType="//@ownedElements.8" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Review" superClasses="//@ownedElements.0">
    <ownedProperty name="rating" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="comment" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="product" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>