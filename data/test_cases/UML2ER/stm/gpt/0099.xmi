<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="CompanyModel">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="teams" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Team">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="participants" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="sponsorDepartment" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Meeting">
    <ownedProperty name="subject" primitiveType="String" isContainment="false"/>
    <ownedProperty name="scheduledBy" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="attendees" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="location" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="RemoteEmployee" superClasses="//@ownedElements.2">
    <ownedProperty name="timeZone" primitiveType="String" isContainment="false"/>
    <ownedProperty name="remoteAddress" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>