<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">
  <!-- 0 -->
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Auditable">
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="updatedOn" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publishedYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="coAuthors" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="booksWritten" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publishedBooks" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Membership" superClasses="//@ownedElements.0">
    <ownedProperty name="startDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="endDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="member" complexType="//@ownedElements.7" isContainment="true"/>
    <ownedProperty name="library" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Member" superClasses="//@ownedElements.0">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="loanDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="returned" primitiveType="Boolean" isContainment="false"/>
    <ownedProperty name="book" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="member" complexType="//@ownedElements.7" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>