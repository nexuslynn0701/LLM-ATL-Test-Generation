<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterprisePackage">

  <!-- 0 -->
  <ownedElements name="Organization">
    <ownedProperty name="orgId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="departments" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Department">
    <ownedProperty name="deptId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Manager">
    <ownedProperty name="managerId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="officeNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.2">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="currentProject" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Project">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="tasks" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Task">
    <ownedProperty name="taskId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="subTasks" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="SubTask">
    <ownedProperty name="subTaskId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="estimatedHours" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Client">
    <ownedProperty name="clientId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryContact" complexType="//@ownedElements.8" isContainment="true"/>
    <ownedProperty name="projects" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Contact">
    <ownedProperty name="contactId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="phone" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 9: multiple inheritance -->
  <ownedElements name="ExternalConsultant" superClasses="//@ownedElements.3 //@ownedElements.8">
    <ownedProperty name="hourlyRate" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="expertiseArea" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>