<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseSystem">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.1 //@ownedElements.0">
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
    <!-- containment to Department -->
    <ownedProperty name="primaryDepartment" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- non-containment to Department -->
    <ownedProperty name="secondaryDepartment" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Project">
    <ownedProperty name="projectCode" primitiveType="String" isContainment="false"/>
    <!-- containment to Employee -->
    <ownedProperty name="leader" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Task">
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="estimatedHours" primitiveType="Integer" isContainment="false"/>
    <!-- non-containment to Project -->
    <ownedProperty name="project" complexType="//@ownedElements.4" isContainment="false"/>
    <!-- non-containment to Employee -->
    <ownedProperty name="assignee" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Client" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contactPhone" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Contract">
    <ownedProperty name="referenceNumber" primitiveType="String" isContainment="false"/>
    <!-- non-containment to Client -->
    <ownedProperty name="client" complexType="//@ownedElements.6" isContainment="false"/>
    <!-- non-containment to Project -->
    <ownedProperty name="relatedProject" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>