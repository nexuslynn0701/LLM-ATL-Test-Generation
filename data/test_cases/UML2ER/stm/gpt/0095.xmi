<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">

  <!-- 0 -->
  <ownedElements name="NamedElement">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <!-- non-containment reference to Manager -->
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Manager" superClasses="//@ownedElements.1">
    <ownedProperty name="officeNumber" primitiveType="String" isContainment="false"/>
    <!-- containment of subordinate Employees -->
    <ownedProperty name="team" complexType="//@ownedElements.4" isContainment="true"/>
    <!-- non-containment link to Department -->
    <ownedProperty name="leads" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.1">
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="hireDate" primitiveType="String" isContainment="false"/>
    <!-- non-containment reference to Department -->
    <ownedProperty name="worksIn" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- containment of Tasks -->
    <ownedProperty name="tasks" complexType="//@ownedElements.6" isContainment="true"/>
    <!-- non-containment reference to owning Department -->
    <ownedProperty name="ownerDepartment" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Task" superClasses="//@ownedElements.0">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="estimateHours" primitiveType="Integer" isContainment="false"/>
    <!-- non-containment reference to assigned Employee -->
    <ownedProperty name="assignee" complexType="//@ownedElements.4" isContainment="false"/>
    <!-- non-containment self-reference to predecessor Task -->
    <ownedProperty name="predecessor" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Document" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdOn" primitiveType="String" isContainment="false"/>
    <!-- containment of DocumentVersion -->
    <ownedProperty name="versions" complexType="//@ownedElements.8" isContainment="true"/>
    <!-- non-containment link to related Project -->
    <ownedProperty name="relatedProject" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="DocumentVersion" superClasses="//@ownedElements.0">
    <ownedProperty name="versionLabel" primitiveType="String" isContainment="false"/>
    <ownedProperty name="authorName" primitiveType="String" isContainment="false"/>
    <!-- non-containment link back to Document -->
    <ownedProperty name="ofDocument" complexType="//@ownedElements.7" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>