<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="staff" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.2">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedLibrary" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="Author" superClasses="//@ownedElements.2">
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements name="Member" superClasses="//@ownedElements.2">
    <ownedProperty name="membershipNo" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="homeLibrary" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>