<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="SocialNetworkModel">

  <!-- 0 -->
  <ownedElements name="Entity" >
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="User" superClasses="//@ownedElements.0">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Post" superClasses="//@ownedElements.0">
    <ownedProperty name="content" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Comment" superClasses="//@ownedElements.0">
    <ownedProperty name="text" primitiveType="String" isContainment="false"/>
    <ownedProperty name="post" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="writer" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Group">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="PrivateGroup" superClasses="//@ownedElements.4">
    <ownedProperty name="inviteCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Profile">
    <ownedProperty name="bio" primitiveType="String" isContainment="false"/>
    <ownedProperty name="user" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>