<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="User" superClasses="//@ownedElements.0">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Group" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="mainGroup" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Task" superClasses="//@ownedElements.3">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Comment">
    <ownedProperty name="text" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="task" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Attachment">
    <ownedProperty name="fileName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="sizeInBytes" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="relatedComment" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="AuditLog" superClasses="//@ownedElements.0">
    <ownedProperty name="timestamp" primitiveType="String" isContainment="false"/>
    <ownedProperty name="actor" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="targetProject" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="targetTask" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>