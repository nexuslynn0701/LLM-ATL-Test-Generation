<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="EnterpriseModel">
  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="OrganizationalUnit" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentUnit" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Company" superClasses="//@ownedElements.1">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="registrationNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headquarters" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Department" superClasses="//@ownedElements.1">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="parentCompany" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0 //@ownedElements.7">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Contractor" superClasses="//@ownedElements.0">
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contactPerson" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Person">
    <ownedProperty name="nationalId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="birthDate" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="ownerCompany" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="leadDepartment" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- 9 -->
  <ownedElements name="Task" superClasses="//@ownedElements.0">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="relatedProject" complexType="//@ownedElements.8" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>