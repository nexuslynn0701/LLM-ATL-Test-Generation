<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="Identifiable">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <ownedProperty name="membershipId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="authors" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="booksWritten" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="libraryName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="staff" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.0">
    <ownedProperty name="loanDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="loanedBook" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Reservation" superClasses="//@ownedElements.0">
    <ownedProperty name="requestDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="reservedBy" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="reservedBook" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements name="Category" superClasses="//@ownedElements.0">
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentCategory" complexType="//@ownedElements.9" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>