<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">
  <!-- Index 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Index 1 -->
  <ownedElements name="Customer" superClasses="//@ownedElements.0">
    <ownedProperty name="customerNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="orders" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <!-- Index 2 -->
  <ownedElements name="Order" superClasses="//@ownedElements.0">
    <ownedProperty name="orderNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="date" primitiveType="String" isContainment="false"/>
    <ownedProperty name="totalAmount" primitiveType="String" isContainment="false"/>
    <ownedProperty name="customer" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="items" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <!-- Index 3 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Index 4 -->
  <ownedElements name="OrderItem">
    <ownedProperty name="quantity" primitiveType="String" isContainment="false"/>
    <ownedProperty name="unitPrice" primitiveType="String" isContainment="false"/>
    <ownedProperty name="product" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <!-- Index 5 -->
  <ownedElements name="Product" superClasses="//@ownedElements.0">
    <ownedProperty name="sku" primitiveType="String" isContainment="false"/>
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <ownedProperty name="category" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>
  <!-- Index 6 -->
  <ownedElements name="Category">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentCategory" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>
  <!-- Index 7 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.7" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.8" isContainment="false"/>
  </ownedElements>
  <!-- Index 8 -->
  <ownedElements name="Department">
    <ownedProperty name="deptCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.7" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>