<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="CompanyModel">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Organization" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="organization" isContainment="false" complexType="//@ownedElements.1"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Team" superClasses="//@ownedElements.2">
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Manager" superClasses="//@ownedElements.4">
    <ownedProperty name="managedDepartment" isContainment="false" complexType="//@ownedElements.2"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="deadline" primitiveType="Date" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Assignment" superClasses="//@ownedElements.0">
    <ownedProperty name="employee" isContainment="false" complexType="//@ownedElements.4"/>
    <ownedProperty name="project" isContainment="false" complexType="//@ownedElements.6"/>
    <ownedProperty name="hoursPerWeek" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Address" superClasses="//@ownedElements.0">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements name="Office" superClasses="//@ownedElements.0">
    <ownedProperty name="location" isContainment="true" complexType="//@ownedElements.8"/>
    <ownedProperty name="capacity" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>