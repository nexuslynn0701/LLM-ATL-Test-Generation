<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="PublishingDomain">

  <!-- 0 -->
  <ownedElements name="BaseEntity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Category" superClasses="//@ownedElements.0">
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentCategory" isContainment="false" complexType="//@ownedElements.2"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Tag">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainAuthor" isContainment="false" complexType="//@ownedElements.1"/>
    <ownedProperty name="publisher" isContainment="false" complexType="//@ownedElements.4"/>
    <ownedProperty name="primaryCategory" isContainment="false" complexType="//@ownedElements.2"/>
    <ownedProperty name="tags" isContainment="false" complexType="//@ownedElements.3"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="EBook" superClasses="//@ownedElements.5">
    <ownedProperty name="fileFormat" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fileSizeMB" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="PrintedBook" superClasses="//@ownedElements.5">
    <ownedProperty name="pageCount" primitiveType="String" isContainment="false"/>
    <ownedProperty name="weightGrams" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <ownedProperty name="libraryName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" isContainment="true" complexType="//@ownedElements.5"/>
  </ownedElements>

</SimpleUml:Package>