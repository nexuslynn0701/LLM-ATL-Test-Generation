<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="BusinessDomain">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="int" isContainment="false"/>
    <ownedProperty name="createdAt" primitiveType="date" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Auditable">
    <ownedProperty name="createdBy" primitiveType="string" isContainment="false"/>
    <ownedProperty name="updatedBy" primitiveType="string" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="User" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="username" primitiveType="string" isContainment="false"/>
    <ownedProperty name="email" primitiveType="string" isContainment="false"/>
    <ownedProperty name="profile" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="primaryDepartment" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="UserProfile">
    <ownedProperty name="firstName" primitiveType="string" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="string" isContainment="false"/>
    <ownedProperty name="birthDate" primitiveType="date" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="string" isContainment="false"/>
    <ownedProperty name="name" primitiveType="string" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="title" primitiveType="string" isContainment="false"/>
    <ownedProperty name="description" primitiveType="string" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="leadDepartment" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Task" superClasses="//@ownedElements.0">
    <ownedProperty name="summary" primitiveType="string" isContainment="false"/>
    <ownedProperty name="estimateHours" primitiveType="float" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="parentProject" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="subTasks" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Comment">
    <ownedProperty name="text" primitiveType="string" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="onTask" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>