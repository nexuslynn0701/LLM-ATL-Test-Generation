<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="UniversitySystem">

  <!-- 0 -->
  <ownedElements name="NamedEntity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="officeNumber" primitiveType="String" isContainment="false"/>
    <!-- non-containment reference to Department -->
    <ownedProperty name="department" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="enrollmentYear" primitiveType="Integer" isContainment="false"/>
    <!-- non-containment reference to Department -->
    <ownedProperty name="majorDepartment" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- self-reference (non-containment) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Course">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <!-- non-containment references -->
    <ownedProperty name="offeredBy" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Enrollment">
    <!-- pure primitive attributes -->
    <ownedProperty name="grade" primitiveType="String" isContainment="false"/>
    <ownedProperty name="semester" primitiveType="String" isContainment="false"/>
    <!-- strong/containment-ish links modeled as containment = true -->
    <ownedProperty name="student" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="course" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Program" superClasses="//@ownedElements.1">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="durationYears" primitiveType="Integer" isContainment="false"/>
    <!-- containment collection of courses -->
    <ownedProperty name="coreCourse" complexType="//@ownedElements.4" isContainment="true"/>
    <!-- optional primitive without complexType -->
    <ownedProperty name="isGraduate" primitiveType="Boolean" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>