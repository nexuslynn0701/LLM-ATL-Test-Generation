<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">

  <!-- 0: Abstract base class -->
  <ownedElements name="Entity" />

  <!-- 1: Concrete class with only primitive properties -->
  <ownedElements name="Department"
                 superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
  </ownedElements>

  <!-- 2: Class with multiple superclasses and complex reference -->
  <ownedElements name="Team"
                 superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentDepartment"
                   complexType="//@ownedElements.1"
                   isContainment="false"/>
  </ownedElements>

  <!-- 3: Class with self‑reference and containment complex type -->
  <ownedElements name="Employee"
                 superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager"
                   complexType="//@ownedElements.3"
                   isContainment="false"/>
    <ownedProperty name="subordinates"
                   complexType="//@ownedElements.3"
                   isContainment="true"/>
  </ownedElements>

  <!-- 4: Class with both primitive and complex properties -->
  <ownedElements name="Project"
                 superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="active" primitiveType="Boolean" isContainment="false"/>
    <ownedProperty name="lead"
                   complexType="//@ownedElements.3"
                   isContainment="false"/>
    <ownedProperty name="owningTeam"
                   complexType="//@ownedElements.2"
                   isContainment="false"/>
  </ownedElements>

  <!-- 5: Class without superclasses, used as complex type elsewhere -->
  <ownedElements name="Location">
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="officeNumber" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 6: Class combining primitive, containment, and non‑containment references -->
  <ownedElements name="Assignment">
    <ownedProperty name="role" primitiveType="String" isContainment="false"/>
    <ownedProperty name="hoursPerWeek" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="assignee"
                   complexType="//@ownedElements.3"
                   isContainment="false"/>
    <ownedProperty name="project"
                   complexType="//@ownedElements.4"
                   isContainment="false"/>
    <ownedProperty name="workLocation"
                   complexType="//@ownedElements.5"
                   isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>