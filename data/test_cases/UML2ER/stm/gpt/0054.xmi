<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="CompanyModel">

  <!-- 0 -->
  <ownedElements name="Entity">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="empName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="worksIn" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="subordinates" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="projectName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Address" superClasses="//@ownedElements.0">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Company" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headquarters" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="departments" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="projects" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Meeting">
    <ownedProperty name="topic" primitiveType="String" isContainment="false"/>
    <ownedProperty name="date" primitiveType="String" isContainment="false"/>
    <ownedProperty name="organizer" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="participants" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="room" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Room" superClasses="//@ownedElements.0">
    <ownedProperty name="roomNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="capacity" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>