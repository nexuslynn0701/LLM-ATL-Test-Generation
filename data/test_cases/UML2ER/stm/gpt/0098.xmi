<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="SocialNetworkModel">

  <!-- Index 0 -->
  <ownedElements name="User">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="posts" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="followers" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Post">
    <ownedProperty name="content" primitiveType="String" isContainment="false"/>
    <ownedProperty name="timestamp" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="comments" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Comment">
    <ownedProperty name="text" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="inReplyTo" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Group">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="ownedPosts" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Admin" superClasses="//@ownedElements.0">
    <ownedProperty name="permissions" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedGroups" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="Moderator" superClasses="//@ownedElements.0 //@ownedElements.4">
    <ownedProperty name="scope" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements name="Tag">
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <ownedProperty name="taggedPosts" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>