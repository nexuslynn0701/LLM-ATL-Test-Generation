<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="EnterpriseModel">
  <ownedElements name="NamedElementBase">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="OrganizationUnit" superClasses="//@ownedElements.0">
    <ownedProperty name="unitName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="subUnits" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Person" superClasses="//@ownedElements.0">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.2">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="worksIn" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="tasks" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Task">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignedTo" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Customer" superClasses="//@ownedElements.0">
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contactPerson" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>