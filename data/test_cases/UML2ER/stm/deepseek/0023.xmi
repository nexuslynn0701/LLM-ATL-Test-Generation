<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Person"/>
  <ownedElements name="Organization"/>
  <ownedElements name="Department"/>
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="empId" primitiveType="String" isContainment="true"/>
    <ownedProperty name="worksFor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.3">
    <ownedProperty name="tenure" primitiveType="Boolean" isContainment="true"/>
    <ownedProperty name="department" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="code" primitiveType="String" isContainment="true"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="true"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Enrollment" superClasses="//@ownedElements.0">
    <ownedProperty name="grade" primitiveType="String" isContainment="true"/>
    <ownedProperty name="student" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="course" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>