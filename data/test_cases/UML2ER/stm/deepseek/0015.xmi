<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Course">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="students" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student">
    <ownedProperty name="studentId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="enrolledCourses" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="account" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Instructor">
    <ownedProperty name="instructorId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
    <ownedProperty name="teaches" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="employmentContract" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Account">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="password" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isActive" primitiveType="Boolean" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="faculty" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>