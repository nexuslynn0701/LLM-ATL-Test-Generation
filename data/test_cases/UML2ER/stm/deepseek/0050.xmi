<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person"/>
  <ownedElements name="Employee">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="gpa" primitiveType="Float" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.1">
    <ownedProperty name="specialization" primitiveType="String" isContainment="false"/>
    <ownedProperty name="office" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="PhDStudent" superClasses="//@ownedElements.2">
    <ownedProperty name="researchArea" primitiveType="String" isContainment="false"/>
    <ownedProperty name="supervisor" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ResearchGroup">
    <ownedProperty name="members" complexType="//@ownedElements.5" isContainment="true"/>
    <ownedProperty name="funding" primitiveType="Float" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="head" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>