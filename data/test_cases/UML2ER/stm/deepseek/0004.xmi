<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversityDomain">
  <ownedElements name="Course">
    <ownedProperty name="courseId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="students" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="gpa" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="enrolledIn" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="chair" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ResearchProject">
    <ownedProperty name="projectId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="startDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="endDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="supervisor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>