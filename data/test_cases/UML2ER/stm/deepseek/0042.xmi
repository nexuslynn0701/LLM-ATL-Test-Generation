<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.2">
    <ownedProperty name="specialization" primitiveType="String" isContainment="false"/>
    <ownedProperty name="courses" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="syllabus" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ResearchProject">
    <ownedProperty name="projectId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="leadResearcher" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="relatedCourse" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Lab" superClasses="//@ownedElements.1">
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <ownedProperty name="capacity" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="supervisor" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="equipment" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Equipment">
    <ownedProperty name="serialNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="purchaseDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="value" primitiveType="Double" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>