<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="GraduateStudent" superClasses="//@ownedElements.0"/>
  <ownedElements name="Student">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="employeeId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="teaches" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="enrolledStudents" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="departName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="offeredCourses" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="supervisor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="participants" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>