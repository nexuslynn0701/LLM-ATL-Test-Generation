<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Person"/>
  <ownedElements name="Employee"/>
  <ownedElements name="Professor" superClasses="//@ownedElements.0 //@ownedElements.1"/>
  <ownedElements name="Course">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="coordinator" isContainment="false" complexType="//@ownedElements.2"/>
    <ownedProperty name="prerequisites" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" isContainment="false" complexType="//@ownedElements.2"/>
    <ownedProperty name="courses" isContainment="true" complexType="//@ownedElements.3"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0"/>
  <ownedElements name="ResearchGroup">
    <ownedProperty name="groupName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="leader" isContainment="false" complexType="//@ownedElements.2"/>
    <ownedProperty name="members" isContainment="true" complexType="//@ownedElements.5"/>
  </ownedElements>
</SimpleUml:Package>