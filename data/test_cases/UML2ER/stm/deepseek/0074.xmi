<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="birthDate" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="authors" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="joinDate" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Loan">
    <ownedProperty name="loanDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="returnDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="book" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="member" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="library" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person" superClasses="//@ownedElements.0 //@ownedElements.3"/>
</SimpleUml:Package>