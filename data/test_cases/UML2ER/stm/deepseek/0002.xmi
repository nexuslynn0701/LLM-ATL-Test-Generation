<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person"/>
  <ownedElements name="Organization">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentOrg" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department" superClasses="//@ownedElements.1">
    <ownedProperty name="deptCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.3 //@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="office" primitiveType="String" isContainment="false"/>
    <ownedProperty name="advisees" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="gpa" primitiveType="Real" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>