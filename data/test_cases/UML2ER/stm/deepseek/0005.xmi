<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Course">
    <ownedProperty name="courseId" primitiveType="String" isContainment="true"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="true"/>
    <ownedProperty name="studentsEnrolled" isContainment="false" complexType="//@ownedElements.1"/>
  </ownedElements>
  <ownedElements name="Student">
    <ownedProperty name="studentId" primitiveType="String" isContainment="true"/>
    <ownedProperty name="gpa" primitiveType="Double" isContainment="true"/>
    <ownedProperty name="enrolledCourses" isContainment="false" complexType="//@ownedElements.0"/>
    <ownedProperty name="academicAdvisor" isContainment="false" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="true"/>
    <ownedProperty name="department" primitiveType="String" isContainment="true"/>
    <ownedProperty name="teachesCourses" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="GraduateStudent" superClasses="//@ownedElements.1">
    <ownedProperty name="thesisTitle" primitiveType="String" isContainment="true"/>
    <ownedProperty name="advisor" isContainment="false" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="budget" primitiveType="Double" isContainment="true"/>
    <ownedProperty name="headProfessor" isContainment="false" complexType="//@ownedElements.2"/>
    <ownedProperty name="coursesOffered" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
</SimpleUml:Package>