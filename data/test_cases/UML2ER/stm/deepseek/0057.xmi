<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person"/>
  <ownedElements name="Employee"/>
  <ownedElements name="Student"/>
  <ownedElements name="Course">
    <ownedProperty name="courseId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="instructor" isContainment="false" complexType="//@ownedElements.1"/>
    <ownedProperty name="participants" isContainment="false" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" isContainment="false" complexType="//@ownedElements.1"/>
    <ownedProperty name="courses" isContainment="false" complexType="//@ownedElements.3"/>
    <ownedProperty name="staff" isContainment="true" complexType="//@ownedElements.1"/>
  </ownedElements>
  <ownedElements name="Enrollment">
    <ownedProperty name="student" isContainment="false" complexType="//@ownedElements.2"/>
    <ownedProperty name="course" isContainment="false" complexType="//@ownedElements.3"/>
    <ownedProperty name="grade" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>