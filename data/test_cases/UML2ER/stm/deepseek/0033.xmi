<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="true"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee">
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="true"/>
    <ownedProperty name="office" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="code" primitiveType="String" isContainment="true"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>