<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="gpa" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="address" isContainment="true" complexType="//@ownedElements.1"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
    <ownedProperty name="office" isContainment="true" complexType="//@ownedElements.1"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="instructor" isContainment="false" complexType="//@ownedElements.3"/>
    <ownedProperty name="ta" isContainment="false" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="chair" isContainment="false" complexType="//@ownedElements.3"/>
    <ownedProperty name="courses" isContainment="true" complexType="//@ownedElements.4"/>
  </ownedElements>
</SimpleUml:Package>