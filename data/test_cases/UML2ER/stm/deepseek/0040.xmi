<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Department"/>
  <ownedElements name="Employee">
    <ownedProperty name="empId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.1">
    <ownedProperty name="rank" primitiveType="String" isContainment="false"/>
    <ownedProperty name="courses" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="office" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="syllabus" primitiveType="String" isContainment="false"/>
    <ownedProperty name="prerequisites" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.1">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="gpa" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="major" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="enrolledCourses" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="transcript" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="TeachingAssistant" superClasses="//@ownedElements.4 //@ownedElements.2">
    <ownedProperty name="supervisor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="assignedCourse" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="hoursPerWeek" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ResearchProject">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="leadResearcher" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="fundingAgency" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Laboratory">
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <ownedProperty name="capacity" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="labManager" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Publication">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="year" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="journal" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>