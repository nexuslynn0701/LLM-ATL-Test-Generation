<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Course">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="syllabus" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="gpa" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="enrolledCourses" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
    <ownedProperty name="teaches" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="advisees" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department" superClasses="//@ownedElements.0 //@ownedElements.2">
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="faculty" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="GraduateStudent" superClasses="//@ownedElements.1">
    <ownedProperty name="thesisTopic" primitiveType="String" isContainment="false"/>
    <ownedProperty name="supervisor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="researchGroup" primitiveType="String" isContainment="false"/>
    <ownedProperty name="labAssistant" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ResearchProject">
    <ownedProperty name="startDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="endDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="funding" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="leader" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="output" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>