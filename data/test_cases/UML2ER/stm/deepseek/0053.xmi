<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.1">
    <ownedProperty name="tenure" primitiveType="Boolean" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="syllabus" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="PhDStudent" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="thesisTitle" primitiveType="String" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="publications" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>