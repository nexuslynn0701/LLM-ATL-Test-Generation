<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <!-- Class with primitive properties only -->
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  
  <!-- Class with complex type properties (non-containment) -->
  <ownedElements name="Department">
    <ownedProperty name="departmentHead" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="staffMembers" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  
  <!-- Class with containment reference (composition) -->
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="syllabus" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="prerequisites" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  
  <!-- Class used for containment reference -->
  <ownedElements name="Syllabus">
    <ownedProperty name="topics" primitiveType="Text" isContainment="false"/>
    <ownedProperty name="textbooks" primitiveType="String" isContainment="false"/>
  </ownedElements>
  
  <!-- Class with inheritance hierarchy -->
  <ownedElements name="Prerequisite">
    <ownedProperty name="minimumGrade" primitiveType="String" isContainment="false"/>
    <ownedProperty name="requiredCourse" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  
  <!-- Derived class with superclass reference -->
  <ownedElements name="GraduateCourse" superClasses="//@ownedElements.2">
    <ownedProperty name="thesisRequired" primitiveType="Boolean" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  
  <!-- Another class with multiple superclasses -->
  <ownedElements name="TeachingAssistant" superClasses="//@ownedElements.0 //@ownedElements.6">
    <ownedProperty name="assignedCourse" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="hoursPerWeek" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  
  <!-- Class with cyclic reference -->
  <ownedElements name="ResearchGroup">
    <ownedProperty name="groupName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="leadInvestigator" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="subGroups" complexType="//@ownedElements.7" isContainment="false"/>
  </ownedElements>
  
  <!-- Class with multiple containment references -->
  <ownedElements name="Project">
    <ownedProperty name="projectTitle" primitiveType="String" isContainment="false"/>
    <ownedProperty name="projectPlan" complexType="//@ownedElements.9" isContainment="true"/>
    <ownedProperty name="projectDeliverables" complexType="//@ownedElements.10" isContainment="true"/>
  </ownedElements>
  
  <!-- Contained classes for Project -->
  <ownedElements name="ProjectPlan">
    <ownedProperty name="startDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="endDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="milestones" primitiveType="String" isContainment="false"/>
  </ownedElements>
  
  <ownedElements name="Deliverable">
    <ownedProperty name="deliverableName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="weight" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="deadline" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>