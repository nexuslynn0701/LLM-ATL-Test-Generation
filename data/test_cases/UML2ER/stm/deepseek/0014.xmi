<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:SimpleUml="http://SimpleUML"
    name="SchoolSystem">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="deptCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="tasks" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Task">
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignedTo" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="completed" primitiveType="Boolean" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course" superClasses="//@ownedElements.0"/>
  <ownedElements name="Professor" superClasses="//@ownedElements.0 //@ownedElements.1"/>
  <ownedElements name="Administrator" superClasses="//@ownedElements.1"/>
</SimpleUml:Package>