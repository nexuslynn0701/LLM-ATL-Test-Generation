<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryPkg">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="chapters" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Chapter" superClasses="//@ownedElements.3">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Section">
    <ownedProperty name="heading" primitiveType="String" isContainment="false"/>
    <ownedProperty name="chapter" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>