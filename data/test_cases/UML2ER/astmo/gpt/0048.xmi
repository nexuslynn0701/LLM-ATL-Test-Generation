<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- primitive attribute with primitiveType set -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute with primitiveType undefined (so NoType in target) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- complex reference, non-containment -> WeakReference -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- complex reference, containment -> StrongReference -->
    <ownedProperty name="chapters" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- primitive attribute with primitiveType set -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute with empty primitiveType string -->
    <ownedProperty name="birthDate" primitiveType="" isContainment="false"/>
    <!-- complex reference, non-containment -> WeakReference -->
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Chapter -->
  <ownedElements name="Chapter">
    <!-- primitive attribute -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute with primitiveType undefined -->
    <ownedProperty name="number" isContainment="false"/>
    <!-- complex reference, containment -> StrongReference -->
    <ownedProperty name="subChapters" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Section (used as subChapter target) -->
  <ownedElements name="Section">
    <!-- primitive attribute -->
    <ownedProperty name="heading" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute with primitiveType undefined -->
    <ownedProperty name="pageStart" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>