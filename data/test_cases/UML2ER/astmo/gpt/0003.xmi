<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Primitive attribute with primitiveType defined -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute with primitiveType undefined -->
    <ownedProperty name="publishedYear" isContainment="false"/>
    <!-- Reference to Author: non-containment => WeakReference -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Reference to Publisher: containment => StrongReference -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Primitive attribute with primitiveType defined -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute with primitiveType undefined -->
    <ownedProperty name="biography" isContainment="false"/>
    <!-- Reference to Book: non-containment => WeakReference -->
    <ownedProperty name="writtenBook" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Reference to Author (self): containment => StrongReference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Primitive attribute with primitiveType defined -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute with primitiveType undefined -->
    <ownedProperty name="founded" isContainment="false"/>
    <!-- Reference to Book: containment => StrongReference -->
    <ownedProperty name="flagshipBook" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Reference to Author: non-containment => WeakReference -->
    <ownedProperty name="contactAuthor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>