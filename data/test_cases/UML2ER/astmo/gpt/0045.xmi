<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Attribute with undefined primitiveType -->
    <ownedProperty name="biography" isContainment="false"/>
    <!-- Weak reference (non-containment) to Book -->
    <ownedProperty name="writtenBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType explicitly empty string -->
    <ownedProperty name="country" primitiveType="" isContainment="false"/>
    <!-- Strong reference (containment) to Book -->
    <ownedProperty name="featuredBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>