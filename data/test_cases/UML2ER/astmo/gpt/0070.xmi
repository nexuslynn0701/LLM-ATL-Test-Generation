<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="publishedYear" isContainment="false"/>
    <!-- Weak reference to Author (non-containment, complexType set) -->
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Library (containment, complexType set) -->
    <ownedProperty name="library" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference (containment, complexType set) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Member -->
  <ownedElements name="Member">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="nickname" isContainment="false"/>
    <!-- Weak reference to Library (non-containment, complexType set) -->
    <ownedProperty name="homeLibrary" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Library -->
  <ownedElements name="Library">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book (non-containment, complexType set) -->
    <ownedProperty name="featuredBook" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference to Member (containment, complexType set) -->
    <ownedProperty name="headMember" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>