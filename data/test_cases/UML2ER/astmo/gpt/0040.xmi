<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0 -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1 -->
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="foundedYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="headquarters" primitiveType="" isContainment="false"/>
  </ownedElements>

  <!-- Class 2 -->
  <ownedElements name="Author" superClasses="//@ownedElements.3">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" isContainment="false"/>
    <ownedProperty name="agent" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Class 3 -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 4 -->
  <ownedElements name="Agent">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedAuthor" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>