<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="Package26">

  <!-- Class 0: SimpleUser, primitive-only properties -->
  <ownedElements name="SimpleUser">
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="true"/>
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Address, referenced by weak and strong references -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="true"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="postalCode" primitiveType="String" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Account, with super class SimpleUser and mixed refs -->
  <ownedElements name="Account" superClasses="//@ownedElements.0">
    <!-- Weak reference to Address -->
    <ownedProperty name="billingAddress" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Address -->
    <ownedProperty name="shippingAddress" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Attribute with explicit primitive type -->
    <ownedProperty name="status" primitiveType="String" isContainment="false"/>
    <!-- Attribute with undefined primitiveType (becomes NoType) -->
    <ownedProperty name="note" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Order, multiple references and attributes -->
  <ownedElements name="Order" superClasses="//@ownedElements.2">
    <!-- Weak reference to Account -->
    <ownedProperty name="owner" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Strong reference to Account -->
    <ownedProperty name="primaryAccount" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak reference to Address -->
    <ownedProperty name="deliveryAddress" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Primitive attributes -->
    <ownedProperty name="orderNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="totalAmount" primitiveType="Float" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Shipment, with complexType refs and attributes -->
  <ownedElements name="Shipment" superClasses="//@ownedElements.3">
    <!-- Strong reference to Order -->
    <ownedProperty name="relatedOrder" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- Weak reference to Address -->
    <ownedProperty name="pickupLocation" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Attribute with primitive type -->
    <ownedProperty name="trackingCode" primitiveType="String" isContainment="false"/>
    <!-- Attribute with undefined primitiveType -->
    <ownedProperty name="remarks" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>