<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibraryPkg">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="true"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Author" superClasses="//@ownedElements.2 //@ownedElements.1">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" isContainment="true"/>
    <ownedProperty name="mainBook" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Contributor">
    <ownedProperty name="notes" primitiveType="Text" isContainment="false"/>
    <ownedProperty name="book" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>