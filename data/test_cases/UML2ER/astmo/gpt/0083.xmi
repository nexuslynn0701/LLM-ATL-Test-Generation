<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="CompanyModel">
  <ownedElements name="Department">
    <ownedProperty name="deptId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Employee">
    <ownedProperty name="empId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="fullName" isContainment="true"/>
    <ownedProperty name="worksIn" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="manages" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="true"/>
    <ownedProperty name="lead" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>