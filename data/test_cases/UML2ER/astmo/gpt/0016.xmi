<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversityModel">
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="chair" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="students" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="matriculationNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="minorDepartment" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Enrollment">
    <ownedProperty name="grade" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="enrolledStudent" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="enrolledCourse" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="enrollmentNote" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>