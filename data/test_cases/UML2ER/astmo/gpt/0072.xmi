<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="RootPkg">
  <ownedElements name="User">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="profile" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Profile">
    <ownedProperty name="bio" primitiveType="String" isContainment="true"/>
    <ownedProperty name="user" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Group">
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>