<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Library">
    <ownedProperty name="libraryName" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="EString" isContainment="true"/>
    <ownedProperty name="isbn" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="pageCount" primitiveType="EInt" isContainment="true"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="EString" isContainment="true"/>
    <ownedProperty name="email" primitiveType="EString" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="homeLibrary" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="publisherName" primitiveType="EString" isContainment="true"/>
    <ownedProperty name="country" primitiveType="" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>