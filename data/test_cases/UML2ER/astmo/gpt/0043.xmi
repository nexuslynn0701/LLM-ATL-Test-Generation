<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="borrowHistory" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="nationality" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Loan">
    <ownedProperty name="loanDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="returnDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="item" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Member" superClasses="//@ownedElements.0">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="phone" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>