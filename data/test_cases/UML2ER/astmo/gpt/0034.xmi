<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="ERPSystem">

  <!-- Class 0: Department -->
  <ownedElements name="Department">
    <ownedProperty name="deptId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Employee -->
  <ownedElements name="Employee">
    <ownedProperty name="empId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- containment reference to Department (StrongReference) -->
    <ownedProperty name="homeDepartment" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- non-containment reference to Department (WeakReference) -->
    <ownedProperty name="assignedDepartment" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Project -->
  <ownedElements name="Project">
    <!-- Attribute with undefined primitiveType (will become NoType) -->
    <ownedProperty name="code" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- containment reference to Employee (StrongReference) -->
    <ownedProperty name="leader" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Task, with inheritance from Project -->
  <ownedElements name="Task" superClasses="//@ownedElements.2">
    <ownedProperty name="taskId" primitiveType="Integer" isContainment="false"/>
    <!-- non-containment reference to Project (WeakReference) -->
    <ownedProperty name="parentProject" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>