<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Primitive property with primitiveType, no complexType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Primitive property with undefined primitiveType -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- Complex non-containment reference to Author (WeakReference) -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Complex containment reference to Chapter (StrongReference) -->
    <ownedProperty name="chapters" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Primitive attribute -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Complex containment reference to Book (StrongReference) -->
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Member, with superclass Book to exercise superClasses reference -->
  <ownedElements name="Member" superClasses="//@ownedElements.0">
    <!-- Primitive attribute -->
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <!-- Complex non-containment reference to Book (WeakReference) -->
    <ownedProperty name="borrowedBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Chapter, with superclass Book to exercise multiple classes having superClasses -->
  <ownedElements name="Chapter" superClasses="//@ownedElements.0">
    <!-- Primitive attribute -->
    <ownedProperty name="chapterNumber" primitiveType="Integer" isContainment="false"/>
    <!-- Complex containment reference to Book (StrongReference) -->
    <ownedProperty name="parentBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>