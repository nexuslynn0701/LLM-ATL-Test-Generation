<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- attribute, primitiveType defined -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- attribute, primitiveType undefined -->
    <ownedProperty name="code" isContainment="false"/>
    <!-- weak reference to Author -->
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- strong reference to Library -->
    <ownedProperty name="homeLibrary" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- attribute, primitiveType defined -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- weak reference to Book (non-containment) -->
    <ownedProperty name="writtenBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Library -->
  <ownedElements name="Library">
    <!-- attribute, primitiveType undefined -->
    <ownedProperty name="address" isContainment="false"/>
    <!-- strong reference to Book (containment) -->
    <ownedProperty name="collection" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>