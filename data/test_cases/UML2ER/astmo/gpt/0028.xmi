<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="details" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="biography" primitiveType="Text" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <!-- Class 2: LibraryItem (superclass of Book and Magazine) -->
  <ownedElements name="LibraryItem">
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdOn" primitiveType="" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- Class 3: BookDetails -->
  <ownedElements name="BookDetails">
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="weight" primitiveType="Float" isContainment="false"/>
  </ownedElements>
  <!-- Class 4: Library -->
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <!-- Class 5: Member, subclass of Person -->
  <ownedElements name="Member" superClasses="//@ownedElements.6">
    <ownedProperty name="joinedOn" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="borrowedItems" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- Class 6: Person -->
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Class 7: Magazine, subclass of LibraryItem -->
  <ownedElements name="Magazine" superClasses="//@ownedElements.2">
    <ownedProperty name="issueNumber" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="editor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>