<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Primitive attribute with primitiveType set -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute with primitiveType undefined -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Reference to complex type Author, non-containment (WeakReference) -->
    <ownedProperty name="writer" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Reference to complex type Category, containment (StrongReference) -->
    <ownedProperty name="mainCategory" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Primitive attribute with primitiveType set -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Reference back to Book, non-containment (WeakReference) -->
    <ownedProperty name="booksWritten" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Category -->
  <ownedElements name="Category">
    <!-- Primitive attribute with primitiveType undefined -->
    <ownedProperty name="label" isContainment="false"/>
    <!-- Reference to Book, containment (StrongReference) -->
    <ownedProperty name="featuredBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>