<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <ownedElements name="Book">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="summary" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="birthYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="hqAddress" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>