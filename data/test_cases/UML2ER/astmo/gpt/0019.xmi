<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="BusinessDomain">
  <ownedElements name="Company">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="hqAddress" primitiveType="String" isContainment="true"/>
    <ownedProperty name="employees" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="clients" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="currentProject" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Client">
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contactEmail" primitiveType="String" isContainment="false"/>
    <ownedProperty name="accountManager" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="ownerCompany" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="client" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>