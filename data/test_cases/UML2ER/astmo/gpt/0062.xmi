<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="PkgComplexModel">

  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- reference to Address, non-containment -> WeakReference -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- reference to Address, containment -> StrongReference -->
    <ownedProperty name="workAddress" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="Integer" isContainment="false"/>
    <!-- primitiveType omitted, complexType undefined -> Attribute with type 'NoType' -->
    <ownedProperty name="country" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Company -->
  <ownedElements name="Company">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- reference to Person, non-containment -> WeakReference -->
    <ownedProperty name="employees" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- reference to Address, containment -> StrongReference -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>