<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: RootEntity with only primitive attributes (no complexType) -->
  <ownedElements name="RootEntity">
    <ownedProperty name="rootId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="rootFlag" primitiveType="Boolean" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Book with both primitive and complex properties -->
  <ownedElements name="Book">
    <!-- Primitive properties -->
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="true"/>
    <ownedProperty name="publishedYear" primitiveType="Integer" isContainment="false"/>
    <!-- complexType reference (non-containment) to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- complexType reference (containment) to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- complexType reference (containment) to RootEntity -->
    <ownedProperty name="rootLink" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Author with one primitive and one complex property -->
  <ownedElements name="Author">
    <ownedProperty name="authorName" primitiveType="String" isContainment="true"/>
    <!-- complexType reference (non-containment) to Book -->
    <ownedProperty name="primaryBook" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Publisher with only complex references, no primitiveType -->
  <ownedElements name="Publisher">
    <!-- complexType reference (containment) to Book -->
    <ownedProperty name="publishedBook" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- complexType reference (non-containment) to Author -->
    <ownedProperty name="contactAuthor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>