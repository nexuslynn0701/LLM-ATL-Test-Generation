<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- ownedElements[0] -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (should lead to NoType) -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- Weak reference (non-containment) to Author -->
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference (containment) to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- ownedElements[1] -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference (non-containment) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- ownedElements[2] -->
  <ownedElements name="Publisher">
    <!-- Attribute with primitiveType undefined (NoType) -->
    <ownedProperty name="code" isContainment="false"/>
    <!-- Strong reference (containment) to Address -->
    <ownedProperty name="address" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- ownedElements[3] -->
  <ownedElements name="Address">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <!-- Weak reference (non-containment) to Publisher -->
    <ownedProperty name="publisherBackRef" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>