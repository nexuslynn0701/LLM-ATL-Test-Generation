<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <ownedElements name="User">
    <ownedProperty name="userId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="profile" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="primaryAccount" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Account">
    <ownedProperty name="accountId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="billingAddress" primitiveType="" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Book" superClasses="//@ownedElements.4">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publisher" primitiveType="String" isContainment="false"/>
    <ownedProperty name="category" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="primaryAuthor" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>
  <ownedElements name="UserProfile">
    <ownedProperty name="displayName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="picture" primitiveType="Binary" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Item">
    <ownedProperty name="internalCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Category">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentCategory" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainBook" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>