<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0: Class Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType defined, no complexType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (NoType case), no complexType -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- WeakReference: complexType set, isContainment = false -->
    <ownedProperty name="writtenBy" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 1: Class Member -->
  <ownedElements name="Member">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <!-- WeakReference to Book -->
    <ownedProperty name="favoriteBook" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- StrongReference to Loan (containment) -->
    <ownedProperty name="loans" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- 2: Class Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- StrongReference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- 3: Class Loan -->
  <ownedElements name="Loan">
    <!-- Attribute with primitiveType undefined (NoType) -->
    <ownedProperty name="startDate" isContainment="false"/>
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="endDate" primitiveType="Date" isContainment="false"/>
    <!-- WeakReference to Member -->
    <ownedProperty name="borrower" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>