<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Weak reference: non-containment complexType -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference: containment complexType -->
    <ownedProperty name="chapters" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book (non-containment) -->
    <ownedProperty name="primaryBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher, with a superclass -->
  <ownedElements name="Publisher">
    <!-- Superclass: Organization -->
    <superClasses href="//@ownedElements.4"/>
    <!-- Attribute without primitiveType -->
    <ownedProperty name="rating" isContainment="false"/>
    <!-- Strong reference to Book (containment) -->
    <ownedProperty name="publishedBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Chapter -->
  <ownedElements name="Chapter">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType -->
    <ownedProperty name="pageCount" isContainment="false"/>
    <!-- Weak self-reference -->
    <ownedProperty name="nextChapter" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Organization (superclass of Publisher) -->
  <ownedElements name="Organization">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>