<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="ERPSystem">

  <!-- Class 0: Product -->
  <ownedElements name="Product">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="true"/>
    <ownedProperty name="supplier" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="category" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Category -->
  <ownedElements name="Category">
    <ownedProperty name="title" primitiveType="String" isContainment="true"/>
    <ownedProperty name="parentCategory" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Supplier -->
  <ownedElements name="Supplier">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contactEmail" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Address -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="true"/>
    <ownedProperty name="zipCode" primitiveType="" isContainment="false"/>
    <ownedProperty name="country" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>