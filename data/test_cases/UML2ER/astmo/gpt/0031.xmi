<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute-like: primitiveType set, no complexType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute-like: primitiveType undefined, no complexType (will yield NoType) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Weak reference: complexType = Author, isContainment = false -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference: complexType = LibraryMember, isContainment = true -->
    <ownedProperty name="currentBorrower" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute-like: primitiveType set, no complexType -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="true"/>
    <!-- Weak reference: complexType = Book, isContainment = false -->
    <ownedProperty name="primaryWork" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: LibraryMember -->
  <ownedElements name="LibraryMember">
    <!-- Attribute-like: primitiveType set, no complexType -->
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <!-- Strong reference: complexType = Book, isContainment = true -->
    <ownedProperty name="favoriteBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>