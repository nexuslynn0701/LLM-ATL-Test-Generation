<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryModel">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- primitive attribute, with type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute, without primitiveType (will yield NoType) -->
    <ownedProperty name="code" isContainment="false"/>
    <!-- reference to Author, non-containment -> WeakReference -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- reference to Publisher, containment -> StrongReference -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- primitive attribute, with type -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- reference to Book, non-containment -> WeakReference -->
    <ownedProperty name="writtenBook" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- reference to Address, containment -> StrongReference -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- primitive attribute, without primitiveType (NoType) -->
    <ownedProperty name="companyId" isContainment="false"/>
    <!-- primitive attribute, with type -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- reference to Address, non-containment -> WeakReference -->
    <ownedProperty name="hqAddress" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Address -->
  <ownedElements name="Address">
    <!-- primitive attribute, with type -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute, without primitiveType (NoType) -->
    <ownedProperty name="zipCode" isContainment="false"/>
    <!-- reference to Publisher, containment -> StrongReference -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>