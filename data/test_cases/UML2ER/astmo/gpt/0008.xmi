<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType defined, no complexType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined, no complexType -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Weak reference (non-containment) to Author -->
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference (containment) to Category -->
    <ownedProperty name="category" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType defined, no complexType -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined, no complexType -->
    <ownedProperty name="biography" isContainment="true"/>
    <!-- Strong reference (containment) to Book -->
    <ownedProperty name="booksWritten" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Category -->
  <ownedElements name="Category">
    <!-- Attribute with primitiveType defined, no complexType -->
    <ownedProperty name="label" primitiveType="String" isContainment="true"/>
    <!-- Weak reference (non-containment) to Book -->
    <ownedProperty name="recommendedBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>