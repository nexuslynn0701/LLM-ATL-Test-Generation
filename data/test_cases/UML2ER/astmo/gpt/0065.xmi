<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Primitive attribute with primitiveType defined -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute with primitiveType undefined -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Reference to Author, non-containment (WeakReference) -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Reference to Publisher, containment (StrongReference) -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Primitive attribute with primitiveType defined -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Reference to Book, non-containment (WeakReference) -->
    <ownedProperty name="writtenBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Primitive attribute with primitiveType undefined -->
    <ownedProperty name="companyName" isContainment="false"/>
    <!-- Reference to Book, containment (StrongReference) -->
    <ownedProperty name="publishedBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Library (with superClass Book) -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <!-- Primitive attribute with primitiveType defined -->
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <!-- Reference to Book, non-containment (WeakReference) -->
    <ownedProperty name="featuredBook" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Reference to Author, containment (StrongReference) -->
    <ownedProperty name="residentAuthor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>