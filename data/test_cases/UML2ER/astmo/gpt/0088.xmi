<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0 -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (NoType case) -->
    <ownedProperty name="summary" isContainment="true"/>
    <!-- Weak reference (non-containment) to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference (containment) to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1 -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="true"/>
    <!-- Weak reference (non-containment) to Book -->
    <ownedProperty name="writtenBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2 -->
  <ownedElements name="Publisher">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference (containment) to Book -->
    <ownedProperty name="publishedBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>