<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Person">
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contactEmail" primitiveType="String" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="bio" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="true"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="editor" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Library">
    <ownedProperty name="libraryName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="librarian" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>