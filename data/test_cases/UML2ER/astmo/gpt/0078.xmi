<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <ownedElements name="User">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="profile" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="UserProfile">
    <ownedProperty name="nickname" isContainment="true"/>
    <ownedProperty name="avatar" primitiveType="Binary" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="metadata" isContainment="true"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="bio" primitiveType="Text" isContainment="false"/>
    <ownedProperty name="primaryBook" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" isContainment="false"/>
    <ownedProperty name="contactPerson" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>