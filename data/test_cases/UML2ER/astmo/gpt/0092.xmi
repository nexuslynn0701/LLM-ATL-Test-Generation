<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Library">
    <ownedProperty name="libId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="true"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="true"/>
    <ownedProperty name="publishedYear" primitiveType="" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="true"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="authorId" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>