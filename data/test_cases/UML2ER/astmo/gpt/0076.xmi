<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Member" superClasses="//@ownedElements.0">
    <ownedProperty name="membershipId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <!-- complexType undefined, primitiveType defined -->
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <!-- complexType undefined, primitiveType undefined -->
    <ownedProperty name="untypedNote" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>