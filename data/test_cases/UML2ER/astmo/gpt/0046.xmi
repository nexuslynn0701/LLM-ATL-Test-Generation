<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Librarian" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignedBranch" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Branch">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedBy" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Loan">
    <ownedProperty name="loanDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="returnDate" isContainment="false"/>
    <ownedProperty name="book" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>