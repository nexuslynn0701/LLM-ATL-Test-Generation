<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">
  <ownedElements name="Company">
    <ownedProperty name="companyId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="hqAddress" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="departments" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="deptCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="employees" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee">
    <ownedProperty name="empId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="homeAddress" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="mentor" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="backupContact" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>