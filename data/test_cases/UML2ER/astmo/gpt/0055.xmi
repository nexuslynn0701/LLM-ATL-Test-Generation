<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryModel">

  <!-- Class 0 -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <!-- strong reference to Library -->
    <ownedProperty name="homeLibrary" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- weak reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1 -->
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- primitiveType undefined, will yield NoType -->
    <ownedProperty name="code" isContainment="false"/>
    <!-- strong reference to Shelf -->
    <ownedProperty name="shelves" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 2 -->
  <ownedElements name="Author" superClasses="//@ownedElements.4">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- weak reference to Book (non-containment) -->
    <ownedProperty name="mainWork" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 3 -->
  <ownedElements name="Shelf">
    <!-- attribute without primitiveType, will also yield NoType -->
    <ownedProperty name="identifier" isContainment="false"/>
    <!-- strong reference to Book -->
    <ownedProperty name="storedBooks" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 4 (superclass only) -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>