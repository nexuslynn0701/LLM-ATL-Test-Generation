<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="SocialNetworkModel">

  <!-- Class 0: User -->
  <ownedElements name="User">
    <!-- Primitive attributes (Attributes rule, with and without primitiveType) -->
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <ownedProperty name="signupDate" primitiveType="" isContainment="true"/>
    <ownedProperty name="statusMessage" isContainment="false"/>

    <!-- Weak reference (complexType set, isContainment=false) -->
    <ownedProperty name="profile" complexType="//@ownedElements.1" isContainment="false"/>

    <!-- Strong reference (complexType set, isContainment=true) -->
    <ownedProperty name="groups" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Profile -->
  <ownedElements name="Profile">
    <!-- Primitive attributes -->
    <ownedProperty name="bio" primitiveType="String" isContainment="true"/>
    <ownedProperty name="avatarUrl" primitiveType="URL" isContainment="false"/>

    <!-- Weak reference back to User -->
    <ownedProperty name="owner" complexType="//@ownedElements.0" isContainment="false"/>

    <!-- Strong reference to Post -->
    <ownedProperty name="favoritePost" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Group -->
  <ownedElements name="Group">
    <!-- Primitive attributes -->
    <ownedProperty name="title" primitiveType="String" isContainment="true"/>
    <ownedProperty name="description" isContainment="false"/>

    <!-- Weak reference to User (non-containment) -->
    <ownedProperty name="members" complexType="//@ownedElements.0" isContainment="false"/>

    <!-- Strong reference to Post (containment) -->
    <ownedProperty name="posts" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Post -->
  <ownedElements name="Post">
    <!-- Primitive attributes -->
    <ownedProperty name="content" primitiveType="Text" isContainment="true"/>
    <ownedProperty name="createdOn" primitiveType="DateTime" isContainment="false"/>

    <!-- Weak references to User and Group -->
    <ownedProperty name="author" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="postedIn" complexType="//@ownedElements.2" isContainment="false"/>

    <!-- Strong self-reference (containment) -->
    <ownedProperty name="replies" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>