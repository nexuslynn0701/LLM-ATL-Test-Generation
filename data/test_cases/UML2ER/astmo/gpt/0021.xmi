<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Library -->
    <ownedProperty name="homeLibrary" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Attribute with undefined primitiveType (to trigger NoType) -->
    <ownedProperty name="biography" isContainment="false"/>
    <!-- Strong reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference -->
    <ownedProperty name="parentCompany" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Library -->
  <ownedElements name="Library">
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <!-- Attribute with undefined primitiveType (to trigger NoType) -->
    <ownedProperty name="code" isContainment="false"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="featuredBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>