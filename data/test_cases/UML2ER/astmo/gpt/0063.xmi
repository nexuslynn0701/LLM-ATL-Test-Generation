<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="ERPkg">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- primitive attribute, no complexType -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- primitive attribute with empty primitiveType string -->
    <ownedProperty name="nickname" primitiveType="" isContainment="true"/>
    <!-- complex weak reference to Address -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- complex strong reference to Company -->
    <ownedProperty name="employer" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Company -->
  <ownedElements name="Company">
    <!-- primitive attribute with defined type -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- complex weak self-reference -->
    <ownedProperty name="parentCompany" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- complex strong reference to Department -->
    <ownedProperty name="hqDepartment" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Address -->
  <ownedElements name="Address">
    <!-- primitive attribute with undefined primitiveType -->
    <ownedProperty name="street" isContainment="true"/>
    <!-- primitive attribute with defined type -->
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Department, subclass of Company and Person -->
  <ownedElements name="Department" superClasses="//@ownedElements.0 //@ownedElements.1">
    <!-- primitive attribute -->
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <!-- complex weak reference to Person -->
    <ownedProperty name="manager" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- complex strong reference to Address -->
    <ownedProperty name="location" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>