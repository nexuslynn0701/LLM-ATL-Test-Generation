<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType, no complexType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with undefined primitiveType, no complexType -->
    <ownedProperty name="publishedYear" isContainment="false"/>
    <!-- Weak reference to Author (non-containment, complexType set) -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Library (containment, complexType set) -->
    <ownedProperty name="owningLibrary" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book (non-containment, complexType set) -->
    <ownedProperty name="writtenBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="publisherName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book (non-containment, complexType set) -->
    <ownedProperty name="publishedBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Library -->
  <ownedElements name="Library">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Book (containment, complexType set) -->
    <ownedProperty name="collectionBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>