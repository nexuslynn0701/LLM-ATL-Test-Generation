<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Library -->
  <ownedElements name="Library">
    <!-- Attribute: name, primitive with type -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Attribute: code, primitive without type (to get NoType) -->
    <ownedProperty name="code" isContainment="true"/>
    <!-- Weak reference: mainBranch (non-containment) to Branch -->
    <ownedProperty name="mainBranch" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Strong reference: rootCategory (containment) to Category -->
    <ownedProperty name="rootCategory" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Book -->
  <ownedElements name="Book">
    <!-- Attribute: title, primitive with type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute: publicationYear, primitive without type -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- Weak reference: library (non-containment) to Library -->
    <ownedProperty name="library" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference: mainAuthor (containment) to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Branch (subclass of Library) -->
  <ownedElements name="Branch" superClasses="//@ownedElements.0">
    <!-- Attribute: location, primitive with type -->
    <ownedProperty name="location" primitiveType="String" isContainment="true"/>
    <!-- Weak reference: parentLibrary (non-containment) to Library -->
    <ownedProperty name="parentLibrary" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Category -->
  <ownedElements name="Category">
    <!-- Attribute: label, primitive with type -->
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference: parentCategory (containment) -->
    <ownedProperty name="parentCategory" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 4: Author -->
  <ownedElements name="Author">
    <!-- Attribute: fullName, primitive with type -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference: homeBranch (non-containment) to Branch -->
    <ownedProperty name="homeBranch" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>