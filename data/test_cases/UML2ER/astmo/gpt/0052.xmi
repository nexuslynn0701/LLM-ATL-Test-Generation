<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute: title (primitive, no complexType) -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute: isbn (primitive, no complexType) -->
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <!-- Reference: author (non-containment WeakReference to Author) -->
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Reference: publisher (containment StrongReference to Publisher) -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute: name (primitive, no complexType) -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Attribute: birthYear (primitive, no complexType) -->
    <ownedProperty name="birthYear" primitiveType="Integer" isContainment="false"/>
    <!-- Reference: mainBook (containment StrongReference to Book) -->
    <ownedProperty name="mainBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Attribute: companyName (primitive, no complexType) -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Attribute: founded (primitive, no complexType, with different primitive) -->
    <ownedProperty name="founded" primitiveType="Year" isContainment="false"/>
    <!-- Reference: headquarters (non-containment WeakReference to Address) -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Address -->
  <ownedElements name="Address">
    <!-- Attribute: street (primitive, no complexType) -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Attribute: city (primitive, no complexType) -->
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <!-- Attribute: zipCode (no primitiveType specified, no complexType) -->
    <ownedProperty name="zipCode" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>