<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="Model0079">
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="deptId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Project" superClasses="//@ownedElements.1">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="ownerDept" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="sponsor" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>