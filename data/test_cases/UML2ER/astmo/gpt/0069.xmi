<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <ownedElements name="Book">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="true"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="chapters" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="true"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Author" superClasses="//@ownedElements.4">
    <ownedProperty name="firstName" primitiveType="String" isContainment="true"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contact" primitiveType="" isContainment="true"/>
    <ownedProperty name="mainPublisher" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Chapter">
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="true"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>