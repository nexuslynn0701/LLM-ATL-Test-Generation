<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="ER_Test_Model_0087">

  <!-- Class 0: Book, with primitive and complex properties -->
  <ownedElements name="Book">
    <!-- primitive attribute with explicit type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without primitiveType (will yield NoType) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- weak reference to Author (non-containment complexType) -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- strong reference to Publisher (containment complexType) -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author, subclass of Person -->
  <ownedElements name="Author" superClasses="//@ownedElements.3">
    <!-- primitive attribute with explicit type -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- strong self-reference (containment) to represent authored books -->
    <ownedProperty name="writtenBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher, subclass of Organization -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.4">
    <!-- primitive attribute with explicit type -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- weak self-reference (non-containment) to represent partner publishers -->
    <ownedProperty name="partner" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Person, superclass with only primitive attributes -->
  <ownedElements name="Person">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Organization, superclass with primitive attributes -->
  <ownedElements name="Organization">
    <ownedProperty name="legalName" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without primitiveType (will yield NoType) -->
    <ownedProperty name="registrationId" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>