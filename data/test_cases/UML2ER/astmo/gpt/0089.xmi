<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">
  <ownedElements name="Department">
    <ownedProperty name="deptId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="company" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Company">
    <ownedProperty name="companyId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headquarters" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="profile" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>