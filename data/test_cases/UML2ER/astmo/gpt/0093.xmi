<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="PkgMain">

  <!-- Class 0: Plain entity with primitive and untyped attributes -->
  <ownedElements name="Account">
    <!-- primitive attribute with explicit type -->
    <ownedProperty name="accountId" primitiveType="String" isContainment="false"/>
    <!-- attribute with primitiveType undefined (omitted) -->
    <ownedProperty name="description" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Has weak (non-containment) reference to Class 2 and one primitive attribute -->
  <ownedElements name="Transaction">
    <!-- primitive attribute -->
    <ownedProperty name="amount" primitiveType="Float" isContainment="false"/>
    <!-- weak reference to Customer -->
    <ownedProperty name="customerRef" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Has strong (containment) reference to Class 3 and untyped primitive attribute -->
  <ownedElements name="Customer">
    <!-- attribute with primitiveType undefined (will become NoType) -->
    <ownedProperty name="nickname" isContainment="false"/>
    <!-- strong reference (containment) to Address -->
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Referenced only as complexType target -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>