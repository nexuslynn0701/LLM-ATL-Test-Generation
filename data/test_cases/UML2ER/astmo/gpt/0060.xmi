<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Primitive attribute, defined type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute, undefined type (will become NoType) -->
    <ownedProperty name="code" isContainment="false"/>
    <!-- Reference to Author, non-containment => WeakReference -->
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Reference to LibraryBranch, containment => StrongReference -->
    <ownedProperty name="location" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Primitive attribute with type -->
    <ownedProperty name="name" primitiveType="EString" isContainment="false"/>
    <!-- Complex non-containment reference back to Book (demonstrates cross-class ref) -->
    <ownedProperty name="mainWork" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Primitive attribute with non-empty type -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Complex containment reference to Book => StrongReference -->
    <ownedProperty name="publishedBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: LibraryBranch, subclass of Publisher -->
  <ownedElements name="LibraryBranch" superClasses="//@ownedElements.2">
    <!-- Primitive attribute, undefined type -->
    <ownedProperty name="branchCode" isContainment="false"/>
    <!-- Complex non-containment reference to Publisher => WeakReference -->
    <ownedProperty name="managedBy" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>