<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- primitive attribute with explicit type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- reference to a complex type, non-containment -> WeakReference -->
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- reference to a complex type, containment -> StrongReference -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- primitive attribute without primitiveType (-> NoType) -->
    <ownedProperty name="name" isContainment="true"/>
    <!-- reference to Book, non-containment -> WeakReference -->
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- primitive attribute with explicit type -->
    <ownedProperty name="publisherName" primitiveType="String" isContainment="true"/>
    <!-- reference to Book, containment -> StrongReference -->
    <ownedProperty name="publishedBooks" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>