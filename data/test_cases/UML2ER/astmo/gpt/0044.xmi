<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="profile" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="favoriteBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Profile">
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="phone" primitiveType="" isContainment="false"/>
    <ownedProperty name="referrer" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>