<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="ERScenarioPkg">
  <ownedElements name="Person">
    <ownedProperty name="pid" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="spouse" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="address" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="true"/>
    <ownedProperty name="zipCode" primitiveType="" isContainment="false"/>
    <ownedProperty name="country" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Company">
    <ownedProperty name="cid" primitiveType="String" isContainment="false"/>
    <ownedProperty name="hqAddress" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="ceo" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>