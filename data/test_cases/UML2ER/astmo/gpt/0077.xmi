<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="Book">
    <!-- primitive attribute with explicit type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute with undefined primitiveType -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- weak reference to Member -->
    <ownedProperty name="borrower" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Author">
    <!-- primitive attribute with explicit type -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- weak reference to Book -->
    <ownedProperty name="writtenBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Member">
    <!-- primitive attribute with undefined primitiveType -->
    <ownedProperty name="memberId" isContainment="false"/>
    <!-- strong reference to Book -->
    <ownedProperty name="currentLoan" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>