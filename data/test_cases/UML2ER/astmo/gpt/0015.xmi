<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book, only primitive properties (Attributes rule, with and without primitiveType) -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publicationYear" primitiveType="" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author, primitive and complex properties (Attributes, WeakReferences, StrongReferences) -->
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- weak reference to Book -->
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- strong reference to Book -->
    <ownedProperty name="favoriteBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher, only complex properties (WeakReferences and StrongReferences) -->
  <ownedElements name="Publisher">
    <!-- weak reference to Book -->
    <ownedProperty name="publishedBooks" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- strong reference to Author -->
    <ownedProperty name="chiefAuthor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Library, mix of primitive and complex properties -->
  <ownedElements name="Library">
    <ownedProperty name="libraryName" primitiveType="String" isContainment="false"/>
    <!-- weak reference to Publisher -->
    <ownedProperty name="partners" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- strong reference to Book -->
    <ownedProperty name="featuredBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>