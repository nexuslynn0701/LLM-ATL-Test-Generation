<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="ERPSystem">

  <!-- Class 0: Customer -->
  <ownedElements name="Customer">
    <ownedProperty name="customerId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="true"/>
    <!-- Attribute with undefined primitiveType (tests NoType) -->
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Order -->
  <ownedElements name="Order">
    <!-- Weak reference to Customer (complexType, isContainment=false) -->
    <ownedProperty name="buyer" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference to Customer (complexType, isContainment=true) -->
    <ownedProperty name="owner" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Attribute with explicit primitiveType -->
    <ownedProperty name="totalAmount" primitiveType="Double" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Product with superclass Customer -->
  <ownedElements name="Product" superClasses="//@ownedElements.0">
    <!-- Weak self-reference -->
    <ownedProperty name="similarProduct" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="description" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Invoice with multiple superclasses -->
  <ownedElements name="Invoice" superClasses="//@ownedElements.0 //@ownedElements.1">
    <!-- Strong reference to Order -->
    <ownedProperty name="relatedOrder" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Product -->
    <ownedProperty name="primaryProduct" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Simple attribute -->
    <ownedProperty name="issueDate" primitiveType="Date" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Address (no superClass) -->
  <ownedElements name="Address">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="street" primitiveType="String" isContainment="true"/>
    <!-- Attribute with empty primitiveType string (still treated as primitive) -->
    <ownedProperty name="notes" primitiveType="" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>