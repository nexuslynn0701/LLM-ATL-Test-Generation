<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- Index 0 -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="true"/>
    <ownedProperty name="primaryAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="containingLibrary" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <!-- Index 1 -->
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="biography" isContainment="true"/>
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <!-- Index 2 -->
  <ownedElements name="Library">
    <ownedProperty name="libraryName" primitiveType="String" isContainment="true"/>
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <!-- Index 3 -->
  <ownedElements name="Member">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="true"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>