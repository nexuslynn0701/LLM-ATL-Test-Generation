<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibModel">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Primitive attribute with defined type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with undefined primitiveType (will become NoType) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Primitive attribute -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Address -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Primitive attribute -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Address -->
    <ownedProperty name="hqAddress" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Address -->
  <ownedElements name="Address">
    <!-- Primitive attribute -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Attribute with undefined primitiveType -->
    <ownedProperty name="postalCode" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>