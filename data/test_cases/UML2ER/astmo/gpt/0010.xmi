<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0 -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="true"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 1 -->
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="code" isContainment="true"/>
  </ownedElements>

  <!-- Class 2 -->
  <ownedElements name="Library" superClasses="//@ownedElements.3">
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 3 -->
  <ownedElements name="Institution">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="contactEmail" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>