<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseModel">
  <ownedElements name="Employee">
    <ownedProperty name="empId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="currentProject" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="deptId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="parentDepartment" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="location" primitiveType="" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="sponsorDepartment" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="notes" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>