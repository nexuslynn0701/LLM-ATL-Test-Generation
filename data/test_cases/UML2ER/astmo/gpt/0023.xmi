<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- Index 0 -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="chapters" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Item">
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="EBook" superClasses="//@ownedElements.0 //@ownedElements.1">
    <ownedProperty name="fileSizeMB" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="format" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Chapter">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="subChapters" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>