<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- ownedElements[0] -->
  <ownedElements name="Library">
    <!-- Attribute with primitiveType, no complexType -> Attributes rule -->
    <ownedProperty name="libName" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined, no complexType -> Attributes rule, NoType -->
    <ownedProperty name="location" isContainment="true"/>
    <!-- Weak reference (isContainment=false) to Member -->
    <ownedProperty name="members" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference (isContainment=true) to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- ownedElements[1] -->
  <ownedElements name="Member">
    <!-- Attribute with primitiveType, no complexType -->
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute with primitiveType, no complexType -->
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <!-- Strong reference (isContainment=true) to Loan -->
    <ownedProperty name="loans" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- ownedElements[2] -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType, no complexType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType, no complexType -->
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <!-- Weak reference (isContainment=false) to Member -->
    <ownedProperty name="currentHolder" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference (isContainment=true) to Library -->
    <ownedProperty name="homeLibrary" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- ownedElements[3] -->
  <ownedElements name="Loan">
    <!-- Attribute with primitiveType, no complexType -->
    <ownedProperty name="startDate" primitiveType="Date" isContainment="false"/>
    <!-- Attribute with primitiveType, no complexType -->
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
    <!-- Weak reference (isContainment=false) to Book -->
    <ownedProperty name="item" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Weak reference (isContainment=false) to Member -->
    <ownedProperty name="borrower" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>