<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType defined (triggers Attributes with given type) -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (triggers Attributes with NoType) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Weak reference (non-containment) to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference (containment) to Chapter -->
    <ownedProperty name="chapters" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="true"/>
    <!-- Weak reference (non-containment) back to Book -->
    <ownedProperty name="writtenBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Chapter, subclass of Book -->
  <ownedElements name="Chapter" superClasses="//@ownedElements.0">
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="sectionNumber" isContainment="true"/>
    <!-- Strong reference (containment) to Book -->
    <ownedProperty name="parentBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Publisher, subclass of Author -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.1">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference (non-containment) to Book -->
    <ownedProperty name="publishedBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>