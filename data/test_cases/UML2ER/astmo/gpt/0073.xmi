<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryModel">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType, no complexType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (tests NoType), no complexType -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Weak reference: non-containment, complexType -> Author -->
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference: containment, complexType -> Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType, no complexType -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference: containment, complexType -> Author -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Attribute with primitiveType, no complexType -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference: non-containment, complexType -> Publisher -->
    <ownedProperty name="parentCompany" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>