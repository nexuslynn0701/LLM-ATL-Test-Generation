<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="publishedYear" isContainment="false"/>
    <!-- Weak reference to Author (non-containment complex type) -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Publisher (containment complex type) -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference (non-containment complex type) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Address (containment complex type) -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="name" isContainment="false"/>
    <!-- Weak reference to Address (non-containment complex type) -->
    <ownedProperty name="officeAddress" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Address -->
  <ownedElements name="Address">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="zipCode" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>