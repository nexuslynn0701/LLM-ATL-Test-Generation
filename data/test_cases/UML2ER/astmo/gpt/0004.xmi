<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0 -->
  <ownedElements name="Book">
    <!-- primitive attribute with primitiveType set -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute with undefined primitiveType -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- weak reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- strong reference to Author -->
    <ownedProperty name="editor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 1 -->
  <ownedElements name="Author">
    <!-- primitive attribute -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 2 -->
  <ownedElements name="Publisher">
    <!-- primitive attribute with undefined primitiveType -->
    <ownedProperty name="code" isContainment="false"/>
    <!-- strong reference to Book -->
    <ownedProperty name="publishedBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>