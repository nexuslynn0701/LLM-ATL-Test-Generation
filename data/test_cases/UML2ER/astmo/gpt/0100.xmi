<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibSystem">

  <!-- ownedElements[0] -->
  <ownedElements name="Library">
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="libName" primitiveType="String" isContainment="false"/>
    <!-- reference, non-containment, targets Member -->
    <ownedProperty name="members" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- reference, containment, targets Book -->
    <ownedProperty name="books" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- ownedElements[1] -->
  <ownedElements name="Member">
    <!-- primitive attribute with primitiveType undefined -->
    <ownedProperty name="memberId" isContainment="false"/>
    <!-- reference, non-containment, targets Loan -->
    <ownedProperty name="loans" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- ownedElements[2] -->
  <ownedElements name="Book">
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="true"/>
    <!-- primitive attribute with primitiveType undefined -->
    <ownedProperty name="isbn" isContainment="true"/>
    <!-- reference, non-containment, targets Member -->
    <ownedProperty name="currentHolder" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- reference, containment, targets Loan -->
    <ownedProperty name="allLoans" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- ownedElements[3] -->
  <ownedElements name="Loan">
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="startDate" primitiveType="Date" isContainment="false"/>
    <!-- primitive attribute with primitiveType undefined -->
    <ownedProperty name="returnDate" isContainment="false"/>
    <!-- reference, non-containment, targets Member -->
    <ownedProperty name="borrower" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- reference, containment, targets Book -->
    <ownedProperty name="loanedBook" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>