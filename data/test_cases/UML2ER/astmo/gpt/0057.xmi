<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0 -->
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" primitiveType="String" isContainment="true"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 1 -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="summary" isContainment="false"/>
  </ownedElements>

  <!-- Class 2 -->
  <ownedElements name="Author">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryBook" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="agent" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Class 3 -->
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 4 -->
  <ownedElements name="Agent">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="representedAuthor" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>