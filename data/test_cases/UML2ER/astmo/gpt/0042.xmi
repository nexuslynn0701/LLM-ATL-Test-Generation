<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="InventorySystem">

  <!-- Class 0: Item -->
  <ownedElements name="Item">
    <ownedProperty name="sku" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="supplier" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Warehouse -->
  <ownedElements name="Warehouse">
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <ownedProperty name="capacity" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="items" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Supplier -->
  <ownedElements name="Supplier">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="rating" isContainment="false"/>
    <ownedProperty name="preferredWarehouse" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Shipment -->
  <ownedElements name="Shipment" superClasses="//@ownedElements.4">
    <ownedProperty name="date" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fromWarehouse" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="toWarehouse" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 4: Transport -->
  <ownedElements name="Transport">
    <ownedProperty name="mode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="cost" primitiveType="Float" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>