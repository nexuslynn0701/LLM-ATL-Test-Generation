<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType, no complexType => Attributes rule -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with undefined primitiveType, no complexType => Attributes (NoType) -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- Weak reference: non-containment to existing class Member -->
    <ownedProperty name="borrower" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Strong reference: containment to existing class Chapter -->
    <ownedProperty name="chapters" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author (no properties, will still create an EntityType) -->
  <ownedElements name="Author"/>

  <!-- Class 2: Member, subclass of Person -->
  <ownedElements name="Member" superClasses="//@ownedElements.4">
    <!-- Attribute with primitiveType, no complexType -->
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book (non-containment) -->
    <ownedProperty name="borrowedBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Chapter, subclass of Book -->
  <ownedElements name="Chapter" superClasses="//@ownedElements.0">
    <!-- Attribute with primitiveType, no complexType -->
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
    <!-- Strong reference to Author (containment) -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 4: Person, superclass in hierarchy -->
  <ownedElements name="Person">
    <!-- Attribute with primitiveType, no complexType -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>