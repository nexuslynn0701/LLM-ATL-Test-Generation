<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Library -->
  <ownedElements name="Library">
    <!-- Attribute with primitiveType defined, no complexType -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined, no complexType -->
    <ownedProperty name="code" isContainment="true"/>
    <!-- Weak reference: complexType set, isContainment = false -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference: complexType set, isContainment = true -->
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Book -->
  <ownedElements name="Book">
    <!-- Attribute -->
    <ownedProperty name="title" primitiveType="String" isContainment="true"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="author" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Author -->
  <ownedElements name="Author">
    <!-- Attribute without primitiveType -->
    <ownedProperty name="fullName" isContainment="false"/>
    <!-- Strong reference to Book -->
    <ownedProperty name="mainWork" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>