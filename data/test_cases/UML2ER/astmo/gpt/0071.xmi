<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="Book">
    <!-- primitive, no complexType -> Attribute, typed -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive, no complexType -> Attribute, NoType (primitiveType undefined) -->
    <ownedProperty name="code" isContainment="true"/>
    <!-- complexType, non-containment -> WeakReference -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- complexType, containment -> StrongReference -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Author">
    <!-- primitive, no complexType -> Attribute, typed -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- complexType, non-containment -> WeakReference -->
    <ownedProperty name="primaryBook" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- complexType, containment -> StrongReference -->
    <ownedProperty name="address" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Publisher">
    <!-- primitive, no complexType -> Attribute, NoType -->
    <ownedProperty name="companyName" isContainment="false"/>
    <!-- complexType, non-containment -> WeakReference -->
    <ownedProperty name="featuredBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Address">
    <!-- primitive, no complexType -> Attribute, typed -->
    <ownedProperty name="street" primitiveType="String" isContainment="true"/>
    <!-- primitive, no complexType -> Attribute, NoType -->
    <ownedProperty name="zip" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>