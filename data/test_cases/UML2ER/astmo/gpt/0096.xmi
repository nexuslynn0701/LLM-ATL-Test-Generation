<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Book -->
  <ownedElements name="Book">
    <!-- primitive, with explicit primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive, primitiveType undefined -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- complex, non-containment -> WeakReference -->
    <ownedProperty name="borrower" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Library -->
  <ownedElements name="Library">
    <!-- complex, containment -> StrongReference -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- primitive, primitiveType undefined, to become Attribute with NoType -->
    <ownedProperty name="code" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>