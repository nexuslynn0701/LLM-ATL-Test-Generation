<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without primitiveType (will become NoType) -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- weak reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- strong reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- primitive attribute with primitiveType -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- strong reference to Address -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- primitive attribute without primitiveType -->
    <ownedProperty name="name" isContainment="false"/>
    <!-- weak reference to Address -->
    <ownedProperty name="location" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Address -->
  <ownedElements name="Address">
    <!-- primitive attribute with primitiveType -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without primitiveType -->
    <ownedProperty name="zipCode" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>