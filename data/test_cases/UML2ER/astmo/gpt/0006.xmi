<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryModel">

  <!-- ownedElements[0] -->
  <ownedElements xmi:type="SimpleUml:Class" name="Book">
    <!-- primitive attribute, complexType undefined -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute with empty primitiveType -->
    <ownedProperty name="isbn" primitiveType="" isContainment="false"/>
    <!-- primitive attribute with primitiveType undefined (omitted) -->
    <ownedProperty name="pages" isContainment="false"/>
    <!-- weak reference to Author (non-containment, complexType set) -->
    <ownedProperty name="writer" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- strong reference to Publisher (containment, complexType set) -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- ownedElements[1] -->
  <ownedElements xmi:type="SimpleUml:Class" name="Author">
    <!-- primitive attribute -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- strong reference to Address -->
    <ownedProperty name="mainAddress" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- weak reference to Book (non-containment) -->
    <ownedProperty name="writtenBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- ownedElements[2] -->
  <ownedElements xmi:type="SimpleUml:Class" name="Publisher" superClasses="//@ownedElements.4">
    <!-- primitive attribute -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- strong reference to Address -->
    <ownedProperty name="hqAddress" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- ownedElements[3] -->
  <ownedElements xmi:type="SimpleUml:Class" name="Address">
    <!-- primitive attribute, primitiveType undefined -->
    <ownedProperty name="street" isContainment="false"/>
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="zipcode" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- ownedElements[4] -->
  <ownedElements xmi:type="SimpleUml:Class" name="Organization">
    <!-- primitive attribute -->
    <ownedProperty name="orgName" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>