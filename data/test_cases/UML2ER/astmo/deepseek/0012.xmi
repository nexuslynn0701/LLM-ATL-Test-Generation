<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="gpa" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="courses" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="description" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="teaches" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="mentor" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ResearchGroup">
    <ownedProperty name="topic" primitiveType="String" isContainment="false"/>
    <ownedProperty name="funding" isContainment="false"/>
    <ownedProperty name="leader" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="labLocation" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>