<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String"/>
    <ownedProperty name="age" primitiveType="Integer"/>
    <ownedProperty name="address" complexType="//@ownedElements.2"/>
    <ownedProperty name="department" isContainment="true" complexType="//@ownedElements.3"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String"/>
    <ownedProperty name="gpa" primitiveType="Double"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.0"/>
    <ownedProperty name="enrolledCourses" isContainment="true" complexType="//@ownedElements.4"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String"/>
    <ownedProperty name="city" primitiveType="String"/>
    <ownedProperty name="zipcode" primitiveType="String"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String"/>
    <ownedProperty name="budget" primitiveType="Double"/>
    <ownedProperty name="head" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="title" primitiveType="String"/>
    <ownedProperty name="credits" primitiveType="Integer"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.0"/>
    <ownedProperty name="prerequisites" isContainment="true" complexType="//@ownedElements.4"/>
  </ownedElements>
</SimpleUml:Package>