<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String"/>
    <ownedProperty name="location" primitiveType="String"/>
    <ownedProperty name="books" isContainment="true" complexType="//@ownedElements.1"/>
    <ownedProperty name="members" isContainment="true" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String"/>
    <ownedProperty name="isbn" primitiveType="String"/>
    <ownedProperty name="author" complexType="//@ownedElements.3"/>
    <ownedProperty name="publisher" primitiveType="String"/>
    <ownedProperty name="pages" primitiveType="Integer"/>
  </ownedElements>
  <ownedElements name="Member">
    <ownedProperty name="fullName" primitiveType="String"/>
    <ownedProperty name="memberId" primitiveType="Integer"/>
    <ownedProperty name="borrowedBooks" isContainment="false" complexType="//@ownedElements.1"/>
    <ownedProperty name="email" primitiveType="String"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="firstName" primitiveType="String"/>
    <ownedProperty name="lastName" primitiveType="String"/>
    <ownedProperty name="birthYear" primitiveType="Integer"/>
    <ownedProperty name="booksWritten" isContainment="false" complexType="//@ownedElements.1"/>
    <ownedProperty name="website" primitiveType="String"/>
  </ownedElements>
  <ownedElements name="Librarian" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String"/>
    <ownedProperty name="salary" primitiveType="Float"/>
    <ownedProperty name="managedSection" primitiveType="String"/>
  </ownedElements>
</SimpleUml:Package>