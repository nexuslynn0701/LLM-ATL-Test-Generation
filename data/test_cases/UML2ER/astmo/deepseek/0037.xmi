<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="courses" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="prerequisites" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student">
    <ownedProperty name="studentId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="enrolledCourses" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Enrollment">
    <ownedProperty name="grade" primitiveType="String" isContainment="false"/>
    <ownedProperty name="semester" primitiveType="String" isContainment="false"/>
    <ownedProperty name="student" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="course" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>