<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" isContainment="false" complexType="//@ownedElements.1"/>
    <ownedProperty name="courses" isContainment="true" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employeeId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="department" isContainment="false" complexType="//@ownedElements.0"/>
    <ownedProperty name="advisees" isContainment="true" complexType="//@ownedElements.3"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="teacher" isContainment="false" complexType="//@ownedElements.1"/>
    <ownedProperty name="prerequisites" isContainment="true" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="Student">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="enrolledIn" isContainment="false" complexType="//@ownedElements.2"/>
    <ownedProperty name="mentor" isContainment="false" complexType="//@ownedElements.1"/>
  </ownedElements>
</SimpleUml:Package>