<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String"/>
    <ownedProperty name="faculty" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Faculty">
    <ownedProperty name="facultyName" primitiveType="String"/>
    <ownedProperty name="dean" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="profName" primitiveType="String"/>
    <ownedProperty name="department" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student">
    <ownedProperty name="studentName" primitiveType="String"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="majorDept" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="GraduateStudent" superClasses="//@ownedElements.3"/>
</SimpleUml:Package>