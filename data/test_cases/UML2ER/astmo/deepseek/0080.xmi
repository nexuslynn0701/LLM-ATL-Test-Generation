<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="int" isContainment="false"/>
    <ownedProperty name="name" primitiveType="string" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="matriculationNumber" primitiveType="string" isContainment="false"/>
    <ownedProperty name="enrolledCourses" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="int" isContainment="false"/>
    <ownedProperty name="teachesCourse" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="office" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="code" primitiveType="string" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="int" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Office">
    <ownedProperty name="roomNumber" primitiveType="string" isContainment="false"/>
    <ownedProperty name="capacity" primitiveType="int" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>