<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UnivSystem">
  <ownedElements name="University">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="departments" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="libraries" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="floors" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="catalog" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="affiliatedWith" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Catalog">
    <ownedProperty name="totalBooks" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="managedBy" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="offeredBy" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="specialization" primitiveType="String" isContainment="false"/>
    <ownedProperty name="teaches" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>