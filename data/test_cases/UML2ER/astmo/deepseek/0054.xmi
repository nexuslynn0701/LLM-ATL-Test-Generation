<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="members" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="library" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="booksWritten" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person">
    <ownedProperty name="age" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>