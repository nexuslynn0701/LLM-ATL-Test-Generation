<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="SchoolSystem">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.1">
    <ownedProperty name="courses" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="office" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="dean" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Office">
    <ownedProperty name="roomNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="floor" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>