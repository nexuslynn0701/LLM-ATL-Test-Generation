<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="gpa" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="advises" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Advisor">
    <ownedProperty name="office" primitiveType="String" isContainment="false"/>
    <ownedProperty name="officeHours" primitiveType="String" isContainment="false"/>
    <ownedProperty name="maxStudents" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="prerequisite" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="syllabus" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Float" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>