<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" isContainment="false" complexType="//@ownedElements.2"/>
    <ownedProperty name="courses" isContainment="true" complexType="//@ownedElements.1"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="department" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="specialty" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
</SimpleUml:Package>