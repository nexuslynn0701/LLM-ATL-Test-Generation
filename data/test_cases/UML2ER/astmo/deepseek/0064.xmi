<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="String"/>
    <ownedProperty name="faculty" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Faculty">
    <ownedProperty name="name" primitiveType="String"/>
    <ownedProperty name="department" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="dean" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="firstName" primitiveType="String"/>
    <ownedProperty name="lastName" primitiveType="String"/>
    <ownedProperty name="employeeId" primitiveType="Integer"/>
    <ownedProperty name="department" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="teaches" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="code" primitiveType="String"/>
    <ownedProperty name="credits" primitiveType="Integer"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Student">
    <ownedProperty name="studentId" primitiveType="String"/>
    <ownedProperty name="enrolledIn" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="mentor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ResearchGroup">
    <ownedProperty name="topic" primitiveType="String"/>
    <ownedProperty name="leader" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>