<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dean" isContainment="false" complexType="//@ownedElements.0"/>
    <ownedProperty name="faculty" isContainment="true" complexType="//@ownedElements.1"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="profName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="specialization" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" isContainment="false" complexType="//@ownedElements.0"/>
    <ownedProperty name="mentor" isContainment="false" complexType="//@ownedElements.1"/>
    <ownedProperty name="researchGroup" isContainment="true" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="ResearchGroup">
    <ownedProperty name="groupName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="foundedYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="leader" isContainment="false" complexType="//@ownedElements.1"/>
    <ownedProperty name="parentDept" isContainment="true" complexType="//@ownedElements.0"/>
  </ownedElements>
</SimpleUml:Package>