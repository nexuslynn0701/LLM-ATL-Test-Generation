<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:SimpleUml="http://SimpleUML" name="UniversityModel">
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="coordinator" isContainment="false" complexType="//@ownedElements.1"/>
    <ownedProperty name="department" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="Student">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="courses" isContainment="true" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="Enrollment">
    <ownedProperty name="enrollmentDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="grade" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="student" isContainment="false" complexType="//@ownedElements.3"/>
    <ownedProperty name="course" isContainment="false" complexType="//@ownedElements.2"/>
  </ownedElements>
</SimpleUml:Package>