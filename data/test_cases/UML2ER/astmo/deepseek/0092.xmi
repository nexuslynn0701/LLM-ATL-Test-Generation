<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" isContainment="false" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="Employee">
    <ownedProperty name="employeeId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="personInfo" isContainment="true" complexType="//@ownedElements.0"/>
    <ownedProperty name="department" isContainment="false" complexType="//@ownedElements.3"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="postalCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" isContainment="true" complexType="//@ownedElements.1"/>
    <ownedProperty name="parentDepartment" isContainment="false" complexType="//@ownedElements.3"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="lead" isContainment="true" complexType="//@ownedElements.1"/>
    <ownedProperty name="members" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
</SimpleUml:Package>