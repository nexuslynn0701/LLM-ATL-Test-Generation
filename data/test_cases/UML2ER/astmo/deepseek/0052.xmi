<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String"/>
    <ownedProperty name="isbn" primitiveType="String"/>
    <ownedProperty name="author" complexType="//@ownedElements.1"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String"/>
    <ownedProperty name="email" primitiveType="String"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String"/>
    <ownedProperty name="address" primitiveType="String"/>
    <ownedProperty name="publishedBooks" complexType="//@ownedElements.0"/>
    <ownedProperty name="contactPerson" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Library">
    <ownedProperty name="libraryName" primitiveType="String"/>
    <ownedProperty name="location" primitiveType="String"/>
    <ownedProperty name="bookCollection" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="librarian" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Librarian">
    <ownedProperty name="employeeId" primitiveType="String"/>
    <ownedProperty name="fullName"/>
    <ownedProperty name="manages" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>