<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="faculty" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="courses" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Faculty">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="prerequisites" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="gpa" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="enrolledCourses" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ResearchProject">
    <ownedProperty name="budget" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="leadResearcher" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="collaborators" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>