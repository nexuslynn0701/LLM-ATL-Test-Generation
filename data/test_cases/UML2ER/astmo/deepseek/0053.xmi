<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String"/>
    <ownedProperty name="age" primitiveType="Integer"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.2"/>
    <ownedProperty name="courses" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="employeeId" primitiveType="Integer"/>
    <ownedProperty name="department" primitiveType="String"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="code" primitiveType="String"/>
    <ownedProperty name="credits" primitiveType="Integer"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="syllabus" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Syllabus">
    <ownedProperty name="content" primitiveType="String"/>
    <ownedProperty name="totalPages" primitiveType="Integer"/>
  </ownedElements>
</SimpleUml:Package>