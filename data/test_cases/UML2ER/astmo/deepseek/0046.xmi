<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="Library">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="chapters" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Member">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="address" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <ownedProperty name="foundedYear" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Chapter">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pageCount" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="subChapters" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>