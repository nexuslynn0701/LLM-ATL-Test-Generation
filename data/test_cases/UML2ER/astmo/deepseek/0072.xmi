<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="birthYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="founded" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="ceo" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="established" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="employees" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Employee">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="worksIn" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="joinDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="membershipType" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="BorrowRecord">
    <ownedProperty name="borrowDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="returnDate" primitiveType="String" isContainment="false"/>
    <ownedProperty name="relatedBook" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>