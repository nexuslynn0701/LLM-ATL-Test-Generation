<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="faculty" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Faculty">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dean" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Enrollment">
    <ownedProperty name="grade" primitiveType="String" isContainment="false"/>
    <ownedProperty name="student" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="course" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>