<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="major" primitiveType="String" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assistants" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="TeachingAssistant" superClasses="//@ownedElements.0">
    <ownedProperty name="hourlyRate" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="supervisor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="enrolledStudents" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>