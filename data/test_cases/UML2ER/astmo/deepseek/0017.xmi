<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="profName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="prerequisites" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Student">
    <ownedProperty name="studentId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="major" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>