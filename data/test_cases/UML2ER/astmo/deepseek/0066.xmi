<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student">
    <ownedProperty name="studentId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="gpa" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="enrolledIn" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="specialization" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="mentors" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>