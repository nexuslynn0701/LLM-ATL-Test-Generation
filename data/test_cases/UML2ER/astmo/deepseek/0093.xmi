<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="headProfessor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="syllabus" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="mentor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ResearchProject">
    <ownedProperty name="projectId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="funding" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="leadResearcher" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="collaborators" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>