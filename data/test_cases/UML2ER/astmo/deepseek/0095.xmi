<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:SimpleUml="http://SimpleUML" name="UniversityModel">
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" isContainment="true" complexType="//@ownedElements.1"/>
    <ownedProperty name="location" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee">
    <ownedProperty name="empId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="department" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="leader" isContainment="false" complexType="//@ownedElements.1"/>
    <ownedProperty name="tasks" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Task" superClasses="//@ownedElements.3">
    <ownedProperty name="taskName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignedTo" isContainment="true" complexType="//@ownedElements.1"/>
    <ownedProperty name="priority" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="parentProject" isContainment="false" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="Milestone">
    <ownedProperty name="deadline" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="completed" primitiveType="Boolean" isContainment="false"/>
    <ownedProperty name="milestoneProject" isContainment="true" complexType="//@ownedElements.2"/>
  </ownedElements>
</SimpleUml:Package>