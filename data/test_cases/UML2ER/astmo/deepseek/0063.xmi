<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String"/>
    <ownedProperty name="age" primitiveType="Integer"/>
    <ownedProperty name="address" complexType="//@ownedElements.1"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String"/>
    <ownedProperty name="city" primitiveType="String"/>
    <ownedProperty name="zipCode" primitiveType="Integer"/>
    <ownedProperty name="country" primitiveType="String"/>
    <ownedProperty name="person" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="departmentName" primitiveType="String"/>
    <ownedProperty name="budget" primitiveType="Float"/>
    <ownedProperty name="head" isContainment="true" complexType="//@ownedElements.3"/>
    <ownedProperty name="members" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="professorId" primitiveType="String"/>
    <ownedProperty name="specialization" primitiveType="String"/>
    <ownedProperty name="office" complexType="//@ownedElements.4"/>
    <ownedProperty name="managedDepartment" isContainment="false" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="Office">
    <ownedProperty name="roomNumber" primitiveType="String"/>
    <ownedProperty name="floor" primitiveType="Integer"/>
    <ownedProperty name="capacity" primitiveType="Integer"/>
    <ownedProperty name="occupant" isContainment="true" complexType="//@ownedElements.3"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="projectName" primitiveType="String"/>
    <ownedProperty name="startDate" primitiveType="String"/>
    <ownedProperty name="budget" primitiveType="Float"/>
    <ownedProperty name="leader" isContainment="false" complexType="//@ownedElements.3"/>
    <ownedProperty name="participants" isContainment="false" complexType="//@ownedElements.0"/>
    <ownedProperty name="sponsor" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String"/>
    <ownedProperty name="title" primitiveType="String"/>
    <ownedProperty name="credits" primitiveType="Integer"/>
    <ownedProperty name="instructor" isContainment="true" complexType="//@ownedElements.3"/>
    <ownedProperty name="prerequisites" isContainment="false" complexType="//@ownedElements.6"/>
  </ownedElements>
</SimpleUml:Package>