<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="enrollments" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
    <ownedProperty name="advisees" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Enrollment">
    <ownedProperty name="grade" primitiveType="String" isContainment="false"/>
    <ownedProperty name="semester" primitiveType="String" isContainment="false"/>
    <ownedProperty name="student" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="course" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>