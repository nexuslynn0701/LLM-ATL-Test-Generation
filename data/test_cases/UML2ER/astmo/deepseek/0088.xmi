<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="profName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Student">
    <ownedProperty name="studentName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="studentId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="enrolledIn" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Enrollment">
    <ownedProperty name="enrollmentDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="grade" primitiveType="String" isContainment="false"/>
    <ownedProperty name="student" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="course" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>