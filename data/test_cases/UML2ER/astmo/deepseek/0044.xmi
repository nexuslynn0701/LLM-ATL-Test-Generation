<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversityModel">
  <ownedElements name="Department" superClasses="">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" isContainment="false" complexType="//@ownedElements.1"/>
  </ownedElements>
  <ownedElements name="Employee">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="Manager" superClasses="//@ownedElements.1">
    <ownedProperty name="teamSize" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="secretary" isContainment="false" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="Secretary" superClasses="//@ownedElements.1">
    <ownedProperty name="typingSpeed" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="boss" isContainment="true" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="budget" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="lead" isContainment="false" complexType="//@ownedElements.1"/>
    <ownedProperty name="members" isContainment="true" complexType="//@ownedElements.4"/>
  </ownedElements>
  <ownedElements name="Task">
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignedTo" isContainment="false" complexType="//@ownedElements.1"/>
    <ownedProperty name="subtasks" isContainment="true" complexType="//@ownedElements.5"/>
  </ownedElements>
</SimpleUml:Package>