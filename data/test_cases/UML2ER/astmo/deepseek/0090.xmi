<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="faculty" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="courses" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Faculty">
    <ownedProperty name="facultyName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="dean" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="departments" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="syllabus" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="profName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employeeId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="teaches" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Syllabus">
    <ownedProperty name="content" primitiveType="Text" isContainment="false"/>
    <ownedProperty name="version" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>