<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="facultyMember" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Employee">
    <ownedProperty name="employeeId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="workEmail" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.1">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="courses" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="AdminStaff" superClasses="//@ownedElements.1">
    <ownedProperty name="officeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="permissions" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>