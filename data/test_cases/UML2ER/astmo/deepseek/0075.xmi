<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="gpa" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="enrolledIn" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="departmentName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="teaches" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="mentors" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="deptCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="chair" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="college" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="syllabus" primitiveType="String" isContainment="false"/>
    <ownedProperty name="offeredBy" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="prerequisite" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="College">
    <ownedProperty name="collegeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="foundingYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="dean" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>