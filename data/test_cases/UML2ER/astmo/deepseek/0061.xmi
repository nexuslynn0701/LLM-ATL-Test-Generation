<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headProfessor" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="courses" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="profName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="office" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="taughtBy" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="requiredTextbook" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Office">
    <ownedProperty name="roomNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="capacity" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Textbook">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>