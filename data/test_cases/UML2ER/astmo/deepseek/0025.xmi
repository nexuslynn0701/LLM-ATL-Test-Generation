<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="headOfDept" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor">
    <ownedProperty name="profName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="coursesTaught" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="PhDStudent" superClasses="//@ownedElements.4">
    <ownedProperty name="studentName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="thesisTopic" primitiveType="String" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="registration" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Person">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>