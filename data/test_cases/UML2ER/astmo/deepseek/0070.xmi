<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="TestPackage">
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="booksWritten" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="pubName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>