<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="modelPkg">
  <!-- Class 0: Simple entity with only primitive properties -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Uses both weak and strong references to other classes -->
  <ownedElements name="Company">
    <ownedProperty name="companyId" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Person (non-containment complexType) -->
    <ownedProperty name="founder"
                   complexType="//@ownedElements.0"
                   isContainment="false"/>
    <!-- Strong reference to Address (containment complexType) -->
    <ownedProperty name="headOffice"
                   complexType="//@ownedElements.2"
                   isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Target of strong reference and supertype in inheritance -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Inherits from Person and Company, mixes all property patterns -->
  <ownedElements name="Employee"
                 superClasses="//@ownedElements.0 //@ownedElements.1">
    <!-- Primitive attribute -->
    <ownedProperty name="salary" primitiveType="Real" isContainment="false"/>
    <!-- Weak reference to Company -->
    <ownedProperty name="employer"
                   complexType="//@ownedElements.1"
                   isContainment="false"/>
    <!-- Strong reference to Address -->
    <ownedProperty name="homeAddress"
                   complexType="//@ownedElements.2"
                   isContainment="true"/>
    <!-- Attribute with undefined primitiveType (will become NoType) -->
    <ownedProperty name="miscInfo" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>