<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="LibrarySystem">
  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without primitiveType (will become NoType) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- weak reference to Author -->
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- strong (containment) reference to Chapter -->
    <ownedProperty name="chapters" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without primitiveType -->
    <ownedProperty name="birthYear" isContainment="false"/>
    <!-- weak reference back to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Chapter (subclass of Book and Author to exercise superClasses) -->
  <ownedElements name="Chapter" superClasses="//@ownedElements.0 //@ownedElements.1">
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
    <!-- primitive attribute without primitiveType -->
    <ownedProperty name="title" isContainment="false"/>
    <!-- strong (containment) reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>