<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="modelPkg">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- primitive attribute, no complexType => Attributes rule, primitiveType defined -->
    <ownedProperty name="personId" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute, no complexType, primitiveType undefined => Attributes rule, NoType -->
    <ownedProperty name="nickname" isContainment="true"/>
    <!-- complex, non-containment => References + WeakReferences -->
    <ownedProperty name="spouse" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- complex, containment => References + StrongReferences -->
    <ownedProperty name="address" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Employee, subclass of Person -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <!-- primitive attribute, no complexType => Attributes rule -->
    <ownedProperty name="salary" primitiveType="Integer" isContainment="false"/>
    <!-- complex, non-containment => References + WeakReferences -->
    <ownedProperty name="manager" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- complex, containment => References + StrongReferences -->
    <ownedProperty name="department" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Address -->
  <ownedElements name="Address">
    <!-- primitive attribute, no complexType => Attributes rule -->
    <ownedProperty name="street" primitiveType="String" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Department -->
  <ownedElements name="Department">
    <!-- primitive attribute, no complexType => Attributes rule -->
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <!-- complex, containment => References + StrongReferences -->
    <ownedProperty name="employees" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>