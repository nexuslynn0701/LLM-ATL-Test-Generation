<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="library_pkg">
  <ownedElements name="Author">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>