<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="details" isContainment="true" complexType="//@ownedElements.3"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="birthDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="primaryBook" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainAuthor" isContainment="true" complexType="//@ownedElements.1"/>
  </ownedElements>
  <ownedElements name="BookDetails">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>