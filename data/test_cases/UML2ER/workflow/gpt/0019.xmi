<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="ModelPkg">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Primitive attribute with primitiveType set -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- Primitive attribute with primitiveType undefined -->
    <ownedProperty name="description" isContainment="false"/>
    <!-- Weak reference to Address (complexType, non-containment) -->
    <ownedProperty name="livesAt" complexType="//@ownedElements.3" isContainment="false"/>
    <!-- Strong reference to Order (complexType, containment) -->
    <ownedProperty name="orders" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Customer, subclass of Person -->
  <ownedElements name="Customer" superClasses="//@ownedElements.0">
    <!-- Primitive attribute -->
    <ownedProperty name="customerNumber" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Person (e.g., referredBy) -->
    <ownedProperty name="referredBy" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference to Address (contained address) -->
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Order -->
  <ownedElements name="Order">
    <!-- Primitive attribute -->
    <ownedProperty name="totalAmount" primitiveType="Float" isContainment="false"/>
    <!-- Weak reference back to Customer (non-containment) -->
    <ownedProperty name="customer" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Address -->
  <ownedElements name="Address">
    <!-- Primitive attributes -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Person (containment) -->
    <ownedProperty name="resident" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>