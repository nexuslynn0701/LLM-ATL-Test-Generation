<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="library_pkg">
  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType defined (Attribute rule, NamedElement, Property) -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (will become NoType) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Weak reference to Author (complexType set, isContainment=false) -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Publisher (complexType set, isContainment=true) -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Weak reference back to Book (complexType set, isContainment=false) -->
    <ownedProperty name="writtenBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Attribute with primitiveType undefined (NoType) -->
    <ownedProperty name="code" isContainment="false"/>
    <!-- Strong reference to Book (complexType set, isContainment=true) -->
    <ownedProperty name="publishedBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>