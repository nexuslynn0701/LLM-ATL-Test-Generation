<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestPkg_Main">
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Company">
    <ownedProperty name="companyId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="headquarters" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="employer" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>