<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="pkgMain">

  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute without complexType, with primitiveType -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute without complexType, without primitiveType -->
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Weak reference (non-containment) to Person -->
    <ownedProperty name="resident" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference (containment) to Person -->
    <ownedProperty name="owner" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Company, subclass of Person -->
  <ownedElements name="Company" superClasses="//@ownedElements.0">
    <!-- Attribute without complexType, with primitiveType -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Weak reference (non-containment) to Address -->
    <ownedProperty name="hqAddress" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>