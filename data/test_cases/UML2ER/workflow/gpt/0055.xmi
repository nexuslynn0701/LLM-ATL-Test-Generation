<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestPkg_Main">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Primitive attribute with explicit primitiveType -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- Primitive attribute with undefined primitiveType (will become NoType) -->
    <ownedProperty name="nickname" isContainment="false"/>
    <!-- Weak reference to Address (non-containment, complexType set) -->
    <ownedProperty name="homeAddress"
                   complexType="//@ownedElements.1"
                   isContainment="false"/>
    <!-- Strong reference to Company (containment, complexType set) -->
    <ownedProperty name="employer"
                   complexType="//@ownedElements.2"
                   isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Primitive attribute, no primitiveType (NoType) -->
    <ownedProperty name="street" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Company, subclass of Person -->
  <ownedElements name="Company" superClasses="//@ownedElements.0">
    <!-- Primitive attribute with explicit primitiveType -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Address (containment, complexType set) -->
    <ownedProperty name="hqAddress"
                   complexType="//@ownedElements.1"
                   isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>