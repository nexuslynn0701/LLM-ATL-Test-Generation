<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="TestPkg_Main">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="nickname" isContainment="false"/>
    <!-- Weak reference to Address (Class 1) -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Company (Class 2) -->
    <ownedProperty name="employer" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="postalCode" isContainment="false"/>
    <!-- Weak reference to Person (Class 0) -->
    <ownedProperty name="resident" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Company, subclass of Person and Address -->
  <ownedElements name="Company" superClasses="//@ownedElements.0 //@ownedElements.1">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="foundedOn" isContainment="false"/>
    <!-- Strong reference to Address (Class 1) -->
    <ownedProperty name="hqAddress" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>