<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="LibraryModel">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publishedYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="chapters" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Chapter">
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>