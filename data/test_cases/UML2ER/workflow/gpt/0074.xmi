<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UmlToEr_TestPkg">
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Company">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="headquarters" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Project" superClasses="//@ownedElements.2">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="mainContact" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>