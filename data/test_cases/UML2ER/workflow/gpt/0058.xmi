<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="ModelPkg">
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Company">
    <ownedProperty name="mainAddress" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="headquarterCity" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="officeAddress" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="salary" primitiveType="Float" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>