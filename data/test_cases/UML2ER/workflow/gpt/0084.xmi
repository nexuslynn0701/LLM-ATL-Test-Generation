<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="library_model">
  <ownedElements name="Author">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contactInfo" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ContactInfo">
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="phone" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>