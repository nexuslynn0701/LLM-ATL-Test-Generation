<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestModelRoot">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Primitive attribute with explicit primitiveType -->
    <ownedProperty name="personId" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute with undefined primitiveType -->
    <ownedProperty name="age" isContainment="false"/>
    <!-- Weak reference to Address (non-containment, complexType set) -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Company (containment, complexType set) -->
    <ownedProperty name="employer" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Primitive attribute with explicit primitiveType -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference (containment, complexType set) -->
    <ownedProperty name="relatedAddress" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Company, subclass of Person -->
  <ownedElements name="Company" superClasses="//@ownedElements.0">
    <!-- Primitive attribute without primitiveType (NoType expected) -->
    <ownedProperty name="companyCode" isContainment="false"/>
    <!-- Weak self-reference (non-containment, complexType set) -->
    <ownedProperty name="parentCompany" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>