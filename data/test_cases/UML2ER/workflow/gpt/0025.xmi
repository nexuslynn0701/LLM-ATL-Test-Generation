<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="pkg_main">
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="employer" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Company">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headquarters" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="employees" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Project" superClasses="//@ownedElements.2 //@ownedElements.0">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="owner" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="description" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>