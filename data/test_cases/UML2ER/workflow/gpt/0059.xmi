<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="UML2ER_TestPackage">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Primitive attribute with explicit primitiveType -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- Primitive attribute without primitiveType (will become NoType) -->
    <ownedProperty name="nickname" isContainment="false"/>
    <!-- Weak reference to Address (class 1) -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Company (class 2) -->
    <ownedProperty name="employer" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Primitive attribute with type -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute without type -->
    <ownedProperty name="zipCode" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Company, subclass of Person (to exercise superClasses reference) -->
  <ownedElements name="Company" superClasses="//@ownedElements.0">
    <!-- Weak reference back to Person -->
    <ownedProperty name="contactPerson" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference to Address -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>