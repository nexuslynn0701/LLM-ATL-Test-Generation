<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="UML2ER_TestPkg">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute property: primitiveType defined, no complexType -->
    <ownedProperty name="personId" primitiveType="String" isContainment="false"/>
    <!-- Attribute property: primitiveType undefined, no complexType -->
    <ownedProperty name="createdOn" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Attribute property: primitiveType defined, no complexType -->
    <ownedProperty name="street" primitiveType="String" isContainment="true"/>
    <!-- Attribute property: primitiveType undefined, no complexType -->
    <ownedProperty name="zipCode" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Company -->
  <ownedElements name="Company">
    <!-- Weak reference: complexType set, isContainment=false -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference: complexType set, isContainment=true -->
    <ownedProperty name="founder" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Department (with superclass) -->
  <ownedElements name="Department" superClasses="//@ownedElements.2">
    <!-- Weak reference to Company -->
    <ownedProperty name="parentCompany" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Strong reference to Address -->
    <ownedProperty name="location" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Attribute without primitiveType -->
    <ownedProperty name="budget" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>