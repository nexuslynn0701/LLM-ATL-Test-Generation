<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="LibrarySystem">
  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without primitiveType (will yield NoType) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- weak reference to Author (complexType set, isContainment=false) -->
    <ownedProperty name="author" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- strong reference to Library (complexType set, isContainment=true) -->
    <ownedProperty name="library" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- primitive attribute with primitiveType -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- weak reference back to Book (complexType set, isContainment=false) -->
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Library -->
  <ownedElements name="Library">
    <!-- primitive attribute with primitiveType -->
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <!-- strong reference to Book (complexType set, isContainment=true) -->
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>