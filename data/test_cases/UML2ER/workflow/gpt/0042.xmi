<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestPkg_Main">
  <!-- Class 0: Person (only primitive properties -> Attributes rule, with and without primitiveType) -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="nickname" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Address (referenced by weak and strong references) -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="true"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Company (weak reference to Address, strong reference to Person) -->
  <ownedElements name="Company">
    <ownedProperty name="headquarters"
                   complexType="//@ownedElements.1"
                   isContainment="false"/>
    <ownedProperty name="founder"
                   complexType="//@ownedElements.0"
                   isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Department (inherits from Company, references Person and Address) -->
  <ownedElements name="Department"
                 superClasses="//@ownedElements.2">
    <ownedProperty name="manager"
                   complexType="//@ownedElements.0"
                   isContainment="false"/>
    <ownedProperty name="location"
                   complexType="//@ownedElements.1"
                   isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>