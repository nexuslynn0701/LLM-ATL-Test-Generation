<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="libraryModel">
  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute property: triggers Attributes rule with explicit primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute property: triggers Attributes rule with NoType (primitiveType undefined) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Weak reference: complexType set, isContainment=false -> WeakReferences -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference: complexType set, isContainment=true -> StrongReferences -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute property -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="booksWritten" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference to Address -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Attribute property -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="publishedBooks" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Address (subclass of Publisher just to exercise superClasses reference) -->
  <ownedElements name="Address" superClasses="//@ownedElements.2">
    <!-- Attribute property -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Attribute property with undefined primitiveType -->
    <ownedProperty name="postcode" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>