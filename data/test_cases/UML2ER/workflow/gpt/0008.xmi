<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="TestPkg_Main">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Primitive attribute with explicit type -->
    <ownedProperty name="personId" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute without type (will become NoType) -->
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>
  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Primitive attribute with type -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Reference to Person, non-containment (WeakReference) -->
    <ownedProperty name="resident" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <!-- Class 2: Order, subclass of Person -->
  <ownedElements name="Order" superClasses="//@ownedElements.0">
    <!-- Primitive attribute with type -->
    <ownedProperty name="orderNumber" primitiveType="Integer" isContainment="false"/>
    <!-- Reference to Address, containment (StrongReference) -->
    <ownedProperty name="shippingAddress" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>