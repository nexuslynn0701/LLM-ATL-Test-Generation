<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="UML2ER_TestPkg">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Primitive attribute with explicit primitiveType -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute without primitiveType (will map to NoType) -->
    <ownedProperty name="age" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Primitive attribute with primitiveType -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Company -->
  <ownedElements name="Company">
    <!-- Non-containment reference to Address (WeakReference) -->
    <ownedProperty name="headquarters"
                   complexType="//@ownedElements.1"
                   isContainment="false"/>
    <!-- Containment reference to Person (StrongReference) -->
    <ownedProperty name="employees"
                   complexType="//@ownedElements.0"
                   isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Customer, subclass of Person and Company -->
  <ownedElements name="Customer"
                 superClasses="//@ownedElements.0 //@ownedElements.2">
    <!-- Primitive attribute with primitiveType -->
    <ownedProperty name="customerId" primitiveType="Integer" isContainment="false"/>
    <!-- Non-containment reference to Address (WeakReference) -->
    <ownedProperty name="billingAddress"
                   complexType="//@ownedElements.1"
                   isContainment="false"/>
    <!-- Containment reference to Company (StrongReference) -->
    <ownedProperty name="preferredSupplier"
                   complexType="//@ownedElements.2"
                   isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>