<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestPkg_Main">
  <!-- Class 0: Only primitive attributes, including one with undefined primitiveType -->
  <ownedElements name="PrimitiveOnly">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="description" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Only complex-type references, both weak and strong -->
  <ownedElements name="RefOnly">
    <!-- Weak reference (non-containment) to Class 2 -->
    <ownedProperty name="weakToClass2"
                   complexType="//@ownedElements.2"
                   isContainment="false"/>
    <!-- Strong reference (containment) to Class 0 -->
    <ownedProperty name="strongToClass0"
                   complexType="//@ownedElements.0"
                   isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Mixed primitive attributes and complex references -->
  <ownedElements name="MixedClass">
    <!-- Attribute with defined primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with undefined primitiveType -->
    <ownedProperty name="flag" isContainment="false"/>
    <!-- Weak reference to Class 1 -->
    <ownedProperty name="weakToClass1"
                   complexType="//@ownedElements.1"
                   isContainment="false"/>
    <!-- Strong reference to Class 0 -->
    <ownedProperty name="strongToClass0Again"
                   complexType="//@ownedElements.0"
                   isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>