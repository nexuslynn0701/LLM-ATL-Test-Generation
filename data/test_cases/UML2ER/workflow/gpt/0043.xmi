<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="LibrarySystem">
  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute: title, primitiveType defined -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute: publicationYear, primitiveType undefined -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- Weak reference: mainAuthor -> Author (non-containment) -->
    <ownedProperty name="mainAuthor"
                   complexType="//@ownedElements.1"
                   isContainment="false"/>
    <!-- Strong reference: publisher -> Publisher (containment) -->
    <ownedProperty name="publisher"
                   complexType="//@ownedElements.2"
                   isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute: name, primitiveType defined -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Weak reference: primaryBook -> Book (non-containment, tests cross-ref cycle) -->
    <ownedProperty name="primaryBook"
                   complexType="//@ownedElements.0"
                   isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Attribute: companyName, primitiveType undefined -->
    <ownedProperty name="companyName" isContainment="false"/>
    <!-- Strong reference: catalog -> Book (containment) -->
    <ownedProperty name="catalog"
                   complexType="//@ownedElements.0"
                   isContainment="true"/>
  </ownedElements>

  <!-- Class 3: LibraryUser (with superClasses Book and Author for coverage) -->
  <ownedElements name="LibraryUser"
                 superClasses="//@ownedElements.0 //@ownedElements.1">
    <!-- Attribute: id, primitiveType defined -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- Weak reference: favoriteBook -> Book -->
    <ownedProperty name="favoriteBook"
                   complexType="//@ownedElements.0"
                   isContainment="false"/>
    <!-- Strong reference: homePublisher -> Publisher -->
    <ownedProperty name="homePublisher"
                   complexType="//@ownedElements.2"
                   isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>