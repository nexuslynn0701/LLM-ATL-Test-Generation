<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestPkg_Main">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="personId" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="nickname" isContainment="false"/>
    <!-- Weak reference to Address (Class 1), non-containment -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Company (Class 2), containment -->
    <ownedProperty name="employer" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Address, subclass of Person -->
  <ownedElements name="Address" superClasses="//@ownedElements.0">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="zipCode" isContainment="false"/>
    <!-- Weak reference to Company (Class 2), non-containment -->
    <ownedProperty name="locatedInCompany" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Strong reference to Person (Class 0), containment -->
    <ownedProperty name="primaryResident" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Company, subclass of Person and Address -->
  <ownedElements name="Company" superClasses="//@ownedElements.0 //@ownedElements.1">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="foundedOn" isContainment="false"/>
    <!-- Weak reference to Person (Class 0), non-containment -->
    <ownedProperty name="contactPerson" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference to Address (Class 1), containment -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>