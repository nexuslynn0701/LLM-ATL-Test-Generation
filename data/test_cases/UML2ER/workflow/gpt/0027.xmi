<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="pkg_main">
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Company">
    <ownedProperty name="companyId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="hqAddress" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.0 //@ownedElements.2">
    <ownedProperty name="salary" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="officeAddress" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>