<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="libraryModel">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute property with primitiveType defined -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute property with primitiveType undefined -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Weak reference (non-containment) to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference (containment) to Author -->
    <ownedProperty name="coAuthor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute property with primitiveType defined -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Weak reference (non-containment) to Book -->
    <ownedProperty name="writtenBook" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference (containment) to Publisher -->
    <ownedProperty name="mainPublisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher, subclass of Author -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.1">
    <!-- Attribute property with primitiveType undefined -->
    <ownedProperty name="code" isContainment="false"/>
    <!-- Weak reference (non-containment) to Book -->
    <ownedProperty name="publishedBook" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference (containment) to Library -->
    <ownedProperty name="ownedLibrary" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Library, subclass of Publisher -->
  <ownedElements name="Library" superClasses="//@ownedElements.2">
    <!-- Attribute property with primitiveType defined -->
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <!-- Attribute property with primitiveType undefined -->
    <ownedProperty name="capacity" isContainment="false"/>
    <!-- Weak reference (non-containment) to Book -->
    <ownedProperty name="featuredBook" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference (containment) to Author -->
    <ownedProperty name="residentAuthor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>