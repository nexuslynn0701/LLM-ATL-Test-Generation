<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="DomainPkg">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- primitive attribute with explicit type -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- primitive attribute without primitiveType (will become NoType) -->
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- primitive attribute with explicit type -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without primitiveType -->
    <ownedProperty name="zipCode" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Company -->
  <ownedElements name="Company">
    <!-- reference, non-containment -> WeakReference, to Person -->
    <ownedProperty name="employees" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- reference, containment -> StrongReference, to Address -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Department, subclass of Company -->
  <ownedElements name="Department" superClasses="//@ownedElements.2">
    <!-- reference, non-containment -> WeakReference, to Company -->
    <ownedProperty name="parentCompany" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- reference, containment -> StrongReference, to Person -->
    <ownedProperty name="manager" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>