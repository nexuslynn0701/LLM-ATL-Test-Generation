<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="LibrarySystem">
  <!-- Class 0 -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (will yield NoType) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1 -->
  <ownedElements name="Author">
    <!-- Simple attribute -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference (e.g., mentor) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 2 -->
  <ownedElements name="Publisher">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="publishedBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>