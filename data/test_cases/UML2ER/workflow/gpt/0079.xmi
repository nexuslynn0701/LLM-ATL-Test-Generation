<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="LibrarySystem">
  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- primitive attribute with primitiveType defined -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute with primitiveType undefined -->
    <ownedProperty name="description" isContainment="false"/>
    <!-- strong reference to Author (containment = true) -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- weak reference to Publisher (containment = false) -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- primitive attribute with primitiveType defined -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- weak self-reference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- strong reference to Book (cyclic ref, containment = true) -->
    <ownedProperty name="debutBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- primitive attribute with primitiveType undefined -->
    <ownedProperty name="code" isContainment="false"/>
    <!-- strong reference to Book (containment = true) -->
    <ownedProperty name="featuredBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: EBook extends Book and Publisher (multiple inheritance) -->
  <ownedElements name="EBook" superClasses="//@ownedElements.0 //@ownedElements.2">
    <!-- primitive attribute with primitiveType defined -->
    <ownedProperty name="fileFormat" primitiveType="String" isContainment="false"/>
    <!-- strong reference to Author (containment = true) -->
    <ownedProperty name="uploader" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>