<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestPkg_Main">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- primitive attribute with explicit type -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- primitive attribute without primitiveType (will become NoType) -->
    <ownedProperty name="nickname" isContainment="false"/>
    <!-- weak reference to Address -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- strong reference to Company -->
    <ownedProperty name="employer" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- primitive attribute with explicit type -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute with different type -->
    <ownedProperty name="zipCode" primitiveType="Integer" isContainment="false"/>
    <!-- strong reference to Country -->
    <ownedProperty name="country" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Company -->
  <ownedElements name="Company">
    <!-- primitive attribute without primitiveType -->
    <ownedProperty name="name" isContainment="false"/>
    <!-- weak reference to Person (non-containment) -->
    <ownedProperty name="ceo" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Country -->
  <ownedElements name="Country">
    <!-- primitive attribute with explicit type -->
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>