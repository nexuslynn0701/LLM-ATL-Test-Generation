<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="banking_system">
  <!-- Class 0 -->
  <ownedElements name="Customer">
    <!-- primitive attribute with primitiveType -->
    <ownedProperty name="customerId" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without primitiveType (will yield NoType) -->
    <ownedProperty name="nickname" isContainment="true"/>
    <!-- weak reference to Account -->
    <ownedProperty name="accounts" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 1 -->
  <ownedElements name="Account">
    <!-- primitive attribute with primitiveType -->
    <ownedProperty name="balance" primitiveType="Double" isContainment="false"/>
    <!-- strong reference to Transaction -->
    <ownedProperty name="transactions" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 2 -->
  <ownedElements name="Transaction" superClasses="//@ownedElements.3">
    <!-- primitive attribute, no complexType -->
    <ownedProperty name="amount" primitiveType="Double" isContainment="false"/>
    <!-- weak reference back to Account -->
    <ownedProperty name="account" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: superclass for Transaction -->
  <ownedElements name="AuditedEntity">
    <!-- primitive attribute -->
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>