<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="pkg_main">
  <!-- Base class: Person -->
  <ownedElements name="Person">
    <!-- Attribute with primitiveType defined (will become Attribute with that type) -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (will become Attribute with type 'NoType') -->
    <ownedProperty name="nickname" isContainment="false"/>
    <!-- Strong reference to Address (containment=true) -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Company (containment=false) -->
    <ownedProperty name="employer" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class: Address -->
  <ownedElements name="Address">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="postalCode" isContainment="false"/>
    <!-- Strong self-reference (containment=true) -->
    <ownedProperty name="parentAddress" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class: Company -->
  <ownedElements name="Company">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Person (containment=false) -->
    <ownedProperty name="ceo" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Subclass: Employee extends Person and Company (multiple inheritance) -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0 //@ownedElements.2">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="salary" primitiveType="Float" isContainment="false"/>
    <!-- Weak reference to Company (containment=false) -->
    <ownedProperty name="departmentCompany" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Strong reference to Address (containment=true) -->
    <ownedProperty name="officeAddress" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>