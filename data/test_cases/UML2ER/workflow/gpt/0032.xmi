<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="libraryModel">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="true"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="chapters" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Chapter" superClasses="//@ownedElements.3">
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="content" isContainment="true"/>
    <ownedProperty name="author" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>