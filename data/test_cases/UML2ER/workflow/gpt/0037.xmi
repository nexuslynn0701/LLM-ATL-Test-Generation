<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="business_model_pkg">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- complexType undefined, primitiveType undefined: will yield Attribute with NoType -->
    <ownedProperty name="metadata" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Company -->
  <ownedElements name="Company">
    <!-- Weak reference (non-containment) to Person -->
    <ownedProperty name="employees"
                   complexType="//@ownedElements.0"
                   isContainment="false"/>
    <!-- Strong reference (containment) to Department -->
    <ownedProperty name="departments"
                   complexType="//@ownedElements.2"
                   isContainment="true"/>
    <!-- Attribute with explicit primitiveType -->
    <ownedProperty name="registrationNumber"
                   primitiveType="Integer"
                   isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Department -->
  <ownedElements name="Department">
    <!-- Weak reference back to Company -->
    <ownedProperty name="parentCompany"
                   complexType="//@ownedElements.1"
                   isContainment="false"/>
    <!-- Strong self-reference (containment) -->
    <ownedProperty name="subDepartments"
                   complexType="//@ownedElements.2"
                   isContainment="true"/>
    <!-- Attribute with primitiveType undefined but complexType undefined: NoType -->
    <ownedProperty name="notes"
                   isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Project (with superClasses Person and Company) -->
  <ownedElements name="Project"
                 superClasses="//@ownedElements.0 //@ownedElements.1">
    <!-- Attribute with primitiveType String -->
    <ownedProperty name="code"
                   primitiveType="String"
                   isContainment="false"/>
    <!-- Weak reference to Department -->
    <ownedProperty name="ownerDepartment"
                   complexType="//@ownedElements.2"
                   isContainment="false"/>
    <!-- Strong reference to Person (containment) -->
    <ownedProperty name="lead"
                   complexType="//@ownedElements.0"
                   isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>