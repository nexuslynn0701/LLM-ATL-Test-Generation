<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="libraryModel">
  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitive type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitive type (will become NoType) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Weak reference to Author (non-containment, complexType set) -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Author (containment, complexType set) -->
    <ownedProperty name="coAuthor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitive type -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitive type -->
    <ownedProperty name="age" isContainment="false"/>
    <!-- Weak self-reference (non-containment, complexType set) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Book (containment, complexType set) -->
    <ownedProperty name="writtenBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher, subclass of Author -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.1">
    <!-- Attribute with primitive type -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book (non-containment, complexType set) -->
    <ownedProperty name="publishedBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>