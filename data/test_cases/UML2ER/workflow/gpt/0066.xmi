<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="LibrarySystem">
  <!-- Class 0 -->
  <ownedElements name="Book">
    <!-- primitive attribute with explicit type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without primitiveType (will yield NoType) -->
    <ownedProperty name="code" isContainment="false"/>
    <!-- reference to Author, non-containment => WeakReference -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- reference to Author, containment => StrongReference -->
    <ownedProperty name="coAuthor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 1 -->
  <ownedElements name="Author">
    <!-- primitive attribute with explicit type -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- reference to Publisher, non-containment => WeakReference -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 2 -->
  <ownedElements name="Publisher">
    <!-- primitive attribute without primitiveType (will yield NoType) -->
    <ownedProperty name="label" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>