<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="TestPkg_Main">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- primitive attribute with undefined primitiveType -->
    <ownedProperty name="nickname" isContainment="true"/>
    <!-- weak reference to Address (class 1) -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- strong reference to Department (class 2) -->
    <ownedProperty name="department" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="street" primitiveType="String" isContainment="true"/>
    <!-- weak reference back to Person (class 0) -->
    <ownedProperty name="resident" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Department (subclass of Organization and Company) -->
  <ownedElements name="Department" superClasses="//@ownedElements.3 //@ownedElements.4">
    <!-- primitive attribute with undefined primitiveType -->
    <ownedProperty name="code" isContainment="false"/>
    <!-- strong reference to Company (class 4) -->
    <ownedProperty name="company" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Organization (superclass) -->
  <ownedElements name="Organization">
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="orgName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Company (superclass) -->
  <ownedElements name="Company">
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="compName" primitiveType="String" isContainment="true"/>
    <!-- weak reference to Department (class 2) -->
    <ownedProperty name="mainDepartment" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>