<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestPkg_Main">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (will become NoType) -->
    <ownedProperty name="nickname" isContainment="false"/>
    <!-- Weak reference to Address (non-containment complexType) -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Company (containment complexType) -->
    <ownedProperty name="employer" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="zipCode" isContainment="false"/>
    <!-- Weak reference to Country (non-containment complexType) -->
    <ownedProperty name="country" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Company -->
  <ownedElements name="Company">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Address (containment complexType) -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Country -->
  <ownedElements name="Country">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="isoCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>