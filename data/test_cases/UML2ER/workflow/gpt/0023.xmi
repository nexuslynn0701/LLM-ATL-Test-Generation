<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestModelPkg">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- primitive attribute with primitiveType defined -->
    <ownedProperty name="personId" primitiveType="Integer" isContainment="false"/>
    <!-- primitive attribute with primitiveType undefined (omitted) -->
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- containment reference to Person (complexType set, isContainment=true) -->
    <ownedProperty name="owner" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- primitive attribute with primitiveType defined -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Order -->
  <ownedElements name="Order" superClasses="//@ownedElements.0">
    <!-- non-containment reference to Person (complexType set, isContainment=false) -->
    <ownedProperty name="customer" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- primitive attribute with primitiveType undefined (omitted) -->
    <ownedProperty name="description" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>