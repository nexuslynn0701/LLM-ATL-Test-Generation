<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="modelPkg">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute property: primitive only, no complexType -->
    <ownedProperty name="personId" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute property without primitiveType (will map to NoType) -->
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Attribute property: primitive only -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Strong reference (containment=true) to Person -->
    <ownedProperty name="owner" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Company -->
  <ownedElements name="Company">
    <!-- Weak reference (containment=false) to Address -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Attribute property: primitive only -->
    <ownedProperty name="registrationCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Employee, subclass of Person and Company -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0 //@ownedElements.2">
    <!-- Strong reference (containment=true) to Address -->
    <ownedProperty name="workAddress" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference (containment=false) to Company -->
    <ownedProperty name="employer" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Attribute property without primitiveType -->
    <ownedProperty name="internalCode" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>