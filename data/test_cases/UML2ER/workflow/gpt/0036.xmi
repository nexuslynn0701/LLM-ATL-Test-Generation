<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestPkg_Main">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- primitive attribute, no complexType -> Attribute rule, type given -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- primitive attribute, no complexType, primitiveType undefined -> Attribute rule, NoType -->
    <ownedProperty name="nickname" isContainment="false"/>
    <!-- reference, complexType = Employee, non-containment -> WeakReference -->
    <ownedProperty name="worksAs" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- reference, complexType = Address, containment -> StrongReference -->
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Employee, extends Person -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <!-- primitive attribute, no complexType -> Attribute rule -->
    <ownedProperty name="salary" primitiveType="Float" isContainment="false"/>
    <!-- reference, complexType = Department, non-containment -> WeakReference -->
    <ownedProperty name="department" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Address -->
  <ownedElements name="Address">
    <!-- primitive attribute, no complexType -> Attribute rule -->
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Department, extends Person and Employee -->
  <ownedElements name="Department" superClasses="//@ownedElements.0 //@ownedElements.1">
    <!-- reference, complexType = Employee, containment -> StrongReference -->
    <ownedProperty name="manager" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- reference, complexType = Employee, non-containment -> WeakReference -->
    <ownedProperty name="staff" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>