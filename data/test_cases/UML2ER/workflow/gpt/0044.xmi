<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="TestModel">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute-only property, primitiveType defined -->
    <ownedProperty name="personId" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute-only property, primitiveType undefined -->
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>
  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Attribute-only property, primitiveType defined -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Attribute-only property, primitiveType undefined -->
    <ownedProperty name="zipCode" isContainment="false"/>
  </ownedElements>
  <!-- Class 2: Company -->
  <ownedElements name="Company">
    <!-- Weak reference (non-containment) to Person -->
    <ownedProperty name="employees" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference (containment) to Address -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>