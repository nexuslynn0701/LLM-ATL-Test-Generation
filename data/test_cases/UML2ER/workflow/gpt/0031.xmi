<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestPkg_Main">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute with undefined primitiveType -->
    <ownedProperty name="age" isContainment="false"/>
    <!-- weak reference (non-containment) to Address -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- strong reference (containment) to Order -->
    <ownedProperty name="orders" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Company, subclass of Person -->
  <ownedElements name="Company" superClasses="//@ownedElements.0">
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- weak reference (non-containment) to Address -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- strong reference (containment) to Person -->
    <ownedProperty name="employees" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Address -->
  <ownedElements name="Address">
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute with undefined primitiveType -->
    <ownedProperty name="zipCode" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Order -->
  <ownedElements name="Order" superClasses="//@ownedElements.1">
    <!-- primitive attribute with explicit primitiveType -->
    <ownedProperty name="orderNumber" primitiveType="Integer" isContainment="false"/>
    <!-- strong reference (containment) to Person -->
    <ownedProperty name="customer" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>