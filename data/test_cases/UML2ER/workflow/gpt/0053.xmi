<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestPkg">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute-only property with primitive type -->
    <ownedProperty name="personId" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute-only property without primitive type (NoType in target) -->
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Attribute-only property with primitive type -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Person (containment = true) -->
    <ownedProperty name="resident"
                   complexType="//@ownedElements.0"
                   isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Company, subclass of Person and Address -->
  <ownedElements name="Company" superClasses="//@ownedElements.0 //@ownedElements.1">
    <!-- Weak reference to Address (containment = false) -->
    <ownedProperty name="headquarters"
                   complexType="//@ownedElements.1"
                   isContainment="false"/>
    <!-- Another attribute-only property with primitive type -->
    <ownedProperty name="registrationCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>