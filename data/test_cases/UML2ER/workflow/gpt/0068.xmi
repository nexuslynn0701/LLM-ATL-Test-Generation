<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="TestPkg_Main">
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="address" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="salary" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>