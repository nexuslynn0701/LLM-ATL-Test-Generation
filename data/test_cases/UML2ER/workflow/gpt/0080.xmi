<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" isContainment="false"/>
    <ownedProperty name="primaryBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contactEmail" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headquartersCity" isContainment="false"/>
    <ownedProperty name="featuredBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>