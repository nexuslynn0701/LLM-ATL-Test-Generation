<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="uml2er_test_pkg">
  <!-- Class 0: Person (no properties) -->
  <ownedElements name="Person"/>
  <!-- Class 1: Address (primitive-only property, with primitiveType) -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Class 2: Company (primitive-only property, primitiveType undefined) -->
  <ownedElements name="Company">
    <ownedProperty name="founded" isContainment="false"/>
  </ownedElements>
  <!-- Class 3: Employee (weak and strong references, plus primitive attribute) -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <!-- Weak reference: complexType set, isContainment=false -->
    <ownedProperty name="worksAt" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Strong reference: complexType set, isContainment=true -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Attribute: no complexType, primitiveType defined -->
    <ownedProperty name="salary" primitiveType="Float" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>