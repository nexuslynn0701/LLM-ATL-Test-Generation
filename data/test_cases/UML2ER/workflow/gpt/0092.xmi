<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestModelPkg">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute with primitiveType, no complexType (Attributes rule) -->
    <ownedProperty name="personId" primitiveType="String" isContainment="false"/>
    <!-- Attribute with undefined primitiveType (NoType case) -->
    <ownedProperty name="birthDate" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- WeakReference: complexType set, isContainment=false -->
    <ownedProperty name="resident"
                   complexType="//@ownedElements.0"
                   isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Company -->
  <ownedElements name="Company">
    <!-- StrongReference: complexType set, isContainment=true -->
    <ownedProperty name="headquarters"
                   complexType="//@ownedElements.1"
                   isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>