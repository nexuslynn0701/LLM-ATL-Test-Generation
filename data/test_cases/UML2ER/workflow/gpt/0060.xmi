<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestPkg">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Weak reference to Person (complexType, isContainment=false) -->
    <ownedProperty name="resident"
                   complexType="//@ownedElements.0"
                   isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Company -->
  <ownedElements name="Company">
    <!-- Strong reference to Address (complexType, isContainment=true) -->
    <ownedProperty name="headquarters"
                   complexType="//@ownedElements.1"
                   isContainment="true"/>
    <!-- Attribute with primitiveType explicitly empty string -->
    <ownedProperty name="code" primitiveType="" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>