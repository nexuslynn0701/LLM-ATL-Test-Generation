<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="details" isContainment="true" complexType="//@ownedElements.3"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="biography" primitiveType="Text" isContainment="false"/>
    <ownedProperty name="books" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publishedBooks" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="BookDetails">
    <ownedProperty name="summary" primitiveType="Text" isContainment="false"/>
    <ownedProperty name="pageCount" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="publisher" isContainment="true" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="Member" superClasses="//@ownedElements.4">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="registeredAt" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="borrowedBooks" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="Person">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contactInfo" isContainment="true" complexType="//@ownedElements.6"/>
  </ownedElements>
  <ownedElements name="ContactInfo">
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="phone" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Librarian" superClasses="//@ownedElements.4">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedMembers" isContainment="true" complexType="//@ownedElements.4"/>
    <ownedProperty name="assignedBranch" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>