<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="erpTestPkg">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (will yield NoType) -->
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Department -->
  <ownedElements name="Department">
    <!-- WeakReference: complexType set, isContainment=false -->
    <ownedProperty name="manager" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- StrongReference: complexType set, isContainment=true -->
    <ownedProperty name="employees" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Project, subclass of Department -->
  <ownedElements name="Project" superClasses="//@ownedElements.1">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="budget" primitiveType="Float" isContainment="false"/>
    <!-- WeakReference to Department -->
    <ownedProperty name="owningDepartment" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- StrongReference to Project itself (self-reference containment) -->
    <ownedProperty name="subProjects" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>