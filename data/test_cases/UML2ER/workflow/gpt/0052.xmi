<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestPkg_Main">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute property with primitiveType defined (Attribute + Property + NamedElement) -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute property with primitiveType undefined (will yield NoType) -->
    <ownedProperty name="nickname" isContainment="false"/>
    <!-- Weak reference to Address (complexType, isContainment=false) -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Order (complexType, isContainment=true) -->
    <ownedProperty name="orders" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Attribute property with primitiveType defined -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Attribute property with primitiveType undefined -->
    <ownedProperty name="zipcode" isContainment="false"/>
    <!-- Weak reference back to Person (non-containment reference) -->
    <ownedProperty name="resident" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Order, subclass of Person and Address to exercise superClasses reference list -->
  <ownedElements name="Order" superClasses="//@ownedElements.0 //@ownedElements.1">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="totalAmount" primitiveType="Float" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="notes" isContainment="false"/>
    <!-- Strong reference to Address (containment reference) -->
    <ownedProperty name="shippingAddress" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>