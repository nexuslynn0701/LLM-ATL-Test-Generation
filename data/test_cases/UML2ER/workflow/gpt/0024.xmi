<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestPkg_ComplexRefs">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="personId" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (tests NoType) -->
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="zipcode" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Company -->
  <ownedElements name="Company">
    <!-- Weak reference (non-containment) to Person -->
    <ownedProperty name="employees"
                   complexType="//@ownedElements.0"
                   isContainment="false"/>
    <!-- Strong reference (containment) to Address -->
    <ownedProperty name="headOffice"
                   complexType="//@ownedElements.1"
                   isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Department, with multiple superClasses -->
  <ownedElements name="Department" superClasses="//@ownedElements.0 //@ownedElements.2">
    <!-- Weak reference to Company -->
    <ownedProperty name="parentCompany"
                   complexType="//@ownedElements.2"
                   isContainment="false"/>
    <!-- Strong reference to Person -->
    <ownedProperty name="manager"
                   complexType="//@ownedElements.0"
                   isContainment="true"/>
    <!-- Primitive attribute -->
    <ownedProperty name="budget" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>