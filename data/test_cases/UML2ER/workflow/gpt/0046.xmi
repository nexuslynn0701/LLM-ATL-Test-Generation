<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="uml2er_test_pkg">
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Order">
    <ownedProperty name="orderNumber" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="totalAmount" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="customer" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="shippingAddress" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="LineItem" superClasses="//@ownedElements.3 //@ownedElements.0">
    <ownedProperty name="quantity" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="product" primitiveType="" isContainment="false"/>
    <ownedProperty name="order" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>