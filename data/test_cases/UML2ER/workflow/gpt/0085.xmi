<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="TestPkg_Main">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="personId" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (omitted) -->
    <ownedProperty name="nickname" isContainment="false"/>
    <!-- Weak reference to Address (Class 1), non-containment -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Company (Class 2), containment -->
    <ownedProperty name="employer" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="street" primitiveType="String" isContainment="true"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="postalCode" isContainment="false"/>
    <!-- Weak reference to Person (Class 0), non-containment -->
    <ownedProperty name="resident" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Company -->
  <ownedElements name="Company">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Person (Class 0), containment -->
    <ownedProperty name="ceo" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Weak reference to Address (Class 1), non-containment -->
    <ownedProperty name="hqAddress" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>