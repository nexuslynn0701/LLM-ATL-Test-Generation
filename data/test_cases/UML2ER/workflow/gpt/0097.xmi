<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="model_pkg">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- primitive attribute, no complexType: triggers Attributes with explicit primitiveType -->
    <ownedProperty name="personId" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute with undefined primitiveType: triggers Attributes with NoType -->
    <ownedProperty name="nickname" isContainment="true"/>
    <!-- reference to Address, non-containment: triggers WeakReferences -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- reference to Department, containment: triggers StrongReferences -->
    <ownedProperty name="department" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Employee (subclass of Person) -->
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <!-- primitive attribute, explicit primitiveType -->
    <ownedProperty name="salary" primitiveType="Integer" isContainment="false"/>
    <!-- reference to Project, non-containment: triggers WeakReferences -->
    <ownedProperty name="project" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Address -->
  <ownedElements name="Address">
    <!-- primitive attribute -->
    <ownedProperty name="street" primitiveType="String" isContainment="true"/>
    <!-- primitive attribute with undefined primitiveType -->
    <ownedProperty name="zipCode" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Department -->
  <ownedElements name="Department">
    <!-- primitive attribute -->
    <ownedProperty name="deptName" primitiveType="String" isContainment="true"/>
    <!-- reference to Employee, non-containment -->
    <ownedProperty name="manager" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Project -->
  <ownedElements name="Project">
    <!-- primitive attribute -->
    <ownedProperty name="projectCode" primitiveType="String" isContainment="true"/>
    <!-- reference to Employee, containment: triggers StrongReferences -->
    <ownedProperty name="teamLead" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>