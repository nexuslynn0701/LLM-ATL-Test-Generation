<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="TestPkg_Main">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Primitive attribute with explicit type -->
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <!-- Primitive attribute with undefined primitiveType -->
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Reference, non-containment (WeakReference) to Person -->
    <ownedProperty name="resident" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Primitive attribute -->
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Company, subclass of Person -->
  <ownedElements name="Company" superClasses="//@ownedElements.0">
    <!-- Containment reference (StrongReference) to Address -->
    <ownedProperty name="hqAddress" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Primitive attribute without primitiveType -->
    <ownedProperty name="code" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>