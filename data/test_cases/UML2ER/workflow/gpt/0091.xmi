<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="LibrarySystem">
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="details" isContainment="true" complexType="//@ownedElements.3"/>
  </ownedElements>
  <ownedElements name="Member">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBook" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="Librarian" superClasses="//@ownedElements.1">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedBranch" isContainment="true" complexType="//@ownedElements.4"/>
  </ownedElements>
  <ownedElements name="BookDetails">
    <ownedProperty name="summary" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Branch">
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headLibrarian" isContainment="false" complexType="//@ownedElements.2"/>
  </ownedElements>
</SimpleUml:Package>