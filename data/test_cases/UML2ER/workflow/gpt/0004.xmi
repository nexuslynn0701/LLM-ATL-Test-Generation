<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="ModelWithAllFeatures">

  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Attribute with undefined primitiveType (will yield NoType) -->
    <ownedProperty name="metadata" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Weak reference to Person (complexType, isContainment=false) -->
    <ownedProperty name="resident" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference to Person (complexType, isContainment=true) -->
    <ownedProperty name="owner" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Attribute with primitiveType and no complexType -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Company, subclass of Person -->
  <ownedElements name="Company" superClasses="//@ownedElements.0">
    <!-- Weak reference to Address -->
    <ownedProperty name="headOffice" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Address -->
    <ownedProperty name="registeredOffice" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="registrationCode" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>