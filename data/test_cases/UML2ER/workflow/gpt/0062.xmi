<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
                   xmlns:xmi="http://www.omg.org/XMI"
                   xmlns:SimpleUml="http://SimpleUML"
                   name="ModelPkg">
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Order" superClasses="//@ownedElements.0">
    <ownedProperty name="orderNumber" primitiveType="Int" isContainment="false"/>
    <ownedProperty name="customer" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="shippingAddress" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Product">
    <ownedProperty name="sku" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>