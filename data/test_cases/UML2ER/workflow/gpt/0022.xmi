<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="TestModelPkg">

  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute-only properties (complexType undefined) -->
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="true"/>
    <!-- Attribute with undefined primitiveType (will become NoType) -->
    <ownedProperty name="identifier" isContainment="false"/>
    <!-- Reference properties (complexType defined) -->
    <ownedProperty name="spouse" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="bestFriend" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Only attributes -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Company -->
  <ownedElements name="Company">
    <!-- Mixed attributes and references -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Reference to Person, non-containment (WeakReference) -->
    <ownedProperty name="ceo" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Reference to Address, containment (StrongReference) -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Department, with inheritance -->
  <ownedElements name="Department" superClasses="//@ownedElements.2">
    <!-- Attribute and references -->
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <!-- Non-containment reference to Company (WeakReference) -->
    <ownedProperty name="parentCompany" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Containment reference to Person (StrongReference) -->
    <ownedProperty name="manager" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>