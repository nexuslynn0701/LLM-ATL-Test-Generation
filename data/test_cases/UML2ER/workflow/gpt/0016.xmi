<?xml version="1.0" encoding="ASCII"?>
<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="TestPkg_Main">
  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="personId" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (will become NoType) -->
    <ownedProperty name="nickname" isContainment="false"/>
    <!-- Weak reference to Address (non-containment complexType) -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Company (containment complexType) -->
    <ownedProperty name="employer" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Address -->
  <ownedElements name="Address">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="postalCode" isContainment="false"/>
    <!-- Weak self-reference (non-containment complexType to Address) -->
    <ownedProperty name="previousAddress" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Company -->
  <ownedElements name="Company">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined -->
    <ownedProperty name="foundedOn" isContainment="false"/>
    <!-- Strong reference to Person (containment complexType) -->
    <ownedProperty name="founder" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>