<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversityModel">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String"/>
    <ownedProperty name="age" primitiveType="Integer"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="enrolledCourses" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="title" primitiveType="String"/>
    <ownedProperty name="credits" primitiveType="Integer"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String"/>
    <ownedProperty name="head" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>