<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversityModel">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String"/>
    <ownedProperty name="age" primitiveType="Integer"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="enrolledCourses" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String"/>
    <ownedProperty name="department" primitiveType="String"/>
    <ownedProperty name="advisees" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String"/>
    <ownedProperty name="credits" primitiveType="Integer"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="syllabus" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Syllabus">
    <ownedProperty name="content" primitiveType="String"/>
    <ownedProperty name="version" primitiveType="String"/>
  </ownedElements>
</SimpleUml:Package>