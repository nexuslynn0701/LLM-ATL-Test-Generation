<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversityModel">
  <ownedElements name="Person"/>
  <ownedElements name="Student" superClasses="//@ownedElements.0"/>
  <ownedElements name="Course"/>
  <ownedElements name="Department"/>
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Enrollment">
    <ownedProperty name="grade" primitiveType="String" isContainment="false"/>
    <ownedProperty name="student" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="course" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>