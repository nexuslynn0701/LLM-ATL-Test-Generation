<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversityModel">
  <ownedElements name="Person"/>
  <ownedElements name="Student" superClasses="//@ownedElements.0"/>
  <ownedElements name="Course"/>
  <ownedElements name="Department"/>
  <ownedElements name="Professor" superClasses="//@ownedElements.0"/>
  <ownedElements name="Enrollment">
    <ownedProperty name="student" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="course" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="grade" primitiveType="String" isContainment="false"/>
    <ownedProperty name="semester" primitiveType="" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="publisher" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Library">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.7" isContainment="true"/>
    <ownedProperty name="location" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>