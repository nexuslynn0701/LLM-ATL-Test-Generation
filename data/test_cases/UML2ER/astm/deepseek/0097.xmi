<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySchema">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="advisor" isContainment="false" complexType="//@ownedElements.2"/>
    <ownedProperty name="courses" isContainment="true" complexType="//@ownedElements.3"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="instructor" isContainment="false" complexType="//@ownedElements.2"/>
    <ownedProperty name="enrolledStudents" isContainment="true" complexType="//@ownedElements.1"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" isContainment="false" complexType="//@ownedElements.2"/>
    <ownedProperty name="courses" isContainment="true" complexType="//@ownedElements.3"/>
    <ownedProperty name="budget" primitiveType="Float" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>