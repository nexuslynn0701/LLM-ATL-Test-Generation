<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="coordinator" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="syllabus" primitiveType="Document" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Enrollment">
    <ownedProperty name="student" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="course" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="grade" primitiveType="String" isContainment="false"/>
    <ownedProperty name="enrollmentDate" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="deadline" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="supervisor" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="deliverable" primitiveType="File" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>