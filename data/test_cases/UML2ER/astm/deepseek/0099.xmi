<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="enrolledCourses" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="teaches" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="syllabus" primitiveType="Text" isContainment="false"/>
    <ownedProperty name="assignments" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Assignment">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="maxScore" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="submissions" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Submission">
    <ownedProperty name="content" primitiveType="Text" isContainment="false"/>
    <ownedProperty name="grade" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="submittedBy" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>