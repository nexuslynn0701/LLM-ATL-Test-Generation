<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="department" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" isContainment="false" complexType="//@ownedElements.0"/>
    <ownedProperty name="salary" primitiveType="Float" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="deptCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="head" isContainment="false" complexType="//@ownedElements.1"/>
    <ownedProperty name="members" isContainment="true" complexType="//@ownedElements.1"/>
    <ownedProperty name="subDepartments" isContainment="true" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="projectName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="deadline" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="lead" isContainment="false" complexType="//@ownedElements.1"/>
    <ownedProperty name="tasks" isContainment="true" complexType="//@ownedElements.4"/>
  </ownedElements>
  <ownedElements name="Task">
    <ownedProperty name="taskName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="Text" isContainment="false"/>
    <ownedProperty name="assignedTo" isContainment="false" complexType="//@ownedElements.1"/>
    <ownedProperty name="subtasks" isContainment="true" complexType="//@ownedElements.4"/>
    <ownedProperty name="status" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Contact">
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="phone" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="preferredContact" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
</SimpleUml:Package>