  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="courseCode" primitiveType="String" complexType="" isContainment="false"/>
    <ownedProperty name="offeredBy" primitiveType="" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="syllabus" primitiveType="Document" complexType="" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Lab" superClasses="//@ownedElements.2">
    <ownedProperty name="capacity" primitiveType="Integer" complexType="" isContainment="false"/>
    <ownedProperty name="belongsTo" primitiveType="" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>