<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="budget" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="tasks" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Task">
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="deadline" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="assignedTo" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="salary" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>