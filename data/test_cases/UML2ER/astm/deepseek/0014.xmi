<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="department" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="projectName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="tasks" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="lead" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Task">
    <ownedProperty name="taskName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignedTo" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Document">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="content" primitiveType="Text" isContainment="false"/>
    <ownedProperty name="attachments" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Attachment">
    <ownedProperty name="fileName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fileSize" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>