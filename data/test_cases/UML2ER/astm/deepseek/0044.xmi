<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="deptName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="worksIn" isContainment="true" complexType="//@ownedElements.1"/>
    <ownedProperty name="subordinates" isContainment="false" complexType="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="projectName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="lead" isContainment="true" complexType="//@ownedElements.2"/>
  </ownedElements>
</SimpleUml:Package>