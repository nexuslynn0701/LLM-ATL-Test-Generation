<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversityModel">
  <ownedElements name="Person"/>
  <ownedElements name="Student" superClasses="//@ownedElements.0"/>
  <ownedElements name="Professor" superClasses="//@ownedElements.0"/>
  <ownedElements name="Course">
    <ownedProperty name="courseName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="assignments" isContainment="true"/>
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department" superClasses="//@ownedElements.0">
    <ownedProperty name="head" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="offering" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="establishedYear" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ResearchProject">
    <ownedProperty name="projectName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="Float" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>