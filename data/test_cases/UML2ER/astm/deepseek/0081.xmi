<?xml version="1.0" encoding="UTF-8"?>
<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="University">
  <ownedElements name="Person"/>
  <ownedElements name="Student" superClasses="//@ownedElements.0"/>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="string" isContainment="false"/>
    <ownedProperty name="city" primitiveType="string" isContainment="false"/>
    <ownedProperty name="country" primitiveType="string" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="string" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="string" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="title" primitiveType="string" isContainment="false"/>
    <ownedProperty name="credits" primitiveType="int" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="materials" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Material">
    <ownedProperty name="description" primitiveType="string" isContainment="false"/>
    <ownedProperty name="url" primitiveType="string" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Professor" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="string" isContainment="false"/>
    <ownedProperty name="office" primitiveType="string" isContainment="false"/>
    <ownedProperty name="advisedStudents" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="managedDepartment" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="GraduateStudent" superClasses="//@ownedElements.1">
    <ownedProperty name="thesisTopic" primitiveType="string" isContainment="false"/>
    <ownedProperty name="supervisor" complexType="//@ownedElements.6" isContainment="false"/>
    <ownedProperty name="researchProject" complexType="//@ownedElements.8" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="title" primitiveType="string" isContainment="false"/>
    <ownedProperty name="budget" primitiveType="double" isContainment="false"/>
    <ownedProperty name="teamMember" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="deliverables" complexType="//@ownedElements.9" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Deliverable">
    <ownedProperty name="name" primitiveType="string" isContainment="false"/>
    <ownedProperty name="deadline" primitiveType="date" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>