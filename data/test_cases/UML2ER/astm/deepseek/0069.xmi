<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversitySystem">
  <ownedElements name="Department" superClasses="">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="parentDept" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="subDepartments" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="">
    <ownedProperty name="empId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Manager" superClasses="//@ownedElements.1">
    <ownedProperty name="teamSize" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="managedDepartment" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="assistant" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Project" superClasses="">
    <ownedProperty name="budget" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="tasks" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Task" superClasses="">
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignee" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="subtasks" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>