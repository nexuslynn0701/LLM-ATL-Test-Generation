<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversityModel">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="age" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="courses" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="enrollments" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Enrollment">
    <ownedProperty name="student" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="courseRef" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="grade" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="advisor" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="transcript" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Transcript">
    <ownedProperty name="entries" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>
  <ownedElements name="TranscriptEntry">
    <ownedProperty name="courseTaken" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="finalGrade" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>