<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="UniversityModel">
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="staff" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Course">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="instructor" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="prerequisites" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <ownedProperty name="studentId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="enrolledCourses" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>