<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with no primitiveType (to trigger 'NoType') -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author, superclass of Contributor -->
  <ownedElements name="Author">
    <!-- Attribute with primitive type -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Book (bidirectional-ish) -->
    <ownedProperty name="primaryWork" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher, superclass of Imprint -->
  <ownedElements name="Publisher">
    <!-- Attribute with primitive type -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Address -->
    <ownedProperty name="location" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Address, only primitive attributes -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Contributor, subclass of Author and Book (multiple inheritance) -->
  <ownedElements name="Contributor" superClasses="//@ownedElements.1 //@ownedElements.0">
    <!-- Attribute with primitive type -->
    <ownedProperty name="role" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="contributedTo" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 5: Imprint, subclass of Publisher -->
  <ownedElements name="Imprint" superClasses="//@ownedElements.2">
    <!-- Attribute with primitive type -->
    <ownedProperty name="imprintCode" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Publisher (its parent) -->
    <ownedProperty name="parentPublisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>