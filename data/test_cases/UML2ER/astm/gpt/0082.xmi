<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Person -->
  <ownedElements name="Person">
    <!-- Attribute: primitive with type -->
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <!-- Attribute: primitive without type (NoType) -->
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Book -->
  <ownedElements name="Book">
    <!-- Attribute: primitive with type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak reference to Library -->
    <ownedProperty name="storedIn" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Author, subclass of Person -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <!-- Weak reference to Book (non-containment) -->
    <ownedProperty name="writes" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Library -->
  <ownedElements name="Library">
    <!-- Attribute: primitive with type -->
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Book (containment) -->
    <ownedProperty name="collection" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Strong self-reference (containment) -->
    <ownedProperty name="branch" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 4: Borrower, subclass of Person -->
  <ownedElements name="Borrower" superClasses="//@ownedElements.0">
    <!-- Weak reference to Book -->
    <ownedProperty name="borrowedBook" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>