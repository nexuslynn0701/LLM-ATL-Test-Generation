<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="Book">
    <!-- primitive attribute with type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without type (NoType case) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- weak reference to Category -->
    <ownedProperty name="category" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Author">
    <!-- primitive attribute with type -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- strong self-reference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Category">
    <!-- primitive attribute with type -->
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <!-- weak reference to superCategory -->
    <ownedProperty name="superCategory" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 3, subclass of Book and Author -->
  <ownedElements name="EBook" superClasses="//@ownedElements.0 //@ownedElements.1">
    <!-- primitive attribute without type (NoType) -->
    <ownedProperty name="fileFormat" isContainment="false"/>
    <!-- strong reference to Category -->
    <ownedProperty name="primaryCategory" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- weak reference to Book (base work) -->
    <ownedProperty name="baseWork" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>