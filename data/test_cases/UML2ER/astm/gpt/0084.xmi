<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <!-- 0 -->
  <ownedElements name="Item">
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="EBook" superClasses="//@ownedElements.1">
    <ownedProperty name="fileSizeMB" primitiveType="Double" isContainment="false"/>
    <ownedProperty name="downloadUrl" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- strong reference (containment = true) -->
    <ownedProperty name="membershipCard" complexType="//@ownedElements.7" isContainment="true"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Publisher">
    <ownedProperty name="publisherName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headquartersCity" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Loan">
    <!-- attribute without primitiveType and without complexType -> NoType -->
    <ownedProperty name="loanCode" isContainment="false"/>
    <!-- weak reference to Member -->
    <ownedProperty name="borrower" complexType="//@ownedElements.3" isContainment="false"/>
    <!-- weak reference to Item (supertype of Book/EBook) -->
    <ownedProperty name="loanedItem" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Reservation" superClasses="//@ownedElements.5">
    <!-- attribute with primitiveType -->
    <ownedProperty name="reservationDate" primitiveType="Date" isContainment="false"/>
    <!-- weak reference to Member -->
    <ownedProperty name="reservingMember" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="MembershipCard">
    <!-- attribute without primitiveType but no complexType -> NoType -->
    <ownedProperty name="barcode" isContainment="false"/>
    <!-- attribute with primitiveType -->
    <ownedProperty name="issueDate" primitiveType="Date" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>