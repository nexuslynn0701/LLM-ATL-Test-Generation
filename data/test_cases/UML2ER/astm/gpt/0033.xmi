<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="Item">
    <!-- Primitive attribute with type -->
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute without type -->
    <ownedProperty name="status" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <!-- Attribute with primitive type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Author">
    <!-- Attribute without primitive type -->
    <ownedProperty name="penName" isContainment="false"/>
    <!-- Strong self-reference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Publisher">
    <!-- Primitive attribute with type -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Address -->
    <ownedProperty name="location" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Address">
    <!-- Primitive attributes -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>