<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Item">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="chapters" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.5" isContainment="true"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Chapter">
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="heading" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Loan">
    <ownedProperty name="loanId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="startDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="loanedItem" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Reservation">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="requestDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="reservedBy" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="reservedBook" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Review">
    <ownedProperty name="rating" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="comment" primitiveType="String" isContainment="false"/>
    <ownedProperty name="reviewer" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="reviewedBook" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Shelf">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <ownedProperty name="storedBooks" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Librarian" superClasses="//@ownedElements.2">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedLoans" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>
  <ownedElements name="LibraryBranch">
    <ownedProperty name="branchName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="branchAddress" complexType="//@ownedElements.5" isContainment="true"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="staff" complexType="//@ownedElements.10" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>