<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- 0 -->
  <ownedElements name="Item">
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
    <ownedProperty name="metadata" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Author">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="homeLibrary" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Publisher">
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headquarters" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="DigitalItem" superClasses="//@ownedElements.0">
    <ownedProperty name="fileSizeMB" primitiveType="" isContainment="false"/>
    <ownedProperty name="downloadUrl" primitiveType="String" isContainment="false"/>
    <ownedProperty name="licensingOrg" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Library">
    <ownedProperty name="libraryName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="digitalCollection" complexType="//@ownedElements.5" isContainment="true"/>
    <ownedProperty name="partnerLibraries" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>