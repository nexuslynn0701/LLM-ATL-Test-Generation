<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="PublishingDomain">

  <!-- Index 0 -->
  <ownedElements name="Publication">
    <!-- Attribute with primitive type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="publicationId" isContainment="false"/>
    <!-- Strong reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Article" superClasses="//@ownedElements.0">
    <!-- Attribute with primitive type -->
    <ownedProperty name="pageCount" primitiveType="Integer" isContainment="false"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.3" isContainment="false"/>
    <!-- Strong reference to Review -->
    <ownedProperty name="review" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Publisher">
    <!-- Attribute with primitive type -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference -->
    <ownedProperty name="parentPublisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Author">
    <!-- Attribute with primitive type -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Publication (general relationship) -->
    <ownedProperty name="primaryPublication" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Review" superClasses="//@ownedElements.0">
    <!-- Attribute with primitive type -->
    <ownedProperty name="rating" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="comments" isContainment="false"/>
    <!-- Strong reference to Article -->
    <ownedProperty name="forArticle" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>