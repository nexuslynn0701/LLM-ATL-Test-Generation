<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="Publication">
    <ownedProperty name="pubId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="chapters" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="" isContainment="false"/>
    <ownedProperty name="address" primitiveType="AddressType" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Publisher">
    <ownedProperty name="pubCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.2">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedMembers" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="Chapter">
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="heading" primitiveType="String" isContainment="false"/>
    <ownedProperty name="subChapters" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- Index 6 -->
  <ownedElements name="LibraryBranch">
    <ownedProperty name="branchCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainLibrarian" complexType="//@ownedElements.4" isContainment="false"/>
    <ownedProperty name="inventory" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>