<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType or complexType -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Category -->
    <ownedProperty name="category" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference (non-containment) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Category -->
  <ownedElements name="Category">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference (containment) -->
    <ownedProperty name="subCategory" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Library, with multiple superClasses -->
  <ownedElements name="Library" superClasses="//@ownedElements.0 //@ownedElements.1">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Weak reference to Category -->
    <ownedProperty name="mainCategory" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>