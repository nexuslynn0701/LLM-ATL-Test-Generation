<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="EnterpriseModel">
  <ownedElements name="Department">
    <ownedProperty name="deptId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="head" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Person">
    <ownedProperty name="personId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.1">
    <ownedProperty name="salary" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="worksIn" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Contractor" superClasses="//@ownedElements.1">
    <ownedProperty name="contractId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignedDepartment" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="ownerDepartment" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="externalContributors" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Asset">
    <ownedProperty name="assetTag" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignedTo" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="storedIn" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Location">
    <ownedProperty name="locationCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Meeting">
    <ownedProperty name="subject" primitiveType="String" isContainment="false"/>
    <ownedProperty name="scheduledAt" primitiveType="String" isContainment="false"/>
    <ownedProperty name="room" complexType="//@ownedElements.6" isContainment="false"/>
    <ownedProperty name="host" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="participants" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Document">
    <ownedProperty name="docId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="relatedProject" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="ArchiveEntry">
    <ownedProperty name="archiveKey" isContainment="false"/>
    <ownedProperty name="linkedDocument" complexType="//@ownedElements.8" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>