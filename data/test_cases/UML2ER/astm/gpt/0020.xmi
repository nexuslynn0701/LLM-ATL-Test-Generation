<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitive type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (will become NoType) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Category -->
    <ownedProperty name="category" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author, superclass of Book -->
  <ownedElements name="Author">
    <!-- Attribute with primitive type -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book (non-containment) -->
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Category, superclass of Book and subClass of DomainConcept -->
  <ownedElements name="Category" superClasses="//@ownedElements.4">
    <!-- Attribute with primitive type -->
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference (containment) -->
    <ownedProperty name="subCategory" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: LibraryMember with multiple superclasses -->
  <ownedElements name="LibraryMember" superClasses="//@ownedElements.1 //@ownedElements.5">
    <!-- Attribute with primitive type -->
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <!-- Strong reference to Book -->
    <ownedProperty name="borrowedBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 4: DomainConcept, superclass of Category -->
  <ownedElements name="DomainConcept">
    <!-- Attribute with primitive type -->
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 5: Person, superclass of LibraryMember -->
  <ownedElements name="Person">
    <!-- Attribute without primitiveType (will become NoType) -->
    <ownedProperty name="identifier" isContainment="false"/>
    <!-- Weak reference to LibraryMember -->
    <ownedProperty name="asMember" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>