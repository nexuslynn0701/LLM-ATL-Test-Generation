<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <!-- Attribute with primitive type -->
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
    <!-- Reference, non-containment (WeakReference) -->
    <ownedProperty name="primaryBook" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Book">
    <!-- Attribute without primitiveType (will yield NoType) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Containment reference (StrongReference) -->
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Non-containment reference back to Book (WeakReference) -->
    <ownedProperty name="mainBook" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Library">
    <!-- Containment reference to Book (StrongReference) -->
    <ownedProperty name="collection" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Simple attribute -->
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>