<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- 0 -->
  <ownedElements name="Document">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publicationYear" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <!-- strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="false"/>
    <!-- attribute without primitiveType (NoType) -->
    <ownedProperty name="internalCode" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- weak back-reference to Book -->
    <ownedProperty name="booksWritten" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Publisher">
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- strong reference to Address -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <!-- attribute without primitiveType (NoType) -->
    <ownedProperty name="postalCode" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>