<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="User">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="userId" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Book">
    <!-- Strong reference to Author (index 2) -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak reference to User (index 0) -->
    <ownedProperty name="borrower" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Attribute with primitiveType -->
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Author">
    <!-- Strong self-containment reference -->
    <ownedProperty name="primaryAssistant" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak self-reference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.0">
    <!-- Weak reference to Book (index 1) -->
    <ownedProperty name="managedBook" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="officeLocation" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="AdminUser" superClasses="//@ownedElements.0 //@ownedElements.3">
    <!-- Strong reference to User (index 0) -->
    <ownedProperty name="managedUser" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Attribute with primitiveType -->
    <ownedProperty name="adminCode" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>