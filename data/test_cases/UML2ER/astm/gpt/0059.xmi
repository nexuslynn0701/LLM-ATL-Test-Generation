<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Library, with primitive attributes and strong/weak references -->
  <ownedElements name="Library">
    <!-- Primitive attribute with a type -->
    <ownedProperty name="libraryName" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute without a type (will map to NoType) -->
    <ownedProperty name="establishedYear" isContainment="false"/>
    <!-- Strong reference to Address (containment = true) -->
    <ownedProperty name="mainAddress" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak reference to Book (containment = false) -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Book, with attributes and references -->
  <ownedElements name="Book">
    <!-- Primitive attribute with a type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute without a type -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="primaryAuthor" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Address, only primitive attributes -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute without type -->
    <ownedProperty name="postalCode" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Author, with self-contained and cross references -->
  <ownedElements name="Author">
    <!-- Primitive attribute with type -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Address -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak self-reference (e.g., coAuthor) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Publisher, with superClasses and mixed properties -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.5">
    <!-- Primitive attribute with type -->
    <ownedProperty name="publisherName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Address -->
    <ownedProperty name="hqAddress" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 5: Organization, superclass of Publisher -->
  <ownedElements name="Organization">
    <!-- Primitive attribute with type -->
    <ownedProperty name="orgName" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute without type -->
    <ownedProperty name="registrationId" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>