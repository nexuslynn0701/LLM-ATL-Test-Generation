<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="Item">
    <!-- Primitive attribute with primitiveType set -->
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (should map to NoType) -->
    <ownedProperty name="status" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <!-- Primitive attribute -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- Weak reference to Category -->
    <ownedProperty name="category" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Category">
    <!-- Primitive attribute -->
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference -->
    <ownedProperty name="parentCategory" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <!-- Primitive attribute -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference -->
    <ownedProperty name="primaryContact" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Library">
    <!-- Primitive attribute -->
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Category -->
    <ownedProperty name="mainCategory" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>