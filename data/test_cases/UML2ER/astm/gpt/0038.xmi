<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book, with only primitive properties (Attributes rule) -->
  <ownedElements name="Book">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitiveType missing, complexType undefined => Attributes with 'NoType' -->
    <ownedProperty name="summary" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author, targeted by weak and strong references -->
  <ownedElements name="Author">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher, superclass and target of references -->
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Library, with super classes and mixed properties -->
  <ownedElements name="Library" superClasses="//@ownedElements.2">
    <!-- primitive attribute -->
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <!-- weak reference to Book (non-containment complexType) -->
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- strong reference to Publisher (containment complexType) -->
    <ownedProperty name="mainPublisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 4: DigitalLibrary, multiple superClasses -->
  <ownedElements name="DigitalLibrary" superClasses="//@ownedElements.3 //@ownedElements.2">
    <!-- strong reference to Library -->
    <ownedProperty name="baseLibrary" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- weak reference to Publisher -->
    <ownedProperty name="externalPublisher" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- primitive attribute without type => NoType -->
    <ownedProperty name="endpointUrl" isContainment="false"/>
  </ownedElements>

  <!-- Class 5: Membership, referenced strongly and weakly -->
  <ownedElements name="Membership">
    <ownedProperty name="level" primitiveType="String" isContainment="false"/>
    <!-- self-reference weak -->
    <ownedProperty name="parentMembership" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- Class 6: Member, uses Membership with strong/weak references -->
  <ownedElements name="Member" superClasses="//@ownedElements.1">
    <!-- primitive attribute -->
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <!-- strong reference to Membership -->
    <ownedProperty name="primaryMembership" complexType="//@ownedElements.5" isContainment="true"/>
    <!-- weak reference to Membership -->
    <ownedProperty name="secondaryMembership" complexType="//@ownedElements.5" isContainment="false"/>
    <!-- primitive attribute without type => NoType -->
    <ownedProperty name="notes" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>