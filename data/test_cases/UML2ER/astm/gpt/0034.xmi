<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- Index 0 -->
  <ownedElements name="Item">
    <!-- attribute with primitive type -->
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <!-- attribute without primitiveType (will get NoType) -->
    <ownedProperty name="label" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <!-- primitive attribute -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- strong reference (containment) to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- weak reference (non-containment) to Category -->
    <ownedProperty name="category" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <!-- primitive attribute -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- attribute with NoType -->
    <ownedProperty name="biography" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Category">
    <!-- primitive attribute -->
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <!-- weak reference to parent Category -->
    <ownedProperty name="parentCategory" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Library">
    <!-- strong containment reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- strong containment reference to Author -->
    <ownedProperty name="authors" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- weak reference to main Category -->
    <ownedProperty name="rootCategory" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>