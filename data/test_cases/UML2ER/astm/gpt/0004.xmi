<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Library">
    <!-- Attribute with primitiveType defined -->
    <ownedProperty name="libraryId" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (NoType case) -->
    <ownedProperty name="remarks" isContainment="false"/>
    <!-- Strong reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Member -->
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Book">
    <!-- Primitive attribute -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute without type (NoType) -->
    <ownedProperty name="summary" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- Weak self-reference -->
    <ownedProperty name="relatedBook" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Member" superClasses="//@ownedElements.4">
    <!-- Primitive attribute -->
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <!-- Strong reference to Address -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.5" isContainment="true"/>
    <!-- Weak reference to Library -->
    <ownedProperty name="registeredLibrary" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Author" superClasses="//@ownedElements.4">
    <!-- Primitive attribute -->
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Address -->
    <ownedProperty name="contactAddress" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Person">
    <!-- Primitive attribute -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements xmi:type="SimpleUml:Class" name="Address">
    <!-- Primitive attributes -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to City -->
    <ownedProperty name="city" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements xmi:type="SimpleUml:Class" name="City">
    <!-- Primitive attribute -->
    <ownedProperty name="cityName" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>