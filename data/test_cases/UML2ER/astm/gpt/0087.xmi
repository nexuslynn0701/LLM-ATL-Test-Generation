<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="Person">
    <ownedProperty name="personId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contact" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Member" superClasses="//@ownedElements.0">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="membershipStart" primitiveType="" isContainment="false"/>
    <ownedProperty name="borrowedItems" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedSections" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Book">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publisher" primitiveType="" isContainment="false"/>
    <ownedProperty name="authors" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="postalCode" primitiveType="" isContainment="false"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="Author">
    <ownedProperty name="authorId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>