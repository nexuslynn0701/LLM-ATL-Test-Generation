<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- primitive attribute with primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without primitiveType (NoType case) -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- weak reference to Author (complexType set, non-containment) -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- strong reference to Library (complexType set, containment) -->
    <ownedProperty name="ownedByLibrary" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- primitive attribute with primitiveType -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without primitiveType (NoType) -->
    <ownedProperty name="birthDate" isContainment="false"/>
    <!-- strong self-reference (containment) -->
    <ownedProperty name="primaryPseudonym" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Member with multiple superClasses -->
  <ownedElements name="Member" superClasses="//@ownedElements.0 //@ownedElements.1">
    <!-- primitive attribute with primitiveType -->
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <!-- weak reference to Book -->
    <ownedProperty name="favoriteBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Library -->
  <ownedElements name="Library">
    <!-- primitive attribute without primitiveType (NoType) -->
    <ownedProperty name="city" isContainment="false"/>
    <!-- strong reference to Member (containment) -->
    <ownedProperty name="registeredMembers" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- weak reference to Book -->
    <ownedProperty name="featuredBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>