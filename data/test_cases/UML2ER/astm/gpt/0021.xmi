<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined => NoType -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="writer" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to LibraryBranch -->
    <ownedProperty name="storedAt" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Book (e.g., mainWork) -->
    <ownedProperty name="mainWork" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Weak self-reference (e.g., mentor) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Member, subclass of Person and VIPMember -->
  <ownedElements name="Member" superClasses="//@ownedElements.4 //@ownedElements.5">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book (borrowed book) -->
    <ownedProperty name="borrowedBook" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference to LibraryBranch (home branch) -->
    <ownedProperty name="homeBranch" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: LibraryBranch -->
  <ownedElements name="LibraryBranch">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined => NoType -->
    <ownedProperty name="establishedDate" isContainment="false"/>
    <!-- Strong self-reference (e.g., parent branch) -->
    <ownedProperty name="parentBranch" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 4: Person -->
  <ownedElements name="Person">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 5: VIPMember, subclass of Member -->
  <ownedElements name="VIPMember" superClasses="//@ownedElements.2">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="vipLevel" primitiveType="Integer" isContainment="false"/>
    <!-- Weak reference to Member (personal assistant) -->
    <ownedProperty name="assistant" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>