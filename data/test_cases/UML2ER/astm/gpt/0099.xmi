<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Library (no superclasses) -->
  <ownedElements name="Library">
    <!-- Strong reference to Book (containment) -->
    <ownedProperty name="books" isContainment="true" complexType="//@ownedElements.1"/>
    <!-- Weak reference to Member (non-containment) -->
    <ownedProperty name="registeredMembers" isContainment="false" complexType="//@ownedElements.2"/>
    <!-- Attribute without primitiveType (will become NoType) -->
    <ownedProperty name="locationCode" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Book (no superclasses) -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Strong reference to Author (containment) -->
    <ownedProperty name="mainAuthor" isContainment="true" complexType="//@ownedElements.3"/>
    <!-- Weak reference to Library (non-containment, cross-reference back) -->
    <ownedProperty name="homeLibrary" isContainment="false" complexType="//@ownedElements.0"/>
  </ownedElements>

  <!-- Class 2: Member (subclass of Person) -->
  <ownedElements name="Member" superClasses="//@ownedElements.4">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book (non-containment) -->
    <ownedProperty name="borrowedBook" isContainment="false" complexType="//@ownedElements.1"/>
  </ownedElements>

  <!-- Class 3: Author (subclass of Person) -->
  <ownedElements name="Author" superClasses="//@ownedElements.4">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book (non-containment, many-to-many style) -->
    <ownedProperty name="writtenBooks" isContainment="false" complexType="//@ownedElements.1"/>
  </ownedElements>

  <!-- Class 4: Person (no superclasses) -->
  <ownedElements name="Person">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType -->
    <ownedProperty name="nationalId" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>