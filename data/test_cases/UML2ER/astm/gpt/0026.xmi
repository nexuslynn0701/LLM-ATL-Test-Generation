<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="UniversityModel">

  <!-- Class 0: Department, superclass of Course -->
  <ownedElements name="Department">
    <!-- Attribute with primitive type -->
    <ownedProperty name="deptCode" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (will yield 'NoType') -->
    <ownedProperty name="description" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Person, superclass of Student and Instructor -->
  <ownedElements name="Person">
    <!-- Attribute with primitive type -->
    <ownedProperty name="personId" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute without primitiveType -->
    <ownedProperty name="fullName" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Course, has superclass Department -->
  <ownedElements name="Course" superClasses="//@ownedElements.0">
    <!-- Weak reference to Department (non-containment reference) -->
    <ownedProperty name="offeredBy" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference to Person as coordinator (containment reference) -->
    <ownedProperty name="coordinator" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Attribute with primitive type -->
    <ownedProperty name="credits" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Student, subclass of Person -->
  <ownedElements name="Student" superClasses="//@ownedElements.1">
    <!-- Weak reference to Course (non-containment reference) -->
    <ownedProperty name="enrolledIn" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Attribute without primitiveType -->
    <ownedProperty name="enrollmentStatus" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Instructor, subclass of Person -->
  <ownedElements name="Instructor" superClasses="//@ownedElements.1">
    <!-- Strong reference to Course (containment reference) -->
    <ownedProperty name="teaches" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Attribute with primitive type -->
    <ownedProperty name="salary" primitiveType="Double" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>