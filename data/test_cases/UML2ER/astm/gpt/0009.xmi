<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- 0: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="authorId" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (NoType case) -->
    <ownedProperty name="penName" isContainment="false"/>
  </ownedElements>

  <!-- 1: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="coAuthor" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- 2: Library -->
  <ownedElements name="Library">
    <!-- Strong reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="featuredAuthor" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- 3: DigitalLibrary, subclass of Library and Book -->
  <ownedElements name="DigitalLibrary" superClasses="//@ownedElements.2 //@ownedElements.1">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="url" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Library -->
    <ownedProperty name="parentLibrary" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="highlightedBook" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>