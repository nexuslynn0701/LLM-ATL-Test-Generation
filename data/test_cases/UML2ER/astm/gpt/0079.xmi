<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book, with primitive attributes and mixed references -->
  <ownedElements name="Book">
    <!-- primitive with type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive without type (should yield NoType) -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- containment reference to Chapter -->
    <ownedProperty name="chapters" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- non-containment reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author, with primitive and reference properties -->
  <ownedElements name="Author">
    <!-- primitive with type -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- primitive without type -->
    <ownedProperty name="birthDate" isContainment="false"/>
    <!-- non-containment reference to Address -->
    <ownedProperty name="address" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- containment reference to Book (cyclic reference) -->
    <ownedProperty name="featuredBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Address, with only primitive attributes -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <!-- primitive without type -->
    <ownedProperty name="postcode" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Chapter, with superclass Book to test inheritance and various properties -->
  <ownedElements name="Chapter" superClasses="//@ownedElements.0">
    <!-- primitive with type -->
    <ownedProperty name="heading" primitiveType="String" isContainment="false"/>
    <!-- primitive without type -->
    <ownedProperty name="pageCount" isContainment="false"/>
    <!-- containment reference to Section -->
    <ownedProperty name="sections" complexType="//@ownedElements.4" isContainment="true"/>
    <!-- non-containment reference to Author -->
    <ownedProperty name="contributor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Section, multiple superClasses to exercise reference list -->
  <ownedElements name="Section" superClasses="//@ownedElements.0 //@ownedElements.3">
    <!-- primitive with type -->
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <!-- non-containment reference to Chapter -->
    <ownedProperty name="parentChapter" complexType="//@ownedElements.3" isContainment="false"/>
    <!-- containment reference to Section (self-containment) -->
    <ownedProperty name="subSection" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>