<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with no primitiveType (will become 'NoType') -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Shelf -->
    <ownedProperty name="storedOn" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Book -->
    <ownedProperty name="debutBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Library (superclass of BranchLibrary) -->
  <ownedElements name="Library">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="featuredBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Shelf -->
  <ownedElements name="Shelf">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="position" primitiveType="Integer" isContainment="false"/>
    <!-- Strong reference to Library -->
    <ownedProperty name="inLibrary" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 4: BranchLibrary with superclass Library -->
  <ownedElements name="BranchLibrary" superClasses="//@ownedElements.2">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="branchName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to parent Library -->
    <ownedProperty name="parent" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>