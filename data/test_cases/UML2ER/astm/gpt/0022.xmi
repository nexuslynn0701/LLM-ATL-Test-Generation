<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book, with primitive and untyped attributes and mixed references -->
  <ownedElements name="Book">
    <!-- Primitive attribute with type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Primitive attribute without type -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="writer" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author, superclass of Contributor with containment and non-containment references -->
  <ownedElements name="Author">
    <!-- Primitive attribute with type -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to primary Book (to create containment cycle with Book.publisher) -->
    <ownedProperty name="primaryBook" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Weak self-reference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher, with primitive attribute and weak reference -->
  <ownedElements name="Publisher">
    <!-- Primitive attribute with type -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="featuredBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Contributor extending Author and Publisher, with no properties -->
  <ownedElements name="Contributor"
                 superClasses="//@ownedElements.1 //@ownedElements.2">
  </ownedElements>

  <!-- Class 4: Library extending no one, mix of attribute and both ref kinds -->
  <ownedElements name="Library">
    <!-- Primitive attribute with type -->
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Publisher -->
    <ownedProperty name="mainPublisher" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="featuredItem" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>