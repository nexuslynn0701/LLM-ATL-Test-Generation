<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType omitted (NoType in target) -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Address -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Weak self-reference -->
    <ownedProperty name="coAuthor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Address -->
  <ownedElements name="Address">
    <!-- Attribute with primitiveType omitted (NoType in target) -->
    <ownedProperty name="street" isContainment="false"/>
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="postalCode" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: EBook, subclass of Book and Document -->
  <ownedElements name="EBook" superClasses="//@ownedElements.0 //@ownedElements.4">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="fileFormat" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Book (base edition) -->
    <ownedProperty name="baseEdition" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 4: Document (no properties, used as superclass only) -->
  <ownedElements name="Document">
  </ownedElements>

</SimpleUml:Package>