<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute: primitive with type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute: primitive without type (NoType case) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute primitive with type -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Attribute primitive with type -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Address -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Address (superclass of Library and BranchLibrary) -->
  <ownedElements name="Address">
    <!-- Attribute with explicit primitive type -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitive type (NoType) -->
    <ownedProperty name="postalCode" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Library (inherits Address) -->
  <ownedElements name="Library" superClasses="//@ownedElements.3">
    <!-- Weak reference to Book -->
    <ownedProperty name="featuredBook" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference to Address (composition-like) -->
    <ownedProperty name="location" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 5: BranchLibrary (multiple inheritance: Library and Address) -->
  <ownedElements name="BranchLibrary" superClasses="//@ownedElements.4 //@ownedElements.3">
    <!-- Attribute with type -->
    <ownedProperty name="branchCode" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="partnerPublisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>