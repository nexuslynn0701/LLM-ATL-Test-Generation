<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="Item">
    <!-- Primitive attribute with primitiveType set -->
    <ownedProperty name="itemId" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (will become NoType) -->
    <ownedProperty name="legacyCode" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <!-- Primitive attribute -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Strong reference (containment) to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak reference to Category -->
    <ownedProperty name="category" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Author">
    <!-- Primitive attribute -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Category">
    <!-- Primitive attribute -->
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <!-- Strong reference (containment) back to Book to create a bidirectional-style link -->
    <ownedProperty name="featuredBook" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Member" superClasses="//@ownedElements.0">
    <!-- Primitive attribute -->
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <!-- Strong reference (containment) to Loan -->
    <ownedProperty name="activeLoan" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="Loan">
    <!-- Primitive attribute without primitiveType (NoType) -->
    <ownedProperty name="loanDate" isContainment="false"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="loanedBook" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Weak reference to Member (non-containment, opposite direction) -->
    <ownedProperty name="borrower" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>