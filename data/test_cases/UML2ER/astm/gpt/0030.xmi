<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="Publication">
    <!-- Attribute with primitive type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="code" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <!-- Strong reference to Publication -->
    <ownedProperty name="basePublication" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Attribute with primitive type -->
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Author">
    <!-- Attribute with primitive type -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Biography -->
    <ownedProperty name="biography" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Library">
    <!-- Strong reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Member -->
    <ownedProperty name="registeredMembers" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Biography">
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="text" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Member" superClasses="//@ownedElements.0">
    <!-- Attribute with primitive type -->
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference -->
    <ownedProperty name="referrer" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>