<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitive type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (will become 'NoType') -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitive type -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference (co-author) -->
    <ownedProperty name="coAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Address -->
    <ownedProperty name="homeAddress" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Attribute with primitive type -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Address -->
    <ownedProperty name="officeAddress" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Address -->
  <ownedElements name="Address">
    <!-- Multiple primitive attributes -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="postcode" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: DigitalBook extends Book and Publisher -->
  <ownedElements name="DigitalBook" superClasses="//@ownedElements.0 //@ownedElements.2">
    <!-- Attribute with primitive type -->
    <ownedProperty name="fileFormat" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Book (base edition) -->
    <ownedProperty name="baseEdition" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>