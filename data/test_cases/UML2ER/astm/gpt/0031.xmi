<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="Item">
    <ownedProperty name="id" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="authors" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Magazine" superClasses="//@ownedElements.0">
    <ownedProperty name="issueNumber" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="editor" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contactInfo" primitiveType="" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Member" superClasses="//@ownedElements.3">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedItems" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="profile" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="Profile">
    <ownedProperty name="preferences" primitiveType="String" isContainment="false"/>
    <ownedProperty name="notes" primitiveType="Text" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.3 //@ownedElements.8">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedMembers" complexType="//@ownedElements.5" isContainment="false"/>
    <ownedProperty name="assignedBranch" complexType="//@ownedElements.9" isContainment="true"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="StaffRole">
    <ownedProperty name="roleName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 9 -->
  <ownedElements name="Branch">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="inventory" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>