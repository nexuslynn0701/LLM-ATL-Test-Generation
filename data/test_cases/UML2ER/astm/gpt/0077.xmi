<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType unset to trigger 'NoType' -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference (e.g., mentor) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="debutBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="headquarters" isContainment="false"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="flagshipTitle" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: EBook, subclass of Book -->
  <ownedElements name="EBook" superClasses="//@ownedElements.0">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="fileFormat" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Publisher -->
    <ownedProperty name="digitalPublisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>