<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- 0 -->
  <ownedElements name="Item">
    <ownedProperty name="itemId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Author">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="biography" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="LibraryBranch">
    <ownedProperty name="branchName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="manager" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.5">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignedBranch" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Person">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="Member" superClasses="//@ownedElements.5">
    <ownedProperty name="membershipId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="favoriteBook" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Loan">
    <ownedProperty name="loanDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="borrowedBook" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="borrowingMember" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="Publisher">
    <ownedProperty name="publisherName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publishedBooks" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <!-- 9 -->
  <ownedElements name="Genre">
    <ownedProperty name="genreName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="representativeBook" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <!-- 10 -->
  <ownedElements name="Review">
    <ownedProperty name="rating" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="text" primitiveType="String" isContainment="false"/>
    <ownedProperty name="reviewedBook" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="reviewAuthor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>