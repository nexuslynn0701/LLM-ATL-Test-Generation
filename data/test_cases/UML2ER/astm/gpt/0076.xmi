<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="Item">
    <!-- Attribute with primitiveType (Attributes rule, NamedElement, Property) -->
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
    <!-- Attribute with no primitiveType (NoType case) -->
    <ownedProperty name="creationDate" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <!-- Strong reference to Item (StrongReferences, References) -->
    <ownedProperty name="baseItem" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Attribute with primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Author (WeakReferences, References) -->
    <ownedProperty name="writtenBy" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference back to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0 //@ownedElements.4">
    <!-- Strong reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="authors" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Attribute with primitiveType -->
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Institution">
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="code" isContainment="false"/>
    <!-- Weak reference to Library -->
    <ownedProperty name="mainLibrary" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>