<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <!-- Strong reference to Chapter -->
    <ownedProperty name="chapters" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (triggers NoType) -->
    <ownedProperty name="penName" isContainment="false"/>
    <!-- Weak self-reference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Chapter (subclass of Book) -->
  <ownedElements name="Chapter" superClasses="//@ownedElements.0">
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="heading" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Section -->
    <ownedProperty name="sections" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Section (subclass of Chapter) -->
  <ownedElements name="Section" superClasses="//@ownedElements.2">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Paragraph -->
    <ownedProperty name="paragraphs" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Class 4: Paragraph (no superClasses) -->
  <ownedElements name="Paragraph">
    <ownedProperty name="text" primitiveType="String" isContainment="false"/>
    <!-- Weak reference back to Section -->
    <ownedProperty name="parentSection" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>