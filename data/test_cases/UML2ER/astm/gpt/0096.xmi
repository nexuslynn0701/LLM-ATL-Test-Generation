<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="Library">
    <!-- Attribute with primitiveType set (Attributes rule, NamedElement, Property) -->
    <ownedProperty name="libraryId" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Book (StrongReferences + References) -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Member (WeakReferences + References) -->
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Book">
    <!-- Attribute without primitiveType (NoType branch in Attributes) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Attribute with primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference -->
    <ownedProperty name="relatedEditions" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="author" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Member">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <!-- Weak reference to Library -->
    <ownedProperty name="registeredAt" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Book -->
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- 4: subclass to exercise superClasses reference -->
  <ownedElements name="PremiumMember" superClasses="//@ownedElements.2">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="loyaltyPoints" primitiveType="Integer" isContainment="false"/>
    <!-- Strong reference to Member -->
    <ownedProperty name="parentMember" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>