<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- Class 0: Book, with primitive attributes and strong reference -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publicationYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <!-- Class 1: Author, with primitive attribute and weak reference -->
  <ownedElements name="Author">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryPublisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- Class 2: Publisher, superclass of AcademicPublisher and TechPublisher -->
  <ownedElements name="Publisher">
    <ownedProperty name="legalName" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Class 3: AcademicPublisher, subclass of Publisher -->
  <ownedElements name="AcademicPublisher" superClasses="//@ownedElements.2">
    <ownedProperty name="ranking" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <!-- Class 4: TechPublisher, subclass of Publisher, with a reference to Book -->
  <ownedElements name="TechPublisher" superClasses="//@ownedElements.2">
    <ownedProperty name="focusArea" primitiveType="String" isContainment="false"/>
    <ownedProperty name="flagshipBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <!-- Class 5: Library, with attribute lacking primitiveType and strong reference -->
  <ownedElements name="Library">
    <ownedProperty name="location" isContainment="false"/>
    <ownedProperty name="collection" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>