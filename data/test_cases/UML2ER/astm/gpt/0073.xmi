<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitive type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute without type (primitiveType and complexType both undefined) -->
    <ownedProperty name="publicationNote" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author (no super class) -->
  <ownedElements name="Author">
    <!-- Attribute with primitive type -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to ContactInfo -->
    <ownedProperty name="contactInfo" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Attribute with primitive type -->
    <ownedProperty name="publisherName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Address -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Address -->
  <ownedElements name="Address">
    <!-- All attributes, no references -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: ContactInfo -->
  <ownedElements name="ContactInfo">
    <!-- Attribute without type -->
    <ownedProperty name="preferredChannel" isContainment="false"/>
    <!-- Weak reference back to Address -->
    <ownedProperty name="location" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 5: EBook extends Book and Publisher -->
  <ownedElements name="EBook" superClasses="//@ownedElements.0 //@ownedElements.2">
    <!-- Attribute with primitive type -->
    <ownedProperty name="fileFormat" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Author (different property than mainAuthor) -->
    <ownedProperty name="secondaryAuthor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>