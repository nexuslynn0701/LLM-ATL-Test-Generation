<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="Library">
    <!-- Attribute with primitive type -->
    <ownedProperty name="libraryName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Member -->
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Book">
    <!-- Attribute with primitive type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (NoType case) -->
    <ownedProperty name="publishedYear" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="author" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Member">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Library -->
    <ownedProperty name="homeLibrary" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference to Loan -->
    <ownedProperty name="loans" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference (to test complexType with same class) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Loan" superClasses="//@ownedElements.5">
    <!-- Attribute without primitiveType (NoType case) -->
    <ownedProperty name="loanDate" isContainment="false"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="loanedBook" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Member -->
    <ownedProperty name="borrower" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="Transaction">
    <!-- Simple attribute -->
    <ownedProperty name="transactionCode" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>