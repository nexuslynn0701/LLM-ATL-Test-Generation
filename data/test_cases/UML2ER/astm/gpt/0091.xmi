<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Library -->
  <ownedElements name="Library">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="libraryName" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (will yield NoType) -->
    <ownedProperty name="establishedYear" isContainment="false"/>
    <!-- Strong reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Book -->
  <ownedElements name="Book">
    <!-- Primitive attribute -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Strong reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Author -->
  <ownedElements name="Author">
    <!-- Primitive attribute -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Publisher, subclass of Library -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.0">
    <!-- Primitive attribute -->
    <ownedProperty name="publisherName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Address (class 4) -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Class 4: Address -->
  <ownedElements name="Address">
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="street" isContainment="false"/>
    <!-- Attribute with primitiveType -->
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>