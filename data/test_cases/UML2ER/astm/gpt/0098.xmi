<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="PublishingModel">

  <!-- Index 0 -->
  <ownedElements name="PrimitiveOnlyClass">
    <!-- primitive attribute with type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without type -->
    <ownedProperty name="untitledFlag" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Author">
    <!-- strong reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Book">
    <!-- primitive attribute -->
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <!-- weak reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- strong reference to Chapter -->
    <ownedProperty name="chapters" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Chapter">
    <!-- primitive attribute without type -->
    <ownedProperty name="number" isContainment="false"/>
    <!-- weak reference back to Book -->
    <ownedProperty name="parentBook" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0 //@ownedElements.2">
    <!-- strong reference to Author -->
    <ownedProperty name="allAuthors" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- weak reference to Book -->
    <ownedProperty name="featuredBook" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- primitive attribute -->
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>