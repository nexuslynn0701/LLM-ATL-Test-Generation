<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Primitive-only properties (with and without primitiveType) -->
  <ownedElements name="Config">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="systemName" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (will become 'NoType') -->
    <ownedProperty name="maintenanceWindow" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Book -->
  <ownedElements name="Book">
    <!-- Primitive attribute -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Author (superclass of Member) -->
  <ownedElements name="Author">
    <!-- Primitive attribute -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference (e.g., mentor) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Publisher -->
  <ownedElements name="Publisher">
    <!-- Strong containment reference to Address -->
    <ownedProperty name="headOffice" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Class 4: Address (no properties) -->
  <ownedElements name="Address"/>

  <!-- Class 5: Member, subclass of Author and Config (tests multiple superClasses) -->
  <ownedElements name="Member" superClasses="//@ownedElements.2 //@ownedElements.0">
    <!-- Primitive attribute -->
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <!-- Strong reference to Book -->
    <ownedProperty name="favoriteBook" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Address -->
    <ownedProperty name="shippingAddress" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>