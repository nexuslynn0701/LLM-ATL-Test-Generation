<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="UniversityModel">

  <!-- Index 0 -->
  <ownedElements name="Person">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (will become 'NoType') -->
    <ownedProperty name="notes" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Course">
    <!-- Strong reference to Person -->
    <ownedProperty name="lecturer" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Weak reference to Student (forward reference) -->
    <ownedProperty name="participants" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Student" superClasses="//@ownedElements.0">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="registrationNumber" primitiveType="Integer" isContainment="false"/>
    <!-- Strong reference to Course -->
    <ownedProperty name="mainCourse" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Department">
    <!-- Weak reference to Course -->
    <ownedProperty name="offeredCourses" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Person as head -->
    <ownedProperty name="head" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>