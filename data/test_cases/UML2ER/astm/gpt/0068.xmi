<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="Library">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="libraryName" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (tests NoType) -->
    <ownedProperty name="establishedYear" isContainment="false"/>
    <!-- Strong reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Address -->
    <ownedProperty name="location" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Book">
    <!-- Strong reference to Author -->
    <ownedProperty name="author" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="false"/>
    <!-- Primitive attribute -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Author">
    <!-- Primitive attribute -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Publisher">
    <!-- Primitive attribute with different primitive type -->
    <ownedProperty name="foundedIn" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Address">
    <!-- Several primitive attributes -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="DigitalLibrary" superClasses="//@ownedElements.0">
    <!-- Weak reference to Library (non-containment) -->
    <ownedProperty name="baseLibrary" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Attribute without primitiveType (tests NoType again) -->
    <ownedProperty name="url" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>