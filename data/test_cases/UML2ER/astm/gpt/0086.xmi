<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="Item">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="itemId" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="createdOn" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference (e.g., mentor) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Publisher">
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="code" isContainment="false"/>
    <!-- Weak reference to Address -->
    <ownedProperty name="headOffice" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Address">
    <!-- Simple attributes -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zip" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>