<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- Index 0 -->
  <ownedElements name="User">
    <ownedProperty name="userId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Index 1 -->
  <ownedElements name="Member" superClasses="//@ownedElements.0">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="borrowedItems" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- Index 2 -->
  <ownedElements name="Book">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="summary" primitiveType="" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- Index 3 -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Index 4 -->
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headquarters" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>