<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Library -->
  <ownedElements name="Library">
    <!-- primitive attribute with type -->
    <ownedProperty name="libraryName" primitiveType="String" isContainment="false"/>
    <!-- containment reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- non-containment reference to Member -->
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Book, subclass of Library (for superClasses coverage) -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <!-- primitive attribute without primitiveType (NoType case) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- primitive attribute with type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- strong (containment) reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- weak (non-containment) reference to Member as borrower -->
    <ownedProperty name="borrowedBy" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Member, subclass of Library and Book -->
  <ownedElements name="Member" superClasses="//@ownedElements.0 //@ownedElements.1">
    <!-- primitive attribute with type -->
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <!-- primitive attribute without type (NoType) -->
    <ownedProperty name="nickname" isContainment="false"/>
    <!-- non-containment reference to Library (home library) -->
    <ownedProperty name="homeLibrary" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Author, subclass of Person (see below) -->
  <ownedElements name="Author" superClasses="//@ownedElements.4">
    <!-- primitive attribute with type -->
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
    <!-- containment reference to Book (books written) -->
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 4: Person, superclass used for Author hierarchy -->
  <ownedElements name="Person">
    <!-- primitive attribute with type -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without type -->
    <ownedProperty name="age" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>