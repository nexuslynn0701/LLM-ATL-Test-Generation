<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="PublishingDomain">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <!-- Attribute with no primitiveType (will become NoType) -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Biography -->
    <ownedProperty name="biography" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- Weak self-reference to mentor Author -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Country -->
    <ownedProperty name="headquartersCountry" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Biography -->
  <ownedElements name="Biography" superClasses="//@ownedElements.5">
    <!-- Attribute without primitiveType -->
    <ownedProperty name="summary" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Country -->
  <ownedElements name="Country">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType -->
    <ownedProperty name="description" isContainment="false"/>
  </ownedElements>

  <!-- Class 5: Document (superclass of Biography) -->
  <ownedElements name="Document">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>