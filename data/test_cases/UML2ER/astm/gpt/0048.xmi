<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book (no superClasses) -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (should yield NoType) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author (no superClasses) -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher, subclass of Organization -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.3">
    <!-- Strong reference to Organization (superClass) -->
    <ownedProperty name="parentOrganization" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="country" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Organization (no superClasses) -->
  <ownedElements name="Organization">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="orgName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Library, subclass of Organization and Book -->
  <ownedElements name="Library" superClasses="//@ownedElements.3 //@ownedElements.0">
    <!-- Strong reference to Book -->
    <ownedProperty name="collection" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="mainPublisher" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Attribute with primitiveType -->
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>