<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- Index 0 -->
  <ownedElements name="Item">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined => 'NoType' -->
    <ownedProperty name="legacyCode" isContainment="false"/>
  </ownedElements>
  <!-- Index 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="editor" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- Index 2 -->
  <ownedElements name="Author">
    <!-- Strong self-reference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak self-reference -->
    <ownedProperty name="colleague" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- Index 3 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <!-- Strong reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="guestAuthor" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Attribute with primitiveType undefined => 'NoType' -->
    <ownedProperty name="notes" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>