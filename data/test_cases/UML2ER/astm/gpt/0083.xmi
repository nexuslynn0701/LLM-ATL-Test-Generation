<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (NoType) -->
    <ownedProperty name="publicationDate" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author (superclass of GuestAuthor) -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference to model recursive containment -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher (superclass of LocalPublisher) -->
  <ownedElements name="Publisher">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Library (no superclasses) -->
  <ownedElements name="Library">
    <!-- Attribute with primitiveType undefined (NoType) -->
    <ownedProperty name="location" isContainment="false"/>
    <!-- Strong reference to Book -->
    <ownedProperty name="catalog" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="mainPartner" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: GuestAuthor extends Author and Publisher (multiple inheritance) -->
  <ownedElements name="GuestAuthor" superClasses="//@ownedElements.1 //@ownedElements.2">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="visitReason" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Library -->
    <ownedProperty name="hostLibrary" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 5: LocalPublisher extends Publisher -->
  <ownedElements name="LocalPublisher" superClasses="//@ownedElements.2">
    <!-- Attribute with primitiveType undefined (NoType) -->
    <ownedProperty name="region" isContainment="false"/>
    <!-- Strong reference to Library -->
    <ownedProperty name="associatedLibrary" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>