<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType unset (will yield NoType) -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to LibraryBranch -->
    <ownedProperty name="locatedAt" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference (non-containment) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="EBook" superClasses="//@ownedElements.0">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="fileFormat" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Book (composition-like) -->
    <ownedProperty name="baseEdition" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="LibraryBranch">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Member as contained relationship -->
    <ownedProperty name="branchManager" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Member">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="favoriteBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>