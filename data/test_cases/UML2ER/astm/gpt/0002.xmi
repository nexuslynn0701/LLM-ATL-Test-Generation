<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book (no superclasses) -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (will become 'NoType') -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong (containment) reference to Chapter -->
    <ownedProperty name="chapters" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author (no superclasses) -->
  <ownedElements name="Author">
    <!-- Primitive attribute -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference back to Book -->
    <ownedProperty name="writtenBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: LibraryUser with superclass Book (to exercise superClasses) -->
  <ownedElements name="LibraryUser" superClasses="//@ownedElements.0">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="userId" primitiveType="Integer" isContainment="false"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="borrowedBook" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference to Author (e.g., favorite author) -->
    <ownedProperty name="favoriteAuthor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Chapter, referenced as containment from Book -->
  <ownedElements name="Chapter">
    <!-- Primitive attribute -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Weak reference back to Book -->
    <ownedProperty name="parentBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>