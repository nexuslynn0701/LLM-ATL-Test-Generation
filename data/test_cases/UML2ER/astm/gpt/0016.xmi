<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="PublishingSystem">

  <!-- 0 -->
  <ownedElements name="Document">
    <!-- primitive attribute with type -->
    <ownedProperty name="docId" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without type (NoType) -->
    <ownedProperty name="createdOn" isContainment="false"/>
    <!-- strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- weak reference to Tag -->
    <ownedProperty name="tags" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Author">
    <!-- primitive attribute with type -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without type (NoType) -->
    <ownedProperty name="email" isContainment="false"/>
    <!-- strong self-reference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Review" superClasses="//@ownedElements.0">
    <!-- primitive attribute -->
    <ownedProperty name="score" primitiveType="Integer" isContainment="false"/>
    <!-- weak reference to Document -->
    <ownedProperty name="targetDocument" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- strong reference to Author -->
    <ownedProperty name="reviewer" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Tag">
    <!-- primitive attribute -->
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <!-- weak self-reference -->
    <ownedProperty name="relatedTag" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>