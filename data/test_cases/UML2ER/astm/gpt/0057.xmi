<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="EnterpriseModel">
  <ownedElements name="Organization">
    <ownedProperty name="orgId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="departments" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="hqLocation" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Department">
    <ownedProperty name="deptId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="employees" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="parentDepartment" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Employee" superClasses="//@ownedElements.3">
    <ownedProperty name="empId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="worksIn" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person">
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Project">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="description" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lead" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="teamMembers" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Asset">
    <ownedProperty name="assetTag" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignedTo" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="relatedProject" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Meeting">
    <ownedProperty name="topic" primitiveType="String" isContainment="false"/>
    <ownedProperty name="scheduledAt" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="host" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="participants" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="room" primitiveType="" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>