<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- primitive attribute with type -->
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without type (NoType case) -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- weak reference to Category -->
    <ownedProperty name="primaryCategory" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- primitive attribute with type -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- weak self-reference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- strong reference to Address -->
    <ownedProperty name="contactAddress" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Category -->
  <ownedElements name="Category">
    <!-- primitive attribute with type -->
    <ownedProperty name="label" primitiveType="String" isContainment="false"/>
    <!-- strong self-reference (hierarchy) -->
    <ownedProperty name="parentCategory" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Address -->
  <ownedElements name="Address">
    <!-- only primitive attributes -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without type (NoType case) -->
    <ownedProperty name="postalCode" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: EBook extends Book and Author -->
  <ownedElements name="EBook" superClasses="//@ownedElements.0 //@ownedElements.1">
    <!-- primitive attribute with type -->
    <ownedProperty name="fileFormat" primitiveType="String" isContainment="false"/>
    <!-- weak reference to Book (base work) -->
    <ownedProperty name="baseEdition" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>