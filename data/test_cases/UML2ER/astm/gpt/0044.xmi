<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- Index 0 -->
  <ownedElements name="Library">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="librarians" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <!-- Index 1 -->
  <ownedElements name="Book">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="year" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="allAuthors" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="borrowRecords" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <!-- Index 2 -->
  <ownedElements name="Author">
    <ownedProperty name="authorId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="contactEmail" primitiveType="" isContainment="false"/>
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <!-- Index 3 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.6">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="assignedLibrary" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <!-- Index 4 -->
  <ownedElements name="BorrowRecord">
    <ownedProperty name="recordId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="returnDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="borrowedBook" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <!-- Index 5 -->
  <ownedElements name="Member" superClasses="//@ownedElements.6">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="membershipDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="homeLibrary" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="currentLoans" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <!-- Index 6 -->
  <ownedElements name="Person">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>