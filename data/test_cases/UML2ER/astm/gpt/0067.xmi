<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- 0 -->
  <ownedElements name="Document">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="legacyCode" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="PrintedBook" superClasses="//@ownedElements.0">
    <!-- Strong reference to Document -->
    <ownedProperty name="baseDocument" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="author" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="EBook" superClasses="//@ownedElements.0">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="fileFormat" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to User -->
    <ownedProperty name="lastReader" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to User (e.g., account owner) -->
    <ownedProperty name="ownerAccount" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="User">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference (e.g., mentor user) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.4" isContainment="true"/>
    <!-- Weak reference to PrintedBook -->
    <ownedProperty name="favoritePrinted" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>