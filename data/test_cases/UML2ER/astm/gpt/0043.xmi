<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0: Person -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 1: Book -->
  <ownedElements name="Book">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- containment reference to Chapter -->
    <ownedProperty name="chapters" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- 2: Member extends Person -->
  <ownedElements name="Member" superClasses="//@ownedElements.0">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
    <!-- weak reference to borrowed Book -->
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 3: Librarian extends Person -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <!-- weak self-reference to supervisor Librarian -->
    <ownedProperty name="supervisor" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 4: Chapter -->
  <ownedElements name="Chapter">
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="heading" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 5: Loan -->
  <ownedElements name="Loan">
    <!-- attribute without primitiveType -> NoType -->
    <ownedProperty name="startDate" isContainment="false"/>
    <!-- containment reference to Member -->
    <ownedProperty name="loanedTo" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- weak reference to Book -->
    <ownedProperty name="loanedBook" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>