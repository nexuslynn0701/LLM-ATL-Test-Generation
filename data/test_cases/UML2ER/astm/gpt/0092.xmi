<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <!-- 0 -->
  <ownedElements name="Item">
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdAt" primitiveType="DateTime" isContainment="false"/>
    <ownedProperty name="metadata" primitiveType="" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="chapters" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Chapter">
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="heading" primitiveType="String" isContainment="false"/>
    <ownedProperty name="subsections" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="parentBook" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Author" superClasses="//@ownedElements.5">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryContact" complexType="//@ownedElements.6" isContainment="true"/>
    <ownedProperty name="affiliation" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Section">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="content" primitiveType="Text" isContainment="false"/>
    <ownedProperty name="ownerChapter" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 6 -->
  <ownedElements name="ContactInfo">
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="phone" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 7 -->
  <ownedElements name="Borrower" superClasses="//@ownedElements.5">
    <ownedProperty name="membershipId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="homeAddress" primitiveType="String" isContainment="false"/>
    <ownedProperty name="accountContact" complexType="//@ownedElements.6" isContainment="true"/>
  </ownedElements>
  <!-- 8 -->
  <ownedElements name="Loan">
    <ownedProperty name="loanDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="borrowedItem" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.7" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>