<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Primitive attribute with type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with no primitiveType (will become 'NoType') -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Patron -->
    <ownedProperty name="currentBorrower" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Primitive attribute with type -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference (e.g., mentor) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Item (superclass) -->
  <ownedElements name="Item">
    <!-- Attribute with explicit primitiveType -->
    <ownedProperty name="catalogNumber" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Patron, subclass of Item -->
  <ownedElements name="Patron" superClasses="//@ownedElements.2">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="cardId" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference -->
    <ownedProperty name="referredBy" complexType="//@ownedElements.3" isContainment="false"/>
    <!-- Strong reference to Item (polymorphic) -->
    <ownedProperty name="favoriteItem" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>