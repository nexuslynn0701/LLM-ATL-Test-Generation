<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- 0 -->
  <ownedElements name="NamedElementOnly"/>

  <!-- 1 -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="" isContainment="false"/>
    <ownedProperty name="publicationYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="chapters" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headquarters" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Chapter">
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="author" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Author">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryPublisher" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="booksWritten" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="EBook" superClasses="//@ownedElements.1">
    <ownedProperty name="fileFormat" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fileSizeMB" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="relatedPrintEdition" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 6 -->
  <ownedElements name="LibraryBranch">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="address" primitiveType="String" isContainment="false"/>
    <ownedProperty name="manager" complexType="//@ownedElements.7" isContainment="true"/>
    <ownedProperty name="storedBooks" complexType="//@ownedElements.1" isContainment="true"/>
    <ownedProperty name="partnerPublishers" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- 7 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.4">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="officeBranch" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

  <!-- 8 -->
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="preferredBranch" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>