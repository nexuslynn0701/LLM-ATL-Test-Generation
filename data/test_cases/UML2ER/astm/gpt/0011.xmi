<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Person (no properties) -->
  <ownedElements name="Person"/>

  <!-- Class 1: Book (only primitive attributes, some with type, some without) -->
  <ownedElements name="Book">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType, should yield 'NoType' -->
    <ownedProperty name="code" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Member (inherits Person, has mixed attributes and references) -->
  <ownedElements name="Member" superClasses="//@ownedElements.0">
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <!-- Containment reference to a complex type (StrongReference) -->
    <ownedProperty name="profile" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- Non-containment reference to complex type (WeakReference) -->
    <ownedProperty name="borrowedBook" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Profile (only primitive attributes) -->
  <ownedElements name="Profile">
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="phone" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Reservation (inherits Member and Book) -->
  <ownedElements name="Reservation" superClasses="//@ownedElements.2 //@ownedElements.1">
    <!-- Attribute without primitiveType, should yield 'NoType' -->
    <ownedProperty name="reservationCode" isContainment="false"/>
    <!-- Non-containment complex reference (WeakReference) -->
    <ownedProperty name="reservedBook" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Containment complex reference (StrongReference) -->
    <ownedProperty name="holder" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>