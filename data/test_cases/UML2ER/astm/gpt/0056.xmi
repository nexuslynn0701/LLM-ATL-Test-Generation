<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: User -->
  <ownedElements name="User">
    <!-- primitive attribute with type -->
    <ownedProperty name="userId" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without type -->
    <ownedProperty name="nickname" isContainment="false"/>
    <!-- weak reference to Role -->
    <ownedProperty name="role" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Role -->
  <ownedElements name="Role">
    <!-- primitive attribute -->
    <ownedProperty name="roleName" primitiveType="String" isContainment="false"/>
    <!-- strong reference to Permission -->
    <ownedProperty name="permissions" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Permission -->
  <ownedElements name="Permission">
    <!-- primitive attribute -->
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Book, with multiple superclasses -->
  <ownedElements name="Book" superClasses="//@ownedElements.4 //@ownedElements.6">
    <!-- primitive attribute -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- weak reference to User (borrower) -->
    <ownedProperty name="borrower" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- strong reference to Author -->
    <ownedProperty name="primaryAuthor" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Class 4: Author -->
  <ownedElements name="Author">
    <!-- primitive attribute with no type -->
    <ownedProperty name="penName" isContainment="false"/>
    <!-- strong reference to Address -->
    <ownedProperty name="address" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>

  <!-- Class 5: Address -->
  <ownedElements name="Address">
    <!-- primitive attributes -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 6: Publication -->
  <ownedElements name="Publication">
    <!-- primitive attribute -->
    <ownedProperty name="year" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- Class 7: Library with mixed properties -->
  <ownedElements name="Library">
    <!-- primitive attribute -->
    <ownedProperty name="libraryName" primitiveType="String" isContainment="false"/>
    <!-- strong reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- weak reference to Address (location shared) -->
    <ownedProperty name="location" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>