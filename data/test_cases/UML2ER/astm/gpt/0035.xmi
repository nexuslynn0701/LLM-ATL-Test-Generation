<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute: with primitive type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute: without primitive type (NoType in ATL) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Weak self-reference -->
    <ownedProperty name="mentor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong reference to Book -->
    <ownedProperty name="debutBook" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher, superclass of Book -->
  <ownedElements name="Publisher">
    <!-- Attribute -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Address -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Address, superclass of LibraryBranch -->
  <ownedElements name="Address">
    <!-- Attributes -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Country -->
    <ownedProperty name="country" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Country -->
  <ownedElements name="Country">
    <!-- Attribute -->
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference (for regional grouping) -->
    <ownedProperty name="region" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Class 5: LibraryBranch, subclass of Address -->
  <ownedElements name="LibraryBranch" superClasses="//@ownedElements.3">
    <!-- Attributes -->
    <ownedProperty name="branchName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Address (alternate location) -->
    <ownedProperty name="alternateAddress" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>