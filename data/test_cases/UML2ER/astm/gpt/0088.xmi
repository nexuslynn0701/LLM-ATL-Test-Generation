<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitive type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (will map to NoType) -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Strong (containment) reference to Library -->
    <ownedProperty name="owningLibrary" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitive type -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book (non-containment) -->
    <ownedProperty name="primaryBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Member, subclass of Person and PremiumMember -->
  <ownedElements name="Member" superClasses="//@ownedElements.4 //@ownedElements.5">
    <!-- Attribute with primitive type -->
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <!-- Strong reference to Library (containment) -->
    <ownedProperty name="homeLibrary" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Library -->
  <ownedElements name="Library">
    <!-- Attribute with primitive type -->
    <ownedProperty name="libraryName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Book (containment) -->
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Strong reference to Member (containment) -->
    <ownedProperty name="members" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 4: Person -->
  <ownedElements name="Person">
    <!-- Attribute with primitive type -->
    <ownedProperty name="personName" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 5: PremiumMember, subclass of Person -->
  <ownedElements name="PremiumMember" superClasses="//@ownedElements.4">
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="membershipLevel" isContainment="false"/>
    <!-- Weak reference to Member -->
    <ownedProperty name="linkedMember" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>