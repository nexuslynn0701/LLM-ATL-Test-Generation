<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- Index 0 -->
  <ownedElements name="Library">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="libraryName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference (containment) to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference (non-containment) to Member -->
    <ownedProperty name="registeredMembers" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Book">
    <!-- Attribute without primitiveType (will map to NoType) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- Attribute with primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- Weak reference to Member (borrower) -->
    <ownedProperty name="currentBorrower" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 2: subclass of Person -->
  <ownedElements name="Member" superClasses="//@ownedElements.4">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <!-- Strong reference to Book (borrowed books) -->
    <ownedProperty name="borrowedBooks" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book (works written) -->
    <ownedProperty name="works" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Index 4: superclass, no properties -->
  <ownedElements name="Person"/>
</SimpleUml:Package>