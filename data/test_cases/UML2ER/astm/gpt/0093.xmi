<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- Class 0: Book, with primitive attributes and a strong reference to Publisher -->
  <ownedElements name="Book">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publishedYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 1: Article, subclass of Book, with additional attributes and weak references -->
  <ownedElements name="Article" superClasses="//@ownedElements.0">
    <ownedProperty name="doi" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pageStart" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="pageEnd" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="coAuthor" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher, with a primitive attribute and a strong reference to Address -->
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headquarters" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Person, with attributes, including one with no primitiveType and no complexType -->
  <ownedElements name="Person">
    <ownedProperty name="firstName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="lastName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="birthYear" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="identifier" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Address, used as containment and weak reference target -->
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="zipCode" primitiveType="String" isContainment="false"/>
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 5: Library, referencing Book (strong) and Address (weak) -->
  <ownedElements name="Library">
    <ownedProperty name="libraryName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="mainCollection" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="location" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>