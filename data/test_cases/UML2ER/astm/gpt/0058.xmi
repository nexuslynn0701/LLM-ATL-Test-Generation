<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="EnterpriseDomain">

  <!-- Class 0: Department (no superClasses) -->
  <ownedElements name="Department">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="deptCode" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (will map to NoType) -->
    <ownedProperty name="description" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Team (inherits from Department) -->
  <ownedElements name="Team" superClasses="//@ownedElements.0">
    <!-- Strong reference to Department -->
    <ownedProperty name="parentDepartment" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Weak reference to Person (defined later) -->
    <ownedProperty name="lead" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Person (no superClasses) -->
  <ownedElements name="Person">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Strong self-reference -->
    <ownedProperty name="manager" complexType="//@ownedElements.2" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Employee (inherits from Person and Team) -->
  <ownedElements name="Employee" superClasses="//@ownedElements.2 //@ownedElements.1">
    <!-- Attribute without primitiveType -->
    <ownedProperty name="employeeId" isContainment="false"/>
    <!-- Weak reference to Department -->
    <ownedProperty name="assignedDepartment" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>