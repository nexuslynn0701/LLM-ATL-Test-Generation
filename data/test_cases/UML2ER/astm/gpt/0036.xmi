<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute: title (primitive, with type) -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute: publishedYear (primitive, with type) -->
    <ownedProperty name="publishedYear" primitiveType="Integer" isContainment="false"/>
    <!-- Attribute: notes (primitive, without type -> NoType) -->
    <ownedProperty name="notes" isContainment="false"/>
    <!-- Strong reference: mainAuthor -> Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference: publisher -> Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author" superClasses="//@ownedElements.3">
    <!-- Attribute: fullName (primitive) -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference: primaryAddress -> Address -->
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher -->
  <ownedElements name="Publisher">
    <!-- Attribute: name (primitive) -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Strong reference: headOffice -> Address -->
    <ownedProperty name="headOffice" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: Person (superclass of Author and Member) -->
  <ownedElements name="Person">
    <!-- Attribute: identifier (primitive) -->
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Address -->
  <ownedElements name="Address">
    <!-- Attribute: street (primitive) -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Attribute: city (primitive) -->
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 5: Member (subclass of Person, references Book) -->
  <ownedElements name="Member" superClasses="//@ownedElements.3">
    <!-- Attribute: membershipId (primitive) -->
    <ownedProperty name="membershipId" primitiveType="String" isContainment="false"/>
    <!-- Weak reference: borrowedBook -> Book -->
    <ownedProperty name="borrowedBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>