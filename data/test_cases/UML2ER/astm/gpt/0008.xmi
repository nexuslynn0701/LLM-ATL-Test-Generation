<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (will map to NoType) -->
    <ownedProperty name="publicationYear" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book (non-containment, bidirectional style) -->
    <ownedProperty name="writtenBooks" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Strong reference to Address -->
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Class 2: Publisher, subclass of Party and AddressHolder -->
  <ownedElements name="Publisher" superClasses="//@ownedElements.4 //@ownedElements.5">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Address -->
    <ownedProperty name="headquarters" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="publishedBooks" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Address -->
  <ownedElements name="Address">
    <!-- All attributes; no complexType -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <!-- Attribute with no primitiveType set (NoType) -->
    <ownedProperty name="postalCode" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: Party -->
  <ownedElements name="Party">
    <!-- Attribute only -->
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 5: AddressHolder -->
  <ownedElements name="AddressHolder">
    <!-- Strong reference to Address -->
    <ownedProperty name="address" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>