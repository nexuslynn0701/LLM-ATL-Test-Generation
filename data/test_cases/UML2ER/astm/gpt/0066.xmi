<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- 0 -->
  <ownedElements name="Item">
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="isbn" primitiveType="" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="fullname" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Loan">
    <ownedProperty name="loanId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="borrowedItem" complexType="//@ownedElements.0" isContainment="true"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Author" superClasses="//@ownedElements.2">
    <ownedProperty name="penName" primitiveType="" isContainment="false"/>
    <ownedProperty name="booksWritten" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Publisher">
    <ownedProperty name="publisherId" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publishedBooks" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
</SimpleUml:Package>