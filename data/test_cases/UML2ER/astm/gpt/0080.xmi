<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements xmi:type="SimpleUml:Class" name="Book">
    <!-- Attribute with primitive type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitive type (NoType case) -->
    <ownedProperty name="isbn" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements xmi:type="SimpleUml:Class" name="Author">
    <!-- Strong reference to Book -->
    <ownedProperty name="mainWork" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="relatedBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Publisher, subclass of Author -->
  <ownedElements xmi:type="SimpleUml:Class" name="Publisher" superClasses="//@ownedElements.1">
    <!-- Strong self-reference -->
    <ownedProperty name="parentCompany" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak reference to Author -->
    <ownedProperty name="contactAuthor" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Attribute with primitive type -->
    <ownedProperty name="country" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Class 3: Library, subclass of Publisher -->
  <ownedElements xmi:type="SimpleUml:Class" name="Library" superClasses="//@ownedElements.2">
    <!-- Strong reference to Book -->
    <ownedProperty name="collection" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="managementCompany" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Attribute without primitive type (NoType case) -->
    <ownedProperty name="internalCode" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>