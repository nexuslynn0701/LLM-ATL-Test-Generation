<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- Class 0: Library -->
  <ownedElements name="Library">
    <!-- primitive attribute with type -->
    <ownedProperty name="libraryName" primitiveType="String" isContainment="false"/>
    <!-- containment reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- non-containment reference to Member -->
    <ownedProperty name="registeredMembers" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>
  <!-- Class 1: Book -->
  <ownedElements name="Book">
    <!-- primitive attribute without type (NoType) -->
    <ownedProperty name="isbn" isContainment="false"/>
    <!-- primitive attribute with type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- strong containment reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.3" isContainment="true"/>
    <!-- weak reference to Library (back reference) -->
    <ownedProperty name="owningLibrary" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <!-- Class 2: Member, subclass of Person -->
  <ownedElements name="Member" superClasses="//@ownedElements.4">
    <!-- primitive attribute with type -->
    <ownedProperty name="memberId" primitiveType="Integer" isContainment="false"/>
    <!-- weak reference to Library -->
    <ownedProperty name="homeLibrary" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <!-- Class 3: Author -->
  <ownedElements name="Author">
    <!-- primitive attribute with type -->
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
    <!-- strong containment reference to Book (for authoredBooks collection) -->
    <ownedProperty name="authoredBooks" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <!-- Class 4: Person, superclass of Member -->
  <ownedElements name="Person">
    <!-- primitive attribute with type -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without type (NoType) -->
    <ownedProperty name="age" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>