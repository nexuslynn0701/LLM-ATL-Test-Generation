<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- 0 -->
  <ownedElements name="Item">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
  </ownedElements>

  <!-- 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="summary" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="true"/>
    <ownedProperty name="coAuthors" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 2 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- 3 -->
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <ownedProperty name="publishedBooks" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- 4 -->
  <ownedElements name="Member">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedItems" complexType="//@ownedElements.0" isContainment="false"/>
    <ownedProperty name="preferredPublisher" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- 5 -->
  <ownedElements name="Librarian" superClasses="//@ownedElements.4 //@ownedElements.0">
    <ownedProperty name="employeeNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="managedMembers" complexType="//@ownedElements.4" isContainment="true"/>
    <ownedProperty name="managedBooks" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>