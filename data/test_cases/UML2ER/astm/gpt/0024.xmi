<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Book -->
  <ownedElements name="Book">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType undefined (should become NoType) -->
    <ownedProperty name="edition" isContainment="false"/>
  </ownedElements>

  <!-- Class 1: Author -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book (non-containment, complexType set) -->
    <ownedProperty name="favoriteBook" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Library, superclass of PublicLibrary and UniversityLibrary -->
  <ownedElements name="Library">
    <!-- Strong containment reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Strong containment reference to Author -->
    <ownedProperty name="authors" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Class 3: PublicLibrary extends Library -->
  <ownedElements name="PublicLibrary" superClasses="//@ownedElements.2">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Library (non-containment) -->
    <ownedProperty name="partnerLibrary" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Class 4: UniversityLibrary extends Library -->
  <ownedElements name="UniversityLibrary" superClasses="//@ownedElements.2">
    <!-- Attribute with primitiveType undefined (NoType) -->
    <ownedProperty name="campusCode" isContainment="false"/>
    <!-- Strong containment reference to Author -->
    <ownedProperty name="residentScholar" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>