<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- 0 -->
  <ownedElements name="Item">
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
    <ownedProperty name="createdOn" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pageCount" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="publisher" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Member" superClasses="//@ownedElements.0">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <ownedProperty name="activeCard" complexType="//@ownedElements.3" isContainment="true"/>
    <ownedProperty name="currentLoan" complexType="//@ownedElements.5" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Card">
    <ownedProperty name="number" primitiveType="String" isContainment="false"/>
    <ownedProperty name="expiryDate" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Publisher">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="headquarters" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Loan">
    <ownedProperty name="loanedBook" complexType="//@ownedElements.1" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.2" isContainment="false"/>
    <ownedProperty name="startDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="endDate" primitiveType="Date" isContainment="false"/>
    <!-- primitiveType intentionally omitted to get 'NoType' in target -->
    <ownedProperty name="notes" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>