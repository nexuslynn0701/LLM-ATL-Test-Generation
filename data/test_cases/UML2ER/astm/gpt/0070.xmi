<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Class 0: Member (no properties) -->
  <ownedElements name="Member"/>

  <!-- Class 1: Book with primitive and NoType attributes and a weak reference -->
  <ownedElements name="Book">
    <!-- primitive attribute with type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- primitive attribute without type (will become 'NoType') -->
    <ownedProperty name="shelfCode" isContainment="false"/>
    <!-- weak reference to Member (not containment) -->
    <ownedProperty name="borrower"
                   complexType="//@ownedElements.0"
                   isContainment="false"/>
  </ownedElements>

  <!-- Class 2: Library with strong and weak references, and a primitive attribute -->
  <ownedElements name="Library">
    <!-- strong reference: containment to Book -->
    <ownedProperty name="books"
                   complexType="//@ownedElements.1"
                   isContainment="true"/>
    <!-- weak reference: non-containment to Member -->
    <ownedProperty name="registeredMembers"
                   complexType="//@ownedElements.0"
                   isContainment="false"/>
    <!-- primitive attribute with explicit type -->
    <ownedProperty name="location"
                   primitiveType="String"
                   isContainment="false"/>
  </ownedElements>

  <!-- Class 3: DigitalLibrary inheriting from Library and with mixed properties -->
  <ownedElements name="DigitalLibrary" superClasses="//@ownedElements.2">
    <!-- primitive attribute without type (NoType) -->
    <ownedProperty name="url"
                   isContainment="false"/>
    <!-- strong reference to Member (containment) -->
    <ownedProperty name="premiumMember"
                   complexType="//@ownedElements.0"
                   isContainment="true"/>
    <!-- weak reference to Book (non-containment) -->
    <ownedProperty name="featuredBook"
                   complexType="//@ownedElements.1"
                   isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>