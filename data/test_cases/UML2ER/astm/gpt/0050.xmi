<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">

  <!-- Index 0 -->
  <ownedElements name="Item">
    <!-- Attribute with primitive type -->
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitive type -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <!-- Attribute with primitive type -->
    <ownedProperty name="pageCount" primitiveType="Integer" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Author">
    <!-- Attribute with primitive type -->
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Strong reference back to Book (composition) -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Publisher">
    <!-- Attribute with primitive type -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="publishedBooks" complexType="//@ownedElements.1" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Library" superClasses="//@ownedElements.0">
    <!-- Strong reference to Book -->
    <ownedProperty name="books" complexType="//@ownedElements.1" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="partnerPublishers" complexType="//@ownedElements.3" isContainment="false"/>
    <!-- Attribute with primitive type -->
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType and without complexType -->
    <ownedProperty name="note" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>