<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibraryDomain">

  <!-- Index 0 -->
  <ownedElements name="Item">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="legacyCode" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.2" isContainment="true"/>
    <!-- Weak reference to Publisher -->
    <ownedProperty name="publisher" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Author">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <!-- Self weak reference (e.g., mentor) -->
    <ownedProperty name="mentor" complexType="//@ownedElements.2" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Publisher">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="companyName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Address -->
    <ownedProperty name="headOffice" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Address">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="postcode" isContainment="false"/>
  </ownedElements>

  <!-- Index 5 -->
  <ownedElements name="LibraryBranch" superClasses="//@ownedElements.0">
    <!-- Attribute with primitiveType -->
    <ownedProperty name="branchName" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Address -->
    <ownedProperty name="location" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>

</SimpleUml:Package>