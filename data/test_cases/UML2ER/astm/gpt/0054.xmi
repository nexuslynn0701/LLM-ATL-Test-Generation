<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="OnlineShopModel">

  <!-- Index 0 -->
  <ownedElements name="User">
    <!-- Attribute with primitiveType set -->
    <ownedProperty name="username" primitiveType="String" isContainment="false"/>
    <!-- Attribute with primitiveType missing (NoType case) -->
    <ownedProperty name="nickname" isContainment="false"/>
  </ownedElements>

  <!-- Index 1 -->
  <ownedElements name="Product">
    <!-- Weak reference to Category -->
    <ownedProperty name="categoryRef" complexType="//@ownedElements.2" isContainment="false"/>
    <!-- Strong reference to Review -->
    <ownedProperty name="reviews" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>

  <!-- Index 2 -->
  <ownedElements name="Category">
    <!-- Weak reference back to Product (association kind) -->
    <ownedProperty name="products" complexType="//@ownedElements.1" isContainment="false"/>
    <!-- Attribute without primitiveType (NoType) -->
    <ownedProperty name="description" isContainment="false"/>
  </ownedElements>

  <!-- Index 3 -->
  <ownedElements name="Review" superClasses="//@ownedElements.4">
    <!-- Strong reference to User (containment) -->
    <ownedProperty name="author" complexType="//@ownedElements.0" isContainment="true"/>
    <!-- Attribute with primitiveType -->
    <ownedProperty name="rating" primitiveType="Integer" isContainment="false"/>
  </ownedElements>

  <!-- Index 4 -->
  <ownedElements name="Comment">
    <!-- Weak reference to User -->
    <ownedProperty name="commenter" complexType="//@ownedElements.0" isContainment="false"/>
    <!-- Attribute with primitiveType -->
    <ownedProperty name="content" primitiveType="String" isContainment="false"/>
  </ownedElements>

</SimpleUml:Package>