<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- 0 -->
  <ownedElements name="Item">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 1 -->
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="summary" isContainment="false"/>
    <ownedProperty name="primaryAuthor" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="chapters" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <!-- 2 -->
  <ownedElements name="Journal" superClasses="//@ownedElements.0">
    <ownedProperty name="issueNumber" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="editor" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <!-- 3 -->
  <ownedElements name="Person">
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <!-- 4 -->
  <ownedElements name="Member" superClasses="//@ownedElements.3">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="borrowedItems" complexType="//@ownedElements.0" isContainment="false"/>
  </ownedElements>
  <!-- 5 -->
  <ownedElements name="Chapter">
    <ownedProperty name="number" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>