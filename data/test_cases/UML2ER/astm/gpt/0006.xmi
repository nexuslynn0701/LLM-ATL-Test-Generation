<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <ownedElements name="Publication">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pubYear" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="PrintedBook" superClasses="//@ownedElements.0">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pages" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Author">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="birthYear" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="LibraryMember">
    <ownedProperty name="memberId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="LibraryBranch">
    <ownedProperty name="branchName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="location" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Loan">
    <ownedProperty name="loanDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="dueDate" primitiveType="Date" isContainment="false"/>
    <ownedProperty name="borrower" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="item" complexType="//@ownedElements.1" isContainment="true"/>
  </ownedElements>
  <ownedElements name="EBook" superClasses="//@ownedElements.0">
    <ownedProperty name="fileSizeMB" primitiveType="Float" isContainment="false"/>
    <ownedProperty name="downloadUrl" primitiveType="String" isContainment="false"/>
  </ownedElements>
  <ownedElements name="CatalogEntry">
    <ownedProperty name="catalogId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="tags" primitiveType="" isContainment="false"/>
    <ownedProperty name="primaryPublication" complexType="//@ownedElements.0" isContainment="true"/>
    <ownedProperty name="relatedPublication" complexType="//@ownedElements.6" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>