<SimpleUml:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:SimpleUml="http://SimpleUML" name="LibrarySystem">
  <ownedElements name="Item">
    <ownedProperty name="identifier" primitiveType="String" isContainment="false"/>
    <ownedProperty name="classificationCode" primitiveType="" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Book" superClasses="//@ownedElements.0">
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <ownedProperty name="summary" primitiveType="" isContainment="false"/>
    <ownedProperty name="mainAuthor" complexType="//@ownedElements.3" isContainment="false"/>
    <ownedProperty name="chapters" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Magazine" superClasses="//@ownedElements.0">
    <ownedProperty name="issueNumber" primitiveType="Integer" isContainment="false"/>
    <ownedProperty name="editor" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Person">
    <ownedProperty name="fullName" primitiveType="String" isContainment="false"/>
    <ownedProperty name="primaryAddress" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <ownedElements name="Chapter">
    <ownedProperty name="heading" primitiveType="String" isContainment="false"/>
    <ownedProperty name="pageCount" primitiveType="Integer" isContainment="false"/>
  </ownedElements>
  <ownedElements name="Address">
    <ownedProperty name="street" primitiveType="String" isContainment="false"/>
    <ownedProperty name="city" primitiveType="String" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>