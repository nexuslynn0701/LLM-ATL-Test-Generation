<SimpleUml:Package xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:SimpleUml="http://SimpleUML"
    name="LibrarySystem">
  <!-- Index 0 -->
  <ownedElements name="Person">
    <ownedProperty name="id" primitiveType="String" isContainment="false"/>
    <ownedProperty name="fullName" primitiveType="String" isContainment="true"/>
    <ownedProperty name="birthDate" primitiveType="Date" isContainment="false"/>
  </ownedElements>
  <!-- Index 1 -->
  <ownedElements name="Member" superClasses="//@ownedElements.0">
    <ownedProperty name="membershipNumber" primitiveType="String" isContainment="false"/>
    <ownedProperty name="email" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Library -->
    <ownedProperty name="homeLibrary" complexType="//@ownedElements.4" isContainment="true"/>
  </ownedElements>
  <!-- Index 2 -->
  <ownedElements name="Staff" superClasses="//@ownedElements.0">
    <ownedProperty name="employeeId" primitiveType="String" isContainment="false"/>
    <ownedProperty name="role" primitiveType="String" isContainment="true"/>
    <!-- Weak reference to Library -->
    <ownedProperty name="worksAt" complexType="//@ownedElements.4" isContainment="false"/>
  </ownedElements>
  <!-- Index 3 -->
  <ownedElements name="Book">
    <ownedProperty name="isbn" primitiveType="String" isContainment="false"/>
    <ownedProperty name="title" primitiveType="String" isContainment="false"/>
    <!-- Attribute with undefined primitiveType -->
    <ownedProperty name="description" isContainment="false"/>
    <!-- Strong reference to Author -->
    <ownedProperty name="writtenBy" complexType="//@ownedElements.5" isContainment="true"/>
  </ownedElements>
  <!-- Index 4 -->
  <ownedElements name="Library">
    <ownedProperty name="code" primitiveType="String" isContainment="false"/>
    <ownedProperty name="name" primitiveType="String" isContainment="false"/>
    <!-- Strong reference to Book -->
    <ownedProperty name="collection" complexType="//@ownedElements.3" isContainment="true"/>
  </ownedElements>
  <!-- Index 5 -->
  <ownedElements name="Author" superClasses="//@ownedElements.0">
    <ownedProperty name="penName" primitiveType="String" isContainment="false"/>
    <!-- Weak reference to Book -->
    <ownedProperty name="notableWork" complexType="//@ownedElements.3" isContainment="false"/>
  </ownedElements>
</SimpleUml:Package>