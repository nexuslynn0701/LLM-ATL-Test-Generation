<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://example/rootPkg"
    nsPrefix="root">
  <!-- Class 0: Root class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass">
    <!-- Attribute 0: String, lower=0, upper=-1, not ID, with default -->
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="title"
        lowerBound="0"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"
        ordered="true"
        unique="true"
        defaultValueLiteral="defaultTitle"/>
    <!-- Attribute 1: Int, lower=1, upper=1, is ID, no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="identifier"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"
        ordered="true"
        unique="true"/>
    <!-- Attribute 2: Enum-typed, lower=0, upper=1, with default enum literal -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.4"
        iD="false"
        ordered="true"
        unique="true"
        defaultValueLiteral="ACTIVE"/>
    <!-- Reference 0: containment to SubClassA, lower=0, upper=-1, no opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="childrenA"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.1"
        containment="true"
        resolveProxies="true"
        ordered="true"
        unique="true"/>
    <!-- Reference 1: non-containment to SubClassB, lower=1, upper=1, opposite set below -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="mainB"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.2"
        containment="false"
        resolveProxies="true"
        ordered="true"
        unique="true"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- Class 1: SubClassA extends RootClass, has one reference back and one attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClassA">
    <!-- Super type: RootClass -->
    <eSuperTypes href="//@eClassifiers.0"/>
    <!-- Reference 0: to RootClass, non-containment, upper=-1, no opposite -->
    <eStructuralFeatures xsi:type="eccore:EReference"
        name="ownerRoots"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.0"
        containment="false"
        resolveProxies="true"
        ordered="true"
        unique="false"/>
    <!-- Attribute 0: Boolean, lower=0, upper=1, with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        iD="false"
        ordered="true"
        unique="true"
        defaultValueLiteral="true"/>
  </eClassifiers>

  <!-- Class 2: SubClassB, super type set via eSuperTypes, has opposite reference -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClassB">
    <!-- Super type: SubClassA -->
    <eSuperTypes href="//@eClassifiers.1"/>
    <!-- Reference 0: opposite of RootClass.mainB -->
    <eStructuralFeatures xsi:type="eccore:EReference"
        name="rootOwner"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.0"
        containment="false"
        resolveProxies="true"
        ordered="true"
        unique="true"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.4"/>
    <!-- Attribute 0: Double, lower=0, upper=1, no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="ratio"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        iD="false"
        ordered="true"
        unique="false"/>
  </eClassifiers>

  <!-- Class 3: Independent class to increase variety -->
  <eClassifiers xsi:type="ecore:EClass" name="AuxClass">
    <!-- Attribute 0: String, lower=0, upper=1 -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="description"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"
        ordered="true"
        unique="true"/>
    <!-- Reference 0: to RootClass, containment=false, many, no opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="relatedRoots"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.0"
        containment="false"
        resolveProxies="true"
        ordered="true"
        unique="true"/>
  </eClassifiers>

  <!-- Enum 4: Simple status enum with three literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
    <eLiterals name="PENDING" value="2" literal="PENDING"/>
  </eClassifiers>
</ecore:EPackage>