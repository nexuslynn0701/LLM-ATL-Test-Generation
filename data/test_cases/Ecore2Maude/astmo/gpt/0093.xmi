<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg93"
    nsURI="http://example.org/rootPkg93"
    nsPrefix="r93">

  <!-- Classifier 0: EClass Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <!-- Attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        iD="true"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        iD="false"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="John &quot;Doe&quot;"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- References -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="addresses"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="spouse"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- Classifier 1: EClass Address -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        iD="false"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="Main St."
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="zip"
        iD="false"
        lowerBound="0"
        upperBound="1"
        ordered="false"
        unique="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        lowerBound="0"
        upperBound="1"
        ordered="false"
        unique="true"
        containment="false"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- Classifier 2: EEnum Color -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <!-- Classifier 3: EClass ColoredAddress extends Address -->
  <eClassifiers xsi:type="ecore:EClass" name="ColoredAddress"
      abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="color"
        iD="false"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

</ecore:EPackage>