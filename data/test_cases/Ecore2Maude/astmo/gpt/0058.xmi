<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="metaRoot"
    nsURI="http://metaRoot/1.0"
    nsPrefix="mr">

  <!-- Classifiers index:
       0 Person (EClass)
       1 Employee (EClass, extends Person)
       2 Department (EClass, has references and attributes)
       3 Project (EClass, has enum attribute)
       4 Status (EEnum)
       5 PrimitiveAlias (EDataType, custom primitive)
  -->

  <!-- 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="John &quot;Doe&quot;"/>
  </eClassifiers>

  <!-- 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="salary"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="department"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"
        containment="false"/>
  </eClassifiers>

  <!-- 2 -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employees"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.1"
        containment="true">
    </eStructuralFeatures>
  </eClassifiers>

  <!-- 3 -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 4 -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="PLANNED" value="0" literal="PLANNED"/>
    <eLiterals name="ONGOING" value="1" literal="ONGOING"/>
    <eLiterals name="FINISHED" value="2" literal="FINISHED"/>
  </eClassifiers>

  <!-- 5 -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="PrimitiveAlias"
      instanceClassName="java.lang.String"/>

</ecore:EPackage>