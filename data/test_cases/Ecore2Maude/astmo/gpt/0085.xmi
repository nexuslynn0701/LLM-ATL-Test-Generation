<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="RootMM"
    nsURI="http://rootmm/1.0"
    nsPrefix="root">

  <!-- Classifier 0: RootClass -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <!-- Attribute 0: idAttr (String, ID, lower=1, upper=1) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="idAttr"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="root-id"
        iD="true"/>
    <!-- Attribute 1: flag (Boolean, lower=0, upper=1) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Reference 2: child (containment, to ChildClass, lower=0, upper=-1, opposite backRef) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="child"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.1"
        containment="true"
        resolveProxies="true"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- Classifier 1: ChildClass -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" abstract="false" interface="false">
    <!-- Attribute 0: value (Int, lower=0, upper=1) -->
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="value"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference 1: backRef (non-containment, to RootClass, lower=0, upper=1, opposite child) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="backRef"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.0"
        containment="false"
        resolveProxies="true"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- Classifier 2: AbstractBase (abstract superclass of ChildClass) -->
  <eClassifiers xsi:type="ecore:EClass" name="AbstractBase" abstract="true" interface="false">
    <!-- Attribute 0: baseName (String, lower=0, upper=1) -->
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="baseName"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Make ChildClass extend AbstractBase -->
  <eClassifiers xsi:type="ecore:EClass" xmi:id="_childTmp" name="ChildClassTmpRef"/>

  <!-- Classifier 3: StatusEnum -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="DONE" value="1" literal="DONE"/>
  </eClassifiers>

  <!-- Classifier 4: HolderClass, with enum attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="HolderClass" abstract="false" interface="false">
    <!-- Attribute 0: status (StatusEnum, lower=0, upper=1, default DONE) -->
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="status"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.3"
        defaultValueLiteral="DONE"/>
  </eClassifiers>

  <!-- Proper definition for ChildClass with super type fixed (override temporary one) -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" abstract="false" interface="false" eSuperTypes="//@eClassifiers.2">
    <!-- Attribute 0: value (Int, lower=0, upper=1) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="value"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference 1: backRef (non-containment, to RootClass, lower=0, upper=1, opposite child) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="backRef"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.0"
        containment="false"
        resolveProxies="true"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

</ecore:EPackage>