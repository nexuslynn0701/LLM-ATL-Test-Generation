<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="RootPkg"
    nsURI="http://example/rootpkg"
    nsPrefix="root">
  <!-- EClass: Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="personId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"
        upperBound="1"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="fullName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="John &quot;Johnny&quot; Doe"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        eType="//@eClassifiers.4"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="ACTIVE"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="manager"
        eType="//@eClassifiers.0"
        lowerBound="0"
        upperBound="1"
        containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="projects"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="-1"
        containment="true"/>
  </eClassifiers>

  <!-- EClass: Project -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="PRJ-001"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="budget"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="100000.0"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        eType="//@eClassifiers.0"
        lowerBound="1"
        upperBound="1"
        containment="false"/>
  </eClassifiers>

  <!-- EClass: Task extends Project -->
  <eClassifiers xsi:type="ecore:EClass" name="Task" abstract="true">
    <eSuperTypes>//@eClassifiers.1</eSuperTypes>
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="priority"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="1"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="assignee"
        eType="//@eClassifiers.0"
        lowerBound="0"
        upperBound="1"
        containment="false"/>
  </eClassifiers>

  <!-- EClass: Milestone extends Task -->
  <eClassifiers xsi:type="ecore:EClass" name="Milestone">
    <eSuperTypes>//@eClassifiers.2</eSuperTypes>
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="dueDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"
        lowerBound="0"
        upperBound="1"
        iD="false"/>
  </eClassifiers>

  <!-- EEnum: Status -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
    <eLiterals name="PENDING" value="2" literal="PENDING"/>
  </eClassifiers>
</ecore:EPackage>