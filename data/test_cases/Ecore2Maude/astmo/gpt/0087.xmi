<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="libraryPkg"
    nsURI="http://example.org/library"
    nsPrefix="lib">

  <!-- Classifiers order is important for index-based references -->

  <!-- 0: EClass Library -->
  <eClassifiers xsi:type="ecore:EClass" name="Library">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="libName"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                         lowerBound="1"
                         upperBound="1"
                         iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="books"
                         eType="//@eClassifiers.1"
                         lowerBound="0"
                         upperBound="-1"
                         containment="true"
                         resolveProxies="true"/>
  </eClassifiers>

  <!-- 1: EClass Book -->
  <eClassifiers xsi:type="ecore:EClass" name="Book">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="title"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                         lowerBound="1"
                         upperBound="1"
                         iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="pages"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                         lowerBound="0"
                         upperBound="1"
                         iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="author"
                         eType="//@eClassifiers.2"
                         lowerBound="1"
                         upperBound="1"
                         containment="false"
                         resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="category"
                         eType="//@eClassifiers.5"
                         lowerBound="0"
                         upperBound="1"
                         iD="false"/>
  </eClassifiers>

  <!-- 2: EClass Writer -->
  <eClassifiers xsi:type="ecore:EClass" name="Writer">
    <eStructuralFeatures xsi:type="eccore:EAttribute"
                         name="penName"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                         lowerBound="0"
                         upperBound="1"
                         iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="writtenBooks"
                         eType="//@eClassifiers.1"
                         lowerBound="0"
                         upperBound="-1"
                         containment="false"
                         resolveProxies="true"/>
  </eClassifiers>

  <!-- 3: EClass PrintedItem extends Book to trigger superTypes handling -->
  <eClassifiers xsi:type="ecore:EClass" name="PrintedItem">
    <eSuperTypes>//@eClassifiers.1</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="isbn"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                         lowerBound="0"
                         upperBound="1"
                         iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="relatedItems"
                         eType="//@eClassifiers.3"
                         lowerBound="0"
                         upperBound="-1"
                         containment="false"
                         resolveProxies="true"/>
  </eClassifiers>

  <!-- 4: EClass DigitalItem (no features, still triggers Class2Sort etc.) -->
  <eClassifiers xsi:type="ecore:EClass" name="DigitalItem"/>

  <!-- 5: EEnum Category -->
  <eClassifiers xsi:type="ecore:EEnum" name="Category">
    <eLiterals name="Science" value="0" literal="Science"/>
    <eLiterals name="Novel" value="1" literal="Novel"/>
    <eLiterals name="History" value="2" literal="History"/>
  </eClassifiers>

</ecore:EPackage>