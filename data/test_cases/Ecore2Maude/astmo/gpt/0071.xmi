<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="meta71"
    nsURI="http://meta71"
    nsPrefix="m71">

  <!-- Class Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false">
    <!-- Attribute id : EInt, lower=1 upper=1, ID=true, defaultValueLiteral="1" -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="1"/>
    <!-- Attribute name : EString, lower=0 upper=1, defaultValueLiteral="John&quot;Doe" -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="John&quot;Doe"/>
    <!-- Reference addresses : Address [0..*], non-containment, opposite person -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="addresses"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- Class Address -->
  <eClassifiers xsi:type="ecore:EClass" name="Address" abstract="false" interface="false">
    <!-- Attribute street : EString [0..1] -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Reference person : Person [0..1], containment, opposite addresses -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="person"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- Enum Color with three literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <!-- Class Car with an enum-typed attribute and a reference to Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Car" abstract="false" interface="false">
    <!-- Attribute plate : EString [0..1] -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="plate"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute color : Color [0..1] with default GREEN -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="color"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="//@eClassifiers.2"
        defaultValueLiteral="GREEN"/>
    <!-- Reference owner : Person [0..1], non-containment -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

</ecore:EPackage>