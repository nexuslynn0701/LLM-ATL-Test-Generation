<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="mm62"
    nsURI="http://mm62"
    nsPrefix="mm62">

  <!-- EClass: Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <!-- Attribute: id (EInt, iD=true, lower=1 upper=1) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"/>
    <!-- Attribute: name (EString, lower=1 upper=1, default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="John"/>
    <!-- Reference: friends (many, not containment, opposite in FriendRel) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="friends"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- EClass: Address -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <!-- Attribute: street (EString, lower=0 upper=1) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute: number (EInt, lower=0 upper=1, default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="number"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="0"/>
    <!-- Reference: owner (to Person, containment=true, opposite in PersonAddressLink) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.0"
        containment="true"/>
  </eClassifiers>

  <!-- EClass: FriendRel (association-like, between Person instances) -->
  <eClassifiers xsi:type="ecore:EClass" name="FriendRel">
    <!-- Reference: from (to Person, opposite to Person.friends, containment=false) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="from"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
    <!-- Reference: to (to Person, no opposite, containment=false) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="to"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- EEnum: Status with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="OLD" value="1" literal="OLD"/>
  </eClassifiers>

  <!-- EClass: Project with attribute of enum type -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <!-- Attribute: status (typed by Status enum, lower=0 upper=1, default=NEW) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.3"
        defaultValueLiteral="NEW"/>
    <!-- Attribute: title (EString, lower=1 upper=1) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Reference: lead (to Person, lower=1 upper=1, containment=false) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="lead"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

</ecore:EPackage>