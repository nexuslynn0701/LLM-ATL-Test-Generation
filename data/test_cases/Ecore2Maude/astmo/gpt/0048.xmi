<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootMM"
    nsURI="http://rootMM/1.0"
    nsPrefix="root">

  <!-- Class 0: Root with only attributes -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"
        ordered="true"
        unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        iD="false"
        ordered="true"
        unique="true"
        defaultValueLiteral="true"/>
  </eClassifiers>

  <!-- Class 1: Child with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass">
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="code"
        lowerBound="0"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="false"
        ordered="false"
        unique="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="description"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"
        ordered="true"
        unique="true"
        defaultValueLiteral="default description"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.0"
        containment="false"
        resolveProxies="true"
        ordered="true"
        unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="details"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.2"
        containment="true"
        resolveProxies="true"
        ordered="true"
        unique="true"/>
  </eClassifiers>

  <!-- Class 2: Detail with bidirectional reference to ChildClass -->
  <eClassifiers xsi:type="ecore:EClass" name="DetailClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="value"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"
        ordered="true"
        unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.1"
        containment="false"
        resolveProxies="true"
        ordered="true"
        unique="true"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.3"/>
  </eClassifiers>

  <!-- Enumeration 3 with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- Class 4: Uses enum as attribute type -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumUser">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="favoriteColor"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.3"
        iD="false"
        ordered="true"
        unique="true"
        defaultValueLiteral="RED"/>
  </eClassifiers>

</ecore:EPackage>