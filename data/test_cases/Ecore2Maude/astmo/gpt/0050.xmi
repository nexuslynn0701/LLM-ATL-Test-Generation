<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://rootPkg/1.0"
    nsPrefix="root">

  <!-- EClass 0: RootClass, with one attribute and two references -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        iD="true"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="child"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="enumOwner"
        lowerBound="0"
        upperBound="1"
        containment="false"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- EClass 1: ChildClass, subtype of RootClass, with attribute and opposite reference -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="0"
        upperBound="1"
        containment="false"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="value"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- EEnum 2: ColorEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- EClass 3: EnumHolder, with attribute of enum type and a string attribute with default -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumHolder">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="color"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="label"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="defaultLabel"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- EDataType 4: Custom data type, unused but valid -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="CustomData"
      instanceClassName="java.lang.String"/>

</ecore:EPackage>