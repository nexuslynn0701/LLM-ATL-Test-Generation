<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="ShopModel"
    nsURI="http://shop/example"
    nsPrefix="shop">

  <!-- Class 0: Item -->
  <eClassifiers xsi:type="ecore:EClass" name="Item">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="itemId"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="price"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- Class 1: Product extends Item -->
  <eClassifiers xsi:type="ecore:EClass" name="Product"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        upperBound="1"
        iD="false"
        defaultValueLiteral="Unnamed"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="stock"
        lowerBound="0"
        upperBound="-1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- Class 2: Customer -->
  <eClassifiers xsi:type="ecore:EClass" name="Customer">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="customerId"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="vip"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- Class 3: Order -->
  <eClassifiers xsi:type="ecore:EClass" name="Order">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="orderNumber"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="customer"
        lowerBound="1"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="lines"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- Class 4: OrderLine -->
  <eClassifiers xsi:type="ecore:EClass" name="OrderLine">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="quantity"
        lowerBound="1"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="product"
        lowerBound="1"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Enum 5: Status -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="PAID" value="1" literal="PAID"/>
    <eLiterals name="SHIPPED" value="2" literal="SHIPPED"/>
  </eClassifiers>

</ecore:EPackage>