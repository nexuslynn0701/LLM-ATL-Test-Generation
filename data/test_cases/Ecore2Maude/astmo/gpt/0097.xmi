<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="mm97"
    nsURI="http://mm97"
    nsPrefix="mm97">

  <!-- Classifiers index:
       0 Person (EClass)
       1 Address (EClass)
       2 Color (EEnum)
       3 Note (EClass)
  -->

  <!-- EClass 0: Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <!-- attribute: id (EString, ID=true, lower=1, upper=1) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- attribute: age (EInt, lower=0, upper=1, default 0) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- reference: home (to Address, containment=true, lower=0, upper=1, opposite resident) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="home"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="true"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- EClass 1: Address -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <!-- opposite ref: resident (to Person, containment=false, lower=0, upper=-1) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="resident"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
    <!-- attribute: street (EString, lower=1, upper=1, default "unknown") -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="unknown"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- attribute: color (EEnum Color, lower=0, upper=1, default RED) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="color"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"
        defaultValueLiteral="RED"/>
  </eClassifiers>

  <!-- EEnum 2: Color with 3 literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <!-- EClass 3: Note (no features, tests EmptyList handling for classes) -->
  <eClassifiers xsi:type="ecore:EClass" name="Note"/>

</ecore:EPackage>