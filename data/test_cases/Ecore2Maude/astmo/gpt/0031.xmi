<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="metamodel31"
    nsURI="http://metamodel31"
    nsPrefix="mm31">

  <!-- Root package classifiers -->
  <eClassifiers xsi:type="ecore:EClass" name="Alpha">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="alphaId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"
        upperBound="1"
        iD="true"
        ordered="true"
        unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="betaRef"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        ordered="true"
        unique="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Beta">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="betaName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        iD="false"
        ordered="true"
        unique="true"
        defaultValueLiteral="defaultBeta"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="alphaBack"
        eType="//@eClassifiers.0"
        lowerBound="0"
        upperBound="1"
        containment="false"
        ordered="true"
        unique="true"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="ColorKind">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <!-- Subpackage to exercise superPackage/subPackages relationships -->
  <eSubpackages name="subpkg31"
      nsURI="http://metamodel31/sub"
      nsPrefix="mm31sub">

    <eClassifiers xsi:type="ecore:EClass" name="Gamma">
      <eSuperTypes>//@eClassifiers.0</eSuperTypes>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="gammaFlag"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
          lowerBound="0"
          upperBound="1"
          iD="false"
          ordered="true"
          unique="true"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="gammaColor"
          eType="//@eClassifiers.2"
          lowerBound="0"
          upperBound="1"
          iD="false"
          ordered="true"
          unique="true"
          defaultValueLiteral="RED"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="alphaLink"
          eType="//@eClassifiers.0"
          lowerBound="1"
          upperBound="1"
          containment="false"
          ordered="true"
          unique="true"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EEnum" name="ModeKind">
      <eLiterals name="ON" value="0" literal="ON"/>
      <eLiterals name="OFF" value="1" literal="OFF"/>
    </eClassifiers>

  </eSubpackages>

</ecore:EPackage>