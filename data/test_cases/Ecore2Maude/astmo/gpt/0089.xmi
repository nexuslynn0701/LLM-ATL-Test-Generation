<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="metaRoot"
    nsURI="http://metaroot/1.0"
    nsPrefix="mr">

  <!-- Class 0: A -->
  <eClassifiers xsi:type="ecore:EClass" name="A">
    <!-- attribute aId: String, ID, lower=1, upper=1, ordered=false, unique=true -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="aId"
        ordered="false"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <!-- attribute aFlag: Boolean, lower=0, upper=-1 (*), ordered=false, unique=true -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="aFlag"
        ordered="false"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- Class 1: B -->
  <eClassifiers xsi:type="ecore:EClass" name="B">
    <!-- attribute code: Int, lower=0, upper=1, ordered=true, unique=false, defaultValueLiteral -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        ordered="true"
        unique="false"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="0"/>
  </eClassifiers>

  <!-- Class 2: C -->
  <eClassifiers xsi:type="ecore:EClass" name="C">
    <!-- reference linkAB: containment to A, lower=0, upper=-1 (*), ordered=false, unique=false -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="linkAB"
        ordered="false"
        unique="false"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.0"
        containment="true"/>
  </eClassifiers>

  <!-- Enum 3: KindEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="KindEnum">
    <eLiterals name="KIND_ONE" value="0" literal="KIND_ONE"/>
    <eLiterals name="KIND_TWO" value="1" literal="KIND_TWO"/>
  </eClassifiers>

  <!-- Class 4: D with an enum-typed attribute having specific default value -->
  <eClassifiers xsi:type="ecore:EClass" name="D">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="kind"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.3"
        defaultValueLiteral="KIND_ONE"/>
  </eClassifiers>

</ecore:EPackage>