<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://example/rootPkg"
    nsPrefix="root">
  <!-- EClass: BaseClass -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass">
    <!-- Attribute 'id' with default value, EInt, is ID -->
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="id"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="0"/>
    <!-- Reference 'selfRef' non-containment, upperBound -1 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="selfRef"
        eType="//@eClassifiers.0"
        containment="false"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"/>
  </eClassifiers>

  <!-- EClass: SubClass extends BaseClass, with attribute and two refs (one bidirectional) -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <!-- Attribute 'name' EString, not ID -->
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="defaultName"/>
    <!-- Containment reference to BaseClass with opposite set later -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        eType="//@eClassifiers.0"
        containment="true"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"/>
    <!-- Non-containment reference to EnumClass (no opposite) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="enumRef"
        eType="//@eClassifiers.3"
        containment="false"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"/>
  </eClassifiers>

  <!-- EDataType: CustomDataType -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="CustomDataType"
      instanceClassName="java.lang.String"
      serializable="true"/>

  <!-- EEnum: Color with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- EClass: EnumClass with attribute typed by Color enum -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumClass">
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="color"
        eType="//@eClassifiers.3"
        iD="false"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"/>
  </eClassifiers>
</ecore:EPackage>