<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="mmRoot"
    nsURI="http://mmRoot/1.0"
    nsPrefix="mmRoot">

  <!-- Classifier 0: Container (root class) -->
  <eClassifiers xsi:type="ecore:EClass" name="Container" abstract="false" interface="false">
    <!-- attrA: String attribute, lower=0, upper=1, not ID -->
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="attrA"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <!-- attrB: Int attribute, lower=1, upper=-1, is ID -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="attrB"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="-1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        defaultValueLiteral="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"/>
    <!-- refChild: containment reference to Child, lower=0, upper=-1, has opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="refChild"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"/>
    <!-- refLeaf: non-containment reference to Leaf, lower=1, upper=1, has opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="refLeaf"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.2"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- Classifier 1: Child (extends Container) -->
  <eClassifiers xsi:type="ecore:EClass" name="Child" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- refParent: opposite of Container.refChild -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="refParent"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
    <!-- refLeafs: non-containment, multi-valued, opposite of Leaf.refOwner -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="refLeafs"
        ordered="false"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.2"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.1"/>
    <!-- attrC: Boolean attribute with default value -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="attrC"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        iD="false"/>
  </eClassifiers>

  <!-- Classifier 2: Leaf (no inheritance) -->
  <eClassifiers xsi:type="ecore:EClass" name="Leaf" abstract="false" interface="false">
    <!-- refContainer: opposite of Container.refLeaf -->
    <eStructuralFeatures xsi:type="eccore:EReference"
        name="refContainer"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"/>
    <!-- refOwner: opposite of Child.refLeafs -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="refOwner"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- Classifier 3: Color enumeration -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

</ecore:EPackage>