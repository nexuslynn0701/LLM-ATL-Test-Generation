<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="MM79"
    nsURI="http://example.org/mm79"
    nsPrefix="mm79">

  <!-- Classifiers order is important for index-based references -->
  <!-- 0: Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <!-- Attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- References -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="addresses"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employer"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 1: Company -->
  <eClassifiers xsi:type="ecore:EClass" name="Company">
    <!-- Attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="foundedYear"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- References -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employees"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="false"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 2: Address -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <!-- Super type to trigger ClassEqSuperTypes with one super -->
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <!-- Attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="number"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 3: RoleKind enum -->
  <eClassifiers xsi:type="ecore:EEnum" name="RoleKind">
    <eLiterals name="ADMIN" value="0" literal="ADMIN"/>
    <eLiterals name="USER" value="1" literal="USER"/>
  </eClassifiers>

  <!-- 4: Status enum -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
    <eLiterals name="PENDING" value="2" literal="PENDING"/>
  </eClassifiers>

  <!-- 5: EStringToStringMapEntry as in standard Ecore -->
  <eClassifiers xsi:type="ecore:EClass" name="EStringToStringMapEntry">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="key"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="value"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>