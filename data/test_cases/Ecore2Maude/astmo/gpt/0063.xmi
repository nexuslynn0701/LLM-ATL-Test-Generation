<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="RootMM"
    nsURI="http://rootmm"
    nsPrefix="root">
  <!-- Classifier 0: EClass -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        iD="true">
      <eGenericType eClassifier="//@eClassifiers.3"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        lowerBound="0"
        upperBound="1">
      <eGenericType eClassifier="//@eClassifiers.4"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="bestFriend"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="friends"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="0"
        upperBound="1">
      <eGenericType eClassifier="//@eClassifiers.5"/>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- Classifier 1: EEnum with literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="ACTIVE" value="1" literal="ACTIVE"/>
    <eLiterals name="SUSPENDED" value="2" literal="SUSPENDED"/>
  </eClassifiers>

  <!-- Classifier 2: EClass -->
  <eClassifiers xsi:type="ecore:EClass" name="Account">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="number"
        lowerBound="1"
        upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        lowerBound="1"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="kind"
        lowerBound="0"
        upperBound="1">
      <eGenericType eClassifier="//@eClassifiers.5"/>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- Classifier 3: EDataType for String -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="MyString"
      instanceClassName="java.lang.String"
      serializable="true"/>

  <!-- Classifier 4: EDataType for Int -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="MyInt"
      instanceClassName="int"
      serializable="true"/>

  <!-- Classifier 5: EDataType used as EEnum type in attributes (dummy) -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="StatusKindType"
      instanceClassName="java.lang.String"
      serializable="true"/>
</ecore:EPackage>