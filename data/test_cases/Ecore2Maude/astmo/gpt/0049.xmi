<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg49"
    nsURI="http://example.org/rootPkg49"
    nsPrefix="root49">

  <!-- Classifiers index:
       0: RootClass
       1: SubClass
       2: LocalStatus (EEnum)
       3: SecondaryClass
  -->

  <!-- EClass 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <!-- Attribute idx 0 -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute idx 1 -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="priority"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference idx 2 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="subItems"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- EClass 1: subclass of RootClass -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute idx 0 -->
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="status"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"
        eType="//@eClassifiers.2"/>
    <!-- Reference idx 1 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="mainRoot"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- EEnum 2 -->
  <eClassifiers xsi:type="ecore:EEnum" name="LocalStatus">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="ACTIVE" value="1" literal="ACTIVE"/>
  </eClassifiers>

  <!-- EClass 3, independent -->
  <eClassifiers xsi:type="ecore:EClass" name="SecondaryClass" abstract="false" interface="false">
    <!-- Attribute idx 0 with defaultValueLiteral to trigger AttEqSpecificDefaultValue -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="description"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"
        defaultValueLiteral="sample &quot;text&quot;"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Reference idx 1 with containment and no opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="rootRefs"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

</ecore:EPackage>