<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="ec2maTest"
    nsURI="http://ec2ma/test/0084"
    nsPrefix="ec2maTest">

  <!-- 0: EEnum Color -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <!-- 1: EEnum Size -->
  <eClassifiers xsi:type="ecore:EEnum" name="Size">
    <eLiterals name="SMALL" value="0" literal="SMALL"/>
    <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
    <eLiterals name="LARGE" value="2" literal="LARGE"/>
  </eClassifiers>

  <!-- 2: EClass Entity (no supertypes) -->
  <eClassifiers xsi:type="ecore:EClass" name="Entity" abstract="false" interface="false">
    <!-- id attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"/>
    <!-- name attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
  </eClassifiers>

  <!-- 3: EClass Person extends Entity -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <!-- age attribute (int, lower 0, upper 1) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="false"/>
    <!-- active attribute (boolean, default true) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        iD="false"
        defaultValueLiteral="true"/>
    <!-- favoriteColor attribute (enum Color, default RED) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="favoriteColor"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.0"
        iD="false"
        defaultValueLiteral="RED"/>
    <!-- nicknames attribute (multi-valued String, unbounded upper = -1) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="nicknames"
        ordered="true"
        unique="false"
        lowerBound="0"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <!-- employer reference to Company (non-containment, many, opposite employees) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employer"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.4"
        containment="false"
        resolveProxies="true"
        eOpposite="//@eClassifiers.4/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- 4: EClass Company extends Entity -->
  <eClassifiers xsi:type="ecore:EClass" name="Company" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <!-- rating attribute (double, lower 0, upper 1) -->
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        xsi:type="ecore:EAttribute"
        name="rating"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        iD="false"/>
    <!-- size attribute (enum Size, no default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="size"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.1"
        iD="false"/>
    <!-- employees reference to Person (containment, many, opposite employer) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employees"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.3"
        containment="true"
        resolveProxies="true"
        eOpposite="//@eClassifiers.3/@eStructuralFeatures.4"/>
  </eClassifiers>

  <!-- 5: EClass Department extends Entity and Company (multiple inheritance) -->
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2 //@eClassifiers.4">
    <!-- code attribute (String, lower 1, upper 1, default "GEN") -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"
        defaultValueLiteral="GEN"/>
    <!-- head reference to Person (single, non-containment) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="head"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.3"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

</ecore:EPackage>