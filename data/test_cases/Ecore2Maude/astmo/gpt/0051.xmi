<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="libraryPkg"
    nsURI="http://example.org/library"
    nsPrefix="lib">

  <!-- Classifiers order is important for index-based references -->
  <!-- 0: Book -->
  <eClassifiers xsi:type="ecore:EClass" name="Book">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="pages"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="authors"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="-1"
        eType="//@eClassifiers.1"
        containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="mainCategory"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.3"
        containment="false"/>
  </eClassifiers>

  <!-- 1: Author -->
  <eClassifiers xsi:type="ecore:EClass" name="Author">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="books"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"
        containment="false"/>
  </eClassifiers>

  <!-- 2: Library -->
  <eClassifiers xsi:type="ecore:EClass" name="Library">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="books"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.0"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="members"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.4"
        containment="true"/>
  </eClassifiers>

  <!-- 3: Category -->
  <eClassifiers xsi:type="ecore:EClass" name="Category">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.3"
        containment="false"/>
  </eClassifiers>

  <!-- 4: Member -->
  <eClassifiers xsi:type="ecore:EClass" name="Member">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="memberId"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        iD="false"/>
  </eClassifiers>

  <!-- 5: Genre enumeration -->
  <eClassifiers xsi:type="ecore:EEnum" name="Genre">
    <eLiterals name="NOVEL" value="0" literal="NOVEL"/>
    <eLiterals name="ESSAY" value="1" literal="ESSAY"/>
    <eLiterals name="POETRY" value="2" literal="POETRY"/>
  </eClassifiers>

  <!-- 6: BookFormat enumeration -->
  <eClassifiers xsi:type="ecore:EEnum" name="BookFormat">
    <eLiterals name="HARDCOVER" value="0" literal="HARDCOVER"/>
    <eLiterals name="PAPERBACK" value="1" literal="PAPERBACK"/>
  </eClassifiers>

  <!-- 7: Rating enumeration -->
  <eClassifiers xsi:type="ecore:EEnum" name="Rating">
    <eLiterals name="LOW" value="0" literal="LOW"/>
    <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
    <eLiterals name="HIGH" value="2" literal="HIGH"/>
    <eLiterals name="TOP" value="3" literal="TOP"/>
  </eClassifiers>

  <!-- 8: Review -->
  <eClassifiers xsi:type="ecore:EClass" name="Review">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="text"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"
        defaultValueLiteral="&quot;no review&quot;"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="score"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        iD="false"/>
  </eClassifiers>

  <!-- 9: EEnum used as attribute type (Rating already at 7), here just reuse -->
  <!-- 10: Comment -->
  <eClassifiers xsi:type="ecore:EClass" name="Comment">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="authorName"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="importance"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.7"
        iD="false"/>
  </eClassifiers>

  <!-- 11: Shelf (subclass of Category to trigger createSort for supertype in ecore package) -->
  <eClassifiers xsi:type="ecore:EClass" name="Shelf">
    <eSuperTypes>//@eClassifiers.3</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
  </eClassifiers>

  <!-- Attributes referencing enums and other datatypes to exercise AttEqSpecificDefaultValue and EqType -->
  <!-- Extend Book with enum-typed attributes -->
  <eClassifiers xsi:type="ecore:EClass" name="BookDetails">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="genre"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.5"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="format"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.6"
        iD="false"
        defaultValueLiteral="HARDCOVER"/>
  </eClassifiers>

</ecore:EPackage>