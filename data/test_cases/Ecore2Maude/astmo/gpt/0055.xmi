<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="meta55"
    nsURI="http://meta55"
    nsPrefix="m55">

  <!-- Package-level classifiers: 0..4 -->
  <!-- 0: EClass -->
  <eClassifiers xsi:type="ecore:EClass" name="Alpha" abstract="false" interface="false">
    <!-- Attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="alphaId"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="alphaName"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        changeable="true"
        volatile="false"
        transient="false"
        defaultValueLiteral="defaultAlpha"
        unsettable="false"
        derived="false"
        iD="false"/>
    <!-- References -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="betaRef"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="true"
        resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="gammaLink"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.2"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- 1: EClass -->
  <eClassifiers xsi:type="ecore:EClass" name="Beta" abstract="false" interface="false">
    <!-- Make Beta a subtype of Alpha to trigger superTypes handling -->
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>

    <!-- Attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="betaFlag"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        iD="false"/>
    <!-- One more attribute (no default value) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="betaCount"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        iD="false"/>

    <!-- Bidirectional reference with Gamma -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="gammaOpp"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- 2: EClass -->
  <eClassifiers xsi:type="ecore:EClass" name="Gamma" abstract="true" interface="false">
    <!-- Supertype to create a small hierarchy -->
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>

    <!-- Opposite side of bidirectional reference to Beta -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="betaOpp"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- 3: EEnum -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <!-- 4: EClass using the EEnum -->
  <eClassifiers xsi:type="ecore:EClass" name="Painter" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="favoriteColor"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.3"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        iD="false"
        defaultValueLiteral="RED"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="painterName"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        iD="false"/>
  </eClassifiers>

</ecore:EPackage>