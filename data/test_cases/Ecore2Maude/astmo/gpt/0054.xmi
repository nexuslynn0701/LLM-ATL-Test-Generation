<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="demoMM"
    nsURI="http://example.org/demoMM"
    nsPrefix="demo">

  <!-- Root EPackage (index 0) -->
  <!-- Class Person (index 1) with attribute id and reference bestFriend -->
  <!-- Class Employee (index 2) extends Person, has salary attribute and manages reference -->
  <!-- Enum Role (index 3) with literals ADMIN, USER, GUEST -->
  <!-- DataType ExtraData (index 4) as a serializable EDataType -->

  <!-- EClass Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        iD="true"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="bestFriend"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.0"
        containment="false"/>
  </eClassifiers>

  <!-- EClass Employee extends Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="salary"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="manages"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.0"
        containment="true"/>
  </eClassifiers>

  <!-- EEnum Role with three literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Role">
    <eLiterals name="ADMIN" value="0" literal="ADMIN"/>
    <eLiterals name="USER" value="1" literal="USER"/>
    <eLiterals name="GUEST" value="2" literal="GUEST"/>
  </eClassifiers>

  <!-- Simple EDataType to show presence of a non-primitive classifier -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="ExtraData"
      instanceClassName="java.lang.String"
      serializable="true"/>
</ecore:EPackage>