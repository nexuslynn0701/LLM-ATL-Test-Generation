<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="RootMM"
    nsURI="http://example.com/rootmm"
    nsPrefix="root">

  <!-- Main package classifiers -->
  <!-- 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="Container">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cid"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1" upperBound="1" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="items"
        eType="//@eClassifiers.1" containment="true"
        lowerBound="0" upperBound="-1"/>
  </eClassifiers>

  <!-- 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="Item">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0" upperBound="1" defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="link"
        eType="//@eClassifiers.2"
        lowerBound="0" upperBound="1" containment="false"/>
  </eClassifiers>

  <!-- 2 -->
  <eClassifiers xsi:type="ecore:EClass" name="Detail">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priority"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0" upperBound="1" defaultValueLiteral="5"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner"
        eType="//@eClassifiers.1"
        lowerBound="0" upperBound="1" containment="false"/>
  </eClassifiers>

  <!-- 3 -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="OLD" value="1" literal="OLD"/>
  </eClassifiers>

  <!-- 4 -->
  <eClassifiers xsi:type="ecore:EClass" name="Record">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="//@eClassifiers.3"
        lowerBound="1" upperBound="1" defaultValueLiteral="NEW"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="note"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0" upperBound="1" defaultValueLiteral="note &quot;example&quot;"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="details"
        eType="//@eClassifiers.2" containment="true"
        lowerBound="0" upperBound="-1"/>
  </eClassifiers>

</ecore:EPackage>