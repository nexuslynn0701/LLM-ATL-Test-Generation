<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="MetaRoot"
    nsURI="http://metaroot/example"
    nsPrefix="metaRoot">

  <!-- Root package classifiers -->
  <eClassifiers xsi:type="ecore:EClass" name="Alpha"
      abstract="false" interface="false">
    <!-- Attribute with default, is ID, lower=0, upper=-1 -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="aName"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"
        defaultValueLiteral="root &quot;alpha&quot; value"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Beta"
      abstract="false" interface="false"
      eSuperTypes="//@eSubpackages.0/@eClassifiers.0">
    <!-- EReference with opposite, containment=false, bounds 1..1 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="toAlpha"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.0"
        containment="false"
        eOpposite="//@eSubpackages.0/@eClassifiers.0/@eStructuralFeatures.0"/>
    <!-- EAttribute with Boolean type and no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        ordered="true"
        unique="false"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        iD="false"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- Subpackage of MetaRoot -->
  <eSubpackages name="SubLayer"
      nsURI="http://metaroot/example/sublayer"
      nsPrefix="subLayer">
    <eClassifiers xsi:type="ecore:EClass" name="Gamma"
        abstract="false" interface="false">
      <!-- Reference back to Beta with opposite, containment=true, bounds 0..* -->
      <eStructuralFeatures xsi:type="eccore:EReference"
          name="betas"
          ordered="false"
          unique="true"
          lowerBound="0"
          upperBound="-1"
          eType="//@eClassifiers.1"
          containment="true"
          eOpposite="//@eClassifiers.1/@eStructuralFeatures.0"/>
      <!-- Attribute whose type is the Color enum -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="tone"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          eType="//@eClassifiers.2"
          iD="false"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>