<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootMM"
    nsURI="http://example.org/rootMM"
    nsPrefix="root">
  <!-- Classifiers order (for index-based references):
       0: Container
       1: Item
       2: Color (EEnum)
       3: Flag (EEnum)
  -->
  <eClassifiers xsi:type="ecore:EClass" name="Container">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="items"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="-1"
        containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Item">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="defaultItem"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="quantity"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="featured"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0"
        upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="color"
        eType="//@eClassifiers.2"
        lowerBound="0"
        upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="container"
        eType="//@eClassifiers.0"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="relatedItem"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="1"
        containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="//@eClassifiers.3"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="ON"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="Flag">
    <eLiterals name="ON" value="0" literal="ON"/>
    <eLiterals name="OFF" value="1" literal="OFF"/>
  </eClassifiers>
</ecore:EPackage>