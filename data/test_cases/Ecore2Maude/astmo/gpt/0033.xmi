<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootMetamodel"
    nsURI="http://rootMetamodel/1.0"
    nsPrefix="root">
  <!-- Index 0: Class Alpha -->
  <eClassifiers xsi:type="ecore:EClass" name="Alpha">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="alphaCode"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="alphaFlag"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0"
        upperBound="1"
        iD="false"
        defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="betaLink"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="-1"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="gammaAssoc"
        eType="//@eClassifiers.2"
        lowerBound="1"
        upperBound="1"
        containment="false"/>
  </eClassifiers>

  <!-- Index 1: Class Beta extends Alpha -->
  <eClassifiers xsi:type="ecore:EClass" name="Beta"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="betaValue"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"
        upperBound="1"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="alphaBack"
        eType="//@eClassifiers.0"
        lowerBound="0"
        upperBound="1"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"
        containment="false"/>
  </eClassifiers>

  <!-- Index 2: Class Gamma -->
  <eClassifiers xsi:type="ecore:EClass" name="Gamma">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="gammaName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="deltaRef"
        eType="//@eClassifiers.4"
        lowerBound="0"
        upperBound="1"
        containment="false"/>
  </eClassifiers>

  <!-- Index 3: Enum Color -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="Red" value="0" literal="Red"/>
    <eLiterals name="Green" value="1" literal="Green"/>
    <eLiterals name="Blue" value="2" literal="Blue"/>
  </eClassifiers>

  <!-- Index 4: Class Delta with attribute typed by Color -->
  <eClassifiers xsi:type="ecore:EClass" name="Delta">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="shade"
        eType="//@eClassifiers.3"
        lowerBound="0"
        upperBound="1"
        iD="false"
        defaultValueLiteral="Green"/>
  </eClassifiers>

  <!-- Index 5: Class Epsilon with String-typed attribute with default -->
  <eClassifiers xsi:type="ecore:EClass" name="Epsilon">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        iD="false"
        defaultValueLiteral="default &quot;epsilon&quot; label"/>
  </eClassifiers>
</ecore:EPackage>