<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="RootPkg"
    nsURI="http://rootpkg/1.0"
    nsPrefix="root">

  <!-- Class 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="Alpha">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="alphaId"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="alphaFlag"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="toBeta"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.1"
        containment="true"/>
  </eClassifiers>

  <!-- Class 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="Beta">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="betaCode"
        lowerBound="0"
        upperBound="*"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="alphaBack"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- Enumeration 2 -->
  <eClassifiers xsi:type="ecore:EEnum" name="GammaKind">
    <eLiterals name="GAMMA_LOW" value="0" literal="GAMMA_LOW"/>
    <eLiterals name="GAMMA_HIGH" value="1" literal="GAMMA_HIGH"/>
  </eClassifiers>

  <!-- Class 3 -->
  <eClassifiers xsi:type="ecore:EClass" name="Gamma">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="gammaLevel"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"
        defaultValueLiteral="GAMMA_LOW"/>
  </eClassifiers>

</ecore:EPackage>