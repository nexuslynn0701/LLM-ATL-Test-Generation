<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="RootMM" nsURI="http://rootmm" nsPrefix="root">

  <!-- Classifiers index:
       0: Container
       1: Node
       2: Leaf
       3: Color (EEnum)
       4: Role  (EEnum)
       5: EString (local)
       6: EBool   (local)
       7: EIntLocal (local)
       8: EFloatLocal (local)
  -->

  <!-- EClasses -->
  <eClassifiers xsi:type="ecore:EClass" name="Container">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cid"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true" lowerBound="1" upperBound="1" ordered="true" unique="true"/>
    <!-- use local EIntLocal and EBool to drive attDataType = '@Int' / '@Bool' -->
    <eStructuralFeatures xsi:type="eccore:EAttribute"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Node"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nid"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="false" lowerBound="0" upperBound="-1" ordered="false" unique="true"
        defaultValueLiteral="0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        iD="false" lowerBound="0" upperBound="1" ordered="true" unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children"
        eType="//@eClassifiers.1" containment="true"
        lowerBound="0" upperBound="-1" ordered="true" unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent"
        eType="//@eClassifiers.1" containment="false"
        lowerBound="0" upperBound="1" ordered="true" unique="true"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.2"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Leaf"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="text"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false" lowerBound="1" upperBound="1" ordered="true" unique="true"
        defaultValueLiteral="defaultText"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="weight"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        iD="false" lowerBound="0" upperBound="1" ordered="true" unique="true"
        defaultValueLiteral="1.5"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="role"
        eType="//@eClassifiers.4" iD="false"
        lowerBound="0" upperBound="1" ordered="true" unique="true"
        defaultValueLiteral="ADMIN"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="colorRef"
        eType="//@eClassifiers.3" containment="false"
        lowerBound="0" upperBound="1" ordered="true" unique="true"/>
  </eClassifiers>

  <!-- Enums -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="Role">
    <eLiterals name="ADMIN" value="0" literal="ADMIN"/>
    <eLiterals name="USER" value="1" literal="USER"/>
  </eClassifiers>

  <!-- Local data types to cover attDataType branches -->
  <eClassifiers xsi:type="ecore:EDataType" name="EString"
      instanceClassName="java.lang.String"/>
  <eClassifiers xsi:type="ecore:EDataType" name="EBool"
      instanceClassName="java.lang.Boolean"/>
  <eClassifiers xsi:type="ecore:EDataType" name="EIntLocal"
      instanceClassName="int"/>
  <eClassifiers xsi:type="ecore:EDataType" name="EFloatLocal"
      instanceClassName="double"/>

</ecore:EPackage>