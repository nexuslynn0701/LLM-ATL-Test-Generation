<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://rootPkg"
    nsPrefix="root">

  <!-- Subpackage to exercise eSuperPackage / eSubpackages -->
  <eSubpackages name="subPkg"
                nsURI="http://subPkg"
                nsPrefix="sub">
    <!-- EClasses in subPkg -->
    <eClassifiers xsi:type="ecore:EClass" name="Base">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="baseId"
                           lowerBound="1"
                           upperBound="1"
                           ordered="true"
                           unique="true"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                           iD="true"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="baseFlag"
                           lowerBound="0"
                           upperBound="1"
                           ordered="true"
                           unique="true"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="relToAssoc"
                           lowerBound="0"
                           upperBound="-1"
                           ordered="true"
                           unique="true"
                           containment="true"
                           eType="//@eSubpackages.0/@eClassifiers.4"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="Derived"
                  abstract="false"
                  interface="false"
                  eSuperTypes="//@eSubpackages.0/@eClassifiers.0">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="code"
                           lowerBound="0"
                           upperBound="1"
                           ordered="true"
                           unique="true"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                           defaultValueLiteral="42"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="toAssoc"
                           lowerBound="1"
                           upperBound="1"
                           ordered="true"
                           unique="true"
                           containment="false"
                           eType="//@eSubpackages.0/@eClassifiers.4"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="Container"
                  abstract="false"
                  interface="false">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="label"
                           lowerBound="0"
                           upperBound="-1"
                           ordered="true"
                           unique="true"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="children"
                           lowerBound="0"
                           upperBound="-1"
                           ordered="true"
                           unique="true"
                           containment="true"
                           eType="//@eSubpackages.0/@eClassifiers.1"/>
    </eClassifiers>

    <!-- Enum used as attribute type and with literals -->
    <eClassifiers xsi:type="ecore:EEnum" name="Priority">
      <eLiterals name="LOW" value="0" literal="LOW"/>
      <eLiterals name="HIGH" value="1" literal="HIGH"/>
    </eClassifiers>

    <!-- Association-like class to be target of references -->
    <eClassifiers xsi:type="ecore:EClass" name="Assoc"
                  abstract="false"
                  interface="false">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="prio"
                           lowerBound="0"
                           upperBound="1"
                           ordered="true"
                           unique="true"
                           eType="//@eSubpackages.0/@eClassifiers.3"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="left"
                           lowerBound="0"
                           upperBound="-1"
                           ordered="true"
                           unique="true"
                           containment="false"
                           eType="//@eSubpackages.0/@eClassifiers.0"
                           eOpposite="//@eSubpackages.0/@eClassifiers.0/@eStructuralFeatures.2"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="right"
                           lowerBound="0"
                           upperBound="-1"
                           ordered="true"
                           unique="true"
                           containment="false"
                           eType="//@eSubpackages.0/@eClassifiers.1"/>
    </eClassifiers>
  </eSubpackages>

  <!-- EClasses in rootPkg -->
  <eClassifiers xsi:type="ecore:EClass" name="RootElement"
                abstract="false"
                interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="rootName"
                         lowerBound="1"
                         upperBound="1"
                         ordered="true"
                         unique="true"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                         defaultValueLiteral="defaultRoot"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="mainContainer"
                         lowerBound="0"
                         upperBound="1"
                         ordered="true"
                         unique="true"
                         containment="true"
                         eType="//@eSubpackages.0/@eClassifiers.2"/>
  </eClassifiers>

</ecore:EPackage>