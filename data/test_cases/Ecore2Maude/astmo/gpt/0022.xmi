<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://rootpkg"
    nsPrefix="root">
  <!-- eClassifiers.0 -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
  </eClassifiers>
  <!-- eClassifiers.1 -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="0"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="refsToBase"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.0"
        containment="false"/>
  </eClassifiers>
  <!-- eClassifiers.2 -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>
  <!-- eClassifiers.3 -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumUser">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="favoriteColor"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"
        iD="false"/>
  </eClassifiers>
  <!-- eClassifiers.4 -->
  <eClassifiers xsi:type="ecore:EClass" name="ContainerClass">
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="containedSubs"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.1"
        containment="true"/>
  </eClassifiers>
</ecore:EPackage>