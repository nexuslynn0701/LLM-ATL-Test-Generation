<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://example/0053"
    nsPrefix="rp">

  <!-- Class 0: RootClass, contains attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <!-- id attribute with default value and EString type -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="RC-001"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- numeric attribute with EInt type and no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="num"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- reference to ChildClass, containment, many -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.1"/>
    <!-- reference to EnumHolder, non-containment, single -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="enumOwner"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- Class 1: ChildClass, super type RootClass to trigger ClassEqSuperTypes and createSort -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- attribute with Boolean type and default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        lowerBound="0"
        upperBound="1"
        ordered="false"
        unique="true"
        defaultValueLiteral="true"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- non-containment reference back to RootClass, opposite of RootClass.children -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        resolveProxies="true"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- Class 2: EnumHolder, has attribute typed by local enum -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumHolder" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- Enum 3: StatusEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="DONE" value="1" literal="DONE"/>
  </eClassifiers>

</ecore:EPackage>