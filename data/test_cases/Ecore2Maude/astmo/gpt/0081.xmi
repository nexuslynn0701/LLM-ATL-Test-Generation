<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg81"
    nsURI="http://rootPkg81"
    nsPrefix="rp81">

  <!-- Class C0 with one attribute and one reference -->
  <eClassifiers xsi:type="ecore:EClass" name="C0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="idAttr"
        iD="true"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="next"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.0"
        containment="true"/>
  </eClassifiers>

  <!-- Class C1 extending C0, with an int attribute and a reference to C2 -->
  <eClassifiers xsi:type="ecore:EClass" name="C1"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="count"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="toC2"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- Class C2 with one boolean attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="C2">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- Enumeration with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="NEW" value="0" literal="NEW_LIT"/>
    <eLiterals name="DONE" value="1" literal="DONE_LIT"/>
  </eClassifiers>

</ecore:EPackage>