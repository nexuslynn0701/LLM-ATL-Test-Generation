<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPack"
    nsURI="http://example/rootPack"
    nsPrefix="root">
  <!-- Classifiers index:
       0: RootClass
       1: AbstractBase
       2: SubClass
       3: LinkedClass
       4: SampleEnum
       5: OtherEnum
       6: HelperClass
  -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="child"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.2"
        containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="AbstractBase" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="SubClass" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="defaultName"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="kindAttr"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="link"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.3"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="LinkedClass">
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="back"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.2"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- SampleEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="SampleEnum">
    <eLiterals name="FIRST" value="0" literal="FIRST"/>
    <eLiterals name="SECOND" value="1" literal="SECOND"/>
  </eClassifiers>

  <!-- Second enum to exercise multiple enums and variables -->
  <eClassifiers xsi:type="ecore:EEnum" name="OtherEnum">
    <eLiterals name="ALPHA" value="0" literal="ALPHA"/>
    <eLiterals name="BETA" value="1" literal="BETA"/>
    <eLiterals name="GAMMA" value="2" literal="GAMMA"/>
  </eClassifiers>

  <!-- HelperClass to increase number of classes and attributes -->
  <eClassifiers xsi:type="ecore:EClass" name="HelperClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="helperName"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="helperCount"
        lowerBound="0"
        upperBound="5"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
</ecore:EPackage>