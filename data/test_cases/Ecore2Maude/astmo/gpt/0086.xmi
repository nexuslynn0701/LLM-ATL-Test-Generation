<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="metaRoot"
    nsURI="http://example/metaroot"
    nsPrefix="mr">

  <!-- EClass 0: RootEntity -->
  <eClassifiers xsi:type="ecore:EClass" name="RootEntity">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="0"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        lowerBound="1"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="detail"
        lowerBound="0"
        upperBound="1"
        containment="true"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="tags"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- EClass 1: Detail (subclass of RootEntity) -->
  <eClassifiers xsi:type="ecore:EClass" name="Detail">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="description"
        lowerBound="0"
        upperBound="1"
        iD="false"
        defaultValueLiteral="sample &quot;text&quot;"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- EEnum 2: StatusKind with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>

  <!-- EClass 3: Tag -->
  <eClassifiers xsi:type="ecore:EClass" name="Tag">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="label"
        lowerBound="1"
        upperBound="-1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="priority"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

</ecore:EPackage>