<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    xmi:version="2.0"
    name="rootPkg"
    nsURI="http://example/rootPkg"
    nsPrefix="root">
  <!-- Subpackage -->
  <eSubpackages name="subPkgA" nsURI="http://example/subPkgA" nsPrefix="subA">
    <!-- Classifiers in subPkgA -->
    <eClassifiers xsi:type="ecore:EClass" name="Person">
      <eStructuralFeatures xsi:type="eccore:EAttribute"
                           name="id"
                           lowerBound="1"
                           upperBound="1"
                           iD="true"
                           ordered="true"
                           unique="true"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="age"
                           lowerBound="0"
                           upperBound="1"
                           ordered="true"
                           unique="true"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="address"
                           lowerBound="0"
                           upperBound="1"
                           containment="true"
                           ordered="true"
                           unique="true"
                           eType="//@eClassifiers.1"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="bestFriend"
                           lowerBound="0"
                           upperBound="1"
                           containment="false"
                           ordered="true"
                           unique="true"
                           eType="//@eClassifiers.0"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="roles"
                           lowerBound="0"
                           upperBound="-1"
                           containment="false"
                           ordered="true"
                           unique="true"
                           eType="//@eClassifiers.2"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="Address">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="street"
                           lowerBound="0"
                           upperBound="1"
                           ordered="true"
                           unique="true"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="zip"
                           lowerBound="0"
                           upperBound="1"
                           ordered="true"
                           unique="true"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="resident"
                           lowerBound="0"
                           upperBound="1"
                           containment="false"
                           ordered="true"
                           unique="true"
                           eType="//@eClassifiers.0"
                           eOpposite="//@eSubpackages.0/@eClassifiers.0/@eStructuralFeatures.2"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="RoleKind">
      <eLiterals name="Admin" value="0" literal="Admin"/>
      <eLiterals name="User" value="1" literal="User"/>
    </eClassifiers>
  </eSubpackages>

  <!-- Classifiers in rootPkg -->
  <eClassifiers xsi:type="ecore:EClass" name="Company">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="name"
                         lowerBound="1"
                         upperBound="1"
                         ordered="true"
                         unique="true"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="employees"
                         lowerBound="0"
                         upperBound="-1"
                         containment="true"
                         ordered="true"
                         unique="true"
                         eType="//@eSubpackages.0/@eClassifiers.0"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="code"
                         lowerBound="0"
                         upperBound="1"
                         ordered="true"
                         unique="true"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="manager"
                         lowerBound="0"
                         upperBound="1"
                         containment="false"
                         ordered="true"
                         unique="true"
                         eType="//@eSubpackages.0/@eClassifiers.0"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="Priority">
    <eLiterals name="LOW" value="0" literal="LOW"/>
    <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
    <eLiterals name="HIGH" value="2" literal="HIGH"/>
  </eClassifiers>
</ecore:EPackage>