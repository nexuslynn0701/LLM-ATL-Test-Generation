<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="company"
    nsURI="http://example.org/company"
    nsPrefix="company">

  <!-- EClasses -->
  <eClassifiers xsi:type="ecore:EClass" name="Company">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="companyName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="departments"
        eType="//@eClassifiers.1"
        containment="true"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="ceo"
        eType="//@eClassifiers.2"
        containment="false"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Department"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="deptCode"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="true"
        defaultValueLiteral="D-000"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employees"
        eType="//@eClassifiers.2"
        containment="true"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parentCompany"
        eType="//@eClassifiers.0"
        containment="false"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Employee">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="empId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="fullName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"
        defaultValueLiteral="John &quot;Johnny&quot; Doe"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="employmentStatus"
        eType="//@eClassifiers.4"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"
        defaultValueLiteral="ACTIVE"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="department"
        eType="//@eClassifiers.1"
        containment="false"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="OrgUnit" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="unitName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"/>
  </eClassifiers>

  <!-- EEnum -->
  <eClassifiers xsi:type="ecore:EEnum" name="EmploymentStatus">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>

</ecore:EPackage>