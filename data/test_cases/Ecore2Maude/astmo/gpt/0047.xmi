<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="RootPkg"
    nsURI="http://rootpkg"
    nsPrefix="root">

  <!-- Subpackage to trigger superPackage/subPackages logic -->
  <eSubpackages name="SubPkg"
                nsURI="http://subpkg"
                nsPrefix="sub">
    <!-- Classifiers of SubPkg -->
    <eClassifiers xsi:type="ecore:EClass" name="Node">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="code"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                           lowerBound="0"
                           upperBound="1"
                           iD="true"
                           ordered="true"
                           unique="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="parent"
                           eType="//@eClassifiers.0"
                           lowerBound="0"
                           upperBound="1"
                           containment="false"
                           ordered="true"
                           unique="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="ColorKind">
      <eLiterals name="RED" value="0" literal="RED"/>
      <eLiterals name="GREEN" value="1" literal="GREEN"/>
    </eClassifiers>
  </eSubpackages>

  <!-- Classifiers of RootPkg -->
  <!-- 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="name"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                         lowerBound="1"
                         upperBound="1"
                         iD="true"
                         defaultValueLiteral="John Doe"
                         ordered="true"
                         unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="friends"
                         eType="//@eClassifiers.0"
                         lowerBound="0"
                         upperBound="-1"
                         containment="false"
                         ordered="true"
                         unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="age"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                         lowerBound="0"
                         upperBound="1"
                         iD="false"
                         ordered="true"
                         unique="true"
                         defaultValueLiteral="30"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="favoriteColor"
                         eType="//@eClassifiers.3"
                         lowerBound="0"
                         upperBound="1"
                         iD="false"
                         ordered="true"
                         unique="true"
                         defaultValueLiteral="GREEN"/>
  </eClassifiers>

  <!-- 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee"
                eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="salary"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
                         lowerBound="0"
                         upperBound="1"
                         iD="false"
                         ordered="true"
                         unique="true"
                         defaultValueLiteral="1234.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="manager"
                         eType="//@eClassifiers.1"
                         lowerBound="0"
                         upperBound="1"
                         containment="false"
                         ordered="true"
                         unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="department"
                         eType="//@eClassifiers.2"
                         lowerBound="0"
                         upperBound="1"
                         containment="false"
                         ordered="true"
                         unique="true"/>
  </eClassifiers>

  <!-- 2 -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="deptName"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                         lowerBound="1"
                         upperBound="1"
                         iD="true"
                         ordered="true"
                         unique="true"
                         defaultValueLiteral="R&amp;D"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="employees"
                         eType="//@eClassifiers.1"
                         lowerBound="0"
                         upperBound="-1"
                         containment="true"
                         ordered="true"
                         unique="true"/>
  </eClassifiers>

  <!-- 3 -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

</ecore:EPackage>