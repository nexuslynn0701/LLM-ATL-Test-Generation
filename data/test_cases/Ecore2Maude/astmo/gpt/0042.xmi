<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="blog"
    nsURI="http://example.org/blog"
    nsPrefix="blog">

  <!-- EClasses -->
  <eClassifiers xsi:type="ecore:EClass" name="BlogPackage">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        iD="false"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Post">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"
        upperBound="1"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="content"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="-1"
        iD="false"
        defaultValueLiteral="default post"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="comments"
        eType="//@eClassifiers.2"
        containment="true"
        lowerBound="0"
        upperBound="-1"
        resolveProxies="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Comment">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="text"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="post"
        eType="//@eClassifiers.1"
        containment="false"
        lowerBound="0"
        upperBound="1"
        resolveProxies="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="SpecialPost">
    <eSuperTypes>//@eClassifiers.1</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="priority"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="1"
        iD="false"
        defaultValueLiteral="1"/>
  </eClassifiers>

  <!-- EEnum -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="PUBLISHED" value="1" literal="PUBLISHED"/>
    <eLiterals name="ARCHIVED" value="2" literal="ARCHIVED"/>
  </eClassifiers>

</ecore:EPackage>