<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://example/rootPkg"
    nsPrefix="rootPkg">

  <!-- Root package classifiers: 0..4 -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass">
    <!-- Structural features 0..3 -->
    <eStructuralFeatures xsi:type="eccore:EAttribute" name="id"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1" upperBound="1" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0" upperBound="1" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="child"
        eType="//@eClassifiers.1"
        containment="true"
        lowerBound="0" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="linked"
        eType="//@eClassifiers.2"
        containment="false"
        lowerBound="1" upperBound="1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="SubClassA">
    <!-- eSuperTypes references RootClass -->
    <eSuperTypes href="//@eClassifiers.0"/>
    <!-- Structural features 0..1 -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0" upperBound="1" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="other"
        eType="//@eClassifiers.2"
        containment="false"
        lowerBound="0" upperBound="-1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="SubClassB">
    <eSuperTypes href="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0" upperBound="1" iD="false"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="SizeEnum">
    <eLiterals name="SMALL" value="0" literal="SMALL"/>
    <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
  </eClassifiers>

  <!-- Subpackage 0 -->
  <eSubpackages name="subPkg"
      nsURI="http://example/subPkg"
      nsPrefix="subPkg">
    <!-- Subpackage classifiers: 0..3 -->
    <eClassifiers xsi:type="ecore:EClass" name="SubPkgClass">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          lowerBound="0" upperBound="1" iD="false"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="rootRef"
          eType="//@eClassifiers.0"
          containment="false"
          lowerBound="0" upperBound="-1"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
      <eLiterals name="NEW" value="0" literal="NEW"/>
      <eLiterals name="OLD" value="1" literal="OLD"/>
      <eLiterals name="ARCHIVED" value="2" literal="ARCHIVED"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="AnotherClass">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          lowerBound="0" upperBound="1" iD="false"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="status"
          eType="//@eSubpackages.0/@eClassifiers.1"
          containment="false"
          lowerBound="0" upperBound="1"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="EnumHolder">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="primaryColor"
          eType="//@eClassifiers.3"
          lowerBound="0" upperBound="1" iD="false"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="size"
          eType="//@eClassifiers.4"
          lowerBound="0" upperBound="1" iD="false"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="statusDefault"
          eType="//@eSubpackages.0/@eClassifiers.1"
          lowerBound="0" upperBound="1" iD="false"
          defaultValueLiteral="NEW"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>