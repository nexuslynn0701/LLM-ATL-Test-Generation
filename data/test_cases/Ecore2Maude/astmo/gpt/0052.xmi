<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="mm5"
    nsURI="http://mm5/1.0"
    nsPrefix="mm5">

  <!-- 0: EClass RootA -->
  <eClassifiers xsi:type="ecore:EClass" name="RootA" abstract="false" interface="false">
    <!-- Attribute aId : EInt, ID, lower=1, upper=1 -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="aId"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Attribute aName : EString, non-ID, lower=0, upper=-1 -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="aName"
        lowerBound="0"
        upperBound="-1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Reference childB : to NodeB, containment, lower=0, upper=-1, with opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="childB"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.0"/>
    <!-- Reference optRefC : to LeafC, non-containment, lower=0, upper=1, no opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="optRefC"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 1: EClass NodeB, subtype of RootA -->
  <eClassifiers xsi:type="ecore:EClass" name="NodeB" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Opposite container reference to RootA.childB, non-containment, lower=0, upper=1 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parentA"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
    <!-- Reference deepC : to LeafC, containment, lower=1, upper=1 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="deepC"
        lowerBound="1"
        upperBound="1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 2: EClass LeafC, subtype of NodeB -->
  <eClassifiers xsi:type="ecore:EClass" name="LeafC" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <!-- Attribute flag : EBoolean, lower=0, upper=1, non-ID, default 'true' -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        lowerBound="0"
        upperBound="1"
        iD="false"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Attribute rating : EFloat, lower=0, upperBound="-1", non-ID -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rating"
        lowerBound="0"
        upperBound="-1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <!-- Attribute priority : custom EDataType PriorityKind (index 6), lower=1, upper=1, non-ID -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="priority"
        lowerBound="1"
        upperBound="1"
        iD="false"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

  <!-- 3: EEnum StatusEnum -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="DONE" value="1" literal="DONE"/>
  </eClassifiers>

  <!-- 4: EEnum ModeEnum -->
  <eClassifiers xsi:type="ecore:EEnum" name="ModeEnum">
    <eLiterals name="AUTO" value="0" literal="AUTO"/>
    <eLiterals name="MANUAL" value="1" literal="MANUAL"/>
    <eLiterals name="MIXED" value="2" literal="MIXED"/>
  </eClassifiers>

  <!-- 5: EClass Config, no supertypes -->
  <eClassifiers xsi:type="ecore:EClass" name="Config" abstract="false" interface="false">
    <!-- Attribute status : StatusEnum, default NEW -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="1"
        upperBound="1"
        iD="false"
        defaultValueLiteral="NEW"
        eType="//@eClassifiers.3"/>
    <!-- Attribute mode : ModeEnum, default MANUAL -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="mode"
        lowerBound="1"
        upperBound="1"
        iD="false"
        defaultValueLiteral="MANUAL"
        eType="//@eClassifiers.4"/>
    <!-- Reference primaryRoot : RootA, non-containment, lower=1, upper=1 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="primaryRoot"
        lowerBound="1"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 6: EDataType PriorityKind (custom data type) -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="PriorityKind"
      instanceClassName="int"/>
</ecore:EPackage>