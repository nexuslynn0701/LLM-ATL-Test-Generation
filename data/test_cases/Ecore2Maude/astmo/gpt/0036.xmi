<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg36"
    nsURI="http://example.org/rootPkg36"
    nsPrefix="rp36">

  <!-- EClass 0: Base class, no supers, one attribute, one reference -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="baseCode"
        lowerBound="0"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="linkToLeaf"
        lowerBound="1"
        upperBound="-1"
        containment="false"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- EClass 1: Subclass of BaseClass, has attribute with default, opposite reference -->
  <eClassifiers xsi:type="ecore:EClass" name="MiddleClass">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="midFlag"
        lowerBound="0"
        upperBound="1"
        iD="false"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.1"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- EClass 2: Leaf class, subclass of MiddleClass, contains children, opposite back to parent -->
  <eClassifiers xsi:type="ecore:EClass" name="LeafClass">
    <eSuperTypes>//@eClassifiers.1</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="leafValue"
        lowerBound="1"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- EEnum 3: Status with three literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="ACTIVE" value="1" literal="ACTIVE"/>
    <eLiterals name="DONE" value="2" literal="DONE"/>
  </eClassifiers>

  <!-- EClass 4: Uses the enum and an extra attribute with default value -->
  <eClassifiers xsi:type="ecore:EClass" name="TaskItem">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="1"
        upperBound="1"
        iD="false"
        eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="label"
        lowerBound="0"
        upperBound="1"
        iD="false"
        defaultValueLiteral="Untitled"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>