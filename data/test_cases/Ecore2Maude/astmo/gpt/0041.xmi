<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="RootPkg"
    nsURI="http://rootpkg/1.0"
    nsPrefix="root">

  <!-- Class Person with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employer"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.1"
        containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="friends"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.0"
        containment="false"/>
  </eClassifiers>

  <!-- Class Company -->
  <eClassifiers xsi:type="ecore:EClass" name="Company">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
  </eClassifiers>

  <!-- Enumeration Gender with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Gender">
    <eLiterals name="MALE" value="0" literal="MALE"/>
    <eLiterals name="FEMALE" value="1" literal="FEMALE"/>
  </eClassifiers>

  <!-- Class Employee extending Person, uses the enum and has an extra reference -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="gender"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="manager"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.3"
        containment="false"/>
  </eClassifiers>

</ecore:EPackage>