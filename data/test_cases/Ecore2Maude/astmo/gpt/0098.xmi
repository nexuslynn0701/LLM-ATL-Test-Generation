<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="RootMM"
    nsURI="http://rootmm/1.0"
    nsPrefix="root">

  <!-- Class 0: Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <!-- Attribute 0 of Person -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"/>
    <!-- Attribute 1 of Person -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="18"/>
    <!-- Reference 2 of Person -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="worksAt"
        eType="//@eClassifiers.1"
        containment="false"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"/>
  </eClassifiers>

  <!-- Class 1: Company -->
  <eClassifiers xsi:type="ecore:EClass" name="Company">
    <!-- Attribute 0 of Company -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="ACME"/>
    <!-- Reference 1 of Company -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employees"
        eType="//@eClassifiers.0"
        containment="true"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- Enum 2: Role -->
  <eClassifiers xsi:type="ecore:EEnum" name="Role">
    <eLiterals name="ADMIN" value="0" literal="ADMIN"/>
    <eLiterals name="USER" value="1" literal="USER"/>
  </eClassifiers>

  <!-- Class 3: Account -->
  <eClassifiers xsi:type="ecore:EClass" name="Account">
    <!-- Attribute 0 of Account, typed by Role enum -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="role"
        iD="false"
        eType="//@eClassifiers.2"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="ADMIN"/>
  </eClassifiers>

</ecore:EPackage>