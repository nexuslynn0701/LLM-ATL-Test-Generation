<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="ShopMM"
    nsURI="http://shop/example"
    nsPrefix="shop">

  <!-- 0: Enum RoleKind with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="RoleKind">
    <eLiterals name="ADMIN" value="0" literal="ADMIN"/>
    <eLiterals name="CUSTOMER" value="1" literal="CUSTOMER"/>
  </eClassifiers>

  <!-- 1: Class NamedElement (no super types) -->
  <eClassifiers xsi:type="ecore:EClass" name="NamedElement" abstract="false" interface="false"/>

  <!-- 2: Class Person extends NamedElement, with attribute personName and reference addresses -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="personName"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="addresses"
        ordered="true" unique="true" lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.3"
        containment="true"/>
  </eClassifiers>

  <!-- 3: Class Address extends NamedElement, with attributes street (String) and houseNumber (Int) -->
  <eClassifiers xsi:type="ecore:EClass" name="Address" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="houseNumber"
        ordered="true" unique="true" lowerBound="0" upperBound="-1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 4: Class Order extends NamedElement, with attributes amount (Int), status (String),
           and enum-valued attribute role of type RoleKind -->
  <eClassifiers xsi:type="ecore:EClass" name="Order" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="amount"
        ordered="true" unique="true" lowerBound="1" upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        iD="false"
        defaultValueLiteral="pending"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="role"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        iD="false"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 5: Class LineItem extends NamedElement, with reference order and attribute quantity -->
  <eClassifiers xsi:type="ecore:EClass" name="LineItem" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EReference" name="order"
        ordered="true" unique="true" lowerBound="1" upperBound="1"
        eType="//@eClassifiers.4"
        containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="quantity"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

</ecore:EPackage>