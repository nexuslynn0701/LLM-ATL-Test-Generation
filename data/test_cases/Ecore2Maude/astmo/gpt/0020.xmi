<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="RootMM"
    nsURI="http://example/rootmm"
    nsPrefix="root">

  <!-- Root-level classifiers: one class and one enum -->
  <eClassifiers xsi:type="ecore:EClass" name="Node" abstract="false" interface="false">
    <!-- Attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="level"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference to enum's type class (to exercise EqType, bounds, containment=false) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="kindRef"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eType="//@eClassifiers.2"/>
    <!-- Containment reference to sub package class -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="subItems"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eSubpackages.0/@eClassifiers.0"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="KindCode">
    <eLiterals name="PRIMARY" value="0" literal="PRIMARY"/>
    <eLiterals name="SECONDARY" value="1" literal="SECONDARY"/>
  </eClassifiers>

  <!-- A data type to ensure EDataType presence (used indirectly via helpers) -->
  <eClassifiers xsi:type="eccore:EDataType" name="DummyType"
      instanceClassName="java.lang.String"/>

  <!-- Subpackage to exercise super/sub package equations and class listing -->
  <eSubpackages name="SubMM" nsURI="http://example/submm" nsPrefix="sub">
    <eClassifiers xsi:type="ecore:EClass" name="SubNode" abstract="false" interface="false">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="code"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          iD="false"
          defaultValueLiteral="XYZ"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="owner"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          containment="false"
          eType="//@eClassifiers.0"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>