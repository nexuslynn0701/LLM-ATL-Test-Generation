<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="RootMM"
    nsURI="http://rootmm/example"
    nsPrefix="root">

  <!-- 0: Super package -->
  <eSubpackages name="CorePkg" nsURI="http://rootmm/core" nsPrefix="core">
    <!-- 0.0: EClass in subpackage -->
    <eClassifiers xsi:type="ecore:EClass" name="BaseElement">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="id"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          lowerBound="1"
          upperBound="1"
          iD="true"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="createdOn"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"
          lowerBound="0"
          upperBound="1"
          iD="false"/>
    </eClassifiers>
  </eSubpackages>

  <!-- 1: Classifier 0 - EClass -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <!-- attribute triggering Attribute2Operation, EqType (String), bounds (0..*), isId=false, default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="-1"
        iD="false"
        defaultValueLiteral="&quot;unknown&quot;"/>
    <!-- attribute triggering Attribute2Operation, EqType (Int), bounds (1..1), isId=true -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"
        upperBound="1"
        iD="true"/>
    <!-- reference to Address with opposite, containment=false, bounds (0..1) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="primaryAddress"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.0"/>
    <!-- reference to Address, containment=true, no opposite, bounds (0..*) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="otherAddresses"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="-1"
        containment="true"/>
    <!-- reference to BaseElement in subpackage, no opposite, non-containment -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="base"
        eType="//@eSubpackages.0/@eClassifiers.0"
        lowerBound="0"
        upperBound="1"
        containment="false"/>
  </eClassifiers>

  <!-- 2: Classifier 1 - EClass -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <!-- superclass: BaseElement in subpackage -->
    <eSuperTypes>//@eSubpackages.0/@eClassifiers.0</eSuperTypes>
    <!-- opposite reference back to Person.primaryAddress -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        eType="//@eClassifiers.0"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
    <!-- attribute with Boolean type -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="isActive"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0"
        upperBound="1"
        iD="false"/>
  </eClassifiers>

  <!-- 3: Classifier 2 - EEnum -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorKind">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

</ecore:EPackage>