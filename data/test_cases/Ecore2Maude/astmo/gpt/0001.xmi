<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="RootMM"
    nsURI="http://rootmm"
    nsPrefix="root">

  <!-- EClass 0: Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="John Doe"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="addresses"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"/>
  </eClassifiers>

  <!-- EClass 1: Address -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        xsi:type="ecore:EAttribute"
        name="street"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="zip"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="resident"
        eType="//@eClassifiers.0"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"/>
  </eClassifiers>

  <!-- EEnum 2: Status -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="CONFIRMED" value="1" literal="CONFIRMED"/>
    <eLiterals name="CANCELLED" value="2" literal="CANCELLED"/>
  </eClassifiers>

</ecore:EPackage>