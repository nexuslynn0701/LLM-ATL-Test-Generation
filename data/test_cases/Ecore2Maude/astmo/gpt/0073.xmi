<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="RootMeta"
    nsURI="http://rootmeta/1.0"
    nsPrefix="rootmeta">

  <!-- Subpackage to exercise eSuperPackage / eSubpackages -->
  <eSubpackages name="SubMeta"
                nsURI="http://rootmeta/sub"
                nsPrefix="sub">
    <!-- Classifiers inside SubMeta -->
    <eClassifiers xsi:type="ecore:EClass" name="Node">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="nodeId"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                           lowerBound="1"
                           upperBound="1"
                           iD="true"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="label"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                           lowerBound="0"
                           upperBound="1"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="outgoing"
                           eType="//@eSubpackages.0/@eClassifiers.1"
                           lowerBound="0"
                           upperBound="-1"
                           containment="true"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="Edge">
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="source"
                           eType="//@eSubpackages.0/@eClassifiers.0"
                           lowerBound="1"
                           upperBound="1"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="target"
                           eType="//@eSubpackages.0/@eClassifiers.0"
                           lowerBound="1"
                           upperBound="1"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="weight"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
                           lowerBound="0"
                           upperBound="1"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EEnum" name="EdgeKind">
      <eLiterals name="DIRECTED" value="0" literal="DIRECTED"/>
      <eLiterals name="UNDIRECTED" value="1" literal="UNDIRECTED"/>
    </eClassifiers>
  </eSubpackages>

  <!-- Classifiers in root package -->
  <eClassifiers xsi:type="ecore:EClass" name="Element">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="name"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                         lowerBound="0"
                         upperBound="1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Container">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="capacity"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                         lowerBound="0"
                         upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="elements"
                         eType="//@eClassifiers.0"
                         lowerBound="0"
                         upperBound="-1"
                         containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="OLD" value="1" literal="OLD"/>
    <eLiterals name="ARCHIVED" value="2" literal="ARCHIVED"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="AnnotatedElement">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="status"
                         eType="//@eClassifiers.2"
                         lowerBound="0"
                         upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="related"
                         eType="//@eClassifiers.0"
                         lowerBound="0"
                         upperBound="-1"/>
  </eClassifiers>

</ecore:EPackage>