<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="blogMeta"
    nsURI="http://example.org/blogMeta"
    nsPrefix="blog">

  <!-- Root package classifiers (indices 0..5) -->
  <!-- 0: EClass Blog -->
  <eClassifiers xsi:type="ecore:EClass" name="Blog">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="posts"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.1"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.2"
        containment="false"/>
  </eClassifiers>

  <!-- 1: EClass Post -->
  <eClassifiers xsi:type="ecore:EClass" name="Post">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="subject"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rating"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="blog"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.0"
        containment="false"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="author"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.2"
        containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="comments"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.3"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="visibility"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 2: EClass User -->
  <eClassifiers xsi:type="ecore:EClass" name="User" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="username"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="ownedBlogs"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.0"
        containment="false"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- 3: EClass Comment -->
  <eClassifiers xsi:type="ecore:EClass" name="Comment">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="content"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flagged"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        iD="false"/>
  </eClassifiers>

  <!-- 4: EEnum Visibility -->
  <eClassifiers xsi:type="ecore:EEnum" name="Visibility">
    <eLiterals name="PUBLIC" value="0" literal="PUBLIC"/>
    <eLiterals name="PRIVATE" value="1" literal="PRIVATE"/>
    <eLiterals name="FRIENDS_ONLY" value="2" literal="FRIENDS_ONLY"/>
  </eClassifiers>

  <!-- 5: Extra EEnum Mood to trigger enum rules with single literal -->
  <eClassifiers xsi:type="ecore:EEnum" name="Mood">
    <eLiterals name="HAPPY" value="0" literal="HAPPY"/>
  </eClassifiers>

  <!-- Subpackage to exercise subpackage and superPackage handling -->
  <eSubpackages name="blogMetaStats" nsURI="http://example.org/blogMetaStats" nsPrefix="blogStats">
    <!-- 0: EClass Stats inside subpackage -->
    <eClassifiers xsi:type="ecore:EClass" name="Stats">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="views"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
          iD="false"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="hot"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          eType="//@eClassifiers.5"
          iD="false"
          defaultValueLiteral="HAPPY"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>