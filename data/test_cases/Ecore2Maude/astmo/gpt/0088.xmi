<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="meta8"
    nsURI="http://meta8"
    nsPrefix="m8">

  <!-- Classifiers index map:
       0: Root
       1: Child
       2: FlagKind (EEnum)
       3: IntKind  (EEnum)
  -->

  <!-- Root class with references and attributes -->
  <eClassifiers xsi:type="ecore:EClass" name="Root">
    <!-- reference to Child, containment, upperBound = -1 to trigger '*' case -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.1"
        containment="true"/>
    <!-- non-ID String attribute with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"
        defaultValueLiteral="Untitled"/>
    <!-- ID Int attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"/>
  </eClassifiers>

  <!-- Child class, with supertype Root -->
  <eClassifiers xsi:type="ecore:EClass" name="Child"
      eSuperTypes="//@eClassifiers.0">
    <!-- enum-typed attribute with default literal -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"
        iD="false"
        defaultValueLiteral="ACTIVE"/>
    <!-- Boolean attribute, no default, multiplicity many -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        iD="false"/>
    <!-- bidirectional non-containment reference back to Root -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.0"
        containment="false"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- FlagKind enumeration, used as attribute type -->
  <eClassifiers xsi:type="ecore:EEnum" name="FlagKind">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>

  <!-- IntKind enumeration, only to exercise additional enum / literal rules -->
  <eClassifiers xsi:type="ecore:EEnum" name="IntKind">
    <eLiterals name="LOW" value="0" literal="LOW"/>
    <eLiterals name="HIGH" value="1" literal="HIGH"/>
  </eClassifiers>

</ecore:EPackage>