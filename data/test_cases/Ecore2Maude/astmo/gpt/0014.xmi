<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg14"
    nsURI="http://example.org/rootPkg14"
    nsPrefix="rp14">

  <!-- Root package classifiers (indices 0..4) -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="baseId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"
        upperBound="1"
        iD="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="SubClass"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="subName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="toOther"
        eType="//@eSubpackages.0/@eClassifiers.0"
        lowerBound="0"
        upperBound="-1"
        containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="containedOther"
        eType="//@eSubpackages.0/@eClassifiers.0"
        lowerBound="0"
        upperBound="-1"
        containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="EnumUser">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="color"
        eType="//@eClassifiers.3"
        lowerBound="0"
        upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="priority"
        eType="//@eClassifiers.4"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="HIGH"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="PriorityEnum">
    <eLiterals name="LOW" value="0" literal="LOW"/>
    <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
    <eLiterals name="HIGH" value="2" literal="HIGH"/>
  </eClassifiers>

  <!-- Subpackage (index 0 in eSubpackages of root) -->
  <eSubpackages name="childPkg"
      nsURI="http://example.org/childPkg14"
      nsPrefix="cp14">

    <!-- childPkg classifiers (indices 0..1) -->
    <eClassifiers xsi:type="ecore:EClass" name="OtherClass">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="otherFlag"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
          lowerBound="0"
          upperBound="1"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="backToSub"
          eType="//@eClassifiers.1"
          lowerBound="0"
          upperBound="-1"
          containment="false"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="LeafClass"
        eSuperTypes="//@eSubpackages.0/@eClassifiers.0">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="leafCode"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          lowerBound="0"
          upperBound="1"
          defaultValueLiteral="L14"/>
    </eClassifiers>

  </eSubpackages>
</ecore:EPackage>