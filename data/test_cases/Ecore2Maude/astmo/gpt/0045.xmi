<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="CompanyModel"
    nsURI="http://company/example/0045"
    nsPrefix="company">

  <!-- Classifier 0: EClass Company -->
  <eClassifiers xsi:type="ecore:EClass" name="Company">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="companyId"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"
        defaultValueLiteral="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="companyName"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="departments"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.1"
        containment="true"
        resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="ceo"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- Classifier 1: EClass Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="deptCode"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="budget"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employees"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.2"
        containment="true"
        resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parentCompany"
        lowerBound="1"
        eType="//@eClassifiers.0"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- Classifier 2: EClass Employee -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="empId"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="empName"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="department"
        lowerBound="0"
        eType="//@eClassifiers.1"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- Classifier 3: EEnum Role -->
  <eClassifiers xsi:type="ecore:EEnum" name="Role">
    <eLiterals name="MANAGER" value="0" literal="MANAGER"/>
    <eLiterals name="DEVELOPER" value="1" literal="DEVELOPER"/>
  </eClassifiers>

  <!-- Classifier 4: EClass Position -->
  <eClassifiers xsi:type="ecore:EClass" name="Position">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="Junior&quot;Dev"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="role"
        lowerBound="1"
        eType="//@eClassifiers.3"
        defaultValueLiteral="MANAGER"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="holder"
        lowerBound="0"
        eType="//@eClassifiers.2"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

</ecore:EPackage>