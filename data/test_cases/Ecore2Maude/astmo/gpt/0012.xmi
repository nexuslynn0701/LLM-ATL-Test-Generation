<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="mmTest12"
    nsURI="http://mm/test/12"
    nsPrefix="mm12">

  <!-- Class: Root -->
  <eClassifiers xsi:type="ecore:EClass" name="Root" abstract="false" interface="false">
    <!-- Attribute: id (String, lower=1, upper=1, isID=true) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Reference: children (to Node, containment, 0..*) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Class: Node -->
  <eClassifiers xsi:type="ecore:EClass" name="Node" abstract="false" interface="false">
    <!-- Attribute: name (String, 0..1, default="noname") -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="noname"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute: flag (Boolean, 0..1) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Reference: parent (to Root, non-containment, 0..1, opposite of Root.children) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
    <!-- Reference: next (to Node, non-containment, 0..1, opposite self, upperBound=-1 on other side via same feature) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="next"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Enum: Color -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <!-- DataType: CustomDouble (will trigger @DataType in attDataType) -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDouble" instanceClassName="double"/>

  <!-- Class: ColoredNode -->
  <eClassifiers xsi:type="ecore:EClass" name="ColoredNode" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <!-- Attribute: color (EEnum Color, 0..1, default literal GREEN) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="color"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"
        defaultValueLiteral="GREEN"
        eType="//@eClassifiers.2"/>
    <!-- Attribute: weight (CustomDouble, 0..1) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="weight"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="false"
        eType="//@eClassifiers.3"/>
    <!-- Reference: refNode (to Node, 1..1, non-containment) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="refNode"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

</ecore:EPackage>