<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="MetaRoot"
    nsURI="http://metaroot/1.0"
    nsPrefix="mroot">

  <!-- Root-level classifiers: 0..4 -->
  <!-- 0: EClass -->
  <eClassifiers xsi:type="ecore:EClass" name="Node"
      abstract="false"
      interface="false">
    <!-- Structural features 0 and 1: EReference -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.0"/>
    <!-- 2: EAttribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nodeId"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- 3: EAttribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="weight"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="0"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 1: EClass that extends Node -->
  <eClassifiers xsi:type="ecore:EClass" name="Leaf"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- 0: EAttribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="defaultLabel"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- 1: EAttribute with Boolean type -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="true"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- 2: EEnum with 2 literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- 3: EClass using enum and having both attribute and reference -->
  <eClassifiers xsi:type="ecore:EClass" name="Painter"
      abstract="false"
      interface="false">
    <!-- 0: EAttribute enum-typed -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="favoriteColor"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="//@eClassifiers.2"/>
    <!-- 1: EReference to Node (non-containment, no opposite) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="targetNode"
        ordered="false"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 4: Another EClass to increase classifier variety -->
  <eClassifiers xsi:type="ecore:EClass" name="Gallery"
      abstract="false"
      interface="false">
    <!-- 0: EReference to Painter (multi-valued containment) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="painters"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.3"/>
    <!-- 1: EAttribute string -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="main"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Nested subpackage to exercise eSuperPackage/eSubpackages -->
  <eSubpackages name="SubMeta"
      nsURI="http://metaroot/1.0/sub"
      nsPrefix="mrootsub">
    <!-- In subpackage: 0: EClass -->
    <eClassifiers xsi:type="ecore:EClass" name="SubNode"
        abstract="false"
        interface="false">
      <!-- 0: EAttribute -->
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
          ordered="true"
          unique="true"
          lowerBound="1"
          upperBound="1"
          defaultValueLiteral="S0"
          iD="false"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <!-- 1: EReference back to Gallery in super package -->
      <eStructuralFeatures xsi:type="ecore:EReference" name="homeGallery"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          containment="false"
          resolveProxies="true"
          eType="//@eClassifiers.4"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>