<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="Metamodel9"
    nsURI="http://metamodel9"
    nsPrefix="mm9">

  <!-- Classifier 0: a simple data type to be used as attribute type -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomString"/>

  <!-- Classifier 1: an enumeration with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorKind">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="BLUE" value="1" literal="BLUE"/>
  </eClassifiers>

  <!-- Classifier 2: EClass Shape -->
  <eClassifiers xsi:type="ecore:EClass" name="Shape" abstract="true" interface="false">
    <!-- id attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="shapeId"
                         ordered="true"
                         unique="true"
                         lowerBound="1"
                         upperBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                         iD="true"/>
    <!-- name attribute with default to trigger AttEqSpecificDefaultValue -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="label"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                         defaultValueLiteral="defaultLabel"/>
    <!-- enum-typed attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="color"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Classifier 3: EClass Circle extends Shape, has attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="Circle" abstract="false" interface="false"
                eSuperTypes="//@eClassifiers.2">
    <!-- radius attribute using built-in Double -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="radius"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <!-- custom datatype attribute to drive '@DataType' case -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="tag"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="-1"
                         eType="//@eClassifiers.0"/>
    <!-- containment reference to Rectangle -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="innerRectangles"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="-1"
                         eType="//@eClassifiers.4"
                         containment="true"/>
    <!-- non-containment, opposite reference to Rectangle -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="outerRectangle"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         eType="//@eClassifiers.4"
                         eOpposite="//@eClassifiers.4/@eStructuralFeatures.1"
                         containment="false"/>
  </eClassifiers>

  <!-- Classifier 4: EClass Rectangle extends Shape, has various structural features -->
  <eClassifiers xsi:type="ecore:EClass" name="Rectangle" abstract="false" interface="false"
                eSuperTypes="//@eClassifiers.2">
    <!-- width attribute, Integer -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="width"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- height attribute, Integer with upperBound -1 to exercise '*' case -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="height"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="-1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- opposite reference back to Circle -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="ownerCircle"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         eType="//@eClassifiers.3"
                         eOpposite="//@eClassifiers.3/@eStructuralFeatures.3"
                         containment="false"/>
  </eClassifiers>

</ecore:EPackage>