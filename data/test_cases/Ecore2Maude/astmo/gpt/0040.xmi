<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="mm40"
    nsURI="http://mm40"
    nsPrefix="mm40">

  <!-- Classifier 0: a simple datatype to vary structure (not used by rules that exclude EDataType) -->
  <eClassifiers xsi:type="ecore:EDataType" name="UnusedData" instanceClassName="java.lang.String"/>

  <!-- Classifier 1: EClass with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="Alpha">
    <!-- Attribute 0 on Alpha -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="idAlpha"
        lowerBound="0"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1 on Alpha -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flagAlpha"
        lowerBound="1"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Containment reference from Alpha to Beta -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="betas"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.2"/>
    <!-- Non-containment reference from Alpha to Alpha (self) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="linkToSelf"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Classifier 2: EClass with an attribute and a reference back to Alpha -->
  <eClassifiers xsi:type="ecore:EClass" name="Beta">
    <!-- Attribute on Beta with no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Non-containment reference from Beta to Alpha -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        lowerBound="1"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Classifier 3: Enumeration with several literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

</ecore:EPackage>