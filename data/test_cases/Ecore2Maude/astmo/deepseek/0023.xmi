<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="ShopSystem" nsURI="http://shop/1.0" nsPrefix="shop">
  
  <eClassifiers xsi:type="ecore:EClass" name="Product">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="productCode" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="price" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="inStock" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="category" eType="//@eClassifiers.1" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="supplier" eType="//@eClassifiers.2" containment="true"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="Category">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="categoryCode" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="products" eType="//@eClassifiers.0" upperBound="-1"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="Supplier">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="supplierName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rating" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EEnum" name="ProductStatus">
    <eLiterals name="ACTIVE" value="1"/>
    <eLiterals name="DISCONTINUED" value="2"/>
    <eLiterals name="OUTOFSTOCK" value="3"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EEnum" name="ShippingMethod">
    <eLiterals name="STANDARD" value="0"/>
    <eLiterals name="EXPRESS" value="1"/>
    <eLiterals name="OVERNIGHT" value="2"/>
  </eClassifiers>
  
</ecore:EPackage>