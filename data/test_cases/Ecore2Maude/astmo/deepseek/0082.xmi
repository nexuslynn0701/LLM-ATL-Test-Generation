<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestMM" nsURI="http://test/1.0" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="number" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="1" iD="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" eType="//@eClassifiers.0" containment="true" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="friends" upperBound="-1" eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Employee" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="50000.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="department" eType="//@eClassifiers.3" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager" eType="//@eClassifiers.2" eOpposite="//@eClassifiers.2/@eStructuralFeatures.2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EReference" name="members" upperBound="-1" eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="head" eType="//@eClassifiers.2" eOpposite="//@eClassifiers.2/@eStructuralFeatures.3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals xsi:type="ecore:EEnumLiteral" name="Red" value="1"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="Green" value="2"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="Blue" value="3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals xsi:type="ecore:EEnumLiteral" name="Active" value="0"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="Inactive" value="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDataType" serializable="false"/>
  <eClassifiers xsi:type="ecore:EClass" name="Container">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="data" eType="//@eClassifiers.6"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="nested" eType="//@eClassifiers.7" containment="true" upperBound="-1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Item"/>
</ecore:EPackage>