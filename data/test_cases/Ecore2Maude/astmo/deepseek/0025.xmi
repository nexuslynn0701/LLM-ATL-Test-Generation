<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestModel" nsURI="http://test/1.0" nsPrefix="test">
  
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="friends" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="number" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner" lowerBound="1" upperBound="1" eType="//@eClassifiers.0"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="Company" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" containment="true"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="Department" eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="budget" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parentCompany" lowerBound="1" upperBound="1" eType="//@eClassifiers.2"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EEnum" name="Gender">
    <eLiterals name="MALE" value="0"/>
    <eLiterals name="FEMALE" value="1"/>
    <eLiterals name="OTHER" value="2"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="ACTIVE" value="0"/>
    <eLiterals name="INACTIVE" value="1"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EDataType" name="CustomType" instanceClassName="java.lang.String"/>
  
  <eSubpackages name="SubPkg" nsURI="http://sub/1.0" nsPrefix="sub">
    <eClassifiers xsi:type="ecore:EClass" name="SubClass">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" defaultValueLiteral="default"/>
    </eClassifiers>
  </eSubpackages>
  
</ecore:EPackage>