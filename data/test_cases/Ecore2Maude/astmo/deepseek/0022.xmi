<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestModel" nsURI="http://test/1.0" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" eType="//@eClassifiers.1" containment="true" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="friends" eType="//@eClassifiers.0" upperBound="-1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="number" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="0" upperBound="1" defaultValueLiteral="0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner" eType="//@eClassifiers.0" eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Company" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees" eType="//@eClassifiers.0" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="departments" eType="//@eClassifiers.3" upperBound="-1" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager" eType="//@eClassifiers.0" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subDepartments" eType="//@eClassifiers.3" upperBound="-1" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Gender">
    <eLiterals name="male" value="0"/>
    <eLiterals name="female" value="1"/>
    <eLiterals name="other" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="active" value="0"/>
    <eLiterals name="inactive" value="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="MyCustomType" instanceClassName="java.lang.String"/>
  <eClassifiers xsi:type="ecore:EClass" name="Product">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="price" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="inStock" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" lowerBound="0" upperBound="1" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="category" eType="//@eClassifiers.7" containment="true" lowerBound="0" upperBound="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Category">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="//@eClassifiers.7" lowerBound="0" upperBound="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Order">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="orderId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="totalAmount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="items" eType="//@eClassifiers.9" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="customer" eType="//@eClassifiers.0" lowerBound="1" upperBound="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="OrderItem">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="quantity" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="product" eType="//@eClassifiers.6" lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="order" eType="//@eClassifiers.8" eOpposite="//@eClassifiers.8/@eStructuralFeatures.2"/>
  </eClassifiers>
</ecore:EPackage>