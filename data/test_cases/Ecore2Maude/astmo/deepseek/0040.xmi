<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="MyMetamodel" nsURI="http://mymetamodel/1.0" nsPrefix="my">
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstName" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" upperBound="1" eType="//@eClassifiers.1" containment="false" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="friends" upperBound="-1" eType="//@eClassifiers.0" containment="false" resolveProxies="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="number" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" iD="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Gender">
    <eLiterals name="MALE" value="0" literal="Male"/>
    <eLiterals name="FEMALE" value="1" literal="Female"/>
    <eLiterals name="OTHER" value="2" literal="Other"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="Red"/>
    <eLiterals name="GREEN" value="1" literal="Green"/>
    <eLiterals name="BLUE" value="2" literal="Blue"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Employee" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager" upperBound="1" eType="//@eClassifiers.2" containment="false" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subordinates" upperBound="-1" eType="//@eClassifiers.2" containment="false" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat" iD="false" defaultValueLiteral="1000.0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="CustomType" serializable="true"/>
</ecore:EPackage>