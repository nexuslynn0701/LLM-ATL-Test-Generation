<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestMM" nsURI="http://test/1.0" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" eOpposite="//@eClassifiers.0/@eStructuralFeatures.0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SubClass" abstract="false" interface="false" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="level" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="links" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="Red"/>
    <eLiterals name="GREEN" value="1" literal="Green"/>
    <eLiterals name="BLUE" value="2" literal="Blue"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ColoredElement" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="color" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" defaultValueLiteral="RED"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="CustomType" serializable="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="DataHolder" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="data" lowerBound="0" upperBound="1" eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner" lowerBound="1" upperBound="1" eType="//@eClassifiers.3"/>
  </eClassifiers>
  <eSubpackages name="Internal" nsURI="http://test/internal/1.0" nsPrefix="int">
    <eClassifiers xsi:type="ecore:EClass" name="NestedClass" abstract="false" interface="false"/>
    <eClassifiers xsi:type="ecore:EEnum" name="Status">
      <eLiterals name="ON" value="0" literal="On"/>
      <eLiterals name="OFF" value="1" literal="Off"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>