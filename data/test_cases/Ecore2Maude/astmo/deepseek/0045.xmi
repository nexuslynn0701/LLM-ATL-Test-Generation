<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="Test" nsURI="http://test" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EClass" name="RootClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="attr1" lowerBound="0" upperBound="1" iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ref1" lowerBound="0" upperBound="-1" containment="true"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ref2" lowerBound="1" upperBound="1" containment="false"
        eType="//@eClassifiers.2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" upperBound="1" iD="false"
        ordered="true" unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="0" upperBound="1" iD="false"
        defaultValueLiteral="42"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parentRef" lowerBound="0" upperBound="1" containment="false"
        eType="//@eClassifiers.0" eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TargetClass" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag" lowerBound="0" upperBound="1" iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="backRef" lowerBound="0" upperBound="1" containment="false"
        eType="//@eClassifiers.0" eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals xsi:type="ecore:EEnumLiteral" name="RED" value="0" literal="red"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="GREEN" value="1" literal="green"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="BLUE" value="2" literal="blue"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="WithEnum">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="colorAttr" lowerBound="1" upperBound="1" iD="false"
        eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="floatAttr" lowerBound="0" upperBound="1" iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDataType" instanceClassName="java.util.Date"/>
</ecore:EPackage>