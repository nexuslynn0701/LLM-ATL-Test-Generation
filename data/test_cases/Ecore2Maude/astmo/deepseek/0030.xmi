<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="mypkg" nsURI="http://mypkg" nsPrefix="myp">
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="0" upperBound="1" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1" upperBound="1" iD="false" defaultValueLiteral="John"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="friends" eType="//@eClassifiers.0" lowerBound="0" upperBound="-1" containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" eType="//@eClassifiers.2" lowerBound="0" upperBound="1" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Employee" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="1" upperBound="1" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager" eType="//@eClassifiers.1" lowerBound="0" upperBound="1" containment="false" eOpposite="//@eClassifiers.1/@eStructuralFeatures.3"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subordinates" eType="//@eClassifiers.1" lowerBound="0" upperBound="-1" containment="false" eOpposite="//@eClassifiers.1/@eStructuralFeatures.2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="city" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1" upperBound="1" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="zip" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="0" upperBound="1" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="person" eType="//@eClassifiers.0" lowerBound="0" upperBound="-1" containment="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="MyStringType" instanceClassName="java.lang.String"/>
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals xsi:type="ecore:EEnumLiteral" name="RED" value="0" literal="RED"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="BLUE" value="1" literal="BLUE"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="GREEN" value="2" literal="GREEN"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Size">
    <eLiterals xsi:type="ecore:EEnumLiteral" name="SMALL" value="0" literal="SMALL"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="MEDIUM" value="1" literal="MEDIUM"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="LARGE" value="2" literal="LARGE"/>
  </eClassifiers>
  <eSubpackages xsi:type="ecore:EPackage" name="subpkg" nsURI="http://subpkg" nsPrefix="subp">
    <eClassifiers xsi:type="ecore:EClass" name="SubClass">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="subAtt" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" lowerBound="1" upperBound="1" iD="false"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>