<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestMetamodel" nsURI="http://test" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0"/>
    <eLiterals name="GREEN" value="1"/>
    <eLiterals name="BLUE" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="favoriteColor" eType="//@eClassifiers.0" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" eType="//@eClassifiers.2" containment="true" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="friends" eType="//@eClassifiers.1" lowerBound="0" upperBound="-1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="city" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner" eType="//@eClassifiers.1" lowerBound="0" upperBound="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Company" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="revenue" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" lowerBound="0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees" eType="//@eClassifiers.1" lowerBound="0" upperBound="-1" containment="true"/>
  </eClassifiers>
</ecore:EPackage>