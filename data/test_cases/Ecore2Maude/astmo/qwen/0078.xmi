<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestMetamodel" nsURI="http://test" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EClass" name="RootClass"/>
  <eClassifiers xsi:type="ecore:EClass" name="BaseEntity" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="1" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="//@eClassifiers.1" containment="false" resolveProxies="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SpecializedEntity" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="0" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" eType="//@eClassifiers.1" containment="true" upperBound="-1" resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="ACTIVE" value="0" literal="active"/>
    <eLiterals name="INACTIVE" value="1" literal="inactive"/>
    <eLiterals name="PENDING" value="2" literal="pending"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ConfigurableItem">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" eType="//@eClassifiers.3" lowerBound="1" defaultValueLiteral="ACTIVE"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tags" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="0" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="relatedItems" eType="//@eClassifiers.4" containment="false" upperBound="-1" resolveProxies="true"/>
  </eClassifiers>
</ecore:EPackage>