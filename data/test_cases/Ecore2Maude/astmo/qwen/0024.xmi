<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestModel" nsURI="http://testmodel" nsPrefix="tm">
  <eClassifiers xsi:type="ecore:EClass" name="Person"/>
  <eClassifiers xsi:type="ecore:EClass" name="Address" eSuperTypes="//@eClassifiers.0"/>
  <eClassifiers xsi:type="ecore:EEnum" name="Gender">
    <eLiterals name="MALE" value="0" literal="MALE"/>
    <eLiterals name="FEMALE" value="1" literal="FEMALE"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1" upperBound="1"/>
  <eClassifiers xsi:type="ecore:EAttribute" name="age" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="0" upperBound="1"/>
  <eClassifiers xsi:type="ecore:EAttribute" name="gender" eType="//@eClassifiers.2" lowerBound="1" upperBound="1" defaultValueLiteral="MALE"/>
  <eClassifiers xsi:type="ecore:EAttribute" name="isStudent" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" lowerBound="1" upperBound="1" iD="false"/>
  <eClassifiers xsi:type="ecore:EReference" name="homeAddress" eType="//@eClassifiers.1" containment="true" lowerBound="0" upperBound="1"/>
  <eClassifiers xsi:type="ecore:EReference" name="workAddress" eType="//@eClassifiers.1" containment="true" lowerBound="0" upperBound="-1"/>
  <eClassifiers xsi:type="ecore:EReference" name="spouse" eType="//@eClassifiers.0" eOpposite="//@eClassifiers.9"/>
  <eClassifiers xsi:type="ecore:EReference" name="partner" eType="//@eClassifiers.0" eOpposite="//@eClassifiers.10"/>
  <!-- Person structural features -->
  <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true" lowerBound="1" upperBound="1"/>
  <eStructuralFeatures xsi:type="ecore:EAttribute" name="email" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="0" upperBound="1"/>
  <eStructuralFeatures xsi:type="ecore:EReference" name="addresses" eType="//@eClassifiers.1" containment="true" lowerBound="0" upperBound="-1"/>
  <!-- Address structural features -->
  <eStructuralFeatures xsi:type="ecore:EAttribute" name="street" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1" upperBound="1"/>
  <eStructuralFeatures xsi:type="ecore:EAttribute" name="city" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1" upperBound="1"/>
  <eStructuralFeatures xsi:type="ecore:EAttribute" name="zipCode" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="1" upperBound="1"/>
</ecore:EPackage>