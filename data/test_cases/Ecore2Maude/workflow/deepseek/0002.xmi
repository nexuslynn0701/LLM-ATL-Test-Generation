<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://ecore" name="RootPkg" nsURI="http://root" nsPrefix="root">
  <eSubpackages xsi:type="ecore:EPackage" name="SubPkg" nsURI="http://sub" nsPrefix="sub">
    <eClassifiers xsi:type="ecore:EClass" name="SubClass"/>
  </eSubpackages>
  <eClassifiers xsi:type="ecore:EClass" name="NamedElement" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="Person" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" iD="true" defaultValueLiteral="0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fullName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" defaultValueLiteral="default desc" ordered="false" unique="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" eType="//@eClassifiers.2" containment="true" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employer" eType="//@eClassifiers.3" lowerBound="0" upperBound="1" eOpposite="//@eClassifiers.3/@eStructuralFeatures.0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Address">
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Company">
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees" eType="//@eClassifiers.1" lowerBound="0" upperBound="-1" ordered="false" unique="false" eOpposite="//@eClassifiers.1/@eStructuralFeatures.5"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Order">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="orderId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals xsi:type="ecore:EEnumLiteral" name="red" value="0" literal="red"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="blue" value="1" literal="blue"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="EmptyEnum"/>
</ecore:EPackage>