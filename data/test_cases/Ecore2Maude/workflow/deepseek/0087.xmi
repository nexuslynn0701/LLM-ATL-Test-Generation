<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://ecore" name="mymetamodel" nsURI="http://example.com/mymetamodel" nsPrefix="mm">
  <eClassifiers xsi:type="ecore:EClass" name="MyClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="myAttr" lowerBound="1" upperBound="1" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="myRef" lowerBound="0" upperBound="-1" containment="true" eType="//@eClassifiers.0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="MyEnum">
    <eLiterals name="LIT1" value="0" literal="lit1"/>
    <eLiterals name="LIT2" value="1" literal="lit2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AnotherClass" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="anotherAttr" lowerBound="0" upperBound="1" defaultValueLiteral="defaultVal"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="anotherRef" lowerBound="1" upperBound="1" eType="//@eClassifiers.0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="MyDataType"/>
</ecore:EPackage>