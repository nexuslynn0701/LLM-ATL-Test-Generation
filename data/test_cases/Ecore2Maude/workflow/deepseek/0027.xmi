<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://ecore" name="myModel" nsURI="http://my/model" nsPrefix="my">
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" lowerBound="0" upperBound="1" eAttributeType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="friends" upperBound="-1" eType="#//@eClassifiers.0" containment="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Employee" eSuperTypes="#//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary" lowerBound="1" upperBound="1" defaultValueLiteral="50000" eAttributeType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager" lowerBound="0" upperBound="1" eType="#//@eClassifiers.0" containment="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="EInt" instanceClassName="int"/>
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0"/>
    <eLiterals name="GREEN" value="1"/>
    <eLiterals name="BLUE" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="ACTIVE" value="0"/>
    <eLiterals name="INACTIVE" value="1"/>
  </eClassifiers>
</ecore:EPackage>