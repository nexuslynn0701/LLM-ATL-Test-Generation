<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="mutationtest" nsURI="http://mut" nsPrefix="mt">
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="DerivedClass" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EReference" name="refToAnother" eType="//@eClassifiers.3"
        containment="true" eOpposite="//@eClassifiers.3/@eStructuralFeatures.0" lowerBound="1"
        upperBound="1" ordered="false" unique="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0" defaultValueLiteral="defaultName"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="favoriteColor" eType="//@eClassifiers.2"
        lowerBound="0" defaultValueLiteral="red"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="score" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"
        lowerBound="0" defaultValueLiteral="3.14" volatile="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="Red" value="0" literal="red"/>
    <eLiterals name="Blue" value="1" literal="blue"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AnotherClass">
    <eStructuralFeatures xsi:type="ecore:EReference" name="backRef" eType="//@eClassifiers.1"
        containment="false" eOpposite="//@eClassifiers.1/@eStructuralFeatures.0" lowerBound="0"
        upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="simpleRef" eType="//@eClassifiers.0"
        containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="desc"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="EmptyEnum"/>
  <eSubpackages xsi:type="ecore:EPackage" name="sub1"/>
  <eSubpackages xsi:type="ecore:EPackage" name="sub2">
    <eClassifiers xsi:type="ecore:EClass" name="SubClassInP2"/>
  </eSubpackages>
</ecore:EPackage>