<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://ecore" name="RootPkg" nsURI="http://rootpkg" nsPrefix="rp">
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass">
    <eStructuralFeatures xsi:type="ecore:EReference" name="sub" eType="//@eClassifiers.1" eOpposite="//@eClassifiers.1/@eStructuralFeatures.2" lowerBound="0" upperBound="-1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DerivedClass" abstract="true" eSuperTypes="//@eClassifiers.0 //@eSubpackages.0/@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="1" upperBound="1" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="//@eClassifiers.0" containment="true" eOpposite="//@eClassifiers.0/@eStructuralFeatures.0" lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="color" eType="//@eClassifiers.2" defaultValueLiteral="RED"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ecoreRef" eType="//@eSubpackages.0/@eClassifiers.0" containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="amount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isActive" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0"/>
    <eLiterals name="GREEN" value="1"/>
    <eLiterals name="BLUE" value="2"/>
  </eClassifiers>
  <eSubpackages xsi:type="ecore:EPackage" name="ecore" nsURI="http://ecore" nsPrefix="ec">
    <eClassifiers xsi:type="ecore:EClass" name="ECoreBase"/>
  </eSubpackages>
</ecore:EPackage>