<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://ecore" name="MainPkg" nsURI="http://main" nsPrefix="mp">
  <eClassifiers xsi:type="ecore:EClass" name="SuperClass" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EReference" name="childRef" eType="//@eClassifiers.1" containment="false" eOpposite="//@eClassifiers.1/@eStructuralFeatures.0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SubClass" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EReference" name="parentRef" eType="//@eClassifiers.0" containment="true" eOpposite="//@eClassifiers.0/@eStructuralFeatures.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="idAttr" iD="true" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="desc" defaultValueLiteral="hello world" ordered="false" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="color" ordered="false" unique="false" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="extraAttr" volatile="true" transient="true" lowerBound="0" upperBound="4" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="CustomType" instanceTypeName="java.lang.String"/>
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals xsi:type="ecore:EEnumLiteral" name="Red"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="Blue"/>
  </eClassifiers>
  <eSubpackages xsi:type="ecore:EPackage" name="SubPkg" nsURI="http://sub" nsPrefix="sp">
    <eClassifiers xsi:type="ecore:EClass" name="InnerClass"/>
  </eSubpackages>
</ecore:EPackage>