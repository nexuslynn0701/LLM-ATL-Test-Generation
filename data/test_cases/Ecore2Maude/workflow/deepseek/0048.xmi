<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://ecore" name="mymetamodel" nsURI="http://example.com/test" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EClass" name="MyClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="myAttr" lowerBound="1" upperBound="1" iD="false" ordered="true" unique="true" changeable="true" volatile="false" transient="false" defaultValueLiteral="defaultVal"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="myRef" lowerBound="0" upperBound="-1" containment="true" resolveProxies="true" ordered="true" unique="true" changeable="true" volatile="false" transient="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SubClass" abstract="false" interface="false">
    <eSuperTypes xsi:type="ecore:EClass" href="#//MyClass"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="subAttr" lowerBound="0" upperBound="1" iD="false" ordered="true" unique="true" changeable="true" volatile="false" transient="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="MyEnum">
    <eLiterals name="LIT1" value="0" literal="lit1"/>
    <eLiterals name="LIT2" value="1" literal="lit2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="MyDataType" serializable="true"/>
</ecore:EPackage>