<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://ecore" name="mypkg" nsURI="http://mypkg" nsPrefix="mp">
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="myId" lowerBound="0" upperBound="1" iD="true" defaultValueLiteral="myDefault" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="toChild" lowerBound="0" upperBound="-1" containment="true" eType="//@eClassifiers.1" eOpposite="//@eClassifiers.1/@eStructuralFeatures.0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EReference" name="toParent" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="plainRef" lowerBound="0" upperBound="1" eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" lowerBound="1" upperBound="1" defaultValueLiteral="Active" eType="//@eClassifiers.3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="OtherClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="count" ordered="false" unique="false" lowerBound="0" upperBound="10" eType="//@eClassifiers.5"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="Active" value="1"/>
    <eLiterals name="Inactive" value="2"/>
    <eLiterals name="Pending" value="3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="NoTypeDT"/>
  <eClassifiers xsi:type="ecore:EDataType" name="IntType"/>
  <eSubpackages name="subpkg" nsURI="http://subpkg" nsPrefix="sp">
    <eClassifiers xsi:type="ecore:EClass" name="SubClass">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="subAttr" ordered="false" unique="false" lowerBound="0" upperBound="1" eType="//@eClassifiers.4"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>