<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://ecore" name="mymetamodel" nsURI="http://example.com" nsPrefix="mm">
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" lowerBound="0" upperBound="1" iD="false" ordered="true" unique="true" defaultValueLiteral="0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="friends" upperBound="-1" containment="false" resolveProxies="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="true">
    <eSuperTypes xsi:type="ecore:EClass" href="#//Person"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary" lowerBound="1" upperBound="1" iD="false" ordered="true" unique="true" defaultValueLiteral="50000"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager" upperBound="1" containment="false" resolveProxies="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="red"/>
    <eLiterals name="GREEN" value="1" literal="green"/>
    <eLiterals name="BLUE" value="2" literal="blue"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="MyString" instanceClassName="java.lang.String"/>
</ecore:EPackage>