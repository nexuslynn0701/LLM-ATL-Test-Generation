<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="rootURI"
    nsPrefix="root">
  <!-- Class Person with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false">
    <!-- id attribute, String, iD=true, default value -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="ID-000"
        iD="true"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- age attribute, int, non-ID, has bounds -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="18"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- status attribute, enum -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eAttributeType="//@eClassifiers.4"/>
    <!-- one-to-many containment reference to Address -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="addresses"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="false"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.0"/>
    <!-- non-containment reference to Department with opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="department"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.2"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- Class Address contained in Person, with back-reference -->
  <eClassifiers xsi:type="ecore:EClass" name="Address" abstract="false" interface="false">
    <!-- container reference back to Person -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        containment="false"
        resolveProxies="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"/>
    <!-- street attribute, String -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="unknown street"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Class Department with super type Person (to trigger createSort), and references -->
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="true" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- opposite reference to Person.department -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employees"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.4"/>
    <!-- name attribute, String -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="dept"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Simple EDataType -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomData"/>

  <!-- Enum Status with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>
</ecore:EPackage>