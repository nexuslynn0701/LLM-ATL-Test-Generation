<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://example/rootPkg"
    nsPrefix="root">
  <!-- Root package has one subpackage and one classifier (an EEnum) -->
  <eSubpackages name="subPkg"
                nsURI="http://example/subPkg"
                nsPrefix="sub">
    <!-- Subpackage has two EClasses to trigger createSort via eSuperTypes -->
    <eClassifiers xsi:type="ecore:EClass" name="BaseClass"/>
    <eClassifiers xsi:type="ecore:EClass" name="DerivedClass"
                  eSuperTypes="//@eSubpackages.0/@eClassifiers.0"/>
  </eSubpackages>
  <!-- Enum with no literals (to trigger mtOrdConstant in EqLiterals) -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color"/>
</ecore:EPackage>