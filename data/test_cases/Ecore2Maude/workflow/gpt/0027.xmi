<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://example/rootpkg"
    nsPrefix="root">

  <!-- Root package classifiers -->
  <!-- 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        iD="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass"
      abstract="true"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="refToBase"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 2 -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- 3 -->
  <eClassifiers xsi:type="ecore:EEnum" name="Size">
    <eLiterals name="SMALL" value="0" literal="SMALL"/>
  </eClassifiers>

  <!-- 4 -->
  <eClassifiers xsi:type="ecore:EClass" name="Holder">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="label"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="defaultLabel"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="baseRef"
        lowerBound="0"
        upperBound="1"
        containment="true"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 5 -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumUser">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="colorAttr"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="RED"
        eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="sizeAttr"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="SMALL"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- 6 -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomNumber"
      instanceTypeName="int"/>

  <!-- 7 -->
  <eClassifiers xsi:type="ecore:EClass" name="NumberHolder">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="num"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

</ecore:EPackage>