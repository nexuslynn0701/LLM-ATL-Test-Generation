<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://root"
    nsPrefix="r">
  <!-- Class 0: root, refers to subpackage class via reference, has attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootId"
        lowerBound="1"
        upperBound="1"
        iD="true"
        ordered="true"
        unique="true"
        defaultValueLiteral="42"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="child"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        ordered="true"
        unique="true"
        eType="//@eSubpackages.0/@eClassifiers.0"/>
  </eClassifiers>

  <!-- Class 1: base class in root package, superclass of Class2 -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="baseName"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="base"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Class 2: subclass of BaseClass, has attribute and reference with opposite -->
  <eClassifiers xsi:type="ecore:EClass" name="DerivedClass" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="backToRoot"
        lowerBound="0"
        upperBound="1"
        containment="false"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- Enum 3 with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- Enum 4 with one literal -->
  <eClassifiers xsi:type="ecore:EEnum" name="SizeEnum">
    <eLiterals name="SMALL" value="0" literal="SMALL"/>
  </eClassifiers>

  <!-- DataType 5: for attribute type -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomString"
      instanceClassName="java.lang.String"/>

  <!-- Subpackage -->
  <eSubpackages name="subpkg" nsURI="http://sub" nsPrefix="s">
    <!-- Class 0 in subpackage -->
    <eClassifiers xsi:type="ecore:EClass" name="SubClass" abstract="false" interface="false">
      <!-- Attribute 0: uses EString -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="subName"
          lowerBound="0"
          upperBound="1"
          ordered="true"
          unique="true"
          defaultValueLiteral="sub"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <!-- Attribute 1: uses ColorEnum -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="color"
          lowerBound="0"
          upperBound="1"
          ordered="true"
          unique="true"
          eType="//@eClassifiers.3"/>
      <!-- Attribute 2: uses SizeEnum with default literal -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="size"
          lowerBound="0"
          upperBound="1"
          ordered="true"
          unique="true"
          defaultValueLiteral="SMALL"
          eType="//@eClassifiers.4"/>
      <!-- Reference 3: non-containment multiplicity 1..* to DerivedClass -->
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="deriveds"
          lowerBound="1"
          upperBound="-1"
          containment="false"
          ordered="true"
          unique="true"
          eType="//@eClassifiers.2"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>