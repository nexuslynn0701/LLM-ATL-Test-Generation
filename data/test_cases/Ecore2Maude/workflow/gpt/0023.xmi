<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://example/rootpkg"
    nsPrefix="root">
  <!-- Class C1 with int attribute and reference to C2 -->
  <eClassifiers xsi:type="ecore:EClass" name="C1" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="a1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="1"
        iD="true"
        ordered="true"
        unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="r1"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        ordered="true"
        unique="true"/>
  </eClassifiers>

  <!-- Class C2 extending C1, with String attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="C2" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="a2"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="defVal"
        ordered="false"
        unique="false"/>
  </eClassifiers>

  <!-- Enumeration E1 with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="E1">
    <eLiterals name="L1" value="0" literal="L1"/>
    <eLiterals name="L2" value="1" literal="L2"/>
  </eClassifiers>

  <!-- Attribute using enumeration E1 -->
  <eClassifiers xsi:type="ecore:EClass" name="C3" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="eattr"
        eType="//@eClassifiers.2"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"/>
  </eClassifiers>
</ecore:EPackage>