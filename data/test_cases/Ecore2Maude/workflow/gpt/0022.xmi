<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="testpkg"
    nsURI="http://testpkg"
    nsPrefix="tp">

  <!-- Class 0: root class with attributes and a containment reference -->
  <eClassifiers xsi:type="ecore:EClass" name="Root" abstract="false" interface="false">
    <!-- Attribute 0 on Root: String-typed ID attribute with default value -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootName"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        transient="false"
        volatile="false"
        unsettable="false"
        derived="false"
        defaultValueLiteral="defaultRootName"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1 on Root: Int-typed, multiplicity [0..*] -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootCount"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        transient="false"
        volatile="false"
        unsettable="false"
        derived="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Containment reference to Child -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        transient="false"
        volatile="false"
        unsettable="false"
        derived="false"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Class 1: Child, extends Root, has attributes and a bidirectional reference to Leaf -->
  <eClassifiers xsi:type="ecore:EClass" name="Child" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute 0 on Child: Boolean-typed, with default value -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        transient="false"
        volatile="false"
        unsettable="false"
        derived="false"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Attribute 1 on Child: Enum-typed (Status) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        transient="false"
        volatile="false"
        unsettable="false"
        derived="false"
        eType="//@eClassifiers.3"/>
    <!-- Non-containment reference to Leaf, opposite is leafOwner -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="leafRef"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        transient="false"
        volatile="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.2"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- Class 2: Leaf, no supertypes, opposite reference back to Child -->
  <eClassifiers xsi:type="ecore:EClass" name="Leaf" abstract="false" interface="false">
    <!-- Opposite reference back to Child.leafRef -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="leafOwner"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        transient="false"
        volatile="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.2"/>
    <!-- Attribute on Leaf: Double-typed, multiplicity [0..*] -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="value"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        transient="false"
        volatile="false"
        unsettable="false"
        derived="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- Enum 3: Status with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="DONE" value="1" literal="DONE"/>
  </eClassifiers>

</ecore:EPackage>