<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootMeta"
    nsURI="http://root/meta"
    nsPrefix="rm">

  <!-- Class 0: Root class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="RootEntity" abstract="false" interface="false">
    <!-- Attribute 0: ID attribute with String type and default value -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        defaultValueLiteral="defaultId"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1: Integer-typed attribute without default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="count"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference 0: containment reference to ChildEntity -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.1"/>
    <!-- Reference 1: non-containment reference to Node with opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="mainNode"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.1"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- Class 1: Child entity extending RootEntity, with enum-typed attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildEntity" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute 0: enum-typed attribute with default literal -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        defaultValueLiteral="ACTIVE"
        eType="//@eClassifiers.4"/>
    <!-- Reference 0: reference back to RootEntity (no opposite) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- Class 2: Node class with opposite reference to RootEntity and attribute with default -->
  <eClassifiers xsi:type="ecore:EClass" name="Node" abstract="false" interface="false">
    <!-- Attribute 0: boolean attribute with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Reference 0: opposite of RootEntity.mainNode -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="ownerRoot"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- Enum 3: Priority with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Priority">
    <eLiterals name="LOW" value="0" literal="LOW"/>
    <eLiterals name="HIGH" value="1" literal="HIGH"/>
  </eClassifiers>

  <!-- Enum 4: Status with three literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
    <eLiterals name="PENDING" value="2" literal="PENDING"/>
  </eClassifiers>

</ecore:EPackage>