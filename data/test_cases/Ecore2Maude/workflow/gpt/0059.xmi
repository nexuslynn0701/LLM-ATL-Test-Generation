<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://rootpkg"
    nsPrefix="root">

  <!-- Classifier 0: root-level concrete class -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <!-- Attribute 0: ID attribute with String type -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootId"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="RID"/>
    <!-- Attribute 1: Boolean attribute with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        lowerBound="0"
        upperBound="1"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true"/>
    <!-- Reference 2: containment reference to SubClass -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Classifier 1: subclass of RootClass -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute 0: Integer attribute with bounds -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="count"
        lowerBound="0"
        upperBound="-1"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="0"/>
    <!-- Reference 1: non-containment reference back to RootClass, with opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        lowerBound="1"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.0"
        resolveProxies="true"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- Classifier 2: an EEnum with two literals -->
  <eClassifiers xsi:type="ecore:EClass" name="Priority" abstract="false" interface="false">
    <!-- Attribute 0: enum-typed attribute using primitive String with constrained values -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="value"
        lowerBound="1"
        upperBound="1"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="LOW"/>
  </eClassifiers>

  <!-- Classifier 3: another "enum-like" class with one literal -->
  <eClassifiers xsi:type="ecore:EClass" name="State" abstract="false" interface="false">
    <!-- Attribute 0: enum-typed attribute using primitive String with constrained values -->
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="value"
        lowerBound="1"
        upperBound="1"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="NEW"/>
  </eClassifiers>

  <!-- Classifier 4: a DataType used by an attribute -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomData" instanceTypeName="java.lang.String"/>

  <!-- Classifier 5: class using "enum-like" and custom-typed attributes -->
  <eClassifiers xsi:type="ecore:EClass" name="Task" abstract="false" interface="false">
    <!-- Attribute 0: attribute typed as primitive String with default "LOW" -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="priority"
        lowerBound="0"
        upperBound="1"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="LOW"/>
    <!-- Attribute 1: attribute typed as primitive String with default "NEW" -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="state"
        lowerBound="0"
        upperBound="1"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="NEW"/>
    <!-- Attribute 2: custom datatype attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="0"
        upperBound="1"
        eAttributeType="//@eClassifiers.4"
        defaultValueLiteral="T-001"/>
    <!-- Reference 3: reference to SubClass without opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="relatedSub"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

</ecore:EPackage>