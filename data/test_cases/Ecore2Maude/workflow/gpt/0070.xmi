<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://example/root"
    nsPrefix="root">
  <!-- 0: Class A -->
  <eClassifiers xsi:type="ecore:EClass" name="ClassA">
    <!-- Attribute a1 : String, isID, lower=1, upper=1, default with quotes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="a1"
        ordered="true" unique="true"
        lowerBound="1" upperBound="1"
        defaultValueLiteral="defaultA1&quot;value"
        iD="true">
      <eType eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eStructuralFeatures>
    <!-- Attribute a2 : Boolean, non-ID, lower=0, upper=-1 (*), no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="a2"
        ordered="false" unique="false"
        lowerBound="0" upperBound="-1">
      <eType eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    </eStructuralFeatures>
    <!-- Reference r1 : ClassB, containment, opposite r2, lower=0, upper=-1 -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="r1"
        ordered="true" unique="true"
        lowerBound="0" upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- 1: Class B, subclass of ClassA -->
  <eClassifiers xsi:type="ecore:EClass" name="ClassB"
      abstract="true"
      interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute b1 : Integer, non-ID, lower=2, upper=5, numeric default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="b1"
        ordered="true" unique="true"
        lowerBound="2" upperBound="5"
        defaultValueLiteral="42">
      <eType eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eStructuralFeatures>
    <!-- Reference r2 : ClassA, non-containment, opposite r1, lower=1, upper=1 -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="r2"
        ordered="false" unique="true"
        lowerBound="1" upperBound="1"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- 2: Enum Color with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- 3: Class C using Color and custom data type -->
  <eClassifiers xsi:type="ecore:EClass" name="ClassC">
    <!-- Attribute c1 : Color (EEnum), default RED -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="c1"
        ordered="true" unique="true"
        lowerBound="0" upperBound="1"
        defaultValueLiteral="RED">
      <eType eType="//@eClassifiers.2"/>
    </eStructuralFeatures>
    <!-- Attribute c2 : Custom data type CodeType, no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="c2"
        ordered="true" unique="true"
        lowerBound="0" upperBound="1">
      <eType eType="//@eClassifiers.4"/>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- 4: Custom EDataType -->
  <eClassifiers xsi:type="ecore:EDataType" name="CodeType" instanceTypeName="java.lang.String"/>
</ecore:EPackage>