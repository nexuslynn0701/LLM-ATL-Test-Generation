<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="modelRoot"
    nsURI="http://example/modelRoot"
    nsPrefix="mroot">

  <!-- Classifier 0: RootClass -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass">
    <!-- Attribute 0 of RootClass -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootName"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Classifier 1: SubClass extends RootClass, has attribute and reference -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass" abstract="true">
    <!-- Super type RootClass -->
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>

    <!-- Attribute 0 of SubClass -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="subValue"
        lowerBound="0"
        upperBound="*"
        defaultValueLiteral="42"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>

    <!-- Reference 1 of SubClass: to RootClass, non-opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="rootRef"
        lowerBound="0"
        upperBound="*"
        containment="false"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- Classifier 2: AnotherClass with containment reference and attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="AnotherClass">
    <!-- Attribute 0 of AnotherClass -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="anotherFlag"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>

    <!-- Reference 1 of AnotherClass: contains SubClass, opposite set later -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Classifier 3: SimpleEnum -->
  <eClassifiers xsi:type="ecore:EEnum" name="SimpleEnum">
    <eLiterals name="FIRST" value="0" literal="FIRST"/>
    <eLiterals name="SECOND" value="1" literal="SECOND"/>
  </eClassifiers>

  <!-- Classifier 4: ColorEnum -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <!-- Classifier 5: DataType1 -->
  <eClassifiers xsi:type="ecore:EDataType" name="DataType1" instanceTypeName="java.lang.String"/>

  <!-- Classifier 6: DataType2 -->
  <eClassifiers xsi:type="ecore:EDataType" name="DataType2" instanceTypeName="java.lang.Integer"/>

  <!-- Classifier 7: EnumClass with enum attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="simpleKind"
        lowerBound="0"
        upperBound="1"
        eAttributeType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- Classifier 8: OppositeReferenceClass with opposite references -->
  <eClassifiers xsi:type="ecore:EClass" name="OppositeReferenceClass">
    <!-- forward reference to AnotherClass -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="another"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.2"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.1"/>
  </eClassifiers>

</ecore:EPackage>