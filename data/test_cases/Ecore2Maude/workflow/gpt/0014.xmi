<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="rootURI"
    nsPrefix="root">
  <!-- Class Base -->
  <eClassifiers xsi:type="ecore:EClass" name="Base">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="baseId"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="baseFlag"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- Class A extending Base -->
  <eClassifiers xsi:type="ecore:EClass" name="A"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="aName"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="defaultA"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="aCount"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="aToB"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="aOwnedBs"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- Class B extending Base -->
  <eClassifiers xsi:type="ecore:EClass" name="B"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="bLabel"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="lbl"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="bToA"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- Enum Color -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- Class C using Color and primitive attributes -->
  <eClassifiers xsi:type="ecore:EClass" name="C">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="cColor"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="RED"
        eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="cNumber"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="cToA"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

</ecore:EPackage>