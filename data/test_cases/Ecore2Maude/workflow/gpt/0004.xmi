<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://rootpkg"
    nsPrefix="root">

  <!-- Class 0: local class with supertype from external ecore package (EObject) -->
  <eClassifiers xsi:type="ecore:EClass" name="LocalClass">
    <eSuperTypes>ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EObject</eSuperTypes>
  </eClassifiers>

</ecore:EPackage>