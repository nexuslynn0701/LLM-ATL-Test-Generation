<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="rootURI"
    nsPrefix="root">
  <!-- Class C1 with attributes and a containment reference -->
  <eClassifiers xsi:type="ecore:EClass" name="C1">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="a1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        iD="true"
        defaultValueLiteral="dval_a1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0"
        upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        eType="//@eClassifiers.1"
        containment="true"
        lowerBound="0"
        upperBound="-1"/>
  </eClassifiers>

  <!-- Class C2 extending C1, with its own attribute and a non-containment reference to C3 -->
  <eClassifiers xsi:type="ecore:EClass"
      name="C2"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="num"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="link"
        eType="//@eClassifiers.2"
        containment="false"
        lowerBound="1"
        upperBound="1"/>
  </eClassifiers>

  <!-- Class C3 with one attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="C3">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"/>
  </eClassifiers>

  <!-- Enumeration with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- Class C4 with an enum-typed attribute and a plain EDataType attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="C4">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="color"
        eType="//@eClassifiers.3"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="RED"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        eType="//@eClassifiers.5"
        lowerBound="0"
        upperBound="1"/>
  </eClassifiers>

  <!-- Simple custom EDataType used by C4.code -->
  <eClassifiers xsi:type="ecore:EDataType" name="CodeType"/>
</ecore:EPackage>