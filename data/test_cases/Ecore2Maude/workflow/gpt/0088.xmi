<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://example/root"
    nsPrefix="root">
  <!-- 0: Enum used as attribute type and with literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>
  <!-- 1: DataType to be used as attribute type -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomString" instanceTypeName="java.lang.String"/>
  <!-- 2: Super class -->
  <eClassifiers xsi:type="ecore:EClass" name="NamedElement" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <!-- 3: Class with both attribute and reference, super type NamedElement -->
  <eClassifiers xsi:type="ecore:EClass" name="Node" eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="label"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="defaultLabel"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.3"/>
  </eClassifiers>
  <!-- 4: Class with enum attribute and non-containment reference, super type NamedElement -->
  <eClassifiers xsi:type="ecore:EClass" name="Leaf" eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="color"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="RED"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.3"/>
  </eClassifiers>
  <!-- 5: Class with attribute typed by custom EDataType -->
  <eClassifiers xsi:type="ecore:EClass" name="Container">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="description"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.1"/>
  </eClassifiers>
</ecore:EPackage>