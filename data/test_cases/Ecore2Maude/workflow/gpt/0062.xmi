<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootMeta"
    nsURI="http://example/rootMeta"
    nsPrefix="root">

  <!-- Classifier 0: EClass RootClass -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <!-- Attribute 0: id (String, isID, default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="idAttr"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="true"
        defaultValueLiteral="defaultId"/>
    <!-- Attribute 1: flag (Boolean with default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flagAttr"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Attribute 2: count (Int, multiplicity *, no default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="countAttr"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference 3: singleRef to ChildClass, not containment, has opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="singleRef"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"/>
    <!-- Reference 4: manyChildren containment to ChildClass, no opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Classifier 1: EClass ChildClass extends RootClass -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute 0: name (String) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="nameAttr"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="childName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Reference 1: backRef to RootClass, opposite of RootClass.singleRef -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"/>
  </eClassifiers>

  <!-- Classifier 2: EEnum Color with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- Classifier 3: EEnum Status with three literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="ACTIVE" value="1" literal="ACTIVE"/>
    <eLiterals name="DONE" value="2" literal="DONE"/>
  </eClassifiers>

  <!-- Classifier 4: EClass EnumHolder with attributes typed by enums -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumHolder" abstract="false" interface="false">
    <!-- Attribute 0: color (typed by ColorEnum, with default literal) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="colorAttr"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="RED"
        eType="//@eClassifiers.2"/>
    <!-- Attribute 1: status (typed by StatusEnum, without default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="statusAttr"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

</ecore:EPackage>