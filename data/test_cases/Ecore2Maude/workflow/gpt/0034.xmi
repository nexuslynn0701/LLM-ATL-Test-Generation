<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="mainpkg"
    nsURI="http://example/mainpkg"
    nsPrefix="mp">

  <!-- Class A: root with one reference and one attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="A">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="aName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        iD="true"
        defaultValueLiteral="defaultAName"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="bRef"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- Class B: supertype of C, has opposite reference back to A -->
  <eClassifiers xsi:type="ecore:EClass" name="B">
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="aOwner"
        eType="//@eClassifiers.0"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- Class C: subclass of B, has one int attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="C" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="cCount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="5"/>
  </eClassifiers>

  <!-- Enum Status with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="ON" value="0" literal="ON"/>
    <eLiterals name="OFF" value="1" literal="OFF"/>
  </eClassifiers>

  <!-- Enum Color with three literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <!-- DataType for custom attribute type -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomString"
      instanceTypeName="java.lang.String"/>

</ecore:EPackage>