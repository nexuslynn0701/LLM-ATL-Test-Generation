<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootMeta"
    nsURI="http://root/meta"
    nsPrefix="rmeta">

  <!-- Classifier 0: Root class with attrs and refs -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <!-- Attribute 0: id, EString, iD=true -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1: flag, EBoolean -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Attribute 2: count, EInt -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="count"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Attribute 3: status, custom EEnum (classifier 3) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.3"/>
    <!-- Attribute 4: level, custom EDataType (classifier 4) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="level"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.4"/>
    <!-- Reference 0: children, to ChildClass (classifier 1), containment true, many -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        eType="//@eClassifiers.1"/>
    <!-- Reference 1: mainChild, to ChildClass (classifier 1), single, non-containment -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="mainChild"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Classifier 1: ChildClass extends RootClass, has attribute and reference back -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute 0: name, EString with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="defaultName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1: priority, EInt -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="priority"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference 0: parent, to RootClass (classifier 0), non-containment, opposite of children -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.5"/>
  </eClassifiers>

  <!-- Classifier 2: Standalone class with its own attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="Standalone" abstract="false" interface="false">
    <!-- Attribute 0: code, EString -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Classifier 3: EEnum StatusKind -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="OLD" value="1" literal="OLD"/>
  </eClassifiers>

  <!-- Classifier 4: custom EDataType -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomLevelType" instanceTypeName="com.example.Level"/>
</ecore:EPackage>