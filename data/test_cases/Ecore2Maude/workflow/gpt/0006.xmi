<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://rootPkgURI"
    nsPrefix="root">
  <!-- Root package with classes, enums, attributes, and references -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass">
    <!-- Attribute: EString, default, non-ID -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="baseName"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="defaultName"
        iD="false">
      <eType xsi:type="ecore:EDataType"
          href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eStructuralFeatures>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="SubClass">
    <!-- Supertype relationship to BaseClass -->
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>

    <!-- Attribute: EInt, explicit bounds, ID attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="idAttr"
        lowerBound="1"
        upperBound="1"
        iD="true">
      <eType xsi:type="ecore:EDataType"
          href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eStructuralFeatures>

    <!-- Attribute: custom EDataType (declared later) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="customData"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.5"/>

    <!-- Containment reference with opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.2"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"/>

    <!-- Non-containment reference without opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="baseRef"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ChildClass">
    <!-- Back-reference opposite of SubClass.children -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="1"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- Enumeration with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>

  <!-- Enumeration with one literal -->
  <eClassifiers xsi:type="ecore:EEnum" name="PriorityEnum">
    <eLiterals name="HIGH" value="0" literal="HIGH"/>
  </eClassifiers>

  <!-- Custom EDataType used by SubClass.customData -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomStringType" instanceClassName="java.lang.String"/>
</ecore:EPackage>