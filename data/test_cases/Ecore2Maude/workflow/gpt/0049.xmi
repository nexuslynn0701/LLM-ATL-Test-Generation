<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="zpmetamodel"
    nsURI="http://zp/mm"
    nsPrefix="zp">
  <!-- Class 0: Root class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <!-- Attribute 0: ID attribute with String type and default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootId"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        defaultValueLiteral="RID-001"
        derived="false"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1: Int attribute with explicit bounds and default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootCount"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        defaultValueLiteral="5"
        derived="false"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Attribute 2: Boolean attribute without default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="activeFlag"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Reference 0: containment to ChildClass -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.1"/>
    <!-- Reference 1: non-containment to AssocClass, with opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="assoc"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.2"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- Class 1: ChildClass extends RootClass and has own attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute 0: String attribute referencing EString -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="childName"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        defaultValueLiteral="defaultChild"
        derived="false"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Class 2: AssocClass with back reference to RootClass -->
  <eClassifiers xsi:type="ecore:EClass" name="AssocClass" abstract="false" interface="false">
    <!-- Reference 0: opposite of RootClass.assoc -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.4"/>
  </eClassifiers>

  <!-- Enum 3: StatusEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="DONE" value="1" literal="DONE"/>
  </eClassifiers>

  <!-- Enum 4: PriorityEnum with one literal -->
  <eClassifiers xsi:type="ecore:EEnum" name="PriorityEnum">
    <eLiterals name="HIGH" value="0" literal="HIGH"/>
  </eClassifiers>

  <!-- DataType 5: Custom data type -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomData" instanceTypeName="java.lang.String"/>

  <!-- Class 6: EnumUser uses enums and custom datatype -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumUser" abstract="false" interface="false">
    <!-- Attribute 0: enum-typed attribute (StatusEnum) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        defaultValueLiteral="NEW"
        derived="false"
        iD="false"
        eType="//@eClassifiers.3"/>
    <!-- Attribute 1: enum-typed attribute (PriorityEnum) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="priority"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        defaultValueLiteral="HIGH"
        derived="false"
        iD="false"
        eType="//@eClassifiers.4"/>
    <!-- Attribute 2: custom datatype attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="customField"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        defaultValueLiteral="CF-VAL"
        derived="false"
        iD="false"
        eType="//@eClassifiers.5"/>
  </eClassifiers>
</ecore:EPackage>