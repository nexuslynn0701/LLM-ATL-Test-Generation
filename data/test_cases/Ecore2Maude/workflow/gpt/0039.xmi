<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="testpkg"
    nsURI="http://test/pkg"
    nsPrefix="tp">
  <!-- Class 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="idAttr"
        iD="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Class 1: extends BaseClass, has attribute and reference with opposite -->
  <eClassifiers xsi:type="ecore:EClass" name="DerivedClass">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="nameAttr"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="defaultName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="toOther"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- Class 2: has containment reference with opposite -->
  <eClassifiers xsi:type="ecore:EClass" name="OtherClass">
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="0"
        upperBound="1"
        containment="true"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Enum 3 -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- Class 4: uses enum attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumUser">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="color"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="RED"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- DataType 5 -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDataType"
        instanceClassName="java.lang.String"/>
</ecore:EPackage>