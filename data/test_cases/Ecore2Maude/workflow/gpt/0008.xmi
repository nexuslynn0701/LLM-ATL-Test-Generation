<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://example/rootpkg"
    nsPrefix="root">
  <!-- Classifiers index map:
       0: RootClass
       1: SubClass
       2: OtherClass
       3: StatusEnum
       4: LevelEnum
       5: helperDataType -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <!-- Attr1: String ID with default and bounds -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="attrId"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="defaultId"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attr2: Boolean attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Attr3: Int attribute with custom bounds -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="count"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="5"
        defaultValueLiteral="3"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Attr4: Enum-typed attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="ACTIVE"
        eType="//@eClassifiers.3"/>
    <!-- Ref1: containment reference to SubClass, with opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="subs"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.0"/>
    <!-- Ref2: non-containment reference to OtherClass -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="otherRef"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="SubClass" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Opposite reference back to RootClass -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.4"/>
    <!-- Attribute with custom data type -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="helper"
        ordered="false"
        unique="false"
        lowerBound="0"
        upperBound="-1"
        defaultValueLiteral="helperDefault"
        eType="//@eClassifiers.5"/>
    <!-- Reference to OtherClass with many upperBound -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="others"
        ordered="false"
        unique="false"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="OtherClass" abstract="true" interface="false">
    <!-- Attribute with LevelEnum -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="level"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="LOW"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- Enum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>

  <!-- Another Enum with three literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="LevelEnum">
    <eLiterals name="LOW" value="0" literal="LOW"/>
    <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
    <eLiterals name="HIGH" value="2" literal="HIGH"/>
  </eClassifiers>

  <!-- Custom EDataType -->
  <eClassifiers xsi:type="ecore:EDataType" name="helperDataType" instanceTypeName="java.lang.String"/>
</ecore:EPackage>