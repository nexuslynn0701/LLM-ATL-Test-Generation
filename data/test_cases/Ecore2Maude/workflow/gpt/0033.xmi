<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="metaRoot"
    nsURI="http://example/metaroot"
    nsPrefix="mroot">
  <!-- Classifier 0: root class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <!-- Attribute 0: string-typed, ID, with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="idAttr"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        iD="true"
        defaultValueLiteral="defaultId"/>
    <!-- Attribute 1: boolean-typed -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flagAttr"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0"
        upperBound="1"/>
    <!-- Reference 2: containment to ChildClass, many, with opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- Classifier 1: child class with super type RootClass and attributes -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" abstract="true" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Reference 0: non-containment back to RootClass (opposite of children) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        eType="//@eClassifiers.0"
        lowerBound="1"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
    <!-- Reference 1: non-containment to LeafClass, many -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="leaves"
        eType="//@eClassifiers.2"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        resolveProxies="true"/>
    <!-- Attribute 2: int-typed, multiplicity 0..* -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="countAttr"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="-1"/>
  </eClassifiers>

  <!-- Classifier 2: leaf class with super type ChildClass -->
  <eClassifiers xsi:type="ecore:EClass" name="LeafClass" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <!-- Attribute 0: enum-typed attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="kind"
        eType="//@eClassifiers.3"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="KIND_A"/>
  </eClassifiers>

  <!-- Classifier 3: enumeration with literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="KindEnum">
    <eLiterals name="KIND_A" value="0" literal="KIND_A"/>
    <eLiterals name="KIND_B" value="1" literal="KIND_B"/>
  </eClassifiers>

  <!-- Classifier 4: another enumeration to increase coverage -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="STATUS_X" value="0" literal="STATUS_X"/>
    <eLiterals name="STATUS_Y" value="1" literal="STATUS_Y"/>
  </eClassifiers>

  <!-- Classifier 5: custom data type -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDataType" instanceClassName="java.lang.String"/>
</ecore:EPackage>