<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="testpkg"
    nsURI="http://testpkg"
    nsPrefix="tp">

  <!-- Class Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <!-- Attribute id : String, iD=true -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        iD="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute age : EInt -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference address : Address (containment, 0..1) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="address"
        lowerBound="0"
        upperBound="1"
        containment="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Class Address -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <!-- Attribute street : String, default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="Main Street"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute number : Int -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="number"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference owner : Person (non-containment, opposite of Person.address, 0..*) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- Enum Gender with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Gender">
    <eLiterals name="MALE" value="0" literal="MALE"/>
    <eLiterals name="FEMALE" value="1" literal="FEMALE"/>
  </eClassifiers>

  <!-- Class Employee using enum Gender and extending Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee">
    <!-- Supertype Person -->
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <!-- Attribute gender : Gender -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="gender"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

</ecore:EPackage>