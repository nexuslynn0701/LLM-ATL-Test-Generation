<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="myRootPkg"
    nsURI="http://myRootPkgURI"
    nsPrefix="myRoot">

  <!-- Class 0: root class with attributes and a reference -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass">
    <!-- Attribute 0: ID attribute, typed with EString -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="idAttr"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1: non-ID attribute, typed with EInt, with default value -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="countAttr"
        lowerBound="0"
        upperBound="-1"
        defaultValueLiteral="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference 2: containment ref to ChildClass, no opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Class 1: child class, subclass of RootClass, with attributes and a reference -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass"
      abstract="true"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute 0: boolean attribute with default value -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flagAttr"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Attribute 1: string attribute with quoted default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="nameAttr"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="defaultName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Reference 2: non-containment ref to RootClass with opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="1"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- Enum 2: simple enumeration with literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <!-- Class 3: enum holder, attribute typed with ColorEnum -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumHolder">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="colorAttr"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="RED"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

</ecore:EPackage>