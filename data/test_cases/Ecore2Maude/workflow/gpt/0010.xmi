<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://rootpkg"
    nsPrefix="root">

  <!-- Root-level class: super type -->
  <eClassifiers xsi:type="ecore:EClass" name="SuperClass" abstract="true">
    <!-- One attribute with String type -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="superName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        iD="false"/>
  </eClassifiers>

  <!-- Root-level class: has ref and attr, and extends SuperClass -->
  <eClassifiers xsi:type="ecore:EClass" name="MainClass">
    <!-- super type: SuperClass (index 0) -->
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>

    <!-- Containment reference to ChildClass (index 2), with opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        eType="//@eClassifiers.2"
        containment="true"
        lowerBound="0"
        upperBound="-1"
        resolveProxies="true"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"/>

    <!-- Simple attribute with Int type -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="mainCount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"
        upperBound="1"
        iD="false"/>
  </eClassifiers>

  <!-- Root-level class: child, references back to MainClass -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass">
    <!-- Non-containment opposite reference back to MainClass -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        eType="//@eClassifiers.1"
        containment="false"
        lowerBound="0"
        upperBound="1"
        resolveProxies="true"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- Root-level enumeration with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="BLUE" value="1" literal="BLUE"/>
  </eClassifiers>

  <!-- Root-level enumeration with one literal -->
  <eClassifiers xsi:type="ecore:EEnum" name="SizeEnum">
    <eLiterals name="SMALL" value="0" literal="SMALL"/>
  </eClassifiers>

</ecore:EPackage>