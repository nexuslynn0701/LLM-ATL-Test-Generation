<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="testpkg"
    nsURI="http://testpkg"
    nsPrefix="tp">

  <!-- Root EClass with one EAttribute and one EReference -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <!-- Attribute with explicit primitive EString type, non-default bounds -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"
        lowerBound="1"
        upperBound="3"
        ordered="true"
        unique="true"/>
    <!-- Containment reference to ChildClass, opposite set on ChildClass.back -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        eType="//@eClassifiers.1"
        containment="true"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        resolveProxies="true"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- Child EClass extending RootClass, with attribute and back reference -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute with integer type, lowerBound 0, non-default upperBound -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="childAge"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="5"
        ordered="true"
        unique="true"/>
    <!-- Non-containment reference back to RootClass, opposite of RootClass.children -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        eType="//@eClassifiers.0"
        containment="false"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        resolveProxies="true"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- Enumeration with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- EClass using the enumeration and a string attribute with default value -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumUser" abstract="false" interface="false">
    <!-- Attribute typed with ColorEnum -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="favoriteColor"
        eType="//@eClassifiers.2"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="RED"/>
    <!-- String attribute with specific default value to trigger AttEqSpecificDefaultValue -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="defaultLabel"/>
  </eClassifiers>

  <!-- Simple EDataType to ensure presence of non-primitive data type -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDataType"/>

</ecore:EPackage>