<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://example/root"
    nsPrefix="root">

  <!-- Root package classifiers -->

  <!-- 0: EClass BaseClass -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass">
    <!-- Attribute with EString type, non-ID -->
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="baseName"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="defaultBase"
        iD="false"/>
  </eClassifiers>

  <!-- 1: EClass SubClass extends BaseClass, has ref and attr -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass">
    <!-- Super type BaseClass -->
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>

    <!-- Containment reference to BaseClass with opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.0"
        containment="true">
      <!-- opposite will be set on BaseClass reference defined later -->
    </eStructuralFeatures>

    <!-- Attribute with EInt type and default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="subCount"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="5"
        iD="false"/>
  </eClassifiers>

  <!-- 2: EClass OtherClass with opposite reference back to SubClass -->
  <eClassifiers xsi:type="ecore:EClass" name="OtherClass" abstract="true">
    <!-- Reference to SubClass, non-containment, opposite of children -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.1"
        containment="false"/>
  </eClassifiers>

  <!-- 3: EEnum ColorEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="BLUE" value="1" literal="BLUE"/>
  </eClassifiers>

  <!-- 4: EClass EnumUser uses ColorEnum as attribute type -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumUser">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="favoriteColor"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- 5: EDataType CustomDataType -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDataType" instanceTypeName="java.lang.String"/>

  <!-- 6: EClass DataUser uses CustomDataType -->
  <eClassifiers xsi:type="ecore:EClass" name="DataUser">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="customField"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 7: EEnum StatusEnum with one literal -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="OK" value="0" literal="OK"/>
  </eClassifiers>

  <!-- 8: EClass StatusUser uses StatusEnum and has ID attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="StatusUser">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="statusId"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.7"
        defaultValueLiteral="OK"/>
  </eClassifiers>

  <!-- 9: EClass RefContainer with non-containment reference and bounds -->
  <eClassifiers xsi:type="ecore:EClass" name="RefContainer">
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="subRef"
        lowerBound="1"
        upperBound="3"
        eType="//@eClassifiers.1"
        containment="false"/>
  </eClassifiers>

  <!-- 10: EClass MultiAttr with various bounds -->
  <eClassifiers xsi:type="ecore:EClass" name="MultiAttr">
    <!-- attribute with many upperBound -1 -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="names"
        lowerBound="0"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- attribute with Boolean type -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

</ecore:EPackage>