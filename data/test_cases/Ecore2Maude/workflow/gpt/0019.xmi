<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="testpkg"
    nsURI="http://test/pkg"
    nsPrefix="test">
  <!-- Class Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false">
    <!-- Attribute id : EString, is ID, lower=1, upper=1 -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute age : EInt, lower=0, upper=1 with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="18"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference bestFriend : Person, optional, non containment, opposite friendOf -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="bestFriend"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"/>
    <!-- Reference friendOf : Person, many, containment -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="friendOf"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- Class Employee extends Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute salary : EInt, upperBound = -1 (*), no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="salary"
        lowerBound="0"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference manager : Employee, single, non containment, no opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="manager"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Enum Role -->
  <eClassifiers xsi:type="ecore:EEnum" name="Role">
    <eLiterals name="ADMIN" value="0" literal="ADMIN"/>
    <eLiterals name="USER" value="1" literal="USER"/>
  </eClassifiers>

  <!-- Attribute-only wrapper class Account using Role -->
  <eClassifiers xsi:type="ecore:EClass" name="Account" abstract="false" interface="false">
    <!-- Attribute username : EString, with default containing quotes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="username"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="&quot;guest&quot;"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute role : Role enum -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="role"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- DataType CustomData -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomData" instanceClassName="java.lang.String"/>

  <!-- Class Holder with attribute of CustomData -->
  <eClassifiers xsi:type="ecore:EClass" name="Holder" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="data"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="defaultData"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- Another root EClass without features -->
  <eClassifiers xsi:type="ecore:EClass" name="EmptyClass" abstract="true" interface="false"/>
</ecore:EPackage>