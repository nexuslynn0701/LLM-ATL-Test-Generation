<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://rootpkgURI"
    nsPrefix="root">
  <!-- Class A with one EAttribute (EString) and one EReference to ClassB -->
  <eClassifiers xsi:type="ecore:EClass" name="ClassA" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="attrA"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        iD="true"
        defaultValueLiteral="defaultA"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="refToB"
        eType="//@eClassifiers.1"
        lowerBound="1"
        upperBound="-1"
        containment="true"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- Class B with super type ClassA, one EAttribute (EInt) and one opposite reference to ClassA -->
  <eClassifiers xsi:type="ecore:EClass" name="ClassB" abstract="true" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="attrB"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"
        upperBound="5"
        iD="false"
        defaultValueLiteral="7"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="backToA"
        eType="//@eClassifiers.0"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- Enumeration with two literals -->
  <eClassifiers xsi:type="ecore:EClass" xsi:nil="true"/>
  <eClassifiers xsi:type="ecore:EClass" xsi:nil="true"/>
  <eClassifiers xsi:type="ecore:EClass" xsi:nil="true"/>

  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>

  <!-- EDataType used for a non-primitive attribute -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDT" instanceTypeName="java.lang.Object"/>

  <!-- Class C with attribute of CustomDT, and EAttribute with enum type and defaultValueLiteral -->
  <eClassifiers xsi:type="ecore:EClass" name="ClassC" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="customAttr"
        eType="//@eClassifiers.5"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="custDef"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        eType="//@eClassifiers.4"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="ACTIVE"/>
  </eClassifiers>

  <!-- Simple subclass of ClassC to trigger additional supertype handling -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClassC" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.6">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="subAttr"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="true"/>
  </eClassifiers>
</ecore:EPackage>