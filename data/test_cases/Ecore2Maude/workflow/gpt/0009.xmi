<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://rootpkgURI"
    nsPrefix="root">
  <!-- Class 0: simple class with one EString attribute and one reference to Class2 -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="bestFriend"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"
        containment="false"/>
  </eClassifiers>

  <!-- Class 1: subclass of Class0, has ID attribute and reference to Class2 (containment) -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee"
      abstract="false">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="empId"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="manager"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"
        containment="true"/>
  </eClassifiers>

  <!-- Class 2: target of references, with a Boolean attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- Enum 3: with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Rank">
    <eLiterals name="JUNIOR" value="0" literal="JUNIOR"/>
    <eLiterals name="SENIOR" value="1" literal="SENIOR"/>
  </eClassifiers>

  <!-- DataType 4: custom data type -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomData" instanceTypeName="java.lang.String"/>
</ecore:EPackage>