<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://rootpkgURI"
    nsPrefix="root">
  <!-- EClass 0: root-level class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <!-- Attribute 0 of RootClass -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootName"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="defaultRootName"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1 of RootClass -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootFlag"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="true"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Reference 2 of RootClass to ChildClass -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- EClass 1: child class with super type RootClass, attributes and a reference -->
  <eClassifiers xsi:type="ecore:EClass"
      name="ChildClass"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute 0 of ChildClass -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="childCode"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="5"
        defaultValueLiteral="CC01"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1 of ChildClass -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="childCount"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="7"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference 2 of ChildClass to RootClass (non-containment) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- EEnum 2 with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>

  <!-- EEnum 3 with one literal -->
  <eClassifiers xsi:type="ecore:EEnum" name="PriorityEnum">
    <eLiterals name="HIGH" value="0" literal="HIGH"/>
  </eClassifiers>

  <!-- EDataType 4: custom data type (unused but present) -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomData"/>

  <!-- EClass 5: another class using enums and custom datatype -->
  <eClassifiers xsi:type="eccore:EClass" name="MetaClass" abstract="true">
    <!-- Attribute 0: enum-typed attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="ACTIVE"
        iD="false"
        eType="//@eClassifiers.2"/>
    <!-- Attribute 1: custom datatype attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="metaValue"
        ordered="false"
        unique="false"
        lowerBound="0"
        upperBound="-1"
        defaultValueLiteral=""
        iD="false"
        eType="//@eClassifiers.4"/>
  </eClassifiers>
</ecore:EPackage>