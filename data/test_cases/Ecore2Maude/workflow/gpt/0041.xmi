<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://rootpkg/example"
    nsPrefix="rootpkg">

  <!-- EClass 0: root class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <!-- Attribute 0: EString, iD=true, lowerBound/upperBound -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="idAttr"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1: EInt, default value, non-ID -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="countAttr"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="5"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference 2: to ChildClass, containment, opposite set later -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- EClass 1: child class with supertype RootClass -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" abstract="false" interface="false" eSuperTypes="//@eClassifiers.0">
    <!-- Reference 0: back-reference to RootClass, non-containment, opposite of RootClass.children -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="1"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
    <!-- Attribute 1: enum-typed -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="ACTIVE"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- EEnum 2 with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>

  <!-- EEnum 3 with one literal -->
  <eClassifiers xsi:type="ecore:EEnum" name="ModeEnum">
    <eLiterals name="DEFAULT" value="0" literal="DEFAULT"/>
  </eClassifiers>

  <!-- EDataType 4: custom data type -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDataType" instanceTypeName="java.lang.String"/>

</ecore:EPackage>