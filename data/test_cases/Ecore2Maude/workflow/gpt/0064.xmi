<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootMeta"
    nsURI="http://rootMetaURI"
    nsPrefix="rm">

  <!-- Class 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass">
    <!-- Attribute 0 of Class 0 -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootId"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1 of Class 0 -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootCount"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference 2 of Class 0 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="child"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Class 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass">
    <!-- Attribute 0 of Class 1 -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="childName"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="defaultChild"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1 of Class 1 -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Reference 2 of Class 1 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- Enum 2 -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <!-- Class 3 with enum-typed attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="Palette">
    <!-- Attribute 0 of Class 3 -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="mainColor"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="RED"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

</ecore:EPackage>