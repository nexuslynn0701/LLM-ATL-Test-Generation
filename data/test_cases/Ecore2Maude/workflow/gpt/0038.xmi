<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://root/pkg"
    nsPrefix="rp">

  <!-- Classifier 0: Root class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass">
    <!-- Attribute 0 of RootClass -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootName"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="true"
        defaultValueLiteral="defaultRoot"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1 of RootClass, Int-typed, with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootCount"
        lowerBound="1"
        upperBound="1"
        ordered="false"
        unique="true"
        defaultValueLiteral="5"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference 0 of RootClass to ChildClass, containment -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Classifier 1: Child class extending RootClass, with attributes & reference -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- String attribute with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="childLabel"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="false"
        defaultValueLiteral="childDefault"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Boolean attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Reference back to RootClass, non-containment, opposite of RootClass.children -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="1"
        upperBound="1"
        ordered="false"
        unique="true"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- Classifier 2: An enumeration with literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <!-- Classifier 3: Another class using the enum and primitive types -->
  <eClassifiers xsi:type="ecore:EClass" name="ShapeClass">
    <!-- Enum-typed attribute with default literal -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="color"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="RED"
        eType="//@eClassifiers.2"/>
    <!-- Float-typed attribute with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="size"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="1.5"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <!-- Reference from ShapeClass to ChildClass (non-containment, no opposite) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="ownerChild"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

</ecore:EPackage>