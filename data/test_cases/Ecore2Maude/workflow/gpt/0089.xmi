<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://rootpkgURI"
    nsPrefix="root">
  <!-- EClass 0: a root class with both attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false">
    <!-- Attribute 0 of Person: String-typed, with default value, is ID -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="John &quot;Doe&quot;"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1 of Person: Boolean-typed, with default value -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- EClass 1: has a reference to Person and one attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="Company" abstract="false" interface="false">
    <!-- Reference 0 of Company: many-valued containment to Person, no opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employees"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        eType="//@eClassifiers.0"/>
    <!-- Attribute 0 of Company: Int-typed, with default value -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="foundedYear"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="1999"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- EClass 2: subtype of Person, with an EEnum-typed attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="false" interface="false" eSuperTypes="//@eClassifiers.0">
    <!-- Attribute 0 of Employee: Enum-typed, with default literal -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="role"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="MANAGER"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- EEnum 3: used by Employee.role -->
  <eClassifiers xsi:type="ecore:EEnum" name="Role">
    <eLiterals name="EMPLOYEE" value="0" literal="EMPLOYEE"/>
    <eLiterals name="MANAGER" value="1" literal="MANAGER"/>
  </eClassifiers>

  <!-- EEnum 4: an extra enum to trigger additional enum-related rules -->
  <eClassifiers xsi:type="ecore:EEnum" name="DepartmentKind">
    <eLiterals name="HR" value="0" literal="HR"/>
    <eLiterals name="IT" value="1" literal="IT"/>
    <eLiterals name="FINANCE" value="2" literal="FINANCE"/>
  </eClassifiers>
</ecore:EPackage>