<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://example/root"
    nsPrefix="root">
  <!-- Class 0: base class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="baseName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        iD="true"
        defaultValueLiteral="defaultBaseName"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        eType="//@eClassifiers.1"
        containment="true"
        lowerBound="0"
        upperBound="-1"/>
  </eClassifiers>

  <!-- Class 1: subclass of BaseClass, with EInt attribute and reference back (opposite) -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="count"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"
        upperBound="5"
        defaultValueLiteral="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"
        containment="false"
        lowerBound="0"
        upperBound="1"/>
  </eClassifiers>

  <!-- Class 2: standalone class with mixed attributes and a reference to EnumClass -->
  <eClassifiers xsi:type="ecore:EClass" name="AuxClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="AX-001"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="ratio"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="3.14"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="enumHolder"
        eType="//@eClassifiers.3"
        containment="false"
        lowerBound="0"
        upperBound="1"/>
  </eClassifiers>

  <!-- Class 3: class that uses the enum via attribute type -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="state"
        eType="//@eClassifiers.4"
        lowerBound="1"
        upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="-1"/>
  </eClassifiers>

  <!-- Enum 4 with literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>

  <!-- Additional enum 5 to exercise multiple enums -->
  <eClassifiers xsi:type="ecore:EEnum" name="PriorityLevel">
    <eLiterals name="LOW" value="0" literal="LOW"/>
    <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
    <eLiterals name="HIGH" value="2" literal="HIGH"/>
  </eClassifiers>

  <!-- Custom EDataType 6 -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="CustomString"
      instanceTypeName="java.lang.String"/>

  <!-- Class 7: uses CustomString data type and has multi-valued attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="CustomHolder">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="customValues"
        eType="//@eClassifiers.6"
        lowerBound="0"
        upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="linkToBase"
        eType="//@eClassifiers.0"
        containment="false"
        lowerBound="0"
        upperBound="-1"/>
  </eClassifiers>
</ecore:EPackage>