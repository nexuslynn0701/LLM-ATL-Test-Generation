<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://rootpkg"
    nsPrefix="root">

  <!-- Class 0: base class -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="baseName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        iD="true"
        defaultValueLiteral="defaultBaseName"/>
  </eClassifiers>

  <!-- Class 1: concrete subclass of BaseClass, with attributes and a reference -->
  <eClassifiers xsi:type="ecore:EClass" name="ConcreteBase"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="concreteName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="NamedEntity"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute with String type and default value -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="unnamed"/>
    <!-- Attribute with Int type and no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="priority"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="1"/>
    <!-- Reference to BaseClass, non-containment, single-valued -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="base"
        eType="//@eClassifiers.0"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- Class 2: container class with containment reference and opposite -->
  <eClassifiers xsi:type="ecore:EClass" name="Container">
    <!-- Containment reference to NamedEntity, multiplicity 0..* -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="elements"
        eType="//@eClassifiers.2"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="false"/>
  </eClassifiers>

  <!-- Enum 3: simple enumeration with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="DONE" value="1" literal="DONE"/>
  </eClassifiers>

  <!-- Attribute 0 in NamedEntity using enum Status as type -->
  <!-- We model it as an extra structural feature to exercise enum-typed attributes -->
  <eClassifiers xsi:type="ecore:EClass" name="Task">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        eType="//@eClassifiers.4"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="NEW"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="container"
        eType="//@eClassifiers.2"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- Link opposites between Container.elements and Task.container -->
  <!-- This is done by re-specifying the references with eOpposite -->
  <eClassifiers xsi:type="ecore:EClass" name="ContainerWithOpposite">
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="tasks"
        eType="//@eClassifiers.5"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="false"
        eOpposite="//@eClassifiers.5/@eStructuralFeatures.1"/>
  </eClassifiers>

</ecore:EPackage>