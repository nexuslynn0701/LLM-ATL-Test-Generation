<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="urn:rootpkg"
    nsPrefix="root">
  <!-- EClass 0: Base class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass" abstract="false" interface="false">
    <!-- Attribute 0: String, ID, with default value -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="idAttr"
        lowerBound="1" upperBound="1"
        ordered="true" unique="true"
        defaultValueLiteral="defaultId"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1: Int, non-ID, no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="count"
        lowerBound="0" upperBound="1"
        ordered="true" unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Attribute 2: Enum-typed -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        lowerBound="0" upperBound="1"
        ordered="true" unique="true"
        eType="//@eClassifiers.3"/>
    <!-- Reference 3: to DerivedClass, containment, single-valued -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="child"
        lowerBound="0" upperBound="1"
        ordered="true" unique="true"
        containment="true"
        eType="//@eClassifiers.1"/>
    <!-- Reference 4: to BaseClass, non-containment, multi-valued -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="others"
        lowerBound="0" upperBound="-1"
        ordered="true" unique="true"
        containment="false"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- EClass 1: Derived class with supertype BaseClass, its own attributes/ref -->
  <eClassifiers xsi:type="ecore:EClass" name="DerivedClass" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute 0: Boolean -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag"
        lowerBound="0" upperBound="1"
        ordered="true" unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Attribute 1: String with quotes in default (exercise escapeQuotes) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        lowerBound="0" upperBound="1"
        ordered="false" unique="false"
        defaultValueLiteral="&quot;quoted&quot;"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Reference 2: non-containment, opposite set later -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent"
        lowerBound="1" upperBound="1"
        ordered="true" unique="true"
        containment="false"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- EClass 2: Class with no features to still trigger Class2Sort -->
  <eClassifiers xsi:type="ecore:EClass" name="EmptyClass" abstract="false" interface="false"/>

  <!-- EEnum 3: with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>

  <!-- EEnum 4: second enum to exercise multiple enums -->
  <eClassifiers xsi:type="ecore:EEnum" name="ModeEnum">
    <eLiterals name="AUTO" value="0" literal="AUTO"/>
    <eLiterals name="MANUAL" value="1" literal="MANUAL"/>
  </eClassifiers>
</ecore:EPackage>