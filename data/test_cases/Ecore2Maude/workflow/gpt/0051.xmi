<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://rootpkg"
    nsPrefix="root">
  <!-- Class 0: Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false">
    <!-- Attribute 0: id (String, is ID, with default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="true"
        defaultValueLiteral="PID-0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1: age (Int, with default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="21"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Attribute 2: status (EEnum EmploymentStatus) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.3"/>
    <!-- Reference 3: address (to Address, containment, single) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="address"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="true"
        eType="//@eClassifiers.1"/>
    <!-- Reference 4: friends (to Person, many, non-containment, ordered, unique) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="friends"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="false"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- Class 1: Address -->
  <eClassifiers xsi:type="ecore:EClass" name="Address" abstract="false" interface="false">
    <!-- Attribute 0: city (String, default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="city"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="UnknownCity"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1: street (String, no default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Reference 2: residents (to Person, opposite of Person.address, non-containment, many) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="residents"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"/>
  </eClassifiers>

  <!-- Class 2: Employee extends Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute 0: salary (Int, many, default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="salary"
        lowerBound="0"
        upperBound="-1"
        ordered="false"
        unique="false"
        defaultValueLiteral="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference 1: manager (to Employee, single, non-containment) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="manager"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- Enum 3: EmploymentStatus with 2 literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="EmploymentStatus">
    <eLiterals name="FULL_TIME" value="0" literal="FULL_TIME"/>
    <eLiterals name="PART_TIME" value="1" literal="PART_TIME"/>
  </eClassifiers>

  <!-- DataType 4: CustomString -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="CustomString"
      instanceClassName="java.lang.String"/>
</ecore:EPackage>