<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="testpkg"
    nsURI="http://example.org/testpkg"
    nsPrefix="tp">

  <!-- ClassA: root class with one attribute and one reference (with opposite) -->
  <eClassifiers xsi:type="ecore:EClass" name="ClassA">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="attrA"
        lowerBound="0"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="refB"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- ClassB: subclass of ClassA, references back to A via opposite, has attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="ClassB" abstract="true">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="ownerA"
        lowerBound="1"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flagB"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- ClassC: second subclass of ClassA, has attribute with default and int bounds -->
  <eClassifiers xsi:type="ecore:EClass" name="ClassC">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="countC"
        lowerBound="1"
        upperBound="5"
        defaultValueLiteral="3"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- An EEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="MyEnum">
    <eLiterals name="LIT1" value="0" literal="LIT1"/>
    <eLiterals name="LIT2" value="1" literal="LIT2"/>
  </eClassifiers>

  <!-- Another EEnum with one literal -->
  <eClassifiers xsi:type="ecore:EEnum" name="OtherEnum">
    <eLiterals name="OE1" value="0" literal="OE1"/>
  </eClassifiers>

</ecore:EPackage>