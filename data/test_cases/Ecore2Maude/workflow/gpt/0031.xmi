<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://rootpkgURI"
    nsPrefix="root">
  <!-- Classifiers index map:
       0: rootClass
       1: refClass
       2: attrClass
       3: myEnum
  -->
  <eClassifiers xsi:type="ecore:EClass" name="rootClass">
    <!-- One attribute to trigger Attribute2Operation and related equations -->
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        xmlns:eccore="http://ecore"
        name="idAttr"
        lowerBound="0"
        upperBound="1"
        iD="true"
        defaultValueLiteral="defaultId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- One reference to trigger Reference2Operation and related equations -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="childRef"
        lowerBound="1"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="refClass">
    <!-- Back reference with opposite to exercise maudeMaybeRefSort and RefEqOpposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parentRef"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="attrClass">
    <!-- Attribute with integer type and specific default to exercise attDataType and AttEqSpecificDefaultValue -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="countAttr"
        lowerBound="0"
        upperBound="5"
        defaultValueLiteral="3"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="myEnum">
    <eLiterals name="LIT_ONE" value="0" literal="LIT_ONE"/>
    <eLiterals name="LIT_TWO" value="1" literal="LIT_TWO"/>
  </eClassifiers>
</ecore:EPackage>