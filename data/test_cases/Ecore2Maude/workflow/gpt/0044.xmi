<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="testpkg"
    nsURI="http://test/pkg"
    nsPrefix="tp">

  <!-- Class Person with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <!-- String attribute with default, ID, non-mandatory -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="unknown"
        iD="true"/>
    <!-- Int attribute without default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="1"/>
    <!-- Boolean attribute with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="true"/>
    <!-- Reference to Address (non-containment, 0..*) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="addresses"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="-1"
        containment="false"/>
  </eClassifiers>

  <!-- Class Address with containment reference back to Person (1..1) -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <!-- String attribute street -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"/>
    <!-- Reference back to Person as container (containment true on Person side only) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        eType="//@eClassifiers.0"
        lowerBound="1"
        upperBound="1"
        containment="false"/>
  </eClassifiers>

  <!-- Enum Gender with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Gender">
    <eLiterals name="Male" value="0" literal="Male"/>
    <eLiterals name="Female" value="1" literal="Female"/>
  </eClassifiers>

  <!-- Enum Status with literals and used as attribute type -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="Single" value="0" literal="Single"/>
    <eLiterals name="Married" value="1" literal="Married"/>
  </eClassifiers>

  <!-- Class Employee extending Person, with enum attribute and reference -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Enum attribute of type Gender -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="gender"
        eType="//@eClassifiers.2"
        lowerBound="0"
        upperBound="1"/>
    <!-- Enum attribute of type Status with default literal -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        eType="//@eClassifiers.3"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="Single"/>
    <!-- Self reference manager (0..1) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="manager"
        eType="//@eClassifiers.4"
        lowerBound="0"
        upperBound="1"
        containment="false"/>
  </eClassifiers>

</ecore:EPackage>