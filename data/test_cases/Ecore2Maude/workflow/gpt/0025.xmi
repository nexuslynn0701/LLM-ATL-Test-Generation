<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="testpkg"
    nsURI="http://testpkg"
    nsPrefix="tp">

  <!-- Class 0: BaseClass -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass">
    <!-- Attribute 0 of BaseClass: baseId (EString, ID, lower=1, upper=1, default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="baseId"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="true"
        defaultValueLiteral="idDefault"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1 of BaseClass: flag (EBoolean, lower=0, upper=1, default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- Class 1: SubClass extends BaseClass -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass">
    <!-- Super type: BaseClass -->
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>

    <!-- Reference 0 of SubClass: base (to BaseClass, non-containment, lower=0, upper=-1, opposite backRef) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="base"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"/>

    <!-- Attribute 0 of SubClass: count (EInt, lower=0, upper=-1, default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="count"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        defaultValueLiteral="5"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- Class 2: OtherClass -->
  <eClassifiers xsi:type="ecore:EClass" name="OtherClass">
    <!-- Reference 0 of OtherClass: owner (to SubClass, containment=true, opposite base) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="true"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.0"/>

    <!-- Attribute 0 of OtherClass: title (EString, default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="titleDefault"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Enum 3: StatusEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>

  <!-- Enum 4: LevelEnum with three literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="LevelEnum">
    <eLiterals name="LOW" value="0" literal="LOW"/>
    <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
    <eLiterals name="HIGH" value="2" literal="HIGH"/>
  </eClassifiers>

  <!-- DataType 5: CustomString -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomString"
      instanceTypeName="java.lang.String"/>

  <!-- Class 6: EnumUser uses enums and custom datatype -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumUser">
    <!-- Attribute 0: statusAttr typed by StatusEnum, with default literal ACTIVE -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="statusAttr"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="ACTIVE"
        eType="//@eClassifiers.3"/>
    <!-- Attribute 1: levelAttr typed by LevelEnum, default MEDIUM -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="levelAttr"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="MEDIUM"
        eType="//@eClassifiers.4"/>
    <!-- Attribute 2: customText typed by CustomString, default with quotes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="customText"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="quoted &quot;text&quot;"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

</ecore:EPackage>