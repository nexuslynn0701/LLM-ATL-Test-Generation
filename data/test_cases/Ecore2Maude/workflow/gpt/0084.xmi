<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://rootPkgURI"
    nsPrefix="root">
  <!-- Class 0: base class with one attribute and one reference -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="0"
        upperBound="1"
        iD="true"
        defaultValueLiteral="DEF"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="next"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Class 1: subclass of BaseClass, with an attribute using EString -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass"
      abstract="false">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="description"
        lowerBound="1"
        upperBound="-1"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Enum 2: Status with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="DONE" value="1" literal="DONE"/>
  </eClassifiers>

  <!-- Class 3: uses enum Status as attribute type, has reference with multiplicity * -->
  <eClassifiers xsi:type="ecore:EClass" name="Task">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="state"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="NEW"
        eAttributeType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="related"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- Another enum 4: Priority with one literal -->
  <eClassifiers xsi:type="ecore:EEnum" name="Priority">
    <eLiterals name="HIGH" value="0" literal="HIGH"/>
  </eClassifiers>

  <!-- Class 5: uses Priority and primitive int -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="priority"
        lowerBound="0"
        upperBound="1"
        eAttributeType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="effort"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="0"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="tasks"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.3"/>
  </eClassifiers>
</ecore:EPackage>