<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://example/root"
    nsPrefix="root">
  <!-- Class 0: Base class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass" abstract="false" interface="false">
    <!-- Attribute 0: string-typed, ID, ordered/unique default (true/true), with default value -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="idAttr"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="defaultId"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1: int-typed, non-unique, non-ordered, with default value -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="countAttr"
        ordered="false"
        unique="false"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="7"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Attribute 2: enum-typed, with default literal -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="statusAttr"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="ACTIVE"
        eType="//@eClassifiers.4"/>
    <!-- Reference 0: containment reference to SubClass, multiplicity 0..-1, no opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
    <!-- Reference 1: non-containment, with opposite, multiplicity 0..1 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="partner"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- Class 1: SubClass extending BaseClass, with own attribute and opposite reference -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute 0: boolean-typed, non-ordered, unique -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flagAttr"
        ordered="false"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Reference 1: opposite of BaseClass.partner -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.4"/>
  </eClassifiers>

  <!-- Class 2: ExtraClass extending SubClass, no own features (to exercise superTypes lists) -->
  <eClassifiers xsi:type="ecore:EClass" name="ExtraClass" abstract="true" interface="false"
      eSuperTypes="//@eClassifiers.1"/>

  <!-- Data type 3: custom data type (unused, but present as classifier) -->
  <eClassifiers xsi:type="eccore:EDataType" name="CustomData"/>

  <!-- Enum 4: StatusEnum with three literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
    <eLiterals name="PENDING" value="2" literal="PENDING"/>
  </eClassifiers>

  <!-- Enum 5: ModeEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="ModeEnum">
    <eLiterals name="AUTO" value="0" literal="AUTO"/>
    <eLiterals name="MANUAL" value="1" literal="MANUAL"/>
  </eClassifiers>
</ecore:EPackage>