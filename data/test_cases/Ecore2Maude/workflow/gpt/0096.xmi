<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://rootpkg"
    nsPrefix="root">

  <!-- Classifier 0: EClass with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <!-- Attribute 0: name : EString, lower=1, upper=1, ID=false -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1: age : EInt, lower=0, upper=1, ID=false -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference 2: friends : Person[*], bidirectional with ownedBy -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="friends"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"/>
    <!-- Reference 3: ownedBy : Person[1], opposite of friends -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="ownedBy"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- Classifier 1: EClass with supertype Person and attribute of enum type -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute 0: status : EmploymentStatus, default literal ACTIVE -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="ACTIVE"
        iD="false"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- Classifier 2: EEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="EmploymentStatus">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>

</ecore:EPackage>