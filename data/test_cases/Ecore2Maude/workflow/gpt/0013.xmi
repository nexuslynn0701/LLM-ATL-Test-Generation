<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://example/rootpkg"
    nsPrefix="root">

  <!-- EClass 0: RootClass with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <!-- Attribute 0: idAttr, EString, is ID, with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="idAttr"
        iD="true"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="defaultId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1: flagAttr, EBoolean, non-ID, no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flagAttr"
        iD="false"
        lowerBound="0"
        upperBound="1"
        ordered="false"
        unique="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Reference 2: child, containment to ChildClass -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="child"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.1"/>
    <!-- Reference 3: refToEnumHolder, non-containment to EnumHolder -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="refToEnumHolder"
        lowerBound="0"
        upperBound="1"
        containment="false"
        ordered="false"
        unique="true"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- EClass 1: ChildClass with EInt attribute and opposite ref -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" abstract="false" interface="false">
    <!-- Attribute 0: count, EInt -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="count"
        iD="false"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference 1: parent, opposite of RootClass.child -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="1"
        upperBound="1"
        containment="false"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- EClass 2: EnumHolder with attribute typed by local EEnum -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumHolder" abstract="false" interface="false">
    <!-- Attribute 0: kind, typed by LocalEnum -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="kind"
        iD="false"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- EEnum 3: LocalEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="LocalEnum">
    <eLiterals name="FIRST" value="0" literal="FIRST"/>
    <eLiterals name="SECOND" value="1" literal="SECOND"/>
  </eClassifiers>

  <!-- EDataType 4: CustomDataType -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDataType" instanceClassName="java.lang.String"/>

</ecore:EPackage>