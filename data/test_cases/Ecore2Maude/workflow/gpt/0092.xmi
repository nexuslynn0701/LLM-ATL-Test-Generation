<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://example/root"
    nsPrefix="root">

  <!-- Classifier 0: Root-level class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false">
    <!-- Attribute 0 of Person: has default value, is ID, String type -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="Unnamed Person"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1 of Person: no default, Int type, upperBound -1 to trigger '*' -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference 2 of Person: containment, many, opposite defined in Class Address -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="addresses"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Classifier 1: Address, with opposite reference back to Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Address" abstract="false" interface="false">
    <!-- Opposite of Person.addresses -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        containment="false"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- Classifier 2: Abstract base class with no features, for supertype list use -->
  <eClassifiers xsi:type="ecore:EClass" name="NamedElement" abstract="true" interface="false"/>

  <!-- Classifier 3: Enumeration with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- Classifier 4: DataType solely to be used as an EAttribute type by another package -->
  <eClassifiers xsi:type="ecore:EDataType" name="ExternalString" instanceTypeName="java.lang.String"/>

</ecore:EPackage>