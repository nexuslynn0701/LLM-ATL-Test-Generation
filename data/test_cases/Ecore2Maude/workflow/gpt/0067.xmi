<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="urn:rootPkg"
    nsPrefix="rp">

  <!-- Classifier 0: root-level EClass with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="FirstClass" abstract="false" interface="false">
    <!-- Attribute 0 on FirstClass: String-typed, with default, is ID -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="nameAttr"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        changeable="true"
        volatile="false"
        transient="false"
        defaultValueLiteral="defaultName"
        unsettable="false"
        derived="false"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1 on FirstClass: Integer-typed, no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="countAttr"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference 0 on FirstClass: to SecondClass, containment, 0..* -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.1"/>
    <!-- Reference 1 on FirstClass: bidirectional to ThirdClass, non-containment, 1..1 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="thirdRef"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.2"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- Classifier 1: SecondClass, subclass of FirstClass, with its own ref and attr -->
  <eClassifiers xsi:type="ecore:EClass" name="SecondClass" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Reference 0: to FirstClass, non-containment, 0..1 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"/>
    <!-- Attribute 0 on SecondClass: Boolean-typed -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flagAttr"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- Classifier 2: ThirdClass, abstract, bidirectional ref to FirstClass -->
  <eClassifiers xsi:type="ecore:EClass" name="ThirdClass" abstract="true" interface="false">
    <!-- Reference 0: opposite of FirstClass.thirdRef -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="firstBack"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"/>
  </eClassifiers>

  <!-- Classifier 3: an extra EDataType (non-primitive) -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDataType" instanceTypeName="java.lang.String"/>

  <!-- Classifier 4: an EEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="SampleEnum">
    <eLiterals name="LIT_ONE" value="0" literal="LIT_ONE"/>
    <eLiterals name="LIT_TWO" value="1" literal="LIT_TWO"/>
  </eClassifiers>

  <!-- Classifier 5: AnotherEnum to increase enum coverage -->
  <eClassifiers xsi:type="ecore:EEnum" name="AnotherEnum">
    <eLiterals name="A1" value="0" literal="A1"/>
    <eLiterals name="A2" value="1" literal="A2"/>
    <eLiterals name="A3" value="2" literal="A3"/>
  </eClassifiers>

  <!-- Classifier 6: EClass using enums and CustomDataType in attributes -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumHolder" abstract="false" interface="false">
    <!-- Attribute 0: enum-typed SampleEnum, with default literal -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="enumAttr"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        changeable="true"
        volatile="false"
        transient="false"
        defaultValueLiteral="LIT_ONE"
        unsettable="false"
        derived="false"
        iD="false"
        eType="//@eClassifiers.4"/>
    <!-- Attribute 1: enum-typed AnotherEnum, no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="anotherEnumAttr"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        changeable="true"
        volatile="false"
        transient="false"
        unsettable="false"
        derived="false"
        iD="false"
        eType="//@eClassifiers.5"/>
    <!-- Attribute 2: CustomDataType-typed, default literal triggering @DataType branch -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="customAttr"
        ordered="false"
        unique="false"
        lowerBound="0"
        upperBound="5"
        changeable="true"
        volatile="false"
        transient="false"
        defaultValueLiteral="customDefault"
        unsettable="false"
        derived="true"
        iD="false"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

</ecore:EPackage>