<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://rootpkgURI"
    nsPrefix="root">
  <!-- Class 0: Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false">
    <!-- Attribute 0: id, EString, iD=true -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        iD="true"
        defaultValueLiteral="defaultId"/>
    <!-- Attribute 1: age, EInt -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="1"/>
    <!-- Reference 2: owns, containment, many, to Address -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owns"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- Class 1: Address -->
  <eClassifiers xsi:type="ecore:EClass" name="Address" abstract="false" interface="false">
    <!-- Attribute 0: street, EString -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="main street"/>
    <!-- Attribute 1: number, EInt -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="number"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="1"/>
    <!-- Reference 2: inhabitant, opposite of Person.address -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="inhabitant"
        eType="//@eClassifiers.0"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- EEnum 2: Color with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="BLUE" value="1" literal="BLUE"/>
  </eClassifiers>

  <!-- Class 3: Car extends PersonInterface, has attribute with enum type and reference to Person -->
  <eClassifiers xsi:type="ecore:EClass"
      name="Car"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.4">
    <!-- Attribute 0: color, typed by Color enum -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="color"
        eType="//@eClassifiers.2"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="RED"/>
    <!-- Reference 1: owner, non-containment to Person -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        eType="//@eClassifiers.0"
        lowerBound="1"
        upperBound="1"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- Class 4: PersonInterface, abstract super of Car -->
  <eClassifiers xsi:type="ecore:EClass"
      name="PersonInterface"
      abstract="true"
      interface="true"/>

  <!-- EDataType 5: CustomString -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="CustomString"
      instanceTypeName="java.lang.String"/>
</ecore:EPackage>