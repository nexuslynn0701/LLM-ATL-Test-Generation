<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://rootpkgURI"
    nsPrefix="rootpkgPrefix">

  <!-- Root package classifiers -->

  <!-- 0: EClass BaseClass -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass">
    <!-- attribute idAttr: String, is ID, with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="idAttr"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        iD="true"
        defaultValueLiteral="idDefault"/>
    <!-- attribute count: EInt bounds 0..* -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="count"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="-1"/>
    <!-- reference refToSub: BaseClass -> SubClass, non containment, bidirectional -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="refToSub"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- 1: EClass SubClass extends BaseClass -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass"
      abstract="true">
    <!-- super type BaseClass -->
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <!-- attribute flag: EBoolean -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="true"/>
    <!-- reference backRef: SubClass -> BaseClass, opposite of refToSub, containment -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="backRef"
        eType="//@eClassifiers.0"
        lowerBound="0"
        upperBound="1"
        containment="true"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
    <!-- attribute enumAttr: MyEnum -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="enumAttr"
        eType="//@eClassifiers.3"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="FIRST"/>
  </eClassifiers>

  <!-- 2: EClass ExtraClass with no supertypes -->
  <eClassifiers xsi:type="ecore:EClass" name="ExtraClass">
    <!-- reference extraRef: ExtraClass -> BaseClass, no opposite, non-containment -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="extraRef"
        eType="//@eClassifiers.0"
        lowerBound="1"
        upperBound="1"
        containment="false"/>
  </eClassifiers>

  <!-- 3: EEnum MyEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="MyEnum">
    <eLiterals name="FIRST" value="0" literal="FIRST"/>
    <eLiterals name="SECOND" value="1" literal="SECOND"/>
  </eClassifiers>

</ecore:EPackage>