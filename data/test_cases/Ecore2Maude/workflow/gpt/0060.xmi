<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="metaCore"
    nsURI="http://example/metacore"
    nsPrefix="mcore">

  <!-- 0: Root EClass with one attribute and one reference -->
  <eClassifiers xsi:type="ecore:EClass" name="RootElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="-1"
        containment="true"/>
  </eClassifiers>

  <!-- 1: Child EClass with super type RootElement, one attribute and one reference -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildElement"
      abstract="true"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="childCode"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        eType="//@eClassifiers.0"
        lowerBound="0"
        upperBound="1"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- 2: Status EEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>

  <!-- 3: Priority EEnum with three literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="PriorityLevel">
    <eLiterals name="LOW" value="0" literal="LOW"/>
    <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
    <eLiterals name="HIGH" value="2" literal="HIGH"/>
  </eClassifiers>

  <!-- 4: Simple data type -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomStringType"
      instanceTypeName="java.lang.String"/>

</ecore:EPackage>