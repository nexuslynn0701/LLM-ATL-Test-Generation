<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://example/root"
    nsPrefix="root">

  <!-- 0: Root class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <!-- Attribute with EString type, iD, lower/upper bounds -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="idAttr"
                         ordered="true"
                         unique="true"
                         lowerBound="1"
                         upperBound="1"
                         iD="true"
                         defaultValueLiteral="rootId"
                         eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute with EInt type -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="countAttr"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         defaultValueLiteral="5"
                         eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Attribute typed by local enum (index 5) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="statusAttr"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         eAttributeType="//@eClassifiers.5"/>
    <!-- Containment reference to SubClass with upperBound -1 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="children"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="-1"
                         containment="true"
                         eType="//@eClassifiers.1"/>
    <!-- Non-containment reference to LinkedClass with opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="link"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         containment="false"
                         eType="//@eClassifiers.3"
                         eOpposite="//@eClassifiers.3/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- 1: SubClass extends RootClass -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass" abstract="false" interface="false"
                eSuperTypes="//@eClassifiers.0">
    <!-- Simple EString attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="subName"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Reference back to RootClass, not containment -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="parent"
                         ordered="true"
                         unique="true"
                         lowerBound="1"
                         upperBound="1"
                         containment="false"
                         eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 2: Independent class with only attributes -->
  <eClassifiers xsi:type="ecore:EClass" name="OtherClass" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="flag"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         defaultValueLiteral="true"
                         eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- 3: LinkedClass that participates in a bidirectional reference with RootClass -->
  <eClassifiers xsi:type="ecore:EClass" name="LinkedClass" abstract="false" interface="false">
    <!-- Opposite of RootClass.link -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="root"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         containment="false"
                         eType="//@eClassifiers.0"
                         eOpposite="//@eClassifiers.0/@eStructuralFeatures.4"/>
  </eClassifiers>

  <!-- 4: Simple EDataType -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDataType" instanceClassName="java.lang.String"/>

  <!-- 5: Enumeration with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>

</ecore:EPackage>