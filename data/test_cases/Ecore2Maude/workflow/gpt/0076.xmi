<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="urn:rootpkg"
    nsPrefix="rp">

  <!-- Class in root package with both attributes and references, supertype, and opposite refs -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <!-- attribute with explicit primitive type, iD, bounds, default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        iD="true"
        defaultValueLiteral="&quot;unknown&quot;"/>
    <!-- attribute using EInt, no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="1"/>
    <!-- reference to Address with opposite set below -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="address"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="1"
        containment="true"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- Class with supertype Person, attributes and back reference -->
  <eClassifiers xsi:type="ecore:EClass" name="Address"
      eSuperTypes="//@eClassifiers.0">
    <!-- attribute with String type -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"/>
    <!-- opposite reference back to Person -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="resident"
        eType="//@eClassifiers.0"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- Enum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- DataType to appear among classifiers but not transformed as class/enum -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomData"/>

  <!-- Class that uses the enum and a reference without opposite -->
  <eClassifiers xsi:type="ecore:EClass" name="Car">
    <!-- attribute typed by the enum Color -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="paint"
        eType="//@eClassifiers.2"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="RED"/>
    <!-- reference without opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        eType="//@eClassifiers.0"
        lowerBound="0"
        upperBound="1"
        containment="false"/>
  </eClassifiers>

</ecore:EPackage>