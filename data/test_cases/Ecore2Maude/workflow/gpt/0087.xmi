<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://root/pkg"
    nsPrefix="root">

  <!-- 0: Root class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <!-- Attribute with EString type, iD, default value, non-default bounds -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="idAttr"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="root-id"
        iD="true"
        transient="false"
        volatile="false"
        derived="false"
        unsettable="false"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute with primitive int type, custom bounds, default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="countAttr"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="5"
        defaultValueLiteral="3"
        transient="false"
        volatile="false"
        derived="false"
        unsettable="false"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Attribute with enum type (classifier 4), no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="statusAttr"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        transient="false"
        volatile="false"
        derived="false"
        unsettable="false"
        eAttributeType="//@eClassifiers.4"/>
    <!-- Reference to SubClass, containment=true, single-valued -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="mainChild"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="true"
        resolveProxies="true"
        transient="false"
        volatile="false"
        derived="false"
        unsettable="false"
        eType="//@eClassifiers.1"/>
    <!-- Reference to RootClass, non-containment, many-valued -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="relatedRoots"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        resolveProxies="true"
        transient="false"
        volatile="false"
        derived="false"
        unsettable="false"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 1: SubClass extends RootClass, has attributes and an opposite reference -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute with EBoolean type, default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flagAttr"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="true"
        transient="false"
        volatile="false"
        derived="false"
        unsettable="false"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Attribute with generic EDataType (custom) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="genericAttr"
        ordered="false"
        unique="false"
        lowerBound="0"
        upperBound="1"
        transient="true"
        volatile="true"
        derived="true"
        unsettable="false"
        eAttributeType="//@eClassifiers.3"/>
    <!-- Non-containment reference back to RootClass, with opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        transient="false"
        volatile="false"
        derived="false"
        unsettable="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.4"/>
    <!-- Containment reference to ExtraClass (classifier 2), many-valued -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="extras"
        ordered="false"
        unique="false"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        transient="false"
        volatile="false"
        derived="false"
        unsettable="false"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 2: ExtraClass with supertype SubClass to trigger createSort on supertype in ecore package -->
  <eClassifiers xsi:type="ecore:EClass" name="ExtraClass" abstract="true" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <!-- Attribute without explicit type (NoType in transformation), unusual bounds -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="looseAttr"
        ordered="false"
        unique="false"
        lowerBound="2"
        upperBound="7"
        transient="true"
        volatile="false"
        derived="false"
        unsettable="true"
        eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Reference many-valued to RootClass, non-containment -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="otherRoots"
        ordered="true"
        unique="false"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        resolveProxies="true"
        transient="false"
        volatile="true"
        derived="false"
        unsettable="false"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 3: Custom EDataType used by genericAttr -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomData"/>

  <!-- 4: Enumeration with two literals, used by statusAttr -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>

</ecore:EPackage>