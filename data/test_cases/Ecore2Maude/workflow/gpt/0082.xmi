<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://example/rootpkg"
    nsPrefix="root">
  <!-- Class in root package -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass">
    <!-- Attribute with EString type, is ID, has default value -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootName"
        lowerBound="1"
        upperBound="1"
        iD="true"
        defaultValueLiteral="defaultRootName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Reference to SubClass, containment, bidirectional opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="toSub"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.2"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- Enumeration with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- Subclass in root package, extends RootClass -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass" abstract="true">
    <eSuperTypes href="//@eClassifiers.0"/>
    <!-- Attribute with enum type, default literal -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="color"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="RED"
        eType="//@eClassifiers.1"/>
    <!-- Reference back to RootClass, non-containment opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="1"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- Data type in root package -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDataType" instanceTypeName="java.lang.String"/>

  <!-- Subpackage -->
  <eSubpackages name="subpkg" nsURI="http://example/subpkg" nsPrefix="sub">
    <!-- Class in subpackage, supertype RootClass -->
    <eClassifiers xsi:type="ecore:EClass" name="SubpkgClass">
      <eSuperTypes href="//@eClassifiers.0"/>
      <!-- Attribute with EInt type, default value -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="count"
          lowerBound="0"
          upperBound="1"
          defaultValueLiteral="5"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eClassifiers>
    <!-- Enumeration in subpackage -->
    <eClassifiers xsi:type="ecore:EEnum" name="SubEnum">
      <eLiterals name="ONE" value="1" literal="ONE"/>
      <eLiterals name="TWO" value="2" literal="TWO"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>