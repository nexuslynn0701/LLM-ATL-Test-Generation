<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://rootpkgURI"
    nsPrefix="rootpkg">
  <!-- Root package classifiers -->
  <!-- 0: Class in root package -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass" abstract="false" interface="false">
    <!-- Attribute with String type, default value, ID, assorted bounds -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="nameAttr"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        iD="true"
        defaultValueLiteral="defaultName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute with Boolean type, no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flagAttr"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Reference to DerivedClass with containment, non-opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="containedDerived"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 1: Class in root package, extends BaseClass -->
  <eClassifiers xsi:type="ecore:EClass" name="DerivedClass" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute with Int type, specific bounds -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="countAttr"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="5"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference to BaseClass, non-containment, opposite set below -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        xmi:id="refToBase"
        name="refToBase"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 2: Enum in root package -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <!-- 3: EDataType in root package -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDataType" instanceTypeName="java.lang.Object"/>

  <!-- 4: Second Enum in root package -->
  <eClassifiers xsi:type="ecore:EEnum" name="SizeEnum">
    <eLiterals name="SMALL" value="0" literal="SMALL"/>
    <eLiterals name="LARGE" value="1" literal="LARGE"/>
  </eClassifiers>

  <!-- Subpackage with its own classifiers -->
  <eSubpackages name="subpkg" nsURI="http://subpkgURI" nsPrefix="subpkg">
    <!-- 0: Class in subpackage, with supertype from root package -->
    <eClassifiers xsi:type="ecore:EClass" name="SubClass" abstract="true">
      <!-- Supertype: BaseClass from root package -->
      <eSuperTypes href="//@eClassifiers.0"/>
      <!-- Attribute typed by ColorEnum -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="colorAttr"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          defaultValueLiteral="RED"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <!-- Reference to Enum literal host class via opposite reference -->
      <eStructuralFeatures xsi:type="ecore:EReference"
          xmi:id="subToBaseOpp"
          name="subToBaseOpp"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="-1"
          containment="false"
          resolveProxies="true"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eClassifiers>

    <!-- 1: Enum in subpackage -->
    <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
      <eLiterals name="NEW" value="0" literal="NEW"/>
      <eLiterals name="DONE" value="1" literal="DONE"/>
    </eClassifiers>

    <!-- 2: EDataType in subpackage -->
    <eClassifiers xsi:type="ecore:EDataType" name="SubCustomType" instanceTypeName="java.lang.String"/>
  </eSubpackages>

  <!-- 5: OppositeConnector class in root package -->
  <eClassifiers xsi:type="ecore:EClass" name="OppositeConnector" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="baseToDerived"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"/>
  </eClassifiers>
</ecore:EPackage>