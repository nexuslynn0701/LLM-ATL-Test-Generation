<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://rootPkgURI"
    nsPrefix="root">
  <!-- EClass 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass">
    <!-- Attribute 0 of BaseClass: String-typed, with default, id=false -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="baseName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="defaultBase"
        iD="false"/>
    <!-- Reference 1 of BaseClass: to SubClass, containment, lower=1, upper=-1 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="subs"
        eType="//@eClassifiers.1"
        containment="true"
        lowerBound="1"
        upperBound="-1"
        ordered="true"
        unique="true"/>
  </eClassifiers>

  <!-- EClass 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass">
    <!-- Attribute 0 of SubClass: Int-typed, with default, id=true -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="subId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="42"
        iD="true"/>
    <!-- Reference 1 of SubClass: to BaseClass, opposite of BaseClass.subs, non-containment -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"
        containment="false"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"/>
  </eClassifiers>

  <!-- EEnum 2 with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="DONE" value="1" literal="DONE"/>
  </eClassifiers>

  <!-- EEnum 3 with one literal -->
  <eClassifiers xsi:type="ecore:EEnum" name="Priority">
    <eLiterals name="HIGH" value="0" literal="HIGH"/>
  </eClassifiers>

  <!-- EClass 4 using EEnum and EBoolean -->
  <eClassifiers xsi:type="ecore:EClass" name="Task">
    <!-- Attribute 0: enum-typed (Status) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        eType="//@eClassifiers.2"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="NEW"/>
    <!-- Attribute 1: boolean-typed -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="true"/>
  </eClassifiers>
</ecore:EPackage>