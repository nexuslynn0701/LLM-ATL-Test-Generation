<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="testpkg"
    nsURI="http://testpkg"
    nsPrefix="tp">

  <!-- Class 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="Base" abstract="true">
    <!-- Attribute 0: ID, String-typed, with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        iD="true"
        defaultValueLiteral="ID-DEF"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1: Integer-typed, explicit bounds -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="num"
        lowerBound="0"
        upperBound="5"
        defaultValueLiteral="7"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Attribute 2: Boolean-typed, many-valued -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        lowerBound="0"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- Class 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="Derived">
    <!-- Extends Base (classifier 0) -->
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>

    <!-- Reference 0: to Base, containment, 0..* -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.0"/>

    <!-- Reference 1: to Derived, non-containment, 1..1 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        lowerBound="1"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- Enumeration 2 with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="BLUE" value="1" literal="BLUE"/>
  </eClassifiers>

  <!-- Class 3 using the enum -->
  <eClassifiers xsi:type="ecore:EClass" name="Colored">
    <!-- Attribute 0: enum-typed -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="shade"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

</ecore:EPackage>