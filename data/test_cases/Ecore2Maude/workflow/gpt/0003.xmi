<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:ecore="http://ecore"
  name="pkgroot"
  nsURI="uri_pkgroot"
  nsPrefix="pkgrootPrefix">

  <!-- Classifier 0: root-level EClass A -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClassA">
    <eStructuralFeatures xsi:type="eccore:EAttribute" xmlns:eccore="http://www.eclipse.org/emf/2002/Ecore"
                         name="attrA"
                         lowerBound="0"
                         upperBound="1"
                         ordered="true"
                         unique="true"
                         defaultValueLiteral="defaultA">
      <eType xsi:type="ecore:EDataType"
             href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- Classifier 1: root-level EClass B that extends ecore::EClass to trigger createSort -->
  <eClassifiers xsi:type="ecore:EClass"
                name="RootClassB"
                abstract="true"
                interface="false">
    <!-- Supertype is the standard Ecore EClass: triggers createSort -->
    <eSuperTypes href="http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="refToA"
                         lowerBound="1"
                         upperBound="-1"
                         containment="false"
                         ordered="true"
                         unique="true"
                         resolveProxies="true">
      <eType href="//@eClassifiers.0"/>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- Classifier 2: an EEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="ColorEnum">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
  </eClassifiers>

  <!-- Classifier 3: an EDataType, used as attribute type -->
  <eClassifiers xsi:type="ecore:EDataType"
                name="CustomStringType"
                instanceTypeName="java.lang.String"/>

  <!-- Classifier 4: EClass C using the custom EDataType and the enum -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClassC">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="label"
                         lowerBound="0"
                         upperBound="1"
                         ordered="true"
                         unique="true"
                         defaultValueLiteral="lbl">
      <eType href="//@eClassifiers.3"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="color"
                         lowerBound="0"
                         upperBound="1"
                         ordered="true"
                         unique="true"
                         defaultValueLiteral="RED">
      <eType href="//@eClassifiers.2"/>
    </eStructuralFeatures>
  </eClassifiers>

</ecore:EPackage>