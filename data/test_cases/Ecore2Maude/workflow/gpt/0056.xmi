<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="urn:rootpkg"
    nsPrefix="rp">

  <!-- Classifier 0: Root class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <!-- Attribute 0: string with default, ID, ordered/unique true -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootName"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="defaultRoot"
        iD="true"/>
    <!-- Attribute 1: int without default, not ID, unordered/non-unique -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootCount"
        ordered="false"
        unique="false"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference 2: containment to ChildClass, multiplicity 0..* -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="children"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.1"
        containment="true"/>
    <!-- Reference 3: non-containment to AssocClass, single-valued, with opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="assoc"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"
        containment="false"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- Classifier 1: Child class extending RootClass, with attribute and reference -->
  <eClassifiers xsi:type="ecore:EClass"
      name="ChildClass"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attribute 0: boolean with default value -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true"/>
    <!-- Reference 1: many, non-containment to AssocClass -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="links"
        ordered="false"
        unique="false"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.2"
        containment="false"/>
  </eClassifiers>

  <!-- Classifier 2: Assoc class with opposite back to RootClass and attribute -->
  <eClassifiers xsi:type="ecore:EClass"
      name="AssocClass"
      abstract="false"
      interface="false">
    <!-- Reference 0: opposite of RootClass.assoc -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.0"
        containment="false"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"/>
    <!-- Attribute 1: string, unordered/non-unique -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="tag"
        ordered="false"
        unique="false"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Classifier 3: An EDataType used by attributes -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="CustomData"
      instanceTypeName="java.lang.String"/>

  <!-- Classifier 4: Enumeration with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="DONE" value="1" literal="DONE"/>
  </eClassifiers>

  <!-- Classifier 5: Another Enumeration with one literal -->
  <eClassifiers xsi:type="ecore:EEnum" name="LevelEnum">
    <eLiterals name="LOW" value="0" literal="LOW"/>
  </eClassifiers>

  <!-- Classifier 6: Class using enums and custom datatype -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumUser" abstract="false" interface="false">
    <!-- Attribute 0: enum-typed attribute with default literal -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.4"
        defaultValueLiteral="NEW"/>
    <!-- Attribute 1: enum-typed attribute without default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="level"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.5"/>
    <!-- Attribute 2: custom datatype-typed attribute, multi-valued -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="labels"
        ordered="false"
        unique="false"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

</ecore:EPackage>