<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootpkg"
    nsURI="http://example/rootpkg"
    nsPrefix="rootpkg">
  <!-- Class 0: Superclass for Class1 -->
  <eClassifiers xsi:type="ecore:EClass" name="SuperClass">
    <!-- Attribute 0: idAttr (ID, String type, default value, ordered/unique true) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="idAttr"
        lowerBound="1"
        upperBound="1"
        iD="true"
        defaultValueLiteral="defaultId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Attribute 1: count (Int type, lowerBound 0, upperBound -1) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="count"
        lowerBound="0"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- Class 1: SubClass extends SuperClass, has attributes and a reference -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass" abstract="true" eSuperTypes="//@eClassifiers.0">
    <!-- Attribute 0: flag (Boolean) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Attribute 1: title (String, ordered=false, unique=false) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        ordered="false"
        unique="false"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Reference 2: refToSuper, containment=false, opposite is refBack -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="refToSuper"
        lowerBound="1"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.4/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- Class 2: ClassWithEnumAttr, has an attribute typed by Enum0 -->
  <eClassifiers xsi:type="ecore:EClass" name="ClassWithEnumAttr">
    <!-- Attribute 0: status (EEnum Enum0) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- Enum 3: Enum0 with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Enum0">
    <eLiterals name="LIT_ONE" value="0" literal="LIT_ONE"/>
    <eLiterals name="LIT_TWO" value="1" literal="LIT_TWO"/>
  </eClassifiers>

  <!-- Class 4: RefOwnerClass, references SubClass with opposite refToSuper -->
  <eClassifiers xsi:type="ecore:EClass" name="RefOwnerClass">
    <!-- Reference 0: refBack, containment=true, opposite refToSuper -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="refBack"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- DataType 5: CustomDataType -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDataType" instanceClassName="java.lang.String"/>
</ecore:EPackage>