<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="testPkg65" nsURI="http://testPkg65" nsPrefix="tp65">
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="ACTIVE" value="0" literal="active"/>
    <eLiterals name="INACTIVE" value="1" literal="inactive"/>
    <eLiterals name="PENDING" value="2" literal="pending"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="User" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="username"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="email"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="metadata"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" many="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="profile"
        eType="//@eClassifiers.2" containment="true" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="status"
        eType="//@eClassifiers.0" containment="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Profile" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bio"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="createdDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner"
        eType="//@eClassifiers.1" eOpposite="//@eClassifiers.1/eStructuralFeatures.6"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EOperation" name="authenticate">
    <eParameters name="token" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eExceptions>//@eClassifiers.4</eExceptions>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AuthException" abstract="false" interface="false">
    <eSuperTypes>//@eClassifiers.5</eSuperTypes>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BaseException" abstract="false" interface="false"/>
</ecore:EPackage>