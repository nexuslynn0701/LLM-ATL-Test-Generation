<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="testPkg63" nsURI="http://testPkg63" nsPrefix="tp63">
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="ACTIVE" value="0" literal="active"/>
    <eLiterals name="INACTIVE" value="1" literal="inactive"/>
    <eLiterals name="PENDING" value="2" literal="pending"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="CustomID" instanceClassName="java.lang.String"/>
  <eClassifiers xsi:type="ecore:EClass" name="User" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" iD="true"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" 
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="profile" 
        eType="//@eClassifiers.3" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Profile" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="email" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="user" 
        eType="//@eClassifiers.2" eOpposite="//@eClassifiers.2/@eStructuralFeatures.3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Admin" abstract="false" interface="false">
    <eSuperTypes>//@eClassifiers.2</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="level" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EOperation" name="promote" 
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
    <eParameters name="newLevel" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
</ecore:EPackage>