<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="testPkg" nsURI="http://testPkg" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE" value="0" literal="active"/>
    <eLiterals name="INACTIVE" value="1" literal="inactive"/>
    <eLiterals name="PENDING" value="2" literal="pending"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="CustomString" instanceClassName="java.lang.String"/>
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="email" 
        eType="//@eClassifiers.2" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" 
        eType="//@eClassifiers.0" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" 
        eType="//@eClassifiers.4" containment="true" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="friends" 
        eType="//@eClassifiers.3" upperBound="-1" containment="false" resolveProxies="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Address" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="city" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="resident" 
        eType="//@eClassifiers.3" eOpposite="//@eClassifiers.3/@eStructuralFeatures.4"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Organization" abstract="true" interface="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="Company" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.6">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="companyId" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eOperations name="getEmployeeCount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eOperations name="hireEmployee">
      <eParameters name="person" eType="//@eClassifiers.3"/>
    </eOperations>
  </eClassifiers>
</ecore:EPackage>