<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="testPackage" nsURI="http://test/package" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rootName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rootCount" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" upperBound="-1" eType="//@eClassifiers.1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mainChild" lowerBound="1" eType="//@eClassifiers.1" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="childName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="//@eClassifiers.0" changeable="false" transient="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="details" upperBound="-1" eType="//@eClassifiers.2" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="relatedItems" upperBound="-1" eType="//@eClassifiers.3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DetailClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="detailKey" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="detailValue" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priority" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ItemClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="itemCode" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="quantity" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="price" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum" serializable="true">
    <eLiterals name="PENDING" value="0" literal="pending"/>
    <eLiterals name="ACTIVE" value="1" literal="active"/>
    <eLiterals name="COMPLETED" value="2" literal="completed"/>
    <eLiterals name="ARCHIVED" value="3" literal="archived"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ProcessClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="processId" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="startTime" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="steps" upperBound="-1" eType="//@eClassifiers.6" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="StepClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="stepName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="order" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="duration" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="nextStep" eType="//@eClassifiers.6"/>
  </eClassifiers>
</ecore:EPackage>