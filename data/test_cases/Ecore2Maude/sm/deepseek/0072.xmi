    <eStructuralFeatures xsi:type="ecore:EReference" name="tags" upperBound="-1" eType="//@eClassifiers.2" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Tag" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner" eType="//@eClassifiers.1" changeable="false" transient="true" resolveProxies="false" eOpposite="//@eClassifiers.1/@eStructuralFeatures.3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Configuration" abstract="false" interface="false">
