    <eStructuralFeatures xsi:type="ecore:EAttribute" name="quantity" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="container" eType="//@eClassifiers.8" changeable="false" transient="true"/>
  </eClassifiers>
</ecore:EPackage>