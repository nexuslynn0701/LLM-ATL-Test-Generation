<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="testPackage" nsURI="http://test/package" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rootName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rootCount" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" upperBound="-1" eType="//@eClassifiers.1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mainChild" lowerBound="1" eType="//@eClassifiers.1" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="childName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="childValue" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="//@eClassifiers.0" changeable="false" transient="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="siblings" upperBound="-1" eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="details" upperBound="-1" eType="//@eClassifiers.2" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DetailClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="detailKey" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="detailValue" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priority" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum" serializable="true">
    <eLiterals name="PENDING" value="0" literal="pending"/>
    <eLiterals name="ACTIVE" value="1" literal="active"/>
    <eLiterals name="COMPLETED" value="2" literal="completed"/>
    <eLiterals name="ARCHIVED" value="3" literal="archived"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ProcessClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="processName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeout" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong" defaultValueLiteral="1000"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner" eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tasks" upperBound="-1" eType="//@eClassifiers.5" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TaskClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="taskName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="duration" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="0.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="completed" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="dependencies" upperBound="-1" eType="//@eClassifiers.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assignedTo" eType="//@eClassifiers.1"/>
  </eClassifiers>
</ecore:EPackage>