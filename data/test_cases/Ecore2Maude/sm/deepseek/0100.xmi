<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="testPackage" nsURI="http://test/package" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rootName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" ordered="true" unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rootCount" lowerBound="0" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" upperBound="-1" eType="//@eClassifiers.1" containment="true" ordered="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="linkedItems" upperBound="-1" eType="//@eClassifiers.2" ordered="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="childName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="//@eClassifiers.0" changeable="false" transient="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="details" upperBound="-1" eType="//@eClassifiers.3" containment="true" ordered="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="LinkedItem" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="itemCode" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="0.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owningRoot" eType="//@eClassifiers.0" changeable="false" transient="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DetailInfo" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priority" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="5"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owningChild" eType="//@eClassifiers.1" changeable="false" transient="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum" serializable="true">
    <eLiterals name="PENDING" value="0" literal="pending"/>
    <eLiterals name="ACTIVE" value="1" literal="active"/>
    <eLiterals name="COMPLETED" value="2" literal="completed"/>
    <eLiterals name="ARCHIVED" value="3" literal="archived"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="StatusHolder" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timestamp" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong" defaultValueLiteral="0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" eType="//@eClassifiers.1" ordered="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Configuration" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="configName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxRetries" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="3"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeout" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat" defaultValueLiteral="30.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="associatedRoot" eType="//@eClassifiers.0"/>
  </eClassifiers>
</ecore:EPackage>