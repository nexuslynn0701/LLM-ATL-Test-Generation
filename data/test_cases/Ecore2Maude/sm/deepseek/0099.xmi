<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://ecore" name="InvoiceSystem" nsURI="http://invoicesystem" nsPrefix="inv">
  <eClassifiers xsi:type="ecore:EClass" name="Customer" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="customerID" lowerBound="1" unique="true" ordered="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" changeable="true" volatile="false" transient="false" defaultValueLiteral="true" unsettable="false" derived="false" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Invoice" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="invoiceNumber" lowerBound="1" ordered="true" unique="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="totalAmount" lowerBound="1" ordered="true" unique="false" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="customer" lowerBound="1" upperBound="1" containment="false" resolveProxies="true" eType="//@eClassifiers.0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="LineItem" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" lowerBound="1" ordered="true" unique="false" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="quantity" lowerBound="1" ordered="true" unique="false" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="unitPrice" lowerBound="1" ordered="true" unique="false" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoice" lowerBound="1" upperBound="1" containment="false" resolveProxies="true" eType="//@eClassifiers.1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Payment" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="paymentID" lowerBound="1" ordered="true" unique="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="amount" lowerBound="1" ordered="true" unique="false" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoicePaid" lowerBound="1" upperBound="1" containment="false" resolveProxies="true" eType="//@eClassifiers.1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Product" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="productCode" lowerBound="1" ordered="true" unique="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="price" lowerBound="1" ordered="true" unique="false" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="inStock" changeable="true" volatile="false" transient="false" defaultValueLiteral="true" unsettable="false" derived="false" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="PaymentMethod" serializable="true">
    <eLiterals xsi:type="ecore:EEnumLiteral" name="CREDIT_CARD" value="0" literal="CREDIT_CARD"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="DEBIT_CARD" value="1" literal="DEBIT_CARD"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="BANK_TRANSFER" value="2" literal="BANK_TRANSFER"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="CASH" value="3" literal="CASH"/>
  </eClassifiers>
</ecore:EPackage>