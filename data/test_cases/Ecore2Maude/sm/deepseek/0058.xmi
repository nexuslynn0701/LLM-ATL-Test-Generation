<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="testPackage" nsURI="http://test/package" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EClass" name="Root" abstract="true" interface="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rootID" iD="true" eAttributeType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1" unique="true" ordered="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" upperBound="-1"
        eType="//@eClassifiers.1" containment="true" ordered="true" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="singleChild" eType="//@eClassifiers.1"
        containment="true" ordered="true" resolveProxies="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Child">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1" ordered="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="0" ordered="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="false" ordered="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="//@eClassifiers.0"
        changeable="false" transient="true" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="siblings" upperBound="-1"
        eType="//@eClassifiers.1" ordered="true" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="attributes" upperBound="-1"
        eType="//@eClassifiers.2" containment="true" ordered="true" resolveProxies="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Attribute">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="attrName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1" ordered="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="attrValue" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        ordered="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="attrType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        ordered="true" defaultValueLiteral="string"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner" eType="//@eClassifiers.1"
        changeable="false" transient="true" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="relatedAttribute" eType="//@eClassifiers.2"
        ordered="true" resolveProxies="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDataType" serializable="true"
      instanceClassName="java.lang.String"/>
</ecore:EPackage>