<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="libraryModel"
    nsURI="http://example.org/libraryModel"
    nsPrefix="lib">

  <!-- 0: Primitive-looking data type used as attribute type -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="ISBN"
      instanceClassName="java.lang.String"/>

  <!-- 1: Enum for book categories -->
  <eClassifiers xsi:type="ecore:EEnum" name="BookCategory">
    <eLiterals name="SCIENCE" value="0" literal="SCIENCE"/>
    <eLiterals name="ART" value="1" literal="ART"/>
    <eLiterals name="FICTION" value="2" literal="FICTION"/>
  </eClassifiers>

  <!-- 2: Map entry type (non-abstract, for feature map / options) -->
  <eClassifiers xsi:type="ecore:EClass" name="OptionEntry">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 3: Abstract named element with a code -->
  <eClassifiers xsi:type="ecore:EClass" name="NamedElement" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 4: Abstract person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fullName"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 5: Author class with ID attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="Author"
      eSuperTypes="//@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="iD"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="email"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 6: Member class with containment of borrowed books -->
  <eClassifiers xsi:type="ecore:EClass" name="Member"
      eSuperTypes="//@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memberId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"/>
    <!-- containment reference to Book, with opposite on Book -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="borrowedBooks"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.7"
        eOpposite="//@eClassifiers.7/@eStructuralFeatures.3"/>
  </eClassifiers>

  <!-- 7: Book class -->
  <eClassifiers xsi:type="ecore:EClass" name="Book"
      eSuperTypes="//@eClassifiers.3">
    <!-- title -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- isbn with custom datatype -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isbn"
        eType="//@eClassifiers.0"/>
    <!-- category enum -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="category"
        eType="//@eClassifiers.1"/>
    <!-- back reference to Member (container) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="holder"
        lowerBound="0"
        eType="//@eClassifiers.6"
        eOpposite="//@eClassifiers.6/@eStructuralFeatures.1"/>
    <!-- non-containment reference to Publisher -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="publisher"
        eType="//@eClassifiers.8"/>
  </eClassifiers>

  <!-- 8: Publisher class with operations and parameters -->
  <eClassifiers xsi:type="ecore:EClass" name="Publisher"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- containment of books it prints (different from member.borrowedBooks) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="catalog"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.7"/>
    <!-- sample operation -->
    <eOperations name="findBooksByTitle">
      <eParameters name="pattern"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <!-- operation with exception type -->
    <eOperations name="registerIsbn"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eParameters name="isbnToRegister" eType="//@eClassifiers.0"/>
      <eExceptions eType="//@eClassifiers.9"/>
    </eOperations>
  </eClassifiers>

  <!-- 9: Custom data-type used as an exception classifier -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="RegistrationException"
      instanceClassName="java.lang.Exception"/>

  <!-- 10: Library root that aggregates everything -->
  <eClassifiers xsi:type="ecore:EClass" name="Library">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="publishers"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.8"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="members"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.6"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="allAuthors"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.5"/>
    <!-- a containment of OptionEntry map-like entries -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="options"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

</ecore:EPackage>