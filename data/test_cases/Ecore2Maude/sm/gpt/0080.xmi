<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="complexPkg"
    nsURI="http://example.org/complexPkg"
    nsPrefix="cpx">

  <!-- Classifier 0: Root container class -->
  <eClassifiers xsi:type="ecore:EClass" name="RootElement" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EReference" name="mainPerson"
        lowerBound="1" upperBound="1"
        eType="//@eClassifiers.1"
        containment="true" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="allPersons"
        lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.1"
        containment="true" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="allCompanies"
        lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.2"
        containment="true" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="topLevelEnums"
        lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.4"
        containment="true" resolveProxies="false"/>
  </eClassifiers>

  <!-- Classifier 1: Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identifier"
        lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age"
        lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="vip"
        lowerBound="0" upperBound="1"
        defaultValueLiteral="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employer"
        lowerBound="0" upperBound="1"
        eType="//@eClassifiers.2"
        containment="false" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="addresses"
        lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.3"
        containment="true" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="favoriteColor"
        lowerBound="0" upperBound="1"
        eType="//@eClassifiers.4"
        containment="false" resolveProxies="false"/>
  </eClassifiers>

  <!-- Classifier 2: Company -->
  <eClassifiers xsi:type="ecore:EClass" name="Company" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="founded"
        lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees"
        lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.1"
        containment="false" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="headquarters"
        lowerBound="0" upperBound="1"
        eType="//@eClassifiers.3"
        containment="true" resolveProxies="true"/>
  </eClassifiers>

  <!-- Classifier 3: Address, extending Person (to create non-trivial inheritance) -->
  <eClassifiers xsi:type="ecore:EClass" name="Address" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street"
        lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="city"
        lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="zip"
        lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Classifier 4: Enum Color -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
    <eLiterals name="GREEN" value="1" literal="GREEN"/>
    <eLiterals name="BLUE" value="2" literal="BLUE"/>
  </eClassifiers>

  <!-- Classifier 5: Custom Serializable DataType -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomIDType" instanceClassName="java.lang.String" serializable="true"/>

  <!-- Classifier 6: Simple map entry -->
  <eClassifiers xsi:type="ecore:EClass" name="MetaInfoEntry" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key"
        lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Classifier 7: OperationOwner with operation and parameter -->
  <eClassifiers xsi:type="ecore:EClass" name="OperationOwner" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EReference" name="relatedCompany"
        lowerBound="0" upperBound="1"
        eType="//@eClassifiers.2"
        containment="false" resolveProxies="true"/>
    <eOperations name="computeScore" ordered="true" unique="true" lowerBound="0" upperBound="1">
      <eParameters name="factor"
          ordered="true" unique="true" lowerBound="1" upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eParameters name="label"
          ordered="true" unique="true" lowerBound="0" upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eType xsi:type="ecore:EDataType"
          href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eOperations>
  </eClassifiers>

</ecore:EPackage>