<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="libraryPkg"
    nsURI="http://example.org/libraryPkg"
    nsPrefix="lib">

  <!-- 0: Enum for BookStatus -->
  <eClassifiers xsi:type="ecore:EEnum" name="BookStatus">
    <eLiterals name="AVAILABLE" value="0" literal="AVAILABLE"/>
    <eLiterals name="BORROWED" value="1" literal="BORROWED"/>
    <eLiterals name="LOST" value="2" literal="LOST"/>
  </eClassifiers>

  <!-- 1: Primitive alias for Identifier -->
  <eClassifiers xsi:type="ecore:EDataType" name="Identifier" instanceClassName="java.lang.String"/>

  <!-- 2: EClass Library -->
  <eClassifiers xsi:type="ecore:EClass" name="Library" abstract="false" interface="false">
    <!-- Attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="location"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Containment references -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="books"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="false"
        eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="members"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="false"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 3: EClass Book -->
  <eClassifiers xsi:type="ecore:EClass" name="Book" abstract="false" interface="false">
    <!-- Attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="pages"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.0"/>
    <!-- References -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="primaryAuthor"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="coAuthors"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eType="//@eClassifiers.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="currentBorrower"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 4: EClass Member -->
  <eClassifiers xsi:type="ecore:EClass" name="Member" abstract="false" interface="false">
    <!-- Attributes -->
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        xsi:type="ecore:EAttribute"
        name="memberId"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Non-containment reference to borrowed books -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="borrowedBooks"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- 5: EClass Person (superclass of Author and Librarian) -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="firstName"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="lastName"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 6: EClass Author extends Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Author" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.5">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="penName"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 7: EClass Librarian extends Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Librarian" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.5">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="employeeNumber"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 8: EClass AuditEntry -->
  <eClassifiers xsi:type="ecore:EClass" name="AuditEntry" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="timestamp"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="message"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 9: EClass LibrarySystem (root) -->
  <eClassifiers xsi:type="ecore:EClass" name="LibrarySystem" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="systemName"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="libraries"
        lowerBound="1"
        upperBound="-1"
        containment="true"
        resolveProxies="false"
        eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="staff"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="false"
        eType="//@eClassifiers.7"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="auditTrail"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="false"
        eType="//@eClassifiers.8"/>
  </eClassifiers>

  <!-- 10: Map entry for dynamic properties -->
  <eClassifiers xsi:type="ecore:EClass" name="PropertyEntry" instanceClassName="java.util.Map$Entry">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="key"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="value"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>