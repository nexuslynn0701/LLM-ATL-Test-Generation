<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="libraryPkg"
    nsURI="http://example.org/libraryPkg"
    nsPrefix="lib">

  <!-- 0: Primitive data type -->
  <eClassifiers xsi:type="ecore:EDataType" name="BookIdType" instanceClassName="java.lang.String"/>

  <!-- 1: Enum for status -->
  <eClassifiers xsi:type="ecore:EEnum" name="LendingStatus">
    <eLiterals name="AVAILABLE" value="0" literal="AVAILABLE"/>
    <eLiterals name="BORROWED" value="1" literal="BORROWED"/>
    <eLiterals name="RESERVED" value="2" literal="RESERVED"/>
  </eClassifiers>

  <!-- 2: Abstract base class -->
  <eClassifiers xsi:type="ecore:EClass" name="NamedElement" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 3: Library root -->
  <eClassifiers xsi:type="ecore:EClass" name="Library" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="location"
        lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="books"
        lowerBound="0" upperBound="-1"
        containment="true" resolveProxies="true"
        eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="members"
        lowerBound="0" upperBound="-1"
        containment="true" resolveProxies="true"
        eType="//@eClassifiers.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="loans"
        lowerBound="0" upperBound="-1"
        containment="true" resolveProxies="true"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

  <!-- 4: Book class extends NamedElement -->
  <eClassifiers xsi:type="ecore:EClass" name="Book" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id"
        lowerBound="1" upperBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pages"
        lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        lowerBound="1" upperBound="1"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="authors"
        lowerBound="0" upperBound="-1"
        containment="false" resolveProxies="true"
        eType="//@eClassifiers.7"/>
  </eClassifiers>

  <!-- 5: Member class extends NamedElement -->
  <eClassifiers xsi:type="ecore:EClass" name="Member" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memberNumber"
        lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="email"
        lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 6: Loan class, references Book and Member -->
  <eClassifiers xsi:type="ecore:EClass" name="Loan" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="days"
        lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="book"
        lowerBound="1" upperBound="1"
        containment="false" resolveProxies="true"
        eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="borrower"
        lowerBound="1" upperBound="1"
        containment="false" resolveProxies="true"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 7: Author class extends NamedElement -->
  <eClassifiers xsi:type="ecore:EClass" name="Author" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="birthYear"
        lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 8: Map entry for library properties -->
  <eClassifiers xsi:type="ecore:EClass" name="PropertyEntry" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key"
        lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>