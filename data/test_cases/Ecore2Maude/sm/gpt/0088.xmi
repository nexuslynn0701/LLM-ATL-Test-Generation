<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyModel"
    nsURI="http://example.org/companyModel"
    nsPrefix="comp">

  <!-- 0: Custom String datatype -->
  <eClassifiers xsi:type="ecore:EDataType" name="MyString"
      instanceClassName="java.lang.String"/>

  <!-- 1: Custom Integer datatype -->
  <eClassifiers xsi:type="eccore:EDataType" name="MyInt"
      instanceClassName="int"/>

  <!-- 2: Simple enum with literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="DepartmentKind">
    <eLiterals name="HR" value="0" literal="HR"/>
    <eLiterals name="ENGINEERING" value="1" literal="ENGINEERING"/>
    <eLiterals name="SALES" value="2" literal="SALES"/>
  </eClassifiers>

  <!-- 3: Abstract base class Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 4: Concrete subclass Employee -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary"
        lowerBound="0"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.4"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- 5: Concrete subclass Contractor -->
  <eClassifiers xsi:type="ecore:EClass" name="Contractor" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hourlyRate"
        lowerBound="0"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 6: Department class with enum and containment of Employee & Contractor -->
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind"
        lowerBound="1"
        eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="contractors"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 7: Project class referencing Department and Employee -->
  <eClassifiers xsi:type="ecore:EClass" name="Project" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="projectId"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="budget"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownerDepartment"
        lowerBound="1"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.6"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="team"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 8: Root class Company containing departments and projects -->
  <eClassifiers xsi:type="ecore:EClass" name="Company" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="departments"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.6"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="projects"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.7"/>
  </eClassifiers>

</ecore:EPackage>