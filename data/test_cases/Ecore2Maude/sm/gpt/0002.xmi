<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyModel"
    nsURI="http://example.org/companyModel"
    nsPrefix="company">

  <!-- 0: Primitive alias for String -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="Text"
      instanceClassName="java.lang.String"/>

  <!-- 1: Primitive alias for int -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="IntegerAlias"
      instanceClassName="int"/>

  <!-- 2: Enum for employee roles -->
  <eClassifiers xsi:type="ecore:EEnum" name="RoleKind">
    <eLiterals name="DEV" value="0" literal="DEV"/>
    <eLiterals name="MANAGER" value="1" literal="MANAGER"/>
    <eLiterals name="HR" value="2" literal="HR"/>
  </eClassifiers>

  <!-- 3: Base abstract Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 4: Employee extends Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.3">
    <!-- salary uses IntegerAlias -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="salary"
        lowerBound="0"
        eType="//@eClassifiers.1"/>
    <!-- role is an enum -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="role"
        lowerBound="1"
        eType="//@eClassifiers.2"/>
    <!-- manager is a non-containment reference to another Employee -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="manager"
        lowerBound="0"
        eType="//@eClassifiers.4"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- 5: Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="false" interface="false">
    <eStructuralFeatures xsi-type="ecore:EAttribute"
        name="code"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <!-- containment of employees -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employees"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.4"
        containment="true"
        resolveProxies="false"/>
    <!-- head is non-containment reference to an Employee -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="head"
        lowerBound="0"
        eType="//@eClassifiers.4"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- 6: Project -->
  <eClassifiers xsi:type="ecore:EClass" name="Project" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="budget"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <!-- many-valued reference to employees, non-containment -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="team"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.4"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- 7: Company is the root, contains departments and projects -->
  <eClassifiers xsi:type="ecore:EClass" name="Company" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="legalName"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="departments"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.5"
        containment="true"
        resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="projects"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.6"
        containment="true"
        resolveProxies="false"/>
  </eClassifiers>

  <!-- 8: Utility class with operations and parameters -->
  <eClassifiers xsi:type="ecore:EClass" name="HRTool" abstract="false" interface="false">
    <eOperations name="giveRaise"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true">
      <eParameters name="who"
          lowerBound="1"
          ordered="true"
          unique="true"
          eType="//@eClassifiers.4"/>
      <eParameters name="percent"
          lowerBound="1"
          ordered="true"
          unique="true"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    </eOperations>
  </eClassifiers>

</ecore:EPackage>