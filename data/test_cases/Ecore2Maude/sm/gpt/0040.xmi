<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="libraryPkg"
    nsURI="http://example.org/libraryPkg"
    nsPrefix="lib">

  <!-- 0: Primitive data type for identifiers -->
  <eClassifiers xsi:type="ecore:EDataType" name="Identifier" instanceClassName="java.lang.String"/>

  <!-- 1: Enum for item category -->
  <eClassifiers xsi:type="eccore:EEnum" name="ItemCategory">
    <eLiterals name="BOOK" value="0" literal="BOOK"/>
    <eLiterals name="MAGAZINE" value="1" literal="MAGAZINE"/>
    <eLiterals name="DVD" value="2" literal="DVD"/>
  </eClassifiers>

  <!-- 2: Map entry for metadata -->
  <eClassifiers xsi:type="ecore:EClass" name="MetaEntry" instanceClassName="java.util.Map$Entry">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 3: Abstract base class for all items -->
  <eClassifiers xsi:type="ecore:EClass" name="Item" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="category"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="publishedYear"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="primary" iD="true"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="metadata" upperBound="-1"
        containment="true" eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 4: Book class extending Item -->
  <eClassifiers xsi:type="ecore:EClass" name="Book"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isbn" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pages"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="authors" upperBound="-1"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

  <!-- 5: Magazine class extending Item -->
  <eClassifiers xsi:type="ecore:EClass" name="Magazine"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="eccore:EAttribute" name="issueNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="monthly"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- 6: Author class -->
  <eClassifiers xsi:type="ecore:EClass" name="Author">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="email"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 7: Borrower class with operations -->
  <eClassifiers xsi:type="ecore:EClass" name="Borrower">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="borrowerId" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fullName" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="currentLoans" upperBound="-1"
        eType="//@eClassifiers.3"/>
    <eOperations name="canBorrowMore"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eOperations name="loansCount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 8: Library root class -->
  <eClassifiers xsi:type="ecore:EClass" name="Library">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="items" upperBound="-1"
        containment="true" eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="borrowers" upperBound="-1"
        containment="true" eType="//@eClassifiers.7"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mainBranch"
        eType="//@eClassifiers.9"/>
  </eClassifiers>

  <!-- 9: Branch class, referencing Library and items -->
  <eClassifiers xsi:type="ecore:EClass" name="Branch">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="location"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="library"
        eType="//@eClassifiers.8"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="featuredItems" upperBound="-1"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

</ecore:EPackage>