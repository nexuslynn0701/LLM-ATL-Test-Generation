<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyModel"
    nsURI="http://example.org/companyModel"
    nsPrefix="cmp">

  <!-- 0: Primitive-like data type -->
  <eClassifiers xsi:type="ecore:EDataType"
                name="CodeType"
                instanceClassName="java.lang.String"/>

  <!-- 1: Enum for project status -->
  <eClassifiers xsi:type="eccore:EEnum" xmlns:eccore="http://www.eclipse.org/emf/2002/Ecore" name="ProjectStatus">
    <eLiterals name="PLANNED" value="0" literal="PLANNED"/>
    <eLiterals name="ACTIVE" value="1" literal="ACTIVE"/>
    <eLiterals name="FINISHED" value="2" literal="FINISHED"/>
  </eClassifiers>

  <!-- 2: Department class -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="code"
                         lowerBound="1"
                         eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="name"
                         lowerBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="manager"
                         eType="//@eClassifiers.3"
                         lowerBound="0"
                         upperBound="1"
                         containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="employees"
                         eType="//@eClassifiers.3"
                         lowerBound="0"
                         upperBound="-1"
                         containment="true"/>
  </eClassifiers>

  <!-- 3: Employee class -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="empId"
                         lowerBound="1"
                         iD="true"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="firstName"
                         lowerBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="lastName"
                         lowerBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="department"
                         eType="//@eClassifiers.2"
                         lowerBound="0"
                         upperBound="1"
                         containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="projects"
                         eType="//@eClassifiers.4"
                         lowerBound="0"
                         upperBound="-1"
                         containment="false"/>
  </eClassifiers>

  <!-- 4: Project class -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="name"
                         lowerBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="budget"
                         lowerBound="0"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="status"
                         lowerBound="1"
                         eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="lead"
                         lowerBound="0"
                         upperBound="1"
                         eType="//@eClassifiers.3"
                         containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="team"
                         lowerBound="0"
                         upperBound="-1"
                         eType="//@eClassifiers.3"
                         containment="false"/>
  </eClassifiers>

  <!-- 5: Meeting class with operations and parameters -->
  <eClassifiers xsi:type="ecore:EClass" name="Meeting">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="topic"
                         lowerBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="durationMinutes"
                         lowerBound="0"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="participants"
                         lowerBound="0"
                         upperBound="-1"
                         eType="//@eClassifiers.3"
                         containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="relatedProject"
                         lowerBound="0"
                         upperBound="1"
                         eType="//@eClassifiers.4"
                         containment="false"/>
    <eOperations name="schedule"
                 ordered="true"
                 unique="true"
                 lowerBound="0"
                 upperBound="1">
      <eParameters name="date"
                   ordered="true"
                   unique="true"
                   lowerBound="1"
                   upperBound="1"
                   eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
      <eParameters name="room"
                   ordered="true"
                   unique="true"
                   lowerBound="0"
                   upperBound="1"
                   eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
  </eClassifiers>

  <!-- 6: Abstract base class for all entities -->
  <eClassifiers xsi:type="ecore:EClass" name="IdentifiedElement" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="uuid"
                         lowerBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 7: Class that inherits from IdentifiedElement and references many others -->
  <eClassifiers xsi:type="ecore:EClass" name="Company" eSuperTypes="//@eClassifiers.6">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="name"
                         lowerBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="departments"
                         lowerBound="0"
                         upperBound="-1"
                         containment="true"
                         eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="projects"
                         lowerBound="0"
                         upperBound="-1"
                         containment="true"
                         eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="meetings"
                         lowerBound="0"
                         upperBound="-1"
                         containment="true"
                         eType="//@eClassifiers.5"/>
  </eClassifiers>

</ecore:EPackage>