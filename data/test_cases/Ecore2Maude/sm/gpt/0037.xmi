<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="universityModel"
    nsURI="http://example.org/universityModel"
    nsPrefix="uni">

  <!-- 0: Primitive string datatype -->
  <eClassifiers xsi:type="ecore:EDataType" name="MyString" instanceClassName="java.lang.String"/>

  <!-- 1: Primitive int datatype -->
  <eClassifiers xsi:type="ecore:EDataType" name="MyInt" instanceClassName="int"/>

  <!-- 2: Enum for CourseLevel -->
  <eClassifiers xsi:type="ecore:EEnum" name="CourseLevel">
    <eLiterals name="BASIC" value="0" literal="BASIC"/>
    <eLiterals name="ADVANCED" value="1" literal="ADVANCED"/>
    <eLiterals name="SEMINAR" value="2" literal="SEMINAR"/>
  </eClassifiers>

  <!-- 3: Department class -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="professors"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="courses"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 4: Professor class -->
  <eClassifiers xsi:type="ecore:EClass" name="Professor">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="tenured"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="teaches"
        upperBound="-1"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 5: Course class -->
  <eClassifiers xsi:type="ecore:EClass" name="Course">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="credits"
        lowerBound="1"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="level"
        lowerBound="1"
        eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="students"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.6"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="prerequisites"
        upperBound="-1"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 6: Student class -->
  <eClassifiers xsi:type="ecore:EClass" name="Student">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="matriculationNumber"
        lowerBound="1"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="fullName"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- 7: Abstract Person supertype -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="email"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 8: Professor2 extending Person (to exercise eSuperTypes and multi-level) -->
  <eClassifiers xsi:type="ecore:EClass" name="ProfessorWithContact"
      eSuperTypes="//@eClassifiers.7 //@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="office"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

</ecore:EPackage>