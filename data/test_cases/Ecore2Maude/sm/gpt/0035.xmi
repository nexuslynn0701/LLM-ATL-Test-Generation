<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="universityModel"
    nsURI="http://example.org/universityModel"
    nsPrefix="uni">

  <!-- 0: Primitive alias for String (used as data type) -->
  <eClassifiers xsi:type="ecore:EDataType" name="TextType" instanceClassName="java.lang.String"/>

  <!-- 1: Enumeration for course levels -->
  <eClassifiers xsi:type="ecore:EEnum" name="CourseLevel">
    <eLiterals name="BASIC" value="0" literal="BASIC"/>
    <eLiterals name="INTERMEDIATE" value="1" literal="INTERMEDIATE"/>
    <eLiterals name="ADVANCED" value="2" literal="ADVANCED"/>
  </eClassifiers>

  <!-- 2: Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="University">
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="faculties"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="students"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

  <!-- 3: Faculty -->
  <eClassifiers xsi:type="ecore:EClass" name="Faculty">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="departments"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="dean"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

  <!-- 4: Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="courses"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="head"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

  <!-- 5: Course -->
  <eClassifiers xsi:type="ecore:EClass" name="Course">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="credits"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="level"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="prerequisites"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 6: Student -->
  <eClassifiers xsi:type="ecore:EClass" name="Student">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="fullName"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="enrolledCourses"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eType="//@eClassifiers.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="majorDepartment"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

</ecore:EPackage>