<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="university"
    nsURI="http://example.org/university0026"
    nsPrefix="uni">
  
  <!-- 0: Primitive alias type -->
  <eClassifiers xsi:type="ecore:EDataType" name="CodeType"
      instanceClassName="java.lang.String"/>

  <!-- 1: Enum for CourseLevel -->
  <eClassifiers xsi:type="ecore:EEnum" name="CourseLevel">
    <eLiterals name="BASIC" value="0" literal="BASIC"/>
    <eLiterals name="ADVANCED" value="1" literal="ADVANCED"/>
    <eLiterals name="SEMINAR" value="2" literal="SEMINAR"/>
  </eClassifiers>

  <!-- 2: Enum for Grade -->
  <eClassifiers xsi:type="ecore:EEnum" name="Grade">
    <eLiterals name="A" value="0" literal="A"/>
    <eLiterals name="B" value="1" literal="B"/>
    <eLiterals name="C" value="2" literal="C"/>
    <eLiterals name="F" value="3" literal="F"/>
  </eClassifiers>

  <!-- 3: Abstract Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 4: Student -->
  <eClassifiers xsi:type="ecore:EClass" name="Student" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="matriculationNumber" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 5: Teacher -->
  <eClassifiers xsi:type="ecore:EClass" name="Teacher" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="employeeId" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tenured"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- 6: Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- contained courses -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="courses" lowerBound="0" upperBound="-1"
        containment="true" resolveProxies="true" eType="//@eClassifiers.7"/>
    <!-- non-contained ref to teachers -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="staff" lowerBound="0" upperBound="-1"
        containment="false" resolveProxies="true" eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 7: Course -->
  <eClassifiers xsi:type="ecore:EClass" name="Course" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="credits" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="level" lowerBound="1"
        eType="//@eClassifiers.1"/>
    <!-- container: department -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="department" lowerBound="0"
        containment="false" resolveProxies="true" eType="//@eClassifiers.6"/>
    <!-- non-contained teacher -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="lecturer" lowerBound="0"
        containment="false" resolveProxies="true" eType="//@eClassifiers.5"/>
    <!-- contained enrollments -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="enrollments" lowerBound="0" upperBound="-1"
        containment="true" resolveProxies="true" eType="//@eClassifiers.8"/>
  </eClassifiers>

  <!-- 8: Enrollment -->
  <eClassifiers xsi:type="ecore:EClass" name="Enrollment" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="year" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="grade" lowerBound="0"
        eType="//@eClassifiers.2"/>
    <!-- non-contained student ref -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="student" lowerBound="1"
        containment="false" resolveProxies="true" eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 9: Program with operations and parameters -->
  <eClassifiers xsi:type="ecore:EClass" name="Program" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- reference to department that owns the program -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="homeDepartment" lowerBound="1"
        containment="false" resolveProxies="true" eType="//@eClassifiers.6"/>
    <!-- operation with parameters -->
    <eOperations name="findStudentById">
      <eParameters name="studentId"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eParameters name="activeOnly"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
      <eType eType="//@eClassifiers.4"/>
    </eOperations>
  </eClassifiers>

</ecore:EPackage>