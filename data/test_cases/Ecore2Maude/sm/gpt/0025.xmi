<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyModel"
    nsURI="http://example.com/companyModel"
    nsPrefix="cmp">

  <!-- 0: Data type for identifiers -->
  <eClassifiers xsi:type="ecore:EDataType" name="IdType" instanceClassName="java.lang.String"/>

  <!-- 1: Enum for employee roles -->
  <eClassifiers xsi:type="ecore:EEnum" name="RoleEnum">
    <eLiterals name="DEV" value="0" literal="DEV"/>
    <eLiterals name="MANAGER" value="1" literal="MANAGER"/>
    <eLiterals name="HR" value="2" literal="HR"/>
  </eClassifiers>

  <!-- 2: Enum for project status -->
  <eClassifiers xsi:type="ecore:EEnum" name="ProjectStatus">
    <eLiterals name="PLANNED" value="0" literal="PLANNED"/>
    <eLiterals name="ACTIVE" value="1" literal="ACTIVE"/>
    <eLiterals name="DONE" value="2" literal="DONE"/>
  </eClassifiers>

  <!-- 3: Map entry class for metadata -->
  <eClassifiers xsi:type="ecore:EClass" name="MetaEntry">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 4: Abstract Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 5: Department class -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- containment of employees -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees"
        upperBound="-1" containment="true"
        eType="//@eClassifiers.6"/>
    <!-- non-containment reference to a manager -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

  <!-- 6: Employee extends Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee"
      eSuperTypes="//@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="role"
        lowerBound="1"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <!-- each employee belongs to exactly one department (container) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="department"
        lowerBound="1"
        eType="//@eClassifiers.5"/>
    <!-- many-to-many projects -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="projects"
        upperBound="-1"
        eType="//@eClassifiers.7"/>
  </eClassifiers>

  <!-- 7: Project class -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="eccore:EAttribute" name="code"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="budget"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        lowerBound="1"
        eType="//@eClassifiers.2"/>
    <!-- cross-ref back to employees (not containment) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="team"
        upperBound="-1"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

  <!-- 8: Root container class Company -->
  <eClassifiers xsi:type="ecore:EClass" name="Company">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- containment of departments -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="departments"
        upperBound="-1" containment="true"
        eType="//@eClassifiers.5"/>
    <!-- containment of projects -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="projects"
        upperBound="-1" containment="true"
        eType="//@eClassifiers.7"/>
    <!-- containment of metadata entries -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="metadata"
        upperBound="-1" containment="true"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

</ecore:EPackage>