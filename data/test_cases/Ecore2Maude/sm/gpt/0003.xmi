<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyModel"
    nsURI="http://example.com/companyModel"
    nsPrefix="cmp">

  <!-- 0: EDataType for String IDs -->
  <eClassifiers xsi:type="ecore:EDataType" name="IDString" instanceClassName="java.lang.String"/>

  <!-- 1: EEnum RoleKind -->
  <eClassifiers xsi:type="ecore:EEnum" name="RoleKind">
    <eLiterals name="DEV" value="0" literal="DEV"/>
    <eLiterals name="TEST" value="1" literal="TEST"/>
    <eLiterals name="MGMT" value="2" literal="MGMT"/>
  </eClassifiers>

  <!-- 2: EClass Company -->
  <eClassifiers xsi:type="ecore:EClass" name="Company" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="departments" upperBound="-1"
        containment="true" eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="projects" upperBound="-1"
        containment="true" eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 3: EClass Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager"
        eType="//@eClassifiers.4" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees" upperBound="-1"
        containment="true" eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 4: EClass Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1"
        eType="//@eClassifiers.0" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="role"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assignedTo" upperBound="-1"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 5: EClass Project -->
  <eClassifiers xsi:type="ecore:EClass" name="Project" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identifier" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="budget"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner"
        eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="team" upperBound="-1"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 6: EClass SubDepartment extends Department -->
  <eClassifiers xsi:type="ecore:EClass" name="SubDepartment" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="speciality" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 7: EClass ExternalPerson extends Person (no ID attribute to test AtMostOneID) -->
  <eClassifiers xsi:type="ecore:EClass" name="ExternalPerson" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="companyName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 8: Map entry class -->
  <eClassifiers xsi:type="ecore:EClass" name="ConfigEntry" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>