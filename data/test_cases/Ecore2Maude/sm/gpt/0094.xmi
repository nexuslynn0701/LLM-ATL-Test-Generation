<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="libraryPkg"
    nsURI="http://example.org/libraryPkg"
    nsPrefix="lib">

  <!-- 0: EDataType for ISBN -->
  <eClassifiers xsi:type="ecore:EDataType" name="ISBN"
      instanceClassName="java.lang.String"/>

  <!-- 1: EEnum for BookCategory -->
  <eClassifiers xsi:type="ecore:EEnum" name="BookCategory">
    <eLiterals name="SCIENCE" value="0" literal="SCIENCE"/>
    <eLiterals name="NOVEL" value="1" literal="NOVEL"/>
    <eLiterals name="HISTORY" value="2" literal="HISTORY"/>
  </eClassifiers>

  <!-- 2: EClass Library -->
  <eClassifiers xsi:type="ecore:EClass" name="Library" abstract="false" interface="false">
    <!-- attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        changeable="true" volatile="false" transient="false"
        unsettable="false" derived="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        changeable="true" volatile="false" transient="false"
        unsettable="false" derived="false"/>
    <!-- containment refs -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="branches"
        upperBound="-1" containment="true" resolveProxies="true"
        eType="//@eClassifiers.3" changeable="true" volatile="false"
        transient="false" unsettable="false" derived="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mainCatalog"
        lowerBound="1" containment="true" resolveProxies="true"
        eType="//@eClassifiers.4" changeable="true" volatile="false"
        transient="false" unsettable="false" derived="false"/>
  </eClassifiers>

  <!-- 3: EClass Branch -->
  <eClassifiers xsi:type="ecore:EClass" name="Branch" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        changeable="true" volatile="false" transient="false"
        unsettable="false" derived="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="city"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        changeable="true" volatile="false" transient="false"
        unsettable="false" derived="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="catalog"
        lowerBound="0" containment="true" resolveProxies="true"
        eType="//@eClassifiers.4" changeable="true" volatile="false"
        transient="false" unsettable="false" derived="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="members"
        upperBound="-1" containment="true" resolveProxies="true"
        eType="//@eClassifiers.6" changeable="true" volatile="false"
        transient="false" unsettable="false" derived="false"/>
  </eClassifiers>

  <!-- 4: EClass Catalog -->
  <eClassifiers xsi:type="ecore:EClass" name="Catalog" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="year"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        changeable="true" volatile="false" transient="false"
        unsettable="false" derived="false"/>
    <!-- containment to Book -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="books"
        upperBound="-1" containment="true" resolveProxies="true"
        eType="//@eClassifiers.5" changeable="true" volatile="false"
        transient="false" unsettable="false" derived="false"/>
  </eClassifiers>

  <!-- 5: EClass Book -->
  <eClassifiers xsi:type="ecore:EClass" name="Book" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        changeable="true" volatile="false" transient="false"
        unsettable="false" derived="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pages"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        changeable="true" volatile="false" transient="false"
        unsettable="false" derived="false"/>
    <!-- enum-typed attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="category"
        lowerBound="0"
        eType="//@eClassifiers.1"
        changeable="true" volatile="false" transient="false"
        unsettable="false" derived="false"/>
    <!-- datatype-typed attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isbn"
        lowerBound="0"
        eType="//@eClassifiers.0"
        changeable="true" volatile="false" transient="false"
        unsettable="false" derived="false"/>
    <!-- reference to Author (non-containment, many) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="authors"
        upperBound="-1" containment="false" resolveProxies="true"
        eType="//@eClassifiers.7"
        changeable="true" volatile="false" transient="false"
        unsettable="false" derived="false"/>
  </eClassifiers>

  <!-- 6: EClass Member -->
  <eClassifiers xsi:type="ecore:EClass" name="Member" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="eccore:EAttribute" name="memberId"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        changeable="true" volatile="false" transient="false"
        unsettable="false" derived="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fullName"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        changeable="true" volatile="false" transient="false"
        unsettable="false" derived="false"/>
  </eClassifiers>

  <!-- 7: EClass Author -->
  <eClassifiers xsi:type="ecore:EClass" name="Author" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        changeable="true" volatile="false" transient="false"
        unsettable="false" derived="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="born"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        changeable="true" volatile="false" transient="false"
        unsettable="false" derived="false"/>
  </eClassifiers>

</ecore:EPackage>