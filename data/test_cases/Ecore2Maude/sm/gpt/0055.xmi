<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="model55"
    nsURI="http://example.org/model55"
    nsPrefix="m55">

  <!-- Primitive and helper data types -->
  <eClassifiers xsi:type="ecore:EDataType" name="StringAlias" instanceClassName="java.lang.String"/>
  <eClassifiers xsi:type="ecore:EDataType" name="IntAlias" instanceClassName="int"/>
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="IN_PROGRESS" value="1" literal="IN_PROGRESS"/>
    <eLiterals name="DONE" value="2" literal="DONE"/>
  </eClassifiers>

  <!-- Abstract base class with an ID attribute and an enum-typed attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="Element" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" lowerBound="0"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- Concrete node class with attributes and multiple references -->
  <eClassifiers xsi:type="ecore:EClass" name="Node" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="weight" lowerBound="0"
        eType="//@eClassifiers.1"/>
    <!-- Containment reference to edges where this node is the source -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="outgoing" upperBound="-1"
        eType="//@eClassifiers.5" containment="true" resolveProxies="false"/>
    <!-- Non-containment reference to edges where this node is the target -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="incoming" upperBound="-1"
        eType="//@eClassifiers.5" containment="false" resolveProxies="true"/>
    <!-- Cross reference to arbitrary nodes (neighbors) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="neighbors" upperBound="-1"
        eType="//@eClassifiers.4" containment="false" resolveProxies="true"/>
  </eClassifiers>

  <!-- Edge class linking nodes, contained by its source node -->
  <eClassifiers xsi:type="ecore:EClass" name="Edge" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi-type="ecore:EAttribute" xsi:nil="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" lowerBound="0"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" lowerBound="1"
        eType="//@eClassifiers.4" containment="false" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" lowerBound="1"
        eType="//@eClassifiers.4" containment="false" resolveProxies="true"/>
  </eClassifiers>

  <!-- Container class for the graph with multiple containments -->
  <eClassifiers xsi:type="ecore:EClass" name="Graph" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="nodes" upperBound="-1"
        eType="//@eClassifiers.4" containment="true" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="isolatedNodes" upperBound="-1"
        eType="//@eClassifiers.4" containment="true" resolveProxies="false"/>
  </eClassifiers>

  <!-- Interface type to test interface/abstract combination -->
  <eClassifiers xsi:type="ecore:EClass" name="Named" abstract="true" interface="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="displayName" lowerBound="0"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- Class implementing the interface, separate from Element hierarchy -->
  <eClassifiers xsi:type="ecore:EClass" name="Annotation" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.7">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>