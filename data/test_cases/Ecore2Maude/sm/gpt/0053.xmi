<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyModel"
    nsURI="http://example.org/companyModel"
    nsPrefix="cmp">

  <!-- 0: Primitive alias for string -->
  <eClassifiers xsi:type="ecore:EDataType" name="AliasString"/>

  <!-- 1: Enum for employee roles -->
  <eClassifiers xsi:type="ecore:EEnum" name="RoleKind">
    <eLiterals name="DEVELOPER" value="0" literal="DEV"/>
    <eLiterals name="MANAGER" value="1" literal="MGR"/>
  </eClassifiers>

  <!-- 2: Abstract Person super class -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 3: Employee subclass -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="false" interface="false" eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="salary"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="role"
        lowerBound="1"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="department"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.4"
        containment="false"
        resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="manager"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.3"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- 4: Department with opposite reference to employees -->
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employees"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.3"
        containment="true"
        resolveProxies="false">
      <eOpposite href="//@eClassifiers.3/@eStructuralFeatures.2"/>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- 5: Project with bidirectional reference to Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Project" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="projectId"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="budget"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="mainDepartment"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.4"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- 6: Utility class with operations and parameters -->
  <eClassifiers xsi:type="ecore:EClass" name="HRService" abstract="false" interface="false">
    <eOperations name="increaseSalary"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1">
      <eParameters name="target"
          ordered="true"
          unique="true"
          lowerBound="1"
          upperBound="1"
          eType="//@eClassifiers.3"/>
      <eParameters name="delta"
          ordered="true"
          unique="true"
          lowerBound="1"
          upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eExceptions href="//@eClassifiers.3"/>
    </eOperations>
    <eOperations name="findDepartment"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.4">
      <eParameters name="code"
          ordered="true"
          unique="true"
          lowerBound="1"
          upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
  </eClassifiers>

  <!-- 7: Map entry class -->
  <eClassifiers xsi:type="ecore:EClass" name="StringToIntMapEntry" interface="false" abstract="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="key"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="value"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

</ecore:EPackage>