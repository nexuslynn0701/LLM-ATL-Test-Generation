<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="universityModel"
    nsURI="http://example.org/universityModel"
    nsPrefix="uni">

  <!-- Classifier 0: Primitive-like data type for codes -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="CodeType"
      instanceClassName="java.lang.String"
      serializable="true"/>

  <!-- Classifier 1: Enum for CourseLevel -->
  <eClassifiers xsi:type="ecore:EEnum" name="CourseLevel">
    <eLiterals name="BASIC" value="0" literal="BASIC"/>
    <eLiterals name="INTERMEDIATE" value="1" literal="INTERMEDIATE"/>
    <eLiterals name="ADVANCED" value="2" literal="ADVANCED"/>
  </eClassifiers>

  <!-- Classifier 2: Address -->
  <eClassifiers xsi:type="ecore:EClass" name="Address" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="city"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="zipCode"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- Classifier 3: Person (abstract super type) -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="fullName"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="primaryAddress"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- Classifier 4: Student -->
  <eClassifiers xsi:type="ecore:EClass"
      name="Student"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="matriculationNumber"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- Classifier 5: Professor -->
  <eClassifiers xsi:type="ecore:EClass"
      name="Professor"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Classifier 6: Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="deptCode"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="deptName"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Containment of Professors -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="professors"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.5"/>
    <!-- Containment of Students -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="students"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- Classifier 7: Course -->
  <eClassifiers xsi:type="ecore:EClass" name="Course" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="courseCode"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="level"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.1"/>
    <!-- Non-containment reference to Department -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="offeredBy"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

  <!-- Classifier 8: Enrollment (map-entry-like helper class with attribute key/value) -->
  <eClassifiers xsi:type="ecore:EClass" name="Enrollment" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="year"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Cross references to Student and Course -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="student"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="course"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.7"/>
  </eClassifiers>

  <!-- Classifier 9: University (root container) -->
  <eClassifiers xsi:type="ecore:EClass" name="University" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Containment of Departments -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="departments"
        lowerBound="1"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.6"/>
    <!-- Containment of Courses -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="courses"
        lowerBound="1"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.7"/>
    <!-- Containment of Enrollments -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="enrollments"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.8"/>
  </eClassifiers>

  <!-- Instance model inside the same resource using containment trees -->

  <!-- Root University instance (as an EClass instance) -->
  <eSubpackages name="instances" nsURI="http://example.org/universityModel/instances" nsPrefix="uniinst">
    <!-- Place the root University instance as a classifier-like container host is not usual,
         but we avoid additional metamodel elements; instances will be represented
         via nested containment from this synthetic package root. -->
  </eSubpackages>

</ecore:EPackage>