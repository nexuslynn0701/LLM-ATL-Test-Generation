<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="universityModel"
    nsURI="http://example.org/universityModel"
    nsPrefix="uni">

  <!-- 0: Primitive-like data type -->
  <eClassifiers xsi:type="ecore:EDataType" name="CodeType" instanceClassName="java.lang.String"/>

  <!-- 1: Simple enum -->
  <eClassifiers xsi:type="ecore:EEnum" name="Grade">
    <eLiterals name="A" value="0" literal="A"/>
    <eLiterals name="B" value="1" literal="B"/>
    <eLiterals name="C" value="2" literal="C"/>
    <eLiterals name="D" value="3" literal="D"/>
  </eClassifiers>

  <!-- 2: Abstract base class with attribute and containment, supertype for Person, Course, Department -->
  <eClassifiers xsi:type="ecore:EClass" name="EntityBase" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tags" upperBound="-1" containment="true"
        eType="#//EStringToStringMapEntry"/>
  </eClassifiers>

  <!-- 3: Person class with ID attribute and reference to Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="idNumber" iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fullName" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="department" lowerBound="1"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 4: Course class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="Course" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="credits"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="3"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mainTeacher" lowerBound="1"
        eType="//@eClassifiers.6"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="enrollments" upperBound="-1" containment="true"
        eType="//@eClassifiers.8"/>
  </eClassifiers>

  <!-- 5: Department class with containment of courses and staff -->
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="courses" upperBound="-1" containment="true"
        eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="staff" upperBound="-1" containment="true"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

  <!-- 6: Teacher class, subtype of Person, with operation -->
  <eClassifiers xsi:type="ecore:EClass" name="Teacher" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="office"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="supervisedCourses" upperBound="-1"
        eType="//@eClassifiers.4"/>
    <eOperations name="computeLoad">
      <eParameters name="semester"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eParameters name="includeThesis"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    </eOperations>
  </eClassifiers>

  <!-- 7: Student class, subtype of Person, with references to courses -->
  <eClassifiers xsi:type="ecore:EClass" name="Student" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="enrollmentYear"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="currentCourses" upperBound="-1"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 8: Enrollment class with enum attribute, references to Student and Course -->
  <eClassifiers xsi:type="ecore:EClass" name="Enrollment" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="year"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="grade"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="student" lowerBound="1"
        eType="//@eClassifiers.7"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="course" lowerBound="1"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

</ecore:EPackage>