<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:ecore="http://ecore"
  name="complexPkg"
  nsURI="http://example.org/complexPkg"
  nsPrefix="cpx">

  <!-- 0: Primitive/data types used by the package -->
  <eClassifiers xsi:type="ecore:EDataType"
    name="StringAlias"
    instanceClassName="java.lang.String"/>
  <eClassifiers xsi:type="ecore:EDataType"
    name="IntAlias"
    instanceClassName="int"/>

  <!-- 2: Base abstract class -->
  <eClassifiers xsi:type="ecore:EClass"
    name="Element"
    abstract="true"
    interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
      name="id"
      lowerBound="1"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
      iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
      name="label"
      lowerBound="0"
      eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 3: Node class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass"
    name="Node"
    abstract="false"
    interface="false"
    eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
      name="priority"
      lowerBound="0"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Container reference to Graph -->
    <eStructuralFeatures xsi:type="ecore:EReference"
      name="owner"
      lowerBound="0"
      upperBound="1"
      eType="//@eClassifiers.6"
      containment="false"
      resolveProxies="true"/>
  </eClassifiers>

  <!-- 4: Edge class with container and non-container refs -->
  <eClassifiers xsi:type="ecore:EClass"
    name="Edge"
    abstract="false"
    interface="false"
    eSuperTypes="//@eClassifiers.2">
    <!-- container: edges are contained in Graph -->
    <eStructuralFeatures xsi:type="ecore:EReference"
      name="graph"
      lowerBound="0"
      upperBound="1"
      eType="//@eClassifiers.6"
      containment="false"
      resolveProxies="true"/>
    <!-- non-containment references to nodes -->
    <eStructuralFeatures xsi:type="ecore:EReference"
      name="source"
      lowerBound="1"
      upperBound="1"
      eType="//@eClassifiers.3"
      containment="false"
      resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
      name="target"
      lowerBound="1"
      upperBound="1"
      eType="//@eClassifiers.3"
      containment="false"
      resolveProxies="true"/>
  </eClassifiers>

  <!-- 5: Specialized node type -->
  <eClassifiers xsi:type="ecore:EClass"
    name="SpecialNode"
    abstract="false"
    interface="false"
    eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
      name="flag"
      lowerBound="0"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- 6: Root Graph class that contains nodes and edges -->
  <eClassifiers xsi:type="ecore:EClass"
    name="Graph"
    abstract="false"
    interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
      name="name"
      lowerBound="1"
      eType="//@eClassifiers.0"/>
    <!-- containment of nodes -->
    <eStructuralFeatures xsi:type="ecore:EReference"
      name="nodes"
      lowerBound="0"
      upperBound="-1"
      eType="//@eClassifiers.3"
      containment="true"
      resolveProxies="false"/>
    <!-- containment of edges -->
    <eStructuralFeatures xsi:type="ecore:EReference"
      name="edges"
      lowerBound="0"
      upperBound="-1"
      eType="//@eClassifiers.4"
      containment="true"
      resolveProxies="false"/>
  </eClassifiers>

</ecore:EPackage>