<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyModel"
    nsURI="http://sample/companyModel"
    nsPrefix="cmp">

  <!-- 0: Primitive alias: String -->
  <eClassifiers xsi:type="ecore:EDataType" name="StringAlias" instanceClassName="java.lang.String"/>

  <!-- 1: Primitive alias: Integer -->
  <eClassifiers xsi:type="ecore:EDataType" name="IntAlias" instanceClassName="int"/>

  <!-- 2: Enum with literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="EmploymentType">
    <eLiterals name="FULL_TIME" value="0" literal="FULL_TIME"/>
    <eLiterals name="PART_TIME" value="1" literal="PART_TIME"/>
    <eLiterals name="CONTRACTOR" value="2" literal="CONTRACTOR"/>
  </eClassifiers>

  <!-- 3: Abstract base class Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true" interface="false">
    <!-- id attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1"
        eType="//@eClassifiers.1" iD="true"/>
    <!-- optional birthDate -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="birthDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <!-- name attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 4: Department class -->
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 5: Concrete Employee class extending Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.3">
    <!-- salary attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <!-- enum-typed attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="employmentType" lowerBound="1"
        eType="//@eClassifiers.2"/>
    <!-- reference to Department (non-containment, many) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="department" upperBound="-1"
        eType="//@eClassifiers.4" containment="false" resolveProxies="true"/>
  </eClassifiers>

  <!-- 6: Interface-syle EClass Project (interface=true, abstract=true) -->
  <eClassifiers xsi:type="ecore:EClass" name="Project" abstract="true" interface="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" lowerBound="1"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 7: Concrete implementation of Project with containment and references -->
  <eClassifiers xsi:type="ecore:EClass" name="ClientProject" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.6">
    <!-- non-ID attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="budget"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <!-- containment reference to nested tasks -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="tasks" upperBound="-1"
        eType="//@eClassifiers.8" containment="true" resolveProxies="false"/>
    <!-- reference back to responsible Employee -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="responsible"
        eType="//@eClassifiers.5" containment="false" resolveProxies="true"/>
  </eClassifiers>

  <!-- 8: Task class used as containment child -->
  <eClassifiers xsi:type="ecore:EClass" name="Task" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="estimateHours"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 9: Utility map-entry class -->
  <eClassifiers xsi:type="ecore:EClass" name="PropertyEntry" abstract="false" interface="false"
      eSuperTypes="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EStringToStringMapEntry">
    <!-- no extra features; inherits key/value -->
  </eClassifiers>

  <!-- 10: Root container class Company -->
  <eClassifiers xsi:type="ecore:EClass" name="Company" abstract="false" interface="false">
    <!-- company name -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <!-- containment of departments -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="departments" upperBound="-1"
        eType="//@eClassifiers.4" containment="true" resolveProxies="false"/>
    <!-- containment of employees -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees" upperBound="-1"
        eType="//@eClassifiers.5" containment="true" resolveProxies="false"/>
    <!-- containment of projects -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="projects" upperBound="-1"
        eType="//@eClassifiers.7" containment="true" resolveProxies="false"/>
    <!-- map-like configuration properties -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="configEntries" upperBound="-1"
        eType="//@eClassifiers.9" containment="true" resolveProxies="false"/>
  </eClassifiers>

</ecore:EPackage>