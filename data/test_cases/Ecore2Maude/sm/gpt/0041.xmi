<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="universityPkg"
    nsURI="http://example.org/universityPkg"
    nsPrefix="uni">

  <!-- 0: Primitive data types used by the package -->
  <eClassifiers xsi:type="ecore:EDataType" name="CodeString" instanceClassName="java.lang.String"/>
  <eClassifiers xsi:type="ecore:EDataType" name="CreditsInt" instanceClassName="int"/>

  <!-- 2: Abstract Person supertype -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fullName" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 3: Concrete Student extending Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Student" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="matriculationNumber" lowerBound="1"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 4: Concrete Professor extending Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Professor" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 5: Course with attributes and a container ref to Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Course" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="credits" lowerBound="1"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="department" lowerBound="1"
        eType="//@eClassifiers.7" containment="false" resolveProxies="true"/>
  </eClassifiers>

  <!-- 6: Enrollment linking Student and Course, with enum-typed grade -->
  <eClassifiers xsi:type="ecore:EClass" name="Enrollment" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EReference" name="student" lowerBound="1"
        eType="//@eClassifiers.3" containment="false" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="course" lowerBound="1"
        eType="//@eClassifiers.5" containment="false" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="grade" lowerBound="0"
        eType="//@eClassifiers.8"/>
  </eClassifiers>

  <!-- 7: Department containing Courses and Enrollment records, references to staff and students -->
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deptCode" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="courses" upperBound="-1"
        eType="//@eClassifiers.5" containment="true" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="enrollments" upperBound="-1"
        eType="//@eClassifiers.6" containment="true" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="staff" upperBound="-1"
        eType="//@eClassifiers.4" containment="false" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="students" upperBound="-1"
        eType="//@eClassifiers.3" containment="false" resolveProxies="true"/>
  </eClassifiers>

  <!-- 8: Enum for Grade -->
  <eClassifiers xsi:type="ecore:EEnum" name="Grade">
    <eLiterals name="A" value="0" literal="A"/>
    <eLiterals name="B" value="1" literal="B"/>
    <eLiterals name="C" value="2" literal="C"/>
    <eLiterals name="F" value="3" literal="F"/>
  </eClassifiers>

  <!-- 9: Root model class University containing Departments and people -->
  <eClassifiers xsi:type="ecore:EClass" name="University" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="universityName" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="departments" upperBound="-1"
        eType="//@eClassifiers.7" containment="true" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="allStudents" upperBound="-1"
        eType="//@eClassifiers.3" containment="true" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="allProfessors" upperBound="-1"
        eType="//@eClassifiers.4" containment="true" resolveProxies="true"/>
  </eClassifiers>

</ecore:EPackage>