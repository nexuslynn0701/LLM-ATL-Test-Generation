<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyModel"
    nsURI="http://example.org/companyModel"
    nsPrefix="company">

  <!-- 0: Root abstract NamedElement -->
  <eClassifiers xsi:type="ecore:EClass" name="NamedElement" abstract="true" interface="false"/>

  <!-- 1: Person hierarchy root -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="identifier"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 2: Employee (concrete) extends Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="salary"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="manager"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"
        containment="false"
        resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="projects"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.5"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- 3: Contractor extends Person (no containment, only references) -->
  <eClassifiers xsi:type="ecore:EClass" name="Contractor" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="hourlyRate"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="assignedDepartment"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.4"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- 4: Department with containment of employees and contractors -->
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employees"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.2"
        containment="true"
        resolveProxies="false"/>
    <eStructuralFeatures xsi:type="eccore:EReference"
        xsi:type="ecore:EReference"
        name="contractors"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.3"
        containment="true"
        resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="head"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- 5: Project with containment of tasks and bidirectional ref to employees -->
  <eClassifiers xsi:type="ecore:EClass" name="Project" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="budget"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="tasks"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.6"
        containment="true"
        resolveProxies="false"/>
  </eClassifiers>

  <!-- 6: Task with reference back to Project (non-containment) -->
  <eClassifiers xsi:type="ecore:EClass" name="Task" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="completed"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="project"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.5"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- 7: Address as a simple value object with attributes only -->
  <eClassifiers xsi:type="ecore:EClass" name="Address" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="city"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="zipCode"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 8: Company root, contains departments and projects -->
  <eClassifiers xsi:type="ecore:EClass" name="Company" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="legalName"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="departments"
        lowerBound="1"
        upperBound="-1"
        eType="//@eClassifiers.4"
        containment="true"
        resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="projects"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.5"
        containment="true"
        resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="registeredAddress"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.7"
        containment="true"
        resolveProxies="false"/>
  </eClassifiers>

</ecore:EPackage>