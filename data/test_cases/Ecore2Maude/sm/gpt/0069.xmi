<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="libraryModel"
    nsURI="http://example.org/libraryModel0069"
    nsPrefix="lib69">

  <!-- 0: Enum for status -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="USED" value="1" literal="USED"/>
    <eLiterals name="DAMAGED" value="2" literal="DAMAGED"/>
  </eClassifiers>

  <!-- 1: Data type for custom identifier -->
  <eClassifiers xsi:type="ecore:EDataType" name="IdentifierType" instanceClassName="java.lang.String"/>

  <!-- 2: Root EClass Library -->
  <eClassifiers xsi:type="ecore:EClass" name="Library" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        lowerBound="1" upperBound="1"
        eType="//@eClassifiers.1"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"
        lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="books"
        lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.3"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="members"
        lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.4"
        containment="true"/>
  </eClassifiers>

  <!-- 3: EClass Book -->
  <eClassifiers xsi:type="ecore:EClass" name="Book" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isbn"
        lowerBound="1" upperBound="1"
        eType="//@eClassifiers.1"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pages"
        lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        lowerBound="0" upperBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="primaryAuthor"
        lowerBound="0" upperBound="1"
        eType="//@eClassifiers.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="coAuthors"
        lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="borrowedBy"
        lowerBound="0" upperBound="1"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 4: EClass Member -->
  <eClassifiers xsi:type="ecore:EClass" name="Member" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memberId"
        lowerBound="1" upperBound="1"
        eType="//@eClassifiers.1"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fullName"
        lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="borrowedBooks"
        lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- 5: EClass Person (super of Author and Staff) -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id"
        lowerBound="1" upperBound="1"
        eType="//@eClassifiers.1"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 6: EClass Author -->
  <eClassifiers xsi:type="ecore:EClass" name="Author" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.5">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="penName"
        lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="writtenBooks"
        lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- 7: EClass Staff -->
  <eClassifiers xsi:type="ecore:EClass" name="Staff" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.5">
    <eStructuralFeatures xsi:type="eccore:EAttribute" name="role"
        lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>