<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="universityModel"
    nsURI="http://example.org/universityModel0044"
    nsPrefix="uni">

  <!-- 0: Primitive-like data type for identifiers -->
  <eClassifiers xsi:type="ecore:EDataType" name="Identifier" instanceClassName="java.lang.String"/>

  <!-- 1: Primitive-like data type for grade values -->
  <eClassifiers xsi:type="ecore:EDataType" name="GradeValue" instanceClassName="int"/>

  <!-- 2: Enumeration for course levels -->
  <eClassifiers xsi:type="ecore:EEnum" name="CourseLevel">
    <eLiterals name="BASIC" value="0" literal="BASIC"/>
    <eLiterals name="INTERMEDIATE" value="1" literal="INTERMEDIATE"/>
    <eLiterals name="ADVANCED" value="2" literal="ADVANCED"/>
  </eClassifiers>

  <!-- 3: Enumeration for semester -->
  <eClassifiers xsi:type="ecore:EEnum" name="SemesterKind">
    <eLiterals name="FALL" value="0" literal="FALL"/>
    <eLiterals name="SPRING" value="1" literal="SPRING"/>
    <eLiterals name="SUMMER" value="2" literal="SUMMER"/>
  </eClassifiers>

  <!-- 4: Abstract Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="identifier"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="fullName"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 5: Student -->
  <eClassifiers xsi:type="ecore:EClass" name="Student" abstract="false" interface="false" eSuperTypes="//@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="enrollmentYear"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 6: Professor -->
  <eClassifiers xsi:type="ecore:EClass" name="Professor" abstract="false" interface="false" eSuperTypes="//@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 7: Course -->
  <eClassifiers xsi:type="ecore:EClass" name="Course" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="credits"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="level"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 8: Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="deptCode"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="courses"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.7"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="staff"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

  <!-- 9: Grade -->
  <eClassifiers xsi:type="ecore:EClass" name="Grade" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="numericValue"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 10: Enrollment -->
  <eClassifiers xsi:type="ecore:EClass" name="Enrollment" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="semester"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="course"
        lowerBound="1"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.7"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="grade"
        lowerBound="0"
        upperBound="1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.9"/>
  </eClassifiers>

  <!-- 11: Program -->
  <eClassifiers xsi:type="ecore:EClass" name="Program" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="programCode"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="coreCourses"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.7"/>
  </eClassifiers>

  <!-- 12: University (root) -->
  <eClassifiers xsi:type="ecore:EClass" name="University" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="departments"
        lowerBound="1"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.8"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="students"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="programs"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.11"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="enrollments"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.10"/>
  </eClassifiers>

</ecore:EPackage>