<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="libraryPkg"
    nsURI="http://example.org/libraryPkg"
    nsPrefix="lib">

  <!-- 0: Simple ID data type -->
  <eClassifiers xsi:type="ecore:EDataType" name="Identifier" instanceClassName="java.lang.String"/>

  <!-- 1: Publication base class -->
  <eClassifiers xsi:type="ecore:EClass" name="Publication" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="pubId"
        lowerBound="1"
        eType="//@eClassifiers.0"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="year"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 2: Book class extending Publication -->
  <eClassifiers xsi:type="ecore:EClass" name="Book" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="isbn"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="authors"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 3: Journal class extending Publication -->
  <eClassifiers xsi:type="ecore:EClass" name="Journal" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="impactFactor"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- 4: Author class -->
  <eClassifiers xsi:type="ecore:EClass" name="Author" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="email"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 5: Library root class, with containment of publications and map entries -->
  <eClassifiers xsi:type="ecore:EClass" name="Library" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="publications"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="settings"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

  <!-- 6: Map entry type -->
  <eClassifiers xsi:type="ecore:EClass" name="ConfigEntry" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="key"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 7: BorrowRecord refers to Publication -->
  <eClassifiers xsi:type="ecore:EClass" name="BorrowRecord" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="borrower"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="days"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="item"
        lowerBound="1"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

</ecore:EPackage>