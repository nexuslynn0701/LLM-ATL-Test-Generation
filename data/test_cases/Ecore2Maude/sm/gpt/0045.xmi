<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="workflowPkg"
    nsURI="http://example.org/workflow"
    nsPrefix="wf">

  <!-- 0: Abstract root element -->
  <eClassifiers xsi:type="ecore:EClass" name="WorkflowElement" abstract="true" interface="false"/>

  <!-- 1: Concrete Task with attributes and a containment reference to Parameter -->
  <eClassifiers xsi:type="ecore:EClass" name="Task" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priority"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parameters" upperBound="-1"
        containment="true" resolveProxies="false"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 2: Specialized ReviewTask extending Task -->
  <eClassifiers xsi:type="ecore:EClass" name="ReviewTask" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="requiredApprovals" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 3: Specialized ManualTask extending Task -->
  <eClassifiers xsi:type="ecore:EClass" name="ManualTask" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="estimatedTime"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 4: Parameter class used as containment target -->
  <eClassifiers xsi:type="ecore:EClass" name="Parameter" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 5: Transition connecting WorkflowElements -->
  <eClassifiers xsi:type="ecore:EClass" name="Transition" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" lowerBound="1"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 6: Workflow container with containments and references -->
  <eClassifiers xsi:type="ecore:EClass" name="Workflow" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="elements" upperBound="-1"
        containment="true" resolveProxies="false"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="eccore:EReference" name="transitions" upperBound="-1"
        containment="true" resolveProxies="false"
        eType="//@eClassifiers.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="start" lowerBound="1"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 7: Status enum with literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="IN_PROGRESS" value="1" literal="IN_PROGRESS"/>
    <eLiterals name="DONE" value="2" literal="DONE"/>
  </eClassifiers>

  <!-- 8: AuditEntry class with enum-typed attribute and operation -->
  <eClassifiers xsi:type="ecore:EClass" name="AuditEntry" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timestamp" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="//@eClassifiers.7"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="relatedElement"
        eType="//@eClassifiers.0"/>
    <eOperations name="formatMessage">
      <eParameters name="prefix"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eParameters name="suffix"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eType eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
  </eClassifiers>

</ecore:EPackage>