<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="universityModel"
    nsURI="http://example.org/universityModel"
    nsPrefix="uni">

  <!-- 0: Primitive alias -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="CodeString"
      instanceClassName="java.lang.String"/>

  <!-- 1: Enumeration with multiple literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Grade">
    <eLiterals name="A" value="0" literal="A"/>
    <eLiterals name="B" value="1" literal="B"/>
    <eLiterals name="C" value="2" literal="C"/>
  </eClassifiers>

  <!-- 2: Base abstract interface class -->
  <eClassifiers xsi:type="ecore:EClass"
      name="Identifiable"
      abstract="true"
      interface="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 3: Concrete class Person extends Identifiable -->
  <eClassifiers xsi:type="ecore:EClass"
      name="Person"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 4: Student extends Person, adds attributes and refs -->
  <eClassifiers xsi:type="ecore:EClass"
      name="Student"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="matriculationNumber"
        lowerBound="1"
        eType="//@eClassifiers.0"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="currentGPA"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <!-- non-containment reference to enrolled courses -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="enrolledCourses"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.6"/>
    <!-- container reference to Department (single container) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="department"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 5: Department extends Identifiable, contains students and courses -->
  <eClassifiers xsi:type="ecore:EClass"
      name="Department"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="students"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="courses"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

  <!-- 6: Course extends Identifiable and contains enrollments -->
  <eClassifiers xsi:type="ecore:EClass"
      name="Course"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="credits"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- bidirectional non-containment with Student via Enrolment is avoided to keep SingleContainer -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="enrollments"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.7"/>
  </eClassifiers>

  <!-- 7: Enrollment contains a reference to Student and Course and uses Grade enum -->
  <eClassifiers xsi:type="ecore:EClass"
      name="Enrollment"
      abstract="false"
      interface="false">
    <!-- reference to Student (non-containment) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="student"
        lowerBound="1"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.4"/>
    <!-- reference to Course (container is Course.enrollments) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="course"
        lowerBound="1"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.6"/>
    <!-- attribute typed by Grade enum -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="finalGrade"
        lowerBound="0"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 8: Utility class with operations and parameters -->
  <eClassifiers xsi:type="ecore:EClass"
      name="StatisticsService"
      abstract="false"
      interface="false">
    <!-- Operation: double calculateAverageAge(dept : Department) throws EClassifier Department -->
    <eOperations name="calculateAverageAge">
      <eParameters name="dept" eType="//@eClassifiers.5"/>
      <eExceptions eType="//@eClassifiers.5"/>
      <eType eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    </eOperations>
    <!-- Operation: int countEnrollments(course : Course) -->
    <eOperations name="countEnrollments">
      <eParameters name="course" eType="//@eClassifiers.6"/>
      <eType eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eOperations>
  </eClassifiers>

  <!-- 9: Map-like entry class for annotations -->
  <eClassifiers xsi:type="ecore:EClass"
      name="MetaInfoEntry"
      abstract="false"
      interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="key"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="value"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>