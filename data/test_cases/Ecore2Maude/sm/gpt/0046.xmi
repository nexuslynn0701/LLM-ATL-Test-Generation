<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="libraryPkg"
    nsURI="http://example.org/libraryPkg"
    nsPrefix="lib">

  <!-- 0: Primitive-like data type -->
  <eClassifiers xsi:type="ecore:EDataType"
                name="ISBN"
                instanceClassName="java.lang.String"
                serializable="true"/>

  <!-- 1: Enum for BookCategory -->
  <eClassifiers xsi:type="ecore:EEnum" name="BookCategory">
    <eLiterals name="SCIENCE" value="0" literal="SCIENCE"/>
    <eLiterals name="ART" value="1" literal="ART"/>
    <eLiterals name="HISTORY" value="2" literal="HISTORY"/>
  </eClassifiers>

  <!-- 2: Root container class Library -->
  <eClassifiers xsi:type="ecore:EClass" name="Library" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="name"
                         lowerBound="1"
                         upperBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Containment of books -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="books"
                         lowerBound="0"
                         upperBound="-1"
                         containment="true"
                         resolveProxies="true"
                         eType="//@eClassifiers.3"/>
    <!-- Containment of members -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="members"
                         lowerBound="0"
                         upperBound="-1"
                         containment="true"
                         resolveProxies="true"
                         eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 3: Class Book -->
  <eClassifiers xsi:type="ecore:EClass" name="Book" abstract="false" interface="false">
    <!-- ID attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="id"
                         iD="true"
                         lowerBound="1"
                         upperBound="1"
                         eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="title"
                         lowerBound="1"
                         upperBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="pages"
                         lowerBound="0"
                         upperBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Enum-typed attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="category"
                         lowerBound="0"
                         upperBound="1"
                         eType="//@eClassifiers.1"/>
    <!-- Reference to owning member (non-containment, opposite set in Member) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="borrowedBy"
                         lowerBound="0"
                         upperBound="1"
                         containment="false"
                         resolveProxies="true"
                         eType="//@eClassifiers.4"
                         eOpposite="//@eClassifiers.4/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- 4: Class Member -->
  <eClassifiers xsi:type="ecore:EClass" name="Member" abstract="false" interface="false">
    <eStructuralFeatures xsi-type="ecore:EAttribute"
                         name="memberId"
                         iD="false"
                         lowerBound="1"
                         upperBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="fullName"
                         lowerBound="1"
                         upperBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Opposite reference: books borrowed -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="borrowedBooks"
                         lowerBound="0"
                         upperBound="-1"
                         containment="false"
                         resolveProxies="true"
                         eType="//@eClassifiers.3"
                         eOpposite="//@eClassifiers.3/@eStructuralFeatures.4"/>
  </eClassifiers>

  <!-- 5: Abstract superclass for staff -->
  <eClassifiers xsi:type="ecore:EClass" name="Staff" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="code"
                         lowerBound="1"
                         upperBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 6: Concrete subclass Librarian -->
  <eClassifiers xsi:type="ecore:EClass" name="Librarian" abstract="false" interface="false"
                eSuperTypes="//@eClassifiers.5">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="desk"
                         lowerBound="0"
                         upperBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 7: Operation-using class with parameters and exceptions -->
  <eClassifiers xsi:type="ecore:EClass" name="LoanService" abstract="false" interface="true">
    <eOperations name="createLoan"
                 lowerBound="0"
                 upperBound="1"
                 eType="//@eClassifiers.3">
      <eParameters name="member" lowerBound="1" upperBound="1" eType="//@eClassifiers.4"/>
      <eParameters name="book" lowerBound="1" upperBound="1" eType="//@eClassifiers.3"/>
      <!-- exception classifier: reuse EStringToStringMapEntry as a dummy checked type -->
      <eExceptions href="//@eClassifiers.8"/>
    </eOperations>
    <eOperations name="returnLoan"
                 lowerBound="0"
                 upperBound="1"
                 eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eParameters name="book" lowerBound="1" upperBound="1" eType="//@eClassifiers.3"/>
    </eOperations>
  </eClassifiers>

  <!-- 8: Map entry class (already present in metamodel, used above as exception type) -->
  <eClassifiers xsi:type="ecore:EClass" name="MetaInfoEntry" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="key"
                         lowerBound="1"
                         upperBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="value"
                         lowerBound="0"
                         upperBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 9: Subpackage to exercise eSubpackages / eSuperPackage -->
  <eSubpackages name="statisticsPkg"
                nsURI="http://example.org/libraryPkg/statistics"
                nsPrefix="libstats">
    <eClassifiers xsi:type="ecore:EClass" name="UsageStats" abstract="false" interface="false">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="totalLoans"
                           lowerBound="0"
                           upperBound="1"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="lastUpdated"
                           lowerBound="0"
                           upperBound="1"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>