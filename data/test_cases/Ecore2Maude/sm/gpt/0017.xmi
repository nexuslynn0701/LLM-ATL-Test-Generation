<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyModel"
    nsURI="http://sample/companyModel"
    nsPrefix="cmp">

  <!-- 0: EDataType for String IDs -->
  <eClassifiers xsi:type="ecore:EDataType" name="IDString" instanceClassName="java.lang.String"/>

  <!-- 1: EEnum Role -->
  <eClassifiers xsi:type="ecore:EEnum" name="RoleEnum">
    <eLiterals name="DEV" value="0" literal="DEV"/>
    <eLiterals name="TESTER" value="1" literal="TESTER"/>
    <eLiterals name="MANAGER" value="2" literal="MANAGER"/>
  </eClassifiers>

  <!-- 2: Base named element -->
  <eClassifiers xsi:type="ecore:EClass" name="NamedElement" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        ordered="true" unique="true" lowerBound="1" upperBound="1"/>
  </eClassifiers>

  <!-- 3: Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EReference" name="teams"
        eType="//@eClassifiers.4"
        containment="true" upperBound="-1" ordered="true" unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="head"
        eType="//@eClassifiers.5"
        containment="false" upperBound="1" ordered="true" unique="true"/>
  </eClassifiers>

  <!-- 4: Team -->
  <eClassifiers xsi:type="ecore:EClass" name="Team" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        eType="//@eClassifiers.0"
        iD="false" ordered="true" unique="true" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="members"
        eType="//@eClassifiers.5"
        containment="true" upperBound="-1" ordered="true" unique="true"/>
  </eClassifiers>

  <!-- 5: Employee -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="empId"
        eType="//@eClassifiers.0"
        iD="true" ordered="true" unique="true" lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        ordered="true" unique="true" lowerBound="0" upperBound="1" defaultValueLiteral="30"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        ordered="true" unique="true" lowerBound="0" upperBound="1" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="role"
        eType="//@eClassifiers.1"
        ordered="true" unique="true" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager"
        eType="//@eClassifiers.5"
        containment="false" upperBound="1" ordered="true" unique="true"/>
  </eClassifiers>

  <!-- 6: Project -->
  <eClassifiers xsi:type="ecore:EClass" name="Project" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="budget"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        ordered="true" unique="true" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="lead"
        eType="//@eClassifiers.5"
        containment="false" upperBound="1" ordered="true" unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="contributors"
        eType="//@eClassifiers.5"
        containment="false" upperBound="-1" ordered="true" unique="true"/>
  </eClassifiers>

  <!-- 7: Utility interface-type class -->
  <eClassifiers xsi:type="ecore:EClass" name="Identifiable" abstract="true" interface="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uuid"
        eType="//@eClassifiers.0"
        iD="false" ordered="true" unique="true" lowerBound="0" upperBound="1"/>
  </eClassifiers>

  <!-- 8: EStringToStringMapEntry -->
  <eClassifiers xsi:type="ecore:EClass" name="MetaDataEntry" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.13">
  </eClassifiers>

  <!-- 9: Configuration -->
  <eClassifiers xsi:type="ecore:EClass" name="Configuration" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EReference" name="entries"
        eType="//@eClassifiers.8"
        containment="true" upperBound="-1" ordered="true" unique="true"/>
  </eClassifiers>

  <!-- 10: Abstract Artifact -->
  <eClassifiers xsi:type="ecore:EClass" name="Artifact" abstract="true" interface="false"
      eSuperTypes="//@eClassifiers.2 //@eClassifiers.7">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="createdOn"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"
        ordered="true" unique="true" lowerBound="0" upperBound="1"/>
  </eClassifiers>

  <!-- 11: Document -->
  <eClassifiers xsi:type="ecore:EClass" name="Document" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.10">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="content"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        ordered="true" unique="true" lowerBound="0" upperBound="1"/>
  </eClassifiers>

  <!-- 12: BinaryArtifact -->
  <eClassifiers xsi:type="ecore:EClass" name="BinaryArtifact" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.10">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="data"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EByteArray"
        ordered="true" unique="true" lowerBound="0" upperBound="1"/>
  </eClassifiers>

  <!-- 13: Inherit from EStringToStringMapEntry -->
  <eClassifiers xsi:type="ecore:EClass" name="EStringToStringMapEntryExt"
      eSuperTypes="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EStringToStringMapEntry"/>

</ecore:EPackage>