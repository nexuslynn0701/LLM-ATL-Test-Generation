<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyPkg"
    nsURI="http://example.org/companyPkg"
    nsPrefix="company">

  <!-- 0: Enum Department -->
  <eClassifiers xsi:type="ecore:EEnum" name="Department">
    <eLiterals name="HR" value="0" literal="HR"/>
    <eLiterals name="ENGINEERING" value="1" literal="Engineering"/>
    <eLiterals name="SALES" value="2" literal="Sales"/>
  </eClassifiers>

  <!-- 1: EnumLiteralStatus -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumLiteralStatus">
    <eStructuralFeatures xsi:type="ecore:EReference" name="enumType"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="enumLiteral"
        lowerBound="1"
        eType="//@eClassifiers.0/@eLiterals.1"/>
  </eClassifiers>

  <!-- 2: KindOfAddress -->
  <eClassifiers xsi:type="ecore:EClass" name="KindOfAddress">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 3: Address -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="number"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="kind"
        lowerBound="1"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 4: Person (abstract) -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="primaryAddress"
        lowerBound="1"
        eType="//@eClassifiers.3"
        containment="true"/>
  </eClassifiers>

  <!-- 5: Employee -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee"
      eSuperTypes="//@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="employeeId"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="department"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 6: Customer -->
  <eClassifiers xsi:type="ecore:EClass" name="Customer"
      eSuperTypes="//@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="customerId"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="secondaryAddresses"
        upperBound="-1"
        eType="//@eClassifiers.3"
        containment="true"/>
  </eClassifiers>

  <!-- 7: Project -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="team"
        upperBound="-1"
        eType="//@eClassifiers.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="leader"
        lowerBound="1"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 8: Assignment (uses operations and parameters) -->
  <eClassifiers xsi:type="ecore:EClass" name="Assignment">
    <eStructuralFeatures xsi:type="ecore:EReference" name="assignee"
        lowerBound="1"
        eType="//@eClassifiers.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="project"
        lowerBound="1"
        eType="//@eClassifiers.7"/>

    <!-- Operation: estimateHours(Employee, Project) : EInt -->
    <eOperations name="estimateHours">
      <eParameters name="emp" eType="//@eClassifiers.5"/>
      <eParameters name="proj" eType="//@eClassifiers.7"/>
      <eType eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eOperations>
  </eClassifiers>

  <!-- 9: Registry (uses attributes, references, and map entry) -->
  <eClassifiers xsi:type="ecore:EClass" name="Registry">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees"
        upperBound="-1"
        eType="//@eClassifiers.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="customers"
        upperBound="-1"
        eType="//@eClassifiers.6"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="projects"
        upperBound="-1"
        eType="//@eClassifiers.7"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assignments"
        upperBound="-1"
        eType="//@eClassifiers.8"/>

    <!-- Map-like structure using EStringToStringMapEntry -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="notes"
        upperBound="-1"
        containment="true"
        eType="#//EStringToStringMapEntry"/>
  </eClassifiers>

  <!-- 10: InternalNote -->
  <eClassifiers xsi:type="ecore:EClass" name="InternalNote">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="text"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 11: EStringToStringMapEntry from core Ecore (redeclared locally not allowed, so reference core one from nsURI) is already in Ecore, just use it via eType above -->

  <!-- Instances as EAnnotations to force diverse typed elements / not required by metamodel, omitted -->

</ecore:EPackage>