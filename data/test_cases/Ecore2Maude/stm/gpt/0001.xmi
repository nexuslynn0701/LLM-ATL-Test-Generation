<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="libraryPkg"
    nsURI="http://example.org/library"
    nsPrefix="lib">

  <!-- 0: Library -->
  <eClassifiers xsi:type="ecore:EClass" name="Library">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="books"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="members"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 1: Book -->
  <eClassifiers xsi:type="ecore:EClass" name="Book">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pages"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="category"
        eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="borrower"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 2: Member -->
  <eClassifiers xsi:type="ecore:EClass" name="Member">
    <eStructuralFeatures xsi:type="eccore:EAttribute" name="id"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="borrowed"
        upperBound="-1"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 3: Category -->
  <eClassifiers xsi:type="ecore:EClass" name="Category">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 4: Item (abstract super type) -->
  <eClassifiers xsi:type="ecore:EClass" name="Item" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 5: PrintedItem extends Item -->
  <eClassifiers xsi:type="ecore:EClass" name="PrintedItem"
      eSuperTypes="//@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="weight"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- 6: DigitalItem extends Item -->
  <eClassifiers xsi:type="ecore:EClass" name="DigitalItem"
      eSuperTypes="//@eClassifiers.4">
    <eStructuralFeatures xsi:type="eccore:EAttribute" name="fileSize"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
  </eClassifiers>

  <!-- 7: BookCopy extends PrintedItem and links to Book -->
  <eClassifiers xsi:type="ecore:EClass" name="BookCopy"
      eSuperTypes="//@eClassifiers.5">
    <eStructuralFeatures xsi:type="eccore:EAttribute" name="copyNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ofBook"
        lowerBound="1"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 8: EEnum for member type -->
  <eClassifiers xsi:type="ecore:EEnum" name="MemberType">
    <eLiterals name="ADULT" literal="ADULT" value="0"/>
    <eLiterals name="CHILD" literal="CHILD" value="1"/>
  </eClassifiers>

  <!-- 9: OperationExample -->
  <eClassifiers xsi:type="ecore:EClass" name="OperationExample">
    <eOperations name="findBook"
        eType="//@eClassifiers.1">
      <eParameters name="title"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
  </eClassifiers>

  <!-- 10: AttributeContainer with several EAttributes -->
  <eClassifiers xsi:type="ecore:EClass" name="AttributeContainer">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="count"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>