<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="familyPkg"
    nsURI="http://example.org/familyPkg"
    nsPrefix="fam">

  <!-- 0: PersonKind (Kind with two sorts) -->
  <eClassifiers xsi:type="ecore:EClass" name="PersonKind">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 1: PersonSort (Sort, ModElement) -->
  <eClassifiers xsi:type="ecore:EClass" name="PersonSort"
      eSuperTypes="//@eClassifiers.3 //@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subsortRels"
        upperBound="-1"
        eType="//@eClassifiers.5"
        eOpposite="//@eClassifiers.5/@eStructuralFeatures.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="supersortRels"
        upperBound="-1"
        eType="//@eClassifiers.5"
        eOpposite="//@eClassifiers.5/@eStructuralFeatures.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="kind"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="module"
        eType="//@eClassifiers.7"
        eOpposite="//@eClassifiers.7/@eStructuralFeatures.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="theory"
        eType="//@eClassifiers.6"
        eOpposite="//@eClassifiers.6/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- 2: AgeSort (Sort, ModElement) -->
  <eClassifiers xsi:type="ecore:EClass" name="AgeSort"
      eSuperTypes="//@eClassifiers.3 //@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subsortRels"
        upperBound="-1"
        eType="//@eClassifiers.5"
        eOpposite="//@eClassifiers.5/@eStructuralFeatures.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="supersortRels"
        upperBound="-1"
        eType="//@eClassifiers.5"
        eOpposite="//@eClassifiers.5/@eStructuralFeatures.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="kind"
        lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="module"
        eType="//@eClassifiers.7"
        eOpposite="//@eClassifiers.7/@eStructuralFeatures.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="theory"
        eType="//@eClassifiers.6"
        eOpposite="//@eClassifiers.6/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- 3: Kind base (as type, abstract) -->
  <eClassifiers xsi:type="ecore:EClass" name="KindBase" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 4: ModElement base (abstract) -->
  <eClassifiers xsi:type="ecore:EClass" name="ModElementBase" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EReference" name="module"
        eType="//@eClassifiers.7"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="theory"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

  <!-- 5: SubsortRel (ModElement) -->
  <eClassifiers xsi:type="ecore:EClass" name="SubsortRelCls"
      eSuperTypes="//@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EReference" name="subsorts"
        lowerBound="1"
        upperBound="-1"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="supersorts"
        lowerBound="1"
        upperBound="-1"
        eType="//@eClassifiers.2"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="module"
        eType="//@eClassifiers.7"
        eOpposite="//@eClassifiers.7/@eStructuralFeatures.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="theory"
        eType="//@eClassifiers.6"
        eOpposite="//@eClassifiers.6/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- 6: Theory (abstract top element) -->
  <eClassifiers xsi:type="ecore:EClass" name="FamilyTheory" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="els"
        upperBound="-1"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 7: Module (abstract top element) -->
  <eClassifiers xsi:type="ecore:EClass" name="FamilyModule" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="els"
        upperBound="-1"
        eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="params"
        upperBound="-1"
        eType="//@eClassifiers.8"/>
  </eClassifiers>

  <!-- 8: Parameter (ModExpression) -->
  <eClassifiers xsi:type="ecore:EClass" name="FamilyParameter">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="modExp"
        lowerBound="1"
        eType="//@eClassifiers.9"/>
  </eClassifiers>

  <!-- 9: ModExpression (abstract) -->
  <eClassifiers xsi:type="ecore:EClass" name="ModExpressionBase" abstract="true"/>

  <!-- 10: ModuleIdModExp referencing FamilyModule -->
  <eClassifiers xsi:type="ecore:EClass" name="ModuleIdExp"
      eSuperTypes="//@eClassifiers.9">
    <eStructuralFeatures xsi:type="ecore:EReference" name="module"
        lowerBound="1"
        eType="//@eClassifiers.7"/>
  </eClassifiers>

  <!-- 11: TheoryIdModExp referencing FamilyTheory -->
  <eClassifiers xsi:type="ecore:EClass" name="TheoryIdExp"
      eSuperTypes="//@eClassifiers.9">
    <eStructuralFeatures xsi:type="ecore:EReference" name="theory"
        lowerBound="1"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

  <!-- 12: CompModExp with two ModExpressions -->
  <eClassifiers xsi:type="ecore:EClass" name="CompositeModExp"
      eSuperTypes="//@eClassifiers.9">
    <eStructuralFeatures xsi:type="ecore:EReference" name="modExps"
        lowerBound="2"
        upperBound="-1"
        eType="//@eClassifiers.9"/>
  </eClassifiers>

  <!-- 13: InstModExp using views -->
  <eClassifiers xsi:type="ecore:EClass" name="InstantiatedModExp"
      eSuperTypes="//@eClassifiers.9">
    <eStructuralFeatures xsi:type="ecore:EReference" name="modExp"
        lowerBound="1"
        eType="//@eClassifiers.9"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="views"
        lowerBound="1"
        upperBound="-1"
        eType="//@eClassifiers.16"/>
  </eClassifiers>

  <!-- 14: RenMapping base -->
  <eClassifiers xsi:type="ecore:EClass" name="RenMappingBase" abstract="true"/>

  <!-- 15: SortMapping -->
  <eClassifiers xsi:type="ecore:EClass" name="SortMappingCls"
      eSuperTypes="//@eClassifiers.14">
    <eStructuralFeatures xsi:type="ecore:EReference" name="from"
        lowerBound="1"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="to"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 16: View referencing ModExpressions -->
  <eClassifiers xsi:type="ecore:EClass" name="FamilyView">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="from"
        lowerBound="1"
        eType="//@eClassifiers.9"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="to"
        lowerBound="1"
        eType="//@eClassifiers.9"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="els"
        upperBound="-1"
        eType="//@eClassifiers.14"/>
  </eClassifiers>

  <!-- 17: Operation (ModElement) -->
  <eClassifiers xsi:type="ecore:EClass" name="AgeOperation"
      eSuperTypes="//@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="coarity"
        eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="arity"
        upperBound="-1"
        eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="atts"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="module"
        eType="//@eClassifiers.7"
        eOpposite="//@eClassifiers.7/@eStructuralFeatures.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="theory"
        eType="//@eClassifiers.6"
        eOpposite="//@eClassifiers.6/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- 18: Term base (abstract) -->
  <eClassifiers xsi:type="ecore:EClass" name="TermBase" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EReference" name="type"
        lowerBound="1"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 19: Constant term -->
  <eClassifiers xsi:type="ecore:EClass" name="ConstantTerm"
      eSuperTypes="//@eClassifiers.18">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="op"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 20: Variable term -->
  <eClassifiers xsi:type="ecore:EClass" name="VariableTerm"
      eSuperTypes="//@eClassifiers.18">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 21: RecTerm with args -->
  <eClassifiers xsi:type="ecore:EClass" name="RecursiveTerm"
      eSuperTypes="//@eClassifiers.18">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="op"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="args"
        lowerBound="1"
        upperBound="-1"
        eType="//@eClassifiers.18"/>
  </eClassifiers>

  <!-- 22: Statement base (abstract ModElement) -->
  <eClassifiers xsi:type="ecore:EClass" name="StatementBase" abstract="true"
      eSuperTypes="//@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="atts"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 23: Membership statement -->
  <eClassifiers xsi:type="ecore:EClass" name="AgeMembership"
      eSuperTypes="//@eClassifiers.22">
    <eStructuralFeatures xsi:type="ecore:EReference" name="term"
        lowerBound="1"
        eType="//@eClassifiers.18"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sort"
        lowerBound="1"
        eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="module"
        eType="//@eClassifiers.7"
        eOpposite="//@eClassifiers.7/@eStructuralFeatures.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="theory"
        eType="//@eClassifiers.6"
        eOpposite="//@eClassifiers.6/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- 24: Equation statement -->
  <eClassifiers xsi:type="ecore:EClass" name="AgeEquation"
      eSuperTypes="//@eClassifiers.22">
    <eStructuralFeatures xsi:type="ecore:EReference" name="lhs"
        lowerBound="1"
        eType="//@eClassifiers.18"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rhs"
        lowerBound="1"
        eType="//@eClassifiers.18"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="module"
        eType="//@eClassifiers.7"
        eOpposite="//@eClassifiers.7/@eStructuralFeatures.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="theory"
        eType="//@eClassifiers.6"
        eOpposite="//@eClassifiers.6/@eStructuralFeatures.0"/>
  </eClassifiers>

</ecore:EPackage>