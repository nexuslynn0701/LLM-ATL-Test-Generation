<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyPkg"
    nsURI="http://example.org/companyPkg"
    nsPrefix="company">

  <!-- 0: Primitive wrapper datatype used in the package -->
  <eClassifiers xsi:type="ecore:EDataType" name="EStringAlias" instanceClassName="java.lang.String"/>

  <!-- 1: Enum with literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="EmploymentType">
    <eLiterals name="FULL_TIME" value="0" literal="FULL_TIME"/>
    <eLiterals name="PART_TIME" value="1" literal="PART_TIME"/>
    <eLiterals name="CONTRACTOR" value="2" literal="CONTRACTOR"/>
  </eClassifiers>

  <!-- 2: Abstract base class Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- 3: Department class -->
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees" upperBound="-1"
        eType="//@eClassifiers.4" containment="true" eOpposite="//@eClassifiers.4/@eStructuralFeatures.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager"
        eType="//@eClassifiers.4" eOpposite="//@eClassifiers.4/@eStructuralFeatures.3"/>
  </eClassifiers>

  <!-- 4: Employee subclass of Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="department"
        eType="//@eClassifiers.3" eOpposite="//@eClassifiers.3/@eStructuralFeatures.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="projects" upperBound="-1"
        eType="//@eClassifiers.5" containment="true" eOpposite="//@eClassifiers.5/@eStructuralFeatures.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manages"
        upperBound="-1" eType="//@eClassifiers.3" eOpposite="//@eClassifiers.3/@eStructuralFeatures.3"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="employment"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 5: Project class -->
  <eClassifiers xsi:type="ecore:EClass" name="Project" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner"
        eType="//@eClassifiers.4" eOpposite="//@eClassifiers.4/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- 6: Address class not a ModElement analog, used by Company -->
  <eClassifiers xsi:type="ecore:EClass" name="Address" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="city"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="zip"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 7: Company class with containment and reference features -->
  <eClassifiers xsi:type="ecore:EClass" name="Company" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="departments" upperBound="-1"
        eType="//@eClassifiers.3" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hqAddress"
        eType="//@eClassifiers.6" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="allEmployees" upperBound="-1"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 8: Utility class with operations and parameters -->
  <eClassifiers xsi:type="ecore:EClass" name="HRUtil" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="version"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eOperations name="findEmployeeById">
      <eParameters name="company" eType="//@eClassifiers.7"/>
      <eParameters name="id"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eGenericExceptions eClassifier="//@eClassifiers.9"/>
      <eGenericType eClassifier="//@eClassifiers.4"/>
    </eOperations>
  </eClassifiers>

  <!-- 9: Custom data type for exception representation -->
  <eClassifiers xsi:type="ecore:EDataType" name="SearchException"
      instanceClassName="java.lang.Exception"/>

  <!-- 10: Map entry type used e.g. for configuration -->
  <eClassifiers xsi:type="ecore:EClass" name="ConfigEntry" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 11: Another subclass of Person to exercise inheritance -->
  <eClassifiers xsi:type="ecore:EClass" name="Contractor" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hourlyRate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assignedDept"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

</ecore:EPackage>