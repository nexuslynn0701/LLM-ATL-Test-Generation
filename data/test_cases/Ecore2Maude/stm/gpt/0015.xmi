<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyModel"
    nsURI="http://company/1.0"
    nsPrefix="company">

  <!-- 0: Primitive alias StringDT -->
  <eClassifiers xsi:type="ecore:EDataType" name="StringDT" instanceClassName="java.lang.String"/>

  <!-- 1: Primitive alias IntDT -->
  <eClassifiers xsi:type="ecore:EDataType" name="IntDT" instanceClassName="int"/>

  <!-- 2: Enum for role types -->
  <eClassifiers xsi:type="ecore:EEnum" name="RoleKind">
    <eLiterals name="DEVELOPER" value="0" literal="DEVELOPER"/>
    <eLiterals name="TESTER" value="1" literal="TESTER"/>
    <eLiterals name="MANAGER" value="2" literal="MANAGER"/>
  </eClassifiers>

  <!-- 3: Helper map entry -->
  <eClassifiers xsi:type="ecore:EClass" name="StringToString"
                eSuperTypes="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EStringToStringMapEntry"/>

  <!-- 4: Department class -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deptName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees"
        eType="//@eClassifiers.5" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager"
        eType="//@eClassifiers.6"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="projects"
        eType="//@eClassifiers.7" upperBound="-1" containment="true"/>
  </eClassifiers>

  <!-- 5: Employee base class -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="//@eClassifiers.0" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="primaryRole"
        eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tags"
        upperBound="-1" eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="department"
        eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assignedProjects"
        eType="//@eClassifiers.7" upperBound="-1"/>
  </eClassifiers>

  <!-- 6: Manager subclass -->
  <eClassifiers xsi:type="ecore:EClass" name="Manager"
      eSuperTypes="//@eClassifiers.5">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="level"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="team"
        eType="//@eClassifiers.5" upperBound="-1"/>
  </eClassifiers>

  <!-- 7: Project -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="//@eClassifiers.0" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="budget"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner"
        eType="//@eClassifiers.6"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="participants"
        eType="//@eClassifiers.5" upperBound="-1"/>
  </eClassifiers>

</ecore:EPackage>