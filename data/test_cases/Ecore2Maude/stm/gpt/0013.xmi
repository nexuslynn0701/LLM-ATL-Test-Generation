<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyHierarchy"
    nsURI="http://example.com/companyHierarchy"
    nsPrefix="ch">

  <!-- 0: AddressKind (Kind with multiple Sorts) -->
  <eClassifiers xsi:type="ecore:EClass" name="AddressKind"/>

  <!-- 1: AddressSort (Sort for AddressKind) -->
  <eClassifiers xsi:type="ecore:EClass" name="AddressSort"/>

  <!-- 2: ContactKind (Kind with multiple Sorts) -->
  <eClassifiers xsi:type="ecore:EClass" name="ContactKind"/>

  <!-- 3: EmailSort (Sort for ContactKind, also referenced from ops/terms) -->
  <eClassifiers xsi:type="ecore:EClass" name="EmailSort"/>

  <!-- 4: PhoneSort (another Sort for ContactKind, used in subsort rels) -->
  <eClassifiers xsi:type="ecore:EClass" name="PhoneSort"/>

  <!-- 5: SubsortRel class (will be related to EmailSort & PhoneSort) -->
  <eClassifiers xsi:type="ecore:EClass" name="SubsortRel"/>

  <!-- 6: BasicType (Type that is not Sort/Kind) -->
  <eClassifiers xsi:type="ecore:EClass" name="BasicType"/>

  <!-- 7: Person (ModElement, contains ops and statements) -->
  <eClassifiers xsi:type="ecore:EClass" name="Person"/>

  <!-- 8: Department (another ModElement) -->
  <eClassifiers xsi:type="ecore:EClass" name="Department"/>

  <!-- 9: Membership (Statement subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="Membership"/>

  <!-- 10: Equation (Statement subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="Equation"/>

  <!-- 11: Rule (Statement subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="Rule"/>

  <!-- 12: BooleanCond -->
  <eClassifiers xsi:type="ecore:EClass" name="BooleanCond"/>

  <!-- 13: MembershipCond -->
  <eClassifiers xsi:type="ecore:EClass" name="MembershipCond"/>

  <!-- 14: EqualCond -->
  <eClassifiers xsi:type="ecore:EClass" name="EqualCond"/>

  <!-- 15: MatchingCond -->
  <eClassifiers xsi:type="ecore:EClass" name="MatchingCond"/>

  <!-- 16: RewriteCond -->
  <eClassifiers xsi:type="ecore:EClass" name="RewriteCond"/>

  <!-- 17: Constant (Term subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="Constant"/>

  <!-- 18: RecTerm (Term subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="RecTerm"/>

  <!-- 19: Variable (Term subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="Variable"/>

  <!-- 20: Operation (ModElement subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="Operation"/>

  <!-- 21: Parameter (ModExpression subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="Parameter"/>

  <!-- 22: SortMapping (RenMapping subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="SortMapping"/>

  <!-- 23: OpMapping (RenMapping subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="OpMapping"/>

  <!-- 24: OpTypedMapping (RenMapping subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="OpTypedMapping"/>

  <!-- 25: LabelMapping (RenMapping subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="LabelMapping"/>

  <!-- 26: TermMapping (ViewMapping subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="TermMapping"/>

  <!-- 27: ModImportation (ModElement subclass with imports) -->
  <eClassifiers xsi:type="ecore:EClass" name="ModImportation"/>

  <!-- 28: ModuleIdModExp (ModExpression, references Module) -->
  <eClassifiers xsi:type="ecore:EClass" name="ModuleIdModExp"/>

  <!-- 29: TheoryIdModExp (ModExpression, references Theory) -->
  <eClassifiers xsi:type="ecore:EClass" name="TheoryIdModExp"/>

  <!-- 30: InstModExp (ModExpression, with views) -->
  <eClassifiers xsi:type="ecore:EClass" name="InstModExp"/>

  <!-- 31: RenModExp (ModExpression, with renamings) -->
  <eClassifiers xsi:type="ecore:EClass" name="RenModExp"/>

  <!-- 32: CompModExp (ModExpression, composite of others) -->
  <eClassifiers xsi:type="ecore:EClass" name="CompModExp"/>

  <!-- 33: FModule (Module subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="FModule"/>

  <!-- 34: SModule (Module subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="SModule"/>

  <!-- 35: FTheory (Theory subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="FTheory"/>

  <!-- 36: STheory (Theory subclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="STheory"/>

  <!-- 37: View -->
  <eClassifiers xsi:type="ecore:EClass" name="View"/>

  <!-- 38: MaudeSpec (root, with several top elements) -->
  <eClassifiers xsi:type="ecore:EClass" name="MaudeSpec"/>

</ecore:EPackage>