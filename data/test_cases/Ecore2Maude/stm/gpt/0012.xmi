<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="mathSpec"
    nsURI="http://example.org/mathSpec"
    nsPrefix="math">

  <!-- 0: Kind for terms -->
  <eClassifiers xsi:type="ecore:EClass" name="TermKind" eSuperTypes="//@eClassifiers.5">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dummy" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sorts" lowerBound="1" upperBound="-1"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 1: Sort, ModElement + Type -->
  <eClassifiers xsi:type="ecore:EClass" name="NatSort" eSuperTypes="//@eClassifiers.6 //@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="kind" lowerBound="1"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 2: SubsortRel, ModElement -->
  <eClassifiers xsi:type="ecore:EClass" name="NatSubsortRel" eSuperTypes="//@eClassifiers.6">
    <eStructuralFeatures xsi:type="ecore:EReference" name="subsorts" lowerBound="1" upperBound="-1"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="supersorts" lowerBound="1" upperBound="-1"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 3: Operation, ModElement -->
  <eClassifiers xsi:type="ecore:EClass" name="PlusOp" eSuperTypes="//@eClassifiers.6">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="coarity"
        eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="arity" upperBound="-1"
        eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="atts" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 4: Type -->
  <eClassifiers xsi:type="ecore:EClass" name="AnyType" eSuperTypes="//@eClassifiers.7">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 5: Kind (base, abstract in Maude, here concrete) -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseKind" eSuperTypes="//@eClassifiers.7">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sorts" lowerBound="1" upperBound="-1"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 6: ModElement -->
  <eClassifiers xsi:type="ecore:EClass" name="ModElementBase">
    <eStructuralFeatures xsi:type="ecore:EReference" name="module"
        eType="//@eClassifiers.8"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="theory"
        eType="//@eClassifiers.9"/>
  </eClassifiers>

  <!-- 7: Type (alternative concrete) -->
  <eClassifiers xsi:type="ecore:EClass" name="AltType">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 8: Module (FModule-like) -->
  <eClassifiers xsi:type="ecore:EClass" name="NatModule">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="els" upperBound="-1"
        eType="//@eClassifiers.6"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="params" upperBound="-1"
        eType="//@eClassifiers.10"/>
  </eClassifiers>

  <!-- 9: Theory (FTheory-like) -->
  <eClassifiers xsi:type="ecore:EClass" name="NatTheory">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="els" upperBound="-1"
        eType="//@eClassifiers.6"/>
  </eClassifiers>

  <!-- 10: Parameter -->
  <eClassifiers xsi:type="ecore:EClass" name="NatParameter">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="modExp"
        eType="//@eClassifiers.11"/>
  </eClassifiers>

  <!-- 11: ModExpression (ModuleIdModExp-like) -->
  <eClassifiers xsi:type="ecore:EClass" name="ModuleIdExpression">
    <eStructuralFeatures xsi:type="ecore:EReference" name="module"
        eType="//@eClassifiers.8"/>
  </eClassifiers>

  <!-- 12: ModExpression (TheoryIdModExp-like) -->
  <eClassifiers xsi:type="ecore:EClass" name="TheoryIdExpression">
    <eStructuralFeatures xsi:type="ecore:EReference" name="theory"
        eType="//@eClassifiers.9"/>
  </eClassifiers>

  <!-- 13: ModExpression (CompModExp-like) -->
  <eClassifiers xsi:type="ecore:EClass" name="CompositeExpression">
    <eStructuralFeatures xsi:type="ecore:EReference" name="modExps" lowerBound="2" upperBound="-1"
        eType="//@eClassifiers.11"/>
  </eClassifiers>

  <!-- 14: ModImportation -->
  <eClassifiers xsi:type="ecore:EClass" name="NatImport" eSuperTypes="//@eClassifiers.6">
    <eStructuralFeatures xsi:type="ecore:EReference" name="imports" lowerBound="1"
        eType="//@eClassifiers.13"/>
  </eClassifiers>

  <!-- 15: Statement (abstract in Maude, here concrete superclass) -->
  <eClassifiers xsi:type="ecore:EClass" name="StmtBase" eSuperTypes="//@eClassifiers.6">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="atts" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="conds" upperBound="-1"
        eType="//@eClassifiers.16"/>
  </eClassifiers>

  <!-- 16: Condition -->
  <eClassifiers xsi:type="ecore:EClass" name="CondBase">
    <eStructuralFeatures xsi:type="ecore:EReference" name="lhs" lowerBound="1"
        eType="//@eClassifiers.18"/>
  </eClassifiers>

  <!-- 17: MembershipCond -->
  <eClassifiers xsi:type="ecore:EClass" name="MembershipCondition" eSuperTypes="//@eClassifiers.16">
    <eStructuralFeatures xsi:type="ecore:EReference" name="rhs" lowerBound="1"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 18: Term -->
  <eClassifiers xsi:type="ecore:EClass" name="TermBase">
    <eStructuralFeatures xsi:type="ecore:EReference" name="type" lowerBound="1"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 19: Constant -->
  <eClassifiers xsi:type="ecore:EClass" name="ZeroConst" eSuperTypes="//@eClassifiers.18">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="op" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 20: RecTerm -->
  <eClassifiers xsi:type="ecore:EClass" name="SuccTerm" eSuperTypes="//@eClassifiers.18">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="op" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="args" lowerBound="1" upperBound="-1"
        eType="//@eClassifiers.18"/>
  </eClassifiers>

  <!-- 21: Variable -->
  <eClassifiers xsi:type="ecore:EClass" name="NatVar" eSuperTypes="//@eClassifiers.18">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 22: Equation -->
  <eClassifiers xsi:type="ecore:EClass" name="NatEquation" eSuperTypes="//@eClassifiers.15">
    <eStructuralFeatures xsi:type="ecore:EReference" name="lhs" lowerBound="1"
        eType="//@eClassifiers.18"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rhs" lowerBound="1"
        eType="//@eClassifiers.18"/>
  </eClassifiers>

  <!-- 23: Membership -->
  <eClassifiers xsi:type="ecore:EClass" name="NatMembership" eSuperTypes="//@eClassifiers.15">
    <eStructuralFeatures xsi:type="ecore:EReference" name="term" lowerBound="1"
        eType="//@eClassifiers.18"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sort" lowerBound="1"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 24: Rule -->
  <eClassifiers xsi:type="ecore:EClass" name="NatRule" eSuperTypes="//@eClassifiers.15">
    <eStructuralFeatures xsi:type="ecore:EReference" name="lhs"
        eType="//@eClassifiers.18"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rhs"
        eType="//@eClassifiers.18"/>
  </eClassifiers>

</ecore:EPackage>