<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="complexPkg"
    nsURI="http://complex/example/0076"
    nsPrefix="cpx">

  <!-- 0: Enum with literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="OPEN" value="1" literal="OPEN"/>
    <eLiterals name="CLOSED" value="2" literal="CLOSED"/>
  </eClassifiers>

  <!-- 1: Abstract base class -->
  <eClassifiers xsi:type="ecore:EClass" name="NamedElement" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identifier"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1" upperBound="1"/>
  </eClassifiers>

  <!-- 2: Concrete class with attributes and reference to 5 -->
  <eClassifiers xsi:type="ecore:EClass" name="User" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="primaryGroup"
        eType="//@eClassifiers.5" lowerBound="0" upperBound="1"/>
  </eClassifiers>

  <!-- 3: Concrete class with containment and non-containment -->
  <eClassifiers xsi:type="ecore:EClass" name="Project" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <!-- containment of users -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="members"
        eType="//@eClassifiers.2" lowerBound="0" upperBound="-1" containment="true"/>
    <!-- reference to a status enum as EAttribute using EEnum datatype -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="//@eClassifiers.0" lowerBound="0" upperBound="1"/>
    <!-- cross-project reference -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="related"
        eType="//@eClassifiers.3" lowerBound="0" upperBound="-1"/>
  </eClassifiers>

  <!-- 4: Interface-like abstract class -->
  <eClassifiers xsi:type="ecore:EClass" name="OwnedElement" abstract="true" interface="true">
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner"
        eType="//@eClassifiers.7" lowerBound="0" upperBound="1"/>
  </eClassifiers>

  <!-- 5: Group with bidirectional reference to User (non-containment) -->
  <eClassifiers xsi:type="ecore:EClass" name="Group" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="users"
        eType="//@eClassifiers.2" lowerBound="0" upperBound="-1"/>
  </eClassifiers>

  <!-- 6: Map-entry class with EString-to-EString -->
  <eClassifiers xsi:type="ecore:EClass" name="TagEntry" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0" upperBound="1"/>
  </eClassifiers>

  <!-- 7: Container class for multiple elements, contains projects and groups -->
  <eClassifiers xsi:type="ecore:EClass" name="Repository" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="url"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="projects"
        eType="//@eClassifiers.3" lowerBound="0" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="groups"
        eType="//@eClassifiers.5" lowerBound="0" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="allUsers"
        eType="//@eClassifiers.2" lowerBound="0" upperBound="-1"/>
  </eClassifiers>

  <!-- 8: Class mixing multiple supertypes -->
  <eClassifiers xsi:type="ecore:EClass" name="Task" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1 //@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priority"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assignee"
        eType="//@eClassifiers.2" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="project"
        eType="//@eClassifiers.3" lowerBound="0" upperBound="1"/>
  </eClassifiers>

  <!-- 9: Class with operations and parameters -->
  <eClassifiers xsi:type="ecore:EClass" name="Service" abstract="false" interface="false">
    <!-- Operation 0 -->
    <eOperations name="findUser"
        eType="//@eClassifiers.2">
      <eParameters name="id"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <!-- Operation 1 -->
    <eOperations name="computeStatus"
        eType="//@eClassifiers.0">
      <eParameters name="project"
          eType="//@eClassifiers.3"/>
    </eOperations>
  </eClassifiers>

  <!-- 10: Class with both attributes and references to many types -->
  <eClassifiers xsi:type="ecore:EClass" name="Dashboard" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="repository"
        eType="//@eClassifiers.7" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="focusProject"
        eType="//@eClassifiers.3" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="visibleTasks"
        eType="//@eClassifiers.8" lowerBound="0" upperBound="-1"/>
  </eClassifiers>

</ecore:EPackage>