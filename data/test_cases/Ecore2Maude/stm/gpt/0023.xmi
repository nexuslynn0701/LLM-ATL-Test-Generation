<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyPkg"
    nsURI="http://example.org/companyPkg"
    nsPrefix="company">

  <!-- 0: EClass Company -->
  <eClassifiers xsi:type="ecore:EClass" name="Company">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="departments"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="projects"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 1: EClass Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="deptId"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employees"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="manager"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 2: EClass Employee -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="fullName"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="salary"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="department"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 3: EClass Manager extends Employee -->
  <eClassifiers xsi:type="ecore:EClass"
      name="Manager"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="level"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="managedDepartment"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 4: EClass Project -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="budget"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="lead"
        eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="contributors"
        upperBound="-1"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 5: EEnum EmploymentType -->
  <eClassifiers xsi:type="ecore:EEnum" name="EmploymentType">
    <eLiterals name="FULL_TIME" value="0" literal="FULL_TIME"/>
    <eLiterals name="PART_TIME" value="1" literal="PART_TIME"/>
    <eLiterals name="CONTRACTOR" value="2" literal="CONTRACTOR"/>
  </eClassifiers>

  <!-- 6: EClass Contract -->
  <eClassifiers xsi:type="ecore:EClass" name="Contract">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="contractId"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="type"
        lowerBound="1"
        eType="//@eClassifiers.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employee"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 7: EDataType DateString -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="DateString"
      instanceClassName="java.lang.String"/>

  <!-- 8: EClass TimeSheet -->
  <eClassifiers xsi:type="ecore:EClass" name="TimeSheet">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="year"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="submittedOn"
        eType="//@eClassifiers.7"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employee"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

</ecore:EPackage>