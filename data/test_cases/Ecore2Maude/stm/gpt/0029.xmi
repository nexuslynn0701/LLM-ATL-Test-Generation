<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="familyPkg"
    nsURI="http://family/example/0029"
    nsPrefix="fam">

  <!-- 0: EEnum Gender -->
  <eClassifiers xsi:type="ecore:EEnum" name="Gender">
    <eLiterals name="MALE" value="0" literal="male"/>
    <eLiterals name="FEMALE" value="1" literal="female"/>
  </eClassifiers>

  <!-- 1: EDataType ExternalID -->
  <eClassifiers xsi:type="ecore:EDataType" name="ExternalID"
                instanceClassName="java.lang.String"/>

  <!-- 2: EClass Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="id"
                         lowerBound="1"
                         iD="true"
                         eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="name"
                         lowerBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="age"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="gender"
                         lowerBound="1"
                         eType="//@eClassifiers.0"/>
  </eClassifiers>

  <!-- 3: EClass Employee extends Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee" eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="salary"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- 4: EClass Address -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="street"
                         lowerBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="city"
                         lowerBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="zip"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 5: EClass Company -->
  <eClassifiers xsi:type="ecore:EClass" name="Company">
    <eStructuralFeatures xsi:type="eccore:EAttribute"
                         name="name"
                         lowerBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="employees"
                         upperBound="-1"
                         eType="//@eClassifiers.3"
                         containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="hqAddress"
                         eType="//@eClassifiers.4"
                         containment="true"/>
  </eClassifiers>

  <!-- 6: EClass Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="code"
                         lowerBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="manager"
                         eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="members"
                         upperBound="-1"
                         eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 7: EClass Project -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="title"
                         lowerBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="lead"
                         lowerBound="1"
                         eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="team"
                         upperBound="-1"
                         eType="//@eClassifiers.2"/>
  </eClassifiers>

</ecore:EPackage>