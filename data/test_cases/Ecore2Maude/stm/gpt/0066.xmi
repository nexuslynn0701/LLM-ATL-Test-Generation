<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="complexPkg"
    nsURI="http://complex/example/0066"
    nsPrefix="cp">

  <!-- 0: simple data type -->
  <eClassifiers xsi:type="ecore:EDataType" name="StringAlias"
      instanceClassName="java.lang.String"/>

  <!-- 1: Map entry class -->
  <eClassifiers xsi:type="ecore:EClass" name="TagEntry">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 2: SuperClass with attributes and reference to self -->
  <eClassifiers xsi:type="ecore:EClass" name="SuperClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- 3: SubClass extends SuperClass and has ID attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="SubClass"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="eccore:EAttribute" name="iD"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="refToSuper"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 4: Node with mutual references and containment -->
  <eClassifiers xsi:type="ecore:EClass" name="Node">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="next"
        eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 5: Container with map-like containment and references -->
  <eClassifiers xsi:type="ecore:EClass" name="Container">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="entries"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rootNode"
        containment="true"
        eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mainElement"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 6: Enum with literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Priority">
    <eLiterals name="LOW" value="0" literal="LOW"/>
    <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
    <eLiterals name="HIGH" value="2" literal="HIGH"/>
  </eClassifiers>

  <!-- 7: Task class using the enum, map entries, and references -->
  <eClassifiers xsi:type="ecore:EClass" name="Task">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priority"
        eType="//@eClassifiers.6"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subtasks"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.7"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tags"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="related"
        upperBound="-1"
        eType="//@eClassifiers.7"/>
  </eClassifiers>

  <!-- 8: Abstract base with operation and parameter -->
  <eClassifiers xsi:type="ecore:EClass" name="AbstractElement" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uid"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eOperations name="compute"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
      <eParameters name="factor"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eOperations>
  </eClassifiers>

  <!-- 9: Concrete element extending abstract element and referencing Task -->
  <eClassifiers xsi:type="ecore:EClass" name="ConcreteElement"
      eSuperTypes="//@eClassifiers.8">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="task"
        eType="//@eClassifiers.7"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="container"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

</ecore:EPackage>