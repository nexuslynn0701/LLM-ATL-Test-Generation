<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="maudeTestPkg24"
    nsURI="http://maudeTestPkg24/1.0"
    nsPrefix="mtp24">

  <!-- 0: Enum for states -->
  <eClassifiers xsi:type="ecore:EEnum" name="StateKind">
    <eLiterals name="INITIAL" value="0" literal="INITIAL"/>
    <eLiterals name="INTERMEDIATE" value="1" literal="INTERMEDIATE"/>
    <eLiterals name="FINAL" value="2" literal="FINAL"/>
  </eClassifiers>

  <!-- 1: data type -->
  <eClassifiers xsi:type="ecore:EDataType" name="Identifier" instanceClassName="java.lang.String"/>

  <!-- 2: base abstract class -->
  <eClassifiers xsi:type="ecore:EClass" name="NamedElement" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 3: interface with operation and parameter -->
  <eClassifiers xsi:type="ecore:EClass" name="Annotatable" interface="true" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="annotations"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eOperations name="addAnnotation">
      <eParameters name="text"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
  </eClassifiers>

  <!-- 4: Kind -->
  <eClassifiers xsi:type="ecore:EClass" name="Kind" eSuperTypes="//@eClassifiers.2 //@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priority"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sorts"
        lowerBound="1" upperBound="-1"
        eType="//@eClassifiers.5"
        eOpposite="//@eClassifiers.5/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- 5: Sort -->
  <eClassifiers xsi:type="ecore:EClass" name="Sort" eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="state"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subsortRels"
        upperBound="-1"
        eType="//@eClassifiers.6"
        eOpposite="//@eClassifiers.6/@eStructuralFeatures.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="supersortRels"
        upperBound="-1"
        eType="//@eClassifiers.6"
        eOpposite="//@eClassifiers.6/@eStructuralFeatures.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="kind"
        lowerBound="1"
        eType="//@eClassifiers.4"
        eOpposite="//@eClassifiers.4/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- 6: SubsortRel -->
  <eClassifiers xsi:type="ecore:EClass" name="SubsortRel">
    <eStructuralFeatures xsi:type="ecore:EReference" name="subsorts"
        lowerBound="1" upperBound="-1"
        eType="//@eClassifiers.5"
        eOpposite="//@eClassifiers.5/@eStructuralFeatures.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="supersorts"
        lowerBound="1" upperBound="-1"
        eType="//@eClassifiers.5"
        eOpposite="//@eClassifiers.5/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- 7: Operation (maude-like) -->
  <eClassifiers xsi:type="ecore:EClass" name="Operation" eSuperTypes="//@eClassifiers.2 //@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="symbol"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="coarity"
        eType="//@eClassifiers.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="arity"
        upperBound="-1"
        eType="//@eClassifiers.5"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="atts"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 8: Term (abstract) -->
  <eClassifiers xsi:type="ecore:EClass" name="Term" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EReference" name="type"
        lowerBound="1"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 9: Constant term -->
  <eClassifiers xsi:type="ecore:EClass" name="Constant" eSuperTypes="//@eClassifiers.8">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="op"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 10: Recursive term -->
  <eClassifiers xsi:type="ecore:EClass" name="RecTerm" eSuperTypes="//@eClassifiers.8">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="op"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="args"
        lowerBound="1" upperBound="-1"
        eType="//@eClassifiers.8" containment="true"/>
  </eClassifiers>

  <!-- 11: Variable term -->
  <eClassifiers xsi:type="ecore:EClass" name="Variable" eSuperTypes="//@eClassifiers.8">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 12: Statement (abstract) -->
  <eClassifiers xsi:type="ecore:EClass" name="Statement" abstract="true" eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="atts"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 13: Membership statement -->
  <eClassifiers xsi:type="ecore:EClass" name="Membership" eSuperTypes="//@eClassifiers.12">
    <eStructuralFeatures xsi:type="ecore:EReference" name="term"
        lowerBound="1"
        eType="//@eClassifiers.8" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sort"
        lowerBound="1"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 14: Equation -->
  <eClassifiers xsi:type="ecore:EClass" name="Equation" eSuperTypes="//@eClassifiers.12">
    <eStructuralFeatures xsi:type="ecore:EReference" name="lhs"
        lowerBound="1"
        eType="//@eClassifiers.8" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rhs"
        lowerBound="1"
        eType="//@eClassifiers.8" containment="true"/>
  </eClassifiers>

  <!-- 15: Rule -->
  <eClassifiers xsi:type="ecore:EClass" name="Rule" eSuperTypes="//@eClassifiers.12">
    <eStructuralFeatures xsi:type="ecore:EReference" name="lhs"
        eType="//@eClassifiers.8" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rhs"
        eType="//@eClassifiers.8" containment="true"/>
  </eClassifiers>

  <!-- 16: Module (abstract) -->
  <eClassifiers xsi:type="ecore:EClass" name="Module" abstract="true" eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EReference" name="els"
        upperBound="-1"
        eType="//@eClassifiers.17" containment="true"
        eOpposite="//@eClassifiers.17/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- 17: ModElement -->
  <eClassifiers xsi:type="ecore:EClass" name="ModElement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="module"
        eType="//@eClassifiers.16"
        eOpposite="//@eClassifiers.16/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- 18: FModule -->
  <eClassifiers xsi:type="ecore:EClass" name="FModule" eSuperTypes="//@eClassifiers.16"/>

  <!-- 19: SModule -->
  <eClassifiers xsi:type="ecore:EClass" name="SModule" eSuperTypes="//@eClassifiers.16"/>

  <!-- 20: View -->
  <eClassifiers xsi:type="ecore:EClass" name="View" eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EReference" name="from"
        lowerBound="1"
        eType="//@eClassifiers.16" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="to"
        lowerBound="1"
        eType="//@eClassifiers.16" containment="true"/>
  </eClassifiers>

  <!-- Instances as nested content (example module with sorts, subsort, ops, terms, equations) -->
  <eSubpackages name="instances" nsURI="http://maudeTestPkg24/instances" nsPrefix="mtp24inst">
    <eClassifiers xsi:type="ecore:EClass" name="RootContainer">
      <eStructuralFeatures xsi:type="ecore:EReference" name="specModule"
          lowerBound="1"
          eType="//@eClassifiers.18"
          containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="systemModule"
          lowerBound="1"
          eType="//@eClassifiers.19"
          containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="view"
          lowerBound="1"
          eType="//@eClassifiers.20"
          containment="true"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>