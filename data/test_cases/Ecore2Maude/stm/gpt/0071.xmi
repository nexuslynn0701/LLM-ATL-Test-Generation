<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="libspec"
    nsURI="http://example.org/libspec/0071"
    nsPrefix="lib">

  <!-- 0: Library -->
  <eClassifiers xsi:type="ecore:EClass" name="Library">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="libName"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- containment to Book -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="books"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
    <!-- containment to Member -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="members"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 1: Book -->
  <eClassifiers xsi:type="ecore:EClass" name="Book">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="year"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- ID attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="isbn"
        lowerBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- non-containment to Member via borrowing -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="borrower"
        eType="//@eClassifiers.2"
        lowerBound="0"/>
  </eClassifiers>

  <!-- 2: Member (supertype for AdultMember and ChildMember) -->
  <eClassifiers xsi:type="ecore:EClass" name="Member" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- 3: AdultMember -->
  <eClassifiers xsi:type="ecore:EClass" name="AdultMember" eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="email"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 4: ChildMember -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildMember" eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="guardianName"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 5: Loan -->
  <eClassifiers xsi:type="ecore:EClass" name="Loan">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="date"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- reference to Book -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="book"
        lowerBound="1"
        eType="//@eClassifiers.1"/>
    <!-- reference to Member -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="member"
        lowerBound="1"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 6: Address (used by Member via non-containment) -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="city"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="zip"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 7: MembershipLevel enum -->
  <eClassifiers xsi:type="ecore:EEnum" name="MembershipLevel">
    <eLiterals name="BASIC" value="0" literal="BASIC"/>
    <eLiterals name="PREMIUM" value="1" literal="PREMIUM"/>
    <eLiterals name="STAFF" value="2" literal="STAFF"/>
  </eClassifiers>

  <!-- 8: StaffMember (interface, also a Member) -->
  <eClassifiers xsi:type="ecore:EClass" name="StaffMember"
      abstract="true" interface="true"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="staffId"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 9: Librarian (concrete, implements StaffMember) -->
  <eClassifiers xsi:type="ecore:EClass" name="Librarian" eSuperTypes="//@eClassifiers.8">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="shift"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 10: Fine -->
  <eClassifiers xsi:type="ecore:EClass" name="Fine">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="amount"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="reason"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- reference to Member -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="debtor"
        lowerBound="1"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 11: Settings (uses primitive EDataTypes and EStringToStringMapEntry) -->
  <eClassifiers xsi:type="ecore:EClass" name="Settings">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="maxLoans"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="openOnWeekends"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="config"
        upperBound="-1"
        eType="//@eClassifiers.12"/>
  </eClassifiers>

  <!-- 12: EStringToStringMapEntry from source metamodel -->
  <eClassifiers xsi:type="ecore:EClass" name="EStringToStringMapEntry">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="key"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>