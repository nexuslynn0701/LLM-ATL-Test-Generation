<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyModel"
    nsURI="http://example.com/companyModel"
    nsPrefix="cmp">

  <!-- 0: DataType for String IDs -->
  <eClassifiers xsi:type="ecore:EDataType" name="IDString" instanceClassName="java.lang.String"/>

  <!-- 1: DataType for codes -->
  <eClassifiers xsi:type="ecore:EDataType" name="CodeString" instanceClassName="java.lang.String"/>

  <!-- 2: Enum with multiple literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="EmploymentType">
    <eLiterals name="FULL_TIME" value="0" literal="FULL_TIME"/>
    <eLiterals name="PART_TIME" value="1" literal="PART_TIME"/>
    <eLiterals name="CONTRACTOR" value="2" literal="CONTRACTOR"/>
  </eClassifiers>

  <!-- 3: Abstract top-level entity -->
  <eClassifiers xsi:type="ecore:EClass" name="Entity">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uid" lowerBound="1"
        eType="//@eClassifiers.0" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="createdOn"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
  </eClassifiers>

  <!-- 4: Address value object -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="city" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="zip"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 5: Department class -->
  <eClassifiers xsi:type="ecore:EClass" name="Department" eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Container of employees -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees" upperBound="-1"
        containment="true" eType="//@eClassifiers.7"
        eOpposite="//@eClassifiers.7/@eStructuralFeatures.1"/>
    <!-- Cross-reference to manager -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager"
        eType="//@eClassifiers.7"/>
    <!-- Dept operations -->
    <eOperations name="getHeadCount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 6: Project class -->
  <eClassifiers xsi:type="ecore:EClass" name="Project" eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" lowerBound="1"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="budget"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <!-- Many-to-many with Employee -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="team" upperBound="-1"
        eType="//@eClassifiers.7"
        eOpposite="//@eClassifiers.7/@eStructuralFeatures.3"/>
  </eClassifiers>

  <!-- 7: Employee class -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee" eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstName" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="department"
        eType="//@eClassifiers.5"
        eOpposite="//@eClassifiers.5/@eStructuralFeatures.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="type"
        eType="//@eClassifiers.2"/>
    <!-- Many-to-many opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="projects" upperBound="-1"
        eType="//@eClassifiers.6"
        eOpposite="//@eClassifiers.6/@eStructuralFeatures.2"/>
    <!-- Single address containment -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" lowerBound="1"
        containment="true" eType="//@eClassifiers.4"/>
    <!-- Operation with parameters and exceptions -->
    <eOperations name="giveRaise"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eParameters name="percent"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
      <eExceptions href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
  </eClassifiers>

  <!-- 8: Contractor, a subclass of Employee with extra attributes -->
  <eClassifiers xsi:type="ecore:EClass" name="Contractor" eSuperTypes="//@eClassifiers.7">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dailyRate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- 9: Map entry class -->
  <eClassifiers xsi:type="ecore:EClass" name="MetaInfoEntry" instanceClassName="java.util.Map$Entry">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>