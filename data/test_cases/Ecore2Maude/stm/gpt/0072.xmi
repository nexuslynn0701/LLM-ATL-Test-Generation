<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyHierarchy"
    nsURI="http://example.com/companyHierarchy"
    nsPrefix="ch">

  <!-- 0: EClass Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deptName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- non-containment ref to Manager -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager"
        eType="//@eClassifiers.1"
        lowerBound="1"/>
    <!-- containment of Teams -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="teams"
        eType="//@eClassifiers.2"
        upperBound="-1"
        containment="true"/>
  </eClassifiers>

  <!-- 1: EClass Manager extends Employee -->
  <eClassifiers xsi:type="ecore:EClass" name="Manager"
      eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="eccore:EAttribute" name="level"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 2: EClass Team -->
  <eClassifiers xsi:type="ecore:EClass" name="Team">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="teamName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"/>
    <!-- bidirectional, containment back in Department not needed here -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="members"
        eType="//@eClassifiers.3"
        upperBound="-1"/>
    <!-- non-containment reference to lead (an Employee) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="lead"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- 3: EClass Employee with ID attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="empId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"
        lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lastName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- reference to main team -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="primaryTeam"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 4: EClass Project with operations and references -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="projectName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="budget"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="participants"
        eType="//@eClassifiers.3"
        upperBound="-1"/>
    <!-- Operation with parameters and exceptions -->
    <eOperations name="calculateRemainingBudget"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
      <eParameters name="spent"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
      <eExceptions eType="//@eClassifiers.5"/>
    </eOperations>
  </eClassifiers>

  <!-- 5: EDataType custom exception type -->
  <eClassifiers xsi:type="ecore:EDataType" name="BudgetOverflowException"
      instanceClassName="java.lang.RuntimeException">
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="baseType" value="http://www.w3.org/2001/XMLSchema#string"/>
    </eAnnotations>
  </eClassifiers>

  <!-- 6: EEnum EmploymentType with literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="EmploymentType">
    <eLiterals name="FULL_TIME" value="0" literal="FULL_TIME"/>
    <eLiterals name="PART_TIME" value="1" literal="PART_TIME"/>
    <eLiterals name="CONTRACTOR" value="2" literal="CONTRACTOR"/>
  </eClassifiers>

  <!-- 7: EClass Contract with enum usage and containment -->
  <eClassifiers xsi:type="ecore:EClass" name="Contract">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="contractId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="type"
        eType="//@eClassifiers.6"
        lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employee"
        eType="//@eClassifiers.3"
        lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="projects"
        eType="//@eClassifiers.4"
        upperBound="-1"/>
  </eClassifiers>

  <!-- 8: EClass Address reused by Employee and Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="city"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="zip"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 9: EClass GlobalRegistry demonstrating map entry use -->
  <eClassifiers xsi:type="ecore:EClass" name="GlobalRegistry">
    <eStructuralFeatures xsi:type="ecore:EReference" name="namedDepartments"
        eType="//@eClassifiers.10"
        upperBound="-1"
        containment="true"/>
  </eClassifiers>

  <!-- 10: EClass EStringToDepartmentMapEntry -->
  <eClassifiers xsi:type="ecore:EClass" name="EStringToDepartmentMapEntry">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="value"
        eType="//@eClassifiers.0"/>
  </eClassifiers>

</ecore:EPackage>