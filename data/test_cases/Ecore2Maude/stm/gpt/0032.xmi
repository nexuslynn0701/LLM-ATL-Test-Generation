<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyModel"
    nsURI="http://example.org/companyModel"
    nsPrefix="cmp">

  <!-- EClass 0: Company -->
  <eClassifiers xsi:type="ecore:EClass" name="Company">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Containment of Departments -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="departments"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
    <!-- Non-containment reference to all Employees -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="allEmployees"
        upperBound="-1"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- EClass 1: Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="eccore:EAttribute" name="code"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Container back-reference to Company (non-containment, since opposite is containment) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="company"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
    <!-- Containment of Employees in the department -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.2"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- EClass 2: Employee -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fullName"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Container back-reference to Department -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="department"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.2"/>
    <!-- Reference to Manager (Employee) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- EClass 3: Project -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="eccore:EAttribute" name="title"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Many-to-many association with Employee -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="team"
        upperBound="-1"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- EClass 4: Address -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="eccore:EAttribute" name="street"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="eccore:EAttribute" name="zip"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

</ecore:EPackage>