<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyModel"
    nsURI="http://companyModel/1.0"
    nsPrefix="company">

  <!-- 0: Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- 1: Employee extends Person, with attribute and reference -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="department"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 2: Department with containment to Project -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="projects"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- 3: Project with cross-ref back to Department and to Task -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownerDepartment"
        eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tasks"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.4"/>
  </eClassifiers>

  <!-- 4: Task references Employee (assignee) and Project (parent) -->
  <eClassifiers xsi:type="ecore:EClass" name="Task">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="estimateHours"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assignee"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parentProject"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- 5: Meeting with many attendees (Employee) -->
  <eClassifiers xsi:type="ecore:EClass" name="Meeting">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="topic"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="durationMinutes"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="attendees"
        upperBound="-1"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 6: Role used as a Type in an operation -->
  <eClassifiers xsi:type="ecore:EClass" name="Role">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 7: Utility class with operation and parameter -->
  <eClassifiers xsi:type="ecore:EClass" name="HRUtils">
    <eStructuralFeatures xsi:type="ecore:EOperation" name="assignRole">
      <eParameters name="employee"
          eType="//@eClassifiers.1"/>
      <eParameters name="role"
          eType="//@eClassifiers.6"/>
      <eParameters name="comment"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eExceptions
          eType="//@eClassifiers.8"/>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- 8: CustomException as EClass, used as exception type -->
  <eClassifiers xsi:type="ecore:EClass" name="CustomException"/>

  <!-- 9: Status enum used by TaskStatusMapping -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="IN_PROGRESS" value="1" literal="IN_PROGRESS"/>
    <eLiterals name="DONE" value="2" literal="DONE"/>
  </eClassifiers>

  <!-- 10: Map entry to demonstrate EClass that is not a real domain class -->
  <eClassifiers xsi:type="ecore:EClass" name="TaskStatusMapping">
    <eStructuralFeatures xsi:type="ecore:EReference" name="status"
        eType="//@eClassifiers.9"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lastUpdatedBy"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 11: DataType to exercise EDataType handling -->
  <eClassifiers xsi:type="ecore:EDataType" name="UUID"
      instanceClassName="java.util.UUID"/>
</ecore:EPackage>