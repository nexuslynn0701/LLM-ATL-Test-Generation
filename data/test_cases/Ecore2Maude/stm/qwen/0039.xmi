<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="testPkg" nsURI="http://testPkg" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EClass" name="RootClass"/>
  <eClassifiers xsi:type="ecore:EClass" name="IntermediateClass" eSuperTypes="//@eClassifiers.0"/>
  <eClassifiers xsi:type="ecore:EClass" name="LeafClass" eSuperTypes="//@eClassifiers.1"/>
  <eClassifiers xsi:type="ecore:EDataType" name="CustomString" instanceClassName="java.lang.String"/>
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE" value="0" literal="active"/>
    <eLiterals name="INACTIVE" value="1" literal="inactive"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Entity" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="enabled" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="customField" eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="//@eClassifiers.5" eOpposite="//@eClassifiers.6/eStructuralFeatures.7"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" upperBound="-1" eType="//@eClassifiers.5" eOpposite="//@eClassifiers.6/eStructuralFeatures.6"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Container" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EReference" name="entities" upperBound="-1" eType="//@eClassifiers.5" containment="true" eOpposite="//@eClassifiers.5/eStructuralFeatures.6"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mainEntity" eType="//@eClassifiers.5" containment="true" eOpposite="//@eClassifiers.5/eStructuralFeatures.7"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EOperation" name="validate" eContainingClass="//@eClassifiers.5">
    <eParameters name="context" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EOperation" name="computeHash" eContainingClass="//@eClassifiers.6">
    <eParameters name="algorithm" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eExceptions>//@eClassifiers.0</eExceptions>
  </eClassifiers>
</ecore:EPackage>