<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="testPkg" nsURI="http://testPkg" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EClass" name="RootClass"/>
  <eClassifiers xsi:type="ecore:EClass" name="IntermediateClass" eSuperTypes="//@eClassifiers.0"/>
  <eClassifiers xsi:type="ecore:EClass" name="LeafClass" eSuperTypes="//@eClassifiers.1"/>
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE" value="0" literal="active"/>
    <eLiterals name="INACTIVE" value="1" literal="inactive"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="CustomString" instanceClassName="java.lang.String"/>
  <eClassifiers xsi:type="ecore:EAttribute" name="idAttr" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" iD="true"/>
  <eClassifiers xsi:type="ecore:EAttribute" name="nameAttr" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  <eClassifiers xsi:type="ecore:EAttribute" name="statusAttr" eType="//@eClassifiers.3"/>
  <eClassifiers xsi:type="ecore:EAttribute" name="customAttr" eType="//@eClassifiers.4"/>
  <eClassifiers xsi:type="ecore:EReference" name="parentRef" eType="//@eClassifiers.0" containment="false"/>
  <eClassifiers xsi:type="ecore:EReference" name="childrenRef" eType="//@eClassifiers.2" containment="true" upperBound="-1"/>
  <eClassifiers xsi:type="ecore:EReference" name="selfRef" eType="//@eClassifiers.2" containment="false"/>
  <eClassifiers xsi:type="ecore:EOperation" name="getValue">
    <eParameters name="param1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eParameters name="param2" eType="//@eClassifiers.3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EOperation" name="setValue" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
    <eParameters name="newValue" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
</ecore:EPackage>