<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="metaRoot89"
    nsURI="http://example.org/metaRoot89"
    nsPrefix="mr89">

  <!-- Subpackage to exercise super/sub package equations -->
  <eSubpackages name="subPack89"
                nsURI="http://example.org/metaRoot89/sub"
                nsPrefix="mr89sub">
    <!-- Class with no features, supertype from root package -->
    <eClassifiers xsi:type="ecore:EClass"
                  name="EmptySubClass">
      <eSuperTypes href="//@eClassifiers.0"/>
    </eClassifiers>
  </eSubpackages>

  <!-- Class 0: base class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass"
                name="BaseClass"
                abstract="true">
    <!-- ID attribute, EString type, with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="identifier"
                         iD="true"
                         ordered="true"
                         unique="true"
                         lowerBound="1"
                         upperBound="1"
                         defaultValueLiteral="id-001"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Non-ID attribute, EInt type, no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="count"
                         iD="false"
                         ordered="false"
                         unique="true"
                         lowerBound="0"
                         upperBound="-1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference with opposite, non-containment -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="linkToDerived"
                         ordered="true"
                         unique="false"
                         lowerBound="0"
                         upperBound="-1"
                         containment="false"
                         eType="//@eClassifiers.1"
                         eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"/>
  </eClassifiers>

  <!-- Class 1: derived class with features, including containment and opposite -->
  <eClassifiers xsi:type="ecore:EClass"
                name="Derived Class"
                abstract="false"
                interface="false">
    <eSuperTypes href="//@eClassifiers.0"/>
    <!-- Containment reference with no opposite, upperBound = 1 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="ownedChild"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         containment="true"
                         eType="//@eClassifiers.0"/>
    <!-- Opposite of BaseClass.linkToDerived -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="backToBase"
                         ordered="false"
                         unique="true"
                         lowerBound="0"
                         upperBound="-1"
                         containment="false"
                         eType="//@eClassifiers.0"
                         eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- Class 2: class with only attributes, including Boolean and enum-typed -->
  <eClassifiers xsi:type="ecore:EClass"
                name="FlaggedItem"
                abstract="false"
                interface="false">
    <!-- Boolean attribute with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="active"
                         iD="false"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         defaultValueLiteral="true"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Enum-typed attribute with default literal -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="state"
                         iD="false"
                         ordered="true"
                         unique="true"
                         lowerBound="1"
                         upperBound="1"
                         defaultValueLiteral="OPEN"
                         eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- Classifier 3: Enumeration with several literals -->
  <eClassifiers xsi:type="ecore:EEnum"
                name="LifecycleState">
    <eLiterals name="OPEN" value="0" literal="OPEN"/>
    <eLiterals name="IN_PROGRESS" value="1" literal="IN_PROGRESS"/>
    <eLiterals name="CLOSED" value="2" literal="CLOSED"/>
  </eClassifiers>

</ecore:EPackage>