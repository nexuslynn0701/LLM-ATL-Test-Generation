<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="libRoot"
    nsURI="http://example.org/libRoot"
    nsPrefix="libroot">

  <!-- Root-level EClassifiers (index-based for cross-refs) -->
  <!-- 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="Library" abstract="false" interface="false">
    <!-- attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="libName"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="Central &quot;Library&quot;"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <!-- references -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="books"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        resolveProxies="true"
        eType="//@eSubpackages.0/@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="members"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        resolveProxies="true"
        eType="//@eSubpackages.0/@eClassifiers.1"/>
  </eClassifiers>

  <!-- 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="Item" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="false"/>
  </eClassifiers>

  <!-- 2 -->
  <eClassifiers xsi:type="ecore:EEnum" name="Genre">
    <eLiterals name="Sci_Fi" value="0" literal="Sci_Fi"/>
    <eLiterals name="Non_Fiction" value="1" literal="Non_Fiction"/>
    <eLiterals name="Children" value="2" literal="Children"/>
  </eClassifiers>

  <!-- 3 -->
  <eClassifiers xsi:type="ecore:EClass" name="MediaItem" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="&quot;Untitled&quot;"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="published"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rating"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="3.5"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="genre"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="Sci_Fi"
        eType="//@eClassifiers.2"
        iD="false"/>
  </eClassifiers>

  <!-- 4: simple EDataType that is not a primitive (to exercise @DataType case) -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="CustomData"
      instanceClassName="java.lang.Object"/>

  <!-- 5 -->
  <eClassifiers xsi:type="ecore:EClass" name="Tag" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="label"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="general"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
  </eClassifiers>

  <!-- 6 -->
  <eClassifiers xsi:type="ecore:EClass" name="Librarian" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="employeeId"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        iD="false"/>
  </eClassifiers>

  <!-- 7 -->
  <eClassifiers xsi:type="ecore:EClass" name="Archive" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="archivedItems"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- 8 -->
  <eClassifiers xsi:type="ecore:EClass" name="Shelf" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="shelfNumber"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="A1"
        eType="//@eClassifiers.4"
        iD="false"/>
  </eClassifiers>

  <!-- Nested subpackage -->
  <eSubpackages name="libContent" nsURI="http://example.org/libContent" nsPrefix="lc">
    <!-- 0 in subpackage -->
    <eClassifiers xsi:type="ecore:EClass" name="Book" abstract="false" interface="false"
        eSuperTypes="//@eClassifiers.3">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="pages"
          lowerBound="0"
          upperBound="1"
          ordered="true"
          unique="true"
          defaultValueLiteral="100"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
          iD="false"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="isbn"
          lowerBound="1"
          upperBound="1"
          ordered="true"
          unique="true"
          defaultValueLiteral="000-0-00-000000-0"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          iD="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="owner"
          lowerBound="0"
          upperBound="1"
          ordered="true"
          unique="true"
          containment="false"
          resolveProxies="true"
          eOpposite="//@eSubpackages.0/@eClassifiers.1/@eStructuralFeatures.1"
          eType="//@eSubpackages.0/@eClassifiers.1"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="tags"
          lowerBound="0"
          upperBound="-1"
          ordered="true"
          unique="true"
          containment="false"
          resolveProxies="true"
          eType="//@eClassifiers.5"/>
    </eClassifiers>

    <!-- 1 in subpackage -->
    <eClassifiers xsi:type="ecore:EClass" name="Member" abstract="false" interface="false">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="name"
          lowerBound="1"
          upperBound="1"
          ordered="true"
          unique="true"
          defaultValueLiteral="Anonymous"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          iD="false"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="borrowedBooks"
          lowerBound="0"
          upperBound="-1"
          ordered="true"
          unique="true"
          containment="false"
          resolveProxies="true"
          eOpposite="//@eSubpackages.0/@eClassifiers.0/@eStructuralFeatures.2"
          eType="//@eSubpackages.0/@eClassifiers.0"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="homeLibrary"
          lowerBound="1"
          upperBound="1"
          ordered="true"
          unique="true"
          containment="false"
          resolveProxies="true"
          eType="//@eClassifiers.0"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>