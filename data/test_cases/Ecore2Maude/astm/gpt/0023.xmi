<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="mmRoot23"
    nsURI="http://example.org/mmRoot23"
    nsPrefix="mm23">

  <!-- Classifiers 0-4: EClasses -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseRoot"
      abstract="true"
      interface="false">
    <!-- Structural features index 0: id attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootId"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="MidLevel"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- index 0: reference to BaseRoot, non-containment, opposite is set later -->
    <eStructuralFeatures xsi:type="eccore:EReference"
        xmlns:eccore="http://www.eclipse.org/emf/2002/Ecore"
        name="rootRef"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"/>
    <!-- index 1: String attribute with default, not ID -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="midName"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="defaultMid&quot;Name"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="LeafA"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.1">
    <!-- index 0: containment reference to LeafB, many, opposite set later -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="childrenB"
        ordered="false"
        unique="false"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.3"/>
    <!-- index 1: int attribute without default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="count"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="LeafB"
      abstract="false"
      interface="false"
      eSuperTypes="//@eClassifiers.1">
    <!-- index 0: opposite to LeafA.childrenB -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parentA"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.2"/>
    <!-- index 1: enum-typed attribute with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="ACTIVE"
        iD="false"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Utility"
      abstract="false"
      interface="false">
    <!-- index 0: a reference with no type (to hit @NoType branch) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="untypedRef"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"/>
    <!-- index 1: attribute with Boolean type -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- Classifier 5: EEnum -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
  </eClassifiers>

</ecore:EPackage>