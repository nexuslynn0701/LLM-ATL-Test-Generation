<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="mmRoot65"
    nsURI="http://mm/root65"
    nsPrefix="root65">

  <!-- Subpackage to trigger super/sub package equations -->
  <eSubpackages name="mmSub65" nsURI="http://mm/sub65" nsPrefix="sub65">
    <!-- Class with NO super types, attributes and references, and an enum -->
    <eClassifiers xsi:type="ecore:EClass" name="EntityA">
      <!-- Attribute with String type, iD=true, default value and bounds 0..* -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="codeA"
          lowerBound="0"
          upperBound="-1"
          iD="true"
          defaultValueLiteral="A-default &quot;value&quot;"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <!-- Reference with no opposite, containment=false, 1..1 -->
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="toB"
          lowerBound="1"
          upperBound="1"
          containment="false"
          eType="//@eSubpackages.0/@eClassifiers.1"/>
    </eClassifiers>

    <!-- Class with one super type (EntityA), attributes referencing enum and int, and a bi-directional reference -->
    <eClassifiers xsi:type="ecore:EClass" name="EntityB">
      <!-- Super type -->
      <eSuperTypes>//@eSubpackages.0/@eClassifiers.0</eSuperTypes>

      <!-- Attribute with Enum type, iD=false, a literal default -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="statusB"
          lowerBound="1"
          upperBound="1"
          iD="false"
          defaultValueLiteral="ACTIVE"
          eType="//@eSubpackages.0/@eClassifiers.2"/>

      <!-- Attribute with Integer type, no default -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="countB"
          lowerBound="0"
          upperBound="1"
          iD="false"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>

      <!-- Reference with opposite, containment=true, 0..* -->
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="childrenA"
          lowerBound="0"
          upperBound="-1"
          containment="true"
          eType="//@eSubpackages.0/@eClassifiers.0"
          eOpposite="//@eClassifiers.0/@eStructuralFeatures.1"/>
    </eClassifiers>

    <!-- Enumeration with three literals -->
    <eClassifiers xsi:type="ecore:EEnum" name="StateEnum">
      <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
      <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
      <eLiterals name="PENDING" value="2" literal="PENDING"/>
    </eClassifiers>
  </eSubpackages>

  <!-- Class in root package with two super types (EntityA and EntityB) to trigger multiple-supertype list case -->
  <eClassifiers xsi:type="ecore:EClass" name="EntityC">
    <eSuperTypes>//@eSubpackages.0/@eClassifiers.0 //@eSubpackages.0/@eClassifiers.1</eSuperTypes>

    <!-- Attribute without explicit eType (eAttributeType undefined) and a default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="untypedAttrC"
        lowerBound="0"
        upperBound="1"
        iD="false"
        defaultValueLiteral="rawLiteralWithoutType"/>

    <!-- Reference to EntityB with no opposite, containment=true, 0..1 -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="toBOptional"
        lowerBound="0"
        upperBound="1"
        containment="true"
        eType="//@eSubpackages.0/@eClassifiers.1"/>
  </eClassifiers>

  <!-- A data type classifier to be ignored by class-specific rules but used for package/class listing differences -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomData" instanceClassName="java.lang.String"/>

</ecore:EPackage>