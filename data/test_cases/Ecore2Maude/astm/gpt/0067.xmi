<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="meta67"
    nsURI="http://example.org/meta67"
    nsPrefix="m67">

  <!-- Root-level classifiers (indices shown in comments) -->
  <!-- 0 -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="RED"/>
  </eClassifiers>

  <!-- 1 -->
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="ACTIVE" value="1" literal="ACTIVE"/>
  </eClassifiers>

  <!-- 2 -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseEntity" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="BE-0"
        iD="true"/>
  </eClassifiers>

  <!-- 3 -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.1"
        defaultValueLiteral="ACTIVE"/>
  </eClassifiers>

  <!-- 4 -->
  <eClassifiers xsi:type="ecore:EClass" name="Address" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="&quot;Main&quot; st"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.3"
        containment="false"/>
  </eClassifiers>

  <!-- 5 -->
  <eClassifiers xsi:type="ecore:EClass" name="Company" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employees"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.3"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="mainAddress"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.4"
        containment="true"/>
  </eClassifiers>

  <!-- 6 -->
  <eClassifiers xsi:type="ecore:EEnum" name="Size">
    <eLiterals name="SMALL" value="0" literal="SMALL"/>
    <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
  </eClassifiers>

  <!-- 7 -->
  <eClassifiers xsi:type="ecore:EClass" name="Box" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="label"
        ordered="false"
        unique="false"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="size"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.6"
        defaultValueLiteral="SMALL"/>
  </eClassifiers>

  <!-- One subpackage to trigger subPackage-related rules -->
  <eSubpackages name="subpkg" nsURI="http://example.org/meta67/sub" nsPrefix="m67s">
    <!-- indices in this nested package are local to it -->
    <!-- 0 -->
    <eClassifiers xsi:type="ecore:EClass" name="SubItem" abstract="false" interface="false">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="name"
          ordered="true"
          unique="true"
          lowerBound="1"
          upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eClassifiers>
    <!-- 1 -->
    <eClassifiers xsi:type="ecore:EEnum" name="Level">
      <eLiterals name="LOW" value="0" literal="LOW"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>