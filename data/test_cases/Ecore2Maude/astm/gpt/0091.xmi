<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg0091"
    nsURI="http://example.org/rootPkg0091"
    nsPrefix="root0091">

  <!-- Root package classifiers -->
  <!-- 0: RootClassA -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClassA">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="idAttrRoot"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"
        upperBound="1"
        iD="true"
        ordered="true"
        unique="true"
        defaultValueLiteral="7"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flagRoot"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0"
        upperBound="1"
        iD="false"
        ordered="false"
        unique="true"/>
  </eClassifiers>

  <!-- 1: RootClassB extends RootClassA -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClassB"
      abstract="true"
      interface="false"
      eSuperTypes="#//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="toChild1"
        eType="#//@eSubpackages.0/@eClassifiers.0"
        containment="true"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="codeRoot"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        iD="false"
        ordered="true"
        unique="false"
        defaultValueLiteral="default &quot;code&quot;"/>
  </eClassifiers>

  <!-- 2: RootEnum -->
  <eClassifiers xsi:type="ecore:EEnum" name="RootEnum">
    <eLiterals name="FIRST" value="0" literal="FIRST"/>
    <eLiterals name="SECOND" value="1" literal="SECOND"/>
    <eLiterals name="THIRD" value="2" literal="THIRD"/>
  </eClassifiers>

  <!-- 3: RootClassC using enum and string defaults -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClassC">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        eType="#//@eClassifiers.2"
        lowerBound="0"
        upperBound="1"
        iD="false"
        ordered="true"
        unique="true"
        defaultValueLiteral="SECOND"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        iD="false"
        ordered="true"
        unique="true"
        defaultValueLiteral="Root &quot;Label&quot; 0091"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="linkToMiddle"
        eType="#//@eSubpackages.0/@eClassifiers.2"
        containment="false"
        lowerBound="0"
        upperBound="1"
        ordered="false"
        unique="true"/>
  </eClassifiers>

  <!-- 4: RootData (non-primitive EDataType) -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="RootData"
      instanceClassName="java.lang.String"
      serializable="true"/>

  <!-- Subpackage 0 -->
  <eSubpackages name="childPkg"
      nsURI="http://example.org/childPkg0091"
      nsPrefix="child0091">

    <!-- 0: ChildClass1 -->
    <eClassifiers xsi:type="ecore:EClass" name="ChildClass1">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="childName"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          lowerBound="1"
          upperBound="1"
          iD="false"
          ordered="true"
          unique="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="toRootA"
          eType="#//@eClassifiers.0"
          containment="false"
          lowerBound="0"
          upperBound="1"
          ordered="true"
          unique="true"
          eOpposite="#//@eSubpackages.0/@eClassifiers.1/@eStructuralFeatures.0"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="childFlag"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"
          lowerBound="0"
          upperBound="1"
          iD="false"
          ordered="true"
          unique="true"
          defaultValueLiteral="true"/>
    </eClassifiers>

    <!-- 1: ChildClass2 -->
    <eClassifiers xsi:type="ecore:EClass" name="ChildClass2">
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="parent"
          eType="#//@eSubpackages.0/@eClassifiers.0"
          containment="false"
          lowerBound="0"
          upperBound="1"
          ordered="true"
          unique="true"
          eOpposite="#//@eSubpackages.0/@eClassifiers.0/@eStructuralFeatures.1"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="child2Number"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
          lowerBound="0"
          upperBound="1"
          iD="false"
          ordered="false"
          unique="true"
          defaultValueLiteral="42"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="child2CustomData"
          eType="#//@eClassifiers.4"
          lowerBound="0"
          upperBound="1"
          iD="false"
          ordered="true"
          unique="true"/>
    </eClassifiers>

    <!-- 2: MiddleClass extends RootClassA and ChildClass1 -->
    <eClassifiers xsi:type="ecore:EClass" name="MiddleClass"
        abstract="false"
        interface="false"
        eSuperTypes="#//@eClassifiers.0 #//@eSubpackages.0/@eClassifiers.0">
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="crossToC"
          eType="#//@eClassifiers.3"
          containment="false"
          lowerBound="0"
          upperBound="-1"
          ordered="false"
          unique="false"/>
    </eClassifiers>

    <!-- 3: ChildEnum -->
    <eClassifiers xsi:type="ecore:EEnum" name="ChildEnum">
      <eLiterals name="ALPHA" value="0" literal="ALPHA"/>
      <eLiterals name="BETA" value="1" literal="BETA"/>
    </eClassifiers>

    <!-- 4: ChildClass3 using ChildEnum -->
    <eClassifiers xsi:type="ecore:EClass" name="ChildClass3">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="mode"
          eType="#//@eSubpackages.0/@eClassifiers.3"
          lowerBound="0"
          upperBound="1"
          iD="false"
          ordered="true"
          unique="true"
          defaultValueLiteral="ALPHA"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="text"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          lowerBound="0"
          upperBound="1"
          iD="false"
          ordered="true"
          unique="true"
          defaultValueLiteral="Child &quot;text&quot; 0091"/>
    </eClassifiers>

  </eSubpackages>
</ecore:EPackage>