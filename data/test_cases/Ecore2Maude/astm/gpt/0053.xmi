<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="metaRoot{53}"
    nsURI="http://example.org/metaRoot53"
    nsPrefix="mr53">

  <!-- Subpackage to trigger superPackage / subPackages equations -->
  <eSubpackages name="subPackAlpha"
      nsURI="http://example.org/metaRoot53/alpha"
      nsPrefix="mra">
    <!-- Classifiers inside subpackage -->
    <!-- idx 0 inside this package -->
    <eClassifiers xsi:type="ecore:EClass" name="AlphaBase">
      <!-- one attribute, String with default, non-ID -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="code"
          lowerBound="0"
          upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          defaultValueLiteral="AB&quot;42"
          iD="false"/>
    </eClassifiers>
    <!-- idx 1 -->
    <eClassifiers xsi:type="ecore:EEnum" name="AlphaStatus">
      <eLiterals name="NEW" value="0" literal="NEW"/>
      <eLiterals name="USED" value="1" literal="USED"/>
      <eLiterals name="ARCHIVED" value="2" literal="ARCHIVED"/>
    </eClassifiers>
    <!-- idx 2 -->
    <eClassifiers xsi:type="ecore:EClass" name="AlphaItem">
      <eSuperTypes>//@eSubpackages.0/@eClassifiers.0</eSuperTypes>
      <!-- attribute using the local enum with default -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="status"
          lowerBound="1"
          upperBound="1"
          eType="//@eSubpackages.0/@eClassifiers.1"
          defaultValueLiteral="USED"
          iD="false"/>
      <!-- reference to root package class RootEntity, no opposite -->
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="owner"
          lowerBound="0"
          upperBound="1"
          eType="//@eClassifiers.0"
          containment="false"/>
    </eClassifiers>
  </eSubpackages>

  <!-- Classifiers in root package -->
  <!-- idx 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="RootEntity">
    <!-- ID attribute with Int type, no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"/>
    <!-- String attribute with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="label"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="root&quot;entity"
        iD="false"/>
  </eClassifiers>

  <!-- idx 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="SpecialEntity">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <!-- bidirectional containment reference pair to Detail -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="details"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.2"
        containment="true"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"/>
    <!-- simple Boolean attribute without default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        iD="false"/>
  </eClassifiers>

  <!-- idx 2 -->
  <eClassifiers xsi:type="ecore:EClass" name="Detail">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <!-- opposite reference back to SpecialEntity -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.1"
        containment="false"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.0"/>
    <!-- reference with no type to exercise @NoType path in EqType -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="untypedLink"
        lowerBound="0"
        upperBound="1"
        containment="false"/>
  </eClassifiers>

  <!-- idx 3 -->
  <eClassifiers xsi:type="ecore:EEnum" name="GlobalKind">
    <eLiterals name="KIND_A" value="0" literal="KIND_A"/>
    <eLiterals name="KIND_B" value="1" literal="KIND_B"/>
  </eClassifiers>

  <!-- idx 4 -->
  <eClassifiers xsi:type="ecore:EClass" name="ConfigOption">
    <!-- attribute with EBooleanObject type, default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="enabled"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"
        defaultValueLiteral="true"
        iD="false"/>
    <!-- attribute with EDouble type, default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="ratio"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        defaultValueLiteral="3.14"
        iD="false"/>
    <!-- attribute with EIntegerObject type, no default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="limit"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"
        iD="false"/>
    <!-- attribute typed by local enum, with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="kind"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.3"
        defaultValueLiteral="KIND_B"
        iD="false"/>
  </eClassifiers>

</ecore:EPackage>