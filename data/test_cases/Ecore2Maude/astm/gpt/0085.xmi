<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootMeta"
    nsURI="http://example.org/rootMeta"
    nsPrefix="root">

  <!-- Top-level classifiers -->
  <!-- 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseEntity">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        iD="true"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="Person"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="John &quot;Johnny&quot; Doe"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="30"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="address"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="true"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- 2 -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee"
      abstract="true"
      eSuperTypes="//@eClassifiers.1 //@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="salary"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="55000.5"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="manager"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 3 -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="Main Street"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="zipCode"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="12345"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="residents"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 4 -->
  <eClassifiers xsi:type="ecore:EEnum" name="RoleKind">
    <eLiterals name="ADMIN" value="0" literal="ADMIN_LITERAL"/>
    <eLiterals name="USER" value="1" literal="USER_LITERAL"/>
    <eLiterals name="GUEST" value="2" literal="GUEST_LITERAL"/>
  </eClassifiers>

  <!-- 5 -->
  <eClassifiers xsi:type="ecore:EClass" name="Role">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="kind"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="ADMIN"
        eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- 6 -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomData"
      instanceClassName="java.lang.String"/>

  <!-- 7 -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        iD="false"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="PRJ-001"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="customInfo"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="N/A"
        eType="//@eClassifiers.6"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="team"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="-1"
        containment="false"
        eType="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="primaryRole"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- Subpackage -->
  <eSubpackages name="subMeta"
      nsURI="http://example.org/subMeta"
      nsPrefix="sub">
    <!-- 0 in subpackage -->
    <eClassifiers xsi:type="ecore:EClass" name="SubEntity">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="subName"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          defaultValueLiteral="sub-default"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eClassifiers>
    <!-- 1 in subpackage -->
    <eClassifiers xsi:type="ecore:EEnum" name="SubLevel">
      <eLiterals name="LOW" value="0" literal="LOW_LEVEL"/>
      <eLiterals name="HIGH" value="1" literal="HIGH_LEVEL"/>
    </eClassifiers>
    <!-- 2 in subpackage -->
    <eClassifiers xsi:type="ecore:EClass" name="SubHolder">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="level"
          ordered="true"
          unique="true"
          lowerBound="1"
          upperBound="1"
          defaultValueLiteral="LOW"
          eType="//@eSubpackages.0/@eClassifiers.1"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="linkedRoot"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          containment="false"
          eType="//@eClassifiers.7"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>