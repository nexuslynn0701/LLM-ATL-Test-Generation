<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="alphaPkg"
    nsURI="http://alpha/pkg"
    nsPrefix="alpha">

  <!-- Root package classifiers -->
  <!-- 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="AlphaRoot">
    <!-- One concrete class, no supers, has refs and atts -->
    <eStructuralFeatures xsi:type="eccore:EReference" name="rootChildren"
        lowerBound="0" upperBound="-1"
        eType="//@eSubpackages.0/@eClassifiers.0"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rootToGamma"
        lowerBound="0" upperBound="1"
        eType="//@eSubpackages.0/@eClassifiers.1"
        containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rootName"
        lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rootFlag"
        lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        iD="false"
        defaultValueLiteral="true"/>
  </eClassifiers>

  <!-- 1: an EEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="AlphaState">
    <eLiterals name="STATE_ONE" value="0" literal="STATE_ONE"/>
    <eLiterals name="STATE_TWO" value="1" literal="STATE_TWO"/>
  </eClassifiers>

  <!-- 2 -->
  <eClassifiers xsi:type="ecore:EClass" name="AlphaBase" abstract="true" interface="false">
    <!-- Base abstract class with no features -->
  </eClassifiers>

  <!-- 3 -->
  <eClassifiers xsi:type="ecore:EClass" name="AlphaDerived"
      abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.2">
    <!-- Derived class, one reference and one attribute using enum -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="toRoot"
        lowerBound="1" upperBound="1"
        eType="//@eClassifiers.0"
        containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="state"
        lowerBound="1" upperBound="1"
        eType="//@eClassifiers.1"
        iD="false"
        defaultValueLiteral="STATE_TWO"/>
  </eClassifiers>

  <!-- Subpackage -->
  <eSubpackages name="betaPkg" nsURI="http://alpha/beta" nsPrefix="beta">
    <!-- 0 in subpackage: BetaNode, has bidirectional reference and attributes -->
    <eClassifiers xsi:type="ecore:EClass" name="BetaNode" abstract="false" interface="false">
      <eStructuralFeatures xsi:type="ecore:EReference" name="next"
          lowerBound="0" upperBound="1"
          eType="//@eSubpackages.0/@eClassifiers.0"
          eOpposite="//@eSubpackages.0/@eClassifiers.0/@eStructuralFeatures.1"
          containment="false"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="prev"
          lowerBound="0" upperBound="-1"
          eType="//@eSubpackages.0/@eClassifiers.0"
          eOpposite="//@eSubpackages.0/@eClassifiers.0/@eStructuralFeatures.0"
          containment="false"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="nodeId"
          lowerBound="1" upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
          iD="true"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
          lowerBound="0" upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          iD="false"
          defaultValueLiteral="beta &quot;node&quot;"/>
    </eClassifiers>

    <!-- 1 in subpackage: Gamma, super type chain and containment of BetaNode -->
    <eClassifiers xsi:type="ecore:EClass" name="Gamma"
        abstract="false" interface="false"
        eSuperTypes="//@eClassifiers.3 //@eClassifiers.0">
      <eStructuralFeatures xsi:type="ecore:EReference" name="ownedNodes"
          lowerBound="1" upperBound="-1"
          eType="//@eSubpackages.0/@eClassifiers.0"
          containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="gammaNumber"
          lowerBound="0" upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
          iD="false"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="gammaFlag"
          lowerBound="0" upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
          iD="false"
          defaultValueLiteral="false"/>
    </eClassifiers>

    <!-- 2 in subpackage: an extra EEnum with single literal -->
    <eClassifiers xsi:type="ecore:EEnum" name="BetaKind">
      <eLiterals name="KIND_MAIN" value="0" literal="KIND_MAIN"/>
    </eClassifiers>

  </eSubpackages>
</ecore:EPackage>