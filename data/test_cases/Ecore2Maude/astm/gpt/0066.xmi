<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="mm0066"
    nsURI="http://mm0066"
    nsPrefix="mm0066">

  <!-- Classifiers -->
  <!-- 0: Root class, no super types, both attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="RootEntity">
    <!-- Attributes (2) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        lowerBound="1" upperBound="1" iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag"
        lowerBound="0" upperBound="1" iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- References (2) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="items"
        lowerBound="0" upperBound="-1"
        containment="true" resolveProxies="true"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="partner"
        lowerBound="0" upperBound="1"
        containment="false" resolveProxies="true"
        eType="//@eClassifiers.2"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- 1: Leaf class with attribute having default value -->
  <eClassifiers xsi:type="ecore:EClass" name="Item">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        lowerBound="0" upperBound="1" iD="false"
        defaultValueLiteral="42"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 2: Class with opposite reference, super type, and enum-typed attribute -->
  <eClassifiers xsi:type="ecore:EClass" name="Partner">
    <!-- super type = RootEntity (index 0) -->
    <eSuperTypes href="//@eClassifiers.0"/>
    <!-- opposite reference back to RootEntity.partner -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner"
        lowerBound="0" upperBound="1"
        containment="false" resolveProxies="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"/>
    <!-- enum-typed attribute with default literal -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        lowerBound="0" upperBound="1" iD="false"
        defaultValueLiteral="ACTIVE"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- 3: Enumeration with three literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
    <eLiterals name="PENDING" value="2" literal="PENDING"/>
  </eClassifiers>

  <!-- 4: Additional class to give multiple super types and references -->
  <eClassifiers xsi:type="ecore:EClass" name="ExtendedPartner">
    <!-- multiple super types: Partner (2) and RootEntity (0) -->
    <eSuperTypes href="//@eClassifiers.2"/>
    <eSuperTypes href="//@eClassifiers.0"/>
    <!-- reference with no opposite and upperBound = -1 -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="relatedPartners"
        lowerBound="0" upperBound="-1"
        containment="false" resolveProxies="true"
        eType="//@eClassifiers.2"/>
    <!-- string attribute with escaped default value including quotes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        lowerBound="0" upperBound="1" iD="false"
        defaultValueLiteral="&quot;quoted&quot; text"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>