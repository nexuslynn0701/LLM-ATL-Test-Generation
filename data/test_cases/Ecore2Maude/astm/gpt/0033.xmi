<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="metaRoot"
    nsURI="http://metaroot/0033"
    nsPrefix="mr">

  <!-- Root package classifiers -->
  <!-- 0: EClass -->
  <eClassifiers xsi:type="ecore:EClass" name="RootElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="ROOT-001"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0"
        upperBound="1"
        ordered="false"
        unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="primaryChild"
        eType="//@eClassifiers.4"
        lowerBound="1"
        upperBound="1"
        containment="true"
        ordered="true"
        resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="linkedAbstract"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        ordered="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- 1: abstract super EClass -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseNode" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="baseName"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"/>
  </eClassifiers>

  <!-- 2: concrete subclass with superType BaseNode -->
  <eClassifiers xsi:type="ecore:EClass" name="ConcreteNode"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="value"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="7"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parent"
        eType="//@eClassifiers.4"
        lowerBound="0"
        upperBound="1"
        containment="false"
        ordered="true"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- 3: EEnum with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="PriorityLevel">
    <eLiterals name="LOW" value="0" literal="LOW"/>
    <eLiterals name="HIGH" value="1" literal="HIGH"/>
  </eClassifiers>

  <!-- 4: EClass referencing enum and subclass, used as child of RootElement -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildContainer">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="priority"
        iD="false"
        eType="//@eClassifiers.3"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="HIGH"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="description"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="&quot;Quoted&quot; text"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="nodes"
        eType="//@eClassifiers.2"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        ordered="true"
        resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="sibling"
        eType="//@eClassifiers.4"
        lowerBound="0"
        upperBound="1"
        containment="false"
        ordered="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- 5: additional EEnum to ensure multiple enums -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusFlag">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
    <eLiterals name="PENDING" value="2" literal="PENDING"/>
  </eClassifiers>

  <!-- 6: EClass using another enum and an attribute with no default -->
  <eClassifiers xsi:type="ecore:EClass" name="StatusHolder">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        iD="false"
        eType="//@eClassifiers.5"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="ACTIVE"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="note"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        ordered="false"
        unique="false"/>
  </eClassifiers>

  <!-- 7: EDataType to trigger EqPackage on datatype as classifier -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomData"
      instanceClassName="java.lang.String"/>

  <!-- Subpackage with its own classifiers -->
  <eSubpackages name="subSection"
      nsURI="http://metaroot/0033/sub"
      nsPrefix="mrs">
    <!-- 0: EClass inside subpackage with superType RootElement from root pkg -->
    <eClassifiers xsi:type="ecore:EClass" name="SubElement"
        eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="subCode"
          iD="false"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          lowerBound="1"
          upperBound="1"
          ordered="true"
          unique="true"
          defaultValueLiteral="SUB-1"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="statusRef"
          eType="//@eClassifiers.6"
          lowerBound="0"
          upperBound="1"
          containment="false"
          ordered="true"
          resolveProxies="true"/>
    </eClassifiers>

    <!-- 1: EEnum in subpackage -->
    <eClassifiers xsi:type="ecore:EEnum" name="SubMode">
      <eLiterals name="MODE_A" value="0" literal="MODE_A"/>
      <eLiterals name="MODE_B" value="1" literal="MODE_B"/>
    </eClassifiers>

    <!-- 2: EClass that uses SubMode enum -->
    <eClassifiers xsi:type="ecore:EClass" name="ModeHolder">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="mode"
          iD="false"
          eType="//@eSubpackages.0/@eClassifiers.1"
          lowerBound="1"
          upperBound="1"
          ordered="true"
          unique="true"
          defaultValueLiteral="MODE_B"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="owner"
          eType="//@eClassifiers.0"
          lowerBound="0"
          upperBound="1"
          containment="false"
          ordered="false"
          resolveProxies="true"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>