<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="metaRoot52"
    nsURI="http://example.org/metaRoot52"
    nsPrefix="mr52">

  <!-- Root package classifiers (index 0..5) -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="id"
                         iD="true"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                         lowerBound="1"
                         upperBound="1"
                         defaultValueLiteral="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="name"
                         iD="false"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                         lowerBound="1"
                         upperBound="1"
                         defaultValueLiteral="John &quot;J&quot; Doe"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Employee"
                eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="salary"
                         iD="false"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
                         lowerBound="0"
                         upperBound="1"
                         defaultValueLiteral="1000.0"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="deptCode"
                         iD="true"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                         lowerBound="1"
                         upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="employees"
                         eType="//@eClassifiers.1"
                         lowerBound="0"
                         upperBound="-1"
                         containment="true"
                         resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="manager"
                         eType="//@eClassifiers.1"
                         lowerBound="0"
                         upperBound="1"
                         containment="false"
                         resolveProxies="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Company">
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="departments"
                         eType="//@eClassifiers.2"
                         lowerBound="1"
                         upperBound="-1"
                         containment="true"
                         resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="foundedYear"
                         iD="false"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                         lowerBound="0"
                         upperBound="1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="RoleKind">
    <eLiterals name="DEV" value="0" literal="DEV_LITERAL"/>
    <eLiterals name="MANAGER" value="1" literal="MANAGER_LITERAL"/>
    <eLiterals name="HR" value="2" literal="HR_LITERAL"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="RoleAssignment">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="role"
                         iD="false"
                         eType="//@eClassifiers.4"
                         lowerBound="1"
                         upperBound="1"
                         defaultValueLiteral="MANAGER"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="employee"
                         eType="//@eClassifiers.1"
                         lowerBound="1"
                         upperBound="1"
                         containment="false"
                         resolveProxies="true"/>
  </eClassifiers>

  <!-- Subpackage contained in root (index 0 of eSubpackages) -->
  <eSubpackages name="subAnalytics"
                nsURI="http://example.org/metaRoot52/analytics"
                nsPrefix="an52">
    <!-- Classifiers inside subpackage (indices 0..2 relative to this package) -->
    <eClassifiers xsi:type="ecore:EClass" name="Report">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="title"
                           iD="false"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                           lowerBound="1"
                           upperBound="1"
                           defaultValueLiteral="Quarterly Summary"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="author"
                           eType="//@eClassifiers.0"
                           lowerBound="0"
                           upperBound="1"
                           containment="false"
                           resolveProxies="true"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="Chart">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="width"
                           iD="false"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                           lowerBound="0"
                           upperBound="1"
                           defaultValueLiteral="800"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="height"
                           iD="false"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                           lowerBound="0"
                           upperBound="1"
                           defaultValueLiteral="600"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="report"
                           eType="//@eSubpackages.0/@eClassifiers.0"
                           lowerBound="1"
                           upperBound="1"
                           containment="false"
                           resolveProxies="true"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EEnum" name="ChartType">
      <eLiterals name="BAR" value="0" literal="BAR_LITERAL"/>
      <eLiterals name="LINE" value="1" literal="LINE_LITERAL"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>