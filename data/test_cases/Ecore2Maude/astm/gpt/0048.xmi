<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg48"
    nsURI="http://example.org/root48"
    nsPrefix="r48">

  <!-- Subpackage to exercise superPackage/subPackages rules -->
  <eSubpackages name="childPkg48"
                nsURI="http://example.org/root48/child"
                nsPrefix="c48">
    <!-- EClass in subpackage: single supertype, attributes and references -->
    <eClassifiers xsi:type="ecore:EClass" name="ChildEntity">
      <!-- super type is first classifier of root package (index 0 there, 4 here globally) -->
      <eSuperTypes href="//@eClassifiers.4"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="childCode"
                           lowerBound="1"
                           upperBound="1"
                           iD="false">
        <eType xsi:type="ecore:EDataType"
               href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      </eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="parent"
                           lowerBound="1"
                           upperBound="1"
                           containment="false">
        <!-- reference back to rootPkg48.EClass Person (index 4) -->
        <eType xsi:type="ecore:EClass" href="//@eClassifiers.4"/>
      </eStructuralFeatures>
    </eClassifiers>

    <!-- EEnum in subpackage with three literals -->
    <eClassifiers xsi:type="ecore:EEnum" name="ChildStatus">
      <eLiterals name="NEW" value="0" literal="NEW"/>
      <eLiterals name="ACTIVE" value="1" literal="ACTIVE"/>
      <eLiterals name="ARCHIVED" value="2" literal="ARCHIVED"/>
    </eClassifiers>
  </eSubpackages>

  <!-- EEnum in root package with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="PriorityLevel">
    <eLiterals name="LOW" value="0" literal="LOW"/>
    <eLiterals name="HIGH" value="1" literal="HIGH"/>
  </eClassifiers>

  <!-- Simple datatype (not one of the standard primitives) -->
  <eClassifiers xsi:type="ecore:EDataType"
                name="CustomCode"
                instanceClassName="java.lang.String"/>

  <!-- Abstract base class with no supertypes -->
  <eClassifiers xsi:type="ecore:EClass"
                name="AbstractElement"
                abstract="true"
                interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="uid"
                         iD="true"
                         lowerBound="1"
                         upperBound="1">
      <eType xsi:type="ecore:EDataType"
             href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- Concrete class extending AbstractElement, with various features -->
  <eClassifiers xsi:type="ecore:EClass"
                name="Person"
                abstract="false"
                interface="false">
    <!-- super type is AbstractElement (index 2) -->
    <eSuperTypes href="//@eClassifiers.2"/>

    <!-- Attribute: standard EString with default and not ID -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="name"
                         lowerBound="1"
                         upperBound="1"
                         ordered="true"
                         unique="true"
                         defaultValueLiteral="John &quot;Doe&quot;"
                         iD="false">
      <eType xsi:type="ecore:EDataType"
             href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eStructuralFeatures>

    <!-- Attribute: Boolean using EBooleanObject, different default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="active"
                         lowerBound="0"
                         upperBound="1"
                         ordered="false"
                         unique="true"
                         defaultValueLiteral="true"
                         iD="false">
      <eType xsi:type="ecore:EDataType"
             href="http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"/>
    </eStructuralFeatures>

    <!-- Attribute: Int using EInt with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="age"
                         lowerBound="0"
                         upperBound="1"
                         ordered="true"
                         unique="false"
                         defaultValueLiteral="30"
                         iD="false">
      <eType xsi:type="eccore:EDataType"
             href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eStructuralFeatures>

    <!-- Attribute: Float using EDouble -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="rating"
                         lowerBound="0"
                         upperBound="1"
                         ordered="true"
                         unique="true"
                         defaultValueLiteral="3.5"
                         iD="false">
      <eType xsi:type="ecore:EDataType"
             href="http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    </eStructuralFeatures>

    <!-- Attribute: custom datatype; tests '@DataType' branch in attDataType -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="code"
                         lowerBound="0"
                         upperBound="1"
                         ordered="true"
                         unique="true"
                         iD="false">
      <eType xsi:type="ecore:EDataType" href="//@eClassifiers.1"/>
    </eStructuralFeatures>

    <!-- Attribute: enum-typed without default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="priority"
                         lowerBound="0"
                         upperBound="1"
                         ordered="true"
                         unique="true"
                         iD="false">
      <eType xsi:type="ecore:EEnum" href="//@eClassifiers.0"/>
    </eStructuralFeatures>

    <!-- Reference: containment, many-valued, with opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="children"
                         lowerBound="0"
                         upperBound="-1"
                         ordered="true"
                         unique="true"
                         containment="true"
                         resolveProxies="true">
      <!-- containment to subpackage ChildEntity (index 3) -->
      <eType xsi:type="ecore:EClass" href="//@eSubpackages.0/@eClassifiers.0"/>
      <!-- opposite will be set in ChildEntity.ref back to this (see below with eOpposite) -->
    </eStructuralFeatures>

    <!-- Reference: non-containment, optional, no opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="bestFriend"
                         lowerBound="0"
                         upperBound="1"
                         ordered="false"
                         unique="false"
                         containment="false"
                         resolveProxies="true">
      <eType xsi:type="ecore:EClass" href="//@eClassifiers.3"/>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- Another concrete class extending AbstractElement, to test multiple supertypes lists -->
  <eClassifiers xsi:type="ecore:EClass"
                name="Employee"
                abstract="false"
                interface="false">
    <!-- two supertypes: AbstractElement (2) and Person (3) -->
    <eSuperTypes href="//@eClassifiers.2 //@eClassifiers.3"/>

    <!-- Enum-typed attribute with default literal -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="priorityOverride"
                         lowerBound="0"
                         upperBound="1"
                         ordered="true"
                         unique="true"
                         defaultValueLiteral="HIGH"
                         iD="false">
      <eType xsi:type="ecore:EEnum" href="//@eClassifiers.0"/>
    </eStructuralFeatures>

    <!-- Reference: many-valued, non-containment -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="manages"
                         lowerBound="0"
                         upperBound="-1"
                         ordered="true"
                         unique="true"
                         containment="false"
                         resolveProxies="true">
      <eType xsi:type="ecore:EClass" href="//@eClassifiers.3"/>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- Fill in the eOpposite for Person.children / ChildEntity.parent -->
  <!-- This must appear after both EClasses are defined -->
  <!-- We re-open the structural features to assign eOpposite via href -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false" xmi:id="_personRefPatch"/>
  <eClassifiers xsi:type="ecore:EClass" name="ChildEntity" abstract="false" interface="false" xmi:id="_childRefPatch"/>

</ecore:EPackage>