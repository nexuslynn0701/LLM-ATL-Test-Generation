<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="metaRoot{A}"
    nsURI="http://example.org/metaRootA"
    nsPrefix="mra">

  <!-- Root-level EClassifiers (indices 0..5) -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseRoot" abstract="false" interface="false">
    <!-- 0: BaseRoot -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0" upperBound="1" ordered="true" unique="true"
        defaultValueLiteral="root&quot;Code"
        iD="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="SubRootOne" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- 1: SubRootOne extends BaseRoot -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="1" upperBound="1" ordered="true" unique="true"
        defaultValueLiteral="true"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rootToLeaf"
        eType="//@eSubpackages.0/@eClassifiers.0"
        lowerBound="0" upperBound="-1" ordered="true" unique="true"
        containment="false" resolveProxies="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="SubRootTwo" abstract="true" interface="false"
      eSuperTypes="//@eClassifiers.0 //@eSubpackages.1/@eClassifiers.0">
    <!-- 2: SubRootTwo extends BaseRoot and SharedNode -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priority"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0" upperBound="1" ordered="true" unique="true"
        defaultValueLiteral="5"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="oppositeRef"
        eType="//@eClassifiers.3"
        lowerBound="0" upperBound="1" ordered="true" unique="true"
        containment="false" resolveProxies="true"
        eOpposite="//@eClassifiers.3/@eStructuralFeatures.0"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="RootWithNoSupers" abstract="false" interface="false">
    <!-- 3: RootWithNoSupers, referenced with opposite -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="refBack"
        eType="//@eClassifiers.2"
        lowerBound="1" upperBound="-1" ordered="false" unique="false"
        containment="true" resolveProxies="true"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <!-- 4: StatusKind enum -->
    <eLiterals name="NEW" value="0" literal="new"/>
    <eLiterals name="IN_PROGRESS" value="1" literal="inProgress"/>
    <eLiterals name="DONE" value="2" literal="done"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="EnumHolder" abstract="false" interface="false">
    <!-- 5: EnumHolder class using StatusKind and String attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="//@eClassifiers.4"
        lowerBound="1" upperBound="1" ordered="true" unique="true"
        defaultValueLiteral="IN_PROGRESS"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0" upperBound="1" ordered="true" unique="true"
        defaultValueLiteral="&quot;quoted&quot; label"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="genericData"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EJavaObject"
        lowerBound="0" upperBound="-1" ordered="true" unique="false"
        iD="false"/>
  </eClassifiers>

  <!-- Subpackages (indices 0..1) -->

  <eSubpackages name="leafPkg" nsURI="http://example.org/leafPkg" nsPrefix="lp">
    <!-- eSubpackages.0 -->
    <eClassifiers xsi:type="ecore:EClass" name="LeafNode" abstract="false" interface="false">
      <!-- 0: LeafNode in leafPkg -->
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
          lowerBound="0" upperBound="1" ordered="true" unique="true"
          defaultValueLiteral="0"
          iD="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="shared"
          eType="//@eSubpackages.1/@eClassifiers.0"
          lowerBound="1" upperBound="1" ordered="true" unique="true"
          containment="false" resolveProxies="true"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="LeafContainer" abstract="false" interface="false">
      <!-- 1: LeafContainer in leafPkg -->
      <eStructuralFeatures xsi:type="ecore:EReference" name="children"
          eType="//@eSubpackages.0/@eClassifiers.0"
          lowerBound="0" upperBound="-1" ordered="true" unique="true"
          containment="true" resolveProxies="true"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="containerName"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          lowerBound="1" upperBound="1" ordered="false" unique="false"
          defaultValueLiteral="leaf{container}"
          iD="false"/>
    </eClassifiers>
  </eSubpackages>

  <eSubpackages name="sharedPkg" nsURI="http://example.org/sharedPkg" nsPrefix="sp">
    <!-- eSubpackages.1 -->
    <eClassifiers xsi:type="ecore:EClass" name="SharedNode" abstract="false" interface="false">
      <!-- 0: SharedNode in sharedPkg -->
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="sharedName"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          lowerBound="1" upperBound="1" ordered="true" unique="true"
          defaultValueLiteral="shared"
          iD="false"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="containingLeaf"
          eType="//@eSubpackages.0/@eClassifiers.1"
          lowerBound="0" upperBound="1" ordered="true" unique="true"
          containment="false" resolveProxies="true"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EEnum" name="LocalFlag">
      <!-- 1: LocalFlag enum in sharedPkg, with single literal -->
      <eLiterals name="ACTIVE" value="0" literal="active"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>