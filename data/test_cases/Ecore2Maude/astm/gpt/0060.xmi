<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg60"
    nsURI="http://example.org/rootPkg60"
    nsPrefix="rp60">

  <!-- Root-level classifiers (indices 0..6) -->
  <!-- 0: Abstract superclass -->
  <eClassifiers xsi:type="ecore:EClass" name="AbstractItem" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"
        defaultValueLiteral="DEF-CODE"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        iD="false"/>
  </eClassifiers>

  <!-- 1: Concrete subclass with attributes, refs, supertypes -->
  <eClassifiers xsi:type="ecore:EClass" name="Product" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="price"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        iD="false"
        defaultValueLiteral="0.0"/>
    <!-- Non-containment reference to Category, many-valued, opposite set in Category -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="category"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"
        containment="false"
        resolveProxies="true"/>
    <!-- Containment reference to nested Detail elements, 0..* -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="details"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.4"
        containment="true"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- 2: Category with opposite reference and supertype AbstractItem -->
  <eClassifiers xsi:type="ecore:EClass" name="Category" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="label"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <!-- Opposite, non-containment, many-valued -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="products"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.1"
        containment="false"
        resolveProxies="true"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- 3: Enum with multiple literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="ACTIVE" value="1" literal="ACTIVE"/>
    <eLiterals name="DISCONTINUED" value="2" literal="DISCONTINUED"/>
  </eClassifiers>

  <!-- 4: Detail class contained by Product -->
  <eClassifiers xsi:type="ecore:EClass" name="Detail" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="description"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.3"
        iD="false"
        defaultValueLiteral="ACTIVE"/>
  </eClassifiers>

  <!-- 5: Extra class with no features (to test EmptyList in ClassEq*) -->
  <eClassifiers xsi:type="ecore:EClass" name="EmptyEntity" abstract="false" interface="false"/>

  <!-- 6: Extra enum with single literal (to test EqLiterals single case) -->
  <eClassifiers xsi:type="ecore:EEnum" name="SingleFlag">
    <eLiterals name="ONLY" value="0" literal="ONLY"/>
  </eClassifiers>

  <!-- Subpackage hierarchy (to cover superPackage/subPackages and multiple root packages) -->
  <eSubpackages name="subLevelA"
      nsURI="http://example.org/rootPkg60/subA"
      nsPrefix="rp60a">
    <!-- 0: class in subpackage with reference up to root package class -->
    <eClassifiers xsi:type="ecore:EClass" name="SubAClass" abstract="false" interface="false">
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="mainProduct"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          eType="//@eClassifiers.1"
          containment="false"
          resolveProxies="true"/>
    </eClassifiers>
    <!-- 1: enum in subpackage -->
    <eClassifiers xsi:type="ecore:EEnum" name="SubAEnum">
      <eLiterals name="A1" value="0" literal="A1"/>
      <eLiterals name="A2" value="1" literal="A2"/>
    </eClassifiers>
    <!-- nested subpackage B inside A -->
    <eSubpackages name="subLevelB"
        nsURI="http://example.org/rootPkg60/subA/subB"
        nsPrefix="rp60b">
      <!-- 0: class in nested subpackage -->
      <eClassifiers xsi:type="ecore:EClass" name="SubBClass" abstract="false" interface="false">
        <eStructuralFeatures xsi:type="ecore:EAttribute"
            name="flag"
            ordered="true"
            unique="true"
            lowerBound="0"
            upperBound="1"
            eType="//@eSuperPackage/@eClassifiers.6"
            iD="false"
            defaultValueLiteral="ONLY"/>
      </eClassifiers>
    </eSubpackages>
  </eSubpackages>

</ecore:EPackage>