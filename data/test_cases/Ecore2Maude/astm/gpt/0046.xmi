<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://example.org/rootPkg"
    nsPrefix="root">

  <!-- Subpackage with classes and enums -->
  <eSubpackages name="subPkg1"
                nsURI="http://example.org/subPkg1"
                nsPrefix="sub1">

    <!-- Class 0: Person -->
    <eClassifiers xsi:type="ecore:EClass" name="Person">
      <!-- Attribute: id (EInt, is ID, with default) -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="id"
                           ordered="true"
                           unique="true"
                           lowerBound="1"
                           upperBound="1"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                           iD="true"
                           defaultValueLiteral="0"/>
      <!-- Attribute: name (EString, with default and quotes) -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="name"
                           ordered="true"
                           unique="true"
                           lowerBound="0"
                           upperBound="1"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                           iD="false"
                           defaultValueLiteral="&quot;unknown&quot;"/>
      <!-- Attribute: status (enum EmploymentStatus, no default) -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="status"
                           ordered="true"
                           unique="true"
                           lowerBound="0"
                           upperBound="1"
                           eType="//@eSubpackages.0/@eClassifiers.2"
                           iD="false"/>
      <!-- Reference: addresses (multi, containment, opposite of resident) -->
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="addresses"
                           ordered="true"
                           unique="true"
                           lowerBound="0"
                           upperBound="-1"
                           eType="//@eSubpackages.0/@eClassifiers.1"
                           containment="true"
                           resolveProxies="true"
                           eOpposite="//@eSubpackages.0/@eClassifiers.1/@eStructuralFeatures.0"/>
    </eClassifiers>

    <!-- Class 1: Address, superclass of WorkAddress -->
    <eClassifiers xsi:type="ecore:EClass" name="Address">
      <!-- Reference: resident (single, opposite, non-containment) -->
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="resident"
                           ordered="true"
                           unique="true"
                           lowerBound="0"
                           upperBound="1"
                           eType="//@eSubpackages.0/@eClassifiers.0"
                           containment="false"
                           resolveProxies="true"
                           eOpposite="//@eSubpackages.0/@eClassifiers.0/@eStructuralFeatures.3"/>
      <!-- Attribute: city (EString, no default) -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="city"
                           ordered="true"
                           unique="true"
                           lowerBound="0"
                           upperBound="1"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                           iD="false"/>
    </eClassifiers>

    <!-- Enum 2: EmploymentStatus -->
    <eClassifiers xsi:type="ecore:EEnum" name="EmploymentStatus">
      <eLiterals name="EMPLOYED" value="0" literal="EMPLOYED"/>
      <eLiterals name="UNEMPLOYED" value="1" literal="UNEMPLOYED"/>
      <eLiterals name="STUDENT" value="2" literal="STUDENT"/>
    </eClassifiers>

    <!-- Enum 3: Priority -->
    <eClassifiers xsi:type="ecore:EEnum" name="Priority">
      <eLiterals name="LOW" value="0" literal="LOW"/>
      <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
      <eLiterals name="HIGH" value="2" literal="HIGH"/>
      <eLiterals name="URGENT" value="3" literal="URGENT"/>
    </eClassifiers>

    <!-- Class 4: WorkAddress extends Address, with reference and attribute using Priority enum -->
    <eClassifiers xsi:type="ecore:EClass" name="WorkAddress">
      <!-- Super type Address -->
      <eSuperTypes href="//@eSubpackages.0/@eClassifiers.1"/>
      <!-- Attribute: building (EString, default with escaped quote) -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="building"
                           ordered="true"
                           unique="true"
                           lowerBound="0"
                           upperBound="1"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                           iD="false"
                           defaultValueLiteral="Main &quot;Tower&quot;"/>
      <!-- Reference: supervisor (single, non-containment, no opposite) -->
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="supervisor"
                           ordered="true"
                           unique="true"
                           lowerBound="0"
                           upperBound="1"
                           eType="//@eSubpackages.0/@eClassifiers.0"
                           containment="false"
                           resolveProxies="true"/>
      <!-- Attribute: priority (enum Priority, default literal) -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="priority"
                           ordered="true"
                           unique="true"
                           lowerBound="0"
                           upperBound="1"
                           eType="//@eSubpackages.0/@eClassifiers.3"
                           iD="false"
                           defaultValueLiteral="HIGH"/>
    </eClassifiers>

  </eSubpackages>

  <!-- Classifier directly in root package: Project, with attributes and reference -->
  <eClassifiers xsi:type="ecore:EClass" name="Project" abstract="true">
    <!-- Attribute: code (String, with default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="code"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                         iD="false"
                         defaultValueLiteral="PRJ-000"/>
    <!-- Attribute: active (Boolean, no default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="active"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
                         iD="false"/>
    <!-- Reference: lead (single, non-containment) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="lead"
                         ordered="true"
                         unique="true"
                         lowerBound="0"
                         upperBound="1"
                         eType="//@eSubpackages.0/@eClassifiers.0"
                         containment="false"
                         resolveProxies="true"/>
  </eClassifiers>

  <!-- Data type to trigger generic @DataType in attDataType helper -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDecimal" instanceClassName="java.math.BigDecimal"/>

</ecore:EPackage>