<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://example/rootPkg"
    nsPrefix="root">

  <!-- Classifiers 0..2: EClasses -->
  <eClassifiers xsi:type="ecore:EClass" name="RootClass">
    <!-- Attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id"
        ordered="true" unique="true" lowerBound="1" upperBound="1"
        defaultValueLiteral="100"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"
        ordered="false" unique="false" lowerBound="0" upperBound="1"
        defaultValueLiteral="&quot;Untitled root&quot;"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        iD="false"/>
    <!-- References -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="children"
        ordered="true" unique="true" lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tags"
        ordered="false" unique="true" lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.2" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ChildClass"
      abstract="true" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        ordered="true" unique="true" lowerBound="1" upperBound="1"
        defaultValueLiteral="C-01"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="level"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="false"/>
    <!-- References -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        eType="//@eClassifiers.0" eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"
        containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subChild"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        eType="//@eClassifiers.3" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Tag"
      abstract="false" interface="false">
    <!-- Attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        ordered="true" unique="true" lowerBound="1" upperBound="1"
        defaultValueLiteral="defaultTag"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"
        iD="false"/>
    <!-- References -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        eType="//@eClassifiers.0" containment="false"/>
  </eClassifiers>

  <!-- Classifier 3: EClass extending ChildClass and RootClass -->
  <eClassifiers xsi:type="ecore:EClass" name="DeepChild"
      abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1 //@eClassifiers.0">
    <!-- Attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priority"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        defaultValueLiteral="5"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="note"
        ordered="true" unique="false" lowerBound="0" upperBound="1"
        defaultValueLiteral="multi line &quot;note&quot;"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <!-- References -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="related"
        ordered="true" unique="true" lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.3" containment="false"/>
  </eClassifiers>

  <!-- Classifier 4: EEnum with three literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="IN_PROGRESS" value="1" literal="IN_PROGRESS"/>
    <eLiterals name="DONE" value="2" literal="DONE"/>
  </eClassifiers>

  <!-- Classifier 5: EClass using the EEnum and extra references -->
  <eClassifiers xsi:type="ecore:EClass" name="Task">
    <!-- Attributes using enum and primitive types -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        ordered="true" unique="true" lowerBound="1" upperBound="1"
        defaultValueLiteral="NEW"
        eType="//@eClassifiers.4"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        ordered="true" unique="false" lowerBound="0" upperBound="1"
        defaultValueLiteral="&quot;No description&quot;"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="estimate"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        iD="false"/>
    <!-- References, including an opposite and * upper bound -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownerRoot"
        ordered="true" unique="true" lowerBound="1" upperBound="1"
        eType="//@eClassifiers.0" containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="primaryTag"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        eType="//@eClassifiers.2" containment="false"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="relatedTasks"
        ordered="false" unique="true" lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.5" containment="false"/>
  </eClassifiers>

  <!-- Classifier 6: Another EEnum with single literal -->
  <eClassifiers xsi:type="ecore:EEnum" name="SimpleFlag">
    <eLiterals name="ON" value="0" literal="ON"/>
  </eClassifiers>

  <!-- Subpackage to exercise super/subpackage rules and multi-root handling -->
  <eSubpackages name="subPkg"
      nsURI="http://example/rootPkg/sub"
      nsPrefix="sub">
    <!-- Subpackage classifiers 0..2 (relative to subpackage) -->
    <eClassifiers xsi:type="ecore:EClass" name="SubRoot">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="subName"
          ordered="true" unique="true" lowerBound="1" upperBound="1"
          defaultValueLiteral="&quot;SubRoot&quot;"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          iD="false"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="linkedTask"
          ordered="true" unique="true" lowerBound="0" upperBound="1"
          eType="//@eClassifiers.5" containment="false"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="SubItem">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
          ordered="true" unique="true" lowerBound="0" upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
          iD="false"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="ownerSubRoot"
          ordered="true" unique="true" lowerBound="0" upperBound="1"
          eType="//@eSubpackages.0/@eClassifiers.0" containment="false"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="SubChild"
        eSuperTypes="//@eSubpackages.0/@eClassifiers.0">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="flagLocal"
          ordered="true" unique="true" lowerBound="0" upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
          iD="false"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>