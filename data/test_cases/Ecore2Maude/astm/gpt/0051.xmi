<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://example.com/rootPkg"
    nsPrefix="root">

  <!-- Classifiers in root package -->
  <!-- 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="RootAbstract" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootId"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="RID-001"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true"/>
  </eClassifiers>

  <!-- 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="MidLevel" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="midName"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="mid&quot;level"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="toLeaf"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 2 -->
  <eClassifiers xsi:type="ecore:EClass" name="Leaf" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="leafInt"
        ordered="false"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="7"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="backToMid"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        containment="false"
        resolveProxies="true"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 3 -->
  <eClassifiers xsi:type="eccore:EClass" name="Standalone" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="standaloneFloat"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        defaultValueLiteral="3.14"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="description"
        ordered="false"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 4 -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="IN_PROGRESS" value="1" literal="IN_PROGRESS"/>
    <eLiterals name="DONE" value="2" literal="DONE"/>
  </eClassifiers>

  <!-- 5 -->
  <eClassifiers xsi:type="ecore:EClass" name="Task" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="T-001"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="priority"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eAttributeType="//@eClassifiers.4"
        defaultValueLiteral="NEW"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="related"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- Subpackage with its own classifiers -->
  <eSubpackages name="subPkg"
      nsURI="http://example.com/subPkg"
      nsPrefix="sub">
    <!-- 0 in subPkg -->
    <eClassifiers xsi:type="ecore:EClass" name="SubRoot" abstract="true" interface="false">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="subLabel"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          iD="false"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          defaultValueLiteral="default-sub"/>
    </eClassifiers>

    <!-- 1 in subPkg -->
    <eClassifiers xsi:type="ecore:EClass" name="SubChild" abstract="false" interface="false"
        eSuperTypes="//@eSubpackages.0/@eClassifiers.0">
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="toRootMid"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          containment="false"
          resolveProxies="true"
          eType="//@eClassifiers.1"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="estimate"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          iD="false"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eClassifiers>

    <!-- 2 in subPkg -->
    <eClassifiers xsi:type="ecore:EEnum" name="SubLevel">
      <eLiterals name="LOW" value="0" literal="LOW"/>
      <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
      <eLiterals name="HIGH" value="2" literal="HIGH"/>
    </eClassifiers>

    <!-- 3 in subPkg -->
    <eClassifiers xsi:type="ecore:EClass" name="Configured" abstract="false" interface="false">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="level"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          iD="false"
          eAttributeType="//@eSubpackages.0/@eClassifiers.2"
          defaultValueLiteral="MEDIUM"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="ownerTask"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          containment="false"
          resolveProxies="true"
          eType="//@eClassifiers.5"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>