<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="meta77"
    nsURI="http://meta77"
    nsPrefix="m77">

  <!-- Root package classifiers -->
  <!-- 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="Alpha"
                abstract="true"
                interface="false">
    <!-- Structural features of Alpha -->
    <!-- sf0: attribute idA -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="idA"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="0"
        unsettable="false"
        derived="false"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- sf1: attribute code (String with default and quotes to exercise AttEqSpecificDefaultValue / escapeQuotes) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="hello &quot;world&quot;"
        unsettable="false"
        derived="false"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- sf2: reference beta (containment, single) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="beta"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        unsettable="false"
        derived="false"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.1"/>
    <!-- sf3: reference gammaList (non-containment, many, opposite set on Gamma) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="gammaList"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.2"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="Beta"
                abstract="false"
                interface="false"
                eSuperTypes="//@eClassifiers.0">
    <!-- sf0: attribute flag (Boolean with default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="flag"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="true"
        unsettable="false"
        derived="false"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- sf1: reference containerAlpha (non-containment, single, opposite of Alpha.beta) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="containerAlpha"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
    <!-- sf2: attribute rating (Double, no default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rating"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        unsettable="false"
        derived="false"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- 2 -->
  <eClassifiers xsi:type="ecore:EClass" name="Gamma"
                abstract="false"
                interface="false"
                eSuperTypes="//@eClassifiers.0">
    <!-- sf0: reference owner (non-containment, single, opposite of Alpha.gammaList) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"/>
    <!-- sf1: attribute tags (String, many, no default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="tags"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        unsettable="false"
        derived="false"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 3 -->
  <eClassifiers xsi:type="ecore:EEnum" name="Priority">
    <eLiterals name="LOW" value="0" literal="LOW"/>
    <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
    <eLiterals name="HIGH" value="2" literal="HIGH"/>
  </eClassifiers>

  <!-- 4 -->
  <eClassifiers xsi:type="ecore:EEnum" name="Mode">
    <!-- single literal to trigger NamedElConstant branch in EqLiterals -->
    <eLiterals name="SINGLE" value="0" literal="SINGLE"/>
  </eClassifiers>

  <!-- 5 -->
  <eClassifiers xsi:type="ecore:EClass" name="Task"
                abstract="false"
                interface="false">
    <!-- sf0: attribute title (String, default, ordered=false unique=false) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        ordered="false"
        unique="false"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="Untitled"
        unsettable="false"
        derived="false"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- sf1: attribute priority (EEnum Priority, default HIGH) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="priority"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="HIGH"
        unsettable="false"
        derived="false"
        iD="false"
        eType="//@eClassifiers.3"/>
    <!-- sf2: attribute mode (EEnum Mode, no default) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="mode"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        unsettable="false"
        derived="false"
        iD="false"
        eType="//@eClassifiers.4"/>
    <!-- sf3: reference related (many, non-containment, no opposite, to exercise upperBound = -1 and null opposite) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="related"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        unsettable="false"
        derived="false"
        containment="false"
        resolveProxies="true"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 6 -->
  <eClassifiers xsi:type="ecore:EClass" name="Unlinked"
                abstract="false"
                interface="false">
    <!-- class with no superTypes, no features -->
  </eClassifiers>

  <!-- Subpackage contained in root package -->
  <eSubpackages name="sub"
                nsURI="http://meta77/sub"
                nsPrefix="m77sub">
    <!-- 0 in subpackage -->
    <eClassifiers xsi:type="ecore:EClass" name="Delta"
                  abstract="false"
                  interface="false">
      <!-- sf0: attribute value (Int, no default) -->
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="value"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          unsettable="false"
          derived="false"
          iD="false"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eClassifiers>

    <!-- 1 in subpackage -->
    <eClassifiers xsi:type="ecore:EClass" name="Echo"
                  abstract="false"
                  interface="false"
                  eSuperTypes="//@eSubpackages.0/@eClassifiers.0">
      <!-- sf0: reference delta (non-containment, single) -->
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="delta"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          unsettable="false"
          derived="false"
          containment="false"
          resolveProxies="true"
          eType="//@eSubpackages.0/@eClassifiers.0"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>