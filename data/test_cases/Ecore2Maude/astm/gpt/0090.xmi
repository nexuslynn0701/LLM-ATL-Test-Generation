<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootMeta"
    nsURI="http://example.org/rootMeta"
    nsPrefix="root">

  <!-- Subpackage with classifiers -->
  <eSubpackages name="subMeta" nsURI="http://example.org/subMeta" nsPrefix="sub">
    <!-- Class 0: Base abstract class with one attribute and one reference -->
    <eClassifiers xsi:type="ecore:EClass" name="BaseEntity" abstract="true" interface="false">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="identifier"
          ordered="true"
          unique="true"
          lowerBound="1"
          upperBound="1"
          defaultValueLiteral="42"
          iD="true"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="selfRef"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="-1"
          containment="false"
          resolveProxies="true"
          eType="//@eSubpackages.0/@eClassifiers.0"/>
    </eClassifiers>

    <!-- Class 1: Derived concrete class with attribute, two references (one opposite, one non-opposite) -->
    <eClassifiers xsi:type="ecore:EClass" name="ConcreteNode" abstract="false" interface="false"
                  eSuperTypes="//@eSubpackages.0/@eClassifiers.0">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="title"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          defaultValueLiteral="a &quot;quoted&quot; title"
          iD="false"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <!-- bidirectional containment reference pair with NodeLink -->
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="outgoingLinks"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="-1"
          containment="true"
          resolveProxies="true"
          eType="//@eSubpackages.0/@eClassifiers.2"
          eOpposite="//@eSubpackages.0/@eClassifiers.2/@eStructuralFeatures.0"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="tags"
          ordered="false"
          unique="false"
          lowerBound="0"
          upperBound="-1"
          containment="false"
          resolveProxies="true"
          eType="//@eSubpackages.0/@eClassifiers.0"/>
    </eClassifiers>

    <!-- Class 2: Link class with opposite reference back to ConcreteNode and attribute with enum type -->
    <eClassifiers xsi:type="ecore:EClass" name="NodeLink" abstract="false" interface="false">
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="source"
          ordered="true"
          unique="true"
          lowerBound="1"
          upperBound="1"
          containment="false"
          resolveProxies="true"
          eType="//@eSubpackages.0/@eClassifiers.1"
          eOpposite="//@eSubpackages.0/@eClassifiers.1/@eStructuralFeatures.1"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="kind"
          ordered="true"
          unique="true"
          lowerBound="1"
          upperBound="1"
          defaultValueLiteral="STRONG"
          iD="false"
          eType="//@eSubpackages.0/@eClassifiers.3"/>
    </eClassifiers>

    <!-- Enum 3: LinkStrength with two literals -->
    <eClassifiers xsi:type="ecore:EEnum" name="LinkStrength">
      <eLiterals name="STRONG" value="0" literal="STRONG"/>
      <eLiterals name="WEAK" value="1" literal="WEAK"/>
    </eClassifiers>

    <!-- Additional class 4: Uses boolean attribute and contains enum literal as default in another attribute -->
    <eClassifiers xsi:type="ecore:EClass" name="FlagHolder" abstract="false" interface="false">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="enabled"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          iD="false"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="preferredStrength"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="1"
          defaultValueLiteral="WEAK"
          iD="false"
          eType="//@eSubpackages.0/@eClassifiers.3"/>
    </eClassifiers>

    <!-- Additional enum 5: StatusEnum with one literal (for single-literal list handling) -->
    <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
      <eLiterals name="OK" value="0" literal="OK"/>
    </eClassifiers>

  </eSubpackages>

  <!-- Classifier directly in root package to exercise Package2Operation and Class2Sort at root level -->
  <eClassifiers xsi:type="ecore:EClass" name="RootOnly" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="rootName"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>