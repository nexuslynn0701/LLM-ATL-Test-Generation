<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="metaRoot"
    nsURI="http://example/metaroot"
    nsPrefix="mr">

  <!-- Root-level classifiers -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseEntity">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="42"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- Person class with supertype, attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="Person"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="fullName"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="&quot;John &quot;&quot;Johnny&quot;&quot; Doe&quot;"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="primaryAddress"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"
        containment="true"
        resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="contacts"
        ordered="false"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.1"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- Address class with reference back to Person (non-opposite) -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="street"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="Main St"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="number"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="resident"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.1"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- Enumeration with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="PriorityLevel">
    <eLiterals name="LOW" value="0" literal="LOW"/>
    <eLiterals name="HIGH" value="1" literal="HIGH"/>
  </eClassifiers>

  <!-- Abstract Task class with supertype and various attributes / refs -->
  <eClassifiers xsi:type="ecore:EClass" name="Task"
      abstract="true"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="title"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="Untitled"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="priority"
        ordered="true"
        unique="true"
        lowerBound="1"
        upperBound="1"
        defaultValueLiteral="HIGH"
        iD="false"
        eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="assignee"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.1"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- Concrete MeetingTask subclass with attribute and self-reference -->
  <eClassifiers xsi:type="ecore:EClass" name="MeetingTask"
      eSuperTypes="//@eClassifiers.4">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="location"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="Room 1"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="related"
        ordered="true"
        unique="true"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.5"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- Separate root package to trigger multiple root-pack behavior -->
  <eSubpackages name="analytics"
      nsURI="http://example/analytics"
      nsPrefix="an">
    <!-- Class with only attributes to exercise attribute lists -->
    <eClassifiers xsi:type="ecore:EClass" name="Report">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="name"
          ordered="true"
          unique="true"
          lowerBound="1"
          upperBound="1"
          defaultValueLiteral="Monthly"
          iD="false"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="pages"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="-1"
          iD="false"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eClassifiers>

    <!-- Class with only references to exercise reference lists -->
    <eClassifiers xsi:type="ecore:EClass" name="Dashboard">
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="reports"
          ordered="true"
          unique="true"
          lowerBound="0"
          upperBound="-1"
          eType="//@eSubpackages.0/@eClassifiers.0"
          containment="false"
          resolveProxies="true"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>