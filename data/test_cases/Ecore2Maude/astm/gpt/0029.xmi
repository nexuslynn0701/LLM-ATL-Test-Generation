<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootMeta"
    nsURI="http://example/rootMeta"
    nsPrefix="root">
  <!-- Root-level classifiers: 0..7 -->
  <!-- 0: EClass RootEntity -->
  <eClassifiers xsi:type="ecore:EClass" name="RootEntity" abstract="false" interface="false">
    <!-- Attributes -->
    <eStructuralFeatures xsi:type="eccore:EAttribute" xmlns:eccore="http://www.eclipse.org/emf/2002/Ecore"
        name="code"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="DEF-001"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="eccore:EAttribute" xmlns:eccore="http://www.eclipse.org/emf/2002/Ecore"
        name="status"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="ACTIVE"
        iD="false"
        eType="//@eClassifiers.6"/>
    <!-- References -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="details"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="primaryRef"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        resolveProxies="true"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"
        eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 1: EClass DetailEntity (subclass of RootEntity) -->
  <eClassifiers xsi:type="ecore:EClass" name="DetailEntity" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.0">
    <!-- Attributes -->
    <eStructuralFeatures xsi:type="eccore:EAttribute" xmlns:eccore="http://www.eclipse.org/emf/2002/Ecore"
        name="sequence"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="false"
        defaultValueLiteral=""
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Back reference to RootEntity (opposite of primaryRef) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        resolveProxies="true"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"
        eType="//@eClassifiers.0"/>
    <!-- Containment of NestedPart -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parts"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        containment="true"
        resolveProxies="true"
        eType="//@eClassifiers.2"/>
  </eClassifiers>

  <!-- 2: EClass NestedPart (concrete, no supertypes) -->
  <eClassifiers xsi:type="ecore:EClass" name="NestedPart" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="eccore:EAttribute" xmlns:eccore="http://www.eclipse.org/emf/2002/Ecore"
        name="label"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="default label"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Reference without opposite and without type (to trigger @NoType) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="untypedRef"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        containment="false"
        resolveProxies="true"/>
  </eClassifiers>

  <!-- 3: EClass AbstractBase (abstract with no supertypes) -->
  <eClassifiers xsi:type="ecore:EClass" name="AbstractBase" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="eccore:EAttribute" xmlns:eccore="http://www.eclipse.org/emf/2002/Ecore"
        name="flag"
        lowerBound="0"
        upperBound="1"
        ordered="false"
        unique="false"
        defaultValueLiteral=""
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- 4: EClass DerivedConcrete (inherits from AbstractBase and DetailEntity) -->
  <eClassifiers xsi:type="ecore:EClass" name="DerivedConcrete" abstract="false" interface="false"
      eSuperTypes="//@eClassifiers.3 //@eClassifiers.1">
    <eStructuralFeatures xsi:type="eccore:EAttribute" xmlns:eccore="http://www.eclipse.org/emf/2002/Ecore"
        name="ratio"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral=""
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- 5: External-like EClass with non-ecore package in name -->
  <eClassifiers xsi:type="ecore:EClass" name="ExternalLike{Type}" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="eccore:EAttribute" xmlns:eccore="http://www.eclipse.org/emf/2002/Ecore"
        name="externalId"
        lowerBound="0"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral=""
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
  </eClassifiers>

  <!-- 6: Enumeration StatusKind with multiple literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
    <eLiterals name="PENDING_STATE" value="2" literal="PENDING-STATE"/>
  </eClassifiers>

  <!-- 7: Standalone enum for attribute default tests -->
  <eClassifiers xsi:type="ecore:EEnum" name="ModeKind">
    <eLiterals name="AUTO" value="0" literal="AUTO"/>
    <eLiterals name="MANUAL" value="1" literal="MANUAL"/>
  </eClassifiers>

  <!-- Subpackage with its own classifiers -->
  <eSubpackages name="subPkg"
      nsURI="http://example/rootMeta/sub"
      nsPrefix="sub">
    <!-- Subpackage classifiers: 0..2 inside subPkg -->
    <!-- subPkg classifier 0: EClass SubComponent -->
    <eClassifiers xsi:type="ecore:EClass" name="SubComponent" abstract="false" interface="false">
      <eStructuralFeatures xsi:type="eccore:EAttribute" xmlns:eccore="http://www.eclipse.org/emf/2002/Ecore"
          name="nameInSub"
          lowerBound="1"
          upperBound="1"
          ordered="true"
          unique="true"
          defaultValueLiteral="subName"
          iD="false"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <!-- Reference to RootEntity in super package -->
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="rootLink"
          lowerBound="0"
          upperBound="1"
          ordered="true"
          unique="true"
          containment="false"
          resolveProxies="true"
          eType="//@eClassifiers.0"/>
    </eClassifiers>

    <!-- subPkg classifier 1: EClass SubNode with multi-valued EAttribute -->
    <eClassifiers xsi:type="ecore:EClass" name="SubNode" abstract="false" interface="false">
      <eStructuralFeatures xsi:type="eccore:EAttribute" xmlns:eccore="http://www.eclipse.org/emf/2002/Ecore"
          name="tags"
          lowerBound="0"
          upperBound="-1"
          ordered="false"
          unique="false"
          defaultValueLiteral=""
          iD="false"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <!-- Attribute with enum ModeKind and default literal MANUAL -->
      <eStructuralFeatures xsi:type="eccore:EAttribute" xmlns:eccore="http://www.eclipse.org/emf/2002/Ecore"
          name="mode"
          lowerBound="0"
          upperBound="1"
          ordered="true"
          unique="true"
          defaultValueLiteral="MANUAL"
          iD="false"
          eType="//@../@eClassifiers.2"/>
    </eClassifiers>

    <!-- subPkg classifier 2: EEnum ModeKind (referenced above) -->
    <eClassifiers xsi:type="ecore:EEnum" name="ModeKind">
      <eLiterals name="AUTO" value="0" literal="AUTO"/>
      <eLiterals name="MANUAL" value="1" literal="MANUAL"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>