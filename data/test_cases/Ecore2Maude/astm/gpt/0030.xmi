<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyModel"
    nsURI="http://example.com/company"
    nsPrefix="comp">

  <!-- Root package classifiers (indexing basis for cross-refs) -->
  <!-- 0: EClass Person -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="id"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="&quot;John &quot;&quot;Johnny&quot;&quot; Doe&quot;"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="status"
        eType="//@eSubpackages.0/@eClassifiers.0"
        defaultValueLiteral="ACTIVE"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="manager"
        eType="//@eClassifiers.0"
        lowerBound="0"
        upperBound="1"
        containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="projects"
        eType="//@eSubpackages.0/@eClassifiers.1"
        lowerBound="0"
        upperBound="-1"
        containment="true"/>
  </eClassifiers>

  <!-- 1: EClass PermanentEmployee extends Person -->
  <eClassifiers xsi:type="ecore:EClass" name="PermanentEmployee">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="salary"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        lowerBound="0"
        upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="department"
        eType="//@eSubpackages.0/@eClassifiers.2"
        lowerBound="1"
        upperBound="1"
        containment="false"/>
  </eClassifiers>

  <!-- 2: EClass TempEmployee extends Person and ExternalContact -->
  <eClassifiers xsi:type="ecore:EClass" name="TempEmployee" abstract="true">
    <eSuperTypes>//@eClassifiers.0 //@eClassifiers.3</eSuperTypes>
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="hourlyRate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"
        lowerBound="0"/>
  </eClassifiers>

  <!-- 3: EClass ExternalContact -->
  <eClassifiers xsi:type="ecore:EClass" name="ExternalContact">
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="email"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 4: EEnum EmploymentStatus with 3 literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="EmploymentStatus">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
    <eLiterals name="SABBATICAL" value="2" literal="SABBATICAL"/>
  </eClassifiers>

  <!-- 5: Custom datatype RatingType (non-primitive, non-enum) -->
  <eClassifiers xsi:type="ecore:EDataType"
      name="RatingType"
      instanceClassName="int"/>

  <!-- 6: EClass Review using RatingType default -->
  <eClassifiers xsi:type="ecore:EClass" name="Review">
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="score"
        eType="//@eClassifiers.5"
        lowerBound="1"
        defaultValueLiteral="5"/>
  </eClassifiers>

  <!-- 7: EClass GenericHolder with a reference with no type (to trigger @NoType) -->
  <eClassifiers xsi:type="ecore:EClass" name="GenericHolder">
    <eStructuralFeatures xsi:type="eccore:EReference"
        name="untypedRef"
        lowerBound="0"
        upperBound="-1"
        containment="false"/>
  </eClassifiers>

  <!-- 8: EClass StringAttributeOwner with Boolean and String default values -->
  <eClassifiers xsi:type="ecore:EClass" name="StringAttributeOwner">
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="flag"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="eccore:EAttribute"
        name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="simple&quot;text"/>
  </eClassifiers>

  <!-- Subpackage org (index 0 in eSubpackages of root) -->
  <eSubpackages name="org" nsURI="http://example.com/company/org" nsPrefix="org">

    <!-- 0: EEnum DeptKind with 2 literals -->
    <eClassifiers xsi:type="ecore:EEnum" name="DeptKind">
      <eLiterals name="DEV" value="0" literal="DEV"/>
      <eLiterals name="HR" value="1" literal="HR"/>
    </eClassifiers>

    <!-- 1: EClass Project -->
    <eClassifiers xsi:type="ecore:EClass" name="Project">
      <eStructuralFeatures xsi:type="eccore:EAttribute"
          name="code"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          lowerBound="1"
          iD="true"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="priority"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
          defaultValueLiteral="1"/>
    </eClassifiers>

    <!-- 2: EClass Department with opposite references and enum & custom datatypes -->
    <eClassifiers xsi:type="ecore:EClass" name="Department">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="kind"
          eType="//@eSubpackages.0/@eClassifiers.0"
          defaultValueLiteral="DEV"/>
      <eStructuralFeatures xsi:type="eccore:EAttribute"
          name="rating"
          eType="//@eClassifiers.5"/>
      <eStructuralFeatures xsi:type="eccore:EReference"
          name="employees"
          eType="//@eClassifiers.1"
          lowerBound="0"
          upperBound="-1"
          containment="false"
          eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"/>
      <eStructuralFeatures xsi:type="eccore:EReference"
          name="lead"
          eType="//@eClassifiers.1"
          lowerBound="0"
          upperBound="1"
          containment="false"/>
    </eClassifiers>

    <!-- 3: EClass Team with containment and multiplicity * -->
    <eClassifiers xsi:type="ecore:EClass" name="Team">
      <eStructuralFeatures xsi:type="eccore:EAttribute"
          name="teamName"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="eccore:EReference"
          name="members"
          eType="//@eClassifiers.0"
          lowerBound="0"
          upperBound="-1"
          containment="true"/>
    </eClassifiers>

  </eSubpackages>
</ecore:EPackage>