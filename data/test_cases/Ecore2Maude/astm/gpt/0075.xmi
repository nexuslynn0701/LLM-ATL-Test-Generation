<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="mmRoot75"
    nsURI="http://example.com/mmRoot75"
    nsPrefix="mm75">

  <!-- Subpackage to trigger super/sub package relations -->
  <eSubpackages name="subPkg"
      nsURI="http://example.com/mmRoot75/sub"
      nsPrefix="mm75sub">

    <!-- Class in subpackage, extending superpackage class and using many/ordered/unique variants -->
    <eClassifiers xsi:type="ecore:EClass" name="SubEntity">
      <eSuperTypes href="//@eClassifiers.0"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="subCode"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          lowerBound="0"
          upperBound="1"
          ordered="false"
          unique="true"
          defaultValueLiteral="SUB-DEFAULT"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="rootLinks"
          eType="//@eClassifiers.0"
          lowerBound="0"
          upperBound="-1"
          ordered="true"
          unique="false"
          containment="false"/>
    </eClassifiers>

    <!-- Local enum in subpackage -->
    <eClassifiers xsi:type="ecore:EEnum" name="SubLevel">
      <eLiterals name="Low" value="0" literal="Low"/>
      <eLiterals name="High" value="1" literal="High"/>
    </eClassifiers>

  </eSubpackages>

  <!-- Root-level classifiers -->

  <!-- Base class with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="RootEntity">
    <!-- ID attribute with Integer type and default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"
        upperBound="1"
        iD="true"
        defaultValueLiteral="1"/>
    <!-- String attribute without default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"/>
    <!-- Boolean attribute with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="active"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="true"/>
    <!-- Enum-typed attribute with default literal name -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="priority"
        eType="//@eClassifiers.1"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="MEDIUM"/>
    <!-- Reference to Detail with opposite and containment -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="details"
        eType="//@eClassifiers.2"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- Enum with three literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="PriorityKind">
    <eLiterals name="LOW" value="0" literal="LOW"/>
    <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
    <eLiterals name="HIGH" value="2" literal="HIGH"/>
  </eClassifiers>

  <!-- Detail class with back reference, multiplicity variants -->
  <eClassifiers xsi:type="ecore:EClass" name="Detail">
    <!-- Back reference (non-containment), opposite of RootEntity.details -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="owner"
        eType="//@eClassifiers.0"
        lowerBound="1"
        upperBound="1"
        containment="false"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"/>
    <!-- Float-typed attribute with default -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="amount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="10.5"/>
    <!-- Many-valued String attribute (ordered=false, unique=false) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="tags"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="-1"
        ordered="false"
        unique="false"/>
  </eClassifiers>

</ecore:EPackage>