<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootMeta"
    nsURI="http://example.org/rootMeta"
    nsPrefix="root">

  <!-- Root-level EClasses and EEnum -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseRoot" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id"
        ordered="true" unique="true" lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="RootPerson" abstract="false" interface="false">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        ordered="true" unique="true" lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="John &quot;Johnny&quot; Doe"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mainAddress"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        eType="//@eSubpackages.0/@eClassifiers.0"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="otherAddresses"
        ordered="true" unique="true" lowerBound="0" upperBound="-1"
        eType="//@eSubpackages.0/@eClassifiers.0"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="spouse"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        eType="//@eClassifiers.1"
        containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        ordered="true" unique="true" lowerBound="0" upperBound="1"
        eType="//@eClassifiers.2"
        defaultValueLiteral="ACTIVE"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1" literal="INACTIVE"/>
    <eLiterals name="PENDING" value="2" literal="PENDING"/>
  </eClassifiers>

  <!-- Subpackage -->
  <eSubpackages name="subMeta" nsURI="http://example.org/subMeta" nsPrefix="sub">
    <eClassifiers xsi:type="ecore:EClass" name="SubAddress" abstract="false" interface="false">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="street"
          ordered="true" unique="true" lowerBound="1" upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="number"
          ordered="true" unique="true" lowerBound="0" upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
          defaultValueLiteral="0"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind"
          ordered="true" unique="true" lowerBound="0" upperBound="1"
          eType="//@eClassifiers.2"
          defaultValueLiteral="PENDING"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="owner"
          ordered="true" unique="true" lowerBound="0" upperBound="1"
          eType="//@eClassifiers.1"
          eOpposite="//@eClassifiers.1/@eStructuralFeatures.3"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>