<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="metamodel92"
    nsURI="http://example.org/metamodel92"
    nsPrefix="mm92">

  <!-- Top-level package classifiers -->
  <!-- 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="RootElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rootId"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        iD="true"
        defaultValueLiteral="100"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="primaryChild"
        eType="//@eClassifiers.1"
        containment="true"
        lowerBound="1"
        upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="secondaryChildren"
        eType="//@eClassifiers.2"
        containment="true"
        lowerBound="0"
        upperBound="-1"/>
  </eClassifiers>

  <!-- 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="Node" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nodeName"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="defaultNode"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true"/>
  </eClassifiers>

  <!-- 2 -->
  <eClassifiers xsi:type="ecore:EClass" name="LeafNode" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        defaultValueLiteral="3.14"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="//@eClassifiers.5"/>
  </eClassifiers>

  <!-- 3 -->
  <eClassifiers xsi:type="eccore:EClass" name="CompositeNode" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EReference" name="children"
        eType="//@eClassifiers.2"
        containment="true"
        lowerBound="1"
        upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent"
        eType="//@eClassifiers.3"
        containment="false"
        lowerBound="0"
        upperBound="1"
        eOpposite="//@eClassifiers.3/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- 4 -->
  <eClassifiers xsi:type="ecore:EClass" name="UnlinkedClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="count"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"
        defaultValueLiteral="7"/>
  </eClassifiers>

  <!-- 5 -->
  <eClassifiers xsi:type="ecore:EEnum" name="NodeStatus">
    <eLiterals name="NEW" value="0" literal="NEW_STATE"/>
    <eLiterals name="ACTIVE" value="1" literal="ACTIVE_STATE"/>
    <eLiterals name="INACTIVE" value="2" literal="INACTIVE_STATE"/>
  </eClassifiers>

  <!-- 6 -->
  <eClassifiers xsi:type="ecore:EEnum" name="PriorityLevel">
    <eLiterals name="LOW" value="0" literal="LOW_LEVEL"/>
    <eLiterals name="MEDIUM" value="1" literal="MEDIUM_LEVEL"/>
    <eLiterals name="HIGH" value="2" literal="HIGH_LEVEL"/>
  </eClassifiers>

  <!-- Subpackage to exercise eSuperPackage/eSubpackages and multi-root logic -->
  <eSubpackages name="subpkg"
      nsURI="http://example.org/metamodel92/sub"
      nsPrefix="mm92sub">
    <!-- 0 within subpkg -->
    <eClassifiers xsi:type="ecore:EClass" name="SubRoot">
      <eStructuralFeatures xsi:type="ecore:EReference" name="owner"
          eType="//@eClassifiers.0"
          containment="false"
          lowerBound="0"
          upperBound="1"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
          lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          defaultValueLiteral="sub-root"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="priority"
          eType="//@eSubpackages.0/@eClassifiers.1"/>
    </eClassifiers>

    <!-- 1 within subpkg -->
    <eClassifiers xsi:type="ecore:EEnum" name="LocalFlag">
      <eLiterals name="ON" value="1" literal="ON_FLAG"/>
      <eLiterals name="OFF" value="0" literal="OFF_FLAG"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>