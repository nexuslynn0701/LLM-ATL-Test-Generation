<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="mm71Root"
    nsURI="http://mm71/root"
    nsPrefix="mm71">
  <!-- Classifiers in root package -->
  <!-- 0 -->  
  <eClassifiers xsi:type="ecore:EClass" name="BaseA">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="idA"
        iD="true"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="A-001"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flagA"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true"/>
  </eClassifiers>

  <!-- 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="SubA1"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name A1"
        iD="false"
        ordered="false"
        unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="toB"
        lowerBound="1"
        upperBound="-1"
        containment="false"
        resolveProxies="true"
        eType="//@eSubpackages.0/@eClassifiers.1"/>
  </eClassifiers>

  <!-- 2 -->
  <eClassifiers xsi:type="ecore:EClass" name="SubA2"
      abstract="true"
      interface="false"
      eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EReference" name="linkToC"
        lowerBound="0"
        upperBound="1"
        containment="false"
        eType="//@eSubpackages.0/@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="count_sub2"
        iD="false"
        ordered="true"
        unique="false"
        lowerBound="0"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 3 -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="IN_PROGRESS" value="1" literal="IN&quot;PROG"/>
    <eLiterals name="DONE" value="2" literal="DONE"/>
  </eClassifiers>

  <!-- 4 -->
  <eClassifiers xsi:type="ecore:EClass" name="EnumHolder">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        iD="false"
        lowerBound="1"
        eType="//@eClassifiers.3"
        defaultValueLiteral="NEW"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="statusQuoted"
        iD="false"
        eType="//@eClassifiers.3"
        defaultValueLiteral="IN&quot;PROG"/>
  </eClassifiers>

  <!-- Subpackage -->
  <eSubpackages name="subPkg71" nsURI="http://mm71/sub" nsPrefix="mm71sub">
    <!-- 0 in subpackage -->
    <eClassifiers xsi:type="ecore:EClass" name="ContainerX">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="title X"
          iD="false"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          defaultValueLiteral="Default &quot;Title&quot;"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="childrenB"
          lowerBound="0"
          upperBound="-1"
          containment="true"
          eType="//@eSubpackages.0/@eClassifiers.1"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="singleC"
          lowerBound="0"
          upperBound="1"
          containment="true"
          eType="//@eSubpackages.0/@eClassifiers.2"/>
    </eClassifiers>

    <!-- 1 in subpackage -->
    <eClassifiers xsi:type="ecore:EClass" name="NodeB">
      <eStructuralFeatures xsi:type="ecore:EReference" name="owner"
          lowerBound="0"
          upperBound="1"
          containment="false"
          eOpposite="//@eSubpackages.0/@eClassifiers.0/@eStructuralFeatures.1"
          eType="//@eSubpackages.0/@eClassifiers.0"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="next"
          lowerBound="0"
          upperBound="-1"
          containment="false"
          eType="//@eSubpackages.0/@eClassifiers.1"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="bIndex"
          iD="false"
          lowerBound="0"
          upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
          defaultValueLiteral="5"/>
    </eClassifiers>

    <!-- 2 in subpackage -->
    <eClassifiers xsi:type="ecore:EClass" name="LeafC">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="leafName"
          iD="false"
          lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="flagC"
          iD="false"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"
          defaultValueLiteral="false"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="doubleVal"
          iD="false"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
          defaultValueLiteral="3.14"/>
    </eClassifiers>

    <!-- 3 in subpackage -->
    <eClassifiers xsi:type="ecore:EEnum" name="Priority">
      <eLiterals name="LOW" value="0" literal="LOW"/>
      <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
    </eClassifiers>

    <!-- 4 in subpackage -->
    <eClassifiers xsi:type="ecore:EClass" name="PriorityHolder">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="prio"
          iD="false"
          lowerBound="0"
          eType="//@eSubpackages.0/@eClassifiers.3"
          defaultValueLiteral="MEDIUM"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>