<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="mainPkg{0011}"
    nsURI="http://example.org/mainPkg0011"
    nsPrefix="mp11">

  <!-- Root package classifiers -->
  <!-- 0: Base class -->
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0"
        upperBound="1"
        ordered="false"
        unique="true"
        defaultValueLiteral="true"/>
  </eClassifiers>

  <!-- 1: Element class extending BaseClass, with attributes and references -->
  <eClassifiers xsi:type="ecore:EClass" name="Element">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="unnamed"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priority"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0"
        upperBound="1"
        ordered="false"
        unique="true"/>
    <!-- Containment reference to Detail -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="details"
        containment="true"
        resolveProxies="true"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.3"/>
    <!-- Non-containment reference with opposite in ExtraElement -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="linkedExtra"
        containment="false"
        resolveProxies="true"
        lowerBound="0"
        upperBound="1"
        ordered="false"
        unique="true"
        eType="//@eClassifiers.4"
        eOpposite="//@eClassifiers.4/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- 2: Enum with three literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="NEW" value="0" literal="NEW"/>
    <eLiterals name="IN_PROGRESS" value="1" literal="IN_PROGRESS"/>
    <eLiterals name="DONE" value="2" literal="DONE"/>
  </eClassifiers>

  <!-- 3: Detail class, uses enum-typed attribute with default -->
  <eClassifiers xsi:type="ecore:EClass" name="Detail">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        iD="false"
        eType="//@eClassifiers.2"
        lowerBound="1"
        upperBound="1"
        ordered="true"
        unique="true"
        defaultValueLiteral="IN_PROGRESS"/>
  </eClassifiers>

  <!-- 4: ExtraElement class, opposite reference to Element.linkedExtra -->
  <eClassifiers xsi:type="ecore:EClass" name="ExtraElement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="primaryElement"
        containment="false"
        resolveProxies="true"
        lowerBound="0"
        upperBound="-1"
        ordered="true"
        unique="true"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.2"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        iD="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0"
        upperBound="1"
        ordered="false"
        unique="true"
        defaultValueLiteral="&quot;quoted&quot; text"/>
  </eClassifiers>

  <!-- 5: Local data type (to exercise EqPackage on EDataType) -->
  <eClassifiers xsi:type="ecore:EDataType" name="CustomNumber"
      instanceClassName="java.lang.Double"/>

  <!-- Subpackage with its own classifiers -->
  <eSubpackages name="subPkgAlpha"
      nsURI="http://example.org/mainPkg0011/alpha"
      nsPrefix="alpha11">
    <!-- 0 in subpackage: AnotherBase -->
    <eClassifiers xsi:type="ecore:EClass" name="AnotherBase">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
          iD="false"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          lowerBound="1"
          upperBound="1"
          ordered="true"
          unique="true"/>
    </eClassifiers>
    <!-- 1 in subpackage: NumericDetail with multi-valued attr using CustomNumber -->
    <eClassifiers xsi:type="ecore:EClass" name="NumericDetail">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="values"
          iD="false"
          eType="//@eClassifiers.5"
          lowerBound="0"
          upperBound="-1"
          ordered="true"
          unique="false"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>