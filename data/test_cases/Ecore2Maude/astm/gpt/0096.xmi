<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="meta96"
    nsURI="http://example.org/meta96"
    nsPrefix="m96">

  <!-- Root package classifiers -->
  <!-- 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="RootA">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id"
        iD="true"
        lowerBound="1"
        upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="ACTIVE"
        eType="//@eSubpackages.0/@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="child"
        lowerBound="0"
        upperBound="-1"
        containment="true"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="partner"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.2"
        eOpposite="//@eClassifiers.2/@eStructuralFeatures.0"/>
  </eClassifiers>

  <!-- 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="ChildA">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        lowerBound="0"
        upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner"
        lowerBound="1"
        upperBound="1"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="refToB"
        lowerBound="0"
        upperBound="1"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- 2 -->
  <eClassifiers xsi:type="ecore:EClass" name="PartnerA">
    <eSuperTypes>//@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rootBack"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"/>
  </eClassifiers>

  <!-- 3 -->
  <eClassifiers xsi:type="ecore:EClass" name="ExtraA">
    <eSuperTypes>//@eClassifiers.1 //@eSubpackages.0/@eClassifiers.0</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag"
        lowerBound="0"
        upperBound="1"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="linkToD"
        lowerBound="0"
        upperBound="1"
        eType="//@eSubpackages.0/@eClassifiers.1"/>
  </eClassifiers>

  <!-- 4 -->
  <eClassifiers xsi:type="ecore:EEnum" name="LevelA">
    <eLiterals name="LOW" value="0" literal="LOW"/>
    <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
    <eLiterals name="HIGH" value="2" literal="HIGH"/>
  </eClassifiers>

  <!-- Subpackage -->
  <eSubpackages name="sub96"
      nsURI="http://example.org/meta96/sub"
      nsPrefix="m96s">

    <!-- sub96 classifier 0 -->
    <eClassifiers xsi:type="ecore:EClass" name="SubBase">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
          lowerBound="1"
          upperBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="toRoot"
          lowerBound="0"
          upperBound="1"
          eType="//@eClassifiers.0"/>
    </eClassifiers>

    <!-- sub96 classifier 1 -->
    <eClassifiers xsi:type="ecore:EClass" name="SubDetail">
      <eSuperTypes>//@eSubpackages.0/@eClassifiers.0 //@eClassifiers.0</eSuperTypes>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="priority"
          lowerBound="0"
          upperBound="1"
          defaultValueLiteral="5"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="linkToExtra"
          lowerBound="0"
          upperBound="-1"
          containment="false"
          eType="//@eClassifiers.3"/>
    </eClassifiers>

    <!-- sub96 classifier 2: enum used as attribute type with default -->
    <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
      <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
      <eLiterals name="PAUSED" value="1" literal="PAUSED"/>
    </eClassifiers>

  </eSubpackages>

</ecore:EPackage>