<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="companyModel"
    nsURI="http://example.com/companyModel"
    nsPrefix="cmp">

  <!-- Root package classifiers -->
  <!-- 0 -->
  <eClassifiers xsi:type="ecore:EClass" name="Company">
    <!-- Attributes -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="Acme &quot;Corp&quot;"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="foundedYear"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- References -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="headOffice"
        lowerBound="0"
        eType="//@eSubpackages.0/@eClassifiers.1"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="departments"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.1"
        containment="true"/>
  </eClassifiers>

  <!-- 1 -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="code"
        lowerBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="description"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="Undefined"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employees"
        lowerBound="0"
        upperBound="-1"
        eType="//@eClassifiers.2"
        containment="true"
        ordered="false"
        unique="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parentCompany"
        lowerBound="1"
        eType="//@eClassifiers.0"
        eOpposite="//@eClassifiers.0/@eStructuralFeatures.3"/>
  </eClassifiers>

  <!-- 2 -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="firstName"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="age"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- 3 -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee"
      eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="employeeId"
        lowerBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="salary"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="manager"
        lowerBound="0"
        eType="//@eClassifiers.3"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="department"
        lowerBound="0"
        eType="//@eClassifiers.1"
        eOpposite="//@eClassifiers.1/@eStructuralFeatures.2"/>
  </eClassifiers>

  <!-- 4 -->
  <eClassifiers xsi:type="ecore:EEnum" name="EmploymentType">
    <eLiterals name="FULL_TIME" value="0" literal="FULL_TIME"/>
    <eLiterals name="PART_TIME" value="1" literal="PART_TIME"/>
    <eLiterals name="CONTRACTOR" value="2" literal="CONTRACTOR"/>
  </eClassifiers>

  <!-- 5 -->
  <eClassifiers xsi:type="ecore:EClass" name="Contract"
      abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="startDate"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="endDate"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="type"
        lowerBound="1"
        eType="//@eClassifiers.4"
        defaultValueLiteral="FULL_TIME"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="employee"
        lowerBound="1"
        eType="//@eClassifiers.3"/>
  </eClassifiers>

  <!-- 6 -->
  <eClassifiers xsi:type="ecore:EClass" name="PermanentContract"
      eSuperTypes="//@eClassifiers.5"/>

  <!-- 7 -->
  <eClassifiers xsi:type="ecore:EClass" name="OfficeLocation">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="city"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="country"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="Unknown"/>
  </eClassifiers>

  <!-- 8 -->
  <eClassifiers xsi:type="ecore:EClass" name="MeetingRoom">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="roomNumber"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="capacity"
        lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="10"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="location"
        lowerBound="1"
        eType="//@eSubpackages.0/@eClassifiers.1"/>
  </eClassifiers>

  <!-- Subpackage with its own classifiers -->
  <eSubpackages name="companyModel.sub"
      nsURI="http://example.com/companyModel/sub"
      nsPrefix="cmpsub">
    <!-- 0 in subpackage -->
    <eClassifiers xsi:type="ecore:EClass" name="Project">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="title"
          lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="budget"
          lowerBound="0"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
          defaultValueLiteral="100000.0"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="ownerCompany"
          lowerBound="1"
          eType="//@eClassifiers.0"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="team"
          lowerBound="0"
          upperBound="-1"
          eType="//@eClassifiers.3"
          ordered="false"
          unique="false"/>
    </eClassifiers>

    <!-- 1 in subpackage -->
    <eClassifiers xsi:type="ecore:EClass" name="HeadOffice">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="address"
          lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="company"
          lowerBound="1"
          eType="//@eClassifiers.0"
          eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="meetingRooms"
          lowerBound="0"
          upperBound="-1"
          eType="//@eClassifiers.8"
          containment="true"/>
    </eClassifiers>

    <!-- 2 in subpackage -->
    <eClassifiers xsi:type="ecore:EEnum" name="PriorityLevel">
      <eLiterals name="LOW" value="0" literal="LOW"/>
      <eLiterals name="MEDIUM" value="1" literal="MEDIUM"/>
      <eLiterals name="HIGH" value="2" literal="HIGH"/>
      <eLiterals name="CRITICAL" value="3" literal="CRITICAL"/>
    </eClassifiers>

    <!-- 3 in subpackage -->
    <eClassifiers xsi:type="ecore:EClass" name="Task">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="summary"
          lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
          name="priority"
          lowerBound="1"
          eType="//@eSubpackages.0/@eClassifiers.2"
          defaultValueLiteral="MEDIUM"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="assignee"
          lowerBound="0"
          eType="//@eClassifiers.3"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
          name="project"
          lowerBound="1"
          eType="//@eSubpackages.0/@eClassifiers.0"/>
    </eClassifiers>
  </eSubpackages>

</ecore:EPackage>