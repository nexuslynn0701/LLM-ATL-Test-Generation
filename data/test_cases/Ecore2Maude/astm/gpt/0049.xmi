<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg{49}"
    nsURI="http://example.org/rootPkg49"
    nsPrefix="root49">

  <!-- Subpackage to exercise eSuperPackage / eSubpackages -->
  <eSubpackages name="subPkg[inner]"
                nsURI="http://example.org/subPkg49"
                nsPrefix="sub49">

    <!-- Class 0: abstract base, has EString ID and Boolean attribute with default -->
    <eClassifiers xsi:type="ecore:EClass" name="BaseEntity">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="id"
                           iD="true"
                           lowerBound="1"
                           upperBound="1"
                           ordered="true"
                           unique="true"
                           defaultValueLiteral="0001">
        <eType xsi:type="ecore:EDataType"
               href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      </eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="active-flag"
                           iD="false"
                           lowerBound="0"
                           upperBound="1"
                           ordered="false"
                           unique="false"
                           defaultValueLiteral="true">
        <eType xsi:type="ecore:EDataType"
               href="http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
      </eStructuralFeatures>
    </eClassifiers>

    <!-- Class 1: concrete subclass, has one reference with opposite and containment -->
    <eClassifiers xsi:type="ecore:EClass" name="ConcreteItem">
      <eSuperTypes href="//@eSubpackages.0/@eClassifiers.0"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="parts_list"
                           lowerBound="0"
                           upperBound="-1"
                           ordered="false"
                           unique="true"
                           containment="true"
                           resolveProxies="true"
                           eOpposite="//@eSubpackages.0/@eClassifiers.2/@eStructuralFeatures.0"
                           eType="//@eSubpackages.0/@eClassifiers.2"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="priority_level"
                           iD="false"
                           lowerBound="0"
                           upperBound="1"
                           ordered="true"
                           unique="true"
                           defaultValueLiteral="5">
        <eType xsi:type="ecore:EDataType"
               href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      </eStructuralFeatures>
    </eClassifiers>

    <!-- Class 2: Part, opposite reference back, and attribute with enum type -->
    <eClassifiers xsi:type="ecore:EClass" name="Part">
      <eSuperTypes href="//@eSubpackages.0/@eClassifiers.0"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="owner_item"
                           lowerBound="1"
                           upperBound="1"
                           ordered="true"
                           unique="false"
                           containment="false"
                           resolveProxies="true"
                           eOpposite="//@eSubpackages.0/@eClassifiers.1/@eStructuralFeatures.0"
                           eType="//@eSubpackages.0/@eClassifiers.1"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="status"
                           iD="false"
                           lowerBound="0"
                           upperBound="1"
                           ordered="true"
                           unique="true">
        <eType href="//@eSubpackages.0/@eClassifiers.4"/>
      </eStructuralFeatures>
    </eClassifiers>

    <!-- Class 3: Standalone with only attributes, including String default with quotes -->
    <eClassifiers xsi:type="ecore:EClass" name="StandaloneRecord">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="title with space"
                           iD="false"
                           lowerBound="0"
                           upperBound="1"
                           ordered="true"
                           unique="true"
                           defaultValueLiteral="&quot;special&quot; value">
        <eType xsi:type="ecore:EDataType"
               href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      </eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="ratio"
                           iD="false"
                           lowerBound="0"
                           upperBound="1"
                           ordered="true"
                           unique="true"
                           defaultValueLiteral="3.14">
        <eType xsi:type="ecore:EDataType"
               href="http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
      </eStructuralFeatures>
    </eClassifiers>

    <!-- EEnum with three literals, first used as default elsewhere -->
    <eClassifiers xsi:type="ecore:EEnum" name="StateCode">
      <eLiterals name="NEW" value="0" literal="NEW"/>
      <eLiterals name="IN_PROGRESS" value="1" literal="IN_PROGRESS"/>
      <eLiterals name="DONE" value="2" literal="DONE"/>
    </eClassifiers>

    <!-- Class 5: uses enum attribute with default literal -->
    <eClassifiers xsi:type="ecore:EClass" name="WorkflowStep">
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="stepState"
                           iD="false"
                           lowerBound="0"
                           upperBound="1"
                           ordered="true"
                           unique="true"
                           defaultValueLiteral="IN_PROGRESS">
        <eType href="//@eSubpackages.0/@eClassifiers.4"/>
      </eStructuralFeatures>
    </eClassifiers>

  </eSubpackages>
</ecore:EPackage>