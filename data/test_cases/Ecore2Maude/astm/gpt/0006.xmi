<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="metaRoot6"
    nsURI="http://example.org/metaRoot6"
    nsPrefix="mr6">

  <!-- Subpackage 0 -->
  <eSubpackages name="core{model}" nsURI="http://example.org/metaRoot6/core" nsPrefix="core6">
    <!-- Class 0: Abstract base class -->
    <eClassifiers xsi:type="ecore:EClass" name="BaseElement">
      <eStructuralFeatures xsi:type="eccore:EAttribute" name="id" lowerBound="1" iD="true"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eClassifiers>
    <!-- Class 1: Container class -->
    <eClassifiers xsi:type="ecore:EClass" name="Project">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" lowerBound="1"
          defaultValueLiteral="Untitled &quot;Project&quot;"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="tasks" lowerBound="0" upperBound="-1"
          containment="true" eType="//@eSubpackages.0/@eClassifiers.2"
          resolveProxies="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="owner" lowerBound="0"
          containment="false" eType="//@eSubpackages.0/@eClassifiers.4"/>
    </eClassifiers>
    <!-- Class 2: Task, subclass of BaseElement -->
    <eClassifiers xsi:type="ecore:EClass" name="Task"
        eSuperTypes="//@eSubpackages.0/@eClassifiers.0">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="estimateHours" lowerBound="0"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="project" lowerBound="0"
          eType="//@eSubpackages.0/@eClassifiers.1" containment="false">
        <eOpposite xsi:type="ecore:EReference" href="//@eSubpackages.0/@eClassifiers.1/@eStructuralFeatures.1"/>
      </eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" lowerBound="1"
          eType="//@eClassifiers.0"/>
    </eClassifiers>
    <!-- Class 3: Abstract superclass with no references, for EmptyList in superTypes -->
    <eClassifiers xsi:type="ecore:EClass" name="StandaloneAbstract" abstract="true"/>
    <!-- Class 4: User, subclass of BaseElement and StandaloneAbstract -->
    <eClassifiers xsi:type="ecore:EClass" name="User"
        eSuperTypes="//@eSubpackages.0/@eClassifiers.0 //@eSubpackages.0/@eClassifiers.3">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
          defaultValueLiteral="anonymous"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" lowerBound="0"
          defaultValueLiteral="true"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    </eClassifiers>
  </eSubpackages>

  <!-- Subpackage 1 -->
  <eSubpackages name="aux(data)" nsURI="http://example.org/metaRoot6/aux" nsPrefix="aux6">
    <!-- EEnum 0 -->
    <eClassifiers xsi:type="ecore:EEnum" name="TaskState">
      <eLiterals name="NEW" value="0" literal="NEW"/>
      <eLiterals name="IN_PROGRESS" value="1" literal="IN_PROGRESS"/>
      <eLiterals name="DONE" value="2" literal="DONE"/>
    </eClassifiers>
    <!-- EEnum 1 with single literal (for single-element EnumLit cases) -->
    <eClassifiers xsi:type="ecore:EEnum" name="Priority">
      <eLiterals name="NORMAL" value="0" literal="NORMAL"/>
    </eClassifiers>
    <!-- Class 2: Misc, to exercise EReference without opposite and upperBound=-1 -->
    <eClassifiers xsi:type="ecore:EClass" name="Misc">
      <eStructuralFeatures xsi:type="ecore:EReference" name="relatedUsers" lowerBound="0" upperBound="-1"
          containment="false" eType="//@eSubpackages.0/@eClassifiers.4"/>
      <eStructuralFeatures xsi:type="eccore:EAttribute" name="note" lowerBound="0"
          defaultValueLiteral="none"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="importance" lowerBound="0"
          defaultValueLiteral="NORMAL"
          eType="//@eSubpackages.1/@eClassifiers.1"/>
    </eClassifiers>
  </eSubpackages>

  <!-- EEnum at root, used by Task.status -->
  <eClassifiers xsi:type="ecore:EEnum" name="StatusKind">
    <eLiterals name="OPEN" value="0" literal="OPEN"/>
    <eLiterals name="CLOSED" value="1" literal="CLOSED"/>
  </eClassifiers>

</ecore:EPackage>