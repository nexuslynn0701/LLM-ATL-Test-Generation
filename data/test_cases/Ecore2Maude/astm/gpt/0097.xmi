<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore"
    name="rootPkg"
    nsURI="http://example.org/rootPkg"
    nsPrefix="root">

  <!-- Subpackage to exercise superPackage/subPackages -->
  <eSubpackages name="subPkg"
                nsURI="http://example.org/subPkg"
                nsPrefix="sub">
    <!-- Class in subpackage, extends Person to exercise superTypes and createSort -->
    <eClassifiers xsi:type="ecore:EClass" name="Employee">
      <eSuperTypes href="//@eClassifiers.1"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute"
                           name="employeeId"
                           iD="true"
                           lowerBound="1"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eStructuralFeatures xsi:type="ecore:EReference"
                           name="manager"
                           lowerBound="0"
                           eType="//@eSubpackages.0/@eClassifiers.0"/>
    </eClassifiers>
  </eSubpackages>

  <!-- 0: Root-level EClass -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="street"
                         lowerBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                         defaultValueLiteral="Main &quot;Street&quot;"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="number"
                         lowerBound="0"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                         defaultValueLiteral="10"/>
  </eClassifiers>

  <!-- 1: Root-level EClass with superType and references/attributes -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eSuperTypes href="//@eClassifiers.2"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="name"
                         lowerBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="age"
                         lowerBound="0"
                         upperBound="-1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="homeAddress"
                         lowerBound="0"
                         eType="//@eClassifiers.0"
                         containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="bestFriend"
                         lowerBound="0"
                         upperBound="1"
                         eType="//@eClassifiers.1"
                         eOpposite="//@eClassifiers.1/@eStructuralFeatures.3"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="friends"
                         lowerBound="0"
                         upperBound="-1"
                         eType="//@eClassifiers.1"/>
  </eClassifiers>

  <!-- 2: Abstract superclass -->
  <eClassifiers xsi:type="ecore:EClass" name="NamedElement" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="id"
                         iD="false"
                         lowerBound="0"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- 3: Enumeration with two literals -->
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="red" value="0" literal="RED"/>
    <eLiterals name="blue" value="1" literal="BLUE"/>
  </eClassifiers>

  <!-- 4: Class using the enumeration and various attribute types -->
  <eClassifiers xsi:type="ecore:EClass" name="Car">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="plate"
                         iD="true"
                         lowerBound="1"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                         defaultValueLiteral="ABC-123"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="color"
                         lowerBound="1"
                         eType="//@eClassifiers.3"
                         defaultValueLiteral="red"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="electric"
                         lowerBound="0"
                         eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
                         defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="owner"
                         lowerBound="0"
                         upperBound="1"
                         eType="//@eClassifiers.1"/>
  </eClassifiers>

</ecore:EPackage>