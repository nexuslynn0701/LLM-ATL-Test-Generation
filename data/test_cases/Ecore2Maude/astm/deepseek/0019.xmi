<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="testModel" nsURI="http://test/1.0" nsPrefix="test">
  
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="count" lowerBound="0" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="42"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" lowerBound="0" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ratio" lowerBound="0" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="3.14"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" upperBound="-1" eType="//@eClassifiers.1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" lowerBound="0" eType="//@eClassifiers.0" containment="false"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" abstract="false" interface="false" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="0" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sibling" lowerBound="0" eType="//@eClassifiers.1" eOpposite="//@eClassifiers.1/@eStructuralFeatures.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="siblingOpposite" lowerBound="0" eType="//@eClassifiers.1" eOpposite="//@eClassifiers.1/@eStructuralFeatures.1"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="AbstractBase" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="baseAttr" lowerBound="0" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="ConcreteDerived" abstract="false" interface="false" eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EReference" name="items" upperBound="-1" eType="//@eClassifiers.4" containment="true"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="ItemClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="itemName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="quantity" lowerBound="0" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="PENDING" value="0" literal="pending"/>
    <eLiterals name="ACTIVE" value="1" literal="active"/>
    <eLiterals name="COMPLETED" value="2" literal="completed"/>
    <eLiterals name="ARCHIVED" value="3" literal="archived"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="red"/>
    <eLiterals name="GREEN" value="1" literal="green"/>
    <eLiterals name="BLUE" value="2" literal="blue"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="EnumHolder" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" lowerBound="0" eType="//@eClassifiers.5" defaultValueLiteral="PENDING"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="color" lowerBound="0" eType="//@eClassifiers.6" defaultValueLiteral="RED"/>
  </eClassifiers>
  
  <eSubpackages name="subPkg" nsURI="http://test/sub/1.0" nsPrefix="testSub">
    <eClassifiers xsi:type="ecore:EClass" name="SubClass" abstract="false" interface="false">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="subName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="backRef" lowerBound="0" eType="//@eClassifiers.0"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EDataType" name="CustomDataType" serializable="true"/>
  </eSubpackages>
  
</ecore:EPackage>