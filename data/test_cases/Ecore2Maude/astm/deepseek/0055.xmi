<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="Library" nsURI="http://library/1.0" nsPrefix="lib">
  <eClassifiers xsi:type="ecore:EClass" name="Book">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pages" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="100"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="author" lowerBound="1" eType="//@eClassifiers.4" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="library" eType="//@eClassifiers.1" eOpposite="//@eClassifiers.1/eStructuralFeatures.0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Library">
    <eStructuralFeatures xsi:type="ecore:EReference" name="books" upperBound="-1" eType="//@eClassifiers.0" containment="true" eOpposite="//@eClassifiers.0/eStructuralFeatures.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="members" upperBound="-1" eType="//@eClassifiers.2" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Member">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memberId" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="checkedOut" upperBound="-1" eType="//@eClassifiers.0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Author" eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="penName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="books" upperBound="-1" eType="//@eClassifiers.0" eOpposite="//@eClassifiers.0/eStructuralFeatures.1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Genre">
    <eLiterals name="FICTION" value="0" literal="Fiction"/>
    <eLiterals name="NON_FICTION" value="1" literal="Non-Fiction"/>
    <eLiterals name="SCIENCE_FICTION" value="2" literal="Science Fiction"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="AVAILABLE" value="0" literal="Available"/>
    <eLiterals name="CHECKED_OUT" value="1" literal="Checked Out"/>
    <eLiterals name="RESERVED" value="2" literal="Reserved"/>
  </eClassifiers>
  <eSubpackages name="SubLibrary" nsURI="http://sublib/1.0" nsPrefix="slib">
    <eClassifiers xsi:type="ecore:EEnum" name="SubGenre">
      <eLiterals name="MYSTERY" value="0" literal="Mystery"/>
      <eLiterals name="ROMANCE" value="1" literal="Romance"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>