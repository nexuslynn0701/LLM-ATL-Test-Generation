<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestModel" nsURI="http://test/1.0" nsPrefix="test">
  
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rootName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rootCount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="0"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="ConcreteClass" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="weight" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat" defaultValueLiteral="1.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" upperBound="-1" eType="//@eClassifiers.2" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="//@eClassifiers.1" eOpposite="//@eClassifiers.1/@eStructuralFeatures.2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="related" upperBound="-1" eType="//@eClassifiers.3"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="index" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="container" eType="//@eClassifiers.1" eOpposite="//@eClassifiers.1/@eStructuralFeatures.2"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="RelatedClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="backRef" upperBound="-1" eType="//@eClassifiers.1"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="PENDING" value="0" literal="pending"/>
    <eLiterals name="ACTIVE" value="1" literal="active"/>
    <eLiterals name="COMPLETED" value="2" literal="completed"/>
    <eLiterals name="ARCHIVED" value="3" literal="archived"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="StatusContainer">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="currentStatus" eType="//@eClassifiers.4" defaultValueLiteral="PENDING"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priority" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject" defaultValueLiteral="0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ratio" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDoubleObject" defaultValueLiteral="0.0"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EDataType" name="CustomType" instanceClassName="java.lang.String"/>
  
  <eSubpackages name="SubPkg" nsURI="http://test/sub/1.0" nsPrefix="sub">
    <eClassifiers xsi:type="ecore:EClass" name="SubClass">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="subName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="subCount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="linkToRoot" eType="//@eClassifiers.1"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="Color">
      <eLiterals name="RED" value="0" literal="red"/>
      <eLiterals name="GREEN" value="1" literal="green"/>
      <eLiterals name="BLUE" value="2" literal="blue"/>
    </eClassifiers>
  </eSubpackages>
  
</ecore:EPackage>