<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestModel" nsURI="http://test/1.0" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="count" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" iD="false" defaultValueLiteral="42"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" iD="false" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ratio" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" iD="false" defaultValueLiteral="3.14"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" upperBound="-1" eType="//@eClassifiers.1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" upperBound="1" eType="//@eClassifiers.1" containment="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rootRef" upperBound="1" eType="//@eClassifiers.0" eOpposite="//@eClassifiers.0/@eStructuralFeatures.5"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="siblings" upperBound="-1" eType="//@eClassifiers.1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AbstractBase" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="baseAttr" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ConcreteClass" abstract="false" interface="false" eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="concreteAttr" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="linked" upperBound="-1" eType="//@eClassifiers.0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="PENDING" value="0" literal="pending"/>
    <eLiterals name="ACTIVE" value="1" literal="active"/>
    <eLiterals name="COMPLETED" value="2" literal="completed"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="EnumHolder" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" lowerBound="1" eType="//@eClassifiers.4" iD="false" defaultValueLiteral="PENDING"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="floatVal" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat" iD="false" defaultValueLiteral="1.5"/>
  </eClassifiers>
  <eSubpackages name="SubPackage" nsURI="http://test/sub/1.0" nsPrefix="sub">
    <eClassifiers xsi:type="ecore:EClass" name="SubClass" abstract="false" interface="false">
      <eStructuralFeatures xsi:type="ecore:EReference" name="toRoot" upperBound="1" eType="//@eClassifiers.0"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>