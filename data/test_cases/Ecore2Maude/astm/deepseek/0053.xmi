<?xml version="1.0" encoding="ISO-8859-1"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="University" nsURI="http://university/1.0" nsPrefix="uni">
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lastName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="18"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Student" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="studentId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gpa" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="courses" upperBound="-1" eType="//@eClassifiers.3" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="advisor" eType="//@eClassifiers.2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Professor" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="employeeId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="50000.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="teaches" upperBound="-1" eType="//@eClassifiers.3" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mentors" upperBound="-1" eType="//@eClassifiers.1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Course">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="credits" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="1" defaultValueLiteral="3"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="grade" eType="//@eClassifiers.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="prerequisites" upperBound="-1" eType="//@eClassifiers.3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Grade">
    <eLiterals xsi:type="ecore:EEnumLiteral" name="A" value="0" literal="A"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="B" value="1" literal="B"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="C" value="2" literal="C"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="D" value="3" literal="D"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="F" value="4" literal="F"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="AddressType" instanceClassName="java.lang.String"/>
  <eClassifiers xsi:type="ecore:EEnum" name="Semester">
    <eLiterals xsi:type="ecore:EEnumLiteral" name="Fall" value="0" literal="Fall"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="Spring" value="1" literal="Spring"/>
    <eLiterals xsi:type="ecore:EEnumLiteral" name="Summer" value="2" literal="Summer"/>
  </eClassifiers>
  <eSubpackages xsi:type="ecore:EPackage" name="Science" nsURI="http://science/1.0" nsPrefix="sci">
    <eClassifiers xsi:type="ecore:EClass" name="LabCourse" eSuperTypes="//@eClassifiers.3">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="location" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="capacity" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="24"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="ta" eType="//@eClassifiers.1"/>
    </eClassifiers>
  </eSubpackages>
  <eSubpackages xsi:type="ecore:EPackage" name="Humanities" nsURI="http://humanities/1.0" nsPrefix="hum"/>
</ecore:EPackage>