    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="false" defaultValueLiteral="hello"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner" eType="//@eClassifiers.0" containment="false" eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
