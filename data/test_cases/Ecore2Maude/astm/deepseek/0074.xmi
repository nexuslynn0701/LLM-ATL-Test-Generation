<?xml version="1.0" encoding="ISO-8859-1"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="company" nsURI="http://company/1.0" nsPrefix="company">
  
  <eClassifiers xsi:type="ecore:EClass" name="Employee">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="empId" iD="true" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="50000"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rating" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager" upperBound="-1" eType="//@eClassifiers.1" containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="department" lowerBound="1" eType="//@eClassifiers.2" containment="false" eOpposite="//@eClassifiers.2/eStructuralFeatures.0"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="Manager" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bonus" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" defaultValueLiteral="10000.0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="team" upperBound="-1" eType="//@eClassifiers.0" containment="true"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees" upperBound="-1" eType="//@eClassifiers.0" containment="true" eOpposite="//@eClassifiers.0/eStructuralFeatures.2"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="budget" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="1000000"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EClass" name="Contractor" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hourlyRate" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="contractEnd" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EEnum" name="EmploymentType">
    <eLiterals name="FullTime" value="0" literal="FullTime"/>
    <eLiterals name="PartTime" value="1" literal="PartTime"/>
    <eLiterals name="Intern" value="2" literal="Intern"/>
  </eClassifiers>
  
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="Active" value="0" literal="Active"/>
    <eLiterals name="Inactive" value="1" literal="Inactive"/>
    <eLiterals name="Suspended" value="2" literal="Suspended"/>
  </eClassifiers>
  
  <eSubpackages name="hr" nsURI="http://company/hr/1.0" nsPrefix="hr">
    <eClassifiers xsi:type="ecore:EClass" name="Payroll">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="payDate" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="employees" upperBound="-1" eType="//@eClassifiers.0" containment="false"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="Benefits"/>
  </eSubpackages>
  
  <eSubpackages name="it" nsURI="http://company/it/1.0" nsPrefix="it">
    <eClassifiers xsi:type="ecore:EClass" name="Server">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="hostname" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="8080"/>
    </eClassifiers>
  </eSubpackages>
  
</ecore:EPackage>