<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="VehicleSystem" nsURI="http://vehicles/1.0" nsPrefix="veh">
  <eClassifiers xsi:type="ecore:EClass" name="Vehicle" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="modelYear" lowerBound="1" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isElectric" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ownerName" lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="false"
        defaultValueLiteral="Unknown Owner"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parts" upperBound="-1"
        eType="//@eClassifiers.2" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="primaryDriver" lowerBound="0" upperBound="1"
        eType="//@eClassifiers.3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="FuelType">
    <eLiterals name="GASOLINE" value="0" literal="gasoline"/>
    <eLiterals name="DIESEL" value="1" literal="diesel"/>
    <eLiterals name="ELECTRIC" value="2" literal="electric"/>
    <eLiterals name="HYBRID" value="3" literal="hybrid"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Part" abstract="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="serialNumber" lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"
        defaultValueLiteral="UNASSIGNED"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="weight" lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloatObject"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subParts" upperBound="-1"
        eType="//@eClassifiers.2" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="belongsTo" lowerBound="1"
        eType="//@eClassifiers.0" eOpposite="//@eClassifiers.0/eStructuralFeatures.0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Driver" abstract="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="height" lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDoubleObject"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="drivesVehicle" lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Motorcycle" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hasSidecar"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" iD="false"
        defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="fuelType" lowerBound="1"
        eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="engineDisplacement" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" iD="false"/>
  </eClassifiers>
</ecore:EPackage>