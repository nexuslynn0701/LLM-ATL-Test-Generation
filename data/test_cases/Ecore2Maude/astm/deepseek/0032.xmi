<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestModel" nsURI="http://test/1.0" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="count" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" iD="false" defaultValueLiteral="42"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" upperBound="-1" eType="//@eClassifiers.1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="//@eClassifiers.0" containment="false" eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" iD="false" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="false" defaultValueLiteral="hello world"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner" eType="//@eClassifiers.0" containment="false" eOpposite="//@eClassifiers.0/@eStructuralFeatures.2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AbstractBase" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="baseAttr" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="baseRef" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" containment="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ConcreteChild" eSuperTypes="//@eClassifiers.2" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="concreteAttr" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="concreteRef" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="red"/>
    <eLiterals name="GREEN" value="1" literal="green"/>
    <eLiterals name="BLUE" value="2" literal="blue"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ColoredClass" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="color" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" iD="false" defaultValueLiteral="RED"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="price" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble" iD="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="quantity" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject" iD="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="CustomDataType" instanceClassName="java.lang.String"/>
  <eClassifiers xsi:type="ecore:EClass" name="DataHolder" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="customData" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" iD="false"/>
  </eClassifiers>
  <eSubpackages name="SubPackage" nsURI="http://test/sub/1.0" nsPrefix="sub">
    <eClassifiers xsi:type="ecore:EClass" name="SubClass" abstract="false" interface="false">
      <eStructuralFeatures xsi:type="ecore:EReference" name="linkToRoot" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" containment="false"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="Status">
      <eLiterals name="OK" value="0" literal="ok"/>
      <eLiterals name="ERROR" value="1" literal="error"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>