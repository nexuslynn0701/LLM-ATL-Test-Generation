<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestMetamodel" nsURI="http://test" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EClass" name="RootClass"/>
  <eClassifiers xsi:type="ecore:EClass" name="SubClass" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="idAttr" iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1" upperBound="1" defaultValueLiteral="defaultId"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="count" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="refToRoot" 
        eType="//@eClassifiers.0" containment="false" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="containedItems" 
        eType="//@eClassifiers.0" containment="true" upperBound="-1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE" value="0" literal="active"/>
    <eLiterals name="INACTIVE" value="1" literal="inactive"/>
    <eLiterals name="PENDING" value="2" literal="pending"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ConfigClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" 
        eType="//@eClassifiers.2" lowerBound="1" upperBound="1" 
        defaultValueLiteral="ACTIVE"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="oppositeRef" 
        eType="//@eClassifiers.1" eOpposite="//@eClassifiers.1/eStructuralFeatures.2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EPackage" name="SubPackage">
    <eClassifiers xsi:type="ecore:EClass" name="NestedClass">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag" 
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
          defaultValueLiteral="true"/>
    </eClassifiers>
  </eClassifiers>
</ecore:EPackage>