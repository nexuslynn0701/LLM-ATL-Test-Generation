<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestMetamodel" nsURI="http://test" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="ACTIVE" value="0" literal="active"/>
    <eLiterals name="INACTIVE" value="1" literal="inactive"/>
    <eLiterals name="PENDING" value="2" literal="pending"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" iD="true" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" lowerBound="1"
        eType="//@eClassifiers.0" defaultValueLiteral="ACTIVE"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" 
        defaultValueLiteral="A default description with &quot;quotes&quot; and backslash \\"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Address" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="city" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="false" interface="false">
    <eSuperTypes>//@eClassifiers.1</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary" lowerBound="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="workAddress" containment="true"
        eType="//@eClassifiers.2" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="homeAddress" containment="true"
        eType="//@eClassifiers.2" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager" eOpposite="//@eClassifiers.4/eStructuralFeatures.0"
        eType="//@eClassifiers.3" resolveProxies="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deptName" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees" upperBound="-1" unique="false"
        eType="//@eClassifiers.3" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager" eOpposite="//@eClassifiers.3/eStructuralFeatures.3"
        eType="//@eClassifiers.3" resolveProxies="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Project" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="projectName" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SoftwareProject" abstract="false" interface="false">
    <eSuperTypes>//@eClassifiers.5</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="language" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EPackage" name="SubPackage" nsURI="http://sub" nsPrefix="sub">
    <eClassifiers xsi:type="ecore:EClass" name="ExternalEntity" abstract="false" interface="false">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="externalId" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eClassifiers>
  </eClassifiers>
</ecore:EPackage>