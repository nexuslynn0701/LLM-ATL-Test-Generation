<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestModel65" nsURI="http://test/model65" nsPrefix="tm65">
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1"/>
    <eLiterals name="PENDING" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RootClass"/>
  <eClassifiers xsi:type="ecore:EClass" name="BaseEntity" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" eType="//@eClassifiers.0" defaultValueLiteral="ACTIVE"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="count" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="0" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" ordered="false" unique="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SpecializedEntity" eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="//@eClassifiers.2" containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" eType="//@eClassifiers.3" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="related" eType="//@eClassifiers.2" upperBound="-1" resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Container" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EReference" name="items" eType="//@eClassifiers.2" upperBound="-1" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AbstractFeature" abstract="true" interface="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="featureCode" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
</ecore:EPackage>