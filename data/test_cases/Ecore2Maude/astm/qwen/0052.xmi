<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestMM" nsURI="http://testmm/1.0" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="red"/>
    <eLiterals name="GREEN" value="1" literal="green"/>
    <eLiterals name="BLUE" value="2" literal="blue"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RootClass"/>
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="idAttr" lowerBound="1" iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" defaultValueLiteral="defaultId"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="count" lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag" lowerBound="1" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="colorValue" lowerBound="0" upperBound="1"
        eType="//@eClassifiers.0" defaultValueLiteral="GREEN"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="selfRef" lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.2" containment="false" resolveProxies="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DerivedClass" eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EReference" name="containerRef" lowerBound="1" upperBound="1"
        eType="//@eClassifiers.2" containment="true" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="oppositeRef" lowerBound="0" upperBound="1"
        eType="//@eClassifiers.4" eOpposite="//@eClassifiers.4/eStructuralFeatures.0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RelatedClass">
    <eStructuralFeatures xsi:type="ecore:EReference" name="backRef" lowerBound="0" upperBound="1"
        eType="//@eClassifiers.3" eOpposite="//@eClassifiers.3/eStructuralFeatures.1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AbstractClass" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="ConcreteClass" eSuperTypes="//@eClassifiers.5"/>
</ecore:EPackage>