<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestMetamodel" nsURI="http://test" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="ACTIVE" value="0" literal="active"/>
    <eLiterals name="INACTIVE" value="1" literal="inactive"/>
    <eLiterals name="PENDING" value="2" literal="pending"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" lowerBound="1" eType="//@eClassifiers.0" defaultValueLiteral="ACTIVE"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" containment="true" resolveProxies="true" eType="//@eClassifiers.2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Address" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="city" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner" eOpposite="//@eClassifiers.1/@eStructuralFeatures.4" eType="//@eClassifiers.1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Organization" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="orgName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="members" upperBound="-1" containment="true" eType="//@eClassifiers.1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Company" abstract="false" interface="false">
    <eSuperTypes>//@eClassifiers.3</eSuperTypes>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="revenue" lowerBound="0" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Department" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deptCode" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees" upperBound="-1" ordered="true" unique="false" eType="//@eClassifiers.1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subDepartments" upperBound="-1" containment="true" eType="//@eClassifiers.5"/>
  </eClassifiers>
</ecore:EPackage>