<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestModel0059" nsURI="http://testmodel0059" nsPrefix="tm0059">
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE"/>
    <eLiterals name="INACTIVE" value="1"/>
    <eLiterals name="PENDING" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RootClass"/>
  <eClassifiers xsi:type="ecore:EClass" name="BaseEntity" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" iD="true" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" defaultValueLiteral="defaultName"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" lowerBound="1"
        eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="score" lowerBound="0" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" lowerBound="0"
        eType="//@eClassifiers.2" eOpposite="//@eClassifiers.3/@eStructuralFeatures.4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.2" containment="true" eOpposite="//@eClassifiers.2/@eStructuralFeatures.4"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SpecializedEntity" eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="related" lowerBound="1" upperBound="-1"
        eType="//@eClassifiers.2" resolveProxies="false"/>
  </eClassifiers>
  <eSubpackages name="SubPackage1" nsURI="http://sub1" nsPrefix="sp1">
    <eClassifiers xsi:type="ecore:EClass" name="NestedClass">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>