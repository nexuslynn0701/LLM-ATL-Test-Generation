<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestMM" nsURI="http://testmm/1.0" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EClass" name="RootClass"/>
  <eClassifiers xsi:type="ecore:EClass" name="BaseClass" eSuperTypes="//@eClassifiers.0">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="idAttr" iD="true" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" defaultValueLiteral="defaultId"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="count" lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="refToSelf" lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.1" containment="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DerivedClass" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="containedChild" lowerBound="0" upperBound="-1"
        eType="//@eClassifiers.3" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ChildClass">
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" lowerBound="1"
        eType="//@eClassifiers.2" containment="false" eOpposite="//@eClassifiers.2/@eStructuralFeatures.1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="StatusEnum">
    <eLiterals name="ACTIVE" value="0" literal="active"/>
    <eLiterals name="INACTIVE" value="1" literal="inactive"/>
    <eLiterals name="PENDING" value="2" literal="pending"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ConfigClass">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" lowerBound="1"
        eType="//@eClassifiers.4" defaultValueLiteral="ACTIVE"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" lowerBound="0" upperBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EPackage" name="SubPackage" nsURI="http://testmm/sub/1.0" nsPrefix="sub">
    <eClassifiers xsi:type="ecore:EClass" name="NestedClass">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    </eClassifiers>
  </eClassifiers>
</ecore:EPackage>