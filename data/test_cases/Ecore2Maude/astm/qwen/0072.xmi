<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestMM" nsURI="http://testmm/1.0" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="Active"/>
    <eLiterals name="Inactive" value="1"/>
    <eLiterals name="Pending" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RootClass"/>
  <eClassifiers xsi:type="ecore:EClass" name="BaseEntity" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" defaultValueLiteral="Default Description"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" eType="//@eClassifiers.0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SpecializedEntity" eSuperTypes="//@eClassifiers.2">
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="//@eClassifiers.2" containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" eType="//@eClassifiers.3" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="related" eType="//@eClassifiers.2" upperBound="-1" resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Container" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EReference" name="items" eType="//@eClassifiers.2" upperBound="-1" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EPackage" name="SubPackage">
    <eClassifiers xsi:type="ecore:EClass" name="NestedClass">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eClassifiers>
  </eClassifiers>
</ecore:EPackage>