<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestMM" nsURI="http://testmm/1.0" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="red"/>
    <eLiterals name="GREEN" value="1" literal="green"/>
    <eLiterals name="BLUE" value="2" literal="blue"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RootClass" abstract="true" interface="false"/>
  <eClassifiers xsi:type="ecore:EClass" name="Person" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="favColor" eType="//@eClassifiers.0" defaultValueLiteral="GREEN"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="idAttr" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" eType="//@eClassifiers.3" containment="true" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="friends" upperBound="-1" eType="//@eClassifiers.2" resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner" eType="//@eClassifiers.2" eOpposite="//@eClassifiers.2/@eStructuralFeatures.5" resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Organization" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="orgName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="members" upperBound="-1" eType="//@eClassifiers.2" containment="true" resolveProxies="false"/>
  </eClassifiers>
  <eSubpackages name="SubPkg" nsURI="http://testmm/sub/1.0" nsPrefix="sub">
    <eClassifiers xsi:type="ecore:EClass" name="SpecialPerson" eSuperTypes="//@eClassifiers.2 //@eClassifiers.4">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="specialCode" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>