<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestModel" nsURI="http://testmodel" nsPrefix="tm">
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="red"/>
    <eLiterals name="GREEN" value="1" literal="green"/>
    <eLiterals name="BLUE" value="2" literal="blue"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RootPackage" eSuperTypes="">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="idAttr" iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="1" upperBound="1" defaultValueLiteral="defaultId"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="count" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        lowerBound="0" upperBound="1" defaultValueLiteral="5"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        lowerBound="0" upperBound="1" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="colorValue" 
        eType="//@eClassifiers.0"
        lowerBound="0" upperBound="1" defaultValueLiteral="GREEN"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="child" 
        eType="//@eClassifiers.2" containment="true" lowerBound="0" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parentRef" 
        eType="//@eClassifiers.2" eOpposite="//@eClassifiers.2/eStructuralFeatures.6"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ChildElement" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        lowerBound="0" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sibling" 
        eType="//@eClassifiers.2" containment="false" resolveProxies="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="oppositeRef" 
        eType="//@eClassifiers.1" eOpposite="//@eClassifiers.1/eStructuralFeatures.5"/>
  </eClassifiers>
</ecore:EPackage>