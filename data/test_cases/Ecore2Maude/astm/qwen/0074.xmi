<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestModel" nsURI="http://test/model" nsPrefix="tm">
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="RED" value="0" literal="red"/>
    <eLiterals name="GREEN" value="1" literal="green"/>
    <eLiterals name="BLUE" value="2" literal="blue"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="favoriteColor" lowerBound="0" upperBound="1" eType="//@eClassifiers.0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="idCode" iD="true" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" defaultValueLiteral="defaultId"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="address" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="friends" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" ordered="true" unique="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Address" abstract="false" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="city" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="resident" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" eOpposite="//@eClassifiers.1/eStructuralFeatures.5"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Organization" abstract="true" interface="false">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="orgName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Company" eSuperTypes="//@eClassifiers.3">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="revenue" lowerBound="0" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" containment="true"/>
  </eClassifiers>
  <eSubpackages name="subPkg" nsURI="http://test/model/sub" nsPrefix="sub">
    <eClassifiers xsi:type="ecore:EClass" name="Department">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="deptName" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="members" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>