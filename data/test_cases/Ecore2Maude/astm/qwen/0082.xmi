<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://ecore" name="TestMM" nsURI="http://testmm/1.0" nsPrefix="test">
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="Active"/>
    <eLiterals name="Inactive" value="1"/>
    <eLiterals name="Pending" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" 
        eType="//@eClassifiers.0" defaultValueLiteral="Active"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="city" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Employee" eSuperTypes="//@eClassifiers.1">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary" 
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="workAddress" 
        eType="//@eClassifiers.2" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="homeAddress" 
        eType="//@eClassifiers.2" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager" 
        eType="//@eClassifiers.3" eOpposite="//@eClassifiers.3/eStructuralFeatures.4"/>
  </eClassifiers>
  <eStructuralFeatures xsi:type="ecore:EReference" name="teamMembers" upperBound="-1"
      eType="//@eClassifiers.3" eOpposite="//@eClassifiers.3/eStructuralFeatures.3"/>
</ecore:EPackage>