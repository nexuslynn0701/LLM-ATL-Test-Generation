<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net003" name="RetryCycle">
    <elements xsi:type="Grafcet:Step" location="s001" name="Ready" isInitial="true" isActive="true" action="prepare"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="Run" condition="enabled"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="Execute" isInitial="false" isActive="false" action="execute"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="Retry" condition="failed"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="readyToRun" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="runToExecute" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c003" name="executeToRetry" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c004" name="retryToReady" from="/0/@elements.3" to="/0/@elements.0"/>
  </Grafcet:Grafcet>
</xmi:XMI>
