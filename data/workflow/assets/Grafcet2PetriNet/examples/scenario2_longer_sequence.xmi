<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net002" name="LongerSequence">
    <elements xsi:type="Grafcet:Step" location="s001" name="Idle" isInitial="true" isActive="true" action="wait"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="Start" condition="startPressed"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="Working" isInitial="false" isActive="false" action="process"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="Finish" condition="workComplete"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="Done" isInitial="false" isActive="false" action="stop"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="idleToStart" from="/0/@elements.0" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="startToWorking" from="/0/@elements.1" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c003" name="workingToFinish" from="/0/@elements.2" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c004" name="finishToDone" from="/0/@elements.3" to="/0/@elements.4"/>
  </Grafcet:Grafcet>
</xmi:XMI>
