<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ClasspathBuild"
    basedir="."
    description="Compile with a filtered classpath"
    default="compile">
  <targets xmi:id="compile" name="compile">
    <tasks xsi:type="Ant:Javac"
        srcdir="src"
        destdir="build/classes"
        debug="true">
      <classPath refid="compile.classpath">
        <pathElement path="lib/core.jar" location="lib"/>
        <pathElement path="lib/test.jar" location="lib"/>
        <fileset dir="lib">
          <patternset>
            <inexcludes xsi:type="Ant:Includes" name="**/*.jar"/>
            <inexcludes xsi:type="Ant:Excludes" name="**/*-sources.jar"/>
          </patternset>
        </fileset>
      </classPath>
    </tasks>
  </targets>
</Ant:Project>
