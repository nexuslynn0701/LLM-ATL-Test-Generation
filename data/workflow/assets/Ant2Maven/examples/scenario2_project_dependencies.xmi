<?xml version="1.0" encoding="ASCII"?>
<Ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:Ant="Ant"
    name="ApplicationBuild"
    basedir="."
    description="Compile and package application"
    default="package">
  <properties xsi:type="Ant:PropertyValue" name="encoding" value="UTF-8"/>
  <properties xsi:type="Ant:PropertyLocation" name="output.dir" location="build"/>
  <targets xmi:id="compile" name="compile"/>
  <targets xmi:id="package" name="package" depends="compile"/>
</Ant:Project>
