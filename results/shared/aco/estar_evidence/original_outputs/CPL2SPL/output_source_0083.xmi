<?xml version="1.0" encoding="ISO-8859-1"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:SPL="http://spl/1.0">
  <SPL:Method direction="in">
    <type xsi:type="SPL:SimpleType" type="response"/>
    <methodName xsi:type="SPL:SIPMethodName" name="INVITE"/>
  </SPL:Method>
  <SPL:RedirectionErrorResponse errorKind="USE_PROXY"/>
  <SPL:SelectDefault>
    <commentsBefore>// default</commentsBefore>
  </SPL:SelectDefault>
  <SPL:DeclarationStat>
    <declaration xsi:type="SPL:VariableDeclaration" name="shannon"/>
  </SPL:DeclarationStat>
  <SPL:SelectCase>
    <statements xsi:type="SPL:ReturnStat">
      <returnedValue xsi:type="SPL:ForwardExp">
        <exp xsi:type="SPL:ConstantExp"/>
      </returnedValue>
    </statements>
    <values xsi:type="SPL:StringConstant" value="knuth"/>
  </SPL:SelectCase>
</xmi:XMI>
