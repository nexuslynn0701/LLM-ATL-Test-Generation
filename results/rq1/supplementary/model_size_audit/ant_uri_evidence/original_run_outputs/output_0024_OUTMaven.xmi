<?xml version="1.0" encoding="ISO-8859-1"?>
<MavenMaven:Project xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:MavenMaven="MavenMaven" default="//@goals.0">
  <xmlns name="ant" value="jelly:ant"/>
  <properties xsi:type="MavenMaven:AntPropertyValue" name="src.dir" value="src/main/java"/>
  <properties xsi:type="MavenMaven:AntPropertyLocation" name="build.dir" location="build"/>
  <properties xsi:type="MavenMaven:AntPropertyFile" file="build.properties"/>
  <properties xsi:type="MavenMaven:AntPropertyEnv" environment="env."/>
  <taskdefs name="customTask" classname="com.example.ant.CustomTask"/>
  <goals name="buildMain"/>
  <goals name="buildTest"/>
  <goals name="cleanAll"/>
</MavenMaven:Project>
