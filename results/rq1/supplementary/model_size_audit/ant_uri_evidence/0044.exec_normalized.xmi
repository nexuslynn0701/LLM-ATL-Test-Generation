<?xml version='1.0' encoding='ASCII'?>
<Ant:Project xmlns:Ant="Ant" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmi:version="2.0" name="ComplexBuild" basedir="." description="Ant project with multiple targets and varied predefined tasks" default="buildTarget" xmi:id="traceid_0001">

  
  <targets xmi:id="buildTarget" name="build" description="Compile sources, create jar and clean build directory">
    
    <tasks xsi:type="Ant:Mkdir" dir="build/classes" xmi:id="traceid_0002">
      <target href="#buildTarget" xmi:id="traceid_0003" />
    </tasks>
    <tasks xsi:type="Ant:Mkdir" dir="dist" xmi:id="traceid_0004">
      <target href="#buildTarget" xmi:id="traceid_0005" />
    </tasks>

    
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="true" xmi:id="traceid_0006">
      <target href="#buildTarget" xmi:id="traceid_0007" />
    </tasks>

    
    <tasks xsi:type="Ant:Javadoc" sourcepath="src/main/java" destdir="build/javadoc" packagenames="com.example.**" defaultexcludes="true" author="true" version="true" use="true" windowtitle="ComplexBuild API" xmi:id="traceid_0008">
      <target href="#buildTarget" xmi:id="traceid_0009" />
    </tasks>

    
    <tasks xsi:type="Ant:Jar" jarfile="dist/complexbuild.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="META-INF/MANIFEST.MF" xmi:id="traceid_0010">
      <target href="#buildTarget" xmi:id="traceid_0011" />
    </tasks>

    
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" defaultexcludes="true" xmi:id="traceid_0012">
      <target href="#buildTarget" xmi:id="traceid_0013" />
    </tasks>
  </targets>

  
  <targets xmi:id="docTarget" name="doc" description="Generate standalone Javadoc">
    <tasks xsi:type="Ant:Mkdir" dir="build/docsOnly" xmi:id="traceid_0014">
      <target href="#docTarget" xmi:id="traceid_0015" />
    </tasks>

    <tasks xsi:type="Ant:Javadoc" sourcepath="src/main/java" destdir="build/docsOnly" packagenames="com.example.docs.**" defaultexcludes="false" author="false" version="false" use="false" windowtitle="Docs Only" xmi:id="traceid_0016">
      <target href="#docTarget" xmi:id="traceid_0017" />
    </tasks>
  </targets>

</Ant:Project>