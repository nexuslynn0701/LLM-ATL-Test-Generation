<?xml version='1.0' encoding='ASCII'?>
<Ant:Project xmlns:Ant="Ant" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmi:version="2.0" name="ComplexBuild" basedir="." description="Project with multiple targets and diverse predefined tasks" default="build-main" xmi:id="traceid_0001">

  <targets xmi:id="build-main" name="build-main" description="Compile sources and create main jar">
    <tasks xsi:type="Ant:Mkdir" xmi:id="traceid_0002">
      <target href="#build-main" xmi:id="traceid_0003" />
    </tasks>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="true" xmi:id="traceid_0004">
      <target href="#build-main" xmi:id="traceid_0005" />
    </tasks>
    <tasks xsi:type="Ant:Jar" jarfile="dist/main-app.jar" basedir="build/classes" compress="true" encoding="UTF-8" xmi:id="traceid_0006">
      <target href="#build-main" xmi:id="traceid_0007" />
    </tasks>
  </targets>

  <targets xmi:id="build-doc" name="build-doc" description="Generate API documentation">
    <tasks xsi:type="Ant:Mkdir" xmi:id="traceid_0008">
      <target href="#build-doc" xmi:id="traceid_0009" />
    </tasks>
    <tasks xsi:type="Ant:Javadoc" sourcepath="src/main/java" destdir="build/docs" packagenames="com.example.*" defaultexcludes="true" author="true" version="true" use="true" windowtitle="ComplexBuild API" xmi:id="traceid_0010">
      <target href="#build-doc" xmi:id="traceid_0011" />
    </tasks>
  </targets>

  <targets xmi:id="clean-all" name="clean-all" description="Clean build outputs">
    <tasks xsi:type="Ant:Delete" dir="build" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" defaultexcludes="true" xmi:id="traceid_0012">
      <target href="#clean-all" xmi:id="traceid_0013" />
    </tasks>
    <tasks xsi:type="Ant:Delete" dir="dist" verbose="true" quiet="false" failonerror="true" includeEmptyDirs="true" xmi:id="traceid_0014">
      <target href="#clean-all" xmi:id="traceid_0015" />
    </tasks>
  </targets>

</Ant:Project>