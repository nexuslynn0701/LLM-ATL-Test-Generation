<?xml version='1.0' encoding='ASCII'?>
<Ant:Project xmlns:Ant="Ant" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmi:version="2.0" name="LibraryBuild" basedir="." description="Build and test a small library" default="buildMain" xmi:id="traceid_0001">

  
  <properties xsi:type="Ant:PropertyValue" name="src.dir" value="src/main/java" xmi:id="traceid_0002" />
  <properties xsi:type="Ant:PropertyLocation" name="build.dir" location="build" xmi:id="traceid_0003" />
  <properties xsi:type="Ant:PropertyFile" file="build.properties" xmi:id="traceid_0004" />
  <properties xsi:type="Ant:PropertyEnv" environment="env." xmi:id="traceid_0005" />

  
  <taskdef name="customTask" classname="com.example.ant.CustomTask" xmi:id="traceid_0006" />

  
  <targets xmi:id="buildMain" name="buildMain" description="Compile and package main code">
    <tasks xsi:type="Ant:Mkdir" xmi:id="traceid_0007">
      <target href="#buildMain" xmi:id="traceid_0008" />
      <dir xmi:id="traceid_0009">build/classes</dir>
    </tasks>
    <tasks xsi:type="Ant:Javac" srcdir="src/main/java" destdir="build/classes" debug="true" fork="false" optimize="true" deprecation="true" xmi:id="traceid_0010">
      <target href="#buildMain" xmi:id="traceid_0011" />
    </tasks>
    <tasks xsi:type="Ant:Jar" jarfile="dist/library-main.jar" basedir="build/classes" compress="true" encoding="UTF-8" manifest="META-INF/MANIFEST.MF" xmi:id="traceid_0012">
      <target href="#buildMain" xmi:id="traceid_0013" />
    </tasks>
  </targets>

  
  <targets xmi:id="buildTest" name="buildTest" description="Compile and package tests" ifCondition="run.tests">
    <tasks xsi:type="Ant:Mkdir" xmi:id="traceid_0014">
      <target href="#buildTest" xmi:id="traceid_0015" />
      <dir xmi:id="traceid_0016">build/test-classes</dir>
    </tasks>
    <tasks xsi:type="Ant:Javac" srcdir="src/test/java" destdir="build/test-classes" debug="true" fork="false" optimize="false" deprecation="false" xmi:id="traceid_0017">
      <target href="#buildTest" xmi:id="traceid_0018" />
    </tasks>
    <tasks xsi:type="Ant:Jar" jarfile="dist/library-tests.jar" basedir="build/test-classes" compress="false" encoding="UTF-8" xmi:id="traceid_0019">
      <target href="#buildTest" xmi:id="traceid_0020" />
    </tasks>
  </targets>

  
  <targets xmi:id="cleanAll" name="cleanAll" description="Remove build and dist artifacts" unless="keep.build">
    <tasks xsi:type="Ant:Delete" xmi:id="traceid_0021">
      <target href="#cleanAll" xmi:id="traceid_0022" />
      <dir xmi:id="traceid_0023">build</dir>
      <verbose xmi:id="traceid_0024">true</verbose>
      <quiet xmi:id="traceid_0025">false</quiet>
      <failonerror xmi:id="traceid_0026">true</failonerror>
      <includeEmptyDirs xmi:id="traceid_0027">true</includeEmptyDirs>
      <includes xmi:id="traceid_0028">**/*</includes>
      <defaultexcludes xmi:id="traceid_0029">false</defaultexcludes>
    </tasks>
    <tasks xsi:type="Ant:Delete" xmi:id="traceid_0030">
      <target href="#cleanAll" xmi:id="traceid_0031" />
      <dir xmi:id="traceid_0032">dist</dir>
      <verbose xmi:id="traceid_0033">true</verbose>
      <quiet xmi:id="traceid_0034">false</quiet>
      <failonerror xmi:id="traceid_0035">true</failonerror>
      <includeEmptyDirs xmi:id="traceid_0036">true</includeEmptyDirs>
      <includes xmi:id="traceid_0037">**/*.jar</includes>
      <defaultexcludes xmi:id="traceid_0038">false</defaultexcludes>
    </tasks>
  </targets>

</Ant:Project>