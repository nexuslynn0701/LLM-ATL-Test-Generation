<?xml version="1.0" encoding="ISO-8859-1"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:SPL="http://spl/1.0">
  <SPL:Program>
    <service name="unnamed">
      <sessions xsi:type="SPL:Dialog"/>
    </service>
  </SPL:Program>
  <SPL:RedirectionErrorResponse errorKind="USE_PROXY"/>
  <SPL:SelectCase>
    <commentsBefore>// busy</commentsBefore>
    <values xsi:type="SPL:ResponseConstant">
      <response xsi:type="SPL:ClientErrorResponse" errorKind="BUSY_HERE"/>
    </values>
  </SPL:SelectCase>
  <SPL:DeclarationStat>
    <declaration xsi:type="SPL:VariableDeclaration" name="burnell"/>
  </SPL:DeclarationStat>
  <SPL:SelectCase>
    <values xsi:type="SPL:StringConstant" value="curie"/>
  </SPL:SelectCase>
  <SPL:SelectDefault>
    <statements xsi:type="SPL:ReturnStat">
      <returnedValue xsi:type="SPL:ForwardExp">
        <exp xsi:type="SPL:ConstantExp"/>
      </returnedValue>
    </statements>
  </SPL:SelectDefault>
</xmi:XMI>
