<?xml version="1.0" encoding="ISO-8859-1"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:SPL="http://spl/1.0">
  <SPL:Method direction="out">
    <type xsi:type="SPL:SimpleType" type="request"/>
    <methodName xsi:type="SPL:SIPMethodName" name="NOTIFY"/>
    <statements xsi:type="SPL:DeclarationStat">
      <declaration xsi:type="SPL:VariableDeclaration" name="hopper"/>
    </statements>
  </SPL:Method>
  <SPL:RedirectionErrorResponse errorKind="USE_PROXY"/>
  <SPL:ReturnStat>
    <returnedValue xsi:type="SPL:ForwardExp">
      <exp xsi:type="SPL:ConstantExp"/>
    </returnedValue>
  </SPL:ReturnStat>
  <SPL:SelectStat>
    <matchedExp xsi:type="SPL:SIPHeaderPlace" header="TO"/>
  </SPL:SelectStat>
  <SPL:SelectCase>
    <values xsi:type="SPL:StringConstant" value="chatelet"/>
  </SPL:SelectCase>
</xmi:XMI>
