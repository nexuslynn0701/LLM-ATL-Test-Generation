<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net002" name="LinearGrafcet">
    <elements xsi:type="Grafcet:Step" location="s001" name="Init" isInitial="true" isActive="true" action="initAction"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="Run" isInitial="false" isActive="false" action="runAction"/>
    <elements xsi:type="Grafcet:Step" location="s003" name="Done" isInitial="false" isActive="false" action="doneAction"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="T_start" condition="startSignal"/>
    <elements xsi:type="Grafcet:Transition" location="t002" name="T_finish" condition="finishSignal"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="arc1" from="/0/@elements.0" to="/0/@elements.3"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="arc2" from="/0/@elements.3" to="/0/@elements.1"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c003" name="arc3" from="/0/@elements.1" to="/0/@elements.4"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c004" name="arc4" from="/0/@elements.4" to="/0/@elements.2"/>
  </Grafcet:Grafcet>
</xmi:XMI>
