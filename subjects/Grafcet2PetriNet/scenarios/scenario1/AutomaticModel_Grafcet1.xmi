<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Grafcet="Grafcet">
  <Grafcet:Grafcet location="net001" name="SimpleGrafcet">
    <elements xsi:type="Grafcet:Step" location="s001" name="Step1" isInitial="true" isActive="true" action="startAction"/>
    <elements xsi:type="Grafcet:Step" location="s002" name="Step2" isInitial="false" isActive="false" action="processAction"/>
    <elements xsi:type="Grafcet:Transition" location="t001" name="Trans1" condition="sensorReady"/>
    <connections xsi:type="Grafcet:StepToTransition" location="c001" name="arc1" from="/0/@elements.0" to="/0/@elements.2"/>
    <connections xsi:type="Grafcet:TransitionToStep" location="c002" name="arc2" from="/0/@elements.2" to="/0/@elements.1"/>
  </Grafcet:Grafcet>
</xmi:XMI>
